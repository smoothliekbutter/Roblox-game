{
  "name": "CloverBattlegrounds",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$className": "Script"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "Gravity": 225
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [512, 20, 512],
          "Position": [0, -10, 0],
          "Material": "Slate",
          "Color": [0.32, 0.34, 0.3]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "Position": [0, 0.5, 0],
          "Material": "Marble",
          "Color": [0.9, 0.9, 0.85],
          "Duration": 0
        }
      }
    },

    "Lighting": {
      "$properties": {
        "ClockTime": 15.5,
        "Brightness": 3,
        "GlobalShadows": true,
        "Ambient": [0.27, 0.27, 0.3],
        "OutdoorAmbient": [0.5, 0.5, 0.55]
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Haze": 1.2,
          "Color": [0.78, 0.8, 0.86]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 28,
          "Threshold": 1.4
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.1,
          "Saturation": 0.1
        }
      }
    }
  }
}
