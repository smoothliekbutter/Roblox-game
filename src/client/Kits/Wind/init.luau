-- Full-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Looks (built further down); moves can hide his wind sword for a moment
-- (the halberd, the bow).
local looks: { [Model]: { hideSword: number } } = {}

local function hideSword(character: Model, duration: number)
	local look = looks[character]
	if look then
		look.hideSword = os.clock() + duration
	end
end

-- Spirit of Notos: the south wind bursts out of him (a sphere of wind and a
-- ring along the ground); spells blown back go as a whirling disc of wind.
function handlers.SpiritOfNotos(data, character, root)
	if data.phase == "Blast" then
		play(character, ANIMS.Notos)
		task.delay(0.1, function()
			if not root.Parent then
				return
			end
			local position = root.Position
			U.shockwave(position, WIND, 4, 34, 0.5, Enum.Material.ForceField)
			U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, 18, 0.4, 0.3)
			U.burst(position, {
				color = WIND_WHITE,
				count = 36,
				size = 0.5,
				speed = NumberRange.new(60, 100),
				lifetime = NumberRange.new(0.2, 0.4),
				streaks = true,
				spread = 180,
			})
			U.light(position, WIND, 5, 30, 0.4)
			if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 30 then
				CameraShake.Add(0.2)
			end
		end)
	elseif data.phase == "Gust" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local disc = U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 6, 6),
			Color = WIND,
			Transparency = 0.4,
		})
		local position = origin
		every(0.75, function(elapsed, dt)
			position += direction * 120 * dt
			disc.CFrame = CFrame.lookAt(position, position + direction)
				* CFrame.Angles(0, rad(90), 0)
				* CFrame.Angles(elapsed * 20, 0, 0)
			return true
		end, function()
			fadeOut({ disc }, 0.1)
		end)
		gust(origin, 5, direction)
	end
end

-- Spirit of Zephyrus: he leaps into the sky on a burst of wind; hanging
-- there, arms flung wide over a turning ring of wind, wind arrows form one
-- by one floating round him (the same ring the server fires from), pointed
-- down at the ground; then they rain down one after another.
local ZEPHYRUS_ARROWS = 14
local ZEPHYRUS_RING = 4.5
type Volley = { arrows: { [number]: Arrow }, started: number, ring: { BasePart } }
local volleys: { [Model]: Volley } = {}

local function floatingAt(root: BasePart, i: number, t: number): Vector3
	local angle = i / ZEPHYRUS_ARROWS * math.pi * 2 + t * 1.5
	return root.Position
		+ Vector3.new(math.cos(angle) * ZEPHYRUS_RING, 1.2 + math.sin(angle * 2) * 0.6, math.sin(angle) * ZEPHYRUS_RING)
end

local function clearVolley(character: Model)
	local volley = volleys[character]
	if volley then
		volleys[character] = nil
		for _, arrow in volley.arrows do
			arrow.destroy(0.15)
		end
		fadeOut(volley.ring, 0.2)
	end
end

function handlers.SpiritOfZephyrus(data, character, root)
	local phase = data.phase
	if phase == "Leap" then
		play(character, ANIMS.Ark)
		local feet = root.Position - UP * 2.9
		U.ringBurst(CFrame.new(feet), WIND, 1, 9, 0.35, 0.3)
		U.burst(feet, {
			color = WIND_WHITE,
			count = 24,
			size = 0.5,
			speed = NumberRange.new(30, 60),
			lifetime = NumberRange.new(0.2, 0.4),
			streaks = true,
			spread = 40,
			direction = -UP,
		})
		U.debris(feet, 6, 30, 0.5)
		U.bodyTrail(character, WIND, data.rise + 0.1)
		if U.isLocal(character) then
			CameraShake.Add(0.15)
			CameraShake.FovKick(6)
		end
	elseif phase == "Gather" then
		play(character, ANIMS.Notos)
		clearVolley(character)
		local token = bump(character)
		local volley: Volley = {
			arrows = {},
			started = os.clock(),
			ring = arcParts(
				arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 16),
				0.25,
				WIND_WHITE,
				0.2
			),
		}
		volleys[character] = volley
		local count: number = data.arrows
		for i = 1, count do
			task.delay((i - 1) / count * data.gather, function()
				if volleys[character] ~= volley then
					return
				end
				-- The last (the one they never see coming) is the biggest.
				volley.arrows[i] = makeArrow(if i == count then 1.5 else 1)
				local at = floatingAt(root, i, os.clock() - volley.started)
				U.flash(at, WIND_WHITE, 2.5, 0.15)
				U.ringBurst(CFrame.new(at), WIND, 0.3, 1.6, 0.2, 0.08)
			end)
		end
		every(data.gather + count * 0.06 + 1, function()
			if volleys[character] ~= volley or not live(character, token) or not root.Parent then
				return false
			end
			local t = os.clock() - volley.started
			for i, arrow in volley.arrows do
				local position = floatingAt(root, i, t)
				local outward = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
				local aim = ((if outward.Magnitude > 1e-3 then outward.Unit else Vector3.xAxis) * 0.45 - UP).Unit
				arrow.place(CFrame.lookAt(position, position + aim) * CFrame.Angles(0, 0, t * 3 + i))
			end
			local spin = t * 3
			poseArc(
				volley.ring,
				arcPoints(
					root.Position - UP * 3.2,
					Vector3.new(math.cos(spin), 0, math.sin(spin)),
					Vector3.new(-math.sin(spin), 0, math.cos(spin)),
					5,
					0,
					math.pi * 2,
					16
				)
			)
			return true
		end, function()
			if volleys[character] == volley then
				clearVolley(character)
			end
		end)
		U.light(root.Position, WIND, 4, 24, data.gather + 1.2)
	elseif phase == "Arrow" then
		local volley = volleys[character]
		local arrow = volley and volley.arrows[data.index]
		local aim: Vector3 = data.aim
		local from = if volley and arrow
			then floatingAt(root, data.index, os.clock() - volley.started)
			else root.Position
		if volley and arrow then
			volley.arrows[data.index] = nil
		end
		flyingArrow(from, (aim - from).Unit, data.speed, data.range, if data.last then 1.5 else 0.9, arrow)
		U.flash(from, WIND_WHITE, if data.last then 4 else 2, 0.12)
		if data.last and volley then
			task.delay(0.3, function()
				if volleys[character] == volley then
					clearVolley(character)
				end
			end)
		end
		if U.isLocal(character) then
			CameraShake.FovKick(if data.last then 5 else 1)
		end
	elseif phase == "Cancel" then
		bump(character)
		clearVolley(character)
	end
end

-- Spirit of Euros: a recurve bow of wind (curled tips) and a giant wind
-- arrow that the wind spirals into as he draws, a glow swelling at its head;
-- loosed, it's gone in a blink, a white line all there is of it, then the
-- air along it rings.
local EUROS_SCALE = 3.6 -- the arrow, against a normal wind arrow
function handlers.SpiritOfEuros(data, character, root)
	if data.phase == "Draw" then
		play(character, ANIMS.EurosDraw)
		local token = bump(character)
		hideSword(character, data.duration + 0.4)
		local segments = 12
		local limbs = arcParts(table.create(segments + 1, Vector3.zero), 0.24, WIND, 0.15)
		local arrow = makeArrow(EUROS_SCALE)
		local charge = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, Color = WIND, Transparency = 0.6 })
		local all = table.clone(limbs)
		table.insert(all, charge)
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Left")
			local pull = handOf(character, "Right")
			if not live(character, token) or not hand or not pull then
				return false
			end
			local forward = root.CFrame.LookVector
			local center = hand - forward * 1.3
			-- Recurve: the tips curl forward again.
			local points = arcPoints(center, forward, UP, 3.6, -1.2, 1.2, segments)
			points[1] += forward * 0.7
			points[#points] += forward * 0.7
			poseArc(limbs, points)
			local tip = hand + forward * 1.6
			-- Nocked at his hand, the head far out past the bow.
			local frame = CFrame.lookAt(pull, tip) * CFrame.new(0, 0, -1.7 * EUROS_SCALE)
			arrow.place(frame * CFrame.Angles(0, 0, elapsed * 2))
			local head = (frame * CFrame.new(0, 0, -2.1 * EUROS_SCALE)).Position
			charge.Size = Vector3.one * (1 + 5 * math.min(elapsed / data.duration, 1))
			charge.CFrame = CFrame.new(head)
			inflow(head, 7)
			return true
		end, function()
			arrow.destroy(0.1)
			fadeOut(all, 0.1)
		end)
	elseif data.phase == "Loose" then
		play(character, ANIMS.EurosLoose)
		bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local finish = origin + direction * data.length
		flyingArrow(origin, direction, data.length / 0.08, data.length, EUROS_SCALE)
		local line = bar(origin, finish, 0.6, WIND_WHITE, 0)
		local glow = bar(origin, finish, 3.5, WIND, 0.55)
		U.tween(line, 0.45, { Size = Vector3.new(0.04, 0.04, line.Size.Z) })
		fadeOut({ line, glow }, 0.45)
		for i = 0, 8 do
			task.delay(i * 0.02, U.impactRing, origin:Lerp(finish, i / 8), direction, WIND_WHITE, 1.5, 6, 0.3)
		end
		U.flash(finish, WIND_WHITE, 8, 0.2)
		gust(finish, 6, direction)
		U.light(origin, WIND, 5, 24, 0.3)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- Saint Spirit of Zephyr (6 seconds): he flicks a star at them; it binds
-- them and a column of wind and starlight bursts out of the ground and
-- carries them 32 studs into the sky, him flying up beside them. A
-- constellation of twelve stars opens round them over a turning circle of
-- starlight, and Conjunction takes him from star to star, through them each
-- time, faster and faster: every cut a crescent of light left hanging in
-- the air, afterimages of him all round them. An X, then he's high above
-- them, wings of light open, a colossal blade of wind and starlight in his
-- hands, and splits them with one strike straight down to the ground: a
-- line through the whole sky. Every hanging cut detonates in a chain, the
-- constellation shatters and they fall like a meteor into a crater behind
-- him, a tornado of wind tearing up out of it, feathers drifting down.
local SAINT_BLADE = 40

local function quadratic(a: Vector3, b: Vector3, c: Vector3, s: number): Vector3
	return a * ((1 - s) * (1 - s)) + b * (2 * s * (1 - s)) + c * (s * s)
end

-- A cut through the air: a crescent from `from` to `to` bowed out by
-- `bend`, a white-hot edge in a glow of wind, drawn along it in a flash
-- and left hanging, fainter, until it's detonated.
type Cut = { parts: { BasePart }, points: { Vector3 } }

local function crescentCut(from: Vector3, to: Vector3, bend: Vector3, scale: number): Cut
	local segments = 14
	local middle = from:Lerp(to, 0.5) + bend
	local points: { Vector3 } = {}
	for i = 0, segments do
		table.insert(points, quadratic(from, middle, to, i / segments))
	end
	local parts: { BasePart } = {}
	for i = 1, segments do
		local taper = math.sin(math.pi * (i - 0.5) / segments)
		local core = bar(points[i], points[i + 1], (0.08 + 0.42 * taper) * scale, STAR_WHITE, 1)
		local glow = bar(points[i], points[i + 1], (0.3 + 1.8 * taper) * scale, WIND, 1)
		table.insert(parts, core)
		table.insert(parts, glow)
		task.delay((i - 1) / segments * 0.05, function()
			core.Transparency = 0
			glow.Transparency = 0.35
			task.delay(0.12, function()
				if core.Parent then
					U.tween(core, 0.25, {
						Size = Vector3.new(core.Size.X * 0.55, core.Size.Y * 0.55, core.Size.Z),
						Transparency = 0.1,
					})
					U.tween(glow, 0.25, { Transparency = 0.7 })
				end
			end)
		end)
	end
	return { parts = parts, points = points }
end

-- A hanging cut detonates: it flares, bursts into sparks and starlight all
-- along it, and is gone.
local function detonate(cut: Cut)
	local points = cut.points
	for i = 2, #points - 1, 3 do
		U.flash(points[i], STAR_WHITE, 3.5, 0.16)
		U.burst(points[i], {
			color = STAR,
			count = 6,
			size = 0.5,
			speed = NumberRange.new(14, 36),
			lifetime = NumberRange.new(0.2, 0.45),
			streaks = true,
			spread = 180,
		})
	end
	for _, part in cut.parts do
		if part.Parent then
			U.tween(part, 0.08, { Size = part.Size * Vector3.new(2.4, 2.4, 1), Transparency = 0 })
		end
	end
	task.delay(0.08, fadeOut, cut.parts, 0.2)
end

-- The constellation's circle, flat round them and turning: an outer ring
-- of starlight, a dashed ring turning the other way, an inner ring of wind,
-- twelve spokes, and a second ring standing up through them at a slant.
-- It opens out of them, then is thrown apart.
type Circle = { update: (number, number) -> (), shatter: () -> () }

local function magicCircle(center: Vector3, radius: number): Circle
	local function ring(count: number, width: number, color: Color3, transparency: number): { BasePart }
		return arcParts(
			arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, count),
			width,
			color,
			transparency
		)
	end
	local outer = ring(40, 0.3, STAR, 0.1)
	local dashed = ring(48, 0.16, STAR_WHITE, 0.2)
	for i, part in dashed do
		if i % 2 == 0 then
			part.Transparency = 1
		end
	end
	local inner = ring(28, 0.22, WIND, 0.15)
	local slant = ring(36, 0.14, STAR_WHITE, 0.3)
	local spokes: { BasePart } = {}
	for _ = 1, 12 do
		table.insert(spokes, bar(center, center + UP, 0.1, STAR_WHITE, 0.35))
	end
	local all: { BasePart } = {}
	for _, list in { outer, dashed, inner, slant, spokes } do
		table.move(list, 1, #list, #all + 1, all)
	end
	local function flat(angle: number): (Vector3, Vector3)
		return Vector3.new(math.cos(angle), 0, math.sin(angle)), Vector3.new(-math.sin(angle), 0, math.cos(angle))
	end
	local circle = {}
	function circle.update(t: number, open: number)
		local r = radius * open + 0.05
		local a1, b1 = flat(t * 0.6)
		poseArc(outer, arcPoints(center, a1, b1, r, 0, math.pi * 2, 40))
		local a2, b2 = flat(-t * 1.1)
		poseArc(dashed, arcPoints(center, a2, b2, r * 0.86, 0, math.pi * 2, 48))
		local a3, b3 = flat(t * 1.8)
		poseArc(inner, arcPoints(center, a3, b3, r * 0.34, 0, math.pi * 2, 28))
		local axis = flat(t * 0.8)
		local lean = (UP * 0.94 + axis:Cross(UP) * 0.34).Unit
		poseArc(slant, arcPoints(center, axis, lean, r * 1.08, 0, math.pi * 2, 36))
		for i, spoke in spokes do
			local direction = flat(t * 0.6 + i / #spokes * math.pi * 2)
			stretch(spoke, center + direction * r * 0.38, center + direction * r * 0.84)
		end
	end
	function circle.shatter()
		for _, part in all do
			local away = part.Position - center
			away = Vector3.new(away.X, 0, away.Z)
			local out = if away.Magnitude > 0.1 then away.Unit else U.randomUnit()
			U.tween(part, 0.5, {
				CFrame = part.CFrame + out * 9 + UP * (math.random() * 4 - 2),
				Transparency = 1,
			})
		end
		task.delay(0.55, function()
			for _, part in all do
				part:Destroy()
			end
		end)
	end
	return circle
end

-- A column of wind tearing up out of the ground: a shell of wind, a white
-- core and a thread of starlight shooting up, ribbons of wind spiralling up
-- round it, the ground bursting where it comes out.
local function windColumn(base: Vector3, height: number, radius: number, duration: number)
	U.pillar(base, WIND, radius, height, duration, Enum.Material.ForceField, 0.1)
	U.pillar(base, WIND_WHITE, radius * 0.3, height, duration * 0.9)
	U.pillar(base, STAR, radius * 0.12, height * 1.1, duration * 0.8)
	local strands, segments = 5, 18
	local ribbons: { { BasePart } } = {}
	for k = 1, strands do
		local strand = {}
		for _ = 1, segments do
			table.insert(
				strand,
				bar(base, base + UP, if k % 2 == 1 then 0.4 else 0.22, if k % 2 == 1 then WIND_WHITE else STAR, 0.15)
			)
		end
		table.insert(ribbons, strand)
	end
	every(duration, function(elapsed)
		local top = height * math.min(elapsed / (duration * 0.5), 1)
		for k, strand in ribbons do
			local previous = base
			for i, segment in strand do
				local s = i / #strand
				local angle = k / strands * math.pi * 2 + s * math.pi * 5 - elapsed * 10
				local r = radius * (1.15 - s * 0.45)
				local point = base + UP * top * s + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
				stretch(segment, previous, point)
				previous = point
			end
		end
		return true
	end, function()
		for _, strand in ribbons do
			fadeOut(strand, 0.3)
		end
	end)
	U.ringBurst(CFrame.new(base + UP * 0.2), WIND_WHITE, 1, radius * 4, 0.5, 0.4)
	U.shockwave(base, WIND, 2, radius * 6, 0.45)
	U.groundCracks(base, 8, radius * 3, WIND, 1.2)
	U.debris(base, 12, 45, 0.7)
	U.groundRocks(base, 8, radius * 2, 1.3)
	U.burst(base, {
		color = WIND_WHITE,
		count = 40,
		size = 0.6,
		speed = NumberRange.new(60, 110),
		lifetime = NumberRange.new(0.3, 0.6),
		streaks = true,
		spread = 15,
		direction = UP,
	})
	gust(base + UP, 8, UP)
	U.light(base + UP * 4, WIND, 6, 40, duration)
end

-- Wings of light: two great fans of feathers open out of his back for the
-- strike, beat slowly, and fold away.
local function wingsOfLight(character: Model, duration: number)
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if not torso then
		return
	end
	type WingFeather = { vane: BasePart, glow: BasePart, side: number, index: number }
	local feathers: { WingFeather } = {}
	for side = -1, 1, 2 do
		for i = 1, 7 do
			local length = 5 + i * 0.8
			table.insert(feathers, {
				vane = newWedge({ Size = Vector3.new(0.12, 0.9, length), Color = WIND_WHITE, Transparency = 0.05 }),
				glow = U.newPart({ Size = Vector3.new(0.05, 1.9, length + 0.8), Color = WIND, Transparency = 0.55 }),
				side = side,
				index = i,
			})
		end
	end
	every(duration, function(elapsed)
		if not torso.Parent then
			return false
		end
		local open = 1 - (1 - math.min(elapsed / 0.3, 1)) ^ 3
		local fold = math.clamp((elapsed - (duration - 0.25)) / 0.25, 0, 1)
		local spread = open * (1 - fold)
		local beat = math.sin(elapsed * 5) * 0.08
		local frame = torso.CFrame
		for _, f in feathers do
			local angle = rad(8 + (f.index - 1) * 15) * spread + beat
			local out = (
				frame.RightVector * f.side * math.cos(angle)
				+ frame.UpVector * math.sin(angle)
				- frame.LookVector * 0.35
			).Unit
			local base = (frame * CFrame.new(f.side * 0.45, 0.8, 0.55)).Position
			local length = f.vane.Size.Z * (0.3 + 0.7 * spread)
			local pose = CFrame.lookAt(base, base + out, frame.LookVector) * CFrame.new(0, 0, -length / 2)
			f.vane.Size = Vector3.new(f.vane.Size.X, f.vane.Size.Y, length)
			f.vane.CFrame = pose
			f.glow.Size = Vector3.new(f.glow.Size.X, f.glow.Size.Y, length + 0.8)
			f.glow.CFrame = pose
		end
		return true
	end, function()
		for _, f in feathers do
			fadeOut({ f.vane, f.glow }, 0.2)
		end
	end)
end

-- The colossal blade: a white-hot core, a gold edge, a glow of wind and a
-- shimmering sheath, stars spiralling up it and a great star at its point.
type Blade = { set: (Vector3, Vector3, number) -> (), dissolve: () -> () }

local function giantBlade(): Blade
	local layers = {
		{ part = tube(Vector3.zero, UP, 1.4, STAR_WHITE, 0), width = 1.4 },
		{ part = tube(Vector3.zero, UP, 2.6, STAR, 0.35), width = 2.6 },
		{ part = tube(Vector3.zero, UP, 5, WIND, 0.5), width = 5 },
		{ part = tube(Vector3.zero, UP, 8, WIND, 0), width = 8 },
	}
	layers[4].part.Material = Enum.Material.ForceField
	local light = Instance.new("PointLight")
	light.Color = STAR
	light.Range = 60
	light.Brightness = 8
	light.Parent = layers[1].part
	local tip = makeStar(5)
	local motes: { Star } = {}
	for _ = 1, 8 do
		table.insert(motes, makeStar(1.2))
	end
	local last: { from: Vector3, direction: Vector3, length: number }? = nil
	local blade = {}
	function blade.set(from: Vector3, direction: Vector3, length: number)
		last = { from = from, direction = direction, length = length }
		local now = os.clock()
		local to = from + direction * length
		local pulse = 1 + 0.08 * math.sin(now * 40)
		local middle = CFrame.lookAt(from:Lerp(to, 0.5), to) * CFrame.Angles(0, rad(90), 0)
		for i, layer in layers do
			local width = layer.width * pulse
			layer.part.Size = Vector3.new(length, width, width)
			layer.part.CFrame = if i == 4 then middle * CFrame.Angles(now * 8, 0, 0) else middle
		end
		tip.place(to, now * 6)
		local side = direction:Cross(UP)
		side = if side.Magnitude > 1e-3 then side.Unit else Vector3.xAxis
		local up = side:Cross(direction).Unit
		for i, mote in motes do
			local s = (now * 0.9 + i / #motes) % 1
			local angle = now * 7 + i * 0.8
			mote.place(from + direction * length * s + (side * math.cos(angle) + up * math.sin(angle)) * 3.2, angle)
		end
	end
	function blade.dissolve()
		light.Enabled = false
		local shape = last
		if shape then
			for i = 1, 10 do
				local point = shape.from + shape.direction * shape.length * (i / 10)
				U.burst(point, {
					color = if i % 2 == 0 then STAR else WIND_WHITE,
					count = 5,
					size = 0.5,
					speed = NumberRange.new(4, 12),
					lifetime = NumberRange.new(0.4, 0.8),
					spread = 180,
				})
			end
		end
		for _, layer in layers do
			U.tween(layer.part, 0.25, { Size = Vector3.new(layer.part.Size.X, 0.05, 0.05) })
			fadeOut({ layer.part }, 0.28)
		end
		tip.fade(0.25)
		for _, mote in motes do
			mote.fade(0.3)
		end
	end
	return blade
end

-- The strike's line through the whole sky: a white-hot core, gold and wind
-- round it, and a sheet of light along it that flashes wide and is gone.
local function skySplit(top: Vector3, ground: Vector3, side: Vector3)
	local direction = (ground - top).Unit
	local from, to = top - direction * 90, ground + direction * 2
	local core = bar(from, to, 0.8, STAR_WHITE, 0)
	local gold = bar(from, to, 2.2, STAR, 0.25)
	local glow = bar(from, to, 7, WIND, 0.55)
	local sheet = U.newPart({
		Size = Vector3.new(0.15, 16, (to - from).Magnitude),
		CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to, side:Cross(direction)),
		Color = WIND_WHITE,
		Transparency = 0.3,
	})
	U.tween(sheet, 0.35, { Size = Vector3.new(0.05, 50, sheet.Size.Z), Transparency = 1 })
	task.delay(0.37, sheet.Destroy, sheet)
	task.delay(0.3, function()
		U.tween(core, 0.5, { Size = Vector3.new(0.05, 0.05, core.Size.Z) })
		U.tween(gold, 0.5, { Size = Vector3.new(0.05, 0.05, gold.Size.Z) })
		fadeOut({ core, gold, glow }, 0.55)
	end)
end

-- Feathers of light drifting down round him afterwards.
local function featherFall(center: Vector3, count: number, duration: number)
	for i = 1, count do
		local feather = newWedge({ Size = Vector3.new(0.05, 0.3, 1), Color = WIND_WHITE, Transparency = 1 })
		U.tween(feather, 0.3, { Transparency = 0.1 })
		local from = center + Vector3.new(math.random(-70, 70) / 10, 5 + math.random() * 7, math.random(-70, 70) / 10)
		local life = duration * (0.7 + math.random() * 0.3)
		every(life, function(elapsed)
			local drift =
				Vector3.new(math.sin(elapsed * 2.6 + i) * 1.3, -elapsed * 2.4, math.cos(elapsed * 2 + i) * 0.8)
			feather.CFrame = CFrame.new(from + drift)
				* CFrame.Angles(elapsed * 1.5 + i, elapsed * 2.5, math.sin(elapsed * 4 + i) * 0.7)
			return true
		end, function()
			fadeOut({ feather }, 0.3)
		end)
	end
end

local function playSaintZephyr(data, character: Model, root: BasePart)
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = SaintPlan.Plan(data.origin, data.start, data.floorY)
	local times = SaintPlan.Times
	local started = os.clock()
	local mine = involves(data, character)
	local near = (workspace.CurrentCamera.CFrame.Position - plan.center).Magnitude < 120
	local forward, right = plan.forward, plan.right

	-- The star that binds them and two rings of starlight turning round them.
	local seal = makeStar(3.2)
	local bindRings = {
		arcParts(arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 18), 0.16, STAR, 0.1),
		arcParts(arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 18), 0.1, STAR_WHITE, 0.25),
	}
	-- The constellation: twelve stars, joined in the order he cuts from
	-- them (a twelve-pointed star), over the turning circle.
	local stars: { Star } = {}
	local lines: { BasePart } = {}
	for _ = 1, #plan.stars do
		table.insert(stars, makeStar(2.4))
		table.insert(lines, bar(plan.center, plan.center + UP, 0.1, STAR_WHITE, 0.3))
	end
	local circle = magicCircle(plan.center, SaintPlan.Ring + 3)
	local cuts: { Cut } = {}
	local blade: Blade? = nil
	local tail = bar(plan.center, plan.center + UP, 1.2, STAR, 1)
	local tailGlow = bar(plan.center, plan.center + UP, 3, WIND, 1)
	local burst = false

	local bind = "CloverSaintZephyr" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > times.Length + 0.1 then
			finish()
			return
		end
		if root.Parent then
			root.CFrame = SaintPlan.Attacker(plan, t)
		end
		local victim = SaintPlan.Victim(plan, math.min(t, times.Land))
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = victim
		end

		if not burst then
			seal.place(victim.Position + victim.LookVector * 0.9 + UP * 0.4, t * 4)
			for k, ring in bindRings do
				local spin = t * (if k == 1 then 3 else -4)
				poseArc(
					ring,
					arcPoints(
						victim.Position + UP * (if k == 1 then 0.9 else -0.6),
						Vector3.new(math.cos(spin), 0, math.sin(spin)),
						Vector3.new(-math.sin(spin), 0, math.cos(spin)),
						(2.3 + 0.3 * k) * math.min(t / 0.2, 1) + 0.05,
						0,
						math.pi * 2,
						18
					)
				)
			end
			-- The stars open out of them one by one, joined up as they go.
			local placed: { Vector3 } = {}
			for i, star in stars do
				local open = math.clamp((t - times.Lift - i * 0.025) / 0.2, 0, 1)
				-- (Out of sight until it opens.)
				placed[i] = if open > 0
					then plan.center:Lerp(plan.stars[i], 1 - (1 - open) ^ 3)
					else plan.center + UP * 5000
				star.place(placed[i], t * 2 + i)
			end
			for i, line in lines do
				stretch(line, placed[i], placed[i % #placed + 1])
			end
			circle.update(t, 1 - (1 - math.clamp((t - times.Lift) / 0.35, 0, 1)) ^ 3)
		end

		-- The blade, from the rise to the strike: up out of his raised
		-- hands, then straight down along the strike.
		local hand, other = handOf(character, "Right"), handOf(character, "Left")
		if blade and hand and other then
			local hands = hand:Lerp(other, 0.5)
			local grow = 1 - (1 - math.clamp((t - (times.Rise - 0.1)) / 0.35, 0, 1)) ^ 3
			local down = (plan.ground - plan.top).Unit
			local swing = math.clamp((t - (times.Strike - 0.06)) / 0.1, 0, 1)
			local direction = UP:Lerp(down, swing)
			direction = if direction.Magnitude > 1e-3 then direction.Unit else down
			blade.set(hands, direction, SAINT_BLADE * grow + 0.5)
			if t < times.Strike and math.random() < 0.6 then
				inflow(hands + direction * SAINT_BLADE * grow * math.random(), 14, STAR)
			end
		end

		-- Falling like a meteor: a comet's tail behind them.
		if t >= times.Burst and t <= times.Land and targetRoot then
			local length = 4 + 26 * math.clamp((t - times.Burst) / (times.Land - times.Burst), 0, 1)
			stretch(tail, victim.Position, victim.Position + UP * length)
			stretch(tailGlow, victim.Position, victim.Position + UP * length * 1.2)
			tail.Transparency = 0.1
			tailGlow.Transparency = 0.5
		end
	end)

	-- The bind: the star strikes them and a column of wind tears up out of
	-- the ground under them and carries them up, him flying up beside them.
	U.flash(plan.start + UP, STAR_WHITE, 7, 0.2)
	U.glint(plan.start + UP, 2.5, STAR_WHITE)
	windColumn(plan.start - UP * 2.8, SaintPlan.Height + 14, 3.4, times.Lift + 0.4)
	if targetRoot then
		U.spiral(targetRoot, WIND_WHITE, 4, 5, times.Lift, 4, 0.6, 0.3)
		U.bodyTrail(target, STAR, times.Lift)
	end
	task.delay(0.25, function()
		play(character, ANIMS.SaintAscend)
		gust(root.Position - UP * 2.5, 6, UP)
		U.spiral(root, WIND, 3, 4, times.Lift, 3, 0.45, 0.3)
		U.bodyTrail(character, WIND, times.Lift)
	end)
	if mine then
		CameraShake.Add(0.2)
		CameraShake.FovKick(8)
	end

	-- The constellation opens round them.
	task.delay(times.Lift, function()
		U.flash(plan.center, STAR_WHITE, 10, 0.25)
		U.shockwave(plan.center, STAR, 2, SaintPlan.Ring * 2.6, 0.5)
		U.ringBurst(CFrame.new(plan.center), STAR_WHITE, 2, SaintPlan.Ring + 4, 0.5, 0.35)
		U.light(plan.center, STAR, 7, 70, times.Burst - times.Lift)
		for i, at in plan.stars do
			task.delay(i * 0.025 + 0.15, function()
				U.flash(at, STAR_WHITE, 4, 0.2)
				U.glint(at, 1.6, STAR_WHITE)
			end)
		end
	end)

	-- Conjunction: from star to star, straight through them, faster and
	-- faster; afterimages of him gather round them.
	local function cutFrom(star: Vector3, at: number, scale: number, clip: Animation)
		local exit = SaintPlan.Exit(plan, star)
		local along = (exit - star).Unit
		task.delay(math.max(at - SaintPlan.Appear, 0), function()
			U.afterimage(character, WIND, 0.45)
			U.flash(star, STAR_WHITE, 4.5, 0.15)
			U.impactRing(star, along, STAR_WHITE, 0.5, 3.5, 0.18)
			play(character, clip)
		end)
		task.delay(at, function()
			if burst then
				return
			end
			local bend = along:Cross(U.randomUnit())
			bend = if bend.Magnitude > 1e-3 then bend.Unit * (2.5 + math.random() * 2) else UP * 3
			table.insert(cuts, crescentCut(star - along * 3, exit + along * 3, bend, scale))
			U.flash(plan.center, WIND_WHITE, 4 * scale, 0.1)
			U.impactRing(plan.center, along, STAR_WHITE, 1, 7 * scale, 0.22)
			U.shockwave(plan.center, WIND, 1, 6 * scale, 0.2)
			U.burst(plan.center, {
				color = WIND_WHITE,
				count = 12,
				size = 0.45,
				speed = NumberRange.new(30, 70),
				lifetime = NumberRange.new(0.12, 0.3),
				streaks = true,
				spread = 30,
				direction = along,
			})
			if target then
				U.highlight(target, WIND_WHITE, 0.12)
			end
			if mine then
				CameraShake.Add(0.06 * scale)
				CameraShake.FovKick(2 * scale)
			end
		end)
	end
	for i, at in times.Cuts do
		cutFrom(plan.stars[i], at, 1, if i % 2 == 1 then ANIMS.SaintCut else ANIMS.SaintCutBack)
	end

	-- The X: his cut and its mirror at once.
	cutFrom(plan.cross, times.Cross, 1.6, ANIMS.SaintCut)
	task.delay(times.Cross, function()
		if burst then
			return
		end
		local mirror = plan.center + (UP + right).Unit * SaintPlan.Ring
		local along = (SaintPlan.Exit(plan, mirror) - mirror).Unit
		table.insert(cuts, crescentCut(mirror - along * 3, SaintPlan.Exit(plan, mirror) + along * 3, forward * 3, 1.6))
		U.flash(plan.center, STAR_WHITE, 12, 0.25)
		U.glint(plan.center, 4, STAR_WHITE)
		U.shockwave(plan.center, STAR, 2, 20, 0.35)
		if mine or near then
			U.colorGrade({ Brightness = 0.15, Contrast = 0.4, Saturation = -0.6 }, 0, 0.05, 0.15)
		end
		if mine then
			CameraShake.Add(0.25)
			CameraShake.FovKick(8)
		end
	end)

	-- High above them: wings of light, and the blade grows out of his hands.
	task.delay(times.Rise - 0.1, function()
		play(character, ANIMS.SaintRise)
		hideSword(character, times.Strike - times.Rise + 0.35)
		blade = giantBlade()
		wingsOfLight(character, times.Strike - times.Rise + 0.35)
		U.flash(plan.top, STAR_WHITE, 8, 0.25)
		U.ringBurst(CFrame.lookAt(plan.top, plan.top + forward) * CFrame.Angles(rad(90), 0, 0), STAR, 2, 16, 0.5, 0.35)
		U.shockwave(plan.top, WIND, 2, 18, 0.45)
		U.pillar(plan.top, STAR, 2, 60, times.Strike - times.Rise, Enum.Material.ForceField, 0.3)
		U.light(plan.top, STAR, 8, 60, times.Strike - times.Rise + 0.2)
		if mine then
			CameraShake.Add(0.15)
		end
	end)

	-- The strike: the sky cut in two along it.
	task.delay(times.Strike - 0.05, function()
		play(character, ANIMS.SaintStrike)
	end)
	task.delay(times.Strike, function()
		skySplit(plan.top, plan.ground, right)
		U.flash(plan.center, STAR_WHITE, 18, 0.35)
		for k = 1, 3 do
			U.impactRing(plan.center, UP, if k == 2 then STAR else STAR_WHITE, 2, 14 + k * 8, 0.3 + k * 0.08)
		end
		U.shockwave(plan.center, STAR_WHITE, 3, 34, 0.4)
		U.burst(plan.center, {
			color = STAR_WHITE,
			count = 50,
			size = 0.7,
			speed = NumberRange.new(60, 120),
			lifetime = NumberRange.new(0.2, 0.45),
			streaks = true,
			spread = 180,
		})
		U.light(plan.center, STAR_WHITE, 10, 90, 0.45)
		if mine or near then
			-- An impact frame: a flash of stark black and white.
			U.colorGrade({ Brightness = 0.3, Contrast = 0.9, Saturation = -1 }, 0, 0.08, 0.25)
		end
		if mine then
			CameraShake.Add(0.45)
			CameraShake.FovKick(14)
		end
	end)
	task.delay(times.Strike + 0.12, function()
		if blade then
			blade.dissolve()
			blade = nil
		end
	end)

	-- Every hanging cut detonates, one after another; the constellation
	-- shatters; they fall.
	task.delay(times.Burst, function()
		burst = true
		for i, cut in cuts do
			task.delay((i - 1) * 0.015, detonate, cut)
		end
		for i, star in stars do
			U.flash(plan.stars[i], STAR_WHITE, 6, 0.2)
			star.fade(0.2)
		end
		fadeOut(lines, 0.2)
		circle.shatter()
		seal.fade(0.15)
		for _, ring in bindRings do
			fadeOut(ring, 0.15)
		end
		local nova = makeStar(10)
		nova.place(plan.center, 0)
		task.delay(0.1, nova.fade, 0.45)
		U.shockwave(plan.center, STAR, 3, 44, 0.5)
		U.shockwave(plan.center, WIND, 3, 36, 0.45, Enum.Material.Neon, 0.6)
		U.burst(plan.center, {
			color = STAR,
			count = 60,
			size = 0.7,
			speed = NumberRange.new(40, 100),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if targetRoot then
			U.spiral(targetRoot, WIND_WHITE, 3, -5, times.Land - times.Burst, 3, 0.5, 0.2)
			U.bodyTrail(target, STAR, times.Land - times.Burst + 0.1)
		end
		if mine or near then
			U.colorGrade({ Brightness = 0.12, TintColor = Color3.fromRGB(255, 244, 214) }, 0, 0.1, 0.3)
		end
		if mine then
			CameraShake.Add(0.35)
			CameraShake.FovKick(10)
		end
	end)

	-- Landed with his back to them; feathers drift down round him.
	task.delay(times.Strike + 0.1, function()
		play(character, ANIMS.SaintLand)
		gust(plan.ground - UP * 2.5, 8, UP)
		U.ringBurst(CFrame.new(plan.ground - UP * 2.8), WIND_WHITE, 1, 10, 0.35, 0.3)
	end)
	task.delay(times.Land, function()
		tail.Transparency = 1
		fadeOut({ tail, tailGlow }, 0.2)
		featherFall(plan.ground, 18, times.Length - times.Land + 1.2)
	end)
	task.delay(times.Length - 0.35, function()
		local hand = handOf(character, "Right")
		if hand then
			U.glint(hand, 2, STAR_WHITE)
		end
	end)
	task.delay(times.Length + 0.3, finish)

	-- The camera: over his shoulder as the star strikes; from the ground
	-- looking up as the column carries them up; wide as the constellation
	-- opens; round and round them through the cuts, faster and closer; in
	-- front of them for the X; from below up at him and the blade; wide
	-- across the strike; after them as they fall; then low beyond the
	-- crater, looking back at him.
	if mine then
		Cinematic.Camera(function(t)
			local victim = SaintPlan.Victim(plan, math.min(t, times.Land)).Position
			if t < 0.25 then
				local eye = plan.origin.Position - forward * 7 + right * 3 + UP * 3
				return CFrame.lookAt(eye, plan.start + UP), 70
			elseif t < times.Lift + 0.15 then
				local eye = plan.start + forward * 12 + right * 7 + UP * 1.5
				return CFrame.lookAt(eye, victim), 78
			elseif t < times.Cuts[1] then
				local eye = plan.center - forward * 32 + right * 12 + UP * 6
				return CFrame.lookAt(eye, plan.center), 72
			elseif t < times.Cross - 0.1 then
				local u = t - times.Cuts[1]
				local angle = 1 + u * 1.6 + u * u * 1.4
				local radius = 22 - u * 4.5
				local eye = plan.center
					+ (forward * math.cos(angle) + right * math.sin(angle)) * radius
					+ UP * (3 + math.sin(u * 3) * 2)
				return CFrame.lookAt(eye, plan.center), 75 + u * 8
			elseif t < times.Rise - 0.1 then
				local eye = plan.center - forward * 11 + UP
				return CFrame.lookAt(eye, plan.center), 70
			elseif t < times.Strike - 0.05 then
				local u = (t - (times.Rise - 0.1)) / (times.Strike - times.Rise + 0.05)
				local eye = (plan.center - UP * 9 + right * 11 - forward * 4):Lerp(plan.center - UP * 6 + right * 7, u)
				return CFrame.lookAt(eye, plan.top + UP * 6), 62
			elseif t < times.Burst + 0.05 then
				local eye = plan.center + right * 46 + UP * 2
				return CFrame.lookAt(eye, plan.center - UP * 6), 72
			elseif t < times.Land + 0.1 then
				local eye = victim + right * 18 - forward * 5 + UP * 2
				return CFrame.lookAt(eye, victim), 78
			end
			local u = t - times.Land
			local angle = u * 0.25
			local eye = plan.start + (forward * math.cos(angle) + right * math.sin(angle)) * 15 + right * 3 + UP * 2.5
			return CFrame.lookAt(eye, plan.ground + UP * 1.5), 70
		end, times.Length + 0.3)
	end
end

function handlers.SaintSpiritOfZephyr(data, character, root)
	local phase = data.phase
	if phase == "Flick" then
		-- The star flies out ahead of him.
		play(character, ANIMS.Conjunction)
		local hand = handOf(character, "Right") or root.Position
		local forward = root.CFrame.LookVector
		local range: number = data.range or 15
		local star = makeStar(1.4)
		U.flash(hand, STAR_WHITE, 2.5, 0.12)
		U.glint(hand, 1.2, STAR_WHITE)
		every(0.2, function(elapsed)
			local at = hand + forward * range * (elapsed / 0.2)
			star.place(at, elapsed * 20)
			inflow(at, 2, STAR)
			return true
		end, function()
			star.fade(0.15)
		end)
	elseif phase == "Whiff" then
		local at = root.Position + root.CFrame.LookVector * 15
		U.flash(at, STAR, 2.5, 0.15)
		U.burst(at, {
			color = STAR,
			count = 8,
			size = 0.3,
			speed = NumberRange.new(6, 14),
			lifetime = NumberRange.new(0.2, 0.4),
			spread = 180,
		})
	elseif phase == "Begin" then
		playSaintZephyr(data, character, root)
	elseif phase == "Impact" then
		-- A crater, and a tornado of wind tearing up out of it.
		local position: Vector3 = data.position
		U.flash(position + UP * 2, STAR_WHITE, 20, 0.3)
		U.shockwave(position, STAR, 3, 50, 0.6)
		U.shockwave(position, WIND, 3, 38, 0.5, Enum.Material.Neon, 0.6)
		U.ringBurst(CFrame.new(position + UP * 0.2), STAR_WHITE, 2, 28, 0.5, 0.5)
		U.ringBurst(CFrame.new(position + UP * 0.3), WIND, 2, 36, 0.7, 0.3)
		U.groundCracks(position, 14, 16, WIND, 2.5)
		U.groundRocks(position, 14, 10, 2.2)
		U.debris(position, 26, 60, 1.2)
		windColumn(position, 70, 6, 1.2)
		U.burst(position + UP, {
			texture = U.textures.Smoke,
			color = Color3.fromRGB(150, 160, 150),
			count = 24,
			size = 5,
			speed = NumberRange.new(20, 45),
			lifetime = NumberRange.new(0.6, 1.2),
			lightEmission = 0,
			transparency = 0.35,
			spread = 80,
			direction = UP,
			drag = 3,
		})
		gust(position + UP, 12, UP)
		U.light(position, STAR, 8, 60, 0.9)
		if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 80 then
			CameraShake.Add(0.5)
		end
	end
end

---------------------------------------------------------------------------
-- Half-Crown / Full-Crown: transformations and looks
---------------------------------------------------------------------------

-- Sylph circles in and merges into him at the burst; wind gathers, then
-- blasts out.
local function transformation(data, character: Model, root: BasePart, full: boolean)
	if data.phase == "Start" then
		play(character, if full then ANIMS.Ascend else ANIMS.Awaken)
		local sylph = makeSprite(1.4)
		every(0.8, function(elapsed)
			if not root.Parent then
				return false
			end
			local t = elapsed / 0.8
			local angle = t * math.pi * 4
			local radius = 5 * (1 - t) + 0.5
			sylph.place(
				CFrame.new(root.Position + Vector3.new(math.cos(angle) * radius, 3 - t * 2, math.sin(angle) * radius)),
				elapsed
			)
			inflow(root.Position, 7)
			return true
		end, function()
			sylph.fade(0.15)
		end)
		if full then
			U.spiral(root, WIND, 4, 10, 1.3, 4, 0.2, 0.5)
		end
		U.ringBurst(CFrame.new(root.Position - UP * 2.8), WIND, 12, 2, 0.8, 0.2)
	elseif data.phase == "Burst" then
		local position = root.Position
		U.shockwave(position, WIND, 3, if full then 40 else 28, 0.6, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, if full then 22 else 16, 0.5, 0.4)
		U.pillar(position - UP * 3, WIND, 4, if full then 40 else 26, 0.6, Enum.Material.ForceField, 0.3)
		U.burst(position, {
			color = WIND_WHITE,
			count = 40,
			size = 0.6,
			speed = NumberRange.new(40, 90),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if full then
			U.flash(position + UP * 3, STAR, 10, 0.3)
		end
		U.light(position, WIND, 6, 40, 0.8)
		if U.isLocal(character) then
			U.colorGrade({ Brightness = 0.15, Saturation = 0.3 }, 0, 0.1, 0.5)
			CameraShake.Add(0.35)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "End" then
		gust(root.Position, 6)
	end
end

function handlers.Awaken(data, character, root)
	transformation(data, character, root, false)
end

function handlers.Ascend(data, character, root)
	transformation(data, character, root, true)
end

-- The look. Half-Crown: green mana coats his left side (where Sylph sits),
-- a wing of wind grows from his left shoulder blade and half a crown of
-- gold leaves forms over his left temple. Full-Crown: both sides, both
-- wings, the whole crown, and a two-handed sword of wind. Either way his
-- grimoire comes out and circles him, open, pages fluttering. Anchored
-- parts posed every frame round his body; they fade in.
local GRIMOIRE_COVER = Color3.fromRGB(28, 70, 58)
local GRIMOIRE_PAPER = Color3.fromRGB(226, 234, 214)

-- Feathers per wing: long primaries fanned high and wide (with a shimmer of
-- wind over them) behind shorter coverts nearer the shoulder. Spread is
-- degrees up from straight out; back is how far they sweep behind him.
local WING_LAYERS = {
	{ count = 5, from = 10, to = 82, length = 3.9, shrink = 0.3, width = 0.72, back = 0.62, shimmer = true },
	{ count = 4, from = 4, to = 62, length = 2.1, shrink = 0.22, width = 0.56, back = 0.48, shimmer = false },
}

type Feather = {
	vane: BasePart,
	tip: BasePart,
	core: BasePart,
	shell: BasePart?,
	layer: { [string]: any },
	index: number,
	length: number,
}
type Spike = { left: BasePart, right: BasePart, angle: number, height: number }
type Page = { part: BasePart, offset: CFrame, side: number }

local function buildLook(character: Model, full: boolean): () -> ()
	local torso = character:FindFirstChild("Torso") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = U.getRoot(character)
	if not torso or not head or not root then
		return function() end
	end
	local look = { hideSword = 0 }
	looks[character] = look
	local entries: { { part: BasePart, base: number } } = {}
	local function part(props: { [string]: any }, base: number, wedge: boolean?): BasePart
		local p: BasePart
		if wedge then
			p = Instance.new("WedgePart")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			for key, value in props do
				(p :: any)[key] = value
			end
			p.Parent = U.folder
		else
			p = U.newPart(props)
		end
		p.Transparency = 1
		table.insert(entries, { part = p, base = base })
		return p
	end
	local sides = if full then { -1, 1 } else { -1 } -- -1: his left

	-- Wings.
	local wings: { { side: number, feathers: { Feather } } } = {}
	local emitters: { ParticleEmitter } = {}
	for _, side in sides do
		local feathers: { Feather } = {}
		for _, layer in WING_LAYERS do
			for i = 1, layer.count do
				local length = layer.length - (i - 1) * layer.shrink
				local tip =
					part({ Size = Vector3.new(0.07, layer.width * 0.72, layer.width * 0.72), Color = WIND }, 0.3)
				table.insert(feathers, {
					vane = part({ Size = Vector3.new(0.07, layer.width, length), Color = WIND }, 0.32),
					tip = tip,
					core = part({ Size = Vector3.new(0.09, 0.07, length), Color = WIND_WHITE }, 0.1),
					shell = if layer.shimmer
						then part({
							Size = Vector3.new(0.18, layer.width * 1.35, length * 1.05),
							Color = WIND,
							Material = Enum.Material.ForceField,
						}, 0)
						else nil,
					layer = layer,
					index = i,
					length = length,
				})
				-- Wisps of wind streaming off the longest feathers' tips.
				if layer.shimmer and i <= 2 then
					local wisp = Instance.new("ParticleEmitter")
					wisp.Texture = U.textures.Smoke
					wisp.Color = ColorSequence.new(WIND_WHITE, WIND)
					wisp.LightEmission = 1
					wisp.LightInfluence = 0
					wisp.Size = NumberSequence.new(0.35, 0)
					wisp.Transparency = NumberSequence.new(0.4, 1)
					wisp.Lifetime = NumberRange.new(0.3, 0.5)
					wisp.Rate = 14
					wisp.Speed = NumberRange.new(0.5, 1)
					wisp.Parent = tip
					table.insert(emitters, wisp)
				end
			end
		end
		table.insert(wings, { side = side, feathers = feathers })
	end

	-- Crown: a gold band and leaf-shaped spikes (two wedges back to back),
	-- the tallest at the front (Full-Crown) or over his left temple (Half).
	local spikes: { Spike } = {}
	local spikeCount = if full then 10 else 5
	for i = 1, spikeCount do
		local angle, height
		if full then
			angle = (i - 1) / spikeCount * math.pi * 2
			height = if i == 1 then 1 elseif i % 2 == 1 then 0.72 else 0.48
		else
			local f = (i - 1) / (spikeCount - 1)
			angle = -(0.1 + 0.8 * f) * math.pi
			height = 0.45 + 0.5 * math.sin(f * math.pi)
		end
		table.insert(spikes, {
			left = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			right = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			angle = angle,
			height = height,
		})
	end
	local bandCount = if full then 16 else 8
	local band = {}
	for _ = 1, bandCount do
		table.insert(band, part({ Size = Vector3.new(0.09, 0.14, 0.3), Color = STAR }, 0.05))
	end
	local gem = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.22, Color = WIND }, 0)

	-- Green mana coating the marked side: a shimmering shell over the arm,
	-- the leg and that half of the torso.
	local shells: { { part: BasePart, limb: BasePart, offset: CFrame } } = {}
	for _, side in sides do
		for _, name in { if side < 0 then "Left Arm" else "Right Arm", if side < 0 then "Left Leg" else "Right Leg" } do
			local limb = character:FindFirstChild(name) :: BasePart?
			if limb then
				table.insert(shells, {
					part = part({
						Size = limb.Size + Vector3.new(0.08, 0.08, 0.08),
						Color = WIND,
						Material = Enum.Material.ForceField,
					}, 0),
					limb = limb,
					offset = CFrame.identity,
				})
			end
		end
		table.insert(shells, {
			part = part({ Size = Vector3.new(1.06, 2.08, 1.08), Color = WIND, Material = Enum.Material.ForceField }, 0),
			limb = torso,
			offset = CFrame.new(side * 0.5, 0, 0),
		})
		local arm = character:FindFirstChild(if side < 0 then "Left Arm" else "Right Arm") :: BasePart?
		if arm then
			local wisp = Instance.new("ParticleEmitter")
			wisp.Texture = U.textures.Smoke
			wisp.Color = ColorSequence.new(WIND)
			wisp.LightEmission = 0.8
			wisp.LightInfluence = 0
			wisp.Size = NumberSequence.new(0.5, 0)
			wisp.Transparency = NumberSequence.new(0.5, 1)
			wisp.Lifetime = NumberRange.new(0.4, 0.7)
			wisp.Rate = 18
			wisp.Speed = NumberRange.new(0.5, 1.5)
			wisp.Acceleration = Vector3.new(0, 3, 0)
			wisp.Parent = arm
			table.insert(emitters, wisp)
		end
	end

	-- His grimoire: a dark green book with a four-leaf clover of light over
	-- its open pages.
	local book: { Page } = {}
	local function page(props: { [string]: any }, base: number, offset: CFrame, side: number)
		table.insert(book, { part = part(props, base), offset = offset, side = side })
	end
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			0.05,
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, 0, CFrame.new(0, 1.05, -0.4), 0)
	local bookLight = Instance.new("PointLight")
	bookLight.Color = WIND
	bookLight.Range = 8
	bookLight.Brightness = 1.5
	bookLight.Parent = book[#book].part

	-- The wind sword (Full-Crown), in the right hand.
	local sword: { BasePart }? = nil
	if full then
		sword = {
			part({ Size = Vector3.new(0.22, 1.1, 0.22), Color = WIND_DEEP }, 0),
			part({ Size = Vector3.new(1.5, 0.18, 0.32), Color = STAR }, 0),
			part({ Size = Vector3.new(0.2, 5.6, 0.85), Color = WIND }, 0.25),
			part({ Size = Vector3.new(0.1, 5.4, 0.28), Color = WIND_WHITE }, 0),
			part({ Size = Vector3.new(0.3, 5.9, 1.15), Color = WIND, Material = Enum.Material.ForceField }, 0),
		}
	end

	local start = os.clock()
	local connection: RBXScriptConnection
	local function destroy()
		connection:Disconnect()
		if looks[character] == look then
			looks[character] = nil
		end
		for _, emitter in emitters do
			emitter.Enabled = false
			task.delay(1, emitter.Destroy, emitter)
		end
		local parts = {}
		for _, entry in entries do
			table.insert(parts, entry.part)
		end
		fadeOut(parts, 0.4)
	end
	connection = RunService.RenderStepped:Connect(function()
		if not torso.Parent or not head.Parent or not root.Parent then
			-- He's gone (died, left): the look goes with him.
			destroy()
			return
		end
		local t = os.clock() - start
		local alpha = math.min(t / 0.5, 1)
		for _, entry in entries do
			entry.part.Transparency = 1 - (1 - entry.base) * alpha
		end

		-- Wings: each feather fanned out from the shoulder blade, a slow
		-- beat rippling out along the wing (the tips move most).
		local back = -torso.CFrame.LookVector
		for _, wing in wings do
			local base = torso.CFrame * Vector3.new(wing.side * 0.45, 0.55, 0.55)
			for _, feather in wing.feathers do
				local layer = feather.layer
				local f = if layer.count > 1 then (feather.index - 1) / (layer.count - 1) else 0
				local flap = math.sin(t * 2.1 - feather.index * 0.35) * (6 + f * 6)
				local angle = rad(layer.from + (layer.to - layer.from) * f + flap)
				local localDirection =
					Vector3.new(wing.side * math.cos(angle), math.sin(angle) * 0.95 + 0.05, layer.back).Unit
				local direction = torso.CFrame:VectorToWorldSpace(localDirection)
				local across = direction:Cross(back)
				local up = if across.Magnitude > 1e-3 then across.Unit else UP
				local center = base + direction * (feather.length / 2)
				local frame = CFrame.lookAt(center, center + direction, up)
				feather.vane.CFrame = frame
				feather.core.CFrame = frame
				if feather.shell then
					feather.shell.CFrame = frame
				end
				local tipAt = base + direction * feather.length
				feather.tip.CFrame = CFrame.lookAt(tipAt, tipAt + direction, up) * CFrame.Angles(rad(45), 0, 0)
			end
		end

		-- Crown.
		local crown = head.CFrame * CFrame.new(0, 0.3, 0)
		local function around(a: number): Vector3
			return Vector3.new(math.sin(a), 0, -math.cos(a))
		end
		local function along(a: number): Vector3
			return crown:VectorToWorldSpace(Vector3.new(math.cos(a), 0, math.sin(a)))
		end
		for i, segment in band do
			local a = if full then (i - 0.5) / bandCount * math.pi * 2 else -((i - 0.5) / bandCount) * math.pi
			local position = crown * (around(a) * 0.66)
			segment.CFrame = CFrame.lookAt(position, position + along(a), crown.UpVector)
		end
		for _, spike in spikes do
			local center = crown * (around(spike.angle) * 0.66) + crown.UpVector * (spike.height / 2 + 0.05)
			local frame = CFrame.lookAt(center, center + along(spike.angle), crown.UpVector)
			local half = spike.left.Size.Z / 2
			spike.left.CFrame = frame * CFrame.new(0, 0, -half)
			spike.right.CFrame = frame * CFrame.new(0, 0, half) * CFrame.Angles(0, math.pi, 0)
		end
		gem.CFrame =
			CFrame.new(crown * ((if full then around(0) else around(-math.pi / 2)) * 0.7 + Vector3.new(0, 0.12, 0)))

		-- Mana.
		for _, shell in shells do
			if shell.limb.Parent then
				shell.part.CFrame = shell.limb.CFrame * shell.offset
			end
		end

		-- Grimoire: circling him, turned to keep its pages towards him.
		local orbit = t * 1.15
		local position = root.Position
			+ Vector3.new(math.cos(orbit) * 3, 1.3 + math.sin(t * 2.1) * 0.3, math.sin(orbit) * 3)
		local bookFrame = CFrame.lookAt(position, root.Position + UP * 1.3) * CFrame.Angles(rad(-15), 0, 0)
		local open = rad((62 + math.sin(t * 6) * 6) * alpha)
		for _, p in book do
			local hinge = CFrame.Angles(0, -p.side * open, 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = bookFrame * hinge * spin * p.offset
		end

		-- Sword.
		if sword then
			local arm = character:FindFirstChild("Right Arm") :: BasePart?
			if arm then
				local grip = arm.CFrame * CFrame.new(0, -1.1, 0) * CFrame.Angles(rad(-90), 0, 0)
				sword[1].CFrame = grip
				sword[2].CFrame = grip * CFrame.new(0, 0.6, 0)
				sword[3].CFrame = grip * CFrame.new(0, 3.5, 0)
				sword[4].CFrame = grip * CFrame.new(0, 3.5, 0)
				sword[5].CFrame = grip * CFrame.new(0, 3.55, 0)
			end
			if os.clock() < look.hideSword then
				for _, p in sword do
					p.Transparency = 1
				end
			end
		end
	end)

	return function()
		if connection.Connected then
			destroy()
		end
	end
end

local destroyLook: { [Model]: () -> () } = {}
local stageWatch: { [Model]: RBXScriptConnection } = {}

function Kit.SetAwakened(character: Model, on: boolean)
	local watch = stageWatch[character]
	if watch then
		watch:Disconnect()
		stageWatch[character] = nil
	end
	local destroy = destroyLook[character]
	if destroy then
		destroyLook[character] = nil
		destroy()
	end
	if not on then
		return
	end
	local function rebuild()
		local old = destroyLook[character]
		if old then
			old()
		end
		destroyLook[character] = buildLook(character, character:GetAttribute("Ascended") == true)
	end
	rebuild()
	stageWatch[character] = character:GetAttributeChangedSignal("Ascended"):Connect(function()
		if character:GetAttribute("Awakened") == true then
			rebuild()
		end
	end)
end

---------------------------------------------------------------------------
-- Spawn entrance
---------------------------------------------------------------------------

-- A grimoire of its own (the Crown look poses its own copy): dark green
-- covers, open pages, a four-leaf clover of light turning over them.
type Book = { place: (CFrame, number, number) -> (), fade: (number) -> () }

local function makeBook(): Book
	local pages: { { part: BasePart, offset: CFrame, side: number } } = {}
	local function page(props: { [string]: any }, offset: CFrame, side: number)
		table.insert(pages, { part = U.newPart(props), offset = offset, side = side })
	end
	local cover = Color3.fromRGB(28, 70, 58)
	local paper = Color3.fromRGB(226, 234, 214)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, CFrame.new(0, 1.05, -0.4), 0)
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 8
	light.Brightness = 2
	light.Parent = pages[#pages].part
	local book = {}
	function book.place(frame: CFrame, open: number, t: number)
		for _, p in pages do
			local hinge = CFrame.Angles(0, -p.side * rad(open), 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = frame * hinge * spin * p.offset
		end
	end
	function book.fade(duration: number)
		light.Enabled = false
		local parts = {}
		for _, p in pages do
			table.insert(parts, p.part)
		end
		fadeOut(parts, duration)
	end
	return book
end

-- Wind gathers round him and his grimoire comes down out of the sky to
-- him, circling him as it opens, Sylph darting about; he reaches for it,
-- the clover flares and the wind bursts out, and Sylph is gone into him.
function handlers.Entrance(data, character, root)
	if data.phase ~= "Start" then
		return
	end
	play(character, ANIMS.Entrance)
	local book = makeBook()
	local sylph = makeSprite(1.2)
	every(2.2, function(elapsed)
		if not root.Parent then
			return false
		end
		local forward = root.CFrame.LookVector
		local right = root.CFrame.RightVector
		local position, open
		if elapsed < 0.6 then
			local eased = 1 - (1 - elapsed / 0.6) ^ 2
			position = root.Position + forward * 2.5 + UP * (1.5 + 18 * (1 - eased)) + right * 6 * (1 - eased)
			open = 0
		elseif elapsed < 1.2 then
			local a = (elapsed - 0.6) / 0.6
			local angle = a * math.pi * 2
			position = root.Position + (forward * math.cos(angle) + right * math.sin(angle)) * 2.5 + UP * 1.5
			open = 70 * a
		else
			position = root.Position + forward * 2.2 + UP * (1.8 + math.min((elapsed - 1.2) * 2, 0.8))
			open = 70
		end
		book.place(CFrame.lookAt(position, root.Position + UP * 1.5) * CFrame.Angles(rad(-15), 0, 0), open, elapsed)
		if elapsed < 1.2 then
			local angle = elapsed * 7
			sylph.place(
				CFrame.new(
					root.Position
						+ Vector3.new(math.cos(angle) * 3.5, 1.5 + math.sin(elapsed * 9), math.sin(angle) * 3.5)
				),
				elapsed
			)
			inflow(root.Position, 7)
		end
		return true
	end, function()
		book.fade(0.3)
	end)
	U.spiral(root, WIND, 3, 6, 1.2, 3, 0.1, 0.4)
	task.delay(1.2, function()
		sylph.fade(0.15)
		if not root.Parent then
			return
		end
		local position = root.Position
		gust(position + UP, 8, UP)
		U.shockwave(position, WIND, 3, 20, 0.45, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, 14, 0.4, 0.35)
		U.flash(position + root.CFrame.LookVector * 2.2 + UP * 2, STAR, 6, 0.25)
		U.light(position, WIND, 5, 26, 0.5)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(8)
		end
	end)
end

---------------------------------------------------------------------------
-- Movement: a green dash on the wind, and the gust under his air jump
---------------------------------------------------------------------------

local DASH_VECTORS = {
	Front = Vector3.new(0, 0, -1),
	Back = Vector3.new(0, 0, 1),
	Left = Vector3.new(-1, 0, 0),
	Right = Vector3.new(1, 0, 0),
}

VFX.RegisterKitEffect("Wind", "Dash", function(data)
	local character: Model? = data.character
	local root = U.getRoot(character)
	if not character or not root then
		return
	end
	local direction = if type(data.direction) == "string" then data.direction else "Front"
	U.afterimage(character, WIND, 0.3)
	for i = 1, 3 do
		task.delay(i * 0.05, function()
			if character.Parent then
				U.afterimage(character, if i == 3 then WIND_WHITE else WIND, 0.25)
			end
		end)
	end
	U.bodyTrail(character, WIND, 0.28)
	local ground = U.groundBelow(root.Position, { character })
	local feet = if ground then ground.Position else root.Position - UP * 3
	U.ringBurst(CFrame.new(feet + UP * 0.1), WIND, 0.6, 3.8, 0.25, 0.14)
	local away = -(root.CFrame:VectorToWorldSpace(DASH_VECTORS[direction] or DASH_VECTORS.Front))
	U.burst(root.Position - UP * 0.5, {
		color = WIND_WHITE,
		count = 10,
		size = 0.35,
		speed = NumberRange.new(16, 30),
		lifetime = NumberRange.new(0.12, 0.25),
		streaks = true,
		spread = 35,
		direction = away,
	})
	U.light(root.Position, WIND, 2, 10, 0.25)
end)

VFX.RegisterKitEffect("Wind", "AirJump", function(data)
	local character: Model? = data.character
	local root = U.getRoot(character)
	if not character or not root then
		return
	end
	local feet = root.Position - UP * 3
	U.ringBurst(CFrame.new(feet), WIND, 0.8, 4.2, 0.3, 0.16)
	U.burst(feet, {
		color = WIND_WHITE,
		count = 12,
		size = 0.4,
		speed = NumberRange.new(12, 26),
		lifetime = NumberRange.new(0.15, 0.3),
		streaks = true,
		spread = 50,
		direction = -UP,
	})
	U.afterimage(character, WIND, 0.2)
end)

function Kit.OnSkill(data)
	local character = data.character
	if typeof(character) ~= "Instance" or not character:IsA("Model") then
		return
	end
	local root = U.getRoot(character)
	local handler = handlers[data.skill]
	if root and handler then
		handler(data, character, root)
	end
end

return Kit
