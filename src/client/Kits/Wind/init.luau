--[[
	Prince of Wind (Yuno), client side: stance and spell animations, every
	spell's visuals and the Half-Crown / Full-Crown looks. The server sends
	("Skill", {skill, phase, ...}) events (Server/Kits/Wind) and every client
	draws them locally.

	Wind is pale green with a white core, star magic gold-white. Spells are
	built from anchored neon parts posed every frame, so they follow him and
	look the same at any ping.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DivePlan = require(ReplicatedStorage:WaitForChild("Shared").TempestDive)
local SaintPlan = require(ReplicatedStorage:WaitForChild("Shared").SaintZephyr)
local CameraShake = require(script.Parent.Parent.CameraShake)
local Cinematic = require(script.Parent.Parent.Cinematic)
local M1Animations = require(script.Parent.Parent.M1Animations)
local PoseAnimator = require(script.Parent.Parent.PoseAnimator)
local VFX = require(script.Parent.Parent.VFX)
local Saint = require(script.Saint)
local Soft = require(script.Soft)

type Animation = PoseAnimator.Animation
type Star = Soft.Star
type Sprite = Soft.Sprite
type Slash = Soft.Slash

local U = VFX.Util
local rad = math.rad
local UP = Vector3.yAxis

-- The palette and the soft wind everything is drawn with (see Soft).
local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE, STAR_FIRE = Soft.STAR, Soft.STAR_WHITE, Soft.STAR_FIRE
local SMOKE, SPARKLE = Soft.SMOKE, Soft.SPARKLE
local every, fadeOut, key = Soft.every, Soft.fadeOut, Soft.key
local bar, tube, stretch, newWedge = Soft.bar, Soft.tube, Soft.stretch, Soft.newWedge
local inflow, gust = Soft.inflow, Soft.gust
local makeStar, makeSprite = Soft.makeStar, Soft.makeSprite
local arcPoints, arcParts, poseArc = Soft.arcPoints, Soft.arcParts, Soft.poseArc
local worldAnchor, softBeam, fadeBeams, softRing = Soft.worldAnchor, Soft.softBeam, Soft.fadeBeams, Soft.softRing
local windRing, lightRing, windEmitter, windPuff = Soft.windRing, Soft.lightRing, Soft.windEmitter, Soft.windPuff
local windSlash, twinkle, starDust, streaks = Soft.windSlash, Soft.twinkle, Soft.starDust, Soft.streaks

local Kit = {}

VFX.SetPalette("Wind", { hit = WIND, heavy = WIND_DEEP, flash = WIND_WHITE })

---------------------------------------------------------------------------
-- Animations (generated by tools/anim/yuno_anims.py, see Animations.luau)
---------------------------------------------------------------------------

local function build(raw: { [string]: any }): Animation
	local keyframes = {}
	for _, key in raw.keys do
		table.insert(keyframes, {
			time = key[1],
			pose = key[2],
			easing = if key[3] then (Enum.EasingStyle :: any)[key[3]] else nil,
			direction = if key[4] then (Enum.EasingDirection :: any)[key[4]] else nil,
		})
	end
	return {
		keyframes = keyframes,
		loop = raw.loop,
		fadeIn = raw.fadeIn,
		fadeOut = raw.fadeOut,
		delays = raw.delays,
	}
end

local ANIMS: { [string]: Animation } = {}
for name, raw in require(script.Animations) do
	ANIMS[name] = build(raw)
end

-- Calm, upright stance; a light sprint with both arms swinging. The strides
-- are how far one loop (two steps) carries him (RUN_STRIDE / WALK_STRIDE
-- in tools/anim/yuno_anims.py), so the feet keep pace with the ground.
Kit.Idle = {
	stand = ANIMS.Idle,
	move = ANIMS.Run,
	walk = ANIMS.Walk,
	air = ANIMS.Air,
	moveSpeed = 16,
	walkSpeed = 8,
	moveStride = 10.88,
	walkStride = 6.13,
}

-- Awakened (Half-Crown and Full-Crown) he doesn't walk: he hovers on the
-- wind, rising and settling, and glides when he moves.
local HOVER = {
	stand = ANIMS.HoverIdle,
	move = ANIMS.HoverMove,
	air = ANIMS.HoverIdle, -- still carried on the wind (so a jump doesn't drop him)
	moveSpeed = 16,
}

-- The idle set for him right now (Moves asks when the kit is put on).
function Kit.IdleFor(character: Model): PoseAnimator.IdleSet
	return if character:GetAttribute("Awakened") == true then HOVER else Kit.Idle
end

local function play(character: Model, animation: Animation, onEvent: ((string) -> ())?)
	PoseAnimator.Play(character, animation, onEvent)
end

---------------------------------------------------------------------------
-- M1: wind-wrapped strikes (the shared fist string), each with a gust
---------------------------------------------------------------------------

function Kit.PlayM1(character: Model, index: number, variant: string)
	local name = M1Animations.NameFor(index, variant)
	local animation = M1Animations.Clips[name]
	if not animation then
		return
	end
	local heavy = variant ~= "Normal"
	local strikers = M1Animations.Strikers[name] or {}
	play(character, animation, function(event)
		if event ~= "Strike" then
			return
		end
		for _, limbName in strikers do
			VFX.LimbTrail(character, limbName, if heavy then 0.2 else 0.13, WIND)
			local limb = character:FindFirstChild(limbName)
			if limb and limb:IsA("BasePart") then
				local tip = (limb.CFrame * CFrame.new(0, -1, 0)).Position
				local out = (limb.CFrame.LookVector * -1 + limb.CFrame.UpVector * -1).Unit
				U.burst(tip, {
					color = WIND_WHITE,
					count = if heavy then 10 else 5,
					size = 0.35,
					speed = NumberRange.new(10, 24),
					lifetime = NumberRange.new(0.1, 0.22),
					streaks = true,
					spread = 50,
					direction = out,
				})
				-- A breath of wind off the blow (a ring of it on the heavy ones).
				windPuff(tip, if heavy then 1.4 else 0.8, out)
				if heavy then
					lightRing(tip, out, 0.3, 2.4, 0.16, WIND_WHITE)
				end
			end
		end
		VFX.AirPop(character, heavy)
	end)
end

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------

local handlers: { [string]: (data: any, character: Model, root: BasePart) -> () } = {}

local function involves(data, character: Model): boolean
	return U.isLocal(character) or U.isLocal(data.target)
end

-- Bumped whenever a skill phase starts, so a loop drawing the last phase
-- stops as soon as that skill is released or cancelled.
local castTokens: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local function bump(character: Model): number
	local token = (castTokens[character] or 0) + 1
	castTokens[character] = token
	return token
end
local function live(character: Model, token: number): boolean
	return castTokens[character] == token and character.Parent ~= nil
end

local function handOf(character: Model, side: string): Vector3?
	local arm = character:FindFirstChild(side .. " Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.15, 0)).Position else nil
end

---------------------------------------------------------------------------
-- Base: Prince of Wind
---------------------------------------------------------------------------

-- Eases out (fast, then settling).
local function easeOut(u: number): number
	return 1 - (1 - math.clamp(u, 0, 1)) ^ 3
end

-- Eases in and out (0 to 1, no jolt at either end).
local function easeInOut(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

-- Feathers of wind flung out of a point, tumbling as they fade.
local function featherBurst(position: Vector3, count: number, speed: number)
	for _ = 1, count do
		local feather = newWedge({
			Size = Vector3.new(0.05, 0.28, 0.9),
			Color = WIND_WHITE,
			Material = Enum.Material.ForceField,
			Transparency = 0.1,
			CFrame = CFrame.new(position) * U.randomAngles(),
		})
		local out = U.randomUnit() * speed * (0.5 + math.random() * 0.5)
		local life = 0.45 + math.random() * 0.3
		U.tween(feather, life, {
			CFrame = CFrame.new(position + out * life + UP * 1.5) * U.randomAngles(),
			Transparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(life + 0.05, feather.Destroy, feather)
	end
end

-- Wind Blades Shower: a vortex of wind forms over the spot (rings of wind
-- turning, wind and glitter pouring down out of it) and a circle of wind
-- marks the ground under it; blades fill the sky in it (white blades with
-- pointed tips in a green glow) and fall in waves streaking wind, each
-- bursting where it lands.
local function fallingBlade(target: Vector3, formDelay: number, fallAt: number, alive: () -> boolean)
	local start = target + Vector3.new(math.random(-30, 30) / 10, 20 + math.random() * 6, math.random(-30, 30) / 10)
	local cframe = CFrame.lookAt(start, target) * CFrame.Angles(0, 0, math.random() * math.pi)
	local blade = U.newPart({ Size = Vector3.new(0.08, 0.5, 2.4), Color = WIND_WHITE, Transparency = 1 })
	local parts: { BasePart } = {
		blade,
		newWedge({ Size = Vector3.new(0.08, 0.25, 1.1), Color = WIND_WHITE, Transparency = 1 }),
		newWedge({ Size = Vector3.new(0.08, 0.25, 1.1), Color = WIND_WHITE, Transparency = 1 }),
		U.newPart({ Size = Vector3.new(0.04, 1.3, 4), Color = WIND, Transparency = 1 }),
	}
	local offsets = {
		CFrame.identity,
		CFrame.new(0, 0.125, -1.75),
		CFrame.new(0, -0.125, -1.75) * CFrame.Angles(0, 0, math.pi),
		CFrame.new(0, 0, -0.3),
	}
	local shown = { 0.05, 0.05, 0.05, 0.6 }
	for i, part in parts do
		part.CFrame = cframe * offsets[i]
	end
	local trails = {
		Soft.trail(blade, Vector3.new(0, 0.25, 1.2), Vector3.new(0, -0.25, 1.2), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new(0.2, 1),
			lifetime = 0.12,
		}),
		Soft.trail(blade, Vector3.new(0, 0.9, 1.2), Vector3.new(0, -0.9, 1.2), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new({ key(0, 0.55), key(1, 1) }),
			width = NumberSequence.new({ key(0, 1), key(1, 0.3) }),
			lifetime = 0.25,
			texture = SMOKE,
		}),
	}
	task.delay(formDelay, function()
		for i, part in parts do
			U.tween(part, 0.2, { Transparency = shown[i] })
		end
	end)
	task.delay(fallAt, function()
		if not alive() then
			-- Cancelled during the wind-up: the blade just fades.
			for _, trail in trails do
				Soft.endTrail(trail)
			end
			fadeOut(parts, 0.15)
			return
		end
		local drop = target - start
		for _, part in parts do
			U.tween(part, 0.14, { CFrame = part.CFrame + drop }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		task.delay(0.14, function()
			for _, trail in trails do
				Soft.endTrail(trail)
			end
			for i, part in parts do
				if i == 1 then
					Soft.linger(part, 0, 0.4) -- (the blade carries the trails)
				else
					part:Destroy()
				end
			end
			U.burst(target, {
				color = WIND_WHITE,
				count = 5,
				size = 0.35,
				speed = NumberRange.new(10, 22),
				lifetime = NumberRange.new(0.12, 0.25),
				streaks = true,
				spread = 70,
			})
			windPuff(target + UP * 0.3, 1.2, UP)
			lightRing(target + UP * 0.15, UP, 0.3, 2.6, 0.22, WIND_WHITE)
			U.ringBurst(CFrame.new(target + UP * 0.1), WIND, 0.4, 2.4, 0.22, 0.08)
			U.flash(target + UP * 0.3, WIND_WHITE, 1.6, 0.1)
		end)
	end)
end

-- Per cast, so only the Shower's own Cancel (not his next move) stops its
-- blades.
local showers: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any

function handlers.WindBladesShower(data, character, root)
	if data.phase == "Cast" then
		play(character, ANIMS.Shower)
		local id = (showers[character] or 0) + 1
		showers[character] = id
		local function alive(): boolean
			return showers[character] == id and character.Parent ~= nil
		end
		local center: Vector3 = data.center
		local radius: number = data.radius
		local delay: number = data.delay
		local length = delay + data.waves * data.gap
		-- Where it will fall: a circle of wind on the ground, and a vortex of
		-- wind in the sky over it, wind and glitter pouring down out of it.
		local sky = center + UP * 22
		local marks = {
			softRing({
				color = ColorSequence.new(WIND_WHITE),
				width0 = 0.25,
				width1 = 0.25,
				transparency = NumberSequence.new(0.35),
			}),
			softRing({
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 1.2,
				width1 = 1.2,
				transparency = NumberSequence.new(0.65),
				texture = SMOKE,
				speed = 2,
				length = 4,
			}),
			softRing({
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 2.8,
				width1 = 2.8,
				transparency = NumberSequence.new(0.5),
				texture = SMOKE,
				speed = 3,
				length = 6,
			}),
			softRing({
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 0.9,
				width1 = 0.9,
				transparency = NumberSequence.new(0.4),
				texture = SPARKLE,
				wrap = true,
				length = 1.5,
				speed = 2,
			}),
			softRing({
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 1.6,
				width1 = 1.6,
				transparency = NumberSequence.new(0.6),
				texture = SMOKE,
				speed = -2,
				length = 5,
			}),
		}
		local cloud =
			U.newPart({ Size = Vector3.new(radius * 2, 1, radius * 2), Transparency = 1, CFrame = CFrame.new(sky) })
		local pour = windEmitter(cloud, {
			Size = NumberSequence.new({ key(0, 2), key(1, 4.5) }),
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(14, 22),
			SpreadAngle = Vector2.new(6, 6),
			EmissionDirection = Enum.NormalId.Bottom,
			Shape = Enum.ParticleEmitterShape.Disc,
			Rate = 30,
		})
		local glitter = windEmitter(cloud, {
			Texture = SPARKLE,
			Color = ColorSequence.new(WIND_WHITE, WIND),
			LightEmission = 1,
			Transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
			Size = NumberSequence.new({ key(0, 0.4), key(1, 0) }),
			Lifetime = NumberRange.new(0.6, 1.1),
			Speed = NumberRange.new(16, 26),
			SpreadAngle = Vector2.new(5, 5),
			EmissionDirection = Enum.NormalId.Bottom,
			Shape = Enum.ParticleEmitterShape.Disc,
			Rate = 25,
		})
		every(length + 0.2, function(elapsed)
			if not alive() then
				return false
			end
			local open = easeOut(elapsed / 0.3)
			marks[1].set(CFrame.new(center + UP * 0.15) * CFrame.Angles(0, elapsed * 0.6, 0), radius * open + 0.05)
			marks[2].set(
				CFrame.new(center + UP * 0.2) * CFrame.Angles(0, -elapsed * 1.4, 0),
				radius * 0.9 * open + 0.05
			)
			marks[3].set(CFrame.new(sky) * CFrame.Angles(0, elapsed * 2.2, 0), (radius + 2) * open + 0.05)
			marks[4].set(CFrame.new(sky - UP * 0.4) * CFrame.Angles(0, -elapsed * 1.6, 0), (radius + 0.5) * open + 0.05)
			marks[5].set(CFrame.new(sky + UP * 0.6) * CFrame.Angles(0, elapsed * 3, 0), radius * 0.55 * open + 0.05)
			return true
		end, function()
			for _, ring in marks do
				ring.fade(0.3)
			end
			pour.Enabled = false
			glitter.Enabled = false
			task.delay(1.2, cloud.Destroy, cloud)
		end)
		windRing(sky, UP, 1, radius + 4, 0.4)
		U.light(sky, WIND, 3, radius * 3, length)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, UP)
		end
		-- The wind-up: wind streams into his raised hand as the blades gather.
		every(delay, function()
			local palm = handOf(character, "Right")
			if not alive() or not palm then
				return false
			end
			inflow(palm, 5)
			return true
		end)
		for wave = 1, data.waves do
			for _ = 1, 3 do
				local angle = math.random() * math.pi * 2
				local spot = center
					+ Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * math.sqrt(math.random())
				fallingBlade(spot, math.random() * delay * 0.6, delay + (wave - 1) * data.gap, alive)
			end
		end
		task.delay(length, function()
			if not alive() then
				return
			end
			gust(center + UP, 6, UP)
			windRing(center + UP * 0.3, UP, 1, radius + 5, 0.45)
			lightRing(center + UP * 0.2, UP, 1, radius + 3, 0.35, WIND_WHITE)
			U.groundCracks(center, 6, radius * 0.7, WIND, 1)
			if (workspace.CurrentCamera.CFrame.Position - center).Magnitude < 40 then
				CameraShake.Add(0.12)
			end
		end)
	elseif data.phase == "Cancel" then
		showers[character] = (showers[character] or 0) + 1
	end
end

-- Swift White Hawk: a hawk of wind (white core, green wings beating, wind
-- streaming off its wingtips, a long ribbon of wind behind it) flies out
-- and curves after its target, bursting into feathers of wind when it
-- strikes.
local hawks: { [Model]: { done: boolean, position: Vector3, direction: Vector3 } } = {}

function handlers.SwiftWhiteHawk(data, character, root)
	if data.phase == "Cast" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			for _ = 1, 6 do
				inflow(hand, 4)
			end
			twinkle(hand, 2, WIND, 0.2)
		end
	elseif data.phase == "Fly" then
		local direction: Vector3 = data.direction
		local state = { done = false, position = data.origin :: Vector3, direction = direction }
		hawks[character] = state
		local target: Model? = data.target
		local body = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Color = WIND_WHITE })
		local aura = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.2, 2.2, 2.2),
			Color = WIND,
			Transparency = 0.65,
		})
		local head = U.newPart({ Size = Vector3.new(0.6, 0.6, 0.9), Color = WIND_WHITE })
		local wings = {
			U.newPart({ Size = Vector3.new(3, 0.08, 1.2), Color = WIND, Transparency = 0.2 }),
			U.newPart({ Size = Vector3.new(3, 0.08, 1.2), Color = WIND, Transparency = 0.2 }),
		}
		local tail = U.newPart({ Size = Vector3.new(1.2, 0.06, 1.6), Color = WIND, Transparency = 0.3 })
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 14
		light.Brightness = 3
		light.Parent = body
		-- Where it starts (before its trails go on, so they start there).
		local start = CFrame.lookAt(state.position, state.position + direction)
		body.CFrame = start
		wings[1].CFrame = start * CFrame.new(1.5, 0, 0.1)
		wings[2].CFrame = start * CFrame.new(-1.5, 0, 0.1)
		-- A long ribbon of wind behind it, and wind off each wingtip.
		local trails = {
			Soft.trail(body, Vector3.new(0, 1, 0.4), Vector3.new(0, -1, 0.4), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.35), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
				lifetime = 0.4,
				texture = SMOKE,
			}),
			Soft.trail(wings[1], Vector3.new(1.4, 0, -0.4), Vector3.new(1.4, 0, 0.4), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
				lifetime = 0.2,
			}),
			Soft.trail(wings[2], Vector3.new(-1.4, 0, -0.4), Vector3.new(-1.4, 0, 0.4), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
				lifetime = 0.2,
			}),
		}
		local glow = Soft.glow(body, WIND, 4.5, 0.86)
		local travelled = 0
		every(data.range / data.speed + 0.3, function(elapsed, dt)
			if state.done then
				return false
			end
			local targetRoot = target and U.getRoot(target)
			if targetRoot then
				local want = (targetRoot.Position - state.position).Unit
				local angle = math.acos(math.clamp(direction:Dot(want), -1, 1))
				if angle > 1e-3 then
					direction = direction:Lerp(want, math.min(1, data.turn * dt / angle)).Unit
				end
			end
			state.direction = direction
			local step = data.speed * dt
			state.position += direction * step
			travelled += step
			local frame = CFrame.lookAt(state.position, state.position + direction)
			body.CFrame = frame
			aura.CFrame = frame
			head.CFrame = frame * CFrame.new(0, 0.15, -0.8)
			local flap = math.sin(elapsed * 22) * rad(35)
			wings[1].CFrame = frame * CFrame.Angles(0, 0, flap) * CFrame.new(1.5, 0, 0.1)
			wings[2].CFrame = frame * CFrame.Angles(0, 0, -flap) * CFrame.new(-1.5, 0, 0.1)
			tail.CFrame = frame * CFrame.new(0, 0, 1.1)
			return travelled < data.range
		end, function()
			hawks[character] = nil
			for _, trail in trails do
				Soft.endTrail(trail)
			end
			glow.Enabled = false
			fadeOut({ aura, head, tail }, 0.12)
			Soft.linger(body, 0.12, 0.55)
			Soft.linger(wings[1], 0.12, 0.35)
			Soft.linger(wings[2], 0.12, 0.35)
		end)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, direction)
			windRing(hand, direction, 0.4, 4, 0.25)
		end
	elseif data.phase == "Burst" then
		local state = hawks[character]
		local direction = if state then state.direction else root.CFrame.LookVector
		if state then
			state.done = true
		end
		local position: Vector3 = data.position
		if data.fade then
			gust(position, 3)
			featherBurst(position, 6, 10)
			return
		end
		gust(position, 7)
		U.shockwave(position, WIND, 2, 9, 0.3)
		windRing(position, direction, 1, 9, 0.3)
		lightRing(position, direction, 0.5, 6, 0.22, WIND_WHITE)
		windPuff(position, 3, direction)
		featherBurst(position, 14, 18)
		U.burst(position, {
			color = WIND,
			count = 18,
			size = 0.6,
			speed = NumberRange.new(20, 40),
			lifetime = NumberRange.new(0.25, 0.5),
			spread = 180,
			drag = 3,
		})
		if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 30 then
			CameraShake.Add(0.15)
		end
	end
end

-- Heavenly Wind Ark: a great crescent of wind rises out of the ground in
-- front of him (on the ground) or sweeps down beneath him (in the air): a
-- white-hot edge in a broad glow of wind, carried up (or down) on a column
-- of wind.
function handlers.HeavenlyWindArk(data, character, root)
	if data.phase == "Cast" then
		play(character, if data.airborne then ANIMS.AirArk else ANIMS.Ark)
	elseif data.phase == "Carry" then
		-- Up together on a spiral of wind.
		for _, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				U.spiral(targetRoot, WIND, 2.5, 6, data.rise, 3, 0.12, 0.3)
				U.bodyTrail(target, WIND, 0.35)
			end
		end
		U.spiral(root, WIND_WHITE, 2.5, 6, 0.4, 2, 0.1, 0.3)
		U.bodyTrail(character, WIND, 0.35)
	elseif data.phase == "Rise" then
		local forward: Vector3 = data.direction
		local right = forward:Cross(UP).Unit
		local air = data.airborne == true
		local center = data.origin + forward * 5.5 + (if air then UP * -2 else UP * -3)
		local from, to = if air then math.pi * 1.05 else -0.05, if air then math.pi * 1.95 else math.pi * 1.05
		local points = arcPoints(center, right, UP, 6, from, to, 12)
		local outer = arcParts(points, 0.9, WIND, 0.45)
		local inner = arcParts(points, 0.3, WIND_WHITE, 0.05)
		local shift = if air then UP * -8 else UP * 9
		for _, part in outer do
			U.tween(part, 0.45, { CFrame = part.CFrame + shift, Transparency = 1 })
		end
		for _, part in inner do
			U.tween(part, 0.4, { CFrame = part.CFrame + shift, Transparency = 1 })
		end
		task.delay(0.5, function()
			for _, part in outer do
				part:Destroy()
			end
			for _, part in inner do
				part:Destroy()
			end
		end)
		-- The soft crescent over the arc, carried with it.
		local crescent = windSlash(points[1], points[#points], (if air then -UP else UP) * 6, 1.3, 0.08)
		crescent.move(shift, 0.45)
		task.delay(0.15, crescent.fade, 0.35)
		if air then
			U.burst(center, {
				color = WIND_WHITE,
				count = 20,
				size = 0.5,
				speed = NumberRange.new(30, 60),
				lifetime = NumberRange.new(0.2, 0.4),
				streaks = true,
				spread = 30,
				direction = -UP,
			})
			windRing(center, UP, 1, 10, 0.35)
			windPuff(center, 3, -UP)
		else
			U.pillar(center, WIND, 3.5, 14, 0.4, Enum.Material.ForceField, 0.3)
			-- A column of wind carrying it up.
			local foot, head = worldAnchor(center, UP), worldAnchor(center + UP * 16, UP)
			local column = {
				softBeam(foot, head, {
					color = ColorSequence.new(WIND_WHITE, WIND),
					width0 = 7,
					width1 = 9,
					transparency = NumberSequence.new({ key(0, 0.85), key(0.2, 0.5), key(1, 1) }),
					texture = SMOKE,
					speed = 8,
					length = 8,
				}),
				softBeam(foot, head, {
					color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
					width0 = 1.4,
					width1 = 0.6,
					transparency = NumberSequence.new({ key(0, 0.5), key(0.2, 0.25), key(1, 1) }),
				}),
			}
			fadeBeams(column, 0.45, { foot, head })
			U.burst(center, {
				color = WIND_WHITE,
				count = 24,
				size = 0.5,
				speed = NumberRange.new(35, 70),
				lifetime = NumberRange.new(0.2, 0.45),
				streaks = true,
				spread = 25,
				direction = UP,
			})
			windRing(center + UP * 0.3, UP, 1, 11, 0.4)
			lightRing(center + UP * 0.2, UP, 0.5, 8, 0.3, WIND_WHITE)
			windPuff(center + UP, 3, UP)
			U.groundCracks(center, 4, 5, WIND, 0.8)
			U.debris(center, 6, 30, 0.6)
		end
		U.light(center, WIND, 4, 18, 0.35)
		if U.isLocal(character) then
			CameraShake.Add(0.14)
			CameraShake.FovKick(5)
		end
	end
end

-- Gale White Bow: a great bow of wind in his left hand, the string drawn to
-- his chin, held through the volley; each arrow streaks out spinning (the
-- wind arrow below, shared by every arrow move).

-- A wind arrow: a white-hot shaft in a shimmer of wind, a four-bladed head
-- of light (one pair of blades white, the other gold), three fins of green
-- wind for fletching, a glow at the head and a ribbon of wind streaming off
-- the tail. Posed by its middle; -Z is where it points.
type Arrow = { place: (CFrame) -> (), destroy: (number) -> () }

local function makeArrow(scale: number): Arrow
	local s = scale
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local function add(part: BasePart, offset: CFrame)
		table.insert(parts, part)
		table.insert(offsets, offset)
	end
	add(U.newPart({ Size = Vector3.new(0.12, 0.12, 3.4) * s, Color = WIND_WHITE }), CFrame.identity)
	add(
		U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3.6, 0.5, 0.5) * s,
			Color = WIND,
			Material = Enum.Material.ForceField,
		}),
		CFrame.Angles(0, rad(90), 0)
	)
	for blade = 0, 1 do
		local turn = CFrame.Angles(0, 0, blade * math.pi / 2)
		local color = if blade == 0 then WIND_WHITE else STAR
		add(
			newWedge({ Size = Vector3.new(0.06, 0.28, 0.9) * s, Color = color }),
			turn * CFrame.new(0, 0.14 * s, -2.15 * s)
		)
		add(
			newWedge({ Size = Vector3.new(0.06, 0.28, 0.9) * s, Color = color }),
			turn * CFrame.new(0, -0.14 * s, -2.15 * s) * CFrame.Angles(0, 0, math.pi)
		)
	end
	for fin = 0, 2 do
		add(
			newWedge({ Size = Vector3.new(0.04, 0.36, 0.8) * s, Color = WIND, Transparency = 0.15 }),
			CFrame.Angles(0, 0, fin * math.pi * 2 / 3) * CFrame.new(0, 0.22 * s, 1.35 * s)
		)
	end
	local glow =
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7 * s, Color = STAR, Transparency = 0.45 })
	add(glow, CFrame.new(0, 0, -1.75 * s))
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 8 * s
	light.Brightness = 2
	light.Parent = glow
	-- A bright ribbon off the tail inside a broad soft contrail of wind, and
	-- glitter shed from the head.
	local trails = {
		Soft.trail(parts[1], Vector3.new(0, 0.18 * s, 1.6 * s), Vector3.new(0, -0.18 * s, 1.6 * s), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new(0.15, 1),
			lifetime = 0.2,
			off = true,
		}),
		Soft.trail(parts[1], Vector3.new(0, 0.7 * s, 1.6 * s), Vector3.new(0, -0.7 * s, 1.6 * s), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
			width = NumberSequence.new({ key(0, 0.6), key(0.3, 1), key(1, 0.2) }),
			lifetime = 0.4,
			texture = SMOKE,
			off = true,
		}),
	}
	local glitter = windEmitter(glow, {
		Texture = SPARKLE,
		Color = ColorSequence.new(STAR_WHITE, STAR),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 0.25), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.35 * s), key(1, 0) }),
		Lifetime = NumberRange.new(0.2, 0.4),
		Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(180, 180),
		Rate = 30,
	})
	local placed = false
	local arrow = {}
	function arrow.place(frame: CFrame)
		for i, part in parts do
			part.CFrame = frame * offsets[i]
		end
		if not placed then
			-- (Its trails start here, not wherever it was made.)
			placed = true
			for _, trail in trails do
				Soft.beginTrail(trail)
			end
		end
	end
	function arrow.destroy(duration: number)
		for _, trail in trails do
			Soft.endTrail(trail)
		end
		glitter.Enabled = false
		light.Enabled = false
		-- The shaft (its trails) and the head (its glitter) are kept, hidden,
		-- until what they left behind has faded.
		local rest = {}
		for i, part in parts do
			if i ~= 1 and part ~= glow then
				table.insert(rest, part)
			end
		end
		fadeOut(rest, duration)
		Soft.linger(parts[1], duration, 0.55)
		Soft.linger(glow, duration, 0.5)
	end
	return arrow
end

-- Where an arrow strikes: rings of wind and light, a burst of wind and a
-- white flash, starlight scattering.
local function arrowStrike(position: Vector3, direction: Vector3, scale: number)
	U.flash(position, WIND_WHITE, 2 * scale, 0.12)
	U.impactRing(position, direction, WIND_WHITE, 0.4, 2.6 * scale, 0.22)
	windRing(position, direction, 0.5, 4 * scale, 0.28)
	lightRing(position, direction, 0.3, 3 * scale, 0.2, WIND_WHITE)
	windPuff(position, 1.5 * scale, -direction)
	twinkle(position, 2.5 * scale, STAR, 0.2)
	gust(position, 2 + 2 * scale, -direction)
end

-- Moves a missile from `origin` along `direction` until it hits a wall or
-- the ground or runs out of range (people don't stop it here: the server
-- decides hits). `place(position, elapsed)` poses it every frame, `strike`
-- gets where it hit a wall, then `done` cleans it up.
local function fly(
	origin: Vector3,
	direction: Vector3,
	speed: number,
	range: number,
	place: (Vector3, number) -> (),
	strike: (Vector3) -> (),
	done: () -> ()
)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { U.folder }
	local position = origin
	local travelled = 0
	place(position, 0)
	every(range / speed + 0.1, function(elapsed, dt)
		local step = speed * dt
		local wall = workspace:Raycast(position, direction * step, params)
		local model = wall and wall.Instance:FindFirstAncestorWhichIsA("Model")
		if wall and not (model and model:FindFirstChildOfClass("Humanoid")) then
			strike(wall.Position)
			return false
		end
		position += direction * step
		travelled += step
		place(position, elapsed)
		return travelled < range
	end, done)
end

-- A wind arrow in flight, spinning (a new one, or one already drawn).
local function flyingArrow(
	origin: Vector3,
	direction: Vector3,
	speed: number,
	range: number,
	scale: number,
	drawn: Arrow?
)
	local arrow = drawn or makeArrow(scale)
	fly(origin, direction, speed, range, function(position, elapsed)
		arrow.place(CFrame.lookAt(position, position + direction) * CFrame.Angles(0, 0, elapsed * 14))
	end, function(position)
		arrowStrike(position, direction, scale)
	end, function()
		arrow.destroy(0.12)
	end)
end

-- The bow keeps an arrow nocked between shots (each one loosed is the arrow
-- that was on the string). Held on the ground, the arrow on the string
-- becomes a great one and the bow grows as he keeps drawing.
type Bow = {
	stop: () -> (),
	nocked: Arrow?,
	scale: number, -- of the nocked arrow
	ends: number, -- os.clock() when the bow goes
	charging: number?, -- os.clock() the great arrow started drawing
	glow: BasePart?,
	well: BasePart?, -- starlight drawn into the great arrow's head
}

-- The bow's glow: wind flowing along its limbs, sparkles along its edge.
local function bowArc(): Soft.Arc
	return Soft.softArc({
		{
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.1,
			width1 = 1.1,
			transparency = NumberSequence.new({ key(0, 0.9), key(0.5, 0.5), key(1, 0.9) }),
			texture = SMOKE,
			speed = 3,
			length = 3,
		},
		{
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.5,
			width1 = 0.5,
			transparency = NumberSequence.new({ key(0, 0.8), key(0.5, 0.35), key(1, 0.8) }),
			texture = SPARKLE,
			wrap = true,
			length = 0.8,
			speed = 2,
		},
	})
end
local bows: { [Model]: Bow } = {}

function handlers.GaleWhiteBow(data, character, root)
	if data.phase == "Draw" then
		play(character, ANIMS.Bow)
		local token = bump(character)
		local length = data.draw + data.arrows * data.gap + 0.25
		local segments = 10
		local limbs = arcParts(table.create(segments + 1, Vector3.zero), 0.22, WIND, 0.2)
		local core = arcParts(table.create(segments + 1, Vector3.zero), 0.08, WIND_WHITE, 0)
		local strings = { bar(Vector3.zero, UP, 0.05, WIND_WHITE, 0.2), bar(Vector3.zero, UP, 0.05, WIND_WHITE, 0.2) }
		local soft = bowArc()
		local all = table.clone(limbs)
		table.move(core, 1, #core, #all + 1, all)
		table.move(strings, 1, 2, #all + 1, all)
		local bow: Bow = {
			stop = function() end,
			nocked = makeArrow(1),
			scale = 1,
			ends = os.clock() + length,
		}
		function bow.stop()
			bows[character] = nil
			fadeOut(all, 0.2)
			soft.fade(0.2)
			if bow.nocked then
				bow.nocked.destroy(0.15)
				bow.nocked = nil
			end
			if bow.glow then
				fadeOut({ bow.glow }, 0.1)
				bow.glow = nil
			end
			if bow.well then
				local well = bow.well
				bow.well = nil
				for _, child in well:GetChildren() do
					if child:IsA("ParticleEmitter") then
						child.Enabled = false
					end
				end
				task.delay(0.6, well.Destroy, well)
			end
		end
		bows[character] = bow
		every(length + 2, function(elapsed)
			local hand = handOf(character, "Left")
			local pull = handOf(character, "Right")
			if not live(character, token) or not hand or not pull or not root.Parent or os.clock() > bow.ends then
				return false
			end
			local forward = root.CFrame.LookVector
			local right = forward:Cross(UP).Unit
			local grow = math.min(elapsed / 0.2, 1)
			local charge = if bow.charging then math.min((os.clock() - bow.charging) / 0.6, 1) else 0
			-- The grip stays put in his hand as the bow grows.
			local radius = (3.4 + 1.4 * charge) * grow + 0.1
			local center = hand + forward * (2.2 - radius)
			local points = arcPoints(center, forward, UP, radius, -1.1, 1.1, segments)
			poseArc(limbs, points)
			poseArc(core, points)
			soft.set(center, forward, UP, radius, -1.1, 1.1)
			local nock = pull + right * 0.1
			strings[1].Size = Vector3.new(0.05, 0.05, (points[1] - nock).Magnitude)
			strings[1].CFrame = CFrame.lookAt(points[1]:Lerp(nock, 0.5), nock)
			strings[2].Size = Vector3.new(0.05, 0.05, (points[#points] - nock).Magnitude)
			strings[2].CFrame = CFrame.lookAt(points[#points]:Lerp(nock, 0.5), nock)
			if bow.nocked then
				local frame = CFrame.lookAt(nock, nock + forward) * CFrame.new(0, 0, -1.6 * bow.scale)
				bow.nocked.place(frame * CFrame.Angles(0, 0, charge * elapsed * 6))
				if bow.glow then
					-- Wind spirals into the head as it draws.
					local head = (frame * CFrame.new(0, 0, -2.3 * bow.scale)).Position
					bow.glow.Size = Vector3.one * (0.8 + 2.6 * charge) * (1 + 0.1 * math.sin(elapsed * 30))
					bow.glow.CFrame = CFrame.new(head)
					if bow.well then
						bow.well.CFrame = CFrame.new(head)
					end
					inflow(head, 5 + 2 * charge)
				end
			end
			return true
		end, function()
			if bows[character] == bow then
				bow.stop()
			end
		end)
	elseif data.phase == "Arrow" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local bow = bows[character]
		local nocked = if bow and not data.last then bow.nocked else nil
		if bow and nocked then
			-- The arrow on the string flies; the next one forms there.
			bow.nocked = nil
			task.delay(0.06, function()
				if bows[character] == bow and not bow.nocked then
					bow.nocked = makeArrow(1)
				end
			end)
		elseif bow and bow.nocked then
			bow.nocked.destroy(0.05)
			bow.nocked = nil
		end
		flyingArrow(origin, direction, data.speed, data.range, if data.last then 1.4 else 1, nocked)
		gust(origin, if data.last then 4 else 2, direction)
		U.impactRing(origin, direction, WIND_WHITE, 0.4, if data.last then 4 else 2.4, 0.18)
		windRing(origin, direction, 0.4, if data.last then 5 else 3, 0.22)
		twinkle(origin, if data.last then 3 else 1.8, WIND, 0.16)
		if U.isLocal(character) then
			CameraShake.FovKick(if data.last then 5 else 2)
		end
	elseif data.phase == "Charge" then
		-- Held on the ground: the arrow on the string becomes a great one.
		local bow = bows[character]
		if bow then
			if bow.nocked then
				bow.nocked.destroy(0.05)
			end
			bow.nocked = makeArrow(1.8)
			bow.scale = 1.8
			bow.charging = os.clock()
			bow.ends = os.clock() + data.max + 0.6
			bow.glow = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, Color = WIND, Transparency = 0.55 })
			-- Starlight and wind drawn in to its head.
			local well = U.newPart({
				Size = Vector3.one * 7,
				Transparency = 1,
				CFrame = CFrame.new(handOf(character, "Right") or root.Position),
			})
			windEmitter(well, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.2), key(1, 0.6) }),
				Size = NumberSequence.new({ key(0, 0.5), key(1, 0.1) }),
				Lifetime = NumberRange.new(0.35, 0.45),
				Speed = NumberRange.new(8, 10),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 45,
			})
			windEmitter(well, {
				Size = NumberSequence.new({ key(0, 2.5), key(1, 0.5) }),
				Lifetime = NumberRange.new(0.35, 0.45),
				Speed = NumberRange.new(8, 10),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 20,
			})
			bow.well = well
		end
		local pull = handOf(character, "Right")
		if pull then
			gust(pull, 3)
		end
		if U.isLocal(character) then
			CameraShake.Add(0.05)
		end
	elseif data.phase == "Great" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local bow = bows[character]
		local drawn = if bow then bow.nocked else nil
		if bow then
			bow.nocked = nil
			bow.stop()
		end
		flyingArrow(origin, direction, data.speed, data.range, 1.8, drawn)
		U.flash(origin, WIND_WHITE, 7, 0.18)
		twinkle(origin, 7, STAR, 0.3)
		gust(origin, 7, direction)
		U.shockwave(origin, WIND, 2, 12, 0.3)
		for i = 0, 3 do
			task.delay(i * 0.03, U.impactRing, origin + direction * i * 3, direction, WIND_WHITE, 1, 7 - i, 0.28)
		end
		-- The air it tears through rings behind it: rings of wind and light
		-- out along its line, and a wake of wind.
		for i = 0, 5 do
			task.delay(i * 0.035, function()
				local at = origin + direction * (4 + i * 6)
				windRing(at, direction, 1, 8 - i * 0.6, 0.35)
				lightRing(at, direction, 0.5, 6 - i * 0.5, 0.25, WIND_WHITE)
			end)
		end
		local a0, a1 = worldAnchor(origin, direction), worldAnchor(origin + direction * 40, direction)
		fadeBeams({
			softBeam(a0, a1, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 5,
				width1 = 1,
				transparency = NumberSequence.new({ key(0, 0.4), key(1, 1) }),
				texture = SMOKE,
				speed = 12,
				length = 10,
			}),
		}, 0.5, { a0, a1 })
		windPuff(origin, 4, -direction)
		U.light(origin, WIND, 6, 28, 0.35)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(9)
		end
		task.delay(0.2, function()
			if PoseAnimator.Current(character) == ANIMS.Bow then
				PoseAnimator.FadeOut(character, 0.25)
			end
		end)
	elseif data.phase == "Cancel" then
		bump(character)
		local bow = bows[character]
		if bow then
			bow.stop()
		end
	end
end

---------------------------------------------------------------------------
-- R: Conjunction
---------------------------------------------------------------------------

local stars: { [Model]: Star } = {}

function handlers.Conjunction(data, character, root)
	if data.phase == "Place" then
		play(character, ANIMS.Conjunction)
		local old = stars[character]
		if old then
			old.fade(0.1)
		end
		local origin: Vector3 = data.origin
		local spot: Vector3 = data.star
		local star = makeStar(1.8)
		stars[character] = star
		-- Flicked out to its spot on a thread of starlight, then it hangs
		-- there turning, pulsing, a soft ring of starlight round it.
		local from, at = worldAnchor(origin), worldAnchor(origin)
		local thread = Soft.starStream(from, at, 0.35, 5)
		task.delay(0.15, fadeBeams, { thread }, 0.25, { from, at })
		local halo = softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.3,
			width1 = 0.3,
			transparency = NumberSequence.new(0.45),
			texture = SPARKLE,
			wrap = true,
			length = 0.8,
			speed = 1,
		})
		local arrived = false
		every(data.life, function(elapsed)
			if stars[character] ~= star then
				return false
			end
			local travel = math.min(elapsed / 0.15, 1)
			local position = origin:Lerp(spot, 1 - (1 - travel) ^ 2)
			star.place(position + UP * math.sin(elapsed * 3) * 0.15, elapsed * 2.5)
			if at.Parent then
				at.CFrame = CFrame.new(position)
			end
			local camera = workspace.CurrentCamera.CFrame.Position
			halo.set(
				CFrame.lookAt(position, camera) * CFrame.Angles(rad(90), 0, 0),
				(1.6 + 0.15 * math.sin(elapsed * 4)) * travel + 0.05
			)
			if travel >= 1 and not arrived then
				arrived = true
				twinkle(spot, 4, STAR, 0.25)
			end
			return true
		end, function()
			halo.fade(0.2)
			if stars[character] == star then
				stars[character] = nil
				star.fade(0.3)
			end
		end)
		U.ringBurst(CFrame.new(spot), STAR, 0.4, 3, 0.35, 0.1)
		lightRing(spot, UP, 0.3, 3.5, 0.3)
	elseif data.phase == "Warp" then
		local star = stars[character]
		stars[character] = nil
		if star then
			star.fade(0.15)
		end
		local from: Vector3 = data.from
		local spot: Vector3 = data.star
		play(character, ANIMS.Warp)
		-- Gone in a flash of starlight, and there: a stream of starlight
		-- along the way he went, wind left swirling where he was.
		local line = bar(from, spot, 0.25, STAR_WHITE, 0.1)
		local glow = bar(from, spot, 0.9, STAR, 0.6)
		fadeOut({ line, glow }, 0.25)
		local a0, a1 = worldAnchor(from, spot - from), worldAnchor(spot, spot - from)
		fadeBeams({
			Soft.starStream(a0, a1, 1.2, 14),
			softBeam(a0, a1, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 2.5,
				width1 = 4,
				transparency = NumberSequence.new({ key(0, 0.6), key(1, 0.75) }),
				texture = SMOKE,
				speed = 10,
				length = 6,
			}),
		}, 0.35, { a0, a1 })
		windPuff(from, 2.5)
		for _, at in { from, spot } do
			twinkle(at, 5, STAR, 0.25)
			lightRing(at - UP * 2.6, UP, 0.5, 6, 0.3)
			U.flash(at, STAR_WHITE, 6, 0.25)
			U.ringBurst(CFrame.new(at - UP * 2.6), STAR, 1, 6, 0.3, 0.12)
			U.burst(at, {
				color = STAR,
				count = 14,
				size = 0.35,
				speed = NumberRange.new(8, 20),
				lifetime = NumberRange.new(0.3, 0.6),
				spread = 180,
				drag = 3,
			})
		end
		U.light(spot, STAR, 4, 16, 0.3)
		if U.isLocal(character) then
			CameraShake.FovKick(-6)
		end
	elseif data.phase == "Fade" then
		local star = stars[character]
		stars[character] = nil
		if star then
			star.fade(0.3)
		end
	end
end

---------------------------------------------------------------------------
-- Half-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Spirit Storm. The charge: Sylph's mana gathers in his palm as an orb of
-- storm, a white core in a green halo inside a shimmering shell, three
-- rings of wind whirling round it on tilted axes, wind streaming in from
-- all round and a ring drawn in along the ground. The beam: a white-hot
-- core in a green column inside a shimmering sheath, three helices of wind
-- twisting round it and spinning, rings tearing off along it, streaks
-- racing down it, the muzzle pulsing; it scars the ground it passes over
-- and bursts where it ends; when it stops the helices unwind and it
-- collapses.
local STORM_STRANDS = 3
local STORM_SEGMENTS = 18

function handlers.SpiritStorm(data, character, root)
	if data.phase == "Charge" then
		play(character, ANIMS.StormCharge)
		local token = bump(character)
		local orb = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Color = WIND_WHITE })
		local halo =
			U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.4, Color = WIND, Transparency = 0.5 })
		local shell = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			Color = WIND,
			Material = Enum.Material.ForceField,
		})
		local rings = {}
		for _ = 1, 3 do
			table.insert(
				rings,
				arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 10), 0.08, WIND_WHITE, 0.15)
			)
		end
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 12
		light.Brightness = 1
		light.Parent = orb
		-- A soft glow round it, a ring of wind whirling round it, and wind and
		-- glitter drawn into it from all round.
		local glow = Soft.glow(orb, WIND, 6, 0.85)
		local whirl = softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1,
			width1 = 1,
			transparency = NumberSequence.new(0.5),
			texture = SMOKE,
			speed = 4,
			length = 3,
		})
		local well = U.newPart({
			Size = Vector3.one * 10,
			Transparency = 1,
			CFrame = CFrame.new(handOf(character, "Right") or root.Position),
		})
		local drawn = {
			windEmitter(well, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.2), key(1, 0.6) }),
				Size = NumberSequence.new({ key(0, 0.5), key(1, 0.1) }),
				Lifetime = NumberRange.new(0.4, 0.5),
				Speed = NumberRange.new(10, 12),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 40,
			}),
			windEmitter(well, {
				Size = NumberSequence.new({ key(0, 3), key(1, 0.6) }),
				Lifetime = NumberRange.new(0.4, 0.5),
				Speed = NumberRange.new(10, 12),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 18,
			}),
		}
		local floor = softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.4,
			width1 = 1.4,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 3,
			length = 4,
		})
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Right")
			if not live(character, token) or not hand then
				return false
			end
			local grow = math.min(elapsed / data.duration, 1)
			local center = hand + root.CFrame.LookVector * 0.7
			well.CFrame = CFrame.new(center)
			whirl.set(
				CFrame.lookAt(center, center + root.CFrame.LookVector) * CFrame.Angles(rad(90), elapsed * 9, 0),
				1.2 + 2 * grow
			)
			floor.set(CFrame.new(root.Position - UP * 2.9) * CFrame.Angles(0, elapsed * 3, 0), 7 - 5.5 * grow)
			orb.Size = Vector3.one * (0.3 + 1.1 * grow)
			halo.Size = Vector3.one * (0.8 + 2.4 * grow)
			shell.Size = Vector3.one * (1 + 3.2 * grow)
			orb.CFrame = CFrame.new(center)
			halo.CFrame = orb.CFrame
			shell.CFrame = orb.CFrame * CFrame.Angles(elapsed * 3, elapsed * 2, 0)
			for r, ring in rings do
				local tilt = CFrame.Angles(r * 1.1 + elapsed * (3 + r), elapsed * (4 - r), r * 0.7)
				poseArc(
					ring,
					arcPoints(center, tilt.RightVector, tilt.UpVector, 0.7 + 1.7 * grow + r * 0.25, 0, math.pi * 2, 10)
				)
			end
			inflow(center, 6)
			inflow(center, 4)
			light.Brightness = 1 + 5 * grow
			return true
		end, function()
			glow.Enabled = false
			for _, emitter in drawn do
				emitter.Enabled = false
			end
			task.delay(0.6, well.Destroy, well)
			whirl.fade(0.1)
			floor.fade(0.15)
			fadeOut({ orb, halo, shell }, 0.08)
			for _, ring in rings do
				fadeOut(ring, 0.08)
			end
		end)
		U.spiral(root, WIND, 2.2, 4, data.duration, 2, 0.08, 0.6)
		if U.isLocal(character) then
			CameraShake.Add(0.06)
		end
	elseif data.phase == "Fire" then
		play(character, ANIMS.StormFire)
		local token = bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local length: number = data.length
		local finish = origin + direction * length
		local right = direction:Cross(UP)
		right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
		local up = right:Cross(direction).Unit

		local core = tube(origin, finish, 1.2, WIND_WHITE, 0)
		local column = tube(origin, finish, 4.2, WIND, 0.5)
		local sheath = tube(origin, finish, 6.4, WIND, 0)
		sheath.Material = Enum.Material.ForceField
		local haze = tube(origin, finish, 9, WIND_DEEP, 0.9)
		local strands: { { BasePart } } = {}
		for k = 1, STORM_STRANDS do
			local strand = {}
			for _ = 1, STORM_SEGMENTS do
				table.insert(
					strand,
					bar(
						origin,
						origin + direction,
						if k == 1 then 0.3 else 0.22,
						if k == 1 then WIND_WHITE else WIND,
						0.1
					)
				)
			end
			table.insert(strands, strand)
		end
		-- Streaks racing down the beam.
		local muzzle = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.lookAt(origin, finish) })
		local racing = Instance.new("ParticleEmitter")
		racing.Texture = U.textures.Spark
		racing.Color = ColorSequence.new(WIND_WHITE, WIND)
		racing.LightEmission = 1
		racing.LightInfluence = 0
		racing.EmissionDirection = Enum.NormalId.Front
		racing.Orientation = Enum.ParticleOrientation.VelocityParallel
		racing.Speed = NumberRange.new(150, 210)
		racing.Lifetime = NumberRange.new(length / 210, length / 150)
		racing.SpreadAngle = Vector2.new(5, 5)
		racing.Size = NumberSequence.new(0.7, 0.1)
		racing.Transparency = NumberSequence.new(0.1, 1)
		racing.Rate = 140
		racing.Parent = muzzle
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 28
		light.Brightness = 5
		light.Parent = core
		-- Soft wind round it all: a broad stream of wind racing down it, a
		-- chain of glitter, a wide haze, and ribbons of wind spiralling down
		-- it.
		local from, to = worldAnchor(origin, direction), worldAnchor(finish, direction)
		local flow = {
			softBeam(from, to, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 9,
				width1 = 11,
				transparency = NumberSequence.new({ key(0, 0.75), key(0.1, 0.55), key(0.9, 0.6), key(1, 0.85) }),
				texture = SMOKE,
				speed = 30,
				length = 12,
			}),
			softBeam(from, to, {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 2.4,
				width1 = 2.4,
				transparency = NumberSequence.new({ key(0, 0.6), key(0.1, 0.3), key(1, 0.45) }),
				texture = SPARKLE,
				wrap = true,
				length = 2.5,
				speed = 40,
			}),
			softBeam(from, to, {
				color = ColorSequence.new(WIND, WIND_DEEP),
				width0 = 16,
				width1 = 18,
				transparency = NumberSequence.new({ key(0, 0.95), key(0.15, 0.88), key(1, 0.9) }),
				texture = SMOKE,
				speed = 12,
				length = 20,
				emission = 0.6,
			}),
		}
		local stopHelix = Soft.helix(function()
			return origin, finish
		end, 3.4, 3, 0.3, 5, 0.9, data.duration)

		local nextRing, nextPulse, nextSplash = 0, 0, 0
		every(data.duration, function(elapsed)
			if not live(character, token) then
				return false
			end
			-- Three helices of wind, twisting round the beam and spinning.
			local spin = elapsed * 14
			for k, strand in strands do
				local phase = k * (math.pi * 2 / STORM_STRANDS) + spin
				local radius = 2.5 + 0.35 * math.sin(elapsed * 30 + k)
				local previous = origin
				for i, segment in strand do
					local s = i / #strand * length
					local angle = phase + s * 0.35
					local point = origin
						+ direction * s
						+ (right * math.cos(angle) + up * math.sin(angle)) * radius * math.min(s / 3, 1)
					segment.Size = Vector3.new(segment.Size.X, segment.Size.Y, (point - previous).Magnitude + 0.05)
					segment.CFrame = CFrame.lookAt(previous:Lerp(point, 0.5), point)
					previous = point
				end
			end
			local breathe = 1 + math.sin(elapsed * 40) * 0.07
			column.Size = Vector3.new(column.Size.X, 4.2 * breathe, 4.2 * breathe)
			core.Size =
				Vector3.new(core.Size.X, 1.2 + math.sin(elapsed * 55) * 0.18, 1.2 + math.sin(elapsed * 55) * 0.18)
			if elapsed >= nextRing then
				nextRing = elapsed + 0.035
				local at = origin + direction * (math.random() * length)
				if math.random() < 0.5 then
					U.impactRing(at, direction, WIND_WHITE, 2, 5.5, 0.2)
				else
					lightRing(at, direction, 2, 6, 0.2, WIND_WHITE)
				end
			end
			if elapsed >= nextPulse then
				nextPulse = elapsed + 0.1
				U.impactRing(origin, direction, WIND, 1.5, 7, 0.25)
				windRing(origin + direction * 2, direction, 1.5, 6, 0.25)
			end
			if elapsed >= nextSplash then
				-- Where it strikes, wind and glitter blast out of it.
				nextSplash = elapsed + 0.09
				windPuff(finish, 3, -direction)
				streaks(finish, 6, 50, -direction, 60)
			end
			return true
		end, function()
			-- The helices unwind outward and it all collapses.
			for _, strand in strands do
				for _, segment in strand do
					local out = segment.Position - (origin + direction * direction:Dot(segment.Position - origin))
					U.tween(segment, 0.3, {
						CFrame = segment.CFrame + (if out.Magnitude > 1e-3 then out.Unit * 2.5 else Vector3.zero),
						Transparency = 1,
					})
				end
				task.delay(0.32, function()
					for _, segment in strand do
						segment:Destroy()
					end
				end)
			end
			U.tween(core, 0.25, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
			fadeOut({ core, column, sheath, haze }, 0.3)
			for _, beam in flow do
				U.tween(beam, 0.3, { Width0 = 0.5, Width1 = 0.5 })
			end
			fadeBeams(flow, 0.32, { from, to })
			stopHelix()
			racing.Enabled = false
			task.delay(0.6, muzzle.Destroy, muzzle)
			gust(finish, 8, direction)
			U.shockwave(finish, WIND, 2, 14, 0.35)
			windRing(finish, direction, 2, 16, 0.4)
			lightRing(finish, direction, 1, 12, 0.3, WIND_WHITE)
		end)

		-- The ground it passes over is scarred.
		for along = 6, length, 6 do
			local ground = U.groundBelow(origin + direction * along, { character }, 7)
			if ground then
				task.delay(along / 300, function()
					U.groundCracks(ground.Position, 2, 4, WIND, 1.2)
					U.debris(ground.Position, 3, 25, 0.5)
				end)
			end
		end
		gust(origin, 6, direction)
		U.flash(origin, WIND_WHITE, 6, 0.2)
		twinkle(origin, 6, WIND, 0.25)
		U.impactRing(origin, direction, WIND_WHITE, 1, 9, 0.3)
		windRing(origin, direction, 1, 12, 0.35)
		U.light(origin, WIND, 6, 24, 0.7)
		if U.isLocal(character) then
			CameraShake.Add(0.25)
			CameraShake.FovKick(10)
		elseif (workspace.CurrentCamera.CFrame.Position - origin).Magnitude < 40 then
			CameraShake.Add(0.1)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- A full tornado: a hollow funnel of wind, narrow at the ground and wide at
-- the top. Its wall is bands of overlapping panels (dust-grey and pale,
-- streaked with glowing green), each band welded to a hub so turning it is
-- one write, dense enough that you can barely see through it; dust pours
-- off it and debris whirls round inside it. It rises out of the ground,
-- spins, and blows apart.
local TORNADO_BANDS = 12
local TORNADO_PANELS = 16
local TORNADO_SHADES = { WIND, Color3.fromRGB(150, 176, 160), Color3.fromRGB(96, 120, 106) }

type Tornado = { update: (t: number, visible: number) -> (), destroy: () -> () }

local function makeTornado(base: Vector3, height: number): Tornado
	local bands = {}
	local emitters = {}
	for k = 1, TORNADO_BANDS do
		local fraction = (k - 0.5) / TORNADO_BANDS
		local radius = 2.5 + 11 * fraction ^ 1.25
		local hub = U.newPart({
			Size = Vector3.one * 0.2,
			Transparency = 1,
			CFrame = CFrame.new(base + UP * (height * fraction)),
		})
		local panels = {}
		local width = 2 * math.pi * radius / TORNADO_PANELS * 1.3
		for j = 1, TORNADO_PANELS do
			local shade = (j + k) % 3 + 1
			local panel = Instance.new("Part")
			panel.Anchored = false
			panel.CanCollide = false
			panel.CanQuery = false
			panel.CanTouch = false
			panel.CastShadow = false
			panel.Massless = true
			panel.Material = if shade == 1 then Enum.Material.Neon else Enum.Material.SmoothPlastic
			panel.Color = TORNADO_SHADES[shade]
			panel.Transparency = 1
			panel.Size = Vector3.new(width, height / TORNADO_BANDS + 0.8, 0.5)
			-- Leaning into the spin, like streaks of wind.
			panel.CFrame = hub.CFrame
				* CFrame.Angles(0, j / TORNADO_PANELS * math.pi * 2, 0)
				* CFrame.new(0, 0, -radius)
				* CFrame.Angles(0, 0, rad(18))
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hub
			weld.Part1 = panel
			weld.Parent = panel
			panel.Parent = U.folder
			table.insert(panels, { part = panel, solid = if shade == 1 then 0.35 else 0.18 })
			if k % 2 == 0 and j % 4 == 0 then
				local dust = Instance.new("ParticleEmitter")
				dust.Texture = U.textures.Smoke
				dust.Color = ColorSequence.new(Color3.fromRGB(170, 190, 175))
				dust.LightInfluence = 0.6
				dust.Size = NumberSequence.new(2.5, 4.5)
				dust.Transparency = NumberSequence.new(0.45, 1)
				dust.Lifetime = NumberRange.new(0.5, 0.8)
				dust.Rate = 0
				dust.Speed = NumberRange.new(0, 1)
				dust.Parent = panel
				table.insert(emitters, dust)
			end
		end
		table.insert(bands, { hub = hub, panels = panels, height = height * fraction, radius = radius, shown = -1 })
	end
	local debris = {}
	for _ = 1, 18 do
		table.insert(
			debris,
			U.newPart({
				Size = Vector3.new(0.4, 0.3, 0.5) * (1 + math.random() * 1.5),
				Color = Color3.fromRGB(92, 86, 78),
				Material = Enum.Material.Slate,
				Transparency = 1,
			})
		)
	end

	local tornado = {}
	-- `visible` 0 to 1: how much of it has risen out of the ground (bands
	-- appear from the foot up), then how solid it still is as it goes.
	function tornado.update(t: number, visible: number)
		for k, band in bands do
			band.hub.CFrame = CFrame.new(base + UP * band.height) * CFrame.Angles(0, t * (9 - k * 0.35) + k * 0.5, 0)
			local risen = math.clamp(visible * TORNADO_BANDS - (k - 1), 0, 1)
			local shown = math.floor(risen * 20 + 0.5) / 20
			if shown ~= band.shown then
				band.shown = shown
				for _, panel in band.panels do
					panel.part.Transparency = 1 - (1 - panel.solid) * shown
				end
			end
		end
		for _, dust in emitters do
			dust.Rate = if visible > 0.5 then 12 else 0
		end
		for i, chunk in debris do
			local fraction = (i - 0.5) / #debris
			local angle = t * (6 + i % 3) + i
			local radius = (2.5 + 11 * fraction ^ 1.25) * 0.75
			local position = base
				+ Vector3.new(
					math.cos(angle) * radius,
					height * 0.9 * fraction + math.sin(t * 2 + i) * 1.5,
					math.sin(angle) * radius
				)
			chunk.CFrame = CFrame.new(position) * CFrame.Angles(t * 5 + i, t * 3, 0)
			chunk.Transparency = if visible > fraction then 0 else 1
		end
	end
	function tornado.destroy()
		for _, band in bands do
			band.hub:Destroy()
			for _, panel in band.panels do
				panel.part:Destroy()
			end
		end
		for _, chunk in debris do
			chunk:Destroy()
		end
	end
	return tornado
end

-- Tempest Dive: he flies straight up dragging them by the collar (wind
-- trailing off them both); a beat at the top, then he swings over them, a
-- full tornado rises out of the ground under them, and he drives them down
-- through the eye of it. The camera goes inside for the way down. Once
-- they hit, the tornado stands over the crater a moment, then blows apart.
local function playTempestDive(data, character: Model, root: BasePart)
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = DivePlan.Plan(data.origin, data.start, data.floorY)
	-- The path starts where his body is (raised by his hover), so his hover
	-- goes at the same moment and he doesn't move.
	PoseAnimator.SettleLift(character, DivePlan.Times.Length)
	local times = DivePlan.Times
	local started = os.clock()
	local mine = involves(data, character)
	local floorY = plan.floorY
	local base = Vector3.new(plan.start.X, floorY, plan.start.Z)

	play(character, ANIMS.TempestDrag)
	U.bodyTrail(character, WIND, times.Lift)
	if target then
		U.bodyTrail(target, WIND_WHITE, times.Lift)
	end
	gust(plan.start, 6, UP)
	U.ringBurst(CFrame.new(base + UP * 0.2), WIND, 1, 9, 0.4, 0.3)
	windRing(base + UP * 0.3, UP, 1, 12, 0.45)
	windPuff(base + UP, 4, UP)
	-- Up on a whirl of wind: ribbons of wind round the two of them and a
	-- soft wake of wind behind.
	Soft.helix(function()
		local at = root.Position
		return at - UP * 6, at + UP * 3
	end, 3, 3, 0.35, 2.5, 0.8, times.Lift)
	local wakes: { Trail } = {}
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if torso then
		table.insert(
			wakes,
			Soft.trail(torso, Vector3.new(1.6, 0, 0), Vector3.new(-1.6, 0, 0), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.45), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.3) }),
				lifetime = 0.45,
				texture = SMOKE,
			})
		)
	end
	task.delay(times.Length, function()
		for _, wake in wakes do
			Soft.endTrail(wake)
		end
	end)

	local tornado = makeTornado(base, DivePlan.Height + 4)
	local formFrom = times.Flip - 0.25 -- it rises out of the ground as he turns them over
	local standUntil = times.Land + 0.6
	local finishAt = standUntil + 0.4
	local bind = "CloverTempestDive" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	local flipped, dove, risen = false, false, false
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > finishAt then
			finish()
			return
		end
		if t <= times.Length and root.Parent then
			root.CFrame = DivePlan.Attacker(plan, t)
		end
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = DivePlan.Victim(plan, t)
		end
		if not flipped and t >= times.Lift then
			flipped = true
			play(character, ANIMS.BoreasForm)
			local top = plan.start + UP * DivePlan.Height
			U.flash(top, WIND_WHITE, 6, 0.2)
			U.ringBurst(CFrame.new(top), WIND, 1, 8, 0.35, 0.2)
			windRing(top, UP, 1, 12, 0.4)
			lightRing(top, UP, 0.5, 9, 0.3, WIND_WHITE)
			windPuff(top, 3)
			if mine then
				CameraShake.Add(0.1)
			end
		end
		if not risen and t >= formFrom then
			risen = true
			U.ringBurst(CFrame.new(base + UP * 0.2), WIND_WHITE, 2, 16, 0.4, 0.5)
			U.debris(base, 14, 40, 0.8)
			windRing(base + UP * 0.4, UP, 3, 20, 0.5)
			-- The tornado's soft heart: wind streaming up its eye and ribbons
			-- of wind whirling up round its wall.
			local height = DivePlan.Height + 4
			local stand = finishAt - formFrom
			local foot, head = worldAnchor(base, UP), worldAnchor(base + UP * height, UP)
			local eye = {
				softBeam(foot, head, {
					color = ColorSequence.new(WIND_WHITE, WIND),
					width0 = 6,
					width1 = 20,
					transparency = NumberSequence.new({ key(0, 0.85), key(0.15, 0.6), key(0.9, 0.7), key(1, 1) }),
					texture = SMOKE,
					speed = 10,
					length = 14,
				}),
				softBeam(foot, head, {
					color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
					width0 = 1.5,
					width1 = 3,
					transparency = NumberSequence.new({ key(0, 0.7), key(0.2, 0.45), key(1, 0.9) }),
					texture = SPARKLE,
					wrap = true,
					length = 3,
					speed = 18,
				}),
			}
			task.delay(stand - 0.4, fadeBeams, eye, 0.4, { foot, head })
			Soft.helix(function()
				return base, base + UP * height
			end, 9, 4, 0.6, 2, 1.4, stand)
			if mine or (workspace.CurrentCamera.CFrame.Position - base).Magnitude < 70 then
				CameraShake.Add(0.2)
			end
		end
		if not dove and t >= times.Flip then
			dove = true
			play(character, ANIMS.BoreasChop)
			if mine then
				CameraShake.FovKick(10)
				U.speedLines(root, -UP, times.Land - times.Flip, WIND_WHITE)
			end
		end
		if t >= formFrom then
			local rising = math.clamp((t - formFrom) / 0.3, 0, 1)
			local going = math.clamp((t - standUntil) / 0.4, 0, 1)
			tornado.update(t, rising * (1 - going))
		end
	end)
	task.delay(finishAt + 0.1, function()
		finish()
		tornado.destroy()
	end)

	-- The camera: from the side on the way up, then inside the tornado on the
	-- way down, looking down past him at them, the walls whirling round.
	if mine then
		Cinematic.Camera(function(t)
			local focus = DivePlan.Victim(plan, math.min(t, times.Land)).Position
			local right = plan.forward:Cross(UP)
			if t < times.Flip - 0.05 then
				-- From the side, rising a little with them on the way up.
				local lift = -2 + 5 * easeInOut(t / times.Lift)
				local offset = right * 18 - plan.forward * 6 + UP * lift
				return CFrame.lookAt(focus + offset, focus), 72
			end
			-- Inside the tornado on the way down, then easing up and out of it
			-- as it stands over the crater.
			local after = easeInOut((t - times.Land) / 0.6)
			local eye = focus + UP * (9 + 7 * after) + right * (1.5 + 4 * after) - plan.forward * (0.5 + 3 * after)
			return CFrame.lookAt(eye, focus), 88 - 12 * after
		end, times.Length + 0.2)
	end
end

function handlers.TempestDive(data, character, root)
	local phase = data.phase
	if phase == "Reach" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, root.CFrame.LookVector)
		end
	elseif phase == "Whiff" then
		gust(root.Position + root.CFrame.LookVector * 4, 2)
	elseif phase == "Begin" then
		playTempestDive(data, character, root)
	elseif phase == "Impact" then
		-- Driven in hard: a dome of wind, a crater ring, the ground split
		-- and thrown up, a column of wind and dust.
		local position: Vector3 = data.position
		U.shockwave(position, WIND, 3, 26, 0.45, Enum.Material.ForceField)
		U.shockwave(position, WIND_WHITE, 2, 12, 0.25)
		U.ringBurst(CFrame.new(position + UP * 0.2), WIND_WHITE, 2, 16, 0.4, 0.45)
		U.ringBurst(CFrame.new(position + UP * 0.3), WIND, 1, 11, 0.5, 0.25)
		U.groundCracks(position, 12, 11, WIND, 1.6)
		U.groundRocks(position, 12, 7, 1.8)
		U.debris(position, 18, 45, 1)
		U.pillar(position, WIND, 3, 22, 0.45, Enum.Material.ForceField, 0.25)
		gust(position + UP, 9, UP)
		windRing(position + UP * 0.3, UP, 2, 26, 0.5)
		windRing(position + UP * 0.5, UP, 1, 16, 0.4, WIND_WHITE)
		lightRing(position + UP * 0.2, UP, 1, 20, 0.4, WIND_WHITE)
		windPuff(position + UP, 6, UP)
		streaks(position + UP, 24, 90, UP, 50)
		U.light(position, WIND, 6, 40, 0.6)
		local near = (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 60
		if near then
			U.colorGrade({ Brightness = 0.2, Contrast = 0.5, Saturation = -0.6 }, 0, 0.06, 0.25)
			CameraShake.Add(0.45)
		end
	end
end

-- Quartile Scutum: four stars at the corners of a rectangle in front of him
-- and beams of light between them, a pane of starlight filling it; it moves
-- with him, ripples where it's struck and fades when it drops.
local barriers: { [Model]: { ripple: (Vector3?) -> (), drop: () -> () } } = {}

function handlers.QuartileScutum(data, character, root)
	if data.phase == "Raise" then
		play(character, ANIMS.Scutum)
		local corners = {
			Vector3.new(-3.6, -2.6, -3.2),
			Vector3.new(3.6, -2.6, -3.2),
			Vector3.new(3.6, 3.2, -3.2),
			Vector3.new(-3.6, 3.2, -3.2),
		}
		local cornerStars = {}
		for _ = 1, 4 do
			table.insert(cornerStars, makeStar(1.4))
		end
		local edges = {}
		for _ = 1, 4 do
			table.insert(edges, bar(Vector3.zero, UP, 0.18, STAR_WHITE, 0.05))
		end
		local pane = U.newPart({
			Size = Vector3.new(7.2, 5.8, 0.1),
			Color = STAR,
			Transparency = 0.82,
			Material = Enum.Material.ForceField,
		})
		-- Streams of starlight running round its edges, glitter drifting off
		-- the pane.
		local anchors: { Attachment } = {}
		for _ = 1, 4 do
			table.insert(anchors, worldAnchor(root.Position))
		end
		local streams: { Beam } = {}
		for i = 1, 4 do
			table.insert(streams, Soft.starStream(anchors[i], anchors[i % 4 + 1], 0.6, 3))
		end
		pane.CFrame = root.CFrame * CFrame.new(0, 0.3, -3.2)
		local shimmer = windEmitter(pane, {
			Texture = SPARKLE,
			Color = ColorSequence.new(STAR_WHITE, STAR),
			LightEmission = 1,
			Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.4), key(1, 1) }),
			Size = NumberSequence.new({ key(0, 0.3), key(0.5, 0.45), key(1, 0) }),
			Lifetime = NumberRange.new(0.5, 0.9),
			Speed = NumberRange.new(0.3, 1),
			SpreadAngle = Vector2.new(180, 180),
			Shape = Enum.ParticleEmitterShape.Box,
			Rate = 22,
		})
		local done = false
		local function drop()
			done = true
			barriers[character] = nil
			for _, star in cornerStars do
				star.fade(0.25)
			end
			for _, anchor in anchors do
				starDust(anchor.WorldPosition, 5, 12)
			end
			shimmer.Enabled = false
			fadeBeams(streams, 0.25, anchors)
			fadeOut(edges, 0.25)
			fadeOut({ pane }, 0.25)
		end
		barriers[character] = {
			ripple = function(from: Vector3?)
				U.impactRing(pane.Position, pane.CFrame.LookVector, STAR_WHITE, 0.5, 4, 0.3)
				lightRing(pane.Position, pane.CFrame.LookVector, 0.3, 4.5, 0.3)
				twinkle(pane.Position, 4, STAR, 0.2)
				U.flash(pane.Position, STAR, 5, 0.15)
				if from then
					U.burst(pane.Position, {
						color = STAR,
						count = 10,
						size = 0.3,
						speed = NumberRange.new(10, 25),
						lifetime = NumberRange.new(0.15, 0.3),
						streaks = true,
						spread = 50,
						direction = (from - pane.Position).Unit,
					})
				end
			end,
			drop = drop,
		}
		for i, corner in corners do
			task.delay((i - 1) * 0.03, function()
				if root.Parent then
					twinkle(root.CFrame:PointToWorldSpace(corner), 3, STAR, 0.22)
				end
			end)
		end
		windPuff(root.CFrame:PointToWorldSpace(Vector3.new(0, 0.3, -3.2)), 2.5, root.CFrame.LookVector)
		every(data.duration + 0.5, function(elapsed)
			if done or not root.Parent then
				return false
			end
			local frame = root.CFrame
			local world = {}
			for i, corner in corners do
				world[i] = frame:PointToWorldSpace(corner)
				cornerStars[i].place(world[i], elapsed * 2 + i)
				anchors[i].CFrame = CFrame.new(world[i])
			end
			for i, edge in edges do
				local a, b = world[i], world[i % 4 + 1]
				local grow = math.min(elapsed / 0.15, 1)
				local tip = a:Lerp(b, grow)
				edge.Size = Vector3.new(0.18, 0.18, (tip - a).Magnitude + 0.05)
				edge.CFrame = CFrame.lookAt(a:Lerp(tip, 0.5), tip)
			end
			pane.CFrame = frame * CFrame.new(0, 0.3, -3.2)
			return true
		end, function()
			if not done then
				drop()
			end
		end)
	elseif data.phase == "Block" then
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(data.from)
		end
	elseif data.phase == "Drop" then
		local barrier = barriers[character]
		if barrier then
			barrier.drop()
		end
	elseif data.phase == "Reflect" then
		-- What it stopped goes back, twice as hard.
		local origin: Vector3 = data.origin
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(nil)
		end
		U.flash(origin, STAR_WHITE, 6, 0.2)
		if data.direction then
			-- A bolt of starlight back at whoever cast it.
			local direction: Vector3 = data.direction
			local star = makeStar(2.2)
			local position = origin
			local travelled = 0
			every(data.range / data.speed + 0.1, function(elapsed, dt)
				local step = data.speed * dt
				position += direction * step
				travelled += step
				star.place(position, elapsed * 12)
				local streak = bar(position, position - direction * 3.5, 0.35, STAR, 0.25)
				U.tween(streak, 0.2, { Transparency = 1, Size = Vector3.new(0.05, 0.05, 3.5) })
				task.delay(0.21, streak.Destroy, streak)
				return travelled < data.range
			end, function()
				star.fade(0.15)
				U.burst(position, {
					color = STAR,
					count = 12,
					size = 0.4,
					speed = NumberRange.new(14, 30),
					lifetime = NumberRange.new(0.15, 0.3),
					spread = 180,
				})
			end)
		else
			-- Straight back into them.
			local target: Vector3 = data.target
			local ray = bar(origin, target, 0.4, STAR_WHITE, 0)
			local glow = bar(origin, target, 1.4, STAR, 0.5)
			fadeOut({ ray, glow }, 0.2)
			U.shockwave(target, STAR, 1, 8, 0.25)
			U.burst(target, {
				color = STAR,
				count = 16,
				size = 0.45,
				speed = NumberRange.new(18, 36),
				lifetime = NumberRange.new(0.15, 0.3),
				streaks = true,
				spread = 180,
			})
		end
		if involves(data, character) then
			CameraShake.Add(0.15)
		end
	end
end

-- Quartile Hasta. Four stars open round his outstretched hand: a gold ring
-- and a counter-turning outer ring, the stars at the corners of a square of
-- light with a cross between them, starlight drawn in (in the air the sigil
-- opens bigger, face-down under his feet). Then:
--   tapped      the stars loose star bolts one after another, comets of
--               starlight that burst into stars where they strike;
--   held        their light pours into one lance he keeps on them (a
--               white-hot core, a gold glow, a shimmering sheath, four
--               strands of starlight twisting round it, rings bursting off
--               along it, a star flaring where it strikes), ending in a
--               blast;
--   in the air  a circle of gold opens on the ground below and star-fire
--               rains into it, each bolt bursting into flames where it lands.
local HASTA_STRANDS = 4
local HASTA_SEGMENTS = 14
type Sigil = { stars: { Star }, center: Vector3, aim: Vector3? }
type Lance = { set: (Vector3, Vector3, number) -> (), stop: () -> () }
local hastaSigils: { [Model]: Sigil } = {}
local hastaLances: { [Model]: Lance } = {}

local function stopLance(character: Model)
	local lance = hastaLances[character]
	if lance then
		hastaLances[character] = nil
		lance.stop()
	end
end

-- A cross of light flaring across `direction` at `position`.
local function crossGlint(position: Vector3, direction: Vector3, size: number)
	local right = direction:Cross(UP)
	right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
	for _, axis in { right, right:Cross(direction).Unit } do
		local line = bar(position - axis * size, position + axis * size, 0.22, STAR_WHITE, 0)
		U.tween(line, 0.35, { Size = Vector3.new(0.02, 0.02, size * 2.8), Transparency = 1 })
		task.delay(0.36, line.Destroy, line)
	end
end

-- The sigil, held until the cast ends.
local function openSigil(character: Model, root: BasePart, down: boolean)
	local token = bump(character)
	stopLance(character)
	local size = if down then 1.5 else 1
	local stars: { Star } = {}
	for _ = 1, 4 do
		table.insert(stars, makeStar(1.3 * size))
	end
	local inner = arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 16), 0.12, STAR, 0.1)
	local outer = arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 20), 0.08, STAR_WHITE, 0.3)
	local square, cross = {}, {}
	for _ = 1, 4 do
		table.insert(square, bar(Vector3.zero, UP, 0.12, STAR_WHITE, 0.05))
	end
	for _ = 1, 2 do
		table.insert(cross, bar(Vector3.zero, UP, 0.06, STAR, 0.4))
	end
	local core = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.5, Color = STAR, Transparency = 0.45 })
	local light = Instance.new("PointLight")
	light.Color = STAR
	light.Range = 12 * size
	light.Parent = core
	-- A soft glow at its heart, a glittering ring outside it and a ring of
	-- wind turning between.
	local glow = Soft.glow(core, STAR, 4 * size, 0.85)
	local glitter = softRing({
		color = ColorSequence.new(STAR_WHITE, STAR),
		width0 = 0.7 * size,
		width1 = 0.7 * size,
		transparency = NumberSequence.new(0.35),
		texture = SPARKLE,
		wrap = true,
		length = 1.2,
		speed = 3,
	})
	local whirl = softRing({
		color = ColorSequence.new(WIND_WHITE, WIND),
		width0 = 1.1 * size,
		width1 = 1.1 * size,
		transparency = NumberSequence.new(0.6),
		texture = SMOKE,
		speed = 3,
		length = 4,
	})
	local parts = table.clone(inner)
	for _, list in { outer, square, cross } do
		table.move(list, 1, #list, #parts + 1, parts)
	end
	table.insert(parts, core)
	local sigil: Sigil = { stars = stars, center = root.Position }
	hastaSigils[character] = sigil
	every(3.5, function(elapsed)
		local hand = handOf(character, "Right")
		if not live(character, token) or not hand or not root.Parent then
			return false
		end
		local center, frame
		if down then
			center = root.Position - UP * 3.4
			frame = CFrame.lookAt(center, center - UP, root.CFrame.LookVector)
		else
			local forward = sigil.aim or root.CFrame.LookVector
			center = hand + forward * 1.2
			frame = CFrame.lookAt(center, center + forward)
		end
		sigil.center = center
		local grow = math.min(elapsed / 0.2, 1)
		local radius = 2.2 * size * grow + 0.05
		-- It spins up while the lance pours out of it.
		local spin = elapsed * (if sigil.aim then 6 else 2.5)
		poseArc(inner, arcPoints(center, frame.RightVector, frame.UpVector, radius, spin, spin + math.pi * 2, 16))
		poseArc(
			outer,
			arcPoints(
				center,
				frame.RightVector,
				frame.UpVector,
				radius * 1.36,
				-spin * 0.7,
				-spin * 0.7 + math.pi * 2,
				20
			)
		)
		local corners = {}
		for i = 1, 4 do
			local angle = (i - 1) * math.pi / 2 + spin
			corners[i] = center + (frame.RightVector * math.cos(angle) + frame.UpVector * math.sin(angle)) * radius
			stars[i].place(corners[i], elapsed * 4 + i)
		end
		for i, edge in square do
			stretch(edge, corners[i], corners[i % 4 + 1])
		end
		stretch(cross[1], corners[1], corners[3])
		stretch(cross[2], corners[2], corners[4])
		core.Size = Vector3.one * (0.5 + 1.5 * size * grow * (1 + 0.15 * math.sin(elapsed * 30)))
		core.CFrame = CFrame.new(center)
		local flat = frame * CFrame.Angles(rad(90), 0, 0)
		glitter.set(flat * CFrame.Angles(0, -spin * 0.5, 0), radius * 1.62)
		whirl.set(flat * CFrame.Angles(0, spin * 1.3, 0), radius * 1.18)
		light.Brightness = 1 + 4 * math.min(elapsed / 0.4, 1)
		inflow(center, 5 * size, STAR)
		return true
	end, function()
		if hastaSigils[character] == sigil then
			hastaSigils[character] = nil
		end
		for _, star in stars do
			star.fade(0.2)
		end
		glow.Enabled = false
		glitter.fade(0.2)
		whirl.fade(0.2)
		fadeOut(parts, 0.2)
	end)
end

-- Where a star bolt strikes: it bursts into a star.
local function starBurst(position: Vector3, direction: Vector3, scale: number)
	local star = makeStar(2.4 * scale)
	star.place(position, math.random() * 6)
	task.delay(0.06, star.fade, 0.22)
	twinkle(position, 4 * scale, STAR, 0.22)
	lightRing(position, direction, 0.4, 4 * scale, 0.22)
	U.impactRing(position, direction, STAR_WHITE, 0.5, 3.5 * scale, 0.22)
	U.burst(position, {
		color = STAR,
		count = math.floor(10 * scale),
		size = 0.4,
		speed = NumberRange.new(16, 36),
		lifetime = NumberRange.new(0.15, 0.32),
		streaks = true,
		spread = 70,
		direction = -direction,
	})
	U.light(position, STAR, 4, 14 * scale, 0.25)
end

-- A star bolt: a comet of starlight, a star for a head, a white-hot streak
-- and a tail burning from gold to orange.
local function starBolt(origin: Vector3, direction: Vector3, speed: number, range: number, scale: number)
	local head = makeStar(1.1 * scale)
	local streak = bar(origin, origin + direction, 0.24 * scale, STAR_WHITE, 0)
	local glow = bar(origin, origin + direction, 0.9 * scale, STAR, 0.55)
	local tail0 = Instance.new("Attachment")
	tail0.Position = Vector3.new(0.4 * scale, 0, 0)
	tail0.Parent = streak
	local tail1 = Instance.new("Attachment")
	tail1.Position = Vector3.new(-0.4 * scale, 0, 0)
	tail1.Parent = streak
	local trail = Instance.new("Trail")
	trail.Attachment0 = tail0
	trail.Attachment1 = tail1
	trail.Color = ColorSequence.new(STAR_WHITE, STAR_FIRE)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Lifetime = 0.15
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Parent = streak
	local length = 3 * scale
	-- Glitter shed behind it, and a soft wake of starlight.
	local shed = windEmitter(streak, {
		Texture = SPARKLE,
		Color = ColorSequence.new(STAR_WHITE, STAR),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.4 * scale), key(1, 0) }),
		Lifetime = NumberRange.new(0.2, 0.45),
		Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(180, 180),
		Rate = 40,
	})
	local wake = Soft.trail(streak, Vector3.new(0.9 * scale, 0, 0), Vector3.new(-0.9 * scale, 0, 0), {
		color = ColorSequence.new(STAR_WHITE, STAR),
		transparency = NumberSequence.new({ key(0, 0.6), key(1, 1) }),
		width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
		lifetime = 0.3,
		texture = SMOKE,
	})
	fly(origin, direction, speed, range, function(position, elapsed)
		head.place(position, elapsed * 12)
		stretch(streak, position - direction * length, position)
		stretch(glow, position - direction * length * 1.5, position)
	end, function(position)
		starBurst(position, direction, scale)
	end, function()
		trail.Enabled = false
		shed.Enabled = false
		Soft.endTrail(wake)
		head.fade(0.1)
		fadeOut({ glow }, 0.12)
		Soft.linger(streak, 0.12, 0.5)
	end)
end

-- Star-fire: a bolt of burning starlight falls onto `spot` and bursts into
-- flames there.
local function starFire(from: Vector3, spot: Vector3)
	local fall = 0.18
	local head = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.9,
		Color = STAR_WHITE,
		CFrame = CFrame.new(from),
	})
	local glow =
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2.2, Color = STAR_FIRE, Transparency = 0.45 })
	local streak = bar(from, from + UP, 0.35, STAR_WHITE, 0.1)
	local flare = bar(from, from + UP, 1.1, STAR_FIRE, 0.5)
	local sparks = windEmitter(head, {
		Texture = SPARKLE,
		Color = ColorSequence.new(STAR_WHITE, STAR_FIRE),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.5), key(1, 0) }),
		Lifetime = NumberRange.new(0.2, 0.4),
		Speed = NumberRange.new(1, 4),
		SpreadAngle = Vector2.new(180, 180),
		Rate = 60,
	})
	every(fall, function(elapsed)
		local a = elapsed / fall
		local position = from:Lerp(spot, a * a)
		head.CFrame = CFrame.new(position)
		glow.CFrame = CFrame.new(position)
		stretch(streak, from:Lerp(position, 0.5), position)
		stretch(flare, from:Lerp(position, 0.3), position)
		return true
	end, function()
		sparks.Enabled = false
		fadeOut({ head, glow, streak, flare }, 0.06)
		twinkle(spot + UP * 0.6, 4, STAR_FIRE, 0.22)
		lightRing(spot + UP * 0.15, UP, 0.4, 4.5, 0.3)
		local holder = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(spot + UP * 0.6) })
		local fire = Instance.new("Fire")
		fire.Color = STAR
		fire.SecondaryColor = STAR_FIRE
		fire.Size = 4
		fire.Heat = 9
		fire.Parent = holder
		task.delay(1.1, function()
			fire.Enabled = false
		end)
		task.delay(2.6, holder.Destroy, holder)
		U.flash(spot + UP * 0.5, STAR_WHITE, 5, 0.18)
		U.burst(spot + UP * 0.3, {
			color = STAR_FIRE,
			count = 14,
			size = 0.45,
			speed = NumberRange.new(14, 34),
			lifetime = NumberRange.new(0.2, 0.5),
			spread = 50,
			direction = UP,
			acceleration = Vector3.new(0, 10, 0),
		})
		U.ringBurst(CFrame.new(spot + UP * 0.12), STAR, 0.5, 4, 0.3, 0.15)
		U.groundCracks(spot, 4, 2.6, STAR_FIRE, 1.2)
		U.light(spot + UP, STAR_FIRE, 5, 14, 0.5)
		if (workspace.CurrentCamera.CFrame.Position - spot).Magnitude < 30 then
			CameraShake.Add(0.03)
		end
	end)
end

-- The held lance, poured out of the sigil; `set` (each server tick) moves
-- where it strikes, smoothed here.
local function startLance(character: Model, root: BasePart): Lance
	local token = castTokens[character] or 0
	local at = root.Position
	local core = tube(at, at + UP, 1.6, STAR_WHITE, 0)
	local glow = tube(at, at + UP, 4.5, STAR, 0.55)
	local sheath = tube(at, at + UP, 7.5, STAR, 0)
	sheath.Material = Enum.Material.ForceField
	local mouth = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, Color = STAR_WHITE, Transparency = 0.2 })
	local light = Instance.new("PointLight")
	light.Color = STAR
	light.Range = 30
	light.Brightness = 5
	light.Parent = core
	local tip = makeStar(3.2)
	local rays: { BasePart } = {}
	for _ = 1, 4 do
		table.insert(rays, bar(at, at + UP, 0.18, STAR_WHITE, 0.15))
	end
	local strands: { { BasePart } } = {}
	for k = 1, HASTA_STRANDS do
		local strand = {}
		for _ = 1, HASTA_SEGMENTS do
			table.insert(
				strand,
				bar(at, at + UP, if k % 2 == 1 then 0.24 else 0.16, if k % 2 == 1 then STAR_WHITE else STAR, 0.1)
			)
		end
		table.insert(strands, strand)
	end
	-- Soft starlight round it: a glittering chain, a broad warm haze and
	-- ribbons of starlight spiralling round it.
	local from, to = worldAnchor(at), worldAnchor(at + UP)
	local softLance = {
		Soft.starStream(from, to, 3, 30),
		softBeam(from, to, {
			color = ColorSequence.new(STAR, STAR_FIRE),
			width0 = 12,
			width1 = 14,
			transparency = NumberSequence.new({ key(0, 0.92), key(0.1, 0.84), key(1, 0.88) }),
			texture = SMOKE,
			speed = 20,
			length = 16,
			emission = 0.7,
		}),
	}
	local spiralFrom, spiralTo = at, at + UP
	local stopHelix = Soft.helix(function()
		return spiralFrom, spiralTo
	end, 3.2, 4, 0.3, 4, 0.7, 4, STAR)
	local origin, target = at, at + root.CFrame.LookVector * 10
	local finish: Vector3? = nil
	local lastSet = os.clock()
	local stopped = false
	local nextRing, nextSpark = 0, 0
	local lance = {}
	function lance.set(newOrigin: Vector3, direction: Vector3, length: number)
		origin = newOrigin
		target = newOrigin + direction * length
		lastSet = os.clock()
	end
	function lance.stop()
		stopped = true
	end
	every(4, function(elapsed, dt)
		if stopped or not live(character, token) or os.clock() - lastSet > 0.5 or not root.Parent then
			return false
		end
		local sigil = hastaSigils[character]
		local start = if sigil then sigil.center else origin
		local now = if finish then finish:Lerp(target, 1 - math.exp(-dt * 14)) else target
		finish = now
		local along = now - start
		local length = along.Magnitude
		if length < 1 then
			return true
		end
		local direction = along.Unit
		if sigil then
			sigil.aim = direction
		end
		Soft.aim(from, start, direction)
		Soft.aim(to, now, direction)
		spiralFrom, spiralTo = start, now
		local right = direction:Cross(UP)
		right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
		local up = right:Cross(direction).Unit
		local grow = math.min(elapsed / 0.12, 1)
		local pulse = grow * (1 + 0.12 * math.sin(elapsed * 40))
		local middle = CFrame.lookAt(start:Lerp(now, 0.5), now) * CFrame.Angles(0, rad(90), 0)
		core.Size = Vector3.new(length, 1.6 * pulse, 1.6 * pulse)
		core.CFrame = middle
		glow.Size = Vector3.new(length, 4.5 * grow, 4.5 * grow)
		glow.CFrame = middle
		sheath.Size = Vector3.new(length, 7.5 * pulse, 7.5 * pulse)
		sheath.CFrame = middle * CFrame.Angles(elapsed * 10, 0, 0)
		mouth.Size = Vector3.one * 3.4 * pulse
		mouth.CFrame = CFrame.new(start)
		tip.place(now, elapsed * 5)
		local spin = elapsed * 16
		for k, strand in strands do
			local phase = k * (math.pi * 2 / HASTA_STRANDS) + spin
			local previous = start
			for i, segment in strand do
				local s = i / #strand * length
				local angle = phase + s * 0.3
				local point = start
					+ direction * s
					+ (right * math.cos(angle) + up * math.sin(angle)) * 3 * math.min(s / 4, 1)
				stretch(segment, previous, point)
				previous = point
			end
		end
		-- The stars pour their light into it.
		for i, ray in rays do
			local star = sigil and sigil.stars[i]
			if star then
				stretch(ray, star.parts[1].Position, start)
			end
		end
		if elapsed >= nextRing then
			nextRing = elapsed + 0.05
			U.impactRing(start + direction * (math.random() * length), direction, STAR_WHITE, 2, 5.5, 0.2)
		end
		if elapsed >= nextSpark then
			nextSpark = elapsed + 0.08
			U.burst(now, {
				color = STAR,
				count = 6,
				size = 0.45,
				speed = NumberRange.new(18, 40),
				lifetime = NumberRange.new(0.12, 0.3),
				streaks = true,
				spread = 75,
				direction = -direction,
			})
			U.impactRing(now, direction, STAR, 1, 4.5, 0.18)
		end
		return true
	end, function()
		stopped = true
		if hastaLances[character] == lance then
			hastaLances[character] = nil
		end
		light.Enabled = false
		tip.fade(0.2)
		stopHelix()
		fadeBeams(softLance, 0.25, { from, to })
		U.tween(core, 0.25, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
		U.tween(glow, 0.25, { Size = Vector3.new(glow.Size.X, 0.4, 0.4) })
		fadeOut({ core, glow, sheath, mouth }, 0.28)
		fadeOut(rays, 0.15)
		for _, strand in strands do
			fadeOut(strand, 0.2)
		end
	end)
	return lance
end

function handlers.QuartileHasta(data, character, root)
	local phase = data.phase
	if phase == "Stars" then
		play(character, if data.airborne then ANIMS.HastaRain else ANIMS.HastaStars)
		openSigil(character, root, data.airborne == true)
		if U.isLocal(character) then
			CameraShake.Add(0.05)
		end
	elseif phase == "Bolt" then
		-- Loosed from one of the stars, bent to meet the server's line 20
		-- studs out.
		local sigil = hastaSigils[character]
		local star = sigil and sigil.stars[data.index]
		local muzzle = root.Position + root.CFrame.LookVector * 3 + UP * 0.8
		local from = if star then star.parts[1].Position else muzzle
		local direction = (muzzle + data.direction * 20 - from).Unit
		local scale = if data.last then 1.5 else 1
		U.flash(from, STAR_WHITE, 3 * scale, 0.12)
		U.impactRing(from, direction, STAR, 0.4, 2.2 * scale, 0.16)
		starBolt(from, direction, data.speed, data.range, scale)
		if U.isLocal(character) then
			CameraShake.FovKick(if data.last then 5 else 1.5)
		end
	elseif phase == "Beam" then
		local lance = hastaLances[character]
		if not lance then
			play(character, ANIMS.HastaBeam)
			lance = startLance(character, root)
			hastaLances[character] = lance
			local sigil = hastaSigils[character]
			local at: Vector3 = if sigil then sigil.center else data.origin
			U.flash(at, STAR_WHITE, 9, 0.2)
			crossGlint(at, data.direction, 6)
			U.light(at, STAR, 6, 30, 0.4)
			if U.isLocal(character) then
				CameraShake.Add(0.12)
				CameraShake.FovKick(6)
			end
		end
		lance.set(data.origin, data.direction, data.length)
		if U.isLocal(character) then
			CameraShake.Add(0.03)
		end
	elseif phase == "BeamEnd" then
		-- One last blast along it: a thick white lance thinning away, rings
		-- bursting off along it and a great star where it ends.
		stopLance(character)
		local sigil = hastaSigils[character]
		local start: Vector3 = if sigil then sigil.center else data.origin
		local finish: Vector3 = data.origin + data.direction * data.length
		local along = finish - start
		local direction: Vector3 = if along.Magnitude > 1e-3 then along.Unit else data.direction
		local length = along.Magnitude
		local core = tube(start, finish, 3.4, STAR_WHITE, 0)
		local glow = tube(start, finish, 9, STAR, 0.5)
		local sheath = tube(start, finish, 12, STAR, 0)
		sheath.Material = Enum.Material.ForceField
		U.tween(core, 0.35, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
		U.tween(glow, 0.35, { Size = Vector3.new(glow.Size.X, 0.5, 0.5) })
		U.tween(sheath, 0.3, { Size = Vector3.new(sheath.Size.X, 16, 16) })
		fadeOut({ core, glow, sheath }, 0.38)
		for i = 0, 10 do
			task.delay(
				i * 0.015,
				U.impactRing,
				start + direction * (length * i / 10),
				direction,
				STAR_WHITE,
				2.5,
				8,
				0.25
			)
		end
		for _ = 1, 8 do
			local twinkle = makeStar(0.9 + math.random() * 1.2)
			twinkle.place(start + direction * (math.random() * length) + U.randomUnit() * 2, math.random() * 6)
			task.delay(0.15 + math.random() * 0.3, twinkle.fade, 0.3)
		end
		crossGlint(start, direction, 8)
		U.flash(start, STAR_WHITE, 12, 0.25)
		twinkle(start, 10, STAR, 0.3)
		for i = 0, 5 do
			task.delay(i * 0.02, lightRing, start + direction * (length * i / 5), direction, 2, 9, 0.28)
		end
		windRing(start, direction, 2, 14, 0.35, STAR)
		local burst = makeStar(5.5)
		burst.place(finish, 0)
		task.delay(0.12, burst.fade, 0.4)
		twinkle(finish, 12, STAR, 0.35)
		starDust(finish, 26, 40)
		U.shockwave(finish, STAR, 2, 14, 0.4)
		U.burst(finish, {
			color = STAR,
			count = 24,
			size = 0.5,
			speed = NumberRange.new(20, 50),
			lifetime = NumberRange.new(0.2, 0.45),
			streaks = true,
			spread = 180,
		})
		U.light(start, STAR, 7, 34, 0.45)
		if U.isLocal(character) then
			CameraShake.FovKick(10)
			U.colorGrade({ Brightness = 0.12, Saturation = 0.15 }, 0, 0.05, 0.3)
		end
	elseif phase == "Rain" then
		-- A turning circle of gold on the ground below, stars on its rim.
		local center: Vector3 = data.center
		local radius: number = data.radius
		local token = castTokens[character] or 0
		local ground = center + UP * 0.15
		local rim =
			arcParts(arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 24), 0.25, STAR, 0.05)
		local inner = arcParts(
			arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 18),
			0.12,
			STAR_WHITE,
			0.3
		)
		local stars: { Star } = {}
		for _ = 1, 4 do
			table.insert(stars, makeStar(1.8))
		end
		local all = table.clone(rim)
		table.move(inner, 1, #inner, #all + 1, all)
		-- Soft light over the circle: a glittering rim and a warm haze of
		-- starlight turning the other way.
		local glitter = softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 1.2,
			width1 = 1.2,
			transparency = NumberSequence.new(0.35),
			texture = SPARKLE,
			wrap = true,
			length = 1.6,
			speed = 2,
		})
		local haze = softRing({
			color = ColorSequence.new(STAR, STAR_FIRE),
			width0 = 3,
			width1 = 3,
			transparency = NumberSequence.new(0.7),
			texture = SMOKE,
			speed = -2,
			length = 6,
		})
		U.ringBurst(CFrame.new(ground), STAR_WHITE, 0.5, radius, 0.35, 0.3)
		lightRing(ground, UP, 0.5, radius + 2, 0.35)
		U.light(center + UP * 3, STAR_FIRE, 4, radius * 2.5, data.duration + 0.8)
		every(data.duration + 1, function(elapsed)
			if not live(character, token) then
				return false
			end
			local grow = math.min(elapsed / 0.25, 1)
			local spin = elapsed * 1.2
			glitter.set(CFrame.new(ground) * CFrame.Angles(0, spin * 0.8, 0), radius * 1.08 * grow + 0.05)
			haze.set(CFrame.new(ground + UP * 0.05) * CFrame.Angles(0, -spin, 0), radius * 0.85 * grow + 0.05)
			poseArc(
				rim,
				arcPoints(ground, Vector3.xAxis, Vector3.zAxis, radius * grow + 0.05, spin, spin + math.pi * 2, 24)
			)
			poseArc(
				inner,
				arcPoints(
					ground,
					Vector3.xAxis,
					Vector3.zAxis,
					radius * 0.7 * grow + 0.05,
					-spin * 1.5,
					-spin * 1.5 + math.pi * 2,
					18
				)
			)
			for i, star in stars do
				local angle = (i - 1) * math.pi / 2 + spin
				star.place(
					ground + Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * grow + UP * 0.8,
					elapsed * 3 + i
				)
			end
			return true
		end, function()
			for _, star in stars do
				star.fade(0.3)
			end
			glitter.fade(0.3)
			haze.fade(0.3)
			fadeOut(all, 0.3)
		end)
	elseif phase == "Fall" then
		-- Out of the sigil under his feet.
		local sigil = hastaSigils[character]
		local from: Vector3 = data.from
		if sigil then
			local offset = from - root.Position
			from = sigil.center + Vector3.new(offset.X, 0, offset.Z)
			U.flash(from, STAR_WHITE, 2, 0.1)
		end
		starFire(from, data.spot)
	elseif phase == "Done" or phase == "Cancel" then
		bump(character)
		stopLance(character)
		local current = PoseAnimator.Current(character)
		if current == ANIMS.HastaBeam or current == ANIMS.HastaStars then
			PoseAnimator.FadeOut(character, 0.2)
		end
	end
end

---------------------------------------------------------------------------
-- Full-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Looks (built further down); moves can hide his wind sword for a moment
-- (the halberd, the bow).
local looks: { [Model]: { hideSword: number, blade: BasePart? } } = {}

local function hideSword(character: Model, duration: number)
	local look = looks[character]
	if look then
		look.hideSword = os.clock() + duration
	end
end

-- Spirit of Euros: a recurve bow of wind (curled tips) and a giant wind
-- arrow that the wind spirals into as he draws, a glow swelling at its head;
-- loosed, it's gone in a blink, a white line all there is of it, then the
-- air along it rings.
local EUROS_SCALE = 3.6 -- the arrow, against a normal wind arrow
function handlers.SpiritOfEuros(data, character, root)
	if data.phase == "Draw" then
		play(character, ANIMS.EurosDraw)
		local token = bump(character)
		hideSword(character, data.duration + 0.4)
		local segments = 12
		local limbs = arcParts(table.create(segments + 1, Vector3.zero), 0.24, WIND, 0.15)
		local arrow = makeArrow(EUROS_SCALE)
		local charge = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, Color = WIND, Transparency = 0.6 })
		local all = table.clone(limbs)
		table.insert(all, charge)
		-- The bow glowing with wind, starlight and wind drawn into the head
		-- from all round, and ribbons of wind spiralling up the arrow into it.
		local soft = bowArc()
		local well = U.newPart({
			Size = Vector3.one * 12,
			Transparency = 1,
			CFrame = CFrame.new(handOf(character, "Left") or root.Position),
		})
		local drawn = {
			windEmitter(well, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.15), key(1, 0.6) }),
				Size = NumberSequence.new({ key(0, 0.7), key(1, 0.1) }),
				Lifetime = NumberRange.new(0.45, 0.55),
				Speed = NumberRange.new(11, 13),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 55,
			}),
			windEmitter(well, {
				Size = NumberSequence.new({ key(0, 4), key(1, 1) }),
				Lifetime = NumberRange.new(0.45, 0.55),
				Speed = NumberRange.new(11, 13),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 24,
			}),
		}
		local tail, head = root.Position, root.Position
		local stopHelix = Soft.helix(function()
			return tail, head
		end, 2.6, 3, 0.4, 2.5, 0.8, data.duration + 0.05)
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Left")
			local pull = handOf(character, "Right")
			if not live(character, token) or not hand or not pull then
				return false
			end
			local forward = root.CFrame.LookVector
			local center = hand - forward * 1.3
			-- Recurve: the tips curl forward again.
			local points = arcPoints(center, forward, UP, 3.6, -1.2, 1.2, segments)
			points[1] += forward * 0.7
			points[#points] += forward * 0.7
			poseArc(limbs, points)
			soft.set(center, forward, UP, 3.6, -1.2, 1.2)
			local tip = hand + forward * 1.6
			-- Nocked at his hand, the head far out past the bow.
			local frame = CFrame.lookAt(pull, tip) * CFrame.new(0, 0, -1.7 * EUROS_SCALE)
			arrow.place(frame * CFrame.Angles(0, 0, elapsed * 2))
			local point = (frame * CFrame.new(0, 0, -2.1 * EUROS_SCALE)).Position
			charge.Size = Vector3.one * (1 + 5 * math.min(elapsed / data.duration, 1))
			charge.CFrame = CFrame.new(point)
			well.CFrame = CFrame.new(point)
			tail, head = (frame * CFrame.new(0, 0, 1.6 * EUROS_SCALE)).Position, point
			inflow(point, 7)
			return true
		end, function()
			arrow.destroy(0.1)
			soft.fade(0.12)
			stopHelix()
			for _, emitter in drawn do
				emitter.Enabled = false
			end
			task.delay(0.6, well.Destroy, well)
			fadeOut(all, 0.1)
		end)
		windRing(root.Position - UP * 2.8, UP, 6, 1.5, data.duration)
	elseif data.phase == "Loose" then
		play(character, ANIMS.EurosLoose)
		bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local finish = origin + direction * data.length
		flyingArrow(origin, direction, data.length / 0.08, data.length, EUROS_SCALE)
		local line = bar(origin, finish, 0.6, WIND_WHITE, 0)
		local glow = bar(origin, finish, 3.5, WIND, 0.55)
		U.tween(line, 0.45, { Size = Vector3.new(0.04, 0.04, line.Size.Z) })
		fadeOut({ line, glow }, 0.45)
		-- The line it leaves: glittering, wind streaming down it in a broad
		-- haze, and the air ringing all along it.
		local a0, a1 = worldAnchor(origin, direction), worldAnchor(finish, direction)
		local wake = {
			Soft.starStream(a0, a1, 1.6, 40),
			softBeam(a0, a1, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 9,
				width1 = 5,
				transparency = NumberSequence.new({ key(0, 0.55), key(1, 0.8) }),
				texture = SMOKE,
				speed = 30,
				length = 16,
			}),
		}
		for _, beam in wake do
			U.tween(beam, 0.5, { Width0 = beam.Width0 * 0.1, Width1 = beam.Width1 * 0.1 })
		end
		fadeBeams(wake, 0.5, { a0, a1 })
		for i = 0, 8 do
			task.delay(i * 0.02, U.impactRing, origin:Lerp(finish, i / 8), direction, WIND_WHITE, 1.5, 6, 0.3)
			task.delay(i * 0.02 + 0.01, lightRing, origin:Lerp(finish, (i + 0.5) / 8), direction, 1, 7, 0.3, WIND_WHITE)
		end
		windRing(origin, direction, 1, 12, 0.35)
		twinkle(origin, 6, WIND, 0.25)
		twinkle(finish, 10, STAR, 0.3)
		U.flash(finish, WIND_WHITE, 8, 0.2)
		gust(finish, 6, direction)
		windPuff(finish, 5, direction)
		U.light(origin, WIND, 5, 24, 0.3)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- Saint Spirit of Zephyr: drawn by the Saint module (with his animations
-- and his sword lent to it).
local saintContext: Saint.Context = {
	anims = ANIMS,
	play = play,
	blade = function(character: Model): BasePart?
		local look = looks[character]
		return look and look.blade
	end,
	hideSword = hideSword,
}

function handlers.SaintSpiritOfZephyr(data, character, root)
	Saint.Handle(data, character, root, saintContext)
end

-- Spirit of Boreas: a great axe of wind forms in his raised hands (a haft
-- of light and a crescent head: a white-hot edge round a see-through blade
-- of wind, wind pouring off it), comes down in one chop, and the ground
-- splits in a line ahead: the earth bursting up along it in a wave, a seam
-- of wind down it, cracks and rocks. From the air it chops down at the
-- ground ahead and below.
local AXE_HAFT = 7
type Axe = { swing: (number) -> (), stop: () -> () }
local axes: { [Model]: Axe } = {}

local function windAxe(character: Model, root: BasePart): Axe
	local hub = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1 })
	-- In the hub's space the haft runs up +Y from his hands and the head's
	-- edge faces -Z.
	local function at(position: Vector3, axis: Vector3): Attachment
		local x = axis.Unit
		local y = if math.abs(x.Y) > 0.98 then Vector3.zAxis else UP
		local z = x:Cross(y).Unit
		local attachment = Instance.new("Attachment")
		attachment.CFrame = CFrame.fromMatrix(position, x, z:Cross(x).Unit)
		attachment.Parent = hub
		return attachment
	end
	local h = AXE_HAFT
	local butt = at(Vector3.new(0, -1.5, 0), UP)
	local crown = at(Vector3.new(0, h, 0), UP)
	-- The head's crescent, from high on the haft out to the edge and back.
	local headTop = at(Vector3.new(0, h - 0.4, 0), Vector3.new(0, -2, -8))
	local edge = at(Vector3.new(0, h - 2.4, -4), Vector3.new(0, -1, 0))
	local headLow = at(Vector3.new(0, h - 4.4, 0), Vector3.new(0, -2, 8))
	local curve = 1.9
	local white = ColorSequence.new(STAR_WHITE, WIND_WHITE)
	local green = ColorSequence.new(WIND_WHITE, WIND)
	local beams = {
		softBeam(
			butt,
			crown,
			{ color = white, width0 = 0.3, width1 = 0.3, transparency = NumberSequence.new(0.15) },
			hub
		),
		softBeam(butt, crown, {
			color = green,
			width0 = 1.3,
			width1 = 1.3,
			transparency = NumberSequence.new(0.65),
			texture = SMOKE,
			speed = 2,
			length = 4,
		}, hub),
		softBeam(headTop, edge, {
			color = white,
			width0 = 0.2,
			width1 = 0.7,
			transparency = NumberSequence.new({ key(0, 0.4), key(1, 0.05) }),
			curve0 = curve,
			curve1 = curve,
		}, hub),
		softBeam(edge, headLow, {
			color = white,
			width0 = 0.7,
			width1 = 0.2,
			transparency = NumberSequence.new({ key(0, 0.05), key(1, 0.4) }),
			curve0 = curve,
			curve1 = curve,
		}, hub),
		softBeam(headTop, edge, {
			color = green,
			width0 = 1.2,
			width1 = 3.2,
			transparency = NumberSequence.new({ key(0, 0.7), key(1, 0.45) }),
			curve0 = curve,
			curve1 = curve,
			texture = SMOKE,
			speed = 2,
			length = 3,
		}, hub),
		softBeam(edge, headLow, {
			color = green,
			width0 = 3.2,
			width1 = 1.2,
			transparency = NumberSequence.new({ key(0, 0.45), key(1, 0.7) }),
			curve0 = curve,
			curve1 = curve,
			texture = SMOKE,
			speed = 2,
			length = 3,
		}, hub),
	}
	-- The blade itself: see-through wind filling the crescent.
	local upper = newWedge({
		Size = Vector3.new(0.1, 2, 4),
		Color = WIND_WHITE,
		Material = Enum.Material.ForceField,
		Transparency = 0.25,
	})
	local lower = newWedge({
		Size = Vector3.new(0.1, 2, 4),
		Color = WIND_WHITE,
		Material = Enum.Material.ForceField,
		Transparency = 0.25,
	})
	local pour = windEmitter(upper, {
		Size = NumberSequence.new({ key(0, 1), key(1, 3) }),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(2, 6),
		Drag = 3,
		Rate = 30,
		Enabled = false, -- (until the axe is in his hands)
	})
	-- Glitter along the edge, a glow round the head, and the head sweeps a
	-- sheet of wind behind it as it comes down.
	for _, pair in { { headTop, edge }, { edge, headLow } } do
		table.insert(
			beams,
			softBeam(pair[1], pair[2], {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 0.7,
				width1 = 0.7,
				transparency = NumberSequence.new({ key(0, 0.6), key(0.5, 0.25), key(1, 0.6) }),
				curve0 = curve,
				curve1 = curve,
				texture = SPARKLE,
				wrap = true,
				length = 1,
				speed = 3,
			}, hub)
		)
	end
	local glow = Soft.glow(upper, WIND, 6, 0.88)
	local sheet = Soft.trail(hub, Vector3.new(0, h - 0.6, 0), Vector3.new(0, h - 2.4, -4.2), {
		color = ColorSequence.new(WIND_WHITE, WIND),
		transparency = NumberSequence.new({ key(0, 0.25), key(1, 1) }),
		lifetime = 0.28,
		faceCamera = false,
		off = true,
	})
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 22
	light.Brightness = 3
	light.Parent = hub
	local swing = 0
	local alive = true
	every(4, function(elapsed)
		if not alive or not root.Parent then
			return false
		end
		local right, left = handOf(character, "Right"), handOf(character, "Left")
		local hands = if right and left then right:Lerp(left, 0.5) else root.Position + UP * 3
		local forward = root.CFrame.LookVector
		local side = root.CFrame.RightVector
		-- Raised over his head, then down at the ground ahead.
		local raised = (UP * 0.92 - forward * 0.3).Unit
		local struck = (forward * 0.85 - UP * 0.5).Unit
		local s = swing * swing * (3 - 2 * swing)
		local haft = raised:Lerp(struck, s).Unit
		local grow = math.min(elapsed / 0.2, 1)
		hub.CFrame = CFrame.fromMatrix(hands, side, haft)
		if alive then
			Soft.beginTrail(sheet) -- (once it's in his hands)
			pour.Enabled = true
		end
		upper.CFrame = hub.CFrame * CFrame.new(0, h - 1.4, -2)
		lower.CFrame = hub.CFrame * CFrame.new(0, h - 3.4, -2) * CFrame.Angles(0, 0, math.pi)
		upper.Size = Vector3.new(0.1, 2 * grow, 4 * grow)
		lower.Size = Vector3.new(0.1, 2 * grow, 4 * grow)
		return true
	end)
	local axe = {}
	function axe.swing(value: number)
		swing = value
	end
	function axe.stop()
		if not alive then
			return
		end
		alive = false
		pour.Enabled = false
		glow.Enabled = false
		light.Enabled = false
		Soft.endTrail(sheet)
		fadeOut({ upper, lower }, 0.25)
		fadeBeams(beams, 0.25)
		task.delay(0.6, hub.Destroy, hub) -- (after the sheet it swept has gone)
	end
	return axe
end

function handlers.SpiritOfBoreas(data, character, root)
	local phase = data.phase
	if phase == "Raise" then
		play(character, ANIMS.BoreasForm)
		local old = axes[character]
		if old then
			old.stop()
		end
		hideSword(character, data.duration + 0.6)
		local axe = windAxe(character, root)
		axes[character] = axe
		task.delay(data.duration + 0.8, function()
			if axes[character] == axe then
				axes[character] = nil
				axe.stop()
			end
		end)
		windPuff(root.Position + UP * 4, 3)
		windRing(root.Position + UP * 7, UP, 1, 9, 0.4)
		twinkle(root.Position + UP * 8, 4, WIND, 0.25)
		for _ = 1, 8 do
			inflow(root.Position + UP * 6, 8, WIND_WHITE)
		end
	elseif phase == "Chop" then
		play(character, ANIMS.BoreasChop)
		local axe = axes[character]
		if axe then
			every(0.1, function(elapsed)
				axe.swing(elapsed / 0.1)
				return true
			end, function()
				axe.swing(1)
			end)
		end
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local length: number = data.length
		local forward = Vector3.new(direction.X, 0, direction.Z)
		forward = if forward.Magnitude > 1e-3 then forward.Unit else root.CFrame.LookVector
		task.delay(0.08, function()
			-- Where the axe bites, and the line it splits along the ground.
			local function floorAt(point: Vector3): Vector3
				local hit = U.groundBelow(point, { character }, 30)
				return if hit then hit.Position else point - UP * 3
			end
			local first = floorAt(origin + forward * 2)
			local last = if data.airborne
				then floorAt(origin + direction * length)
				else floorAt(origin + forward * length)
			if data.airborne then
				first = last
			end
			U.flash(first + UP, WIND_WHITE, 5, 0.15)
			twinkle(first + UP, 6, WIND, 0.25)
			lightRing(first + UP * 0.2, UP, 0.5, 10, 0.3, WIND_WHITE)
			windRing(first + UP * 0.3, UP, 1, 12, 0.4)
			U.shockwave(first, WIND, 2, 18, 0.4)
			U.debris(first, 10, 40, 0.7)
			gust(first + UP, 6, UP)
			-- The ground splitting in a wave along the line.
			local span = (last - first).Magnitude
			local steps = math.max(math.floor(span / 3), 1)
			local side = (last - first):Cross(UP)
			side = if side.Magnitude > 1e-3 then side.Unit else root.CFrame.RightVector
			for i = 0, steps do
				local point = first:Lerp(last, i / steps)
				task.delay(i * 0.018, function()
					windPuff(point + UP * 0.6, 2.4, UP)
					if i % 2 == 0 then
						U.groundRocks(point, 3, 2.2, 0.9)
						-- A blade of wind bursting up out of the split.
						local blade = windSlash(
							point - side * 1.8 + UP * 0.2,
							point + side * 1.8 + UP * 0.2,
							UP * 2.8,
							0.55,
							0.04
						)
						blade.move(UP * 4.5, 0.35)
						task.delay(0.1, blade.fade, 0.3)
					end
					if i % 3 == 0 then
						U.groundCracks(point, 3, 3.5, WIND, 1.2)
					end
				end)
			end
			if span > 1 then
				local a, b = worldAnchor(first + UP * 0.2, last - first), worldAnchor(last + UP * 0.2, last - first)
				local seam = {
					softBeam(a, b, {
						color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
						width0 = 0.9,
						width1 = 0.3,
						transparency = NumberSequence.new({ key(0, 0.1), key(1, 0.5) }),
					}),
					softBeam(a, b, {
						color = ColorSequence.new(WIND_WHITE, WIND),
						width0 = 6,
						width1 = 3,
						transparency = NumberSequence.new({ key(0, 0.5), key(1, 0.8) }),
						texture = SMOKE,
						speed = 6,
						length = 10,
					}),
				}
				task.delay(0.3, fadeBeams, seam, 0.5, { a, b })
			end
			U.burst(first:Lerp(last, 0.5) + UP, {
				texture = SMOKE,
				color = Color3.fromRGB(190, 198, 188),
				count = 16,
				size = 4,
				speed = NumberRange.new(10, 26),
				lifetime = NumberRange.new(0.5, 0.9),
				lightEmission = 0,
				transparency = 0.5,
				spread = 70,
				direction = UP,
				drag = 3,
			})
			U.light(first, WIND, 5, 30, 0.4)
			if (workspace.CurrentCamera.CFrame.Position - first).Magnitude < 50 then
				CameraShake.Add(0.25)
			end
		end)
		if U.isLocal(character) then
			CameraShake.FovKick(8)
		end
	elseif phase == "Cancel" then
		local axe = axes[character]
		if axe then
			axes[character] = nil
			axe.stop()
		end
	end
end

-- Spirit of Zephyrus: his sword of wind grows long (a blade of wind far
-- out past its point, streaking as it moves) and he lunges on a burst of
-- wind, afterimages behind him. Caught, three cuts in a blur, each a
-- crescent of wind through them, then a thrust that runs a seam of wind
-- straight through them.
type LongSword = { stop: () -> () }
local longSwords: { [Model]: LongSword } = {}

local function longSword(character: Model, duration: number): LongSword
	local hub = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1 })
	local hilt = Instance.new("Attachment")
	hilt.Parent = hub
	local point = Instance.new("Attachment")
	point.Position = Vector3.new(0, 0, -9)
	point.Parent = hub
	local beams = {
		softBeam(hilt, point, {
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.45,
			width1 = 0.1,
			transparency = NumberSequence.new({ key(0, 0.1), key(1, 0.45) }),
		}, hub),
		softBeam(hilt, point, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 2.2,
			width1 = 0.6,
			transparency = NumberSequence.new({ key(0, 0.55), key(1, 0.85) }),
			texture = SMOKE,
			speed = 4,
			length = 6,
		}, hub),
	}
	-- Glitter running up its edge and a glow at its point.
	table.insert(beams, Soft.starStream(hilt, point, 0.5, 10, hub))
	local shine = windEmitter(point, {
		Color = ColorSequence.new(WIND_WHITE),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 1), key(0.25, 0.75), key(1, 1) }),
		Size = NumberSequence.new(2.4),
		Lifetime = NumberRange.new(0.18, 0.24),
		Speed = NumberRange.new(0),
		LockedToPart = true,
		Rate = 20,
	})
	local streak0 = Instance.new("Attachment")
	streak0.Position = Vector3.new(0, 0.5, -8.5)
	streak0.Parent = hub
	local streak1 = Instance.new("Attachment")
	streak1.Position = Vector3.new(0, -0.5, -8.5)
	streak1.Parent = hub
	local trail = Instance.new("Trail")
	trail.Attachment0 = streak0
	trail.Attachment1 = streak1
	trail.Color = ColorSequence.new(WIND_WHITE, WIND)
	trail.Transparency = NumberSequence.new({ key(0, 0.35), key(1, 1) })
	trail.WidthScale = NumberSequence.new({ key(0, 1), key(1, 0.2) })
	trail.Lifetime = 0.25
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Parent = hub
	-- And the whole blade sweeps a sheet of wind behind it as he swings, so
	-- each cut is his blade going through them.
	local sweep = Instance.new("Trail")
	sweep.Attachment0 = hilt
	sweep.Attachment1 = point
	sweep.Color = ColorSequence.new(WIND_WHITE, WIND)
	sweep.Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) })
	sweep.Lifetime = 0.18
	sweep.LightEmission = 1
	sweep.LightInfluence = 0
	sweep.Parent = hub
	local alive = true
	every(duration, function()
		local arm = character:FindFirstChild("Right Arm") :: BasePart?
		if not alive or not arm then
			return false
		end
		-- The same grip as his sword of wind (see the look below).
		local grip = arm.CFrame * CFrame.new(0, -1.1, 0) * CFrame.Angles(rad(-90), 0, 0)
		hub.CFrame = CFrame.lookAt(grip.Position, grip.Position + grip.UpVector)
		return true
	end, function()
		if alive then
			alive = false
			trail.Enabled = false
			shine.Enabled = false
			fadeBeams(beams, 0.2, { hub })
		end
	end)
	local sword = {}
	function sword.stop()
		if alive then
			alive = false
			trail.Enabled = false
			sweep.Enabled = false
			shine.Enabled = false
			fadeBeams(beams, 0.2, { hub })
		end
	end
	return sword
end

function handlers.SpiritOfZephyrus(data, character, root)
	local phase = data.phase
	if phase == "Lunge" then
		play(character, ANIMS.ZephyrusLunge)
		local old = longSwords[character]
		if old then
			old.stop()
		end
		longSwords[character] = longSword(character, data.duration + 1)
		local direction: Vector3 = data.direction
		windPuff(root.Position - UP * 2.4, 3, -direction)
		windRing(root.Position, direction, 1, 6, 0.3)
		lightRing(root.Position, direction, 0.5, 5, 0.25, WIND_WHITE)
		U.bodyTrail(character, WIND, data.duration + 0.1)
		local torso = character:FindFirstChild("Torso") :: BasePart?
		if torso then
			local wake = Soft.trail(torso, Vector3.new(0, 1.6, 0), Vector3.new(0, -1.6, 0), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.45), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.3) }),
				lifetime = 0.4,
				texture = SMOKE,
			})
			task.delay(data.duration + 0.1, Soft.endTrail, wake)
		end
		for i = 0, 3 do
			task.delay(i * 0.07, U.afterimage, character, WIND, 0.35)
		end
		if U.isLocal(character) then
			U.speedLines(root, direction, data.duration, WIND_WHITE)
			CameraShake.FovKick(8)
		end
	elseif phase == "Catch" then
		local targetRoot = U.getRoot(data.target)
		if targetRoot then
			U.flash(targetRoot.Position, WIND_WHITE, 3, 0.1)
			windRing(targetRoot.Position, root.CFrame.LookVector, 1, 7, 0.25)
			windPuff(targetRoot.Position, 3, root.CFrame.LookVector)
		end
	elseif phase == "Cut" then
		local index: number = data.index or 1
		play(character, if index % 2 == 1 then ANIMS.SaintCut else ANIMS.SaintCutBack)
		local targetRoot = U.getRoot(data.target)
		if targetRoot then
			local at = targetRoot.Position
			local side = root.CFrame.RightVector * (if index % 2 == 1 then 1 else -1)
			local tilt = UP * (index - 2) * 1.5
			local slash =
				windSlash(at + side * 3.6 + tilt, at - side * 3.6 - tilt, root.CFrame.LookVector * 1.4 + UP * 0.4, 0.7)
			task.delay(0.15, slash.fade, 0.25)
			twinkle(at, 3, WIND, 0.18)
			lightRing(at, side, 0.4, 4, 0.2, WIND_WHITE)
			windPuff(at, 2, side)
			U.burst(at, {
				color = WIND_WHITE,
				count = 8,
				size = 0.4,
				speed = NumberRange.new(24, 50),
				lifetime = NumberRange.new(0.1, 0.25),
				streaks = true,
				spread = 40,
				direction = side,
			})
			U.highlight(data.target, WIND_WHITE, 0.08, 0.6)
			if involves(data, character) then
				CameraShake.Add(0.06)
			end
		end
	elseif phase == "Thrust" then
		play(character, ANIMS.ZephyrusThrust)
		local direction: Vector3 = data.direction
		local targetRoot = U.getRoot(data.target)
		local through = if targetRoot then targetRoot.Position else root.Position + direction * 4
		local from = through - direction * 4
		local a, b = worldAnchor(from, direction), worldAnchor(from + direction * 16, direction)
		local beams = {
			softBeam(a, b, {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 0.8,
				width1 = 0.1,
				transparency = NumberSequence.new({ key(0, 0.05), key(1, 0.6) }),
			}),
			softBeam(a, b, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 4,
				width1 = 1,
				transparency = NumberSequence.new({ key(0, 0.5), key(1, 0.9) }),
				texture = SMOKE,
				speed = 6,
				length = 8,
			}),
		}
		task.delay(0.12, fadeBeams, beams, 0.3, { a, b })
		windRing(through, direction, 1, 9, 0.3)
		U.shockwave(through, WIND, 1, 12, 0.3)
		windPuff(through + direction * 2, 4, direction)
		twinkle(through, 6, WIND, 0.25)
		streaks(through + direction, 16, 90, direction, 25)
		-- The air rings out behind them along the thrust.
		for i = 1, 4 do
			task.delay(i * 0.03, function()
				local at = through + direction * (i * 3)
				lightRing(at, direction, 0.5, 3 + i, 0.25, WIND_WHITE)
				windRing(at, direction, 0.5, 4 + i, 0.3)
			end)
		end
		task.delay(0.35, function()
			local sword = longSwords[character]
			if sword then
				longSwords[character] = nil
				sword.stop()
			end
		end)
		if involves(data, character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(6)
		end
	elseif phase == "Whiff" then
		windPuff(root.Position + root.CFrame.LookVector * 3, 2)
		local sword = longSwords[character]
		if sword then
			longSwords[character] = nil
			sword.stop()
		end
	end
end

---------------------------------------------------------------------------
-- Half-Crown / Full-Crown: transformations and looks
---------------------------------------------------------------------------

-- Sylph circles in and merges into him at the burst; wind gathers, then
-- blasts out.
local function transformation(data, character: Model, root: BasePart, full: boolean)
	if data.phase == "Start" then
		play(character, if full then ANIMS.Ascend else ANIMS.Awaken)
		local sylph = makeSprite(1.4)
		every(0.8, function(elapsed)
			if not root.Parent then
				return false
			end
			local t = elapsed / 0.8
			local angle = t * math.pi * 4
			local radius = 5 * (1 - t) + 0.5
			sylph.place(
				CFrame.new(root.Position + Vector3.new(math.cos(angle) * radius, 3 - t * 2, math.sin(angle) * radius)),
				elapsed
			)
			inflow(root.Position, 7)
			return true
		end, function()
			sylph.fade(0.15)
		end)
		if full then
			U.spiral(root, WIND, 4, 10, 1.3, 4, 0.2, 0.5)
		end
		U.ringBurst(CFrame.new(root.Position - UP * 2.8), WIND, 12, 2, 0.8, 0.2)
		-- A circle of wind closing in on the ground round him, ribbons of wind
		-- whirling up round him, and wind and glitter drawn in from all round.
		local feet = root.Position - UP * 2.85
		local circle = {
			softRing({
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 1.8,
				width1 = 1.8,
				transparency = NumberSequence.new(0.5),
				texture = SMOKE,
				speed = 3,
				length = 5,
			}),
			softRing({
				color = ColorSequence.new(if full then STAR_WHITE else WIND_WHITE, if full then STAR else WIND),
				width0 = 0.9,
				width1 = 0.9,
				transparency = NumberSequence.new(0.35),
				texture = SPARKLE,
				wrap = true,
				length = 1.4,
				speed = 2,
			}),
		}
		local well = U.newPart({ Size = Vector3.one * 16, Transparency = 1, CFrame = CFrame.new(root.Position) })
		local drawn = {
			windEmitter(well, {
				Size = NumberSequence.new({ key(0, 4), key(1, 1) }),
				Lifetime = NumberRange.new(0.5, 0.6),
				Speed = NumberRange.new(14, 16),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 40,
			}),
			windEmitter(well, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, if full then STAR else WIND_WHITE),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.2), key(1, 0.6) }),
				Size = NumberSequence.new({ key(0, 0.7), key(1, 0.1) }),
				Lifetime = NumberRange.new(0.5, 0.6),
				Speed = NumberRange.new(14, 16),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 50,
			}),
		}
		Soft.helix(function()
			return root.Position - UP * 3, root.Position + UP * 4
		end, 3.5, if full then 4 else 3, 0.45, 2, 0.8, 0.8)
		every(0.8, function(elapsed)
			if not root.Parent then
				return false
			end
			local close = easeOut(elapsed / 0.8)
			circle[1].set(CFrame.new(feet) * CFrame.Angles(0, elapsed * 3, 0), 11 - 8 * close)
			circle[2].set(CFrame.new(feet + UP * 0.05) * CFrame.Angles(0, -elapsed * 2, 0), 12 - 8.5 * close)
			return true
		end, function()
			for _, ring in circle do
				ring.fade(0.15)
			end
			for _, emitter in drawn do
				emitter.Enabled = false
			end
			task.delay(0.7, well.Destroy, well)
		end)
	elseif data.phase == "Burst" then
		local position = root.Position
		U.shockwave(position, WIND, 3, if full then 40 else 28, 0.6, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, if full then 22 else 16, 0.5, 0.4)
		U.pillar(position - UP * 3, WIND, 4, if full then 40 else 26, 0.6, Enum.Material.ForceField, 0.3)
		U.burst(position, {
			color = WIND_WHITE,
			count = 40,
			size = 0.6,
			speed = NumberRange.new(40, 90),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if full then
			U.flash(position + UP * 3, STAR, 10, 0.3)
			twinkle(position + UP * 3, 16, STAR, 0.4)
			starDust(position + UP * 2, 30, 40)
		else
			twinkle(position + UP * 2, 10, WIND, 0.35)
		end
		-- A column of wind blasting up out of him, rings of wind and light
		-- racing out, and feathers of wind flung everywhere.
		local foot, head =
			worldAnchor(position - UP * 3, UP), worldAnchor(position + UP * (if full then 44 else 30), UP)
		local column = {
			softBeam(foot, head, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 8,
				width1 = 14,
				transparency = NumberSequence.new({ key(0, 0.8), key(0.15, 0.45), key(1, 1) }),
				texture = SMOKE,
				speed = 14,
				length = 14,
			}),
			softBeam(foot, head, {
				color = ColorSequence.new(STAR_WHITE, if full then STAR else WIND_WHITE),
				width0 = 2.5,
				width1 = 4,
				transparency = NumberSequence.new({ key(0, 0.6), key(0.15, 0.25), key(1, 1) }),
				texture = SPARKLE,
				wrap = true,
				length = 3,
				speed = 24,
			}),
		}
		for _, beam in column do
			U.tween(beam, 0.6, { Width0 = beam.Width0 * 0.2, Width1 = beam.Width1 * 0.2 })
		end
		fadeBeams(column, 0.6, { foot, head })
		windRing(position - UP * 2.6, UP, 2, if full then 30 else 22, 0.55)
		windRing(position, UP, 1, if full then 22 else 16, 0.45, WIND_WHITE)
		lightRing(position - UP * 2.7, UP, 1, if full then 26 else 18, 0.4, if full then STAR else WIND_WHITE)
		windPuff(position, 6)
		featherBurst(position + UP, if full then 22 else 14, 26)
		U.light(position, WIND, 6, 40, 0.8)
		if U.isLocal(character) then
			U.colorGrade({ Brightness = 0.15, Saturation = 0.3 }, 0, 0.1, 0.5)
			CameraShake.Add(0.35)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "End" then
		gust(root.Position, 6)
		windRing(root.Position - UP * 2.6, UP, 1, 10, 0.4)
		featherBurst(root.Position + UP, 8, 14)
	end
end

function handlers.Awaken(data, character, root)
	transformation(data, character, root, false)
end

function handlers.Ascend(data, character, root)
	transformation(data, character, root, true)
end

-- The look. Half-Crown: green mana coats his left side (where Sylph sits),
-- a wing of wind grows from his left shoulder blade and half a crown of
-- gold leaves forms over his left temple. Full-Crown: both sides, both
-- wings, the whole crown, and a two-handed sword of wind. Either way his
-- grimoire comes out and circles him, open, pages fluttering. Anchored
-- parts posed every frame round his body; they fade in.
local GRIMOIRE_COVER = Color3.fromRGB(28, 70, 58)
local GRIMOIRE_PAPER = Color3.fromRGB(226, 234, 214)

-- Feathers per wing: long primaries fanned high and wide (with a shimmer of
-- wind over them) behind shorter coverts nearer the shoulder. Spread is
-- degrees up from straight out; back is how far they sweep behind him.
local WING_LAYERS = {
	{ count = 5, from = 10, to = 82, length = 3.9, shrink = 0.3, width = 0.72, back = 0.62, shimmer = true },
	{ count = 4, from = 4, to = 62, length = 2.1, shrink = 0.22, width = 0.56, back = 0.48, shimmer = false },
}

type Feather = {
	vane: BasePart,
	tip: BasePart,
	core: BasePart,
	shell: BasePart?,
	layer: { [string]: any },
	index: number,
	length: number,
}
type Spike = { left: BasePart, right: BasePart, angle: number, height: number }
type Page = { part: BasePart, offset: CFrame, side: number }

local function buildLook(character: Model, full: boolean): () -> ()
	local torso = character:FindFirstChild("Torso") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = U.getRoot(character)
	if not torso or not head or not root then
		return function() end
	end
	local look: { hideSword: number, blade: BasePart? } = { hideSword = 0, blade = nil }
	looks[character] = look
	local entries: { { part: BasePart, base: number } } = {}
	local function part(props: { [string]: any }, base: number, wedge: boolean?): BasePart
		local p: BasePart
		if wedge then
			p = Instance.new("WedgePart")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			for key, value in props do
				(p :: any)[key] = value
			end
			p.Parent = U.folder
		else
			p = U.newPart(props)
		end
		p.Transparency = 1
		table.insert(entries, { part = p, base = base })
		return p
	end
	local sides = if full then { -1, 1 } else { -1 } -- -1: his left

	-- Wings.
	local wings: { { side: number, feathers: { Feather } } } = {}
	local emitters: { ParticleEmitter } = {}
	local wingTrails: { Trail } = {}
	local wingsStarted = false
	for _, side in sides do
		local feathers: { Feather } = {}
		for _, layer in WING_LAYERS do
			for i = 1, layer.count do
				local length = layer.length - (i - 1) * layer.shrink
				local tip =
					part({ Size = Vector3.new(0.07, layer.width * 0.72, layer.width * 0.72), Color = WIND }, 0.3)
				table.insert(feathers, {
					vane = part({ Size = Vector3.new(0.07, layer.width, length), Color = WIND }, 0.32),
					tip = tip,
					core = part({ Size = Vector3.new(0.09, 0.07, length), Color = WIND_WHITE }, 0.1),
					shell = if layer.shimmer
						then part({
							Size = Vector3.new(0.18, layer.width * 1.35, length * 1.05),
							Color = WIND,
							Material = Enum.Material.ForceField,
						}, 0)
						else nil,
					layer = layer,
					index = i,
					length = length,
				})
				-- Wind streaming off the longest feathers' tips as he moves.
				if layer.shimmer and i <= 3 then
					table.insert(
						wingTrails,
						Soft.trail(tip, Vector3.new(0, 0.22, 0), Vector3.new(0, -0.22, 0), {
							color = ColorSequence.new(WIND_WHITE, WIND),
							transparency = NumberSequence.new({ key(0, 0.55), key(1, 1) }),
							width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
							lifetime = 0.3,
							off = true,
						})
					)
				end
				-- Wisps of wind off the very longest.
				if layer.shimmer and i <= 2 then
					local wisp = Instance.new("ParticleEmitter")
					wisp.Texture = U.textures.Smoke
					wisp.Color = ColorSequence.new(WIND_WHITE, WIND)
					wisp.LightEmission = 1
					wisp.LightInfluence = 0
					wisp.Size = NumberSequence.new(0.35, 0)
					wisp.Transparency = NumberSequence.new(0.4, 1)
					wisp.Lifetime = NumberRange.new(0.3, 0.5)
					wisp.Rate = 14
					wisp.Speed = NumberRange.new(0.5, 1)
					wisp.Parent = tip
					table.insert(emitters, wisp)
				end
			end
		end
		table.insert(wings, { side = side, feathers = feathers })
	end

	-- Crown: a gold band and leaf-shaped spikes (two wedges back to back),
	-- the tallest at the front (Full-Crown) or over his left temple (Half).
	local spikes: { Spike } = {}
	local spikeCount = if full then 10 else 5
	for i = 1, spikeCount do
		local angle, height
		if full then
			angle = (i - 1) / spikeCount * math.pi * 2
			height = if i == 1 then 1 elseif i % 2 == 1 then 0.72 else 0.48
		else
			local f = (i - 1) / (spikeCount - 1)
			angle = -(0.1 + 0.8 * f) * math.pi
			height = 0.45 + 0.5 * math.sin(f * math.pi)
		end
		table.insert(spikes, {
			left = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			right = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			angle = angle,
			height = height,
		})
	end
	local bandCount = if full then 16 else 8
	local band = {}
	for _ = 1, bandCount do
		table.insert(band, part({ Size = Vector3.new(0.09, 0.14, 0.3), Color = STAR }, 0.05))
	end
	local gem = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.22, Color = WIND }, 0)

	-- Green mana coating the marked side: a shimmering shell over the arm,
	-- the leg and that half of the torso.
	local shells: { { part: BasePart, limb: BasePart, offset: CFrame } } = {}
	for _, side in sides do
		for _, name in { if side < 0 then "Left Arm" else "Right Arm", if side < 0 then "Left Leg" else "Right Leg" } do
			local limb = character:FindFirstChild(name) :: BasePart?
			if limb then
				table.insert(shells, {
					part = part({
						Size = limb.Size + Vector3.new(0.08, 0.08, 0.08),
						Color = WIND,
						Material = Enum.Material.ForceField,
					}, 0),
					limb = limb,
					offset = CFrame.identity,
				})
			end
		end
		table.insert(shells, {
			part = part({ Size = Vector3.new(1.06, 2.08, 1.08), Color = WIND, Material = Enum.Material.ForceField }, 0),
			limb = torso,
			offset = CFrame.new(side * 0.5, 0, 0),
		})
		local arm = character:FindFirstChild(if side < 0 then "Left Arm" else "Right Arm") :: BasePart?
		if arm then
			local wisp = Instance.new("ParticleEmitter")
			wisp.Texture = U.textures.Smoke
			wisp.Color = ColorSequence.new(WIND)
			wisp.LightEmission = 0.8
			wisp.LightInfluence = 0
			wisp.Size = NumberSequence.new(0.5, 0)
			wisp.Transparency = NumberSequence.new(0.5, 1)
			wisp.Lifetime = NumberRange.new(0.4, 0.7)
			wisp.Rate = 18
			wisp.Speed = NumberRange.new(0.5, 1.5)
			wisp.Acceleration = Vector3.new(0, 3, 0)
			wisp.Parent = arm
			table.insert(emitters, wisp)
		end
	end

	-- His grimoire: a dark green book with a four-leaf clover of light over
	-- its open pages.
	local book: { Page } = {}
	local function page(props: { [string]: any }, base: number, offset: CFrame, side: number)
		table.insert(book, { part = part(props, base), offset = offset, side = side })
	end
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			0.05,
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, 0, CFrame.new(0, 1.05, -0.4), 0)
	local bookLight = Instance.new("PointLight")
	bookLight.Color = WIND
	bookLight.Range = 8
	bookLight.Brightness = 1.5
	bookLight.Parent = book[#book].part

	-- The wind sword (Full-Crown), in the right hand.
	local sword: { BasePart }? = nil
	local swordBeams: { Beam } = {}
	if full then
		local parts = {
			part({ Size = Vector3.new(0.22, 1.1, 0.22), Color = WIND_DEEP }, 0),
			part({ Size = Vector3.new(1.5, 0.18, 0.32), Color = STAR }, 0),
			part({ Size = Vector3.new(0.2, 5.6, 0.85), Color = WIND }, 0.25),
			part({ Size = Vector3.new(0.1, 5.4, 0.28), Color = WIND_WHITE }, 0),
			part({ Size = Vector3.new(0.3, 5.9, 1.15), Color = WIND, Material = Enum.Material.ForceField }, 0),
		}
		sword = parts
		look.blade = parts[4] -- (moves trail wind off it as it swings)
		-- Wind flowing up the blade, glitter along its edge.
		local low = Instance.new("Attachment")
		low.Position = Vector3.new(0, -2.6, 0)
		low.Parent = parts[4]
		local high = Instance.new("Attachment")
		high.Position = Vector3.new(0, 2.8, 0)
		high.Parent = parts[4]
		swordBeams = {
			softBeam(low, high, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 1.4,
				width1 = 0.6,
				transparency = NumberSequence.new({ key(0, 0.85), key(0.3, 0.62), key(1, 0.8) }),
				texture = SMOKE,
				speed = 2.5,
				length = 3,
			}, parts[4]),
			softBeam(low, high, {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 0.45,
				width1 = 0.25,
				transparency = NumberSequence.new({ key(0, 0.75), key(0.5, 0.45), key(1, 0.7) }),
				texture = SPARKLE,
				wrap = true,
				length = 0.8,
				speed = 1.5,
			}, parts[4]),
		}
	end

	-- Hovering: a ring of wind turning on the ground under him and a soft
	-- downdraft off his feet.
	local hoverRing = softRing({
		color = ColorSequence.new(WIND_WHITE, WIND),
		width0 = 0.9,
		width1 = 0.9,
		transparency = NumberSequence.new(0.6),
		texture = U.textures.Smoke,
		speed = 2,
		length = 4,
	})
	local draft = U.newPart({ Size = Vector3.new(1.6, 0.2, 1.6), Transparency = 1 })
	local downdraft = windEmitter(draft, {
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 3.2) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(5, 9),
		SpreadAngle = Vector2.new(35, 35),
		EmissionDirection = Enum.NormalId.Bottom,
		Drag = 2,
		Rate = 14,
	})

	local start = os.clock()
	local connection: RBXScriptConnection
	local function destroy()
		connection:Disconnect()
		if looks[character] == look then
			looks[character] = nil
		end
		hoverRing.fade(0.3)
		downdraft.Enabled = false
		for _, trail in wingTrails do
			trail.Enabled = false
		end
		for _, beam in swordBeams do
			beam.Enabled = false
		end
		task.delay(1, draft.Destroy, draft)
		for _, emitter in emitters do
			emitter.Enabled = false
			task.delay(1, emitter.Destroy, emitter)
		end
		local parts = {}
		for _, entry in entries do
			table.insert(parts, entry.part)
		end
		fadeOut(parts, 0.4)
	end
	connection = RunService.RenderStepped:Connect(function()
		if not torso.Parent or not head.Parent or not root.Parent then
			-- He's gone (died, left): the look goes with him.
			destroy()
			return
		end
		local t = os.clock() - start
		local alpha = math.min(t / 0.5, 1)
		for _, entry in entries do
			entry.part.Transparency = 1 - (1 - entry.base) * alpha
		end
		hoverRing.set(
			CFrame.new(root.Position - UP * 2.95) * CFrame.Angles(0, t * 1.2, 0),
			(2.2 + 0.25 * math.sin(t * 2)) * alpha + 0.05
		)
		draft.CFrame = root.CFrame * CFrame.new(0, -1.1, 0)

		-- Wings: each feather fanned out from the shoulder blade, a slow
		-- beat rippling out along the wing (the tips move most).
		local back = -torso.CFrame.LookVector
		for _, wing in wings do
			local base = torso.CFrame * Vector3.new(wing.side * 0.45, 0.55, 0.55)
			for _, feather in wing.feathers do
				local layer = feather.layer
				local f = if layer.count > 1 then (feather.index - 1) / (layer.count - 1) else 0
				local flap = math.sin(t * 2.1 - feather.index * 0.35) * (6 + f * 6)
				local angle = rad(layer.from + (layer.to - layer.from) * f + flap)
				local localDirection =
					Vector3.new(wing.side * math.cos(angle), math.sin(angle) * 0.95 + 0.05, layer.back).Unit
				local direction = torso.CFrame:VectorToWorldSpace(localDirection)
				local across = direction:Cross(back)
				local up = if across.Magnitude > 1e-3 then across.Unit else UP
				local center = base + direction * (feather.length / 2)
				local frame = CFrame.lookAt(center, center + direction, up)
				feather.vane.CFrame = frame
				feather.core.CFrame = frame
				if feather.shell then
					feather.shell.CFrame = frame
				end
				local tipAt = base + direction * feather.length
				feather.tip.CFrame = CFrame.lookAt(tipAt, tipAt + direction, up) * CFrame.Angles(rad(45), 0, 0)
			end
		end
		if not wingsStarted then
			-- (The tips are in place now: their trails start here.)
			wingsStarted = true
			for _, trail in wingTrails do
				Soft.beginTrail(trail)
			end
		end

		-- Crown.
		local crown = head.CFrame * CFrame.new(0, 0.3, 0)
		local function around(a: number): Vector3
			return Vector3.new(math.sin(a), 0, -math.cos(a))
		end
		local function along(a: number): Vector3
			return crown:VectorToWorldSpace(Vector3.new(math.cos(a), 0, math.sin(a)))
		end
		for i, segment in band do
			local a = if full then (i - 0.5) / bandCount * math.pi * 2 else -((i - 0.5) / bandCount) * math.pi
			local position = crown * (around(a) * 0.66)
			segment.CFrame = CFrame.lookAt(position, position + along(a), crown.UpVector)
		end
		for _, spike in spikes do
			local center = crown * (around(spike.angle) * 0.66) + crown.UpVector * (spike.height / 2 + 0.05)
			local frame = CFrame.lookAt(center, center + along(spike.angle), crown.UpVector)
			local half = spike.left.Size.Z / 2
			spike.left.CFrame = frame * CFrame.new(0, 0, -half)
			spike.right.CFrame = frame * CFrame.new(0, 0, half) * CFrame.Angles(0, math.pi, 0)
		end
		gem.CFrame =
			CFrame.new(crown * ((if full then around(0) else around(-math.pi / 2)) * 0.7 + Vector3.new(0, 0.12, 0)))

		-- Mana.
		for _, shell in shells do
			if shell.limb.Parent then
				shell.part.CFrame = shell.limb.CFrame * shell.offset
			end
		end

		-- Grimoire: circling him, turned to keep its pages towards him.
		local orbit = t * 1.15
		local position = root.Position
			+ Vector3.new(math.cos(orbit) * 3, 1.3 + math.sin(t * 2.1) * 0.3, math.sin(orbit) * 3)
		local bookFrame = CFrame.lookAt(position, root.Position + UP * 1.3) * CFrame.Angles(rad(-15), 0, 0)
		local open = rad((62 + math.sin(t * 6) * 6) * alpha)
		for _, p in book do
			local hinge = CFrame.Angles(0, -p.side * open, 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = bookFrame * hinge * spin * p.offset
		end

		-- Sword.
		if sword then
			local arm = character:FindFirstChild("Right Arm") :: BasePart?
			if arm then
				local grip = arm.CFrame * CFrame.new(0, -1.1, 0) * CFrame.Angles(rad(-90), 0, 0)
				sword[1].CFrame = grip
				sword[2].CFrame = grip * CFrame.new(0, 0.6, 0)
				sword[3].CFrame = grip * CFrame.new(0, 3.5, 0)
				sword[4].CFrame = grip * CFrame.new(0, 3.5, 0)
				sword[5].CFrame = grip * CFrame.new(0, 3.55, 0)
			end
			local hidden = os.clock() < look.hideSword
			if hidden then
				for _, p in sword do
					p.Transparency = 1
				end
			end
			for _, beam in swordBeams do
				beam.Enabled = not hidden and alpha >= 1
			end
		end
	end)

	return function()
		if connection.Connected then
			destroy()
		end
	end
end

local destroyLook: { [Model]: () -> () } = {}
local stageWatch: { [Model]: RBXScriptConnection } = {}

function Kit.SetAwakened(character: Model, on: boolean)
	local watch = stageWatch[character]
	if watch then
		watch:Disconnect()
		stageWatch[character] = nil
	end
	local destroy = destroyLook[character]
	if destroy then
		destroyLook[character] = nil
		destroy()
	end
	PoseAnimator.SetIdle(character, if on then HOVER else Kit.Idle)
	-- Hovering under everything he does (attacks too), not only standing.
	PoseAnimator.SetLift(character, if on then SaintPlan.Lift else 0)
	if not on then
		return
	end
	local function rebuild()
		local old = destroyLook[character]
		if old then
			old()
		end
		destroyLook[character] = buildLook(character, character:GetAttribute("Ascended") == true)
	end
	rebuild()
	stageWatch[character] = character:GetAttributeChangedSignal("Ascended"):Connect(function()
		if character:GetAttribute("Awakened") == true then
			rebuild()
		end
	end)
end

---------------------------------------------------------------------------
-- Spawn entrance
---------------------------------------------------------------------------

-- A grimoire of its own (the Crown look poses its own copy): dark green
-- covers, open pages, a four-leaf clover of light turning over them.
type Book = { place: (CFrame, number, number) -> (), fade: (number) -> () }

local function makeBook(): Book
	local pages: { { part: BasePart, offset: CFrame, side: number } } = {}
	local function page(props: { [string]: any }, offset: CFrame, side: number)
		table.insert(pages, { part = U.newPart(props), offset = offset, side = side })
	end
	local cover = Color3.fromRGB(28, 70, 58)
	local paper = Color3.fromRGB(226, 234, 214)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, CFrame.new(0, 1.05, -0.4), 0)
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 8
	light.Brightness = 2
	light.Parent = pages[#pages].part
	local book = {}
	function book.place(frame: CFrame, open: number, t: number)
		for _, p in pages do
			local hinge = CFrame.Angles(0, -p.side * rad(open), 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = frame * hinge * spin * p.offset
		end
	end
	function book.fade(duration: number)
		light.Enabled = false
		local parts = {}
		for _, p in pages do
			table.insert(parts, p.part)
		end
		fadeOut(parts, duration)
	end
	return book
end

-- Wind gathers round him and his grimoire comes down out of the sky to
-- him, circling him as it opens, Sylph darting about; he reaches for it,
-- the clover flares and the wind bursts out, and Sylph is gone into him.
function handlers.Entrance(data, character, root)
	if data.phase ~= "Start" then
		return
	end
	play(character, ANIMS.Entrance)
	local book = makeBook()
	local sylph = makeSprite(1.2)
	every(2.2, function(elapsed)
		if not root.Parent then
			return false
		end
		local forward = root.CFrame.LookVector
		local right = root.CFrame.RightVector
		local position, open
		if elapsed < 0.6 then
			local eased = 1 - (1 - elapsed / 0.6) ^ 2
			position = root.Position + forward * 2.5 + UP * (1.5 + 18 * (1 - eased)) + right * 6 * (1 - eased)
			open = 0
		elseif elapsed < 1.2 then
			local a = (elapsed - 0.6) / 0.6
			local angle = a * math.pi * 2
			position = root.Position + (forward * math.cos(angle) + right * math.sin(angle)) * 2.5 + UP * 1.5
			open = 70 * a
		else
			position = root.Position + forward * 2.2 + UP * (1.8 + math.min((elapsed - 1.2) * 2, 0.8))
			open = 70
		end
		book.place(CFrame.lookAt(position, root.Position + UP * 1.5) * CFrame.Angles(rad(-15), 0, 0), open, elapsed)
		if elapsed < 1.2 then
			local angle = elapsed * 7
			sylph.place(
				CFrame.new(
					root.Position
						+ Vector3.new(math.cos(angle) * 3.5, 1.5 + math.sin(elapsed * 9), math.sin(angle) * 3.5)
				),
				elapsed
			)
			inflow(root.Position, 7)
		end
		return true
	end, function()
		book.fade(0.3)
	end)
	U.spiral(root, WIND, 3, 6, 1.2, 3, 0.1, 0.4)
	task.delay(1.2, function()
		sylph.fade(0.15)
		if not root.Parent then
			return
		end
		local position = root.Position
		gust(position + UP, 8, UP)
		U.shockwave(position, WIND, 3, 20, 0.45, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, 14, 0.4, 0.35)
		windRing(position - UP * 2.7, UP, 1, 16, 0.45)
		lightRing(position - UP * 2.75, UP, 1, 12, 0.35, WIND_WHITE)
		featherBurst(position + UP, 12, 18)
		twinkle(position + root.CFrame.LookVector * 2.2 + UP * 2, 7, STAR, 0.3)
		U.flash(position + root.CFrame.LookVector * 2.2 + UP * 2, STAR, 6, 0.25)
		U.light(position, WIND, 5, 26, 0.5)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(8)
		end
	end)
end

---------------------------------------------------------------------------
-- Movement: a green dash on the wind, and the gust under his air jump
---------------------------------------------------------------------------

local DASH_VECTORS = {
	Front = Vector3.new(0, 0, -1),
	Back = Vector3.new(0, 0, 1),
	Left = Vector3.new(-1, 0, 0),
	Right = Vector3.new(1, 0, 0),
}

VFX.RegisterKitEffect("Wind", "Dash", function(data)
	local character: Model? = data.character
	local root = U.getRoot(character)
	if not character or not root then
		return
	end
	local direction = if type(data.direction) == "string" then data.direction else "Front"
	U.afterimage(character, WIND, 0.3)
	for i = 1, 3 do
		task.delay(i * 0.05, function()
			if character.Parent then
				U.afterimage(character, if i == 3 then WIND_WHITE else WIND, 0.25)
			end
		end)
	end
	U.bodyTrail(character, WIND, 0.28)
	local ground = U.groundBelow(root.Position, { character })
	local feet = if ground then ground.Position else root.Position - UP * 3
	U.ringBurst(CFrame.new(feet + UP * 0.1), WIND, 0.6, 3.8, 0.25, 0.14)
	local away = -(root.CFrame:VectorToWorldSpace(DASH_VECTORS[direction] or DASH_VECTORS.Front))
	windRing(feet + UP * 0.2, UP, 0.6, 4.5, 0.3)
	windPuff(root.Position - UP * 1.5, 1.6, away)
	U.burst(root.Position - UP * 0.5, {
		color = WIND_WHITE,
		count = 10,
		size = 0.35,
		speed = NumberRange.new(16, 30),
		lifetime = NumberRange.new(0.12, 0.25),
		streaks = true,
		spread = 35,
		direction = away,
	})
	U.light(root.Position, WIND, 2, 10, 0.25)
end)

VFX.RegisterKitEffect("Wind", "AirJump", function(data)
	local character: Model? = data.character
	local root = U.getRoot(character)
	if not character or not root then
		return
	end
	local feet = root.Position - UP * 3
	U.ringBurst(CFrame.new(feet), WIND, 0.8, 4.2, 0.3, 0.16)
	windRing(feet, UP, 0.6, 5, 0.3)
	windPuff(feet, 1.6, -UP)
	U.burst(feet, {
		color = WIND_WHITE,
		count = 12,
		size = 0.4,
		speed = NumberRange.new(12, 26),
		lifetime = NumberRange.new(0.15, 0.3),
		streaks = true,
		spread = 50,
		direction = -UP,
	})
	U.afterimage(character, WIND, 0.2)
end)

function Kit.OnSkill(data)
	local character = data.character
	if typeof(character) ~= "Instance" or not character:IsA("Model") then
		return
	end
	local root = U.getRoot(character)
	local handler = handlers[data.skill]
	if root and handler then
		handler(data, character, root)
	end
end

return Kit
