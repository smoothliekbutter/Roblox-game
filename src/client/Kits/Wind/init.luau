--[[
	Prince of Wind (Yuno), client side: stance and spell animations, every
	spell's visuals and the Half-Crown / Full-Crown looks. The server sends
	("Skill", {skill, phase, ...}) events (Server/Kits/Wind) and every client
	draws them locally.

	Wind is pale green with a white core, star magic gold-white. Spells are
	built from anchored neon parts posed every frame, so they follow him and
	look the same at any ping.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SaintPlan = require(ReplicatedStorage:WaitForChild("Shared").SaintZephyr)
local DivePlan = require(ReplicatedStorage:WaitForChild("Shared").TempestDive)
local CameraShake = require(script.Parent.Parent.CameraShake)
local Cinematic = require(script.Parent.Parent.Cinematic)
local M1Animations = require(script.Parent.Parent.M1Animations)
local PoseAnimator = require(script.Parent.Parent.PoseAnimator)
local VFX = require(script.Parent.Parent.VFX)

type Animation = PoseAnimator.Animation

local U = VFX.Util
local rad = math.rad
local UP = Vector3.yAxis

local WIND = Color3.fromRGB(120, 235, 175)
local WIND_DEEP = Color3.fromRGB(35, 170, 110)
local WIND_WHITE = Color3.fromRGB(228, 255, 240)
local STAR = Color3.fromRGB(255, 226, 130)
local STAR_WHITE = Color3.fromRGB(255, 250, 228)

local Kit = {}

VFX.SetPalette("Wind", { hit = WIND, heavy = WIND_DEEP, flash = WIND_WHITE })

---------------------------------------------------------------------------
-- Animations (generated by tools/anim/yuno_anims.py, see Animations.luau)
---------------------------------------------------------------------------

local function build(raw: { [string]: any }): Animation
	local keyframes = {}
	for _, key in raw.keys do
		table.insert(keyframes, {
			time = key[1],
			pose = key[2],
			easing = if key[3] then (Enum.EasingStyle :: any)[key[3]] else nil,
			direction = if key[4] then (Enum.EasingDirection :: any)[key[4]] else nil,
		})
	end
	return {
		keyframes = keyframes,
		loop = raw.loop,
		fadeIn = raw.fadeIn,
		fadeOut = raw.fadeOut,
		delays = raw.delays,
	}
end

local ANIMS: { [string]: Animation } = {}
for name, raw in require(script.Animations) do
	ANIMS[name] = build(raw)
end

-- Calm, upright stance; a light sprint with both arms swinging. The strides
-- are how far one loop (two steps) carries him (RUN_STRIDE / WALK_STRIDE
-- in tools/anim/yuno_anims.py), so the feet keep pace with the ground.
Kit.Idle = {
	stand = ANIMS.Idle,
	move = ANIMS.Run,
	walk = ANIMS.Walk,
	air = ANIMS.Air,
	moveSpeed = 16,
	walkSpeed = 8,
	moveStride = 10.88,
	walkStride = 6.13,
}

-- Awakened (Half-Crown and Full-Crown) he doesn't walk: he hovers on the
-- wind, rising and settling, and glides when he moves.
local HOVER = {
	stand = ANIMS.HoverIdle,
	move = ANIMS.HoverMove,
	air = ANIMS.HoverIdle, -- still carried on the wind (so a jump doesn't drop him)
	moveSpeed = 16,
}

-- The idle set for him right now (Moves asks when the kit is put on).
function Kit.IdleFor(character: Model): PoseAnimator.IdleSet
	return if character:GetAttribute("Awakened") == true then HOVER else Kit.Idle
end

local function play(character: Model, animation: Animation, onEvent: ((string) -> ())?)
	PoseAnimator.Play(character, animation, onEvent)
end

---------------------------------------------------------------------------
-- M1: wind-wrapped strikes (the shared fist string), each with a gust
---------------------------------------------------------------------------

function Kit.PlayM1(character: Model, index: number, variant: string)
	local name = M1Animations.NameFor(index, variant)
	local animation = M1Animations.Clips[name]
	if not animation then
		return
	end
	local heavy = variant ~= "Normal"
	local strikers = M1Animations.Strikers[name] or {}
	play(character, animation, function(event)
		if event ~= "Strike" then
			return
		end
		for _, limbName in strikers do
			VFX.LimbTrail(character, limbName, if heavy then 0.2 else 0.13, WIND)
			local limb = character:FindFirstChild(limbName)
			if limb and limb:IsA("BasePart") then
				local tip = (limb.CFrame * CFrame.new(0, -1, 0)).Position
				U.burst(tip, {
					color = WIND_WHITE,
					count = if heavy then 10 else 5,
					size = 0.35,
					speed = NumberRange.new(10, 24),
					lifetime = NumberRange.new(0.1, 0.22),
					streaks = true,
					spread = 50,
					direction = (limb.CFrame.LookVector * -1 + limb.CFrame.UpVector * -1).Unit,
				})
			end
		end
		VFX.AirPop(character, heavy)
	end)
end

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------

local handlers: { [string]: (data: any, character: Model, root: BasePart) -> () } = {}

local function involves(data, character: Model): boolean
	return U.isLocal(character) or U.isLocal(data.target)
end

-- Bumped whenever a skill phase starts, so a loop drawing the last phase
-- stops as soon as that skill is released or cancelled.
local castTokens: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local function bump(character: Model): number
	local token = (castTokens[character] or 0) + 1
	castTokens[character] = token
	return token
end
local function live(character: Model, token: number): boolean
	return castTokens[character] == token and character.Parent ~= nil
end

-- Runs `step(elapsed, dt)` every frame until it returns false, `duration`
-- runs out or the cast is replaced; then `finish` (if any).
local function every(duration: number, step: (number, number) -> boolean?, finish: (() -> ())?)
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		local elapsed = os.clock() - start
		if elapsed >= duration or step(elapsed, dt) == false then
			connection:Disconnect()
			if finish then
				finish()
			end
		end
	end)
end

local function fadeOut(parts: { BasePart }, duration: number)
	for _, part in parts do
		U.tween(part, duration, { Transparency = 1 })
	end
	task.delay(duration + 0.05, function()
		for _, part in parts do
			part:Destroy()
		end
	end)
end

local function handOf(character: Model, side: string): Vector3?
	local arm = character:FindFirstChild(side .. " Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.15, 0)).Position else nil
end

-- A straight bar of light or wind between two points.
local function bar(from: Vector3, to: Vector3, width: number, color: Color3, transparency: number): BasePart
	if (to - from).Magnitude < 1e-3 then
		to = from + UP * 0.05
	end
	local length = math.max((to - from).Magnitude, 0.05)
	return U.newPart({
		Size = Vector3.new(width, width, length),
		CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to),
		Color = color,
		Transparency = transparency,
	})
end

-- A round beam (cylinder) between two points.
local function tube(from: Vector3, to: Vector3, width: number, color: Color3, transparency: number): BasePart
	if (to - from).Magnitude < 1e-3 then
		to = from + UP * 0.05
	end
	local length = math.max((to - from).Magnitude, 0.05)
	return U.newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, width, width),
		CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to) * CFrame.Angles(0, rad(90), 0),
		Color = color,
		Transparency = transparency,
	})
end

-- Re-poses a bar (from `bar`) to run between two points.
local function stretch(line: BasePart, from: Vector3, to: Vector3)
	line.Size = Vector3.new(line.Size.X, line.Size.Y, (to - from).Magnitude + 0.05)
	line.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
end

-- A neon wedge (U.newPart for wedges), for pointed shapes.
local function newWedge(props: { [string]: any }): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Anchored = true
	wedge.CanCollide = false
	wedge.CanQuery = false
	wedge.CanTouch = false
	wedge.CastShadow = false
	wedge.Material = Enum.Material.Neon
	for key, value in props do
		(wedge :: any)[key] = value
	end
	wedge.Parent = U.folder
	return wedge
end

-- Wind streaming into a point from all round it.
local function inflow(target: Vector3, radius: number, color: Color3?)
	local from = target + U.randomUnit() * radius
	local wisp = bar(from, from + (target - from).Unit * 1.2, 0.08, color or WIND_WHITE, 0.3)
	U.tween(wisp, 0.22, { CFrame = CFrame.lookAt(target, target + (target - from).Unit), Transparency = 1 })
	task.delay(0.25, wisp.Destroy, wisp)
end

-- A burst of pale wind streaks.
local function gust(position: Vector3, size: number, direction: Vector3?)
	U.burst(position, {
		color = WIND_WHITE,
		count = math.floor(8 + size * 3),
		size = 0.3 + size * 0.06,
		speed = NumberRange.new(14 + size * 4, 28 + size * 8),
		lifetime = NumberRange.new(0.15, 0.35),
		streaks = true,
		spread = if direction then 40 else 180,
		direction = direction,
	})
	U.ringBurst(CFrame.new(position), WIND, size * 0.2, size, 0.3, 0.12)
	U.light(position, WIND, 3, size * 2.5, 0.25)
end

-- A four-pointed star of light (star magic): a white core, a gold cross and
-- a smaller diagonal cross, always turned to face the camera.
type Star = { place: (Vector3, number) -> (), fade: (number) -> (), parts: { BasePart } }

local function makeStar(size: number, color: Color3?): Star
	local tint = color or STAR
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local function add(part: BasePart, offset: CFrame)
		table.insert(parts, part)
		table.insert(offsets, offset)
	end
	add(
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.32, Color = STAR_WHITE }),
		CFrame.identity
	)
	for i = 0, 3 do
		local long = i % 2 == 0
		add(
			U.newPart({
				Size = Vector3.new(size * 0.07, size * (if long then 1.15 else 0.55), size * 0.07),
				Color = tint,
				Transparency = 0.05,
			}),
			CFrame.Angles(0, 0, i * math.pi / 4)
		)
	end
	add(
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.95, Color = tint, Transparency = 0.82 }),
		CFrame.identity
	)
	local light = Instance.new("PointLight")
	light.Color = tint
	light.Range = size * 6
	light.Brightness = 2.5
	light.Parent = parts[1]
	local star = { parts = parts }
	function star.place(position: Vector3, spin: number)
		local base = CFrame.lookAt(position, workspace.CurrentCamera.CFrame.Position) * CFrame.Angles(0, 0, spin)
		for i, part in parts do
			part.CFrame = base * offsets[i]
		end
	end
	function star.fade(duration: number)
		light.Enabled = false
		fadeOut(parts, duration)
	end
	return star
end

-- Sylph: a small spirit of wind, a glowing body with two fluttering wings.
type Sprite = { place: (CFrame, number) -> (), fade: (number) -> () }

local function makeSprite(scale: number): Sprite
	local body = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.5, 0.5, 0.5) * scale,
		Color = WIND_WHITE,
	})
	local glow = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.3 * scale,
		Color = WIND,
		Transparency = 0.7,
	})
	local wings = {
		U.newPart({ Size = Vector3.new(0.9, 0.05, 0.5) * scale, Color = WIND, Transparency = 0.35 }),
		U.newPart({ Size = Vector3.new(0.9, 0.05, 0.5) * scale, Color = WIND, Transparency = 0.35 }),
	}
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 6 * scale
	light.Brightness = 2
	light.Parent = body
	local parts = { body, glow, wings[1], wings[2] }
	local sprite = {}
	function sprite.place(cframe: CFrame, t: number)
		body.CFrame = cframe
		glow.CFrame = cframe
		local flap = math.sin(t * 30) * rad(40)
		wings[1].CFrame = cframe * CFrame.Angles(0, 0, flap) * CFrame.new(0.45 * scale, 0, 0)
		wings[2].CFrame = cframe * CFrame.Angles(0, 0, -flap) * CFrame.new(-0.45 * scale, 0, 0)
	end
	function sprite.fade(duration: number)
		light.Enabled = false
		fadeOut(parts, duration)
	end
	return sprite
end

-- An arc of thin segments (a bow, a crescent of wind): points on a circle of
-- `radius` round `center` from angle `from` to `to` (radians) in the plane of
-- `right` and `up`.
local function arcPoints(
	center: Vector3,
	right: Vector3,
	up: Vector3,
	radius: number,
	from: number,
	to: number,
	count: number
): { Vector3 }
	local points = {}
	for i = 0, count do
		local angle = from + (to - from) * i / count
		table.insert(points, center + (right * math.cos(angle) + up * math.sin(angle)) * radius)
	end
	return points
end

local function arcParts(points: { Vector3 }, width: number, color: Color3, transparency: number): { BasePart }
	local parts = {}
	for i = 1, #points - 1 do
		table.insert(parts, bar(points[i], points[i + 1], width, color, transparency))
	end
	return parts
end

local function poseArc(parts: { BasePart }, points: { Vector3 })
	for i, part in parts do
		local a, b = points[i], points[i + 1]
		part.Size = Vector3.new(part.Size.X, part.Size.Y, (b - a).Magnitude + 0.05)
		part.CFrame = CFrame.lookAt(a:Lerp(b, 0.5), b)
	end
end

---------------------------------------------------------------------------
-- Base: Prince of Wind
---------------------------------------------------------------------------

-- Wind Blades Shower: a ring of wind forms over the spot and blades fill
-- the sky in it (white blades with pointed tips in a green glow), then fall
-- in waves streaking wind behind them, each bursting where it lands.
local function fallingBlade(target: Vector3, formDelay: number, fallAt: number, alive: () -> boolean)
	local start = target + Vector3.new(math.random(-30, 30) / 10, 20 + math.random() * 6, math.random(-30, 30) / 10)
	local cframe = CFrame.lookAt(start, target) * CFrame.Angles(0, 0, math.random() * math.pi)
	local blade = U.newPart({ Size = Vector3.new(0.08, 0.5, 2.4), Color = WIND_WHITE, Transparency = 1 })
	local parts: { BasePart } = {
		blade,
		newWedge({ Size = Vector3.new(0.08, 0.25, 1.1), Color = WIND_WHITE, Transparency = 1 }),
		newWedge({ Size = Vector3.new(0.08, 0.25, 1.1), Color = WIND_WHITE, Transparency = 1 }),
		U.newPart({ Size = Vector3.new(0.04, 1.3, 4), Color = WIND, Transparency = 1 }),
	}
	local offsets = {
		CFrame.identity,
		CFrame.new(0, 0.125, -1.75),
		CFrame.new(0, -0.125, -1.75) * CFrame.Angles(0, 0, math.pi),
		CFrame.new(0, 0, -0.3),
	}
	local shown = { 0.05, 0.05, 0.05, 0.6 }
	for i, part in parts do
		part.CFrame = cframe * offsets[i]
	end
	local tail0 = Instance.new("Attachment")
	tail0.Position = Vector3.new(0, 0.25, 1.2)
	tail0.Parent = blade
	local tail1 = Instance.new("Attachment")
	tail1.Position = Vector3.new(0, -0.25, 1.2)
	tail1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Attachment0 = tail0
	trail.Attachment1 = tail1
	trail.Color = ColorSequence.new(WIND_WHITE, WIND)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.12
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Parent = blade
	task.delay(formDelay, function()
		for i, part in parts do
			U.tween(part, 0.2, { Transparency = shown[i] })
		end
	end)
	task.delay(fallAt, function()
		if not alive() then
			-- Cancelled during the wind-up: the blade just fades.
			trail.Enabled = false
			fadeOut(parts, 0.15)
			return
		end
		local drop = target - start
		for _, part in parts do
			U.tween(part, 0.14, { CFrame = part.CFrame + drop }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		task.delay(0.14, function()
			for _, part in parts do
				part:Destroy()
			end
			U.burst(target, {
				color = WIND_WHITE,
				count = 5,
				size = 0.35,
				speed = NumberRange.new(10, 22),
				lifetime = NumberRange.new(0.12, 0.25),
				streaks = true,
				spread = 70,
			})
			U.ringBurst(CFrame.new(target + UP * 0.1), WIND, 0.4, 2.4, 0.22, 0.08)
			U.flash(target + UP * 0.3, WIND_WHITE, 1.6, 0.1)
		end)
	end)
end

-- Per cast, so only the Shower's own Cancel (not his next move) stops its
-- blades.
local showers: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any

function handlers.WindBladesShower(data, character, root)
	if data.phase == "Cast" then
		play(character, ANIMS.Shower)
		local id = (showers[character] or 0) + 1
		showers[character] = id
		local function alive(): boolean
			return showers[character] == id and character.Parent ~= nil
		end
		local center: Vector3 = data.center
		local radius: number = data.radius
		local delay: number = data.delay
		-- Where it will fall: a faint circle on the ground and a ring of wind above.
		U.ringBurst(CFrame.new(center + UP * 0.15), WIND, radius, radius, delay + data.waves * data.gap, 0.12)
		U.ringBurst(CFrame.new(center + UP * 22), WIND_WHITE, 2, radius + 2, delay + 0.2, 0.3)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, UP)
		end
		-- The wind-up: wind streams into his raised hand as the blades gather.
		every(delay, function()
			local palm = handOf(character, "Right")
			if not alive() or not palm then
				return false
			end
			inflow(palm, 5)
			return true
		end)
		for wave = 1, data.waves do
			for _ = 1, 3 do
				local angle = math.random() * math.pi * 2
				local spot = center
					+ Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * math.sqrt(math.random())
				fallingBlade(spot, math.random() * delay * 0.6, delay + (wave - 1) * data.gap, alive)
			end
		end
		task.delay(delay + data.waves * data.gap, function()
			if not alive() then
				return
			end
			gust(center + UP, 6, UP)
			U.groundCracks(center, 6, radius * 0.7, WIND, 1)
			if (workspace.CurrentCamera.CFrame.Position - center).Magnitude < 40 then
				CameraShake.Add(0.12)
			end
		end)
	elseif data.phase == "Cancel" then
		showers[character] = (showers[character] or 0) + 1
	end
end

-- Swift White Hawk: a hawk of wind (white core, green wings beating, a
-- streaming tail) flies out and curves after its target, bursting into
-- feathers of wind when it strikes.
local hawks: { [Model]: { done: boolean, position: Vector3 } } = {}

function handlers.SwiftWhiteHawk(data, character, root)
	if data.phase == "Cast" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			for _ = 1, 6 do
				inflow(hand, 4)
			end
		end
	elseif data.phase == "Fly" then
		local state = { done = false, position = data.origin :: Vector3 }
		hawks[character] = state
		local direction: Vector3 = data.direction
		local target: Model? = data.target
		local body = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Color = WIND_WHITE })
		local aura = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.2, 2.2, 2.2),
			Color = WIND,
			Transparency = 0.65,
		})
		local head = U.newPart({ Size = Vector3.new(0.6, 0.6, 0.9), Color = WIND_WHITE })
		local wings = {
			U.newPart({ Size = Vector3.new(3, 0.08, 1.2), Color = WIND, Transparency = 0.2 }),
			U.newPart({ Size = Vector3.new(3, 0.08, 1.2), Color = WIND, Transparency = 0.2 }),
		}
		local tail = U.newPart({ Size = Vector3.new(1.2, 0.06, 1.6), Color = WIND, Transparency = 0.3 })
		local parts = { body, aura, head, wings[1], wings[2], tail }
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 14
		light.Brightness = 3
		light.Parent = body
		local travelled = 0
		every(data.range / data.speed + 0.3, function(elapsed, dt)
			if state.done then
				return false
			end
			local targetRoot = target and U.getRoot(target)
			if targetRoot then
				local want = (targetRoot.Position - state.position).Unit
				local angle = math.acos(math.clamp(direction:Dot(want), -1, 1))
				if angle > 1e-3 then
					direction = direction:Lerp(want, math.min(1, data.turn * dt / angle)).Unit
				end
			end
			local step = data.speed * dt
			state.position += direction * step
			travelled += step
			local frame = CFrame.lookAt(state.position, state.position + direction)
			body.CFrame = frame
			aura.CFrame = frame
			head.CFrame = frame * CFrame.new(0, 0.15, -0.8)
			local flap = math.sin(elapsed * 22) * rad(35)
			wings[1].CFrame = frame * CFrame.Angles(0, 0, flap) * CFrame.new(1.5, 0, 0.1)
			wings[2].CFrame = frame * CFrame.Angles(0, 0, -flap) * CFrame.new(-1.5, 0, 0.1)
			tail.CFrame = frame * CFrame.new(0, 0, 1.1)
			if math.random() < 0.5 then
				local streak = bar(state.position, state.position - direction * 2.5, 0.12, WIND_WHITE, 0.4)
				U.tween(streak, 0.25, { Transparency = 1, Size = Vector3.new(0.02, 0.02, 2.5) })
				task.delay(0.26, streak.Destroy, streak)
			end
			return travelled < data.range
		end, function()
			hawks[character] = nil
			fadeOut(parts, 0.12)
		end)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, direction)
		end
	elseif data.phase == "Burst" then
		local state = hawks[character]
		if state then
			state.done = true
		end
		local position: Vector3 = data.position
		if data.fade then
			gust(position, 3)
			return
		end
		gust(position, 7)
		U.shockwave(position, WIND, 2, 9, 0.3)
		U.burst(position, {
			color = WIND,
			count = 18,
			size = 0.6,
			speed = NumberRange.new(20, 40),
			lifetime = NumberRange.new(0.25, 0.5),
			spread = 180,
			drag = 3,
		})
		if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 30 then
			CameraShake.Add(0.15)
		end
	end
end

-- Heavenly Wind Ark: a great crescent of wind rises out of the ground in
-- front of him (on the ground) or sweeps down beneath him (in the air).
function handlers.HeavenlyWindArk(data, character, root)
	if data.phase == "Cast" then
		play(character, if data.airborne then ANIMS.AirArk else ANIMS.Ark)
	elseif data.phase == "Carry" then
		-- Up together on a spiral of wind.
		for _, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				U.spiral(targetRoot, WIND, 2.5, 6, data.rise, 3, 0.12, 0.3)
				U.bodyTrail(target, WIND, 0.35)
			end
		end
		U.spiral(root, WIND_WHITE, 2.5, 6, 0.4, 2, 0.1, 0.3)
		U.bodyTrail(character, WIND, 0.35)
	elseif data.phase == "Rise" then
		local forward: Vector3 = data.direction
		local right = forward:Cross(UP).Unit
		local air = data.airborne == true
		local center = data.origin + forward * 5.5 + (if air then UP * -2 else UP * -3)
		local from, to = if air then math.pi * 1.05 else -0.05, if air then math.pi * 1.95 else math.pi * 1.05
		local points = arcPoints(center, right, UP, 6, from, to, 12)
		local outer = arcParts(points, 0.9, WIND, 0.45)
		local inner = arcParts(points, 0.3, WIND_WHITE, 0.05)
		local shift = if air then UP * -8 else UP * 9
		for _, part in outer do
			U.tween(part, 0.45, { CFrame = part.CFrame + shift, Transparency = 1 })
		end
		for _, part in inner do
			U.tween(part, 0.4, { CFrame = part.CFrame + shift, Transparency = 1 })
		end
		task.delay(0.5, function()
			for _, part in outer do
				part:Destroy()
			end
			for _, part in inner do
				part:Destroy()
			end
		end)
		if air then
			U.burst(center, {
				color = WIND_WHITE,
				count = 20,
				size = 0.5,
				speed = NumberRange.new(30, 60),
				lifetime = NumberRange.new(0.2, 0.4),
				streaks = true,
				spread = 30,
				direction = -UP,
			})
		else
			U.pillar(center, WIND, 3.5, 14, 0.4, Enum.Material.ForceField, 0.2)
			U.burst(center, {
				color = WIND_WHITE,
				count = 24,
				size = 0.5,
				speed = NumberRange.new(35, 70),
				lifetime = NumberRange.new(0.2, 0.45),
				streaks = true,
				spread = 25,
				direction = UP,
			})
			U.groundCracks(center, 4, 5, WIND, 0.8)
			U.debris(center, 6, 30, 0.6)
		end
		U.light(center, WIND, 4, 18, 0.35)
		if U.isLocal(character) then
			CameraShake.Add(0.14)
			CameraShake.FovKick(5)
		end
	end
end

-- Gale White Bow: a great bow of wind in his left hand, the string drawn to
-- his chin, held through the volley; each arrow streaks out spinning (the
-- wind arrow below, shared by every arrow move).

-- A wind arrow: a white-hot shaft in a shimmer of wind, a four-bladed head
-- of light (one pair of blades white, the other gold), three fins of green
-- wind for fletching, a glow at the head and a ribbon of wind streaming off
-- the tail. Posed by its middle; -Z is where it points.
type Arrow = { place: (CFrame) -> (), destroy: (number) -> () }

local function makeArrow(scale: number): Arrow
	local s = scale
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local function add(part: BasePart, offset: CFrame)
		table.insert(parts, part)
		table.insert(offsets, offset)
	end
	add(U.newPart({ Size = Vector3.new(0.12, 0.12, 3.4) * s, Color = WIND_WHITE }), CFrame.identity)
	add(
		U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3.6, 0.5, 0.5) * s,
			Color = WIND,
			Material = Enum.Material.ForceField,
		}),
		CFrame.Angles(0, rad(90), 0)
	)
	for blade = 0, 1 do
		local turn = CFrame.Angles(0, 0, blade * math.pi / 2)
		local color = if blade == 0 then WIND_WHITE else STAR
		add(
			newWedge({ Size = Vector3.new(0.06, 0.28, 0.9) * s, Color = color }),
			turn * CFrame.new(0, 0.14 * s, -2.15 * s)
		)
		add(
			newWedge({ Size = Vector3.new(0.06, 0.28, 0.9) * s, Color = color }),
			turn * CFrame.new(0, -0.14 * s, -2.15 * s) * CFrame.Angles(0, 0, math.pi)
		)
	end
	for fin = 0, 2 do
		add(
			newWedge({ Size = Vector3.new(0.04, 0.36, 0.8) * s, Color = WIND, Transparency = 0.15 }),
			CFrame.Angles(0, 0, fin * math.pi * 2 / 3) * CFrame.new(0, 0.22 * s, 1.35 * s)
		)
	end
	local glow =
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7 * s, Color = STAR, Transparency = 0.45 })
	add(glow, CFrame.new(0, 0, -1.75 * s))
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 8 * s
	light.Brightness = 2
	light.Parent = glow
	local tail0 = Instance.new("Attachment")
	tail0.Position = Vector3.new(0, 0.18 * s, 1.6 * s)
	tail0.Parent = parts[1]
	local tail1 = Instance.new("Attachment")
	tail1.Position = Vector3.new(0, -0.18 * s, 1.6 * s)
	tail1.Parent = parts[1]
	local trail = Instance.new("Trail")
	trail.Attachment0 = tail0
	trail.Attachment1 = tail1
	trail.Color = ColorSequence.new(WIND_WHITE, WIND)
	trail.Transparency = NumberSequence.new(0.15, 1)
	trail.Lifetime = 0.2
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Parent = parts[1]
	local arrow = {}
	function arrow.place(frame: CFrame)
		for i, part in parts do
			part.CFrame = frame * offsets[i]
		end
	end
	function arrow.destroy(duration: number)
		trail.Enabled = false
		light.Enabled = false
		fadeOut(parts, duration)
	end
	return arrow
end

-- Where an arrow strikes: a ring and a burst of wind and a white flash.
local function arrowStrike(position: Vector3, direction: Vector3, scale: number)
	U.flash(position, WIND_WHITE, 2 * scale, 0.12)
	U.impactRing(position, direction, WIND_WHITE, 0.4, 2.6 * scale, 0.22)
	gust(position, 2 + 2 * scale, -direction)
end

-- Moves a missile from `origin` along `direction` until it hits a wall or
-- the ground or runs out of range (people don't stop it here: the server
-- decides hits). `place(position, elapsed)` poses it every frame, `strike`
-- gets where it hit a wall, then `done` cleans it up.
local function fly(
	origin: Vector3,
	direction: Vector3,
	speed: number,
	range: number,
	place: (Vector3, number) -> (),
	strike: (Vector3) -> (),
	done: () -> ()
)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { U.folder }
	local position = origin
	local travelled = 0
	place(position, 0)
	every(range / speed + 0.1, function(elapsed, dt)
		local step = speed * dt
		local wall = workspace:Raycast(position, direction * step, params)
		local model = wall and wall.Instance:FindFirstAncestorWhichIsA("Model")
		if wall and not (model and model:FindFirstChildOfClass("Humanoid")) then
			strike(wall.Position)
			return false
		end
		position += direction * step
		travelled += step
		place(position, elapsed)
		return travelled < range
	end, done)
end

-- A wind arrow in flight, spinning (a new one, or one already drawn).
local function flyingArrow(
	origin: Vector3,
	direction: Vector3,
	speed: number,
	range: number,
	scale: number,
	drawn: Arrow?
)
	local arrow = drawn or makeArrow(scale)
	fly(origin, direction, speed, range, function(position, elapsed)
		arrow.place(CFrame.lookAt(position, position + direction) * CFrame.Angles(0, 0, elapsed * 14))
	end, function(position)
		arrowStrike(position, direction, scale)
	end, function()
		arrow.destroy(0.12)
	end)
end

-- The bow keeps an arrow nocked between shots (each one loosed is the arrow
-- that was on the string). Held on the ground, the arrow on the string
-- becomes a great one and the bow grows as he keeps drawing.
type Bow = {
	stop: () -> (),
	nocked: Arrow?,
	scale: number, -- of the nocked arrow
	ends: number, -- os.clock() when the bow goes
	charging: number?, -- os.clock() the great arrow started drawing
	glow: BasePart?,
}
local bows: { [Model]: Bow } = {}

function handlers.GaleWhiteBow(data, character, root)
	if data.phase == "Draw" then
		play(character, ANIMS.Bow)
		local token = bump(character)
		local length = data.draw + data.arrows * data.gap + 0.25
		local segments = 10
		local limbs = arcParts(table.create(segments + 1, Vector3.zero), 0.22, WIND, 0.2)
		local core = arcParts(table.create(segments + 1, Vector3.zero), 0.08, WIND_WHITE, 0)
		local strings = { bar(Vector3.zero, UP, 0.05, WIND_WHITE, 0.2), bar(Vector3.zero, UP, 0.05, WIND_WHITE, 0.2) }
		local all = table.clone(limbs)
		table.move(core, 1, #core, #all + 1, all)
		table.move(strings, 1, 2, #all + 1, all)
		local bow: Bow = {
			stop = function() end,
			nocked = makeArrow(1),
			scale = 1,
			ends = os.clock() + length,
		}
		function bow.stop()
			bows[character] = nil
			fadeOut(all, 0.2)
			if bow.nocked then
				bow.nocked.destroy(0.15)
				bow.nocked = nil
			end
			if bow.glow then
				fadeOut({ bow.glow }, 0.1)
				bow.glow = nil
			end
		end
		bows[character] = bow
		every(length + 2, function(elapsed)
			local hand = handOf(character, "Left")
			local pull = handOf(character, "Right")
			if not live(character, token) or not hand or not pull or not root.Parent or os.clock() > bow.ends then
				return false
			end
			local forward = root.CFrame.LookVector
			local right = forward:Cross(UP).Unit
			local grow = math.min(elapsed / 0.2, 1)
			local charge = if bow.charging then math.min((os.clock() - bow.charging) / 0.6, 1) else 0
			-- The grip stays put in his hand as the bow grows.
			local radius = (3.4 + 1.4 * charge) * grow + 0.1
			local center = hand + forward * (2.2 - radius)
			local points = arcPoints(center, forward, UP, radius, -1.1, 1.1, segments)
			poseArc(limbs, points)
			poseArc(core, points)
			local nock = pull + right * 0.1
			strings[1].Size = Vector3.new(0.05, 0.05, (points[1] - nock).Magnitude)
			strings[1].CFrame = CFrame.lookAt(points[1]:Lerp(nock, 0.5), nock)
			strings[2].Size = Vector3.new(0.05, 0.05, (points[#points] - nock).Magnitude)
			strings[2].CFrame = CFrame.lookAt(points[#points]:Lerp(nock, 0.5), nock)
			if bow.nocked then
				local frame = CFrame.lookAt(nock, nock + forward) * CFrame.new(0, 0, -1.6 * bow.scale)
				bow.nocked.place(frame * CFrame.Angles(0, 0, charge * elapsed * 6))
				if bow.glow then
					-- Wind spirals into the head as it draws.
					local head = (frame * CFrame.new(0, 0, -2.3 * bow.scale)).Position
					bow.glow.Size = Vector3.one * (0.8 + 2.6 * charge) * (1 + 0.1 * math.sin(elapsed * 30))
					bow.glow.CFrame = CFrame.new(head)
					inflow(head, 5 + 2 * charge)
				end
			end
			return true
		end, function()
			if bows[character] == bow then
				bow.stop()
			end
		end)
	elseif data.phase == "Arrow" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local bow = bows[character]
		local nocked = if bow and not data.last then bow.nocked else nil
		if bow and nocked then
			-- The arrow on the string flies; the next one forms there.
			bow.nocked = nil
			task.delay(0.06, function()
				if bows[character] == bow and not bow.nocked then
					bow.nocked = makeArrow(1)
				end
			end)
		elseif bow and bow.nocked then
			bow.nocked.destroy(0.05)
			bow.nocked = nil
		end
		flyingArrow(origin, direction, data.speed, data.range, if data.last then 1.4 else 1, nocked)
		gust(origin, if data.last then 4 else 2, direction)
		U.impactRing(origin, direction, WIND_WHITE, 0.4, if data.last then 4 else 2.4, 0.18)
		if U.isLocal(character) then
			CameraShake.FovKick(if data.last then 5 else 2)
		end
	elseif data.phase == "Charge" then
		-- Held on the ground: the arrow on the string becomes a great one.
		local bow = bows[character]
		if bow then
			if bow.nocked then
				bow.nocked.destroy(0.05)
			end
			bow.nocked = makeArrow(1.8)
			bow.scale = 1.8
			bow.charging = os.clock()
			bow.ends = os.clock() + data.max + 0.6
			bow.glow = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, Color = WIND, Transparency = 0.55 })
		end
		local pull = handOf(character, "Right")
		if pull then
			gust(pull, 3)
		end
		if U.isLocal(character) then
			CameraShake.Add(0.05)
		end
	elseif data.phase == "Great" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local bow = bows[character]
		local drawn = if bow then bow.nocked else nil
		if bow then
			bow.nocked = nil
			bow.stop()
		end
		flyingArrow(origin, direction, data.speed, data.range, 1.8, drawn)
		U.flash(origin, WIND_WHITE, 7, 0.18)
		gust(origin, 7, direction)
		U.shockwave(origin, WIND, 2, 12, 0.3)
		for i = 0, 3 do
			task.delay(i * 0.03, U.impactRing, origin + direction * i * 3, direction, WIND_WHITE, 1, 7 - i, 0.28)
		end
		U.light(origin, WIND, 6, 28, 0.35)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(9)
		end
		task.delay(0.2, function()
			if PoseAnimator.Current(character) == ANIMS.Bow then
				PoseAnimator.FadeOut(character, 0.25)
			end
		end)
	elseif data.phase == "Cancel" then
		bump(character)
		local bow = bows[character]
		if bow then
			bow.stop()
		end
	end
end

---------------------------------------------------------------------------
-- R: Conjunction
---------------------------------------------------------------------------

local stars: { [Model]: Star } = {}

function handlers.Conjunction(data, character, root)
	if data.phase == "Place" then
		play(character, ANIMS.Conjunction)
		local old = stars[character]
		if old then
			old.fade(0.1)
		end
		local origin: Vector3 = data.origin
		local spot: Vector3 = data.star
		local star = makeStar(1.8)
		stars[character] = star
		-- Flicked out to its spot, then it hangs there turning, pulsing.
		every(data.life, function(elapsed)
			if stars[character] ~= star then
				return false
			end
			local travel = math.min(elapsed / 0.15, 1)
			local position = origin:Lerp(spot, 1 - (1 - travel) ^ 2)
			star.place(position + UP * math.sin(elapsed * 3) * 0.15, elapsed * 2.5)
			return true
		end, function()
			if stars[character] == star then
				stars[character] = nil
				star.fade(0.3)
			end
		end)
		U.ringBurst(CFrame.new(spot), STAR, 0.4, 3, 0.35, 0.1)
	elseif data.phase == "Warp" then
		local star = stars[character]
		stars[character] = nil
		if star then
			star.fade(0.15)
		end
		local from: Vector3 = data.from
		local spot: Vector3 = data.star
		play(character, ANIMS.Warp)
		-- Gone in a flash of starlight, and there.
		local line = bar(from, spot, 0.25, STAR_WHITE, 0.1)
		local glow = bar(from, spot, 0.9, STAR, 0.6)
		fadeOut({ line, glow }, 0.25)
		for _, at in { from, spot } do
			U.flash(at, STAR_WHITE, 6, 0.25)
			U.ringBurst(CFrame.new(at - UP * 2.6), STAR, 1, 6, 0.3, 0.12)
			U.burst(at, {
				color = STAR,
				count = 14,
				size = 0.35,
				speed = NumberRange.new(8, 20),
				lifetime = NumberRange.new(0.3, 0.6),
				spread = 180,
				drag = 3,
			})
		end
		U.light(spot, STAR, 4, 16, 0.3)
		if U.isLocal(character) then
			CameraShake.FovKick(-6)
		end
	elseif data.phase == "Fade" then
		local star = stars[character]
		stars[character] = nil
		if star then
			star.fade(0.3)
		end
	end
end

---------------------------------------------------------------------------
-- Half-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Spirit Storm. The charge: Sylph's mana gathers in his palm as an orb of
-- storm, a white core in a green halo inside a shimmering shell, three
-- rings of wind whirling round it on tilted axes, wind streaming in from
-- all round and a ring drawn in along the ground. The beam: a white-hot
-- core in a green column inside a shimmering sheath, three helices of wind
-- twisting round it and spinning, rings tearing off along it, streaks
-- racing down it, the muzzle pulsing; it scars the ground it passes over
-- and bursts where it ends; when it stops the helices unwind and it
-- collapses.
local STORM_STRANDS = 3
local STORM_SEGMENTS = 18

function handlers.SpiritStorm(data, character, root)
	if data.phase == "Charge" then
		play(character, ANIMS.StormCharge)
		local token = bump(character)
		local orb = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Color = WIND_WHITE })
		local halo =
			U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.4, Color = WIND, Transparency = 0.5 })
		local shell = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			Color = WIND,
			Material = Enum.Material.ForceField,
		})
		local rings = {}
		for _ = 1, 3 do
			table.insert(
				rings,
				arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 10), 0.08, WIND_WHITE, 0.15)
			)
		end
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 12
		light.Brightness = 1
		light.Parent = orb
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Right")
			if not live(character, token) or not hand then
				return false
			end
			local grow = math.min(elapsed / data.duration, 1)
			local center = hand + root.CFrame.LookVector * 0.7
			orb.Size = Vector3.one * (0.3 + 1.1 * grow)
			halo.Size = Vector3.one * (0.8 + 2.4 * grow)
			shell.Size = Vector3.one * (1 + 3.2 * grow)
			orb.CFrame = CFrame.new(center)
			halo.CFrame = orb.CFrame
			shell.CFrame = orb.CFrame * CFrame.Angles(elapsed * 3, elapsed * 2, 0)
			for r, ring in rings do
				local tilt = CFrame.Angles(r * 1.1 + elapsed * (3 + r), elapsed * (4 - r), r * 0.7)
				poseArc(
					ring,
					arcPoints(center, tilt.RightVector, tilt.UpVector, 0.7 + 1.7 * grow + r * 0.25, 0, math.pi * 2, 10)
				)
			end
			inflow(center, 6)
			inflow(center, 4)
			light.Brightness = 1 + 5 * grow
			return true
		end, function()
			fadeOut({ orb, halo, shell }, 0.08)
			for _, ring in rings do
				fadeOut(ring, 0.08)
			end
		end)
		U.ringBurst(CFrame.new(root.Position - UP * 2.9), WIND, 7, 1, data.duration, 0.15)
		U.spiral(root, WIND, 2.2, 4, data.duration, 2, 0.08, 0.6)
		if U.isLocal(character) then
			CameraShake.Add(0.06)
		end
	elseif data.phase == "Fire" then
		play(character, ANIMS.StormFire)
		local token = bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local length: number = data.length
		local finish = origin + direction * length
		local right = direction:Cross(UP)
		right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
		local up = right:Cross(direction).Unit

		local core = tube(origin, finish, 1.2, WIND_WHITE, 0)
		local column = tube(origin, finish, 4.2, WIND, 0.5)
		local sheath = tube(origin, finish, 6.4, WIND, 0)
		sheath.Material = Enum.Material.ForceField
		local haze = tube(origin, finish, 9, WIND_DEEP, 0.9)
		local strands: { { BasePart } } = {}
		for k = 1, STORM_STRANDS do
			local strand = {}
			for _ = 1, STORM_SEGMENTS do
				table.insert(
					strand,
					bar(
						origin,
						origin + direction,
						if k == 1 then 0.3 else 0.22,
						if k == 1 then WIND_WHITE else WIND,
						0.1
					)
				)
			end
			table.insert(strands, strand)
		end
		-- Streaks racing down the beam.
		local muzzle = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.lookAt(origin, finish) })
		local streaks = Instance.new("ParticleEmitter")
		streaks.Texture = U.textures.Spark
		streaks.Color = ColorSequence.new(WIND_WHITE, WIND)
		streaks.LightEmission = 1
		streaks.LightInfluence = 0
		streaks.EmissionDirection = Enum.NormalId.Front
		streaks.Orientation = Enum.ParticleOrientation.VelocityParallel
		streaks.Speed = NumberRange.new(150, 210)
		streaks.Lifetime = NumberRange.new(length / 210, length / 150)
		streaks.SpreadAngle = Vector2.new(5, 5)
		streaks.Size = NumberSequence.new(0.7, 0.1)
		streaks.Transparency = NumberSequence.new(0.1, 1)
		streaks.Rate = 140
		streaks.Parent = muzzle
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 28
		light.Brightness = 5
		light.Parent = core

		local nextRing, nextPulse = 0, 0
		every(data.duration, function(elapsed)
			if not live(character, token) then
				return false
			end
			-- Three helices of wind, twisting round the beam and spinning.
			local spin = elapsed * 14
			for k, strand in strands do
				local phase = k * (math.pi * 2 / STORM_STRANDS) + spin
				local radius = 2.5 + 0.35 * math.sin(elapsed * 30 + k)
				local previous = origin
				for i, segment in strand do
					local s = i / #strand * length
					local angle = phase + s * 0.35
					local point = origin
						+ direction * s
						+ (right * math.cos(angle) + up * math.sin(angle)) * radius * math.min(s / 3, 1)
					segment.Size = Vector3.new(segment.Size.X, segment.Size.Y, (point - previous).Magnitude + 0.05)
					segment.CFrame = CFrame.lookAt(previous:Lerp(point, 0.5), point)
					previous = point
				end
			end
			local breathe = 1 + math.sin(elapsed * 40) * 0.07
			column.Size = Vector3.new(column.Size.X, 4.2 * breathe, 4.2 * breathe)
			core.Size =
				Vector3.new(core.Size.X, 1.2 + math.sin(elapsed * 55) * 0.18, 1.2 + math.sin(elapsed * 55) * 0.18)
			if elapsed >= nextRing then
				nextRing = elapsed + 0.035
				U.impactRing(origin + direction * (math.random() * length), direction, WIND_WHITE, 2, 5.5, 0.2)
			end
			if elapsed >= nextPulse then
				nextPulse = elapsed + 0.1
				U.impactRing(origin, direction, WIND, 1.5, 7, 0.25)
			end
			return true
		end, function()
			-- The helices unwind outward and it all collapses.
			for _, strand in strands do
				for _, segment in strand do
					local out = segment.Position - (origin + direction * direction:Dot(segment.Position - origin))
					U.tween(segment, 0.3, {
						CFrame = segment.CFrame + (if out.Magnitude > 1e-3 then out.Unit * 2.5 else Vector3.zero),
						Transparency = 1,
					})
				end
				task.delay(0.32, function()
					for _, segment in strand do
						segment:Destroy()
					end
				end)
			end
			U.tween(core, 0.25, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
			fadeOut({ core, column, sheath, haze }, 0.3)
			streaks.Enabled = false
			task.delay(0.6, muzzle.Destroy, muzzle)
			gust(finish, 8, direction)
			U.shockwave(finish, WIND, 2, 14, 0.35)
		end)

		-- The ground it passes over is scarred.
		for along = 6, length, 6 do
			local ground = U.groundBelow(origin + direction * along, { character }, 7)
			if ground then
				task.delay(along / 300, function()
					U.groundCracks(ground.Position, 2, 4, WIND, 1.2)
					U.debris(ground.Position, 3, 25, 0.5)
				end)
			end
		end
		gust(origin, 6, direction)
		U.flash(origin, WIND_WHITE, 6, 0.2)
		U.impactRing(origin, direction, WIND_WHITE, 1, 9, 0.3)
		U.light(origin, WIND, 6, 24, 0.7)
		if U.isLocal(character) then
			CameraShake.Add(0.25)
			CameraShake.FovKick(10)
		elseif (workspace.CurrentCamera.CFrame.Position - origin).Magnitude < 40 then
			CameraShake.Add(0.1)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- A full tornado: a hollow funnel of wind, narrow at the ground and wide at
-- the top. Its wall is bands of overlapping panels (dust-grey and pale,
-- streaked with glowing green), each band welded to a hub so turning it is
-- one write, dense enough that you can barely see through it; dust pours
-- off it and debris whirls round inside it. It rises out of the ground,
-- spins, and blows apart.
local TORNADO_BANDS = 12
local TORNADO_PANELS = 16
local TORNADO_SHADES = { WIND, Color3.fromRGB(150, 176, 160), Color3.fromRGB(96, 120, 106) }

type Tornado = { update: (t: number, visible: number) -> (), destroy: () -> () }

local function makeTornado(base: Vector3, height: number): Tornado
	local bands = {}
	local emitters = {}
	for k = 1, TORNADO_BANDS do
		local fraction = (k - 0.5) / TORNADO_BANDS
		local radius = 2.5 + 11 * fraction ^ 1.25
		local hub = U.newPart({
			Size = Vector3.one * 0.2,
			Transparency = 1,
			CFrame = CFrame.new(base + UP * (height * fraction)),
		})
		local panels = {}
		local width = 2 * math.pi * radius / TORNADO_PANELS * 1.3
		for j = 1, TORNADO_PANELS do
			local shade = (j + k) % 3 + 1
			local panel = Instance.new("Part")
			panel.Anchored = false
			panel.CanCollide = false
			panel.CanQuery = false
			panel.CanTouch = false
			panel.CastShadow = false
			panel.Massless = true
			panel.Material = if shade == 1 then Enum.Material.Neon else Enum.Material.SmoothPlastic
			panel.Color = TORNADO_SHADES[shade]
			panel.Transparency = 1
			panel.Size = Vector3.new(width, height / TORNADO_BANDS + 0.8, 0.5)
			-- Leaning into the spin, like streaks of wind.
			panel.CFrame = hub.CFrame
				* CFrame.Angles(0, j / TORNADO_PANELS * math.pi * 2, 0)
				* CFrame.new(0, 0, -radius)
				* CFrame.Angles(0, 0, rad(18))
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hub
			weld.Part1 = panel
			weld.Parent = panel
			panel.Parent = U.folder
			table.insert(panels, { part = panel, solid = if shade == 1 then 0.35 else 0.18 })
			if k % 2 == 0 and j % 4 == 0 then
				local dust = Instance.new("ParticleEmitter")
				dust.Texture = U.textures.Smoke
				dust.Color = ColorSequence.new(Color3.fromRGB(170, 190, 175))
				dust.LightInfluence = 0.6
				dust.Size = NumberSequence.new(2.5, 4.5)
				dust.Transparency = NumberSequence.new(0.45, 1)
				dust.Lifetime = NumberRange.new(0.5, 0.8)
				dust.Rate = 0
				dust.Speed = NumberRange.new(0, 1)
				dust.Parent = panel
				table.insert(emitters, dust)
			end
		end
		table.insert(bands, { hub = hub, panels = panels, height = height * fraction, radius = radius, shown = -1 })
	end
	local debris = {}
	for _ = 1, 18 do
		table.insert(
			debris,
			U.newPart({
				Size = Vector3.new(0.4, 0.3, 0.5) * (1 + math.random() * 1.5),
				Color = Color3.fromRGB(92, 86, 78),
				Material = Enum.Material.Slate,
				Transparency = 1,
			})
		)
	end

	local tornado = {}
	-- `visible` 0 to 1: how much of it has risen out of the ground (bands
	-- appear from the foot up), then how solid it still is as it goes.
	function tornado.update(t: number, visible: number)
		for k, band in bands do
			band.hub.CFrame = CFrame.new(base + UP * band.height) * CFrame.Angles(0, t * (9 - k * 0.35) + k * 0.5, 0)
			local risen = math.clamp(visible * TORNADO_BANDS - (k - 1), 0, 1)
			local shown = math.floor(risen * 20 + 0.5) / 20
			if shown ~= band.shown then
				band.shown = shown
				for _, panel in band.panels do
					panel.part.Transparency = 1 - (1 - panel.solid) * shown
				end
			end
		end
		for _, dust in emitters do
			dust.Rate = if visible > 0.5 then 12 else 0
		end
		for i, chunk in debris do
			local fraction = (i - 0.5) / #debris
			local angle = t * (6 + i % 3) + i
			local radius = (2.5 + 11 * fraction ^ 1.25) * 0.75
			local position = base
				+ Vector3.new(
					math.cos(angle) * radius,
					height * 0.9 * fraction + math.sin(t * 2 + i) * 1.5,
					math.sin(angle) * radius
				)
			chunk.CFrame = CFrame.new(position) * CFrame.Angles(t * 5 + i, t * 3, 0)
			chunk.Transparency = if visible > fraction then 0 else 1
		end
	end
	function tornado.destroy()
		for _, band in bands do
			band.hub:Destroy()
			for _, panel in band.panels do
				panel.part:Destroy()
			end
		end
		for _, chunk in debris do
			chunk:Destroy()
		end
	end
	return tornado
end

-- Tempest Dive: he flies straight up dragging them by the collar (wind
-- trailing off them both); a beat at the top, then he swings over them, a
-- full tornado rises out of the ground under them, and he drives them down
-- through the eye of it. The camera goes inside for the way down. Once
-- they hit, the tornado stands over the crater a moment, then blows apart.
local function playTempestDive(data, character: Model, root: BasePart)
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = DivePlan.Plan(data.origin, data.start, data.floorY)
	local times = DivePlan.Times
	local started = os.clock()
	local mine = involves(data, character)
	local floorY = plan.floorY
	local base = Vector3.new(plan.start.X, floorY, plan.start.Z)

	play(character, ANIMS.TempestDrag)
	U.bodyTrail(character, WIND, times.Lift)
	if target then
		U.bodyTrail(target, WIND_WHITE, times.Lift)
	end
	gust(plan.start, 6, UP)
	U.ringBurst(CFrame.new(base + UP * 0.2), WIND, 1, 9, 0.4, 0.3)

	local tornado = makeTornado(base, DivePlan.Height + 4)
	local formFrom = times.Flip - 0.25 -- it rises out of the ground as he turns them over
	local standUntil = times.Land + 0.6
	local finishAt = standUntil + 0.4
	local bind = "CloverTempestDive" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	local flipped, dove, risen = false, false, false
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > finishAt then
			finish()
			return
		end
		if t <= times.Length and root.Parent then
			root.CFrame = DivePlan.Attacker(plan, t)
		end
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = DivePlan.Victim(plan, t)
		end
		if not flipped and t >= times.Lift then
			flipped = true
			play(character, ANIMS.BoreasForm)
			local top = plan.start + UP * DivePlan.Height
			U.flash(top, WIND_WHITE, 6, 0.2)
			U.ringBurst(CFrame.new(top), WIND, 1, 8, 0.35, 0.2)
			if mine then
				CameraShake.Add(0.1)
			end
		end
		if not risen and t >= formFrom then
			risen = true
			U.ringBurst(CFrame.new(base + UP * 0.2), WIND_WHITE, 2, 16, 0.4, 0.5)
			U.debris(base, 14, 40, 0.8)
			if mine or (workspace.CurrentCamera.CFrame.Position - base).Magnitude < 70 then
				CameraShake.Add(0.2)
			end
		end
		if not dove and t >= times.Flip then
			dove = true
			play(character, ANIMS.BoreasChop)
			if mine then
				CameraShake.FovKick(10)
			end
		end
		if t >= formFrom then
			local rising = math.clamp((t - formFrom) / 0.3, 0, 1)
			local going = math.clamp((t - standUntil) / 0.4, 0, 1)
			tornado.update(t, rising * (1 - going))
		end
	end)
	task.delay(finishAt + 0.1, function()
		finish()
		tornado.destroy()
	end)

	-- The camera: from the side on the way up, then inside the tornado on the
	-- way down, looking down past him at them, the walls whirling round.
	if mine then
		Cinematic.Camera(function(t)
			local focus = DivePlan.Victim(plan, math.min(t, times.Land)).Position
			local right = plan.forward:Cross(UP)
			if t < times.Flip - 0.05 then
				local offset = right * 18 - plan.forward * 6 + UP * (if t < times.Lift then -2 else 3)
				return CFrame.lookAt(focus + offset, focus), 72
			end
			local eye = focus + UP * 9 + right * 1.5 - plan.forward * 0.5
			return CFrame.lookAt(eye, focus), 88
		end, times.Length + 0.2)
	end
end

function handlers.TempestDive(data, character, root)
	local phase = data.phase
	if phase == "Reach" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, root.CFrame.LookVector)
		end
	elseif phase == "Whiff" then
		gust(root.Position + root.CFrame.LookVector * 4, 2)
	elseif phase == "Begin" then
		playTempestDive(data, character, root)
	elseif phase == "Impact" then
		-- Driven in hard: a dome of wind, a crater ring, the ground split
		-- and thrown up, a column of wind and dust.
		local position: Vector3 = data.position
		U.shockwave(position, WIND, 3, 26, 0.45, Enum.Material.ForceField)
		U.shockwave(position, WIND_WHITE, 2, 12, 0.25)
		U.ringBurst(CFrame.new(position + UP * 0.2), WIND_WHITE, 2, 16, 0.4, 0.45)
		U.ringBurst(CFrame.new(position + UP * 0.3), WIND, 1, 11, 0.5, 0.25)
		U.groundCracks(position, 12, 11, WIND, 1.6)
		U.groundRocks(position, 12, 7, 1.8)
		U.debris(position, 18, 45, 1)
		U.pillar(position, WIND, 3, 22, 0.45, Enum.Material.ForceField, 0.25)
		gust(position + UP, 9, UP)
		U.light(position, WIND, 6, 40, 0.6)
		local near = (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 60
		if near then
			U.colorGrade({ Brightness = 0.2, Contrast = 0.5, Saturation = -0.6 }, 0, 0.06, 0.25)
			CameraShake.Add(0.45)
		end
	end
end

-- Quartile Scutum: four stars at the corners of a rectangle in front of him
-- and beams of light between them, a pane of starlight filling it; it moves
-- with him, ripples where it's struck and fades when it drops.
local barriers: { [Model]: { ripple: (Vector3?) -> (), drop: () -> () } } = {}

function handlers.QuartileScutum(data, character, root)
	if data.phase == "Raise" then
		play(character, ANIMS.Scutum)
		local corners = {
			Vector3.new(-3.6, -2.6, -3.2),
			Vector3.new(3.6, -2.6, -3.2),
			Vector3.new(3.6, 3.2, -3.2),
			Vector3.new(-3.6, 3.2, -3.2),
		}
		local cornerStars = {}
		for _ = 1, 4 do
			table.insert(cornerStars, makeStar(1.4))
		end
		local edges = {}
		for _ = 1, 4 do
			table.insert(edges, bar(Vector3.zero, UP, 0.18, STAR_WHITE, 0.05))
		end
		local pane = U.newPart({
			Size = Vector3.new(7.2, 5.8, 0.1),
			Color = STAR,
			Transparency = 0.82,
			Material = Enum.Material.ForceField,
		})
		local done = false
		local function drop()
			done = true
			barriers[character] = nil
			for _, star in cornerStars do
				star.fade(0.25)
			end
			fadeOut(edges, 0.25)
			fadeOut({ pane }, 0.25)
		end
		barriers[character] = {
			ripple = function(from: Vector3?)
				U.impactRing(pane.Position, pane.CFrame.LookVector, STAR_WHITE, 0.5, 4, 0.3)
				U.flash(pane.Position, STAR, 5, 0.15)
				if from then
					U.burst(pane.Position, {
						color = STAR,
						count = 10,
						size = 0.3,
						speed = NumberRange.new(10, 25),
						lifetime = NumberRange.new(0.15, 0.3),
						streaks = true,
						spread = 50,
						direction = (from - pane.Position).Unit,
					})
				end
			end,
			drop = drop,
		}
		every(data.duration + 0.5, function(elapsed)
			if done or not root.Parent then
				return false
			end
			local frame = root.CFrame
			local world = {}
			for i, corner in corners do
				world[i] = frame:PointToWorldSpace(corner)
				cornerStars[i].place(world[i], elapsed * 2 + i)
			end
			for i, edge in edges do
				local a, b = world[i], world[i % 4 + 1]
				local grow = math.min(elapsed / 0.15, 1)
				local tip = a:Lerp(b, grow)
				edge.Size = Vector3.new(0.18, 0.18, (tip - a).Magnitude + 0.05)
				edge.CFrame = CFrame.lookAt(a:Lerp(tip, 0.5), tip)
			end
			pane.CFrame = frame * CFrame.new(0, 0.3, -3.2)
			return true
		end, function()
			if not done then
				drop()
			end
		end)
	elseif data.phase == "Block" then
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(data.from)
		end
	elseif data.phase == "Drop" then
		local barrier = barriers[character]
		if barrier then
			barrier.drop()
		end
	elseif data.phase == "Reflect" then
		-- What it stopped goes back, twice as hard.
		local origin: Vector3 = data.origin
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(nil)
		end
		U.flash(origin, STAR_WHITE, 6, 0.2)
		if data.direction then
			-- A bolt of starlight back at whoever cast it.
			local direction: Vector3 = data.direction
			local star = makeStar(2.2)
			local position = origin
			local travelled = 0
			every(data.range / data.speed + 0.1, function(elapsed, dt)
				local step = data.speed * dt
				position += direction * step
				travelled += step
				star.place(position, elapsed * 12)
				local streak = bar(position, position - direction * 3.5, 0.35, STAR, 0.25)
				U.tween(streak, 0.2, { Transparency = 1, Size = Vector3.new(0.05, 0.05, 3.5) })
				task.delay(0.21, streak.Destroy, streak)
				return travelled < data.range
			end, function()
				star.fade(0.15)
				U.burst(position, {
					color = STAR,
					count = 12,
					size = 0.4,
					speed = NumberRange.new(14, 30),
					lifetime = NumberRange.new(0.15, 0.3),
					spread = 180,
				})
			end)
		else
			-- Straight back into them.
			local target: Vector3 = data.target
			local ray = bar(origin, target, 0.4, STAR_WHITE, 0)
			local glow = bar(origin, target, 1.4, STAR, 0.5)
			fadeOut({ ray, glow }, 0.2)
			U.shockwave(target, STAR, 1, 8, 0.25)
			U.burst(target, {
				color = STAR,
				count = 16,
				size = 0.45,
				speed = NumberRange.new(18, 36),
				lifetime = NumberRange.new(0.15, 0.3),
				streaks = true,
				spread = 180,
			})
		end
		if involves(data, character) then
			CameraShake.Add(0.15)
		end
	end
end

-- Quartile Hasta. Four stars open round his outstretched hand: a gold ring
-- and a counter-turning outer ring, the stars at the corners of a square of
-- light with a cross between them, starlight drawn in (in the air the sigil
-- opens bigger, face-down under his feet). Then:
--   tapped      the stars loose star bolts one after another, comets of
--               starlight that burst into stars where they strike;
--   held        their light pours into one lance he keeps on them (a
--               white-hot core, a gold glow, a shimmering sheath, four
--               strands of starlight twisting round it, rings bursting off
--               along it, a star flaring where it strikes), ending in a
--               blast;
--   in the air  a circle of gold opens on the ground below and star-fire
--               rains into it, each bolt bursting into flames where it lands.
local HASTA_STRANDS = 4
local HASTA_SEGMENTS = 14
local STAR_FIRE = Color3.fromRGB(255, 140, 40)
type Sigil = { stars: { Star }, center: Vector3, aim: Vector3? }
type Lance = { set: (Vector3, Vector3, number) -> (), stop: () -> () }
local hastaSigils: { [Model]: Sigil } = {}
local hastaLances: { [Model]: Lance } = {}

local function stopLance(character: Model)
	local lance = hastaLances[character]
	if lance then
		hastaLances[character] = nil
		lance.stop()
	end
end

-- A cross of light flaring across `direction` at `position`.
local function crossGlint(position: Vector3, direction: Vector3, size: number)
	local right = direction:Cross(UP)
	right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
	for _, axis in { right, right:Cross(direction).Unit } do
		local line = bar(position - axis * size, position + axis * size, 0.22, STAR_WHITE, 0)
		U.tween(line, 0.35, { Size = Vector3.new(0.02, 0.02, size * 2.8), Transparency = 1 })
		task.delay(0.36, line.Destroy, line)
	end
end

-- The sigil, held until the cast ends.
local function openSigil(character: Model, root: BasePart, down: boolean)
	local token = bump(character)
	stopLance(character)
	local size = if down then 1.5 else 1
	local stars: { Star } = {}
	for _ = 1, 4 do
		table.insert(stars, makeStar(1.3 * size))
	end
	local inner = arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 16), 0.12, STAR, 0.1)
	local outer = arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 20), 0.08, STAR_WHITE, 0.3)
	local square, cross = {}, {}
	for _ = 1, 4 do
		table.insert(square, bar(Vector3.zero, UP, 0.12, STAR_WHITE, 0.05))
	end
	for _ = 1, 2 do
		table.insert(cross, bar(Vector3.zero, UP, 0.06, STAR, 0.4))
	end
	local core = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.5, Color = STAR, Transparency = 0.45 })
	local light = Instance.new("PointLight")
	light.Color = STAR
	light.Range = 12 * size
	light.Parent = core
	local parts = table.clone(inner)
	for _, list in { outer, square, cross } do
		table.move(list, 1, #list, #parts + 1, parts)
	end
	table.insert(parts, core)
	local sigil: Sigil = { stars = stars, center = root.Position }
	hastaSigils[character] = sigil
	every(3.5, function(elapsed)
		local hand = handOf(character, "Right")
		if not live(character, token) or not hand or not root.Parent then
			return false
		end
		local center, frame
		if down then
			center = root.Position - UP * 3.4
			frame = CFrame.lookAt(center, center - UP, root.CFrame.LookVector)
		else
			local forward = sigil.aim or root.CFrame.LookVector
			center = hand + forward * 1.2
			frame = CFrame.lookAt(center, center + forward)
		end
		sigil.center = center
		local grow = math.min(elapsed / 0.2, 1)
		local radius = 2.2 * size * grow + 0.05
		-- It spins up while the lance pours out of it.
		local spin = elapsed * (if sigil.aim then 6 else 2.5)
		poseArc(inner, arcPoints(center, frame.RightVector, frame.UpVector, radius, spin, spin + math.pi * 2, 16))
		poseArc(
			outer,
			arcPoints(
				center,
				frame.RightVector,
				frame.UpVector,
				radius * 1.36,
				-spin * 0.7,
				-spin * 0.7 + math.pi * 2,
				20
			)
		)
		local corners = {}
		for i = 1, 4 do
			local angle = (i - 1) * math.pi / 2 + spin
			corners[i] = center + (frame.RightVector * math.cos(angle) + frame.UpVector * math.sin(angle)) * radius
			stars[i].place(corners[i], elapsed * 4 + i)
		end
		for i, edge in square do
			stretch(edge, corners[i], corners[i % 4 + 1])
		end
		stretch(cross[1], corners[1], corners[3])
		stretch(cross[2], corners[2], corners[4])
		core.Size = Vector3.one * (0.5 + 1.5 * size * grow * (1 + 0.15 * math.sin(elapsed * 30)))
		core.CFrame = CFrame.new(center)
		light.Brightness = 1 + 4 * math.min(elapsed / 0.4, 1)
		inflow(center, 5 * size, STAR)
		return true
	end, function()
		if hastaSigils[character] == sigil then
			hastaSigils[character] = nil
		end
		for _, star in stars do
			star.fade(0.2)
		end
		fadeOut(parts, 0.2)
	end)
end

-- Where a star bolt strikes: it bursts into a star.
local function starBurst(position: Vector3, direction: Vector3, scale: number)
	local star = makeStar(2.4 * scale)
	star.place(position, math.random() * 6)
	task.delay(0.06, star.fade, 0.22)
	U.impactRing(position, direction, STAR_WHITE, 0.5, 3.5 * scale, 0.22)
	U.burst(position, {
		color = STAR,
		count = math.floor(10 * scale),
		size = 0.4,
		speed = NumberRange.new(16, 36),
		lifetime = NumberRange.new(0.15, 0.32),
		streaks = true,
		spread = 70,
		direction = -direction,
	})
	U.light(position, STAR, 4, 14 * scale, 0.25)
end

-- A star bolt: a comet of starlight, a star for a head, a white-hot streak
-- and a tail burning from gold to orange.
local function starBolt(origin: Vector3, direction: Vector3, speed: number, range: number, scale: number)
	local head = makeStar(1.1 * scale)
	local streak = bar(origin, origin + direction, 0.24 * scale, STAR_WHITE, 0)
	local glow = bar(origin, origin + direction, 0.9 * scale, STAR, 0.55)
	local tail0 = Instance.new("Attachment")
	tail0.Position = Vector3.new(0.4 * scale, 0, 0)
	tail0.Parent = streak
	local tail1 = Instance.new("Attachment")
	tail1.Position = Vector3.new(-0.4 * scale, 0, 0)
	tail1.Parent = streak
	local trail = Instance.new("Trail")
	trail.Attachment0 = tail0
	trail.Attachment1 = tail1
	trail.Color = ColorSequence.new(STAR_WHITE, STAR_FIRE)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Lifetime = 0.15
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Parent = streak
	local length = 3 * scale
	fly(origin, direction, speed, range, function(position, elapsed)
		head.place(position, elapsed * 12)
		stretch(streak, position - direction * length, position)
		stretch(glow, position - direction * length * 1.5, position)
	end, function(position)
		starBurst(position, direction, scale)
	end, function()
		trail.Enabled = false
		head.fade(0.1)
		fadeOut({ streak, glow }, 0.12)
	end)
end

-- Star-fire: a bolt of burning starlight falls onto `spot` and bursts into
-- flames there.
local function starFire(from: Vector3, spot: Vector3)
	local fall = 0.18
	local head = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, Color = STAR_WHITE })
	local glow =
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2.2, Color = STAR_FIRE, Transparency = 0.45 })
	local streak = bar(from, from + UP, 0.35, STAR_WHITE, 0.1)
	local flare = bar(from, from + UP, 1.1, STAR_FIRE, 0.5)
	every(fall, function(elapsed)
		local a = elapsed / fall
		local position = from:Lerp(spot, a * a)
		head.CFrame = CFrame.new(position)
		glow.CFrame = CFrame.new(position)
		stretch(streak, from:Lerp(position, 0.5), position)
		stretch(flare, from:Lerp(position, 0.3), position)
		return true
	end, function()
		fadeOut({ head, glow, streak, flare }, 0.06)
		local holder = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(spot + UP * 0.6) })
		local fire = Instance.new("Fire")
		fire.Color = STAR
		fire.SecondaryColor = STAR_FIRE
		fire.Size = 4
		fire.Heat = 9
		fire.Parent = holder
		task.delay(1.1, function()
			fire.Enabled = false
		end)
		task.delay(2.6, holder.Destroy, holder)
		U.flash(spot + UP * 0.5, STAR_WHITE, 5, 0.18)
		U.burst(spot + UP * 0.3, {
			color = STAR_FIRE,
			count = 14,
			size = 0.45,
			speed = NumberRange.new(14, 34),
			lifetime = NumberRange.new(0.2, 0.5),
			spread = 50,
			direction = UP,
			acceleration = Vector3.new(0, 10, 0),
		})
		U.ringBurst(CFrame.new(spot + UP * 0.12), STAR, 0.5, 4, 0.3, 0.15)
		U.groundCracks(spot, 4, 2.6, STAR_FIRE, 1.2)
		U.light(spot + UP, STAR_FIRE, 5, 14, 0.5)
		if (workspace.CurrentCamera.CFrame.Position - spot).Magnitude < 30 then
			CameraShake.Add(0.03)
		end
	end)
end

-- The held lance, poured out of the sigil; `set` (each server tick) moves
-- where it strikes, smoothed here.
local function startLance(character: Model, root: BasePart): Lance
	local token = castTokens[character] or 0
	local at = root.Position
	local core = tube(at, at + UP, 1.6, STAR_WHITE, 0)
	local glow = tube(at, at + UP, 4.5, STAR, 0.55)
	local sheath = tube(at, at + UP, 7.5, STAR, 0)
	sheath.Material = Enum.Material.ForceField
	local mouth = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, Color = STAR_WHITE, Transparency = 0.2 })
	local light = Instance.new("PointLight")
	light.Color = STAR
	light.Range = 30
	light.Brightness = 5
	light.Parent = core
	local tip = makeStar(3.2)
	local rays: { BasePart } = {}
	for _ = 1, 4 do
		table.insert(rays, bar(at, at + UP, 0.18, STAR_WHITE, 0.15))
	end
	local strands: { { BasePart } } = {}
	for k = 1, HASTA_STRANDS do
		local strand = {}
		for _ = 1, HASTA_SEGMENTS do
			table.insert(
				strand,
				bar(at, at + UP, if k % 2 == 1 then 0.24 else 0.16, if k % 2 == 1 then STAR_WHITE else STAR, 0.1)
			)
		end
		table.insert(strands, strand)
	end
	local origin, target = at, at + root.CFrame.LookVector * 10
	local finish: Vector3? = nil
	local lastSet = os.clock()
	local stopped = false
	local nextRing, nextSpark = 0, 0
	local lance = {}
	function lance.set(newOrigin: Vector3, direction: Vector3, length: number)
		origin = newOrigin
		target = newOrigin + direction * length
		lastSet = os.clock()
	end
	function lance.stop()
		stopped = true
	end
	every(4, function(elapsed, dt)
		if stopped or not live(character, token) or os.clock() - lastSet > 0.5 or not root.Parent then
			return false
		end
		local sigil = hastaSigils[character]
		local start = if sigil then sigil.center else origin
		local now = if finish then finish:Lerp(target, 1 - math.exp(-dt * 14)) else target
		finish = now
		local along = now - start
		local length = along.Magnitude
		if length < 1 then
			return true
		end
		local direction = along.Unit
		if sigil then
			sigil.aim = direction
		end
		local right = direction:Cross(UP)
		right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
		local up = right:Cross(direction).Unit
		local grow = math.min(elapsed / 0.12, 1)
		local pulse = grow * (1 + 0.12 * math.sin(elapsed * 40))
		local middle = CFrame.lookAt(start:Lerp(now, 0.5), now) * CFrame.Angles(0, rad(90), 0)
		core.Size = Vector3.new(length, 1.6 * pulse, 1.6 * pulse)
		core.CFrame = middle
		glow.Size = Vector3.new(length, 4.5 * grow, 4.5 * grow)
		glow.CFrame = middle
		sheath.Size = Vector3.new(length, 7.5 * pulse, 7.5 * pulse)
		sheath.CFrame = middle * CFrame.Angles(elapsed * 10, 0, 0)
		mouth.Size = Vector3.one * 3.4 * pulse
		mouth.CFrame = CFrame.new(start)
		tip.place(now, elapsed * 5)
		local spin = elapsed * 16
		for k, strand in strands do
			local phase = k * (math.pi * 2 / HASTA_STRANDS) + spin
			local previous = start
			for i, segment in strand do
				local s = i / #strand * length
				local angle = phase + s * 0.3
				local point = start
					+ direction * s
					+ (right * math.cos(angle) + up * math.sin(angle)) * 3 * math.min(s / 4, 1)
				stretch(segment, previous, point)
				previous = point
			end
		end
		-- The stars pour their light into it.
		for i, ray in rays do
			local star = sigil and sigil.stars[i]
			if star then
				stretch(ray, star.parts[1].Position, start)
			end
		end
		if elapsed >= nextRing then
			nextRing = elapsed + 0.05
			U.impactRing(start + direction * (math.random() * length), direction, STAR_WHITE, 2, 5.5, 0.2)
		end
		if elapsed >= nextSpark then
			nextSpark = elapsed + 0.08
			U.burst(now, {
				color = STAR,
				count = 6,
				size = 0.45,
				speed = NumberRange.new(18, 40),
				lifetime = NumberRange.new(0.12, 0.3),
				streaks = true,
				spread = 75,
				direction = -direction,
			})
			U.impactRing(now, direction, STAR, 1, 4.5, 0.18)
		end
		return true
	end, function()
		stopped = true
		if hastaLances[character] == lance then
			hastaLances[character] = nil
		end
		light.Enabled = false
		tip.fade(0.2)
		U.tween(core, 0.25, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
		U.tween(glow, 0.25, { Size = Vector3.new(glow.Size.X, 0.4, 0.4) })
		fadeOut({ core, glow, sheath, mouth }, 0.28)
		fadeOut(rays, 0.15)
		for _, strand in strands do
			fadeOut(strand, 0.2)
		end
	end)
	return lance
end

function handlers.QuartileHasta(data, character, root)
	local phase = data.phase
	if phase == "Stars" then
		play(character, if data.airborne then ANIMS.HastaRain else ANIMS.HastaStars)
		openSigil(character, root, data.airborne == true)
		if U.isLocal(character) then
			CameraShake.Add(0.05)
		end
	elseif phase == "Bolt" then
		-- Loosed from one of the stars, bent to meet the server's line 20
		-- studs out.
		local sigil = hastaSigils[character]
		local star = sigil and sigil.stars[data.index]
		local muzzle = root.Position + root.CFrame.LookVector * 3 + UP * 0.8
		local from = if star then star.parts[1].Position else muzzle
		local direction = (muzzle + data.direction * 20 - from).Unit
		local scale = if data.last then 1.5 else 1
		U.flash(from, STAR_WHITE, 3 * scale, 0.12)
		U.impactRing(from, direction, STAR, 0.4, 2.2 * scale, 0.16)
		starBolt(from, direction, data.speed, data.range, scale)
		if U.isLocal(character) then
			CameraShake.FovKick(if data.last then 5 else 1.5)
		end
	elseif phase == "Beam" then
		local lance = hastaLances[character]
		if not lance then
			play(character, ANIMS.HastaBeam)
			lance = startLance(character, root)
			hastaLances[character] = lance
			local sigil = hastaSigils[character]
			local at: Vector3 = if sigil then sigil.center else data.origin
			U.flash(at, STAR_WHITE, 9, 0.2)
			crossGlint(at, data.direction, 6)
			U.light(at, STAR, 6, 30, 0.4)
			if U.isLocal(character) then
				CameraShake.Add(0.12)
				CameraShake.FovKick(6)
			end
		end
		lance.set(data.origin, data.direction, data.length)
		if U.isLocal(character) then
			CameraShake.Add(0.03)
		end
	elseif phase == "BeamEnd" then
		-- One last blast along it: a thick white lance thinning away, rings
		-- bursting off along it and a great star where it ends.
		stopLance(character)
		local sigil = hastaSigils[character]
		local start: Vector3 = if sigil then sigil.center else data.origin
		local finish: Vector3 = data.origin + data.direction * data.length
		local along = finish - start
		local direction: Vector3 = if along.Magnitude > 1e-3 then along.Unit else data.direction
		local length = along.Magnitude
		local core = tube(start, finish, 3.4, STAR_WHITE, 0)
		local glow = tube(start, finish, 9, STAR, 0.5)
		local sheath = tube(start, finish, 12, STAR, 0)
		sheath.Material = Enum.Material.ForceField
		U.tween(core, 0.35, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
		U.tween(glow, 0.35, { Size = Vector3.new(glow.Size.X, 0.5, 0.5) })
		U.tween(sheath, 0.3, { Size = Vector3.new(sheath.Size.X, 16, 16) })
		fadeOut({ core, glow, sheath }, 0.38)
		for i = 0, 10 do
			task.delay(
				i * 0.015,
				U.impactRing,
				start + direction * (length * i / 10),
				direction,
				STAR_WHITE,
				2.5,
				8,
				0.25
			)
		end
		for _ = 1, 8 do
			local twinkle = makeStar(0.9 + math.random() * 1.2)
			twinkle.place(start + direction * (math.random() * length) + U.randomUnit() * 2, math.random() * 6)
			task.delay(0.15 + math.random() * 0.3, twinkle.fade, 0.3)
		end
		crossGlint(start, direction, 8)
		U.flash(start, STAR_WHITE, 12, 0.25)
		local burst = makeStar(5.5)
		burst.place(finish, 0)
		task.delay(0.12, burst.fade, 0.4)
		U.shockwave(finish, STAR, 2, 14, 0.4)
		U.burst(finish, {
			color = STAR,
			count = 24,
			size = 0.5,
			speed = NumberRange.new(20, 50),
			lifetime = NumberRange.new(0.2, 0.45),
			streaks = true,
			spread = 180,
		})
		U.light(start, STAR, 7, 34, 0.45)
		if U.isLocal(character) then
			CameraShake.FovKick(10)
			U.colorGrade({ Brightness = 0.12, Saturation = 0.15 }, 0, 0.05, 0.3)
		end
	elseif phase == "Rain" then
		-- A turning circle of gold on the ground below, stars on its rim.
		local center: Vector3 = data.center
		local radius: number = data.radius
		local token = castTokens[character] or 0
		local ground = center + UP * 0.15
		local rim =
			arcParts(arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 24), 0.25, STAR, 0.05)
		local inner = arcParts(
			arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 18),
			0.12,
			STAR_WHITE,
			0.3
		)
		local stars: { Star } = {}
		for _ = 1, 4 do
			table.insert(stars, makeStar(1.8))
		end
		local all = table.clone(rim)
		table.move(inner, 1, #inner, #all + 1, all)
		U.ringBurst(CFrame.new(ground), STAR_WHITE, 0.5, radius, 0.35, 0.3)
		U.light(center + UP * 3, STAR_FIRE, 4, radius * 2.5, data.duration + 0.8)
		every(data.duration + 1, function(elapsed)
			if not live(character, token) then
				return false
			end
			local grow = math.min(elapsed / 0.25, 1)
			local spin = elapsed * 1.2
			poseArc(
				rim,
				arcPoints(ground, Vector3.xAxis, Vector3.zAxis, radius * grow + 0.05, spin, spin + math.pi * 2, 24)
			)
			poseArc(
				inner,
				arcPoints(
					ground,
					Vector3.xAxis,
					Vector3.zAxis,
					radius * 0.7 * grow + 0.05,
					-spin * 1.5,
					-spin * 1.5 + math.pi * 2,
					18
				)
			)
			for i, star in stars do
				local angle = (i - 1) * math.pi / 2 + spin
				star.place(
					ground + Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * grow + UP * 0.8,
					elapsed * 3 + i
				)
			end
			return true
		end, function()
			for _, star in stars do
				star.fade(0.3)
			end
			fadeOut(all, 0.3)
		end)
	elseif phase == "Fall" then
		-- Out of the sigil under his feet.
		local sigil = hastaSigils[character]
		local from: Vector3 = data.from
		if sigil then
			local offset = from - root.Position
			from = sigil.center + Vector3.new(offset.X, 0, offset.Z)
			U.flash(from, STAR_WHITE, 2, 0.1)
		end
		starFire(from, data.spot)
	elseif phase == "Done" or phase == "Cancel" then
		bump(character)
		stopLance(character)
		local current = PoseAnimator.Current(character)
		if current == ANIMS.HastaBeam or current == ANIMS.HastaStars then
			PoseAnimator.FadeOut(character, 0.2)
		end
	end
end

