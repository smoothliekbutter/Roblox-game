-- Half-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Spirit Storm: an orb of mana gathers in his palm, then a dense beam of
-- swirling wind (a white core inside a green column, rings of wind
-- spinning out along it) roars out.
function handlers.SpiritStorm(data, character, root)
	if data.phase == "Charge" then
		play(character, ANIMS.StormCharge)
		local token = bump(character)
		local orb = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Color = WIND_WHITE })
		local halo =
			U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.4, Color = WIND, Transparency = 0.5 })
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Right")
			if not live(character, token) or not hand then
				return false
			end
			local grow = elapsed / data.duration
			orb.Size = Vector3.one * (0.3 + 1.1 * grow)
			halo.Size = Vector3.one * (0.8 + 2.4 * grow)
			orb.CFrame = CFrame.new(hand + root.CFrame.LookVector * 0.6)
			halo.CFrame = orb.CFrame
			inflow(orb.Position, 5)
			return true
		end, function()
			fadeOut({ orb, halo }, 0.08)
		end)
	elseif data.phase == "Fire" then
		play(character, ANIMS.StormFire)
		local token = bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local finish = origin + direction * data.length
		local core = tube(origin, finish, 1.4, WIND_WHITE, 0.05)
		local column = tube(origin, finish, 4.4, WIND, 0.55)
		local sheath = tube(origin, finish, 6, WIND_DEEP, 0.85)
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 24
		light.Brightness = 4
		light.Parent = core
		local nextRing = 0
		every(data.duration, function(elapsed)
			if not live(character, token) then
				return false
			end
			if elapsed >= nextRing then
				nextRing = elapsed + 0.05
				local along = math.random() * data.length
				U.impactRing(origin + direction * along, direction, WIND_WHITE, 1.5, 4.5, 0.18)
			end
			local wobble = 1 + math.sin(elapsed * 40) * 0.08
			column.Size = Vector3.new(column.Size.X, 4.4 * wobble, 4.4 * wobble)
			return true
		end, function()
			fadeOut({ core, column, sheath }, 0.2)
			gust(finish, 6, direction)
		end)
		gust(origin, 5, direction)
		U.light(origin, WIND, 5, 20, 0.6)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(8)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- Spirit's Hushed Dance: wind streams circle him while he reads the mana;
-- on an attack he flows along a ribbon of wind to behind them and strikes.
function handlers.HushedDance(data, character, root)
	if data.phase == "Stance" then
		play(character, ANIMS.Dance)
		U.spiral(root, WIND, 3, 5, data.window, 3, 0.08, 0.2)
		U.highlight(character, WIND, data.window, 0.85)
	elseif data.phase == "Evade" then
		local from: Vector3 = data.from
		local to: Vector3 = data.to
		local side = (to - from):Cross(UP)
		side = if side.Magnitude > 0.01 then side.Unit * 3 else Vector3.zero
		-- A curving ribbon of wind along the way he went.
		local previous = from
		for i = 1, 10 do
			local t = i / 10
			local point = from:Lerp(to, t) + side * math.sin(t * math.pi)
			local piece = bar(previous, point, 0.35, WIND, 0.3)
			task.delay(0.02 * i, function()
				U.tween(piece, 0.3, { Transparency = 1, Size = Vector3.new(0.05, 0.05, piece.Size.Z) })
				task.delay(0.32, piece.Destroy, piece)
			end)
			previous = point
		end
		U.flash(from, WIND_WHITE, 4, 0.2)
		gust(to, 4)
		if data.target then
			play(character, ANIMS.DanceStrike)
			task.delay(0.12, function()
				local targetRoot = U.getRoot(data.target)
				if targetRoot then
					gust(targetRoot.Position, 6, UP)
					U.shockwave(targetRoot.Position, WIND, 1.5, 8, 0.25)
				end
			end)
		end
		if involves(data, character) then
			CameraShake.FovKick(-8)
		end
	end
end

-- Quartile Scutum: four stars at the corners of a rectangle in front of him
-- and beams of light between them, a pane of starlight filling it; it moves
-- with him, ripples where it's struck and fades when it drops.
local barriers: { [Model]: { ripple: (Vector3?) -> (), drop: () -> () } } = {}

function handlers.QuartileScutum(data, character, root)
	if data.phase == "Raise" then
		play(character, ANIMS.Scutum)
		local corners = {
			Vector3.new(-3.6, -2.6, -3.2),
			Vector3.new(3.6, -2.6, -3.2),
			Vector3.new(3.6, 3.2, -3.2),
			Vector3.new(-3.6, 3.2, -3.2),
		}
		local cornerStars = {}
		for _ = 1, 4 do
			table.insert(cornerStars, makeStar(1.4))
		end
		local edges = {}
		for _ = 1, 4 do
			table.insert(edges, bar(Vector3.zero, UP, 0.18, STAR_WHITE, 0.05))
		end
		local pane = U.newPart({
			Size = Vector3.new(7.2, 5.8, 0.1),
			Color = STAR,
			Transparency = 0.82,
			Material = Enum.Material.ForceField,
		})
		local done = false
		local function drop()
			done = true
			barriers[character] = nil
			for _, star in cornerStars do
				star.fade(0.25)
			end
			fadeOut(edges, 0.25)
			fadeOut({ pane }, 0.25)
		end
		barriers[character] = {
			ripple = function(from: Vector3?)
				U.impactRing(pane.Position, pane.CFrame.LookVector, STAR_WHITE, 0.5, 4, 0.3)
				U.flash(pane.Position, STAR, 5, 0.15)
				if from then
					U.burst(pane.Position, {
						color = STAR,
						count = 10,
						size = 0.3,
						speed = NumberRange.new(10, 25),
						lifetime = NumberRange.new(0.15, 0.3),
						streaks = true,
						spread = 50,
						direction = (from - pane.Position).Unit,
					})
				end
			end,
			drop = drop,
		}
		every(data.duration + 0.5, function(elapsed)
			if done or not root.Parent then
				return false
			end
			local frame = root.CFrame
			local world = {}
			for i, corner in corners do
				world[i] = frame:PointToWorldSpace(corner)
				cornerStars[i].place(world[i], elapsed * 2 + i)
			end
			for i, edge in edges do
				local a, b = world[i], world[i % 4 + 1]
				local grow = math.min(elapsed / 0.15, 1)
				local tip = a:Lerp(b, grow)
				edge.Size = Vector3.new(0.18, 0.18, (tip - a).Magnitude + 0.05)
				edge.CFrame = CFrame.lookAt(a:Lerp(tip, 0.5), tip)
			end
			pane.CFrame = frame * CFrame.new(0, 0.3, -3.2)
			return true
		end, function()
			if not done then
				drop()
			end
		end)
	elseif data.phase == "Block" then
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(data.from)
		end
	elseif data.phase == "Drop" then
		local barrier = barriers[character]
		if barrier then
			barrier.drop()
		end
	end
end

-- Quartile Hasta: four stars turn round his outstretched hand, growing;
-- their beams converge ahead of him into one great lance of starlight.
local hastaStars: { [Model]: { Star } } = {}

function handlers.QuartileHasta(data, character, root)
	if data.phase == "Stars" then
		play(character, ANIMS.HastaStars)
		local token = bump(character)
		local set = {}
		for _ = 1, 4 do
			table.insert(set, makeStar(1.2))
		end
		hastaStars[character] = set
		every(data.duration + 0.1, function(elapsed)
			local hand = handOf(character, "Right")
			if not live(character, token) or not hand then
				return false
			end
			local grow = math.min(elapsed / 0.2, 1)
			local frame = CFrame.lookAt(hand, hand + root.CFrame.LookVector) * CFrame.Angles(0, 0, elapsed * 3)
			for i, star in set do
				local angle = (i - 1) * math.pi / 2
				star.place(frame * Vector3.new(math.cos(angle), math.sin(angle), -0.8) * 1.8 * grow, elapsed * 4)
			end
			return true
		end, function()
			if hastaStars[character] == set then
				hastaStars[character] = nil
			end
			for _, star in set do
				star.fade(0.15)
			end
		end)
	elseif data.phase == "Fire" then
		play(character, ANIMS.HastaFire)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local finish = origin + direction * data.length
		local meet = origin + direction * 3
		local set = hastaStars[character]
		if set then
			for _, star in set do
				local from = star.parts[1].Position
				local ray = bar(from, meet, 0.25, STAR_WHITE, 0.05)
				fadeOut({ ray }, 0.2)
			end
		end
		bump(character)
		local core = tube(meet, finish, 1.6, STAR_WHITE, 0)
		local glow = tube(meet, finish, 5.5, STAR, 0.6)
		local sheath = tube(meet, finish, 8, STAR, 0.88)
		U.tween(core, 0.4, { Size = Vector3.new(core.Size.X, 0.1, 0.1) })
		U.tween(glow, 0.4, { Size = Vector3.new(glow.Size.X, 0.6, 0.6) })
		fadeOut({ core, glow, sheath }, 0.4)
		U.flash(meet, STAR_WHITE, 10, 0.25)
		U.flash(finish, STAR, 8, 0.25)
		U.impactRing(meet, direction, STAR_WHITE, 1, 8, 0.3)
		U.light(meet, STAR, 6, 30, 0.4)
		U.burst(finish, {
			color = STAR,
			count = 20,
			size = 0.5,
			speed = NumberRange.new(20, 45),
			lifetime = NumberRange.new(0.2, 0.45),
			spread = 180,
		})
		if U.isLocal(character) then
			CameraShake.Add(0.25)
			CameraShake.FovKick(10)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

---------------------------------------------------------------------------
-- Full-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Looks (built further down); moves can hide his wind sword for a moment
-- (the halberd, the bow).
local looks: { [Model]: { hideSword: number } } = {}

local function hideSword(character: Model, duration: number)
	local look = looks[character]
	if look then
		look.hideSword = os.clock() + duration
	end
end

-- Spirit of Notos: the south wind bursts out of him (a sphere of wind and a
-- ring along the ground); spells blown back go as a whirling disc of wind.
function handlers.SpiritOfNotos(data, character, root)
	if data.phase == "Blast" then
		play(character, ANIMS.Notos)
		task.delay(0.1, function()
			if not root.Parent then
				return
			end
			local position = root.Position
			U.shockwave(position, WIND, 4, 34, 0.5, Enum.Material.ForceField)
			U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, 18, 0.4, 0.3)
			U.burst(position, {
				color = WIND_WHITE,
				count = 36,
				size = 0.5,
				speed = NumberRange.new(60, 100),
				lifetime = NumberRange.new(0.2, 0.4),
				streaks = true,
				spread = 180,
			})
			U.light(position, WIND, 5, 30, 0.4)
			if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 30 then
				CameraShake.Add(0.2)
			end
		end)
	elseif data.phase == "Gust" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local disc = U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 6, 6),
			Color = WIND,
			Transparency = 0.4,
		})
		local position = origin
		every(0.75, function(elapsed, dt)
			position += direction * 120 * dt
			disc.CFrame = CFrame.lookAt(position, position + direction)
				* CFrame.Angles(0, rad(90), 0)
				* CFrame.Angles(elapsed * 20, 0, 0)
			return true
		end, function()
			fadeOut({ disc }, 0.1)
		end)
		gust(origin, 5, direction)
	end
end

-- Spirit of Boreas: the wind sword condenses into a halberd (a long shaft,
-- an axe head and a spike), raised as he closes in and brought down; the
-- impact throws up a ring of wind and splits the ground.
function handlers.SpiritOfBoreas(data, character, root)
	if data.phase == "Form" then
		play(character, ANIMS.BoreasForm)
		hideSword(character, 0.95)
		local shaft = U.newPart({ Size = Vector3.new(0.22, 7.5, 0.22), Color = WIND_DEEP })
		local axe = U.newPart({ Size = Vector3.new(0.14, 1.9, 1.6), Color = WIND, Transparency = 0.15 })
		local edge = U.newPart({ Size = Vector3.new(0.08, 2.1, 0.2), Color = WIND_WHITE })
		local spike = U.newPart({ Size = Vector3.new(0.12, 1.4, 0.12), Color = WIND_WHITE })
		local parts = { shaft, axe, edge, spike }
		every(0.95, function()
			local arm = character:FindFirstChild("Right Arm")
			if not arm or not arm:IsA("BasePart") then
				return false
			end
			local grip = arm.CFrame * CFrame.new(0, -1.1, 0) * CFrame.Angles(rad(-90), 0, 0)
			shaft.CFrame = grip * CFrame.new(0, 2.4, 0)
			axe.CFrame = grip * CFrame.new(0, 5.2, -0.8)
			edge.CFrame = grip * CFrame.new(0, 5.2, -1.6)
			spike.CFrame = grip * CFrame.new(0, 6.6, 0)
			return true
		end, function()
			fadeOut(parts, 0.15)
		end)
		U.flash(root.Position, WIND, 5, 0.2)
		U.speedLines(root, root.CFrame.LookVector, 0.3, WIND)
	elseif data.phase == "Chop" then
		play(character, ANIMS.BoreasChop)
		U.bodyTrail(character, WIND, 0.25)
	elseif data.phase == "Impact" then
		local position: Vector3 = data.position
		U.shockwave(position, WIND, 2, 24, 0.4)
		U.ringBurst(CFrame.new(position + UP * 0.2), WIND_WHITE, 1, 13, 0.4, 0.35)
		U.groundCracks(position, 9, 9, WIND, 1.2)
		U.groundRocks(position, 8, 6, 1.3)
		U.debris(position, 12, 35, 0.8)
		gust(position + UP, 8, UP)
		if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 40 then
			CameraShake.Add(0.3)
		end
	end
end

-- Spirit of Euros: a recurve bow of wind (curled tips) and an arrow that
-- the wind spirals into as he draws; loosed, a white line is all there is,
-- then the air along it rings.
function handlers.SpiritOfEuros(data, character, root)
	if data.phase == "Draw" then
		play(character, ANIMS.EurosDraw)
		local token = bump(character)
		hideSword(character, data.duration + 0.4)
		local segments = 12
		local limbs = arcParts(table.create(segments + 1, Vector3.zero), 0.24, WIND, 0.15)
		local arrow = bar(Vector3.zero, UP, 0.16, WIND_WHITE, 0)
		local arrowGlow = bar(Vector3.zero, UP, 0.6, WIND, 0.5)
		local all = table.clone(limbs)
		table.insert(all, arrow)
		table.insert(all, arrowGlow)
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Left")
			local pull = handOf(character, "Right")
			if not live(character, token) or not hand or not pull then
				return false
			end
			local forward = root.CFrame.LookVector
			local center = hand - forward * 1.3
			-- Recurve: the tips curl forward again.
			local points = arcPoints(center, forward, UP, 3.6, -1.2, 1.2, segments)
			points[1] += forward * 0.7
			points[#points] += forward * 0.7
			poseArc(limbs, points)
			local tip = hand + forward * 1.6
			arrow.Size = Vector3.new(0.16, 0.16, (tip - pull).Magnitude)
			arrow.CFrame = CFrame.lookAt(pull:Lerp(tip, 0.5), tip)
			arrowGlow.Size = Vector3.new(0.6, 0.6, arrow.Size.Z) * (0.5 + elapsed / data.duration)
			arrowGlow.CFrame = arrow.CFrame
			inflow(tip, 4)
			return true
		end, function()
			fadeOut(all, 0.1)
		end)
	elseif data.phase == "Loose" then
		play(character, ANIMS.EurosLoose)
		bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local finish = origin + direction * data.length
		local line = bar(origin, finish, 0.2, WIND_WHITE, 0)
		local glow = bar(origin, finish, 1.2, WIND, 0.55)
		U.tween(line, 0.45, { Size = Vector3.new(0.02, 0.02, line.Size.Z) })
		fadeOut({ line, glow }, 0.45)
		for i = 0, 8 do
			task.delay(i * 0.02, U.impactRing, origin:Lerp(finish, i / 8), direction, WIND_WHITE, 0.5, 3, 0.25)
		end
		U.flash(finish, WIND_WHITE, 8, 0.2)
		gust(finish, 6, direction)
		U.light(origin, WIND, 5, 24, 0.3)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- Neverland: Sylph appears over him and sounds a star horn; a dome of wind
-- rises over the whole area with stars turning across it and her small
-- clones darting about inside. Time stops for whoever is caught (a pale
-- frost of light on them); the clones strike whoever is still inside.
local domes: { [Model]: { close: () -> () } } = {}

function handlers.Neverland(data, character, root)
	if data.phase == "Horn" then
		play(character, ANIMS.Neverland)
		local sylph = makeSprite(1.6)
		local horn = U.newPart({ Size = Vector3.new(0.25, 0.25, 1.1), Color = STAR })
		every(data.cast + 0.2, function(elapsed)
			if not root.Parent then
				return false
			end
			local position = root.Position + UP * (4 + math.sin(elapsed * 4) * 0.2)
			sylph.place(CFrame.new(position) * CFrame.Angles(0, elapsed, 0), elapsed)
			horn.CFrame = CFrame.new(position) * CFrame.Angles(0, elapsed, 0) * CFrame.new(0, 0, -0.9)
			if elapsed > 0.4 and math.random() < 0.3 then
				U.burst(horn.Position, {
					color = STAR,
					count = 2,
					size = 0.3,
					speed = NumberRange.new(4, 10),
					lifetime = NumberRange.new(0.4, 0.8),
					spread = 180,
				})
			end
			return true
		end, function()
			sylph.fade(0.3)
			fadeOut({ horn }, 0.3)
		end)
		U.ringBurst(CFrame.new(data.center + UP * 0.2), STAR, 2, data.radius, data.cast, 0.15)
	elseif data.phase == "Open" then
		local center: Vector3 = data.center
		local radius: number = data.radius
		local old = domes[character]
		if old then
			old.close()
		end
		local dome = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 2,
			CFrame = CFrame.new(center),
			Color = WIND,
			Material = Enum.Material.ForceField,
			Transparency = 0.2,
		})
		U.tween(dome, 0.5, { Size = Vector3.one * radius * 2 }, Enum.EasingStyle.Quart)
		local domeStars = {}
		for i = 1, 16 do
			table.insert(domeStars, { star = makeStar(1.6), ring = if i <= 10 then 1 else 2, index = i })
		end
		local clones = {}
		for _ = 1, 6 do
			table.insert(clones, { sprite = makeSprite(0.9), seed = math.random() * 10 })
		end
		local closed = false
		local function close()
			if closed then
				return
			end
			closed = true
			domes[character] = nil
			U.tween(dome, 0.6, { Transparency = 1 })
			task.delay(0.65, dome.Destroy, dome)
			for _, entry in domeStars do
				entry.star.fade(0.4)
			end
			for _, clone in clones do
				clone.sprite.fade(0.3)
			end
		end
		domes[character] = { close = close }
		every(9, function(elapsed)
			if closed then
				return false
			end
			for _, entry in domeStars do
				local count = if entry.ring == 1 then 10 else 6
				local slot = if entry.ring == 1 then entry.index else entry.index - 10
				local latitude = if entry.ring == 1 then rad(18) else rad(48)
				local angle = slot / count * math.pi * 2 + elapsed * (if entry.ring == 1 then 0.25 else -0.35)
				local horizontal = math.cos(latitude) * radius
				local position = center
					+ Vector3.new(
						math.cos(angle) * horizontal,
						math.sin(latitude) * radius,
						math.sin(angle) * horizontal
					)
				entry.star.place(position, elapsed * 2)
			end
			for i, clone in clones do
				local s = clone.seed + elapsed * 0.9
				local position = center
					+ Vector3.new(
						math.cos(s * 1.3 + i) * radius * 0.55,
						4 + math.sin(s * 2.1) * 3,
						math.sin(s * 1.7 + i) * radius * 0.55
					)
				clone.sprite.place(CFrame.new(position), elapsed + i)
			end
			return true
		end, close)
		U.ringBurst(CFrame.new(center + UP * 0.2), WIND_WHITE, 2, radius, 0.5, 0.4)
		U.light(center + UP * 4, WIND, 4, radius * 1.5, 1)
		if (workspace.CurrentCamera.CFrame.Position - center).Magnitude < radius + 10 then
			U.colorGrade({ Saturation = 0.25, TintColor = Color3.fromRGB(225, 255, 235) }, 0.3, 6.5, 0.6)
			CameraShake.Add(0.2)
		end
	elseif data.phase == "Freeze" then
		for _, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				U.highlight(target, TIME_STOP, data.duration, 0.45)
				U.ringBurst(
					CFrame.new(targetRoot.Position) * CFrame.Angles(rad(90), 0, 0),
					TIME_STOP,
					3,
					2.6,
					data.duration,
					0.08
				)
				U.burst(targetRoot.Position, {
					color = TIME_STOP,
					count = 10,
					size = 0.3,
					speed = NumberRange.new(1, 3),
					lifetime = NumberRange.new(0.8, 1.4),
					spread = 180,
				})
			end
		end
	elseif data.phase == "Strike" then
		for _, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				local from = targetRoot.Position + U.randomUnit() * 8 + UP * 3
				local streak = bar(from, targetRoot.Position, 0.2, WIND_WHITE, 0.1)
				fadeOut({ streak }, 0.2)
				gust(targetRoot.Position, 3)
			end
		end
	elseif data.phase == "Close" then
		local dome = domes[character]
		if dome then
			dome.close()
		end
	end
end

---------------------------------------------------------------------------
-- Half-Crown / Full-Crown: transformations and looks
---------------------------------------------------------------------------

-- Sylph circles in and merges into him at the burst; wind gathers, then
-- blasts out.
local function transformation(data, character: Model, root: BasePart, full: boolean)
	if data.phase == "Start" then
		play(character, if full then ANIMS.Ascend else ANIMS.Awaken)
		local sylph = makeSprite(1.4)
		every(0.8, function(elapsed)
			if not root.Parent then
				return false
			end
			local t = elapsed / 0.8
			local angle = t * math.pi * 4
			local radius = 5 * (1 - t) + 0.5
			sylph.place(
				CFrame.new(root.Position + Vector3.new(math.cos(angle) * radius, 3 - t * 2, math.sin(angle) * radius)),
				elapsed
			)
			inflow(root.Position, 7)
			return true
		end, function()
			sylph.fade(0.15)
		end)
		if full then
			U.spiral(root, WIND, 4, 10, 1.3, 4, 0.2, 0.5)
		end
		U.ringBurst(CFrame.new(root.Position - UP * 2.8), WIND, 12, 2, 0.8, 0.2)
	elseif data.phase == "Burst" then
		local position = root.Position
		U.shockwave(position, WIND, 3, if full then 40 else 28, 0.6, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, if full then 22 else 16, 0.5, 0.4)
		U.pillar(position - UP * 3, WIND, 4, if full then 40 else 26, 0.6, Enum.Material.ForceField, 0.3)
		U.burst(position, {
			color = WIND_WHITE,
			count = 40,
			size = 0.6,
			speed = NumberRange.new(40, 90),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if full then
			U.flash(position + UP * 3, STAR, 10, 0.3)
		end
		U.light(position, WIND, 6, 40, 0.8)
		if U.isLocal(character) then
			U.colorGrade({ Brightness = 0.15, Saturation = 0.3 }, 0, 0.1, 0.5)
			CameraShake.Add(0.35)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "End" then
		gust(root.Position, 6)
	end
end

function handlers.Awaken(data, character, root)
	transformation(data, character, root, false)
end

function handlers.Ascend(data, character, root)
	transformation(data, character, root, true)
end

-- The look: green mana down one side (Half-Crown: his left, where Sylph
-- sits) or both (Full-Crown); a wing of long wind feathers on that side,
-- beating slowly; half a crown of gold spikes, or a full one; Full-Crown
-- also puts a two-handed sword of wind in his hand. Anchored parts posed
-- every frame round his torso, head and arms; they fade in.
local FEATHERS = 4

local function buildLook(character: Model, full: boolean): () -> ()
	local torso = character:FindFirstChild("Torso") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	if not torso or not head then
		return function() end
	end
	local look = { hideSword = 0 }
	looks[character] = look
	local entries: { { part: BasePart, base: number } } = {}
	local function part(props: { [string]: any }, base: number): BasePart
		props.Transparency = 1
		local p = U.newPart(props)
		table.insert(entries, { part = p, base = base })
		return p
	end

	local sides = if full then { -1, 1 } else { -1 } -- -1: his left
	local wings: { { side: number, feathers: { BasePart } } } = {}
	for _, side in sides do
		local feathers = {}
		for i = 1, FEATHERS do
			table.insert(feathers, part({ Size = Vector3.new(0.08, 0.5, 3.3 - i * 0.4), Color = WIND }, 0.3))
		end
		table.insert(wings, { side = side, feathers = feathers })
	end

	local spikes = {}
	local spikeCount = if full then 9 else 5
	for i = 1, spikeCount do
		local tall = if i % 2 == 1 then 0.75 else 0.5
		table.insert(spikes, { part = part({ Size = Vector3.new(0.12, tall, 0.12), Color = STAR }, 0.05), i = i })
	end
	local band = part({ Size = Vector3.new(1.3, 0.12, 1.3), Color = STAR, Shape = Enum.PartType.Cylinder }, 0.2)

	local marks = {}
	for _, side in sides do
		local arm = character:FindFirstChild(if side < 0 then "Left Arm" else "Right Arm") :: BasePart?
		if arm then
			table.insert(
				marks,
				{ arm = arm, side = side, strip = part({ Size = Vector3.new(0.04, 1.7, 0.28), Color = WIND }, 0.15) }
			)
		end
	end

	local sword: { BasePart }? = nil
	if full then
		sword = {
			part({ Size = Vector3.new(0.22, 1.1, 0.22), Color = WIND_DEEP }, 0),
			part({ Size = Vector3.new(1.5, 0.18, 0.32), Color = STAR }, 0),
			part({ Size = Vector3.new(0.2, 5.6, 0.85), Color = WIND }, 0.25),
			part({ Size = Vector3.new(0.1, 5.4, 0.28), Color = WIND_WHITE }, 0),
		}
	end

	-- Wisps of green mana off the marked arms.
	local emitters = {}
	for _, mark in marks do
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = U.textures.Smoke
		emitter.Color = ColorSequence.new(WIND)
		emitter.LightEmission = 0.8
		emitter.LightInfluence = 0
		emitter.Size = NumberSequence.new(0.5, 0)
		emitter.Transparency = NumberSequence.new(0.5, 1)
		emitter.Lifetime = NumberRange.new(0.4, 0.7)
		emitter.Rate = 18
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.Acceleration = Vector3.new(0, 3, 0)
		emitter.Parent = mark.arm
		table.insert(emitters, emitter)
	end

	local start = os.clock()
	local connection = RunService.RenderStepped:Connect(function()
		if not torso.Parent or not head.Parent then
			return
		end
		local t = os.clock() - start
		local alpha = math.min(t / 0.5, 1)
		for _, entry in entries do
			entry.part.Transparency = 1 - (1 - entry.base) * alpha
		end

		-- Wings: long feathers fanned out and back from the shoulder blade,
		-- beating slowly.
		local flap = math.sin(t * 2.2) * 10
		for _, wing in wings do
			local base = torso.CFrame * Vector3.new(wing.side * 0.55, 0.6, 0.55)
			for i, feather in wing.feathers do
				local spread = rad(8 + i * 17 + flap)
				local localDirection =
					Vector3.new(wing.side * math.cos(spread), math.sin(spread) * 0.9 + 0.15, 0.6).Unit
				local direction = torso.CFrame:VectorToWorldSpace(localDirection)
				local length = feather.Size.Z
				feather.CFrame = CFrame.lookAt(base + direction * (length / 2), base + direction * length)
			end
		end

		-- Crown: gold spikes round the top of his head (his left half only in Half-Crown).
		local crown = head.CFrame * CFrame.new(0, 0.62, 0)
		band.CFrame = crown * CFrame.Angles(0, 0, rad(90))
		for _, spike in spikes do
			local angle = if full
				then (spike.i - 1) / spikeCount * math.pi * 2
				else math.pi * 0.5 + (spike.i - 1) / (spikeCount - 1) * math.pi
			local around = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 0.62
			spike.part.CFrame = crown
				* CFrame.new(around + Vector3.new(0, spike.part.Size.Y / 2, 0))
				* CFrame.Angles(around.Z * rad(-25), 0, around.X * rad(25))
		end

		-- Mana markings down the outside of each marked arm.
		for _, mark in marks do
			if mark.arm.Parent then
				mark.strip.CFrame = mark.arm.CFrame * CFrame.new(mark.side * 0.51, 0, 0)
			end
		end

		-- The wind sword, in the right hand.
		if sword then
			local arm = character:FindFirstChild("Right Arm") :: BasePart?
			local hidden = os.clock() < look.hideSword
			if arm then
				local grip = arm.CFrame * CFrame.new(0, -1.1, 0) * CFrame.Angles(rad(-90), 0, 0)
				sword[1].CFrame = grip
				sword[2].CFrame = grip * CFrame.new(0, 0.6, 0)
				sword[3].CFrame = grip * CFrame.new(0, 3.5, 0)
				sword[4].CFrame = grip * CFrame.new(0, 3.5, 0)
			end
			if hidden then
				for _, p in sword do
					p.Transparency = 1
				end
			end
		end
	end)

	return function()
		connection:Disconnect()
		if looks[character] == look then
			looks[character] = nil
		end
		for _, emitter in emitters do
			emitter.Enabled = false
			task.delay(1, emitter.Destroy, emitter)
		end
		local parts = {}
		for _, entry in entries do
			table.insert(parts, entry.part)
		end
		fadeOut(parts, 0.4)
	end
end

local destroyLook: { [Model]: () -> () } = {}
local stageWatch: { [Model]: RBXScriptConnection } = {}

function Kit.SetAwakened(character: Model, on: boolean)
	local watch = stageWatch[character]
	if watch then
		watch:Disconnect()
		stageWatch[character] = nil
	end
	local destroy = destroyLook[character]
	if destroy then
		destroyLook[character] = nil
		destroy()
	end
	if not on then
		return
	end
	local function rebuild()
		local old = destroyLook[character]
		if old then
			old()
		end
		destroyLook[character] = buildLook(character, character:GetAttribute("Ascended") == true)
	end
	rebuild()
	stageWatch[character] = character:GetAttributeChangedSignal("Ascended"):Connect(function()
		if character:GetAttribute("Awakened") == true then
			rebuild()
		end
	end)
end

function Kit.OnSkill(data)
	local character = data.character
	if typeof(character) ~= "Instance" or not character:IsA("Model") then
		return
	end
	local root = U.getRoot(character)
	local handler = handlers[data.skill]
	if root and handler then
		handler(data, character, root)
	end
end

return Kit
