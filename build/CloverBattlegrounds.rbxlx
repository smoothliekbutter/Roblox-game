      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">CombatState</string>
          <string name="Source"><![CDATA[--[[
	CombatState
	Combat state is stored as attributes on the character model. Attributes
	replicate, so the server writes them and clients read them to gate input
	and drive the HUD. Timestamps use server time so both sides agree.
]]

local CombatState = {}

local DEFAULTS = {
	StunUntil = 0,
	BusyUntil = 0,
	IFrameUntil = 0,
	Blocking = false,
	BlockStart = 0,
	Ragdolled = false,
	Evasive = 0,
}

local function now(): number
	return workspace:GetServerTimeNow()
end
CombatState.Now = now

function CombatState.Setup(character: Model)
	for name, value in DEFAULTS do
		character:SetAttribute(name, value)
	end
end

function CombatState.IsAlive(character: Model?): boolean
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") ~= nil
end

function CombatState.IsStunned(character: Model): boolean
	return (tonumber(character:GetAttribute("StunUntil")) or 0) > now()
end

function CombatState.IsBusy(character: Model): boolean
	return (tonumber(character:GetAttribute("BusyUntil")) or 0) > now()
end

function CombatState.IsRagdolled(character: Model): boolean
	return character:GetAttribute("Ragdolled") == true
end

function CombatState.IsBlocking(character: Model): boolean
	return character:GetAttribute("Blocking") == true
end

function CombatState.HasIFrames(character: Model): boolean
	return (tonumber(character:GetAttribute("IFrameUntil")) or 0) > now()
end

-- Alive, not stunned and not ragdolled. Busy (mid-swing) is checked separately.
function CombatState.CanAct(character: Model): boolean
	return CombatState.IsAlive(character)
		and not CombatState.IsStunned(character)
		and not CombatState.IsRagdolled(character)
end

-- Setters below are only meaningful on the server.

function CombatState.Stun(character: Model, duration: number)
	local untilTime = math.max(tonumber(character:GetAttribute("StunUntil")) or 0, now() + duration)
	character:SetAttribute("StunUntil", untilTime)
end

function CombatState.ClearStun(character: Model)
	character:SetAttribute("StunUntil", 0)
end

function CombatState.SetBusy(character: Model, duration: number)
	character:SetAttribute("BusyUntil", now() + duration)
end

function CombatState.GiveIFrames(character: Model, duration: number)
	character:SetAttribute("IFrameUntil", now() + duration)
end

function CombatState.SetBlocking(character: Model, blocking: boolean)
	character:SetAttribute("Blocking", blocking)
	if blocking then
		character:SetAttribute("BlockStart", now())
	end
end

return CombatState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Every tunable combat number lives here so balancing never means digging
	through logic. Times are in seconds, speeds in studs/second.
]]

local Config = {}

Config.Debug = {
	-- Draws a red box wherever a hitbox is checked (server-side, visible to everyone).
	ShowHitboxes = false,
}

Config.Movement = {
	WalkSpeed = 16,
	JumpHeight = 4.5, -- studs (Roblox default is 7.2)
	AttackingSpeed = 10,
	BlockingSpeed = 7,
	StunnedSpeed = 3,
}

Config.M1 = {
	ComboLength = 4,
	Damage = 3.5,
	FinisherDamage = 5,

	SwingCooldown = 0.3, -- time between swings in a string
	ResetTime = 1.1, -- idle time before the combo counter resets
	EndLag = 1.1, -- lockout after the final hit
	Busy = 0.35, -- slowed and can't jump while swinging (> SwingCooldown, so a full string stays grounded)
	FinisherBusy = 0.45,
	WindUp = 0.08, -- delay between the swing starting and the hitbox
	FinisherWindUp = 0.15, -- the 4th hit winds up longer (matches its animation)
	InputTolerance = 0.06, -- accept swings this early to absorb network jitter

	HitStun = 0.6, -- longer than SwingCooldown + WindUp, so strings are true combos
	UppercutStun = 1.1,

	HitboxSize = Vector3.new(5.5, 6, 6),
	HitboxOffset = 3.25, -- studs in front of the root

	Push = 6, -- small push on normal hits keeps the victim in range
	LungeSpeed = 12, -- attacker steps forward a little on every swing
	LungeTime = 0.1,
	AirFloat = 0.35, -- air hits hold both players up this long

	KnockbackForce = 65,
	KnockbackLift = 18,
	UppercutForce = 48,
	DownslamForce = 75,
}

Config.Block = {
	PerfectWindow = 0.2, -- block pressed this recently = perfect block
	ParryStun = 1.25, -- attacker stun after being perfect blocked
	GuardBreakStun = 1.75,
	Cooldown = 0.4, -- after releasing block, stops perfect-block spam
	Pushback = 14,
	FacingDot = 0, -- > 0 means the attacker must be in front (180 degree cone)
}

Config.Dash = {
	Cooldown = 2,
	Duration = 0.28,
	Tolerance = 0.2, -- server allows the client to be this early (latency)
	Speed = {
		Front = 85,
		Back = 70,
		Left = 70,
		Right = 70,
	},
}

Config.Ragdoll = {
	Duration = 1.5,
}

-- Evasive: fills as you take damage. When full, Q while stunned or
-- ragdolled breaks you out of the combo.
Config.Evasive = {
	Max = 100,
	GainPerDamage = 5,
	RegenPerSecond = 1.5,
	IFrames = 0.6,
	Speed = 55,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Impulse</string>
          <string name="Source"><![CDATA[--[[
	Impulse
	Pushes a character for a short time using a LinearVelocity. A plain
	AssemblyLinearVelocity gets eaten by the Humanoid's controller, this
	doesn't. Must run on whoever owns the physics: the client for its own
	character, the server for NPCs and ragdolled characters.
]]

local Impulse = {}

-- Applies `velocity` for `duration` seconds. Only one impulse per `name`
-- exists at a time, so a new dash replaces an old dash. Vertical force is
-- only applied when velocity has a Y component, so gravity still works on
-- flat pushes. Returns the LinearVelocity so callers can steer it.
function Impulse.Apply(root: BasePart, velocity: Vector3, duration: number, name: string?): LinearVelocity
	local id = "Impulse_" .. (name or "Default")
	local existing = root:FindFirstChild(id)
	if existing then
		existing:Destroy()
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = id
	attachment.Parent = root

	local mover = Instance.new("LinearVelocity")
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	local vertical = if math.abs(velocity.Y) > 0.01 then 1e6 else 0
	mover.MaxAxesForce = Vector3.new(1e6, vertical, 1e6)
	mover.VectorVelocity = velocity
	mover.Parent = attachment

	task.delay(duration, function()
		attachment:Destroy()
	end)

	return mover
end

function Impulse.Clear(root: BasePart)
	for _, child in root:GetChildren() do
		if child:IsA("Attachment") and string.sub(child.Name, 1, 8) == "Impulse_" then
			child:Destroy()
		end
	end
end

return Impulse
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	The server creates every RemoteEvent; clients wait for them.

	Action       client -> server   ("M1", {jump}) | ("Block", bool) | ("Dash", dir) | ("Evasive")
	VFX          server -> clients  (effectName, data)
	CameraShake  server -> client   (intensity 0-1)
	Impulse      server -> client   (velocity, duration) applied to your own character
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = { "Action", "VFX", "CameraShake", "Impulse" }

local Remotes: { [string]: RemoteEvent } = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in NAMES do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in NAMES do
		Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Server entry point.
]]

local Players = game:GetService("Players")

local CharacterLoader = require(script.CharacterLoader)
local CombatService = require(script.CombatService)
local Dummies = require(script.Dummies)

CombatService.Start()

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(CombatService.Register)
	if player.Character then
		task.spawn(CombatService.Register, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- After combat hooks are in place, so the first spawn gets registered.
CharacterLoader.Start()

Dummies.Start()
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">CharacterLoader</string>
          <string name="Source"><![CDATA[--[[
	CharacterLoader
	Puts every player in an R6 body while keeping their own avatar look
	(skin colors, clothes, face, accessories). Battlegrounds animations and
	ragdolls are built for R6, and this works without publishing the place
	or changing Game Settings.

	How: an R6 rig named "StarterCharacter" in StarterPlayer makes Roblox
	spawn everyone as that rig. We spawn players ourselves and then dress
	the rig in their avatar.
]]

local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")

local CharacterLoader = {}

local descriptions: { [Player]: HumanoidDescription } = {}

local function getDescription(player: Player): HumanoidDescription
	local cached = descriptions[player]
	if cached then
		return cached
	end
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserIdAsync(player.UserId)
	end)
	if not ok or not description then
		-- Local test servers use fake negative user ids with no avatar.
		description = Instance.new("HumanoidDescription")
	end
	descriptions[player] = description
	return description
end

local function spawnCharacter(player: Player)
	if not player.Parent then
		return
	end
	player:LoadCharacterAsync()

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return
	end

	local ok, err = pcall(function()
		humanoid:ApplyDescriptionAsync(getDescription(player))
	end)
	if not ok then
		warn("[CharacterLoader] Couldn't apply avatar for", player.Name, err)
	end

	humanoid.Died:Connect(function()
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == character then
				spawnCharacter(player)
			end
		end)
	end)
end

function CharacterLoader.Start()
	Players.CharacterAutoLoads = false

	if not StarterPlayer:FindFirstChild("StarterCharacter") then
		local rig = Players:CreateHumanoidModelFromDescriptionAsync(
			Instance.new("HumanoidDescription"),
			Enum.HumanoidRigType.R6
		)
		rig.Name = "StarterCharacter"
		rig.Parent = StarterPlayer
	end

	Players.PlayerAdded:Connect(spawnCharacter)
	Players.PlayerRemoving:Connect(function(player)
		descriptions[player] = nil
	end)
	-- Anyone who joined before this ran may have auto-spawned as R15: respawn them.
	for _, player in Players:GetPlayers() do
		task.spawn(spawnCharacter, player)
	end
end

return CharacterLoader
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--[[
	CombatService
	Server-authoritative core combat: M1 strings, blocking, perfect blocks,
	guard breaks, dashes, ragdolls and the Evasive breakout. Players and NPCs
	go through the same functions, so dummies fight with the real rules.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CombatState = require(Shared.CombatState)
local Impulse = require(Shared.Impulse)
local Remotes = require(Shared.Remotes)

local Hitbox = require(script.Parent.Hitbox)
local Ragdoll = require(script.Parent.Ragdoll)

export type CharData = {
	humanoid: Humanoid,
	combo: number,
	lastM1: number,
	nextM1: number,
	nextBlock: number,
	nextDash: number,
	ragdollToken: number,
	lastDamaged: number,
}

export type HitInfo = {
	damage: number,
	stun: number,
	guardBreak: boolean,
	variant: string, -- "Normal" | "Knockback" | "Uppercut" | "Downslam"
	airborne: boolean,
}

local DASH_DIRECTIONS = { Front = true, Back = true, Left = true, Right = true }

local registry: { [Model]: CharData } = {}

local CombatService = {}

local function getRoot(character: Model): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function flat(vector: Vector3): Vector3
	local v = Vector3.new(vector.X, 0, vector.Z)
	return if v.Magnitude > 1e-3 then v.Unit else Vector3.new(0, 0, -1)
end

local function fireVFX(name: string, data: { [string]: any })
	Remotes.VFX:FireAllClients(name, data)
end

local function shake(character: Model, intensity: number)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		Remotes.CameraShake:FireClient(player, intensity)
	end
end

-- Moves a character, routing to whoever owns its physics.
local function applyVelocity(character: Model, velocity: Vector3, duration: number)
	local root = getRoot(character)
	if not root then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if CombatState.IsRagdolled(character) then
		-- Server owns ragdolls, and a ragdoll has no Humanoid fighting the velocity.
		root.AssemblyLinearVelocity = velocity
	elseif player then
		Remotes.Impulse:FireClient(player, velocity, duration)
	else
		Impulse.Apply(root, velocity, duration, "Knockback")
	end
end

local function isAirborne(character: Model): boolean
	local root = getRoot(character)
	if not root then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	return workspace:Raycast(root.Position, Vector3.new(0, -4.5, 0), params) == nil
end

local function addEvasive(character: Model, amount: number)
	local current = tonumber(character:GetAttribute("Evasive")) or 0
	local value = math.clamp(current + amount, 0, Config.Evasive.Max)
	if value ~= current then
		character:SetAttribute("Evasive", value)
	end
end

local function ragdollFor(character: Model, duration: number)
	local data = registry[character]
	if not data then
		return
	end
	data.ragdollToken += 1
	local token = data.ragdollToken

	CombatState.SetBlocking(character, false)
	Ragdoll.Enable(character)
	CombatState.Stun(character, duration)

	task.delay(duration, function()
		if registry[character] == data and data.ragdollToken == token and CombatState.IsAlive(character) then
			Ragdoll.Disable(character)
		end
	end)
end

-- Fires the crater effect roughly when a downslammed victim reaches the ground.
local function scheduleCrater(victim: Model, attacker: Model)
	local root = getRoot(victim)
	if not root then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { victim, attacker }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -80, 0), params)
	if not result then
		return
	end
	local fallTime = math.clamp((root.Position.Y - result.Position.Y - 2) / Config.M1.DownslamForce, 0, 1)
	task.delay(fallTime, function()
		fireVFX("Crater", { position = result.Position })
		shake(victim, 0.5)
		shake(attacker, 0.4)
	end)
end

function CombatService.GetData(character: Model): CharData?
	return registry[character]
end

function CombatService.Register(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid or registry[character] then
		return
	end
	character:WaitForChild("HumanoidRootPart", 10)

	CombatState.Setup(character)
	humanoid.BreakJointsOnDeath = false
	humanoid.UseJumpPower = false
	-- Only our ragdoll should knock people over. (For players this has to be
	-- repeated on their client, see Input.)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

	local data: CharData = {
		humanoid = humanoid,
		combo = 0,
		lastM1 = 0,
		nextM1 = 0,
		nextBlock = 0,
		nextDash = 0,
		ragdollToken = 0,
		lastDamaged = 0,
	}
	registry[character] = data

	humanoid.Died:Connect(function()
		data.ragdollToken += 1 -- stop any pending get-up
		Ragdoll.Enable(character)
	end)

	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			registry[character] = nil
			Ragdoll.Forget(character)
		end
	end)
end

--[[
	Lands (or fails to land) a hit. Returns what happened:
	"Hit" | "Blocked" | "Parried" | "GuardBreak" | "Immune" | "None"
]]
function CombatService.Hit(attacker: Model, victim: Model, hit: HitInfo): string
	local humanoid = victim:FindFirstChildOfClass("Humanoid")
	local victimRoot = getRoot(victim)
	local attackerRoot = getRoot(attacker)
	if not humanoid or not victimRoot or not attackerRoot or humanoid.Health <= 0 then
		return "None"
	end
	-- No hitting people on the floor: stops infinites.
	if CombatState.HasIFrames(victim) or CombatState.IsRagdolled(victim) then
		return "Immune"
	end

	local toAttacker = flat(attackerRoot.Position - victimRoot.Position)
	local look = flat(attackerRoot.CFrame.LookVector)
	local contact = victimRoot.Position + toAttacker * 1.2

	local facing = victimRoot.CFrame.LookVector:Dot(toAttacker) > Config.Block.FacingDot
	if CombatState.IsBlocking(victim) and facing then
		local blockAge = CombatState.Now() - (tonumber(victim:GetAttribute("BlockStart")) or 0)

		if blockAge <= Config.Block.PerfectWindow then
			CombatState.Stun(attacker, Config.Block.ParryStun)
			fireVFX("PerfectBlock", { position = contact, attacker = attacker, victim = victim })
			shake(attacker, 0.6)
			shake(victim, 0.35)
			return "Parried"
		end

		if hit.guardBreak then
			CombatState.SetBlocking(victim, false)
			CombatState.Stun(victim, Config.Block.GuardBreakStun)
			fireVFX("GuardBreak", { position = contact, victim = victim })
			shake(attacker, 0.4)
			shake(victim, 0.6)
			return "GuardBreak"
		end

		fireVFX("Block", { position = contact, victim = victim })
		applyVelocity(victim, -toAttacker * Config.Block.Pushback, 0.12)
		shake(victim, 0.12)
		return "Blocked"
	end

	-- The hit lands.
	humanoid:TakeDamage(hit.damage)
	CombatState.SetBlocking(victim, false)
	CombatState.Stun(victim, hit.stun)

	local victimData = registry[victim]
	if victimData then
		victimData.lastDamaged = os.clock()
	end
	addEvasive(victim, hit.damage * Config.Evasive.GainPerDamage)

	local heavy = hit.variant ~= "Normal"
	if hit.variant == "Knockback" then
		ragdollFor(victim, Config.Ragdoll.Duration)
		applyVelocity(victim, look * Config.M1.KnockbackForce + Vector3.new(0, Config.M1.KnockbackLift, 0), 0.2)
	elseif hit.variant == "Uppercut" then
		local lift = Vector3.new(0, Config.M1.UppercutForce, 0)
		applyVelocity(victim, lift + look * 4, 0.25)
		applyVelocity(attacker, lift, 0.25)
	elseif hit.variant == "Downslam" then
		ragdollFor(victim, Config.Ragdoll.Duration)
		applyVelocity(victim, look * 10 + Vector3.new(0, -Config.M1.DownslamForce, 0), 0.2)
		scheduleCrater(victim, attacker)
	elseif hit.airborne then
		local float = Vector3.new(0, 3, 0) + look * 3
		applyVelocity(victim, float, Config.M1.AirFloat)
		applyVelocity(attacker, float, Config.M1.AirFloat)
	else
		applyVelocity(victim, look * Config.M1.Push, 0.15)
	end

	fireVFX(if heavy then "HeavyHit" else "Hit", {
		position = contact,
		direction = look,
		attacker = attacker,
		victim = victim,
		damage = hit.damage,
		variant = hit.variant,
	})
	shake(attacker, if heavy then 0.45 else 0.18)
	shake(victim, if heavy then 0.7 else 0.3)
	return "Hit"
end

-- One swing of the M1 string. `jump` = jump held, turns the finisher into an uppercut.
function CombatService.M1(character: Model, jump: boolean?)
	local data = registry[character]
	if not data or not CombatState.CanAct(character) or CombatState.IsBlocking(character) then
		return
	end
	local t = os.clock()
	if t < data.nextM1 - Config.M1.InputTolerance then
		return
	end
	if t - data.lastM1 > Config.M1.ResetTime then
		data.combo = 0
	end

	data.combo += 1
	data.lastM1 = t
	local index = data.combo
	local finisher = index >= Config.M1.ComboLength
	local airborne = isAirborne(character)

	local variant = "Normal"
	if finisher then
		data.combo = 0
		data.nextM1 = t + Config.M1.EndLag
		if jump then
			variant = "Uppercut"
		elseif airborne then
			variant = "Downslam"
		else
			variant = "Knockback"
		end
	else
		data.nextM1 = t + Config.M1.SwingCooldown
	end
	CombatState.SetBusy(character, if finisher then Config.M1.FinisherBusy else Config.M1.Busy)

	fireVFX("Swing", { character = character, index = index, finisher = finisher, variant = variant })

	task.delay(if finisher then Config.M1.FinisherWindUp else Config.M1.WindUp, function()
		-- Getting hit during wind-up cancels the swing.
		if not CombatState.CanAct(character) then
			return
		end
		local root = getRoot(character)
		if not root then
			return
		end
		local hitboxCFrame = root.CFrame * CFrame.new(0, 0, -Config.M1.HitboxOffset)
		for _, victim in Hitbox.Box(character, hitboxCFrame, Config.M1.HitboxSize) do
			CombatService.Hit(character, victim, {
				damage = if finisher then Config.M1.FinisherDamage else Config.M1.Damage,
				stun = if variant == "Uppercut" then Config.M1.UppercutStun else Config.M1.HitStun,
				guardBreak = finisher,
				variant = variant,
				airborne = airborne,
			})
		end
	end)
end

function CombatService.SetBlock(character: Model, wantBlock: boolean)
	local data = registry[character]
	if not data then
		return
	end
	if wantBlock then
		if CombatState.IsBlocking(character) or not CombatState.CanAct(character) or CombatState.IsBusy(character) then
			return
		end
		if os.clock() < data.nextBlock then
			return
		end
		CombatState.SetBlocking(character, true)
	elseif CombatState.IsBlocking(character) then
		CombatState.SetBlocking(character, false)
		data.nextBlock = os.clock() + Config.Block.Cooldown
	end
end

-- Movement is client-side (the client owns its character), the server only
-- validates the cooldown and tells everyone else to draw the effect.
function CombatService.Dash(character: Model, direction: string): boolean
	local data = registry[character]
	if not data or not DASH_DIRECTIONS[direction] or not CombatState.CanAct(character) then
		return false
	end
	local t = os.clock()
	if t < data.nextDash - Config.Dash.Tolerance then
		return false
	end
	data.nextDash = t + Config.Dash.Cooldown
	CombatState.SetBlocking(character, false)
	return true
end

-- Breaks out of a combo or ragdoll when the Evasive bar is full.
function CombatService.Evasive(character: Model): boolean
	local data = registry[character]
	if not data or not CombatState.IsAlive(character) then
		return false
	end
	if not (CombatState.IsStunned(character) or CombatState.IsRagdolled(character)) then
		return false
	end
	if (tonumber(character:GetAttribute("Evasive")) or 0) < Config.Evasive.Max then
		return false
	end

	data.ragdollToken += 1
	character:SetAttribute("Evasive", 0)
	Ragdoll.Disable(character)
	CombatState.ClearStun(character)
	CombatState.GiveIFrames(character, Config.Evasive.IFrames)

	local root = getRoot(character)
	if root then
		local back = -flat(root.CFrame.LookVector)
		applyVelocity(character, back * Config.Evasive.Speed + Vector3.new(0, 8, 0), 0.2)
	end
	fireVFX("Evasive", { character = character })
	return true
end

local function onAction(player: Player, action: unknown, payload: unknown)
	local character = player.Character
	if not character or not registry[character] or type(action) ~= "string" then
		return
	end

	if action == "M1" then
		local jump = type(payload) == "table" and (payload :: any).jump == true
		CombatService.M1(character, jump)
	elseif action == "Block" then
		CombatService.SetBlock(character, payload == true)
	elseif action == "Dash" then
		if type(payload) == "string" and CombatService.Dash(character, payload) then
			-- The dasher already drew their own effect.
			for _, other in Players:GetPlayers() do
				if other ~= player then
					Remotes.VFX:FireClient(other, "Dash", { character = character, direction = payload })
				end
			end
		end
	elseif action == "Evasive" then
		CombatService.Evasive(character)
	end
end

-- Movement speed follows combat state every frame.
local function updateMovement()
	for character, data in registry do
		local humanoid = data.humanoid
		if humanoid.Health > 0 then
			local speed, jump = Config.Movement.WalkSpeed, Config.Movement.JumpHeight
			if CombatState.IsRagdolled(character) then
				speed, jump = 0, 0
			elseif CombatState.IsStunned(character) then
				speed, jump = Config.Movement.StunnedSpeed, 0
			elseif CombatState.IsBlocking(character) then
				speed, jump = Config.Movement.BlockingSpeed, 0
			elseif CombatState.IsBusy(character) then
				speed, jump = Config.Movement.AttackingSpeed, 0
			end
			if humanoid.WalkSpeed ~= speed then
				humanoid.WalkSpeed = speed
			end
			if humanoid.JumpHeight ~= jump then
				humanoid.JumpHeight = jump
			end
		end
	end
end

function CombatService.Start()
	Remotes.Action.OnServerEvent:Connect(onAction)

	local evasiveTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		updateMovement()

		-- Attribute writes replicate, so the passive regen ticks 4 times a second.
		evasiveTimer += dt
		if evasiveTimer >= 0.25 then
			for character in registry do
				addEvasive(character, Config.Evasive.RegenPerSecond * evasiveTimer)
			end
			evasiveTimer = 0
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Dummies</string>
          <string name="Source"><![CDATA[--[[
	Dummies
	Test NPCs in front of spawn. They use the real combat rules:
	  Dummy           - stands still, heals after a few seconds
	  Blocking Dummy  - always blocks and faces you (test guard breaks)
	  Attacking Dummy - throws full M1 strings at you (test blocks, perfect blocks, Evasive)
]]

local Players = game:GetService("Players")

local CombatService = require(script.Parent.CombatService)
local CombatState = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").CombatState)

type Spec = {
	name: string,
	behavior: "Idle" | "Block" | "Attack",
	color: Color3,
	position: Vector3,
}

local SPECS: { Spec } = {
	{ name = "Dummy", behavior = "Idle", color = Color3.fromRGB(225, 225, 225), position = Vector3.new(-12, 3, -28) },
	{
		name = "Blocking Dummy",
		behavior = "Block",
		color = Color3.fromRGB(80, 140, 255),
		position = Vector3.new(0, 3, -28),
	},
	{
		name = "Attacking Dummy",
		behavior = "Attack",
		color = Color3.fromRGB(255, 90, 90),
		position = Vector3.new(12, 3, -28),
	},
}

local RESPAWN_TIME = 3
local REGEN_DELAY = 3
local AGGRO_RANGE = 25
local ATTACK_RANGE = 6.5

local folder = Instance.new("Folder")
folder.Name = "Dummies"
folder.Parent = workspace

local Dummies = {}

local function nearestPlayerRoot(position: Vector3, range: number): BasePart?
	local best, bestDistance = nil, range
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and CombatState.IsAlive(character) then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = root, distance
			end
		end
	end
	return best
end

local function face(root: BasePart, target: Vector3)
	local flatTarget = Vector3.new(target.X, root.Position.Y, target.Z)
	if (flatTarget - root.Position).Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(root.Position, flatTarget)
	end
end

local function runBehavior(model: Model, spec: Spec, humanoid: Humanoid, root: BasePart)
	while model.Parent and humanoid.Health > 0 do
		local data = CombatService.GetData(model)

		-- Heal back to full when left alone.
		if data and os.clock() - data.lastDamaged > REGEN_DELAY and humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end

		local target = nearestPlayerRoot(root.Position, AGGRO_RANGE)
		local canAct = CombatState.CanAct(model)

		if spec.behavior == "Block" then
			if target and canAct then
				face(root, target.Position)
			end
			if canAct and not CombatState.IsBlocking(model) then
				CombatService.SetBlock(model, true)
			end
			task.wait(0.1)
		elseif spec.behavior == "Attack" then
			if target and canAct then
				face(root, target.Position)
				if (target.Position - root.Position).Magnitude <= ATTACK_RANGE then
					-- A full 4 hit string, then a breather.
					for _ = 1, 4 do
						if not CombatState.CanAct(model) then
							break
						end
						face(root, target.Position)
						CombatService.M1(model)
						task.wait(0.34)
					end
					task.wait(2)
				end
			end
			task.wait(0.1)
		else
			task.wait(0.5)
		end
	end
end

local function spawnDummy(spec: Spec)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = spec.color
	description.TorsoColor = spec.color
	description.LeftArmColor = spec.color
	description.RightArmColor = spec.color
	description.LeftLegColor = spec.color
	description.RightLegColor = spec.color

	local model = Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R6)
	model.Name = spec.name

	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	humanoid.DisplayName = spec.name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer

	model:PivotTo(CFrame.lookAt(spec.position, Vector3.new(0, spec.position.Y, 0)))
	model.Parent = folder
	root:SetNetworkOwner(nil)

	CombatService.Register(model)

	humanoid.Died:Connect(function()
		task.delay(RESPAWN_TIME, function()
			model:Destroy()
			spawnDummy(spec)
		end)
	end)

	task.spawn(runBehavior, model, spec, humanoid, root)
end

function Dummies.Start()
	for _, spec in SPECS do
		task.spawn(spawnDummy, spec)
	end
end

return Dummies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Hitbox</string>
          <string name="Source"><![CDATA[--[[
	Hitbox
	Spatial queries that return the characters (anything with a Humanoid)
	inside a region. Each character is returned at most once.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CombatState = require(Shared.CombatState)

local Hitbox = {}

local function characterFromPart(part: BasePart): Model?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

local function visualize(cframe: CFrame, size: Vector3)
	local box = Instance.new("Part")
	box.Name = "HitboxDebug"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.Material = Enum.Material.ForceField
	box.Color = Color3.fromRGB(255, 40, 40)
	box.CFrame = cframe
	box.Size = size
	box.Parent = workspace
	Debris:AddItem(box, 0.25)
end

function Hitbox.Box(attacker: Model, cframe: CFrame, size: Vector3): { Model }
	if Config.Debug.ShowHitboxes then
		visualize(cframe, size)
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { attacker }

	local found: { Model } = {}
	local seen: { [Model]: boolean } = {}
	for _, part in workspace:GetPartBoundsInBox(cframe, size, params) do
		local character = characterFromPart(part)
		if character and not seen[character] and CombatState.IsAlive(character) then
			seen[character] = true
			table.insert(found, character)
		end
	end
	return found
end

return Hitbox
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Ragdoll</string>
          <string name="Source"><![CDATA[--[[
	Ragdoll
	Swaps a character's Motor6Ds for BallSocketConstraints so it flops. The
	server takes network ownership while ragdolled so knockback is smooth and
	can't be ignored by the client. Works with R6 and R15.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

local GROUP = "Ragdoll"
if not PhysicsService:IsCollisionGroupRegistered(GROUP) then
	PhysicsService:RegisterCollisionGroup(GROUP)
end
-- Body parts of a ragdoll don't collide with each other (stops jitter at the joints).
PhysicsService:CollisionGroupSetCollidable(GROUP, GROUP, false)

-- The root joint stays a motor so the HumanoidRootPart follows the torso.
local KEEP_JOINTS = {
	RootJoint = true,
	Root = true,
}

type Record = {
	created: { Instance },
	motors: { Motor6D },
	groups: { [BasePart]: string },
}

local active: { [Model]: Record } = {}

local Ragdoll = {}

-- The Humanoid's own "get up" can fail on a body lying flat, so snap it
-- upright, standing on the ground, facing the way the body was lying.
local function standUp(character: Model, humanoid: Humanoid, root: BasePart)
	local facing = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if facing.Magnitude < 0.2 then
		-- Lying on its back/front: the head direction is the best guess.
		facing = root.CFrame.UpVector * Vector3.new(1, 0, 1)
	end
	if facing.Magnitude < 0.01 then
		facing = Vector3.new(0, 0, -1)
	end

	local position = root.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local ground = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), params)
	if ground then
		local legLength = if humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else humanoid.HipHeight
		position = Vector3.new(position.X, ground.Position.Y + legLength + root.Size.Y / 2, position.Z)
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.lookAt(position, position + facing.Unit)
end

function Ragdoll.IsActive(character: Model): boolean
	return active[character] ~= nil
end

function Ragdoll.Enable(character: Model)
	if active[character] then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return
	end

	local record: Record = { created = {}, motors = {}, groups = {} }
	active[character] = record

	for _, joint in character:GetDescendants() do
		if joint:IsA("Motor6D") and not KEEP_JOINTS[joint.Name] and joint.Part0 and joint.Part1 then
			local a0 = Instance.new("Attachment")
			a0.Name = "RagdollAttachment"
			a0.CFrame = joint.C0
			a0.Parent = joint.Part0

			local a1 = Instance.new("Attachment")
			a1.Name = "RagdollAttachment"
			a1.CFrame = joint.C1
			a1.Parent = joint.Part1

			local socket = Instance.new("BallSocketConstraint")
			socket.Name = "RagdollSocket"
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.LimitsEnabled = true
			socket.UpperAngle = 70
			socket.TwistLimitsEnabled = true
			socket.TwistLowerAngle = -45
			socket.TwistUpperAngle = 45
			socket.Parent = joint.Parent

			joint.Enabled = false
			table.insert(record.motors, joint)
			table.insert(record.created, a0)
			table.insert(record.created, a1)
			table.insert(record.created, socket)
		end
	end

	-- Limbs normally don't collide, so give each one an invisible collider.
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") then
			record.groups[part] = part.CollisionGroup
			part.CollisionGroup = GROUP

			if part ~= root then
				local collider = Instance.new("Part")
				collider.Name = "RagdollCollider"
				collider.Size = part.Size * 0.85
				collider.CFrame = part.CFrame
				collider.Transparency = 1
				collider.Massless = true
				collider.CanQuery = false
				collider.CanTouch = false
				collider.CollisionGroup = GROUP

				local weld = Instance.new("WeldConstraint")
				weld.Part0 = part
				weld.Part1 = collider
				weld.Parent = collider

				collider.Parent = part
				table.insert(record.created, collider)
			end
		end
	end

	if Players:GetPlayerFromCharacter(character) then
		pcall(root.SetNetworkOwner, root, nil)
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	character:SetAttribute("Ragdolled", true)
end

function Ragdoll.Disable(character: Model)
	local record = active[character]
	if not record then
		return
	end
	active[character] = nil

	for _, instance in record.created do
		instance:Destroy()
	end
	for _, motor in record.motors do
		if motor.Parent then
			motor.Enabled = true
		end
	end
	for part, group in record.groups do
		if part.Parent then
			part.CollisionGroup = group
		end
	end
	character:SetAttribute("Ragdolled", false)

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if humanoid and humanoid.Health > 0 then
		if root then
			standUp(character, humanoid, root)
		end
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		local player = Players:GetPlayerFromCharacter(character)
		if player and root then
			pcall(root.SetNetworkOwner, root, player)
		end
	end
end

-- Drops bookkeeping for a character that was removed from the game.
function Ragdoll.Forget(character: Model)
	active[character] = nil
end

return Ragdoll
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="18">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="19">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client entry point.
]]

local StarterGui = game:GetService("StarterGui")

local CameraShake = require(script.CameraShake)
local HUD = require(script.HUD)
local Input = require(script.Input)
local Moves = require(script.Moves)
local VFX = require(script.VFX)

-- Our HUD replaces the default health bar.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

CameraShake.Start()
VFX.Start()
Moves.Start()
HUD.Start()
Input.Start()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CameraShake</string>
            <string name="Source"><![CDATA[--[[
	CameraShake
	Trauma-based shake: hits add trauma, trauma decays, and the shake is
	trauma squared so small hits stay subtle and big hits really kick.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local MAX_ANGLE = 4 -- degrees at full trauma (math.noise is roughly -0.5..0.5)
local DECAY = 1.8 -- trauma lost per second
local FREQUENCY = 25
local BASE_FOV = 70

local CameraShake = {}

local trauma = 0
local seed = math.random() * 1000

function CameraShake.Add(amount: number)
	trauma = math.clamp(trauma + amount, 0, 1)
end

-- Quick field-of-view punch for dashes and heavy hits.
function CameraShake.FovKick(amount: number)
	local camera = workspace.CurrentCamera
	camera.FieldOfView = BASE_FOV + amount
	TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		FieldOfView = BASE_FOV,
	}):Play()
end

function CameraShake.Start()
	Remotes.CameraShake.OnClientEvent:Connect(function(intensity)
		if type(intensity) == "number" then
			CameraShake.Add(intensity)
		end
	end)

	RunService:BindToRenderStep("CloverCameraShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if trauma <= 0 then
			return
		end
		trauma = math.max(0, trauma - dt * DECAY)
		local amount = trauma * trauma * MAX_ANGLE
		local t = os.clock() * FREQUENCY
		local camera = workspace.CurrentCamera
		camera.CFrame = camera.CFrame
			* CFrame.Angles(
				math.rad(math.noise(seed, t) * amount),
				math.rad(math.noise(seed + 10, t) * amount),
				math.rad(math.noise(seed + 20, t) * amount * 0.5)
			)
	end)
end

return CameraShake
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[
	HUD
	Health bar, Evasive bar, dash cooldown and combo counter. Built in code
	so it can be restyled later without touching Studio.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local localPlayer = Players.LocalPlayer

local COLORS = {
	Back = Color3.fromRGB(18, 18, 24),
	Health = Color3.fromRGB(90, 220, 110),
	HealthLow = Color3.fromRGB(230, 60, 60),
	Evasive = Color3.fromRGB(120, 235, 255),
	Text = Color3.fromRGB(240, 240, 240),
}

local COMBO_TIMEOUT = 1.6

local HUD = {}

local healthFill: Frame
local healthText: TextLabel
local evasiveFill: Frame
local evasiveStroke: UIStroke
local dashOverlay: Frame
local comboLabel: TextLabel
local comboScale: UIScale

local dashReadyAt = 0
local dashDuration = 1
local comboCount = 0
local lastComboHit = 0
local shownHealth = 1

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function bar(parent: Instance, name: string, position: UDim2, size: UDim2, color: Color3): (Frame, Frame)
	local back = Instance.new("Frame")
	back.Name = name
	back.Position = position
	back.Size = size
	back.BackgroundColor3 = COLORS.Back
	back.BackgroundTransparency = 0.15
	back.BorderSizePixel = 0
	back.Parent = parent
	corner(back, 6)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	corner(fill, 6)

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170))
	gradient.Rotation = 90
	gradient.Parent = fill

	return back, fill
end

local function build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "CombatHUD"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	local holder = Instance.new("Frame")
	holder.Name = "Bars"
	holder.AnchorPoint = Vector2.new(0.5, 1)
	holder.Position = UDim2.new(0.5, 0, 1, -24)
	holder.Size = UDim2.fromOffset(380, 44)
	holder.BackgroundTransparency = 1
	holder.Parent = gui

	local healthBack
	healthBack, healthFill = bar(holder, "Health", UDim2.fromOffset(52, 0), UDim2.new(1, -52, 0, 24), COLORS.Health)

	healthText = Instance.new("TextLabel")
	healthText.BackgroundTransparency = 1
	healthText.Size = UDim2.fromScale(1, 1)
	healthText.Font = Enum.Font.GothamBold
	healthText.TextSize = 14
	healthText.TextColor3 = COLORS.Text
	healthText.TextStrokeTransparency = 0.5
	healthText.ZIndex = 2
	healthText.Parent = healthBack

	local evasiveBack
	evasiveBack, evasiveFill =
		bar(holder, "Evasive", UDim2.fromOffset(52, 30), UDim2.new(1, -52, 0, 10), COLORS.Evasive)
	evasiveStroke = Instance.new("UIStroke")
	evasiveStroke.Color = COLORS.Evasive
	evasiveStroke.Thickness = 2
	evasiveStroke.Transparency = 1
	evasiveStroke.Parent = evasiveBack

	-- Dash icon: dark overlay shrinks as the cooldown finishes.
	local dash = Instance.new("Frame")
	dash.Name = "Dash"
	dash.Size = UDim2.fromOffset(44, 44)
	dash.BackgroundColor3 = COLORS.Back
	dash.BackgroundTransparency = 0.15
	dash.BorderSizePixel = 0
	dash.ClipsDescendants = true
	dash.Parent = holder
	corner(dash, 8)

	local dashLabel = Instance.new("TextLabel")
	dashLabel.BackgroundTransparency = 1
	dashLabel.Size = UDim2.fromScale(1, 1)
	dashLabel.Font = Enum.Font.GothamBlack
	dashLabel.Text = "Q"
	dashLabel.TextSize = 20
	dashLabel.TextColor3 = COLORS.Text
	dashLabel.ZIndex = 3
	dashLabel.Parent = dash

	dashOverlay = Instance.new("Frame")
	dashOverlay.AnchorPoint = Vector2.new(0, 1)
	dashOverlay.Position = UDim2.fromScale(0, 1)
	dashOverlay.Size = UDim2.fromScale(1, 0)
	dashOverlay.BackgroundColor3 = Color3.new(0, 0, 0)
	dashOverlay.BackgroundTransparency = 0.35
	dashOverlay.BorderSizePixel = 0
	dashOverlay.ZIndex = 2
	dashOverlay.Parent = dash

	comboLabel = Instance.new("TextLabel")
	comboLabel.Name = "Combo"
	comboLabel.AnchorPoint = Vector2.new(1, 0.5)
	comboLabel.Position = UDim2.new(1, -40, 0.45, 0)
	comboLabel.Size = UDim2.fromOffset(260, 70)
	comboLabel.BackgroundTransparency = 1
	comboLabel.Font = Enum.Font.GothamBlack
	comboLabel.TextScaled = true
	comboLabel.TextXAlignment = Enum.TextXAlignment.Right
	comboLabel.TextColor3 = Color3.new(1, 1, 1)
	comboLabel.TextStrokeTransparency = 0
	comboLabel.TextTransparency = 1
	comboLabel.TextStrokeTransparency = 1
	comboLabel.Rotation = -6
	comboLabel.Parent = gui

	comboScale = Instance.new("UIScale")
	comboScale.Parent = comboLabel
end

local function onHit(data)
	if type(data) ~= "table" or data.attacker == nil or data.attacker ~= localPlayer.Character then
		return
	end
	local t = os.clock()
	comboCount = if t - lastComboHit < COMBO_TIMEOUT then comboCount + 1 else 1
	lastComboHit = t

	comboLabel.Text = comboCount .. " HIT" .. (if comboCount == 1 then "" else "S")
	comboLabel.TextTransparency = 0
	comboLabel.TextStrokeTransparency = 0
	comboScale.Scale = 1.5
	TweenService:Create(comboScale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local function update(dt: number)
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
		shownHealth += (ratio - shownHealth) * math.min(dt * 12, 1)
		healthFill.Size = UDim2.fromScale(shownHealth, 1)
		healthFill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.Health, ratio)
		healthText.Text = string.format("%d / %d", math.ceil(humanoid.Health), humanoid.MaxHealth)

		local evasive = tonumber((character :: Model):GetAttribute("Evasive")) or 0
		local evasiveRatio = math.clamp(evasive / Config.Evasive.Max, 0, 1)
		evasiveFill.Size = UDim2.fromScale(evasiveRatio, 1)
		-- Pulse the outline when Evasive is ready.
		evasiveStroke.Transparency = if evasiveRatio >= 1 then 0.3 + 0.4 * math.sin(os.clock() * 8) else 1
	end

	local remaining = math.max(dashReadyAt - os.clock(), 0)
	dashOverlay.Size = UDim2.fromScale(1, remaining / dashDuration)

	if comboCount > 0 and os.clock() - lastComboHit > COMBO_TIMEOUT then
		comboCount = 0
		TweenService:Create(comboLabel, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end
end

function HUD.SetDashCooldown(duration: number)
	dashDuration = duration
	dashReadyAt = os.clock() + duration
end

function HUD.Start()
	build()
	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if name == "Hit" or name == "HeavyHit" then
			onHit(data)
		end
	end)
	RunService.RenderStepped:Connect(update)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--[[
	Input
	Keyboard / mouse / gamepad / touch controls.
	  M1 (click, hold to chain)   basic attack, hold Space on the 4th hit to uppercut
	  Q                           dash in your movement direction (Evasive when stunned)
	  F (hold)                    block, press right before a hit to perfect block
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CombatState = require(Shared.CombatState)
local Impulse = require(Shared.Impulse)
local Remotes = require(Shared.Remotes)

local CameraShake = require(script.Parent.CameraShake)
local HUD = require(script.Parent.HUD)
local Moves = require(script.Parent.Moves)
local VFX = require(script.Parent.VFX)

local localPlayer = Players.LocalPlayer

local DASH_VECTORS = {
	Front = Vector3.new(0, 0, -1),
	Back = Vector3.new(0, 0, 1),
	Left = Vector3.new(-1, 0, 0),
	Right = Vector3.new(1, 0, 0),
}

local BLOCK_RETRY = 0.12

local Input = {}

local m1Held = false
local blockHeld = false
local lastBlockSent = 0
local dashReadyAt = 0

-- Mirror of the server's combo counter so our animation plays instantly.
-- The server still decides what actually hits.
local predictedCombo = 0
local lastM1 = 0
local nextM1 = 0
-- Jumping is locked while swinging. The server enforces it too (JumpHeight 0),
-- but locking it here as well means there's no ping delay.
local noJumpUntil = 0
local jumpEnabled = true

local function getCharacter(): (Model?, Humanoid?, BasePart?)
	local character = localPlayer.Character
	if not character or not CombatState.IsAlive(character) then
		return nil, nil, nil
	end
	return character,
		character:FindFirstChildOfClass("Humanoid"),
		character:FindFirstChild("HumanoidRootPart") :: BasePart
end

-- Camera yaw only, so "forward" means where you're looking, flat on the ground.
local function cameraBasis(): CFrame
	local look = workspace.CurrentCamera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(Vector3.zero, flat.Unit)
end

local function dashDirection(humanoid: Humanoid): string
	local move = humanoid.MoveDirection
	if move.Magnitude < 0.1 then
		return "Front"
	end
	local relative = cameraBasis():VectorToObjectSpace(move)
	if math.abs(relative.X) > math.abs(relative.Z) then
		return if relative.X > 0 then "Right" else "Left"
	end
	return if relative.Z > 0 then "Back" else "Front"
end

local function jumpHeld(humanoid: Humanoid): boolean
	return UserInputService:IsKeyDown(Enum.KeyCode.Space)
		or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
		or humanoid.Jump
end

local function tryM1()
	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then
		return
	end
	if not CombatState.CanAct(character) or CombatState.IsBlocking(character) then
		return
	end
	local t = os.clock()
	if t < nextM1 then
		return
	end
	if t - lastM1 > Config.M1.ResetTime then
		predictedCombo = 0
	end
	predictedCombo += 1
	lastM1 = t

	local index = predictedCombo
	local jump = jumpHeld(humanoid)
	local variant = "Normal"
	if index >= Config.M1.ComboLength then
		predictedCombo = 0
		nextM1 = t + Config.M1.EndLag
		noJumpUntil = t + Config.M1.FinisherBusy
		if jump then
			variant = "Uppercut"
		elseif humanoid.FloorMaterial == Enum.Material.Air then
			variant = "Downslam"
		else
			variant = "Knockback"
		end
	else
		nextM1 = t + Config.M1.SwingCooldown
		noJumpUntil = t + Config.M1.Busy
	end

	Remotes.Action:FireServer("M1", { jump = jump })
	Moves.PlayM1(character, index, variant)

	-- Step into the swing a little so strings stay connected.
	local look = root.CFrame.LookVector
	local forward = Vector3.new(look.X, 0, look.Z).Unit
	Impulse.Apply(root, forward * Config.M1.LungeSpeed, Config.M1.LungeTime, "Lunge")
end

local function performDash(direction: string)
	local character, _, root = getCharacter()
	if not character or not root then
		return
	end
	local speed = Config.Dash.Speed[direction]
	local localVector = DASH_VECTORS[direction]
	local basis = cameraBasis()
	local mover = Impulse.Apply(root, basis:VectorToWorldSpace(localVector) * speed, Config.Dash.Duration, "Dash")

	-- Front dash steers with the camera, side and back dashes keep their line.
	local start = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not mover.Parent then
			connection:Disconnect()
			return
		end
		if direction == "Front" then
			basis = cameraBasis()
		end
		local alpha = (os.clock() - start) / Config.Dash.Duration
		mover.VectorVelocity = basis:VectorToWorldSpace(localVector) * speed * (1 - alpha * 0.4)
	end)

	VFX.Play("Dash", { character = character, direction = direction })
	CameraShake.FovKick(6)
end

local function tryDash()
	local character, humanoid = getCharacter()
	if not character or not humanoid then
		return
	end

	-- While stunned or ragdolled, Q is the Evasive breakout instead.
	if CombatState.IsStunned(character) or CombatState.IsRagdolled(character) then
		if (tonumber(character:GetAttribute("Evasive")) or 0) >= Config.Evasive.Max then
			Remotes.Action:FireServer("Evasive")
		end
		return
	end

	local t = os.clock()
	if t < dashReadyAt then
		return
	end
	dashReadyAt = t + Config.Dash.Cooldown
	HUD.SetDashCooldown(Config.Dash.Cooldown)

	local direction = dashDirection(humanoid)
	Remotes.Action:FireServer("Dash", direction)
	performDash(direction)
end

local function setBlock(held: boolean)
	blockHeld = held
	lastBlockSent = os.clock()
	Remotes.Action:FireServer("Block", held)
end

-- Server owns ragdoll physics, but the client's Humanoid state must match
-- or it fights the ragdoll / stays floppy after getting up.
local function onCharacterAdded(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	jumpEnabled = true
	character:GetAttributeChangedSignal("Ragdolled"):Connect(function()
		if character:GetAttribute("Ragdolled") then
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		else
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
	-- Don't let the default "fall over" states interrupt combat.
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
end

function Input.Start()
	ContextActionService:BindAction("CloverM1", function(_, state)
		if state == Enum.UserInputState.Begin then
			m1Held = true
			tryM1()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			m1Held = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

	ContextActionService:BindAction("CloverDash", function(_, state)
		if state == Enum.UserInputState.Begin then
			tryDash()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)

	ContextActionService:BindAction("CloverBlock", function(_, state)
		if state == Enum.UserInputState.Begin then
			setBlock(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			setBlock(false)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonL2)

	ContextActionService:SetTitle("CloverM1", "M1")
	ContextActionService:SetTitle("CloverDash", "Dash")
	ContextActionService:SetTitle("CloverBlock", "Block")

	RunService.Heartbeat:Connect(function()
		if m1Held then
			tryM1()
		end

		local character, humanoid = getCharacter()
		if character and humanoid then
			local canJump = os.clock() >= noJumpUntil
				and CombatState.CanAct(character)
				and not CombatState.IsBlocking(character)
				and not CombatState.IsBusy(character)
			if canJump ~= jumpEnabled then
				jumpEnabled = canJump
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, canJump)
			end
		end

		-- Holding F through a swing or stun: block as soon as it's allowed.
		if blockHeld and character and not CombatState.IsBlocking(character) then
			if os.clock() - lastBlockSent > BLOCK_RETRY then
				lastBlockSent = os.clock()
				Remotes.Action:FireServer("Block", true)
			end
		end
	end)

	Remotes.Impulse.OnClientEvent:Connect(function(velocity, duration)
		local _, _, root = getCharacter()
		if root and typeof(velocity) == "Vector3" and type(duration) == "number" then
			Impulse.Apply(root, velocity, math.clamp(duration, 0, 1), "Knockback")
		end
	end)

	localPlayer.CharacterAdded:Connect(onCharacterAdded)
	if localPlayer.Character then
		task.spawn(onCharacterAdded, localPlayer.Character)
	end
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">M1Animations</string>
            <string name="Source"><![CDATA[--[[
	M1Animations
	R6 punch/kick animations for the M1 string, built for PoseAnimator.

	The string is: right jab, left cross, right hook, then a finisher:
	  Knockback  spinning front kick
	  Uppercut   rising right uppercut (jump held)
	  Downslam   double-fist hammer (in the air)

	Timing lines up with the server: normal hits land ~0.08s after input
	(Config.M1.WindUp), finishers ~0.15s (Config.M1.FinisherWindUp).
	The "Strike" event is when the limb starts moving fast (trails turn on).
]]

local PoseAnimator = require(script.Parent.PoseAnimator)

type Animation = PoseAnimator.Animation

local rad = math.rad

-- Torso / head / leg rotation. x leans back (+) or forward (-), y twists left (+).
local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

-- Arm/leg aim. pitch raises the limb forward (90 = straight ahead, 180 = up),
-- yaw swings it horizontally (+ = toward the left), roll swings it out sideways
-- (+ = to the right).
local function limb(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, rad(yaw or 0), 0) * CFrame.Angles(0, 0, rad(roll or 0)) * CFrame.Angles(rad(pitch), 0, 0)
end

-- The legs twist against the torso so the feet stay planted. They're
-- additive, so walking still plays underneath.
local LEGS_ADDITIVE = { RightLeg = true, LeftLeg = true }

local Clips: { [string]: Animation } = {}

local M1Animations = {}
M1Animations.Clips = Clips

Clips.Jab = {
	fadeIn = 0.03,
	fadeOut = 0.16,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.04, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -6),
				RightArm = limb(60, 20),
				LeftArm = limb(75, -25),
				RightLeg = rot(0, 6),
				LeftLeg = rot(0, 6),
			},
		},
		{
			time = 0.04,
			pose = {
				Torso = rot(0, -16),
				RightArm = limb(45, 10),
				LeftArm = limb(80, -28),
				Head = rot(0, 14),
				RightLeg = rot(0, 16),
				LeftLeg = rot(0, 16),
			},
		},
		{
			time = 0.1,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-5, 22),
				RightArm = limb(94, 12),
				LeftArm = limb(62, -30),
				Head = rot(0, -18),
				RightLeg = rot(0, -22),
				LeftLeg = rot(0, -22),
			},
		},
		{
			time = 0.2,
			pose = {
				Torso = rot(-4, 18),
				RightArm = limb(90, 12),
				LeftArm = limb(62, -30),
				Head = rot(0, -15),
				RightLeg = rot(0, -18),
				LeftLeg = rot(0, -18),
			},
		},
	},
}

Clips.Cross = {
	fadeIn = 0.03,
	fadeOut = 0.16,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.04, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, 10),
				RightArm = limb(80, 28),
				LeftArm = limb(60, -18),
				RightLeg = rot(0, -10),
				LeftLeg = rot(0, -10),
			},
		},
		{
			time = 0.04,
			pose = {
				Torso = rot(0, 18),
				RightArm = limb(80, 28),
				LeftArm = limb(42, -10),
				Head = rot(0, -14),
				RightLeg = rot(0, -18),
				LeftLeg = rot(0, -18),
			},
		},
		{
			time = 0.1,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-6, -24),
				RightArm = limb(62, 30),
				LeftArm = limb(94, -12),
				Head = rot(0, 20),
				RightLeg = rot(0, 24),
				LeftLeg = rot(0, 24),
			},
		},
		{
			time = 0.2,
			pose = {
				Torso = rot(-5, -20),
				RightArm = limb(62, 30),
				LeftArm = limb(90, -12),
				Head = rot(0, 16),
				RightLeg = rot(0, 20),
				LeftLeg = rot(0, 20),
			},
		},
	},
}

Clips.Hook = {
	fadeIn = 0.03,
	fadeOut = 0.18,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.05, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -10),
				RightArm = limb(70, -10),
				LeftArm = limb(75, -25),
				RightLeg = rot(0, 10),
				LeftLeg = rot(0, 10),
			},
		},
		{
			-- Arm swings out wide to the right.
			time = 0.05,
			pose = {
				Torso = rot(0, -28),
				RightArm = limb(75, -55),
				LeftArm = limb(80, -28),
				Head = rot(0, 22),
				RightLeg = rot(0, 26),
				LeftLeg = rot(0, 26),
			},
		},
		{
			-- ...and sweeps across the body.
			time = 0.12,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-7, 32),
				RightArm = limb(88, 40),
				LeftArm = limb(65, -30),
				Head = rot(0, -26),
				RightLeg = rot(0, -30),
				LeftLeg = rot(0, -30),
			},
		},
		{
			time = 0.22,
			pose = {
				Torso = rot(-6, 28),
				RightArm = limb(85, 38),
				LeftArm = limb(65, -30),
				Head = rot(0, -22),
				RightLeg = rot(0, -26),
				LeftLeg = rot(0, -26),
			},
		},
	},
}

-- Knockback finisher: chambered front kick. Legs are fully posed here.
Clips.Kick = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -8),
				RightArm = limb(70, 20),
				LeftArm = limb(75, -25),
			},
		},
		{
			-- Chamber: knee comes back, body coils.
			time = 0.09,
			pose = {
				Torso = rot(8, -14),
				RightArm = limb(25, 0, 25),
				LeftArm = limb(60, -20),
				Head = rot(-6, 10),
				RightLeg = rot(-30),
				LeftLeg = rot(5),
			},
		},
		{
			-- Snap the leg straight out.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(20, 16),
				RightArm = limb(-20, 0, 45),
				LeftArm = limb(10, 0, -70),
				Head = rot(-18, -12),
				RightLeg = rot(98),
				LeftLeg = rot(-20), -- cancels the torso lean so the standing leg stays vertical
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(18, 14),
				RightArm = limb(-15, 0, 40),
				LeftArm = limb(10, 0, -65),
				Head = rot(-16, -10),
				RightLeg = rot(92),
				LeftLeg = rot(-18),
			},
		},
	},
}

Clips.Uppercut = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -8),
				RightArm = limb(60, 15),
				LeftArm = limb(75, -25),
			},
		},
		{
			-- Dip down and load the right arm low.
			time = 0.09,
			pose = {
				Torso = rot(-18, -18),
				RightArm = limb(-25, 5),
				LeftArm = limb(80, -28),
				Head = rot(12, 12),
				RightLeg = rot(-8, 18),
				LeftLeg = rot(15, 18),
			},
		},
		{
			-- Rip upward.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(14, 22),
				RightArm = limb(168, 10),
				LeftArm = limb(35, -20),
				Head = rot(-20, -16),
				RightLeg = rot(0, -20),
				LeftLeg = rot(0, -20),
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(12, 18),
				RightArm = limb(165, 10),
				LeftArm = limb(35, -20),
				Head = rot(-18, -14),
				RightLeg = rot(0, -16),
				LeftLeg = rot(0, -16),
			},
		},
	},
}

Clips.Downslam = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0),
				RightArm = limb(80, 10),
				LeftArm = limb(80, -10),
			},
		},
		{
			-- Both fists raised overhead, body arched back.
			time = 0.09,
			pose = {
				Torso = rot(18),
				RightArm = limb(172, 12),
				LeftArm = limb(172, -12),
				Head = rot(-15),
				RightLeg = rot(-20),
				LeftLeg = rot(10),
			},
		},
		{
			-- Hammer down.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-32),
				RightArm = limb(45, 15),
				LeftArm = limb(45, -15),
				Head = rot(18),
				RightLeg = rot(30),
				LeftLeg = rot(20),
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(-28),
				RightArm = limb(50, 15),
				LeftArm = limb(50, -15),
				Head = rot(15),
				RightLeg = rot(25),
				LeftLeg = rot(18),
			},
		},
	},
}

-- Which limbs leave a trail on each move.
M1Animations.Strikers = {
	Jab = { "Right Arm" },
	Cross = { "Left Arm" },
	Hook = { "Right Arm" },
	Kick = { "Right Leg" },
	Uppercut = { "Right Arm" },
	Downslam = { "Right Arm", "Left Arm" },
}

local STRING = { "Jab", "Cross", "Hook" }
local FINISHERS = { Knockback = "Kick", Uppercut = "Uppercut", Downslam = "Downslam" }

-- Animation name for combo hit `index` with finisher `variant`.
function M1Animations.NameFor(index: number, variant: string): string
	if variant ~= "Normal" then
		return FINISHERS[variant] or "Kick"
	end
	return STRING[((index - 1) % #STRING) + 1]
end

return M1Animations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Moves</string>
            <string name="Source"><![CDATA[--[[
	Moves
	Plays move animations + their VFX on characters.

	Your own swings play instantly when you click (predicted by Input), so
	they feel responsive at any ping. Everyone else's play when the server's
	"Swing" event arrives.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local M1Animations = require(script.Parent.M1Animations)
local PoseAnimator = require(script.Parent.PoseAnimator)
local VFX = require(script.Parent.VFX)

local localPlayer = Players.LocalPlayer

local TRAIL_TIME = 0.14

local Moves = {}

function Moves.PlayM1(character: Model, index: number, variant: string)
	local name = M1Animations.NameFor(index, variant)
	local animation = M1Animations.Clips[name]
	if not animation then
		return
	end
	local heavy = variant ~= "Normal"
	local strikers = M1Animations.Strikers[name] or {}

	PoseAnimator.Play(character, animation, function(event)
		if event == "Strike" then
			for _, limbName in strikers do
				VFX.LimbTrail(character, limbName, if heavy then TRAIL_TIME * 1.5 else TRAIL_TIME)
			end
			VFX.AirPop(character, heavy)
		end
	end)
end

function Moves.Start()
	PoseAnimator.Start()

	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if name ~= "Swing" or type(data) ~= "table" then
			return
		end
		local character = data.character
		-- Our own swing already played the moment we clicked.
		if typeof(character) ~= "Instance" or character == localPlayer.Character then
			return
		end
		Moves.PlayM1(character :: Model, data.index or 1, data.variant or "Normal")
	end)
end

return Moves
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PoseAnimator</string>
            <string name="Source"><![CDATA[--[[
	PoseAnimator
	Keyframe animations defined in code, played by overriding Motor6D.Transform
	every frame. No uploaded animation assets needed, so they work in any place
	without animation permissions.

	Runs on every client for every character: the server tells clients
	"this character swung", each client animates it locally.

	Poses rotate a limb around its joint in the PARENT part's space:
	  Torso       RootJoint, relative to HumanoidRootPart
	  Head        Neck, relative to Torso
	  RightArm    Right Shoulder, relative to Torso
	  LeftArm     Left Shoulder
	  RightLeg    Right Hip
	  LeftLeg     Left Hip
	Axes: X = right, Y = up, Z = back. So for a limb hanging down,
	  +X rotation swings it forward, +Y turns it to the left,
	  +Z swings it out to the right. For the Torso, +X leans back.
]]

local RunService = game:GetService("RunService")

export type Pose = { [string]: CFrame }

export type Keyframe = {
	time: number,
	pose: Pose,
	easing: Enum.EasingStyle?, -- easing INTO this keyframe
}

export type Animation = {
	keyframes: { Keyframe },
	fadeIn: number?,
	fadeOut: number?,
	-- Joints whose pose is layered on top of the default walk/idle animation
	-- instead of replacing it (e.g. legs counter-twisting while still walking).
	additive: { [string]: boolean }?,
	events: { { time: number, name: string } }?,
}

local JOINTS = {
	Torso = "RootJoint",
	Head = "Neck",
	RightArm = "Right Shoulder",
	LeftArm = "Left Shoulder",
	RightLeg = "Right Hip",
	LeftLeg = "Left Hip",
}

type Track = {
	animation: Animation,
	joints: { [string]: Motor6D },
	start: number,
	length: number,
	onEvent: ((name: string) -> ())?,
	firedEvents: { [number]: boolean },
}

local tracks: { [Model]: Track } = {}
-- What we wrote to each joint last frame. If the default Animator didn't
-- overwrite it, the joint has no base animation and its base is identity.
local lastWritten: { [Motor6D]: CFrame } = {}

local PoseAnimator = {}

local function findJoints(character: Model): { [string]: Motor6D }
	local found = {}
	for poseName, jointName in JOINTS do
		local joint = character:FindFirstChild(jointName, true)
		if joint and joint:IsA("Motor6D") then
			found[poseName] = joint
		end
	end
	return found
end

local function ease(alpha: number, style: Enum.EasingStyle?): number
	if style == Enum.EasingStyle.Linear then
		return alpha
	elseif style == Enum.EasingStyle.Back then
		local c1 = 1.70158
		local c3 = c1 + 1
		return 1 + c3 * (alpha - 1) ^ 3 + c1 * (alpha - 1) ^ 2
	elseif style == Enum.EasingStyle.Sine then
		return math.sin(alpha * math.pi / 2)
	end
	return 1 - (1 - alpha) * (1 - alpha) -- Quad out
end

-- The animation's pose for one joint at time t (identity if never posed).
local function sample(animation: Animation, poseName: string, t: number): CFrame
	local keyframes = animation.keyframes
	local previous = keyframes[1]
	if t <= previous.time then
		return previous.pose[poseName] or CFrame.identity
	end
	for i = 2, #keyframes do
		local nextFrame = keyframes[i]
		if t <= nextFrame.time then
			local span = nextFrame.time - previous.time
			local alpha = if span > 0 then (t - previous.time) / span else 1
			local from = previous.pose[poseName] or CFrame.identity
			local to = nextFrame.pose[poseName] or CFrame.identity
			return from:Lerp(to, ease(alpha, nextFrame.easing))
		end
		previous = nextFrame
	end
	return previous.pose[poseName] or CFrame.identity
end

local function posedJoints(animation: Animation): { [string]: boolean }
	local set = {}
	for _, keyframe in animation.keyframes do
		for poseName in keyframe.pose do
			set[poseName] = true
		end
	end
	return set
end

local function release(track: Track)
	-- Hand the joints back; the default Animator overwrites them next frame
	-- if it's animating them.
	for _, joint in track.joints do
		if lastWritten[joint] then
			lastWritten[joint] = nil
			if joint.Parent then
				joint.Transform = CFrame.identity
			end
		end
	end
end

local function step()
	local now = os.clock()
	for character, track in tracks do
		local elapsed = now - track.start
		local animation = track.animation
		local fadeIn = animation.fadeIn or 0.04
		local fadeOut = animation.fadeOut or 0.15
		local total = track.length + fadeOut

		local dead = not character.Parent or character:GetAttribute("Ragdolled") == true
		if dead or elapsed >= total then
			tracks[character] = nil
			release(track)
			continue
		end

		if animation.events and track.onEvent then
			for index, event in animation.events do
				if not track.firedEvents[index] and elapsed >= event.time then
					track.firedEvents[index] = true
					task.spawn(track.onEvent, event.name)
				end
			end
		end

		local weight = 1
		if elapsed < fadeIn then
			weight = elapsed / fadeIn
		elseif elapsed > track.length then
			weight = 1 - (elapsed - track.length) / fadeOut
		end

		local additive = animation.additive or {}
		for poseName, joint in track.joints do
			local current = joint.Transform
			local base = if lastWritten[joint] == current then CFrame.identity else current
			-- Convert from parent-part space into the joint's own space.
			local c0 = joint.C0.Rotation
			local local_ = c0:Inverse() * sample(animation, poseName, elapsed) * c0
			local target = if additive[poseName] then base * local_ else local_
			local final = base:Lerp(target, weight)
			joint.Transform = final
			lastWritten[joint] = final
		end
	end
end

-- Plays `animation` on `character`, replacing whatever this module was playing on it.
function PoseAnimator.Play(character: Model, animation: Animation, onEvent: ((name: string) -> ())?)
	local existing = tracks[character]
	if existing then
		tracks[character] = nil
		release(existing)
	end

	local posed = posedJoints(animation)
	local all = findJoints(character)
	local joints = {}
	for poseName, joint in all do
		if posed[poseName] then
			joints[poseName] = joint
		end
	end
	if next(joints) == nil then
		return -- not an R6 rig
	end

	local keyframes = animation.keyframes
	tracks[character] = {
		animation = animation,
		joints = joints,
		start = os.clock(),
		length = keyframes[#keyframes].time,
		onEvent = onEvent,
		firedEvents = {},
	}
end

function PoseAnimator.Stop(character: Model)
	local track = tracks[character]
	if track then
		tracks[character] = nil
		release(track)
	end
end

function PoseAnimator.Start()
	-- PreSimulation runs after the default Animator has written its pose, so
	-- whatever we set here is what gets rendered.
	RunService.PreSimulation:Connect(step)
end

return PoseAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">VFX</string>
            <string name="Source"><![CDATA[--[[
	VFX
	Every visual effect is drawn on the client. The server only sends
	("EffectName", data), so effects cost no server performance and stay
	smooth regardless of ping. Built entirely from parts, beams, particles
	and lights using textures that ship with Roblox, so no uploads needed.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)
local CameraShake = require(script.Parent.CameraShake)

local TEXTURES = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}

local COLORS = {
	Swing = Color3.fromRGB(255, 255, 255),
	Hit = Color3.fromRGB(255, 236, 190),
	Heavy = Color3.fromRGB(255, 120, 60),
	Block = Color3.fromRGB(110, 170, 255),
	Parry = Color3.fromRGB(120, 255, 255),
	GuardBreak = Color3.fromRGB(255, 170, 60),
	Dash = Color3.fromRGB(200, 225, 255),
	Evasive = Color3.fromRGB(235, 255, 255),
	Dust = Color3.fromRGB(150, 145, 135),
}

local localPlayer = Players.LocalPlayer

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = workspace

local VFX = {}
local Effects: { [string]: (data: any) -> () } = {}

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------

local function newPart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = fxFolder
	return part
end

local function tween(
	instance: Instance,
	duration: number,
	goals: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, goals)
	t:Play()
	return t
end

local function randomUnit(): Vector3
	local v = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
	return if v.Magnitude > 1e-3 then v.Unit else Vector3.yAxis
end

local function randomAngles(): CFrame
	return CFrame.Angles(math.random() * math.pi * 2, math.random() * math.pi * 2, math.random() * math.pi * 2)
end

local function getRoot(character: Model?): BasePart?
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function isLocal(character: Model?): boolean
	return character ~= nil and character == localPlayer.Character
end

local function groundBelow(position: Vector3, ignore: { Instance }?): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter: { Instance } = { fxFolder }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(filter, player.Character)
		end
	end
	local dummies = workspace:FindFirstChild("Dummies")
	if dummies then
		table.insert(filter, dummies)
	end
	if ignore then
		for _, instance in ignore do
			table.insert(filter, instance)
		end
	end
	params.FilterDescendantsInstances = filter
	return workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params)
end

type BurstOptions = {
	texture: string?,
	color: Color3?,
	count: number?,
	size: number?,
	speed: NumberRange?,
	lifetime: NumberRange?,
	lightEmission: number?,
	transparency: number?,
	drag: number?,
	acceleration: Vector3?,
	spread: number?,
	streaks: boolean?,
	direction: Vector3?, -- aim the spread cone this way (default: straight up)
}

-- One-shot particle burst at a point.
local function burst(position: Vector3, options: BurstOptions)
	local cframe = if options.direction
		then CFrame.lookAt(position, position + options.direction)
		else CFrame.new(position)
	local holder = newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = cframe })
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder

	local lifetime = options.lifetime or NumberRange.new(0.15, 0.35)
	local size = options.size or 1

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = options.texture or TEXTURES.Spark
	emitter.Color = ColorSequence.new(options.color or COLORS.Hit)
	emitter.LightEmission = options.lightEmission or 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(options.transparency or 0, 1)
	emitter.Lifetime = lifetime
	emitter.Speed = options.speed or NumberRange.new(20, 40)
	emitter.SpreadAngle = Vector2.one * (options.spread or 180)
	emitter.Drag = options.drag or 5
	emitter.Acceleration = options.acceleration or Vector3.zero
	if options.direction then
		emitter.EmissionDirection = Enum.NormalId.Front
	end
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	if options.streaks then
		-- Stretch along travel direction for speed-line sparks.
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		emitter.Squash = NumberSequence.new(1.5)
	end
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(options.count or 12)

	Debris:AddItem(holder, lifetime.Max + 0.5)
end

-- Expanding glowing ball.
local function flash(position: Vector3, color: Color3, size: number, duration: number)
	local ball = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size * 0.3,
		CFrame = CFrame.new(position),
		Color = color,
		Transparency = 0.1,
	})
	tween(ball, duration, { Size = Vector3.one * size, Transparency = 1 })
	Debris:AddItem(ball, duration + 0.05)
end

-- Ring of thin neon segments expanding outward in the cframe's XZ plane.
local function ringBurst(
	cframe: CFrame,
	color: Color3,
	startRadius: number,
	endRadius: number,
	duration: number,
	thickness: number?
)
	local segments = 16
	local width = thickness or 0.2
	for i = 1, segments do
		local spin = CFrame.Angles(0, (i / segments) * math.pi * 2, 0)
		local startLength = (2 * math.pi * startRadius / segments) * 1.15
		local endLength = (2 * math.pi * endRadius / segments) * 1.15
		local segment = newPart({
			Size = Vector3.new(startLength, width, width),
			CFrame = cframe * spin * CFrame.new(0, 0, -startRadius),
			Color = color,
			Transparency = 0.05,
		})
		tween(segment, duration, {
			Size = Vector3.new(endLength, width * 0.2, width * 0.2),
			CFrame = cframe * spin * CFrame.new(0, 0, -endRadius),
			Transparency = 1,
		})
		Debris:AddItem(segment, duration + 0.05)
	end
end

-- A ring facing along `direction`, for impacts.
local function impactRing(position: Vector3, direction: Vector3, color: Color3, startRadius, endRadius, duration)
	local cframe = CFrame.lookAt(position, position + direction) * CFrame.Angles(math.rad(90), 0, 0)
	ringBurst(cframe, color, startRadius, endRadius, duration, 0.18)
end

local function light(position: Vector3, color: Color3, brightness: number, range: number, duration: number)
	local holder = newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(position) })
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Brightness = brightness
	pointLight.Range = range
	pointLight.Shadows = false
	pointLight.Parent = holder
	tween(pointLight, duration, { Brightness = 0 })
	Debris:AddItem(holder, duration + 0.05)
end

-- Body glow on hit.
local function highlight(character: Model?, color: Color3, duration: number)
	if not character then
		return
	end
	local h = Instance.new("Highlight")
	h.Adornee = character
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = 0.15
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = fxFolder
	tween(h, duration, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(h, duration + 0.05)
end

-- Neon ghost copy of a character that fades out.
local function afterimage(character: Model, color: Color3, duration: number)
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local ghost = part:Clone()
			if ghost then
				for _, child in ghost:GetChildren() do
					if not child:IsA("DataModelMesh") then
						child:Destroy()
					end
				end
				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanQuery = false
				ghost.CanTouch = false
				ghost.CastShadow = false
				ghost.Massless = true
				ghost.Material = Enum.Material.Neon
				ghost.Color = color
				ghost.Transparency = 0.35
				if ghost:IsA("MeshPart") then
					ghost.TextureID = ""
				end
				ghost.Parent = fxFolder
				tween(ghost, duration, { Transparency = 1 })
				Debris:AddItem(ghost, duration + 0.05)
			end
		end
	end
end

-- Wind trail streaming off a flying character.
local function bodyTrail(character: Model?, color: Color3, duration: number)
	local root = getRoot(character)
	if not root then
		return
	end
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, 1.2, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -1.2, 0)
	bottom.Parent = root

	local trail = Instance.new("Trail")
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(color)
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Lifetime = 0.25
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.FaceCamera = true
	trail.Parent = root

	task.delay(duration, function()
		trail.Enabled = false
		task.wait(trail.Lifetime)
		trail:Destroy()
		top:Destroy()
		bottom:Destroy()
	end)
end

-- Flying shards (unanchored, local physics only).
local function shards(position: Vector3, color: Color3, count: number)
	for _ = 1, count do
		local shard = newPart({
			Size = Vector3.new(0.25, 0.6 + math.random() * 0.6, 0.08),
			CFrame = CFrame.new(position) * randomAngles(),
			Color = color,
			Material = Enum.Material.Glass,
			Transparency = 0.1,
		})
		shard.Anchored = false
		shard.AssemblyLinearVelocity = randomUnit() * (20 + math.random() * 15) + Vector3.new(0, 15, 0)
		shard.AssemblyAngularVelocity = randomUnit() * 20
		tween(shard, 0.6, { Transparency = 1, Size = shard.Size * 0.3 })
		Debris:AddItem(shard, 0.65)
	end
end

-- Rocks bursting up from the ground in a ring, plus dust.
local function groundRocks(position: Vector3, count: number, radius: number, maxSize: number)
	local ground = groundBelow(position)
	if not ground then
		return
	end
	local hitPart = ground.Instance
	local color = if hitPart:IsA("BasePart") then hitPart.Color else COLORS.Dust
	local material = ground.Material

	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.3
		local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (radius + math.random() * 1.5)
		local size = maxSize * (0.5 + math.random() * 0.5)
		local resting = CFrame.new(ground.Position + offset)
			* CFrame.Angles(math.random() * 0.8, math.random() * math.pi, math.random() * 0.8)
		local rock = newPart({
			Size = Vector3.one * size,
			CFrame = resting - Vector3.new(0, size, 0),
			Color = color,
			Material = material,
		})
		rock.CastShadow = true
		tween(rock, 0.15, { CFrame = resting }, Enum.EasingStyle.Back)
		task.delay(1.6 + math.random() * 0.4, function()
			tween(
				rock,
				0.5,
				{ CFrame = resting - Vector3.new(0, size * 1.2, 0) },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
		end)
		Debris:AddItem(rock, 2.6)
	end

	burst(ground.Position, {
		texture = TEXTURES.Smoke,
		color = color:Lerp(Color3.new(1, 1, 1), 0.3),
		count = 14,
		size = 4,
		speed = NumberRange.new(8, 18),
		lifetime = NumberRange.new(0.6, 1.2),
		lightEmission = 0,
		transparency = 0.4,
		drag = 3,
		spread = 80,
	})
end

-- "PERFECT", damage numbers, etc.
local function popup(position: Vector3, text: string, color: Color3, scale: number?)
	local holder = newPart({
		Size = Vector3.one * 0.2,
		Transparency = 1,
		CFrame = CFrame.new(position + Vector3.new((math.random() - 0.5) * 2, 1, (math.random() - 0.5) * 2)),
	})

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160 * (scale or 1), 48 * (scale or 1))
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Parent = holder

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui

	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1.7
	uiScale.Parent = label
	tween(uiScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

	tween(holder, 0.9, { CFrame = holder.CFrame + Vector3.new(0, 2.5, 0) })
	task.delay(0.45, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(holder, 0.95)
end

local function screenFlash(color: Color3, duration: number)
	local correction = Instance.new("ColorCorrectionEffect")
	correction.TintColor = color
	correction.Brightness = 0.2
	correction.Parent = workspace.CurrentCamera
	tween(correction, duration, { TintColor = Color3.new(1, 1, 1), Brightness = 0 })
	Debris:AddItem(correction, duration + 0.05)
end

---------------------------------------------------------------------------
-- Effects (names match what the server sends)
---------------------------------------------------------------------------

function Effects.Hit(data)
	local position: Vector3 = data.position
	local direction: Vector3 = data.direction or Vector3.zAxis

	burst(position, {
		color = COLORS.Hit,
		count = 10,
		size = 0.9,
		speed = NumberRange.new(20, 38),
		streaks = true,
	})
	flash(position, Color3.new(1, 1, 1), 3.2, 0.12)
	impactRing(position, direction, Color3.new(1, 1, 1), 0.5, 2.8, 0.18)
	light(position, COLORS.Hit, 4, 10, 0.15)
	highlight(data.victim, Color3.new(1, 1, 1), 0.15)
	if data.damage then
		popup(position, string.format("%g", data.damage), Color3.new(1, 1, 1))
	end
end

function Effects.HeavyHit(data)
	local position: Vector3 = data.position
	local direction: Vector3 = data.direction or Vector3.zAxis

	burst(position, {
		color = COLORS.Heavy,
		count = 22,
		size = 1.4,
		speed = NumberRange.new(30, 60),
		lifetime = NumberRange.new(0.2, 0.45),
		streaks = true,
	})
	burst(position, {
		color = Color3.new(1, 1, 1),
		count = 8,
		size = 2,
		speed = NumberRange.new(5, 12),
	})
	flash(position, Color3.new(1, 1, 1), 6.5, 0.18)
	impactRing(position, direction, COLORS.Heavy, 0.8, 5.5, 0.25)
	task.delay(0.06, impactRing, position, direction, Color3.new(1, 1, 1), 0.5, 4, 0.22)
	light(position, COLORS.Heavy, 8, 18, 0.3)
	highlight(data.victim, COLORS.Heavy, 0.25)
	if data.damage then
		popup(position, string.format("%g", data.damage), COLORS.Heavy, 1.3)
	end

	if data.variant == "Knockback" or data.variant == "Uppercut" then
		bodyTrail(data.victim, Color3.new(1, 1, 1), 0.6)
	end
	if isLocal(data.attacker) or isLocal(data.victim) then
		CameraShake.FovKick(8)
	end
end

function Effects.Block(data)
	local position: Vector3 = data.position
	local root = getRoot(data.victim)

	burst(position, {
		color = COLORS.Block,
		count = 8,
		size = 0.7,
		speed = NumberRange.new(12, 25),
	})
	if root then
		local shield = newPart({
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.ForceField,
			Color = COLORS.Block,
			Size = Vector3.one * 5,
			CFrame = root.CFrame,
		})
		tween(shield, 0.25, { Size = Vector3.one * 6.5, Transparency = 1 })
		Debris:AddItem(shield, 0.3)
	end
	highlight(data.victim, COLORS.Block, 0.12)
end

function Effects.PerfectBlock(data)
	local position: Vector3 = data.position
	local victimRoot = getRoot(data.victim)
	local direction = if victimRoot then victimRoot.CFrame.LookVector else Vector3.zAxis

	flash(position, COLORS.Parry, 8, 0.25)
	impactRing(position, direction, COLORS.Parry, 1, 7, 0.3)
	task.delay(0.08, impactRing, position, direction, Color3.new(1, 1, 1), 0.6, 5, 0.25)
	burst(position, {
		color = COLORS.Parry,
		count = 24,
		size = 1.2,
		speed = NumberRange.new(25, 50),
		streaks = true,
	})
	light(position, COLORS.Parry, 10, 20, 0.35)
	highlight(data.victim, COLORS.Parry, 0.3)
	highlight(data.attacker, Color3.fromRGB(255, 60, 60), 0.4)
	popup(position + Vector3.new(0, 2, 0), "PERFECT", COLORS.Parry, 1.4)

	if isLocal(data.attacker) or isLocal(data.victim) then
		screenFlash(COLORS.Parry, 0.3)
		CameraShake.FovKick(-6)
	end
end

function Effects.GuardBreak(data)
	local position: Vector3 = data.position
	shards(position, COLORS.Block, 14)
	flash(position, COLORS.GuardBreak, 6, 0.2)
	burst(position, {
		color = COLORS.GuardBreak,
		count = 16,
		size = 1.1,
		speed = NumberRange.new(25, 45),
		streaks = true,
	})
	light(position, COLORS.GuardBreak, 8, 16, 0.3)
	highlight(data.victim, COLORS.GuardBreak, 0.35)
	popup(position + Vector3.new(0, 2, 0), "GUARD BREAK", COLORS.GuardBreak, 1.5)
end

function Effects.Dash(data)
	local character: Model? = data.character
	local root = getRoot(character)
	if not character or not root then
		return
	end

	afterimage(character, COLORS.Dash, 0.35)
	for i = 1, 2 do
		task.delay(i * 0.06, function()
			if character.Parent then
				afterimage(character, COLORS.Dash, 0.3)
			end
		end)
	end

	local ground = groundBelow(root.Position, { character })
	if ground then
		burst(ground.Position, {
			texture = TEXTURES.Smoke,
			color = COLORS.Dust,
			count = 6,
			size = 2.5,
			speed = NumberRange.new(4, 10),
			lifetime = NumberRange.new(0.4, 0.7),
			lightEmission = 0,
			transparency = 0.5,
			spread = 70,
		})
		ringBurst(CFrame.new(ground.Position + Vector3.new(0, 0.1, 0)), COLORS.Dash, 0.6, 3.5, 0.25, 0.12)
	end
end

function Effects.Evasive(data)
	local character: Model? = data.character
	local root = getRoot(character)
	if not character or not root then
		return
	end
	afterimage(character, COLORS.Evasive, 0.5)
	flash(root.Position, COLORS.Evasive, 7, 0.25)
	ringBurst(CFrame.new(root.Position), COLORS.Evasive, 1, 8, 0.35, 0.25)
	burst(root.Position, {
		color = COLORS.Evasive,
		count = 20,
		size = 1,
		speed = NumberRange.new(20, 40),
		streaks = true,
	})
	popup(root.Position + Vector3.new(0, 3, 0), "EVASIVE", COLORS.Evasive, 1.2)
	if isLocal(character) then
		screenFlash(COLORS.Evasive, 0.25)
	end
end

function Effects.Crater(data)
	local position: Vector3 = data.position
	groundRocks(position, 12, 4, 2.2)
	ringBurst(CFrame.new(position + Vector3.new(0, 0.2, 0)), Color3.new(1, 1, 1), 1, 10, 0.35, 0.3)
	flash(position, COLORS.Heavy, 6, 0.2)
	light(position, COLORS.Heavy, 6, 20, 0.35)

	-- Anyone nearby feels the slam.
	local myRoot = getRoot(localPlayer.Character)
	if myRoot then
		local distance = (myRoot.Position - position).Magnitude
		if distance < 40 then
			CameraShake.Add(0.35 * (1 - distance / 40))
		end
	end
end

---------------------------------------------------------------------------

---------------------------------------------------------------------------
-- Public helpers used by the move animations
---------------------------------------------------------------------------

-- Streak behind a striking limb (fist or foot) for `duration` seconds.
function VFX.LimbTrail(character: Model, limbName: string, duration: number, color: Color3?)
	local limbPart = character:FindFirstChild(limbName)
	if not limbPart or not limbPart:IsA("BasePart") then
		return
	end
	-- Two points near the end of the limb (R6 limbs are 2 studs long).
	local tip = Instance.new("Attachment")
	tip.Position = Vector3.new(0, -1.1, 0)
	tip.Parent = limbPart
	local mid = Instance.new("Attachment")
	mid.Position = Vector3.new(0, -0.3, 0)
	mid.Parent = limbPart

	local trail = Instance.new("Trail")
	trail.Attachment0 = tip
	trail.Attachment1 = mid
	trail.Color = ColorSequence.new(color or COLORS.Swing)
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Lifetime = 0.12
	trail.MinLength = 0
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.FaceCamera = true
	trail.Parent = limbPart

	task.delay(duration, function()
		trail.Enabled = false
		task.wait(trail.Lifetime)
		trail:Destroy()
		tip:Destroy()
		mid:Destroy()
	end)
end

-- Burst of displaced air in front of a punch or kick.
function VFX.AirPop(character: Model, heavy: boolean)
	local root = getRoot(character)
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local position = root.Position + look * (if heavy then 3.5 else 3) + Vector3.new(0, 0.5, 0)
	impactRing(position, look, COLORS.Swing, 0.3, if heavy then 3.2 else 1.8, if heavy then 0.2 else 0.14)
	burst(position, {
		color = COLORS.Swing,
		count = if heavy then 8 else 4,
		size = 0.5,
		speed = NumberRange.new(10, 20),
		lifetime = NumberRange.new(0.1, 0.2),
		streaks = true,
		spread = 35,
		direction = look,
	})
	if heavy then
		flash(position, COLORS.Swing, 2.5, 0.1)
	end
end

-- Plays an effect locally (used for instant feedback on your own actions).
function VFX.Play(name: string, data: any)
	local effect = Effects[name]
	if effect then
		task.spawn(effect, data)
	end
end

function VFX.Start()
	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if type(name) == "string" and type(data) == "table" then
			VFX.Play(name, data)
		end
	end)
end

return VFX
