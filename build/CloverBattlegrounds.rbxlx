type Offsets={root:CFrame,bones:{CFrame},middles:{CFrame},feathers:{CFrame}}
local q:{[number]:Offsets}={}
for r,s in{-1,1}do
local t:Offsets={
root=CFrame.new(l.X*s,l.Y,l.Z),
