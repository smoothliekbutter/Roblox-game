				RightLeg = rot(-22, 0, 8),
				LeftLeg = rot(34, 0, -6),
			},
		},
		{
			0.3,
			{
				Torso = body(-0.035, -28),
				Head = rot(22),
				RightArm = limb(-12, 0, 28),
				Sword = aim(0, -1, 0.2),
				LeftArm = limb(-12, 0, -28),
				RightLeg = rot(-22, 0, 8),
