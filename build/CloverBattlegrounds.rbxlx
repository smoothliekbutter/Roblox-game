F=U+g.M1.ResetTime
end
end


k.Action:FireServer("M1",{jump=X,airborne=W,index=V})
m.PlayM1(R,V,Y)


local Z=T.CFrame.LookVector
local _=Vector3.new(Z.X,0,Z.Z).Unit
i.Apply(T,_*g.M1.LungeSpeed,g.M1.LungeTime,"Lunge",0.6)
