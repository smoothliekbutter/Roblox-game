          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Wind</string>
              <string name="Source"><![CDATA[--[[
	Prince of Wind (Yuno), client side: stance and spell animations, every
	spell's visuals and the Half-Crown / Full-Crown looks. The server sends
	("Skill", {skill, phase, ...}) events (Server/Kits/Wind) and every client
	draws them locally.

	Wind is pale green with a white core, star magic gold-white. Spells are
	built from anchored neon parts posed every frame, so they follow him and
	look the same at any ping.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NeverlandPlan = require(ReplicatedStorage:WaitForChild("Shared").Neverland)
local DivePlan = require(ReplicatedStorage:WaitForChild("Shared").TempestDive)
local CameraShake = require(script.Parent.Parent.CameraShake)
local Cinematic = require(script.Parent.Parent.Cinematic)
local M1Animations = require(script.Parent.Parent.M1Animations)
local PoseAnimator = require(script.Parent.Parent.PoseAnimator)
local VFX = require(script.Parent.Parent.VFX)

type Animation = PoseAnimator.Animation

local U = VFX.Util
local rad = math.rad
local UP = Vector3.yAxis

local WIND = Color3.fromRGB(120, 235, 175)
local WIND_DEEP = Color3.fromRGB(35, 170, 110)
local WIND_WHITE = Color3.fromRGB(228, 255, 240)
local STAR = Color3.fromRGB(255, 226, 130)
local STAR_WHITE = Color3.fromRGB(255, 250, 228)
local TIME_STOP = Color3.fromRGB(200, 236, 255)

local Kit = {}

VFX.SetPalette("Wind", { hit = WIND, heavy = WIND_DEEP, flash = WIND_WHITE })

---------------------------------------------------------------------------
-- Animations (generated by tools/anim/yuno_anims.py, see Animations.luau)
---------------------------------------------------------------------------

local function build(raw: { [string]: any }): Animation
	local keyframes = {}
	for _, key in raw.keys do
		table.insert(keyframes, {
			time = key[1],
			pose = key[2],
			easing = if key[3] then (Enum.EasingStyle :: any)[key[3]] else nil,
			direction = if key[4] then (Enum.EasingDirection :: any)[key[4]] else nil,
		})
	end
	return {
		keyframes = keyframes,
		loop = raw.loop,
		fadeIn = raw.fadeIn,
		fadeOut = raw.fadeOut,
		delays = raw.delays,
	}
end

local ANIMS: { [string]: Animation } = {}
for name, raw in require(script.Animations) do
	ANIMS[name] = build(raw)
end

-- Calm, upright stance; a light sprint with both arms swinging. The strides
-- are how far one loop (two steps) carries him (RUN_STRIDE / WALK_STRIDE
-- in tools/anim/yuno_anims.py), so the feet keep pace with the ground.
Kit.Idle = {
	stand = ANIMS.Idle,
	move = ANIMS.Run,
	walk = ANIMS.Walk,
	air = ANIMS.Air,
	moveSpeed = 16,
	walkSpeed = 8,
	moveStride = 10.88,
	walkStride = 6.13,
}

local function play(character: Model, animation: Animation, onEvent: ((string) -> ())?)
	PoseAnimator.Play(character, animation, onEvent)
end

---------------------------------------------------------------------------
-- M1: wind-wrapped strikes (the shared fist string), each with a gust
---------------------------------------------------------------------------

function Kit.PlayM1(character: Model, index: number, variant: string)
	local name = M1Animations.NameFor(index, variant)
	local animation = M1Animations.Clips[name]
	if not animation then
		return
	end
	local heavy = variant ~= "Normal"
	local strikers = M1Animations.Strikers[name] or {}
	play(character, animation, function(event)
		if event ~= "Strike" then
			return
		end
		for _, limbName in strikers do
			VFX.LimbTrail(character, limbName, if heavy then 0.2 else 0.13, WIND)
			local limb = character:FindFirstChild(limbName)
			if limb and limb:IsA("BasePart") then
				local tip = (limb.CFrame * CFrame.new(0, -1, 0)).Position
				U.burst(tip, {
					color = WIND_WHITE,
					count = if heavy then 10 else 5,
					size = 0.35,
					speed = NumberRange.new(10, 24),
					lifetime = NumberRange.new(0.1, 0.22),
					streaks = true,
					spread = 50,
					direction = (limb.CFrame.LookVector * -1 + limb.CFrame.UpVector * -1).Unit,
				})
			end
		end
		VFX.AirPop(character, heavy)
	end)
end

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------

local handlers: { [string]: (data: any, character: Model, root: BasePart) -> () } = {}

local function involves(data, character: Model): boolean
	return U.isLocal(character) or U.isLocal(data.target)
end

-- Bumped whenever a skill phase starts, so a loop drawing the last phase
-- stops as soon as that skill is released or cancelled.
local castTokens: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local function bump(character: Model): number
	local token = (castTokens[character] or 0) + 1
	castTokens[character] = token
	return token
end
local function live(character: Model, token: number): boolean
	return castTokens[character] == token and character.Parent ~= nil
end

-- Runs `step(elapsed, dt)` every frame until it returns false, `duration`
-- runs out or the cast is replaced; then `finish` (if any).
local function every(duration: number, step: (number, number) -> boolean?, finish: (() -> ())?)
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		local elapsed = os.clock() - start
		if elapsed >= duration or step(elapsed, dt) == false then
			connection:Disconnect()
			if finish then
				finish()
			end
		end
	end)
end

local function fadeOut(parts: { BasePart }, duration: number)
	for _, part in parts do
		U.tween(part, duration, { Transparency = 1 })
	end
	task.delay(duration + 0.05, function()
		for _, part in parts do
			part:Destroy()
		end
	end)
end

local function handOf(character: Model, side: string): Vector3?
	local arm = character:FindFirstChild(side .. " Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.15, 0)).Position else nil
end

-- A straight bar of light or wind between two points.
local function bar(from: Vector3, to: Vector3, width: number, color: Color3, transparency: number): BasePart
	if (to - from).Magnitude < 1e-3 then
		to = from + UP * 0.05
	end
	local length = math.max((to - from).Magnitude, 0.05)
	return U.newPart({
		Size = Vector3.new(width, width, length),
		CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to),
		Color = color,
		Transparency = transparency,
	})
end

-- A round beam (cylinder) between two points.
local function tube(from: Vector3, to: Vector3, width: number, color: Color3, transparency: number): BasePart
	if (to - from).Magnitude < 1e-3 then
		to = from + UP * 0.05
	end
	local length = math.max((to - from).Magnitude, 0.05)
	return U.newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, width, width),
		CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to) * CFrame.Angles(0, rad(90), 0),
		Color = color,
		Transparency = transparency,
	})
end

-- Wind streaming into a point from all round it.
local function inflow(target: Vector3, radius: number, color: Color3?)
	local from = target + U.randomUnit() * radius
	local wisp = bar(from, from + (target - from).Unit * 1.2, 0.08, color or WIND_WHITE, 0.3)
	U.tween(wisp, 0.22, { CFrame = CFrame.lookAt(target, target + (target - from).Unit), Transparency = 1 })
	task.delay(0.25, wisp.Destroy, wisp)
end

-- A burst of pale wind streaks.
local function gust(position: Vector3, size: number, direction: Vector3?)
	U.burst(position, {
		color = WIND_WHITE,
		count = math.floor(8 + size * 3),
		size = 0.3 + size * 0.06,
		speed = NumberRange.new(14 + size * 4, 28 + size * 8),
		lifetime = NumberRange.new(0.15, 0.35),
		streaks = true,
		spread = if direction then 40 else 180,
		direction = direction,
	})
	U.ringBurst(CFrame.new(position), WIND, size * 0.2, size, 0.3, 0.12)
	U.light(position, WIND, 3, size * 2.5, 0.25)
end

-- A four-pointed star of light (star magic): a white core, a gold cross and
-- a smaller diagonal cross, always turned to face the camera.
type Star = { place: (Vector3, number) -> (), fade: (number) -> (), parts: { BasePart } }

local function makeStar(size: number, color: Color3?): Star
	local tint = color or STAR
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local function add(part: BasePart, offset: CFrame)
		table.insert(parts, part)
		table.insert(offsets, offset)
	end
	add(
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.32, Color = STAR_WHITE }),
		CFrame.identity
	)
	for i = 0, 3 do
		local long = i % 2 == 0
		add(
			U.newPart({
				Size = Vector3.new(size * 0.07, size * (if long then 1.15 else 0.55), size * 0.07),
				Color = tint,
				Transparency = 0.05,
			}),
			CFrame.Angles(0, 0, i * math.pi / 4)
		)
	end
	add(
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.95, Color = tint, Transparency = 0.82 }),
		CFrame.identity
	)
	local light = Instance.new("PointLight")
	light.Color = tint
	light.Range = size * 6
	light.Brightness = 2.5
	light.Parent = parts[1]
	local star = { parts = parts }
	function star.place(position: Vector3, spin: number)
		local base = CFrame.lookAt(position, workspace.CurrentCamera.CFrame.Position) * CFrame.Angles(0, 0, spin)
		for i, part in parts do
			part.CFrame = base * offsets[i]
		end
	end
	function star.fade(duration: number)
		light.Enabled = false
		fadeOut(parts, duration)
	end
	return star
end

-- Sylph: a small spirit of wind, a glowing body with two fluttering wings.
type Sprite = { place: (CFrame, number) -> (), fade: (number) -> () }

local function makeSprite(scale: number): Sprite
	local body = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.5, 0.5, 0.5) * scale,
		Color = WIND_WHITE,
	})
	local glow = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.3 * scale,
		Color = WIND,
		Transparency = 0.7,
	})
	local wings = {
		U.newPart({ Size = Vector3.new(0.9, 0.05, 0.5) * scale, Color = WIND, Transparency = 0.35 }),
		U.newPart({ Size = Vector3.new(0.9, 0.05, 0.5) * scale, Color = WIND, Transparency = 0.35 }),
	}
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 6 * scale
	light.Brightness = 2
	light.Parent = body
	local parts = { body, glow, wings[1], wings[2] }
	local sprite = {}
	function sprite.place(cframe: CFrame, t: number)
		body.CFrame = cframe
		glow.CFrame = cframe
		local flap = math.sin(t * 30) * rad(40)
		wings[1].CFrame = cframe * CFrame.Angles(0, 0, flap) * CFrame.new(0.45 * scale, 0, 0)
		wings[2].CFrame = cframe * CFrame.Angles(0, 0, -flap) * CFrame.new(-0.45 * scale, 0, 0)
	end
	function sprite.fade(duration: number)
		light.Enabled = false
		fadeOut(parts, duration)
	end
	return sprite
end

-- An arc of thin segments (a bow, a crescent of wind): points on a circle of
-- `radius` round `center` from angle `from` to `to` (radians) in the plane of
-- `right` and `up`.
local function arcPoints(
	center: Vector3,
	right: Vector3,
	up: Vector3,
	radius: number,
	from: number,
	to: number,
	count: number
): { Vector3 }
	local points = {}
	for i = 0, count do
		local angle = from + (to - from) * i / count
		table.insert(points, center + (right * math.cos(angle) + up * math.sin(angle)) * radius)
	end
	return points
end

local function arcParts(points: { Vector3 }, width: number, color: Color3, transparency: number): { BasePart }
	local parts = {}
	for i = 1, #points - 1 do
		table.insert(parts, bar(points[i], points[i + 1], width, color, transparency))
	end
	return parts
end

local function poseArc(parts: { BasePart }, points: { Vector3 })
	for i, part in parts do
		local a, b = points[i], points[i + 1]
		part.Size = Vector3.new(part.Size.X, part.Size.Y, (b - a).Magnitude + 0.05)
		part.CFrame = CFrame.lookAt(a:Lerp(b, 0.5), b)
	end
end

---------------------------------------------------------------------------
-- Base: Prince of Wind
---------------------------------------------------------------------------

-- Wind Blades Shower: a ring of wind forms over the spot and blades fill
-- the sky in it, then fall in waves, each bursting where it lands.
local function fallingBlade(target: Vector3, formDelay: number, fallAt: number)
	local start = target + Vector3.new(math.random(-30, 30) / 10, 20 + math.random() * 6, math.random(-30, 30) / 10)
	local cframe = CFrame.lookAt(start, target) * CFrame.Angles(0, 0, math.random() * math.pi)
	local blade =
		U.newPart({ Size = Vector3.new(0.1, 0.65, 3.2), CFrame = cframe, Color = WIND_WHITE, Transparency = 1 })
	local glow = U.newPart({ Size = Vector3.new(0.05, 1.5, 3.8), CFrame = cframe, Color = WIND, Transparency = 1 })
	task.delay(formDelay, function()
		U.tween(blade, 0.2, { Transparency = 0.1 })
		U.tween(glow, 0.2, { Transparency = 0.6 })
	end)
	task.delay(fallAt, function()
		local drop = target - start
		U.tween(blade, 0.14, { CFrame = cframe + drop }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		U.tween(glow, 0.14, { CFrame = cframe + drop }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.14, function()
			blade:Destroy()
			glow:Destroy()
			U.burst(target, {
				color = WIND_WHITE,
				count = 5,
				size = 0.35,
				speed = NumberRange.new(10, 22),
				lifetime = NumberRange.new(0.12, 0.25),
				streaks = true,
				spread = 70,
			})
			U.ringBurst(CFrame.new(target + UP * 0.1), WIND, 0.4, 2.4, 0.22, 0.08)
		end)
	end)
end

function handlers.WindBladesShower(data, character, root)
	if data.phase == "Cast" then
		play(character, ANIMS.Shower)
		local center: Vector3 = data.center
		local radius: number = data.radius
		local delay: number = data.delay
		-- Where it will fall: a faint circle on the ground and a ring of wind above.
		U.ringBurst(CFrame.new(center + UP * 0.15), WIND, radius, radius, delay + data.waves * data.gap, 0.12)
		U.ringBurst(CFrame.new(center + UP * 22), WIND_WHITE, 2, radius + 2, delay + 0.2, 0.3)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, UP)
		end
		for wave = 1, data.waves do
			for _ = 1, 3 do
				local angle = math.random() * math.pi * 2
				local spot = center
					+ Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * math.sqrt(math.random())
				fallingBlade(spot, math.random() * delay * 0.6, delay + (wave - 1) * data.gap)
			end
		end
		task.delay(delay + data.waves * data.gap, function()
			gust(center + UP, 6, UP)
			U.groundCracks(center, 6, radius * 0.7, WIND, 1)
			if (workspace.CurrentCamera.CFrame.Position - center).Magnitude < 40 then
				CameraShake.Add(0.12)
			end
		end)
	end
end

-- Swift White Hawk: a hawk of wind (white core, green wings beating, a
-- streaming tail) flies out and curves after its target, bursting into
-- feathers of wind when it strikes.
local hawks: { [Model]: { done: boolean, position: Vector3 } } = {}

function handlers.SwiftWhiteHawk(data, character, root)
	if data.phase == "Cast" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			for _ = 1, 6 do
				inflow(hand, 4)
			end
		end
	elseif data.phase == "Fly" then
		local state = { done = false, position = data.origin :: Vector3 }
		hawks[character] = state
		local direction: Vector3 = data.direction
		local target: Model? = data.target
		local body = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Color = WIND_WHITE })
		local aura = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.2, 2.2, 2.2),
			Color = WIND,
			Transparency = 0.65,
		})
		local head = U.newPart({ Size = Vector3.new(0.6, 0.6, 0.9), Color = WIND_WHITE })
		local wings = {
			U.newPart({ Size = Vector3.new(3, 0.08, 1.2), Color = WIND, Transparency = 0.2 }),
			U.newPart({ Size = Vector3.new(3, 0.08, 1.2), Color = WIND, Transparency = 0.2 }),
		}
		local tail = U.newPart({ Size = Vector3.new(1.2, 0.06, 1.6), Color = WIND, Transparency = 0.3 })
		local parts = { body, aura, head, wings[1], wings[2], tail }
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 14
		light.Brightness = 3
		light.Parent = body
		local travelled = 0
		every(data.range / data.speed + 0.3, function(elapsed, dt)
			if state.done then
				return false
			end
			local targetRoot = target and U.getRoot(target)
			if targetRoot then
				local want = (targetRoot.Position - state.position).Unit
				local angle = math.acos(math.clamp(direction:Dot(want), -1, 1))
				if angle > 1e-3 then
					direction = direction:Lerp(want, math.min(1, data.turn * dt / angle)).Unit
				end
			end
			local step = data.speed * dt
			state.position += direction * step
			travelled += step
			local frame = CFrame.lookAt(state.position, state.position + direction)
			body.CFrame = frame
			aura.CFrame = frame
			head.CFrame = frame * CFrame.new(0, 0.15, -0.8)
			local flap = math.sin(elapsed * 22) * rad(35)
			wings[1].CFrame = frame * CFrame.Angles(0, 0, flap) * CFrame.new(1.5, 0, 0.1)
			wings[2].CFrame = frame * CFrame.Angles(0, 0, -flap) * CFrame.new(-1.5, 0, 0.1)
			tail.CFrame = frame * CFrame.new(0, 0, 1.1)
			if math.random() < 0.5 then
				local streak = bar(state.position, state.position - direction * 2.5, 0.12, WIND_WHITE, 0.4)
				U.tween(streak, 0.25, { Transparency = 1, Size = Vector3.new(0.02, 0.02, 2.5) })
				task.delay(0.26, streak.Destroy, streak)
			end
			return travelled < data.range
		end, function()
			hawks[character] = nil
			fadeOut(parts, 0.12)
		end)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, direction)
		end
	elseif data.phase == "Burst" then
		local state = hawks[character]
		if state then
			state.done = true
		end
		local position: Vector3 = data.position
		if data.fade then
			gust(position, 3)
			return
		end
		gust(position, 7)
		U.shockwave(position, WIND, 2, 9, 0.3)
		U.burst(position, {
			color = WIND,
			count = 18,
			size = 0.6,
			speed = NumberRange.new(20, 40),
			lifetime = NumberRange.new(0.25, 0.5),
			spread = 180,
			drag = 3,
		})
		if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 30 then
			CameraShake.Add(0.15)
		end
	end
end

-- Heavenly Wind Ark: a great crescent of wind rises out of the ground in
-- front of him (on the ground) or sweeps down beneath him (in the air).
function handlers.HeavenlyWindArk(data, character, root)
	if data.phase == "Cast" then
		play(character, if data.airborne then ANIMS.AirArk else ANIMS.Ark)
	elseif data.phase == "Carry" then
		-- Up together on a spiral of wind.
		for _, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				U.spiral(targetRoot, WIND, 2.5, 6, data.rise, 3, 0.12, 0.3)
				U.bodyTrail(target, WIND, 0.35)
			end
		end
		U.spiral(root, WIND_WHITE, 2.5, 6, 0.4, 2, 0.1, 0.3)
		U.bodyTrail(character, WIND, 0.35)
	elseif data.phase == "Rise" then
		local forward: Vector3 = data.direction
		local right = forward:Cross(UP).Unit
		local air = data.airborne == true
		local center = data.origin + forward * 5.5 + (if air then UP * -2 else UP * -3)
		local from, to = if air then math.pi * 1.05 else -0.05, if air then math.pi * 1.95 else math.pi * 1.05
		local points = arcPoints(center, right, UP, 6, from, to, 12)
		local outer = arcParts(points, 0.9, WIND, 0.45)
		local inner = arcParts(points, 0.3, WIND_WHITE, 0.05)
		local shift = if air then UP * -8 else UP * 9
		for _, part in outer do
			U.tween(part, 0.45, { CFrame = part.CFrame + shift, Transparency = 1 })
		end
		for _, part in inner do
			U.tween(part, 0.4, { CFrame = part.CFrame + shift, Transparency = 1 })
		end
		task.delay(0.5, function()
			for _, part in outer do
				part:Destroy()
			end
			for _, part in inner do
				part:Destroy()
			end
		end)
		if air then
			U.burst(center, {
				color = WIND_WHITE,
				count = 20,
				size = 0.5,
				speed = NumberRange.new(30, 60),
				lifetime = NumberRange.new(0.2, 0.4),
				streaks = true,
				spread = 30,
				direction = -UP,
			})
		else
			U.pillar(center, WIND, 3.5, 14, 0.4, Enum.Material.ForceField, 0.2)
			U.burst(center, {
				color = WIND_WHITE,
				count = 24,
				size = 0.5,
				speed = NumberRange.new(35, 70),
				lifetime = NumberRange.new(0.2, 0.45),
				streaks = true,
				spread = 25,
				direction = UP,
			})
			U.groundCracks(center, 4, 5, WIND, 0.8)
			U.debris(center, 6, 30, 0.6)
		end
		U.light(center, WIND, 4, 18, 0.35)
		if U.isLocal(character) then
			CameraShake.Add(0.14)
			CameraShake.FovKick(5)
		end
	end
end

-- Gale White Bow: a great bow of wind in his left hand, the string drawn to
-- his chin, held through the volley; each arrow streaks out as a long bolt
-- of wind with a white core.
local function flyingArrow(origin: Vector3, direction: Vector3, speed: number, range: number, scale: number)
	local core = U.newPart({ Size = Vector3.new(0.3, 0.3, 4) * scale, Color = WIND_WHITE })
	local glow = U.newPart({ Size = Vector3.new(1.1, 1.1, 5) * scale, Color = WIND, Transparency = 0.55 })
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { U.folder }
	local position = origin
	local travelled = 0
	every(range / speed + 0.1, function(_, dt)
		local step = speed * dt
		local wall = workspace:Raycast(position, direction * step, params)
		local model = wall and wall.Instance:FindFirstAncestorWhichIsA("Model")
		if wall and not (model and model:FindFirstChildOfClass("Humanoid")) then
			gust(wall.Position, 3)
			return false
		end
		position += direction * step
		travelled += step
		local frame = CFrame.lookAt(position, position + direction)
		core.CFrame = frame
		glow.CFrame = frame
		return travelled < range
	end, function()
		fadeOut({ core, glow }, 0.1)
	end)
end

local bows: { [Model]: { stop: () -> () } } = {}

function handlers.GaleWhiteBow(data, character, root)
	if data.phase == "Draw" then
		play(character, ANIMS.Bow)
		local token = bump(character)
		local length = data.draw + data.arrows * data.gap + 0.25
		local segments = 10
		local limbs = arcParts(table.create(segments + 1, Vector3.zero), 0.22, WIND, 0.2)
		local core = arcParts(table.create(segments + 1, Vector3.zero), 0.08, WIND_WHITE, 0)
		local strings = { bar(Vector3.zero, UP, 0.05, WIND_WHITE, 0.2), bar(Vector3.zero, UP, 0.05, WIND_WHITE, 0.2) }
		local all = table.clone(limbs)
		table.move(core, 1, #core, #all + 1, all)
		table.move(strings, 1, 2, #all + 1, all)
		local function stop()
			bows[character] = nil
			fadeOut(all, 0.2)
		end
		bows[character] = { stop = stop }
		every(length, function(elapsed)
			local hand = handOf(character, "Left")
			local pull = handOf(character, "Right")
			if not live(character, token) or not hand or not pull or not root.Parent then
				return false
			end
			local forward = root.CFrame.LookVector
			local right = forward:Cross(UP).Unit
			local grow = math.min(elapsed / 0.2, 1)
			local center = hand - forward * 1.2
			local points = arcPoints(center, forward, UP, 3.4 * grow + 0.1, -1.1, 1.1, segments)
			poseArc(limbs, points)
			poseArc(core, points)
			local nock = pull + right * 0.1
			strings[1].Size = Vector3.new(0.05, 0.05, (points[1] - nock).Magnitude)
			strings[1].CFrame = CFrame.lookAt(points[1]:Lerp(nock, 0.5), nock)
			strings[2].Size = Vector3.new(0.05, 0.05, (points[#points] - nock).Magnitude)
			strings[2].CFrame = CFrame.lookAt(points[#points]:Lerp(nock, 0.5), nock)
			return true
		end, function()
			if bows[character] then
				stop()
			end
		end)
	elseif data.phase == "Arrow" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		flyingArrow(origin, direction, data.speed, data.range, if data.last then 1.4 else 1)
		gust(origin, if data.last then 4 else 2, direction)
		if U.isLocal(character) then
			CameraShake.FovKick(if data.last then 5 else 2)
		end
	elseif data.phase == "Cancel" then
		bump(character)
		local bow = bows[character]
		if bow then
			bow.stop()
		end
	end
end

---------------------------------------------------------------------------
-- R: Conjunction
---------------------------------------------------------------------------

local stars: { [Model]: Star } = {}

function handlers.Conjunction(data, character, root)
	if data.phase == "Place" then
		play(character, ANIMS.Conjunction)
		local old = stars[character]
		if old then
			old.fade(0.1)
		end
		local origin: Vector3 = data.origin
		local spot: Vector3 = data.star
		local star = makeStar(1.8)
		stars[character] = star
		-- Flicked out to its spot, then it hangs there turning, pulsing.
		every(data.life, function(elapsed)
			if stars[character] ~= star then
				return false
			end
			local travel = math.min(elapsed / 0.15, 1)
			local position = origin:Lerp(spot, 1 - (1 - travel) ^ 2)
			star.place(position + UP * math.sin(elapsed * 3) * 0.15, elapsed * 2.5)
			return true
		end, function()
			if stars[character] == star then
				stars[character] = nil
				star.fade(0.3)
			end
		end)
		U.ringBurst(CFrame.new(spot), STAR, 0.4, 3, 0.35, 0.1)
	elseif data.phase == "Warp" then
		local star = stars[character]
		stars[character] = nil
		if star then
			star.fade(0.15)
		end
		local from: Vector3 = data.from
		local spot: Vector3 = data.star
		play(character, ANIMS.Warp)
		-- Gone in a flash of starlight, and there.
		local line = bar(from, spot, 0.25, STAR_WHITE, 0.1)
		local glow = bar(from, spot, 0.9, STAR, 0.6)
		fadeOut({ line, glow }, 0.25)
		for _, at in { from, spot } do
			U.flash(at, STAR_WHITE, 6, 0.25)
			U.ringBurst(CFrame.new(at - UP * 2.6), STAR, 1, 6, 0.3, 0.12)
			U.burst(at, {
				color = STAR,
				count = 14,
				size = 0.35,
				speed = NumberRange.new(8, 20),
				lifetime = NumberRange.new(0.3, 0.6),
				spread = 180,
				drag = 3,
			})
		end
		U.light(spot, STAR, 4, 16, 0.3)
		if U.isLocal(character) then
			CameraShake.FovKick(-6)
		end
	elseif data.phase == "Fade" then
		local star = stars[character]
		stars[character] = nil
		if star then
			star.fade(0.3)
		end
	end
end

---------------------------------------------------------------------------
-- Half-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Spirit Storm. The charge: Sylph's mana gathers in his palm as an orb of
-- storm, a white core in a green halo inside a shimmering shell, three
-- rings of wind whirling round it on tilted axes, wind streaming in from
-- all round and a ring drawn in along the ground. The beam: a white-hot
-- core in a green column inside a shimmering sheath, three helices of wind
-- twisting round it and spinning, rings tearing off along it, streaks
-- racing down it, the muzzle pulsing; it scars the ground it passes over
-- and bursts where it ends; when it stops the helices unwind and it
-- collapses.
local STORM_STRANDS = 3
local STORM_SEGMENTS = 18

function handlers.SpiritStorm(data, character, root)
	if data.phase == "Charge" then
		play(character, ANIMS.StormCharge)
		local token = bump(character)
		local orb = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Color = WIND_WHITE })
		local halo =
			U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.4, Color = WIND, Transparency = 0.5 })
		local shell = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			Color = WIND,
			Material = Enum.Material.ForceField,
		})
		local rings = {}
		for _ = 1, 3 do
			table.insert(
				rings,
				arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 10), 0.08, WIND_WHITE, 0.15)
			)
		end
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 12
		light.Brightness = 1
		light.Parent = orb
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Right")
			if not live(character, token) or not hand then
				return false
			end
			local grow = math.min(elapsed / data.duration, 1)
			local center = hand + root.CFrame.LookVector * 0.7
			orb.Size = Vector3.one * (0.3 + 1.1 * grow)
			halo.Size = Vector3.one * (0.8 + 2.4 * grow)
			shell.Size = Vector3.one * (1 + 3.2 * grow)
			orb.CFrame = CFrame.new(center)
			halo.CFrame = orb.CFrame
			shell.CFrame = orb.CFrame * CFrame.Angles(elapsed * 3, elapsed * 2, 0)
			for r, ring in rings do
				local tilt = CFrame.Angles(r * 1.1 + elapsed * (3 + r), elapsed * (4 - r), r * 0.7)
				poseArc(
					ring,
					arcPoints(center, tilt.RightVector, tilt.UpVector, 0.7 + 1.7 * grow + r * 0.25, 0, math.pi * 2, 10)
				)
			end
			inflow(center, 6)
			inflow(center, 4)
			light.Brightness = 1 + 5 * grow
			return true
		end, function()
			fadeOut({ orb, halo, shell }, 0.08)
			for _, ring in rings do
				fadeOut(ring, 0.08)
			end
		end)
		U.ringBurst(CFrame.new(root.Position - UP * 2.9), WIND, 7, 1, data.duration, 0.15)
		U.spiral(root, WIND, 2.2, 4, data.duration, 2, 0.08, 0.6)
		if U.isLocal(character) then
			CameraShake.Add(0.06)
		end
	elseif data.phase == "Fire" then
		play(character, ANIMS.StormFire)
		local token = bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local length: number = data.length
		local finish = origin + direction * length
		local right = direction:Cross(UP)
		right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
		local up = right:Cross(direction).Unit

		local core = tube(origin, finish, 1.2, WIND_WHITE, 0)
		local column = tube(origin, finish, 4.2, WIND, 0.5)
		local sheath = tube(origin, finish, 6.4, WIND, 0)
		sheath.Material = Enum.Material.ForceField
		local haze = tube(origin, finish, 9, WIND_DEEP, 0.9)
		local strands: { { BasePart } } = {}
		for k = 1, STORM_STRANDS do
			local strand = {}
			for _ = 1, STORM_SEGMENTS do
				table.insert(
					strand,
					bar(
						origin,
						origin + direction,
						if k == 1 then 0.3 else 0.22,
						if k == 1 then WIND_WHITE else WIND,
						0.1
					)
				)
			end
			table.insert(strands, strand)
		end
		-- Streaks racing down the beam.
		local muzzle = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.lookAt(origin, finish) })
		local streaks = Instance.new("ParticleEmitter")
		streaks.Texture = U.textures.Spark
		streaks.Color = ColorSequence.new(WIND_WHITE, WIND)
		streaks.LightEmission = 1
		streaks.LightInfluence = 0
		streaks.EmissionDirection = Enum.NormalId.Front
		streaks.Orientation = Enum.ParticleOrientation.VelocityParallel
		streaks.Speed = NumberRange.new(150, 210)
		streaks.Lifetime = NumberRange.new(length / 210, length / 150)
		streaks.SpreadAngle = Vector2.new(5, 5)
		streaks.Size = NumberSequence.new(0.7, 0.1)
		streaks.Transparency = NumberSequence.new(0.1, 1)
		streaks.Rate = 140
		streaks.Parent = muzzle
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 28
		light.Brightness = 5
		light.Parent = core

		local nextRing, nextPulse = 0, 0
		every(data.duration, function(elapsed)
			if not live(character, token) then
				return false
			end
			-- Three helices of wind, twisting round the beam and spinning.
			local spin = elapsed * 14
			for k, strand in strands do
				local phase = k * (math.pi * 2 / STORM_STRANDS) + spin
				local radius = 2.5 + 0.35 * math.sin(elapsed * 30 + k)
				local previous = origin
				for i, segment in strand do
					local s = i / #strand * length
					local angle = phase + s * 0.35
					local point = origin
						+ direction * s
						+ (right * math.cos(angle) + up * math.sin(angle)) * radius * math.min(s / 3, 1)
					segment.Size = Vector3.new(segment.Size.X, segment.Size.Y, (point - previous).Magnitude + 0.05)
					segment.CFrame = CFrame.lookAt(previous:Lerp(point, 0.5), point)
					previous = point
				end
			end
			local breathe = 1 + math.sin(elapsed * 40) * 0.07
			column.Size = Vector3.new(column.Size.X, 4.2 * breathe, 4.2 * breathe)
			core.Size =
				Vector3.new(core.Size.X, 1.2 + math.sin(elapsed * 55) * 0.18, 1.2 + math.sin(elapsed * 55) * 0.18)
			if elapsed >= nextRing then
				nextRing = elapsed + 0.035
				U.impactRing(origin + direction * (math.random() * length), direction, WIND_WHITE, 2, 5.5, 0.2)
			end
			if elapsed >= nextPulse then
				nextPulse = elapsed + 0.1
				U.impactRing(origin, direction, WIND, 1.5, 7, 0.25)
			end
			return true
		end, function()
			-- The helices unwind outward and it all collapses.
			for _, strand in strands do
				for _, segment in strand do
					local out = segment.Position - (origin + direction * direction:Dot(segment.Position - origin))
					U.tween(segment, 0.3, {
						CFrame = segment.CFrame + (if out.Magnitude > 1e-3 then out.Unit * 2.5 else Vector3.zero),
						Transparency = 1,
					})
				end
				task.delay(0.32, function()
					for _, segment in strand do
						segment:Destroy()
					end
				end)
			end
			U.tween(core, 0.25, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
			fadeOut({ core, column, sheath, haze }, 0.3)
			streaks.Enabled = false
			task.delay(0.6, muzzle.Destroy, muzzle)
			gust(finish, 8, direction)
			U.shockwave(finish, WIND, 2, 14, 0.35)
		end)

		-- The ground it passes over is scarred.
		for along = 6, length, 6 do
			local ground = U.groundBelow(origin + direction * along, { character }, 7)
			if ground then
				task.delay(along / 300, function()
					U.groundCracks(ground.Position, 2, 4, WIND, 1.2)
					U.debris(ground.Position, 3, 25, 0.5)
				end)
			end
		end
		gust(origin, 6, direction)
		U.flash(origin, WIND_WHITE, 6, 0.2)
		U.impactRing(origin, direction, WIND_WHITE, 1, 9, 0.3)
		U.light(origin, WIND, 6, 24, 0.7)
		if U.isLocal(character) then
			CameraShake.Add(0.25)
			CameraShake.FovKick(10)
		elseif (workspace.CurrentCamera.CFrame.Position - origin).Magnitude < 40 then
			CameraShake.Add(0.1)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- Tempest Dive: he flies straight up dragging them by the collar (wind
-- trailing off them both); a beat at the top, then he swings over them and
-- drives them down, and a tornado forms behind them on the way down: rings
-- of wind stacked from the ground up (narrow at the foot, wide at the top)
-- and a shimmering funnel, spinning, each part appearing as they fall past
-- it. Once they hit, the whole funnel stands over the crater a moment, then
-- blows apart.
local TORNADO_RINGS = 9
local TORNADO_SEGMENTS = 10

local function playTempestDive(data, character: Model, root: BasePart)
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = DivePlan.Plan(data.origin, data.start, data.floorY)
	local times = DivePlan.Times
	local started = os.clock()
	local mine = involves(data, character)
	local floorY = plan.floorY
	local base = Vector3.new(plan.start.X, floorY, plan.start.Z)

	play(character, ANIMS.TempestDrag)
	U.bodyTrail(character, WIND, times.Lift)
	if target then
		U.bodyTrail(target, WIND_WHITE, times.Lift)
	end
	gust(plan.start, 6, UP)
	U.ringBurst(CFrame.new(base + UP * 0.2), WIND, 1, 9, 0.4, 0.3)

	local rings = {}
	for k = 1, TORNADO_RINGS do
		local fraction = (k - 0.5) / TORNADO_RINGS
		local parts = {}
		for j = 1, TORNADO_SEGMENTS do
			local wide = j % 2 == 0
			table.insert(parts, bar(Vector3.zero, UP, if wide then 0.4 else 0.22, if wide then WIND else WIND_WHITE, 1))
		end
		table.insert(
			rings,
			{ parts = parts, height = DivePlan.Height * fraction, radius = 2 + 8 * fraction ^ 1.3, phase = k * 0.7 }
		)
	end
	local funnel = {}
	for k = 1, 3 do
		local fraction = (k - 0.5) / 3
		local width = 3.5 + 13 * fraction
		table.insert(funnel, {
			part = U.newPart({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(DivePlan.Height / 3 + 1, width, width),
				Color = WIND,
				Material = Enum.Material.ForceField,
				Transparency = 1,
			}),
			height = DivePlan.Height * fraction,
		})
	end
	local foot = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(base) })

	local finishAt = times.Land + 0.8
	local bind = "CloverTempestDive" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	local flipped, dove = false, false
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > finishAt then
			finish()
			return
		end
		if t <= times.Length and root.Parent then
			root.CFrame = DivePlan.Attacker(plan, t)
		end
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = DivePlan.Victim(plan, t)
		end
		if not flipped and t >= times.Lift then
			flipped = true
			play(character, ANIMS.BoreasForm)
			local top = plan.start + UP * DivePlan.Height
			U.flash(top, WIND_WHITE, 6, 0.2)
			U.ringBurst(CFrame.new(top), WIND, 1, 8, 0.35, 0.2)
			if mine then
				CameraShake.Add(0.1)
			end
		end
		if not dove and t >= times.Flip then
			dove = true
			play(character, ANIMS.BoreasChop)
			U.spiral(foot, WIND, 4, DivePlan.Height, finishAt - times.Flip, 4, 0.22, 0.35)
			if mine then
				CameraShake.FovKick(10)
			end
		end
		if t >= times.Flip then
			local fall = math.clamp((t - times.Flip) / (times.Land - times.Flip), 0, 1)
			local front = DivePlan.DiveAt(plan, fall).Y - floorY
			local apart = math.clamp((t - times.Land - 0.5) / 0.3, 0, 1)
			for k, ring in rings do
				local center = base + UP * ring.height
				local spin = t * (11 - k * 0.6) + ring.phase
				local points = arcPoints(
					center,
					Vector3.xAxis,
					Vector3.zAxis,
					ring.radius * (1 + apart * 0.9),
					spin,
					spin + math.pi * 1.7,
					TORNADO_SEGMENTS
				)
				poseArc(ring.parts, points)
				local transparency = if ring.height >= front - 1 then 0.25 + 0.75 * apart else 1
				for _, p in ring.parts do
					p.Transparency = transparency
				end
			end
			for k, segment in funnel do
				segment.part.CFrame = CFrame.new(base + UP * segment.height)
					* CFrame.Angles(0, t * 6 + k, 0)
					* CFrame.Angles(0, 0, rad(90))
				segment.part.Transparency = if segment.height >= front - DivePlan.Height / 6
					then 0.15 + 0.85 * apart
					else 1
			end
		end
	end)
	task.delay(finishAt + 0.1, function()
		finish()
		for _, ring in rings do
			for _, p in ring.parts do
				p:Destroy()
			end
		end
		for _, segment in funnel do
			segment.part:Destroy()
		end
		foot:Destroy()
	end)

	if mine then
		Cinematic.Camera(function(t)
			local focus = DivePlan.Victim(plan, math.min(t, times.Land)).Position
			local right = plan.forward:Cross(UP)
			local offset = right * 18 - plan.forward * 6 + UP * (if t < times.Lift then -2 else 3)
			return CFrame.lookAt(focus + offset, focus), if t > times.Flip and t < times.Land then 84 else 72
		end, times.Length + 0.2)
	end
end

function handlers.TempestDive(data, character, root)
	local phase = data.phase
	if phase == "Reach" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, root.CFrame.LookVector)
		end
	elseif phase == "Whiff" then
		gust(root.Position + root.CFrame.LookVector * 4, 2)
	elseif phase == "Begin" then
		playTempestDive(data, character, root)
	elseif phase == "Impact" then
		-- Driven in hard: a dome of wind, a crater ring, the ground split
		-- and thrown up, a column of wind and dust.
		local position: Vector3 = data.position
		U.shockwave(position, WIND, 3, 26, 0.45, Enum.Material.ForceField)
		U.shockwave(position, WIND_WHITE, 2, 12, 0.25)
		U.ringBurst(CFrame.new(position + UP * 0.2), WIND_WHITE, 2, 16, 0.4, 0.45)
		U.ringBurst(CFrame.new(position + UP * 0.3), WIND, 1, 11, 0.5, 0.25)
		U.groundCracks(position, 12, 11, WIND, 1.6)
		U.groundRocks(position, 12, 7, 1.8)
		U.debris(position, 18, 45, 1)
		U.pillar(position, WIND, 3, 22, 0.45, Enum.Material.ForceField, 0.25)
		gust(position + UP, 9, UP)
		U.light(position, WIND, 6, 40, 0.6)
		local near = (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 60
		if near then
			U.colorGrade({ Brightness = 0.2, Contrast = 0.5, Saturation = -0.6 }, 0, 0.06, 0.25)
			CameraShake.Add(0.45)
		end
	end
end

-- Quartile Scutum: four stars at the corners of a rectangle in front of him
-- and beams of light between them, a pane of starlight filling it; it moves
-- with him, ripples where it's struck and fades when it drops.
local barriers: { [Model]: { ripple: (Vector3?) -> (), drop: () -> () } } = {}

function handlers.QuartileScutum(data, character, root)
	if data.phase == "Raise" then
		play(character, ANIMS.Scutum)
		local corners = {
			Vector3.new(-3.6, -2.6, -3.2),
			Vector3.new(3.6, -2.6, -3.2),
			Vector3.new(3.6, 3.2, -3.2),
			Vector3.new(-3.6, 3.2, -3.2),
		}
		local cornerStars = {}
		for _ = 1, 4 do
			table.insert(cornerStars, makeStar(1.4))
		end
		local edges = {}
		for _ = 1, 4 do
			table.insert(edges, bar(Vector3.zero, UP, 0.18, STAR_WHITE, 0.05))
		end
		local pane = U.newPart({
			Size = Vector3.new(7.2, 5.8, 0.1),
			Color = STAR,
			Transparency = 0.82,
			Material = Enum.Material.ForceField,
		})
		local done = false
		local function drop()
			done = true
			barriers[character] = nil
			for _, star in cornerStars do
				star.fade(0.25)
			end
			fadeOut(edges, 0.25)
			fadeOut({ pane }, 0.25)
		end
		barriers[character] = {
			ripple = function(from: Vector3?)
				U.impactRing(pane.Position, pane.CFrame.LookVector, STAR_WHITE, 0.5, 4, 0.3)
				U.flash(pane.Position, STAR, 5, 0.15)
				if from then
					U.burst(pane.Position, {
						color = STAR,
						count = 10,
						size = 0.3,
						speed = NumberRange.new(10, 25),
						lifetime = NumberRange.new(0.15, 0.3),
						streaks = true,
						spread = 50,
						direction = (from - pane.Position).Unit,
					})
				end
			end,
			drop = drop,
		}
		every(data.duration + 0.5, function(elapsed)
			if done or not root.Parent then
				return false
			end
			local frame = root.CFrame
			local world = {}
			for i, corner in corners do
				world[i] = frame:PointToWorldSpace(corner)
				cornerStars[i].place(world[i], elapsed * 2 + i)
			end
			for i, edge in edges do
				local a, b = world[i], world[i % 4 + 1]
				local grow = math.min(elapsed / 0.15, 1)
				local tip = a:Lerp(b, grow)
				edge.Size = Vector3.new(0.18, 0.18, (tip - a).Magnitude + 0.05)
				edge.CFrame = CFrame.lookAt(a:Lerp(tip, 0.5), tip)
			end
			pane.CFrame = frame * CFrame.new(0, 0.3, -3.2)
			return true
		end, function()
			if not done then
				drop()
			end
		end)
	elseif data.phase == "Block" then
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(data.from)
		end
	elseif data.phase == "Drop" then
		local barrier = barriers[character]
		if barrier then
			barrier.drop()
		end
	end
end

-- Quartile Hasta: four stars turn round his outstretched hand, growing;
-- their beams converge ahead of him into one great lance of starlight.
local hastaStars: { [Model]: { Star } } = {}

function handlers.QuartileHasta(data, character, root)
	if data.phase == "Stars" then
		play(character, ANIMS.HastaStars)
		local token = bump(character)
		local set = {}
		for _ = 1, 4 do
			table.insert(set, makeStar(1.2))
		end
		hastaStars[character] = set
		every(data.duration + 0.1, function(elapsed)
			local hand = handOf(character, "Right")
			if not live(character, token) or not hand then
				return false
			end
			local grow = math.min(elapsed / 0.2, 1)
			local frame = CFrame.lookAt(hand, hand + root.CFrame.LookVector) * CFrame.Angles(0, 0, elapsed * 3)
			for i, star in set do
				local angle = (i - 1) * math.pi / 2
				star.place(frame * Vector3.new(math.cos(angle), math.sin(angle), -0.8) * 1.8 * grow, elapsed * 4)
			end
			return true
		end, function()
			if hastaStars[character] == set then
				hastaStars[character] = nil
			end
			for _, star in set do
				star.fade(0.15)
			end
		end)
	elseif data.phase == "Fire" then
		play(character, ANIMS.HastaFire)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local finish = origin + direction * data.length
		local meet = origin + direction * 3
		local set = hastaStars[character]
		if set then
			for _, star in set do
				local from = star.parts[1].Position
				local ray = bar(from, meet, 0.25, STAR_WHITE, 0.05)
				fadeOut({ ray }, 0.2)
			end
		end
		bump(character)
		local core = tube(meet, finish, 1.6, STAR_WHITE, 0)
		local glow = tube(meet, finish, 5.5, STAR, 0.6)
		local sheath = tube(meet, finish, 8, STAR, 0.88)
		U.tween(core, 0.4, { Size = Vector3.new(core.Size.X, 0.1, 0.1) })
		U.tween(glow, 0.4, { Size = Vector3.new(glow.Size.X, 0.6, 0.6) })
		fadeOut({ core, glow, sheath }, 0.4)
		U.flash(meet, STAR_WHITE, 10, 0.25)
		U.flash(finish, STAR, 8, 0.25)
		U.impactRing(meet, direction, STAR_WHITE, 1, 8, 0.3)
		U.light(meet, STAR, 6, 30, 0.4)
		U.burst(finish, {
			color = STAR,
			count = 20,
			size = 0.5,
			speed = NumberRange.new(20, 45),
			lifetime = NumberRange.new(0.2, 0.45),
			spread = 180,
		})
		if U.isLocal(character) then
			CameraShake.Add(0.25)
			CameraShake.FovKick(10)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

---------------------------------------------------------------------------
-- Full-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Looks (built further down); moves can hide his wind sword for a moment
-- (the halberd, the bow).
local looks: { [Model]: { hideSword: number } } = {}

local function hideSword(character: Model, duration: number)
	local look = looks[character]
	if look then
		look.hideSword = os.clock() + duration
	end
end

-- Spirit of Notos: the south wind bursts out of him (a sphere of wind and a
-- ring along the ground); spells blown back go as a whirling disc of wind.
function handlers.SpiritOfNotos(data, character, root)
	if data.phase == "Blast" then
		play(character, ANIMS.Notos)
		task.delay(0.1, function()
			if not root.Parent then
				return
			end
			local position = root.Position
			U.shockwave(position, WIND, 4, 34, 0.5, Enum.Material.ForceField)
			U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, 18, 0.4, 0.3)
			U.burst(position, {
				color = WIND_WHITE,
				count = 36,
				size = 0.5,
				speed = NumberRange.new(60, 100),
				lifetime = NumberRange.new(0.2, 0.4),
				streaks = true,
				spread = 180,
			})
			U.light(position, WIND, 5, 30, 0.4)
			if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 30 then
				CameraShake.Add(0.2)
			end
		end)
	elseif data.phase == "Gust" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local disc = U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 6, 6),
			Color = WIND,
			Transparency = 0.4,
		})
		local position = origin
		every(0.75, function(elapsed, dt)
			position += direction * 120 * dt
			disc.CFrame = CFrame.lookAt(position, position + direction)
				* CFrame.Angles(0, rad(90), 0)
				* CFrame.Angles(elapsed * 20, 0, 0)
			return true
		end, function()
			fadeOut({ disc }, 0.1)
		end)
		gust(origin, 5, direction)
	end
end

-- Spirit of Zephyrus: he leaps into the sky on a burst of wind; hanging
-- there, arms flung wide over a turning ring of wind, wind arrows form one
-- by one floating round him (the same ring the server fires from), pointed
-- down at the ground; then they rain down one after another.
local ZEPHYRUS_ARROWS = 14
local ZEPHYRUS_RING = 4.5
type Floating = { core: BasePart, glow: BasePart, fletch: BasePart }
type Volley = { arrows: { [number]: Floating }, started: number, ring: { BasePart } }
local volleys: { [Model]: Volley } = {}

local function floatingAt(root: BasePart, i: number, t: number): Vector3
	local angle = i / ZEPHYRUS_ARROWS * math.pi * 2 + t * 1.5
	return root.Position
		+ Vector3.new(math.cos(angle) * ZEPHYRUS_RING, 1.2 + math.sin(angle * 2) * 0.6, math.sin(angle) * ZEPHYRUS_RING)
end

local function clearVolley(character: Model)
	local volley = volleys[character]
	if volley then
		volleys[character] = nil
		for _, arrow in volley.arrows do
			fadeOut({ arrow.core, arrow.glow, arrow.fletch }, 0.15)
		end
		fadeOut(volley.ring, 0.2)
	end
end

function handlers.SpiritOfZephyrus(data, character, root)
	local phase = data.phase
	if phase == "Leap" then
		play(character, ANIMS.Ark)
		local feet = root.Position - UP * 2.9
		U.ringBurst(CFrame.new(feet), WIND, 1, 9, 0.35, 0.3)
		U.burst(feet, {
			color = WIND_WHITE,
			count = 24,
			size = 0.5,
			speed = NumberRange.new(30, 60),
			lifetime = NumberRange.new(0.2, 0.4),
			streaks = true,
			spread = 40,
			direction = -UP,
		})
		U.debris(feet, 6, 30, 0.5)
		U.bodyTrail(character, WIND, data.rise + 0.1)
		if U.isLocal(character) then
			CameraShake.Add(0.15)
			CameraShake.FovKick(6)
		end
	elseif phase == "Gather" then
		play(character, ANIMS.Notos)
		clearVolley(character)
		local token = bump(character)
		local volley: Volley = {
			arrows = {},
			started = os.clock(),
			ring = arcParts(
				arcPoints(Vector3.zero, Vector3.xAxis, Vector3.zAxis, 1, 0, math.pi * 2, 16),
				0.25,
				WIND_WHITE,
				0.2
			),
		}
		volleys[character] = volley
		local count: number = data.arrows
		for i = 1, count do
			task.delay((i - 1) / count * data.gather, function()
				if volleys[character] ~= volley then
					return
				end
				volley.arrows[i] = {
					core = U.newPart({ Size = Vector3.new(0.25, 0.25, 3.4), Color = WIND_WHITE }),
					glow = U.newPart({ Size = Vector3.new(0.9, 0.9, 4), Color = WIND, Transparency = 0.55 }),
					fletch = U.newPart({ Size = Vector3.new(0.7, 0.06, 0.7), Color = STAR, Transparency = 0.1 }),
				}
				U.flash(floatingAt(root, i, os.clock() - volley.started), WIND_WHITE, 2.5, 0.15)
			end)
		end
		every(data.gather + count * 0.06 + 1, function()
			if volleys[character] ~= volley or not live(character, token) or not root.Parent then
				return false
			end
			local t = os.clock() - volley.started
			for i, arrow in volley.arrows do
				local position = floatingAt(root, i, t)
				local outward = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
				local aim = ((if outward.Magnitude > 1e-3 then outward.Unit else Vector3.xAxis) * 0.45 - UP).Unit
				local frame = CFrame.lookAt(position, position + aim)
				arrow.core.CFrame = frame
				arrow.glow.CFrame = frame
				arrow.fletch.CFrame = frame * CFrame.new(0, 0, 1.6) * CFrame.Angles(0, rad(45), 0)
			end
			local spin = t * 3
			poseArc(
				volley.ring,
				arcPoints(
					root.Position - UP * 3.2,
					Vector3.new(math.cos(spin), 0, math.sin(spin)),
					Vector3.new(-math.sin(spin), 0, math.cos(spin)),
					5,
					0,
					math.pi * 2,
					16
				)
			)
			return true
		end, function()
			if volleys[character] == volley then
				clearVolley(character)
			end
		end)
		U.light(root.Position, WIND, 4, 24, data.gather + 1.2)
	elseif phase == "Arrow" then
		local volley = volleys[character]
		local arrow = volley and volley.arrows[data.index]
		local aim: Vector3 = data.aim
		local from = if arrow then arrow.core.Position else root.Position
		if volley and arrow then
			volley.arrows[data.index] = nil
			arrow.core:Destroy()
			arrow.glow:Destroy()
			arrow.fletch:Destroy()
		end
		flyingArrow(from, (aim - from).Unit, data.speed, data.range, if data.last then 1.5 else 0.9)
		U.flash(from, WIND_WHITE, if data.last then 4 else 2, 0.12)
		if data.last and volley then
			task.delay(0.3, function()
				if volleys[character] == volley then
					clearVolley(character)
				end
			end)
		end
		if U.isLocal(character) then
			CameraShake.FovKick(if data.last then 5 else 1)
		end
	elseif phase == "Cancel" then
		bump(character)
		clearVolley(character)
	end
end

-- Spirit of Euros: a recurve bow of wind (curled tips) and an arrow that
-- the wind spirals into as he draws; loosed, a white line is all there is,
-- then the air along it rings.
function handlers.SpiritOfEuros(data, character, root)
	if data.phase == "Draw" then
		play(character, ANIMS.EurosDraw)
		local token = bump(character)
		hideSword(character, data.duration + 0.4)
		local segments = 12
		local limbs = arcParts(table.create(segments + 1, Vector3.zero), 0.24, WIND, 0.15)
		local arrow = bar(Vector3.zero, UP, 0.16, WIND_WHITE, 0)
		local arrowGlow = bar(Vector3.zero, UP, 0.6, WIND, 0.5)
		local all = table.clone(limbs)
		table.insert(all, arrow)
		table.insert(all, arrowGlow)
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Left")
			local pull = handOf(character, "Right")
			if not live(character, token) or not hand or not pull then
				return false
			end
			local forward = root.CFrame.LookVector
			local center = hand - forward * 1.3
			-- Recurve: the tips curl forward again.
			local points = arcPoints(center, forward, UP, 3.6, -1.2, 1.2, segments)
			points[1] += forward * 0.7
			points[#points] += forward * 0.7
			poseArc(limbs, points)
			local tip = hand + forward * 1.6
			arrow.Size = Vector3.new(0.16, 0.16, (tip - pull).Magnitude)
			arrow.CFrame = CFrame.lookAt(pull:Lerp(tip, 0.5), tip)
			arrowGlow.Size = Vector3.new(0.6, 0.6, arrow.Size.Z) * (0.5 + elapsed / data.duration)
			arrowGlow.CFrame = arrow.CFrame
			inflow(tip, 4)
			return true
		end, function()
			fadeOut(all, 0.1)
		end)
	elseif data.phase == "Loose" then
		play(character, ANIMS.EurosLoose)
		bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local finish = origin + direction * data.length
		local line = bar(origin, finish, 0.2, WIND_WHITE, 0)
		local glow = bar(origin, finish, 1.2, WIND, 0.55)
		U.tween(line, 0.45, { Size = Vector3.new(0.02, 0.02, line.Size.Z) })
		fadeOut({ line, glow }, 0.45)
		for i = 0, 8 do
			task.delay(i * 0.02, U.impactRing, origin:Lerp(finish, i / 8), direction, WIND_WHITE, 0.5, 3, 0.25)
		end
		U.flash(finish, WIND_WHITE, 8, 0.2)
		gust(finish, 6, direction)
		U.light(origin, WIND, 5, 24, 0.3)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

-- Neverland: his hand shoots out; whoever it catches is caught in stopped
-- time, a dome of pale light with the world drained of colour. Three stars
-- stand round them joined by beams, a triangle that rises with them; he
-- flashes from star to star punching them up through it, then hammers them
-- down from above, through a great triangle of stars, into the ground.
-- Afterwards the dome lingers over the crater, stars turning on its rim.
local domes: { [Model]: { close: () -> () } } = {}

local function triangleBeams(width: number): { BasePart }
	local beams = {}
	for _ = 1, 3 do
		table.insert(beams, bar(Vector3.zero, UP, width, STAR_WHITE, 0.1))
	end
	return beams
end

local function poseTriangle(beams: { BasePart }, corners: { Vector3 })
	for i, beam in beams do
		local a, b = corners[i], corners[i % 3 + 1]
		beam.Size = Vector3.new(beam.Size.X, beam.Size.Y, (b - a).Magnitude + 0.05)
		beam.CFrame = CFrame.lookAt(a:Lerp(b, 0.5), b)
	end
end

local function punchClip(index: number, variant: string): Animation?
	return M1Animations.Clips[M1Animations.NameFor(index, variant)]
end

local function playNeverland(data, character: Model, root: BasePart)
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = NeverlandPlan.Plan(data.origin, data.start, data.floorY)
	local times = NeverlandPlan.Times
	local started = os.clock()
	local mine = involves(data, character)
	local near = (workspace.CurrentCamera.CFrame.Position - plan.start).Magnitude < 70

	-- Time stops: a dome of pale light round them, the world drained.
	local dome = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2,
		CFrame = CFrame.new(plan.start),
		Color = TIME_STOP,
		Material = Enum.Material.ForceField,
		Transparency = 0.1,
	})
	U.tween(dome, 0.35, { Size = Vector3.one * 34 }, Enum.EasingStyle.Quart)
	U.ringBurst(CFrame.new(plan.start), TIME_STOP, 1, 17, 0.35, 0.2)
	if mine or near then
		U.colorGrade({ Saturation = -0.75, Contrast = 0.15, TintColor = TIME_STOP }, 0.15, times.Land - 0.2, 0.5)
	end

	-- The triangle of stars and the light between them.
	local stars = { makeStar(2.2), makeStar(2.2), makeStar(2.2) }
	local beams = triangleBeams(0.22)
	local bigStars: { Star } = {}
	local bigBeams: { BasePart } = {}
	local struck = 0
	local hammered = false

	-- Both of them on the paths, drawn here every frame for smoothness (the
	-- server holds them there too).
	local bind = "CloverNeverland" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > times.Length + 0.1 then
			finish()
			return
		end
		if root.Parent then
			root.CFrame = NeverlandPlan.Attacker(plan, t)
		end
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = NeverlandPlan.Victim(plan, t)
		end

		local height = NeverlandPlan.Height(math.min(t, times.Apex)) - 0.5
		local corners = {
			NeverlandPlan.Corner(plan, 1, height),
			NeverlandPlan.Corner(plan, 2, height),
			NeverlandPlan.Corner(plan, 3, height),
		}
		if not hammered then
			local grow = math.min(t / 0.4, 1)
			for i, star in stars do
				star.place(plan.start + UP * height + (corners[i] - (plan.start + UP * height)) * grow, t * 3 + i)
			end
			poseTriangle(beams, corners)
		end

		-- Each punch: a flash of starlight where he appears, then the hit.
		local strike = NeverlandPlan.StrikeAt(t)
		if strike and strike > struck then
			struck = strike
			local at = times.Strikes[strike]
			U.flash(corners[((strike - 1) % 3) + 1], STAR_WHITE, 4, 0.15)
			task.delay(math.max(at - t, 0), function()
				local clip = punchClip(((strike - 1) % 3) + 1, "Normal")
				if clip then
					play(character, clip)
				end
				local victim = plan.start + UP * NeverlandPlan.Height(at)
				U.shockwave(victim, STAR, 1, 7, 0.2)
				gust(victim, 4)
				U.burst(victim, {
					color = STAR,
					count = 10,
					size = 0.35,
					speed = NumberRange.new(14, 30),
					lifetime = NumberRange.new(0.15, 0.3),
					streaks = true,
					spread = 180,
				})
				if mine then
					CameraShake.Add(0.12)
				end
			end)
		end

		-- The hammer, from above, and a great triangle halfway down for them
		-- to fall through.
		if not hammered and t >= times.Apex then
			hammered = true
			for _, star in stars do
				star.fade(0.2)
			end
			fadeOut(beams, 0.2)
			local clip = punchClip(4, "Downslam")
			if clip then
				play(character, clip)
			end
			local middle = plan.start + UP * (NeverlandPlan.Height(times.Slam) * 0.5)
			local big = {}
			for i = 1, 3 do
				big[i] = middle + (NeverlandPlan.Corner(plan, i, 0) - plan.start) * 1.9
				local star = makeStar(3.4)
				star.place(big[i], i)
				table.insert(bigStars, star)
			end
			bigBeams = triangleBeams(0.5)
			poseTriangle(bigBeams, big)
			U.flash(plan.start + UP * NeverlandPlan.Height(times.Slam), STAR_WHITE, 9, 0.2)
			if mine then
				CameraShake.Add(0.3)
				CameraShake.FovKick(10)
			end
		end
	end)
	task.delay(times.Length + 0.5, function()
		finish()
		for _, star in bigStars do
			star.fade(0.4)
		end
		fadeOut(bigBeams, 0.4)
		U.tween(dome, 0.5, { Transparency = 1 })
		task.delay(0.55, dome.Destroy, dome)
	end)

	-- The camera, for the two of them: round them as they rise, after them
	-- on the way down.
	if mine then
		Cinematic.Camera(function(t)
			local focus = NeverlandPlan.Victim(plan, math.min(t, times.Land)).Position
			local right = plan.forward:Cross(UP)
			local angle = 0.6 + t * 0.45
			local offset = (right * math.cos(angle) - plan.forward * math.sin(angle)) * 17
				+ UP * (3 + math.min(t, times.Apex) * 1.2)
			return CFrame.lookAt(focus + offset, focus), if t > times.Apex then 80 else 70
		end, times.Length + 0.3)
	end
end

function handlers.Neverland(data, character, root)
	local phase = data.phase
	if phase == "Reach" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, root.CFrame.LookVector)
		end
	elseif phase == "Whiff" then
		gust(root.Position + root.CFrame.LookVector * 4, 2)
	elseif phase == "Begin" then
		playNeverland(data, character, root)
	elseif phase == "Impact" then
		local position: Vector3 = data.position
		U.shockwave(position, STAR, 3, 30, 0.5)
		U.ringBurst(CFrame.new(position + UP * 0.2), STAR_WHITE, 2, 18, 0.45, 0.4)
		U.groundCracks(position, 10, 10, WIND, 1.5)
		U.groundRocks(position, 10, 7, 1.6)
		U.debris(position, 16, 40, 0.9)
		U.pillar(position, STAR, 3, 24, 0.4, Enum.Material.ForceField, 0.2)
		gust(position + UP, 9, UP)
		U.light(position, STAR, 6, 40, 0.6)
		if (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 60 then
			CameraShake.Add(0.4)
		end
	elseif phase == "Dome" then
		local center: Vector3 = data.center
		local radius: number = data.radius
		local old = domes[character]
		if old then
			old.close()
		end
		local dome = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * radius * 2,
			CFrame = CFrame.new(center),
			Color = WIND,
			Material = Enum.Material.ForceField,
			Transparency = 1,
		})
		U.tween(dome, 0.4, { Transparency = 0.25 })
		local rim: { Star } = {}
		for _ = 1, 10 do
			table.insert(rim, makeStar(1.6))
		end
		local closed = false
		local function close()
			if closed then
				return
			end
			closed = true
			domes[character] = nil
			U.tween(dome, 0.5, { Transparency = 1 })
			task.delay(0.55, dome.Destroy, dome)
			for _, star in rim do
				star.fade(0.4)
			end
		end
		domes[character] = { close = close }
		every(data.duration, function(elapsed)
			if closed then
				return false
			end
			for i, star in rim do
				local angle = i / #rim * math.pi * 2 + elapsed * 0.4
				star.place(
					center
						+ Vector3.new(
							math.cos(angle) * radius,
							1.5 + math.sin(elapsed * 2 + i) * 0.5,
							math.sin(angle) * radius
						),
					elapsed * 2
				)
			end
			return true
		end, close)
	end
end

---------------------------------------------------------------------------
-- Half-Crown / Full-Crown: transformations and looks
---------------------------------------------------------------------------

-- Sylph circles in and merges into him at the burst; wind gathers, then
-- blasts out.
local function transformation(data, character: Model, root: BasePart, full: boolean)
	if data.phase == "Start" then
		play(character, if full then ANIMS.Ascend else ANIMS.Awaken)
		local sylph = makeSprite(1.4)
		every(0.8, function(elapsed)
			if not root.Parent then
				return false
			end
			local t = elapsed / 0.8
			local angle = t * math.pi * 4
			local radius = 5 * (1 - t) + 0.5
			sylph.place(
				CFrame.new(root.Position + Vector3.new(math.cos(angle) * radius, 3 - t * 2, math.sin(angle) * radius)),
				elapsed
			)
			inflow(root.Position, 7)
			return true
		end, function()
			sylph.fade(0.15)
		end)
		if full then
			U.spiral(root, WIND, 4, 10, 1.3, 4, 0.2, 0.5)
		end
		U.ringBurst(CFrame.new(root.Position - UP * 2.8), WIND, 12, 2, 0.8, 0.2)
	elseif data.phase == "Burst" then
		local position = root.Position
		U.shockwave(position, WIND, 3, if full then 40 else 28, 0.6, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, if full then 22 else 16, 0.5, 0.4)
		U.pillar(position - UP * 3, WIND, 4, if full then 40 else 26, 0.6, Enum.Material.ForceField, 0.3)
		U.burst(position, {
			color = WIND_WHITE,
			count = 40,
			size = 0.6,
			speed = NumberRange.new(40, 90),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if full then
			U.flash(position + UP * 3, STAR, 10, 0.3)
		end
		U.light(position, WIND, 6, 40, 0.8)
		if U.isLocal(character) then
			U.colorGrade({ Brightness = 0.15, Saturation = 0.3 }, 0, 0.1, 0.5)
			CameraShake.Add(0.35)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "End" then
		gust(root.Position, 6)
	end
end

function handlers.Awaken(data, character, root)
	transformation(data, character, root, false)
end

function handlers.Ascend(data, character, root)
	transformation(data, character, root, true)
end

-- The look. Half-Crown: green mana coats his left side (where Sylph sits),
-- a wing of wind grows from his left shoulder blade and half a crown of
-- gold leaves forms over his left temple. Full-Crown: both sides, both
-- wings, the whole crown, and a two-handed sword of wind. Either way his
-- grimoire comes out and circles him, open, pages fluttering. Anchored
-- parts posed every frame round his body; they fade in.
local GRIMOIRE_COVER = Color3.fromRGB(28, 70, 58)
local GRIMOIRE_PAPER = Color3.fromRGB(226, 234, 214)

-- Feathers per wing: long primaries fanned high and wide (with a shimmer of
-- wind over them) behind shorter coverts nearer the shoulder. Spread is
-- degrees up from straight out; back is how far they sweep behind him.
local WING_LAYERS = {
	{ count = 5, from = 10, to = 82, length = 3.9, shrink = 0.3, width = 0.72, back = 0.62, shimmer = true },
	{ count = 4, from = 4, to = 62, length = 2.1, shrink = 0.22, width = 0.56, back = 0.48, shimmer = false },
}

type Feather = {
	vane: BasePart,
	tip: BasePart,
	core: BasePart,
	shell: BasePart?,
	layer: { [string]: any },
	index: number,
	length: number,
}
type Spike = { left: BasePart, right: BasePart, angle: number, height: number }
type Page = { part: BasePart, offset: CFrame, side: number }

local function buildLook(character: Model, full: boolean): () -> ()
	local torso = character:FindFirstChild("Torso") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = U.getRoot(character)
	if not torso or not head or not root then
		return function() end
	end
	local look = { hideSword = 0 }
	looks[character] = look
	local entries: { { part: BasePart, base: number } } = {}
	local function part(props: { [string]: any }, base: number, wedge: boolean?): BasePart
		local p: BasePart
		if wedge then
			p = Instance.new("WedgePart")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			for key, value in props do
				(p :: any)[key] = value
			end
			p.Parent = U.folder
		else
			p = U.newPart(props)
		end
		p.Transparency = 1
		table.insert(entries, { part = p, base = base })
		return p
	end
	local sides = if full then { -1, 1 } else { -1 } -- -1: his left

	-- Wings.
	local wings: { { side: number, feathers: { Feather } } } = {}
	local emitters: { ParticleEmitter } = {}
	for _, side in sides do
		local feathers: { Feather } = {}
		for _, layer in WING_LAYERS do
			for i = 1, layer.count do
				local length = layer.length - (i - 1) * layer.shrink
				local tip =
					part({ Size = Vector3.new(0.07, layer.width * 0.72, layer.width * 0.72), Color = WIND }, 0.3)
				table.insert(feathers, {
					vane = part({ Size = Vector3.new(0.07, layer.width, length), Color = WIND }, 0.32),
					tip = tip,
					core = part({ Size = Vector3.new(0.09, 0.07, length), Color = WIND_WHITE }, 0.1),
					shell = if layer.shimmer
						then part({
							Size = Vector3.new(0.18, layer.width * 1.35, length * 1.05),
							Color = WIND,
							Material = Enum.Material.ForceField,
						}, 0)
						else nil,
					layer = layer,
					index = i,
					length = length,
				})
				-- Wisps of wind streaming off the longest feathers' tips.
				if layer.shimmer and i <= 2 then
					local wisp = Instance.new("ParticleEmitter")
					wisp.Texture = U.textures.Smoke
					wisp.Color = ColorSequence.new(WIND_WHITE, WIND)
					wisp.LightEmission = 1
					wisp.LightInfluence = 0
					wisp.Size = NumberSequence.new(0.35, 0)
					wisp.Transparency = NumberSequence.new(0.4, 1)
					wisp.Lifetime = NumberRange.new(0.3, 0.5)
					wisp.Rate = 14
					wisp.Speed = NumberRange.new(0.5, 1)
					wisp.Parent = tip
					table.insert(emitters, wisp)
				end
			end
		end
		table.insert(wings, { side = side, feathers = feathers })
	end

	-- Crown: a gold band and leaf-shaped spikes (two wedges back to back),
	-- the tallest at the front (Full-Crown) or over his left temple (Half).
	local spikes: { Spike } = {}
	local spikeCount = if full then 10 else 5
	for i = 1, spikeCount do
		local angle, height
		if full then
			angle = (i - 1) / spikeCount * math.pi * 2
			height = if i == 1 then 1 elseif i % 2 == 1 then 0.72 else 0.48
		else
			local f = (i - 1) / (spikeCount - 1)
			angle = -(0.1 + 0.8 * f) * math.pi
			height = 0.45 + 0.5 * math.sin(f * math.pi)
		end
		table.insert(spikes, {
			left = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			right = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			angle = angle,
			height = height,
		})
	end
	local bandCount = if full then 16 else 8
	local band = {}
	for _ = 1, bandCount do
		table.insert(band, part({ Size = Vector3.new(0.09, 0.14, 0.3), Color = STAR }, 0.05))
	end
	local gem = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.22, Color = WIND }, 0)

	-- Green mana coating the marked side: a shimmering shell over the arm,
	-- the leg and that half of the torso.
	local shells: { { part: BasePart, limb: BasePart, offset: CFrame } } = {}
	for _, side in sides do
		for _, name in { if side < 0 then "Left Arm" else "Right Arm", if side < 0 then "Left Leg" else "Right Leg" } do
			local limb = character:FindFirstChild(name) :: BasePart?
			if limb then
				table.insert(shells, {
					part = part({
						Size = limb.Size + Vector3.new(0.08, 0.08, 0.08),
						Color = WIND,
						Material = Enum.Material.ForceField,
					}, 0),
					limb = limb,
					offset = CFrame.identity,
				})
			end
		end
		table.insert(shells, {
			part = part({ Size = Vector3.new(1.06, 2.08, 1.08), Color = WIND, Material = Enum.Material.ForceField }, 0),
			limb = torso,
			offset = CFrame.new(side * 0.5, 0, 0),
		})
		local arm = character:FindFirstChild(if side < 0 then "Left Arm" else "Right Arm") :: BasePart?
		if arm then
			local wisp = Instance.new("ParticleEmitter")
			wisp.Texture = U.textures.Smoke
			wisp.Color = ColorSequence.new(WIND)
			wisp.LightEmission = 0.8
			wisp.LightInfluence = 0
			wisp.Size = NumberSequence.new(0.5, 0)
			wisp.Transparency = NumberSequence.new(0.5, 1)
			wisp.Lifetime = NumberRange.new(0.4, 0.7)
			wisp.Rate = 18
			wisp.Speed = NumberRange.new(0.5, 1.5)
			wisp.Acceleration = Vector3.new(0, 3, 0)
			wisp.Parent = arm
			table.insert(emitters, wisp)
		end
	end

	-- His grimoire: a dark green book with a four-leaf clover of light over
	-- its open pages.
	local book: { Page } = {}
	local function page(props: { [string]: any }, base: number, offset: CFrame, side: number)
		table.insert(book, { part = part(props, base), offset = offset, side = side })
	end
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			0.05,
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, 0, CFrame.new(0, 1.05, -0.4), 0)
	local bookLight = Instance.new("PointLight")
	bookLight.Color = WIND
	bookLight.Range = 8
	bookLight.Brightness = 1.5
	bookLight.Parent = book[#book].part

	-- The wind sword (Full-Crown), in the right hand.
	local sword: { BasePart }? = nil
	if full then
		sword = {
			part({ Size = Vector3.new(0.22, 1.1, 0.22), Color = WIND_DEEP }, 0),
			part({ Size = Vector3.new(1.5, 0.18, 0.32), Color = STAR }, 0),
			part({ Size = Vector3.new(0.2, 5.6, 0.85), Color = WIND }, 0.25),
			part({ Size = Vector3.new(0.1, 5.4, 0.28), Color = WIND_WHITE }, 0),
			part({ Size = Vector3.new(0.3, 5.9, 1.15), Color = WIND, Material = Enum.Material.ForceField }, 0),
		}
	end

	local start = os.clock()
	local connection: RBXScriptConnection
	local function destroy()
		connection:Disconnect()
		if looks[character] == look then
			looks[character] = nil
		end
		for _, emitter in emitters do
			emitter.Enabled = false
			task.delay(1, emitter.Destroy, emitter)
		end
		local parts = {}
		for _, entry in entries do
			table.insert(parts, entry.part)
		end
		fadeOut(parts, 0.4)
	end
	connection = RunService.RenderStepped:Connect(function()
		if not torso.Parent or not head.Parent or not root.Parent then
			-- He's gone (died, left): the look goes with him.
			destroy()
			return
		end
		local t = os.clock() - start
		local alpha = math.min(t / 0.5, 1)
		for _, entry in entries do
			entry.part.Transparency = 1 - (1 - entry.base) * alpha
		end

		-- Wings: each feather fanned out from the shoulder blade, a slow
		-- beat rippling out along the wing (the tips move most).
		local back = -torso.CFrame.LookVector
		for _, wing in wings do
			local base = torso.CFrame * Vector3.new(wing.side * 0.45, 0.55, 0.55)
			for _, feather in wing.feathers do
				local layer = feather.layer
				local f = if layer.count > 1 then (feather.index - 1) / (layer.count - 1) else 0
				local flap = math.sin(t * 2.1 - feather.index * 0.35) * (6 + f * 6)
				local angle = rad(layer.from + (layer.to - layer.from) * f + flap)
				local localDirection =
					Vector3.new(wing.side * math.cos(angle), math.sin(angle) * 0.95 + 0.05, layer.back).Unit
				local direction = torso.CFrame:VectorToWorldSpace(localDirection)
				local across = direction:Cross(back)
				local up = if across.Magnitude > 1e-3 then across.Unit else UP
				local center = base + direction * (feather.length / 2)
				local frame = CFrame.lookAt(center, center + direction, up)
				feather.vane.CFrame = frame
				feather.core.CFrame = frame
				if feather.shell then
					feather.shell.CFrame = frame
				end
				local tipAt = base + direction * feather.length
				feather.tip.CFrame = CFrame.lookAt(tipAt, tipAt + direction, up) * CFrame.Angles(rad(45), 0, 0)
			end
		end

		-- Crown.
		local crown = head.CFrame * CFrame.new(0, 0.3, 0)
		local function around(a: number): Vector3
			return Vector3.new(math.sin(a), 0, -math.cos(a))
		end
		local function along(a: number): Vector3
			return crown:VectorToWorldSpace(Vector3.new(math.cos(a), 0, math.sin(a)))
		end
		for i, segment in band do
			local a = if full then (i - 0.5) / bandCount * math.pi * 2 else -((i - 0.5) / bandCount) * math.pi
			local position = crown * (around(a) * 0.66)
			segment.CFrame = CFrame.lookAt(position, position + along(a), crown.UpVector)
		end
		for _, spike in spikes do
			local center = crown * (around(spike.angle) * 0.66) + crown.UpVector * (spike.height / 2 + 0.05)
			local frame = CFrame.lookAt(center, center + along(spike.angle), crown.UpVector)
			local half = spike.left.Size.Z / 2
			spike.left.CFrame = frame * CFrame.new(0, 0, -half)
			spike.right.CFrame = frame * CFrame.new(0, 0, half) * CFrame.Angles(0, math.pi, 0)
		end
		gem.CFrame =
			CFrame.new(crown * ((if full then around(0) else around(-math.pi / 2)) * 0.7 + Vector3.new(0, 0.12, 0)))

		-- Mana.
		for _, shell in shells do
			if shell.limb.Parent then
				shell.part.CFrame = shell.limb.CFrame * shell.offset
			end
		end

		-- Grimoire: circling him, turned to keep its pages towards him.
		local orbit = t * 1.15
		local position = root.Position
			+ Vector3.new(math.cos(orbit) * 3, 1.3 + math.sin(t * 2.1) * 0.3, math.sin(orbit) * 3)
		local bookFrame = CFrame.lookAt(position, root.Position + UP * 1.3) * CFrame.Angles(rad(-15), 0, 0)
		local open = rad((62 + math.sin(t * 6) * 6) * alpha)
		for _, p in book do
			local hinge = CFrame.Angles(0, -p.side * open, 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = bookFrame * hinge * spin * p.offset
		end

		-- Sword.
		if sword then
			local arm = character:FindFirstChild("Right Arm") :: BasePart?
			if arm then
				local grip = arm.CFrame * CFrame.new(0, -1.1, 0) * CFrame.Angles(rad(-90), 0, 0)
				sword[1].CFrame = grip
				sword[2].CFrame = grip * CFrame.new(0, 0.6, 0)
				sword[3].CFrame = grip * CFrame.new(0, 3.5, 0)
				sword[4].CFrame = grip * CFrame.new(0, 3.5, 0)
				sword[5].CFrame = grip * CFrame.new(0, 3.55, 0)
			end
			if os.clock() < look.hideSword then
				for _, p in sword do
					p.Transparency = 1
				end
			end
		end
	end)

	return function()
		if connection.Connected then
			destroy()
		end
	end
end

local destroyLook: { [Model]: () -> () } = {}
local stageWatch: { [Model]: RBXScriptConnection } = {}

function Kit.SetAwakened(character: Model, on: boolean)
	local watch = stageWatch[character]
	if watch then
		watch:Disconnect()
		stageWatch[character] = nil
	end
	local destroy = destroyLook[character]
	if destroy then
		destroyLook[character] = nil
		destroy()
	end
	if not on then
		return
	end
	local function rebuild()
		local old = destroyLook[character]
		if old then
			old()
		end
		destroyLook[character] = buildLook(character, character:GetAttribute("Ascended") == true)
	end
	rebuild()
	stageWatch[character] = character:GetAttributeChangedSignal("Ascended"):Connect(function()
		if character:GetAttribute("Awakened") == true then
			rebuild()
		end
	end)
end

---------------------------------------------------------------------------
-- Spawn entrance
---------------------------------------------------------------------------

-- A grimoire of its own (the Crown look poses its own copy): dark green
-- covers, open pages, a four-leaf clover of light turning over them.
type Book = { place: (CFrame, number, number) -> (), fade: (number) -> () }

local function makeBook(): Book
	local pages: { { part: BasePart, offset: CFrame, side: number } } = {}
	local function page(props: { [string]: any }, offset: CFrame, side: number)
		table.insert(pages, { part = U.newPart(props), offset = offset, side = side })
	end
	local cover = Color3.fromRGB(28, 70, 58)
	local paper = Color3.fromRGB(226, 234, 214)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, CFrame.new(0, 1.05, -0.4), 0)
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 8
	light.Brightness = 2
	light.Parent = pages[#pages].part
	local book = {}
	function book.place(frame: CFrame, open: number, t: number)
		for _, p in pages do
			local hinge = CFrame.Angles(0, -p.side * rad(open), 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = frame * hinge * spin * p.offset
		end
	end
	function book.fade(duration: number)
		light.Enabled = false
		local parts = {}
		for _, p in pages do
			table.insert(parts, p.part)
		end
		fadeOut(parts, duration)
	end
	return book
end

-- Wind gathers round him and his grimoire comes down out of the sky to
-- him, circling him as it opens, Sylph darting about; he reaches for it,
-- the clover flares and the wind bursts out, and Sylph is gone into him.
function handlers.Entrance(data, character, root)
	if data.phase ~= "Start" then
		return
	end
	play(character, ANIMS.Entrance)
	local book = makeBook()
	local sylph = makeSprite(1.2)
	every(2.2, function(elapsed)
		if not root.Parent then
			return false
		end
		local forward = root.CFrame.LookVector
		local right = root.CFrame.RightVector
		local position, open
		if elapsed < 0.6 then
			local eased = 1 - (1 - elapsed / 0.6) ^ 2
			position = root.Position + forward * 2.5 + UP * (1.5 + 18 * (1 - eased)) + right * 6 * (1 - eased)
			open = 0
		elseif elapsed < 1.2 then
			local a = (elapsed - 0.6) / 0.6
			local angle = a * math.pi * 2
			position = root.Position + (forward * math.cos(angle) + right * math.sin(angle)) * 2.5 + UP * 1.5
			open = 70 * a
		else
			position = root.Position + forward * 2.2 + UP * (1.8 + math.min((elapsed - 1.2) * 2, 0.8))
			open = 70
		end
		book.place(CFrame.lookAt(position, root.Position + UP * 1.5) * CFrame.Angles(rad(-15), 0, 0), open, elapsed)
		if elapsed < 1.2 then
			local angle = elapsed * 7
			sylph.place(
				CFrame.new(
					root.Position
						+ Vector3.new(math.cos(angle) * 3.5, 1.5 + math.sin(elapsed * 9), math.sin(angle) * 3.5)
				),
				elapsed
			)
			inflow(root.Position, 7)
		end
		return true
	end, function()
		book.fade(0.3)
	end)
	U.spiral(root, WIND, 3, 6, 1.2, 3, 0.1, 0.4)
	task.delay(1.2, function()
		sylph.fade(0.15)
		if not root.Parent then
			return
		end
		local position = root.Position
		gust(position + UP, 8, UP)
		U.shockwave(position, WIND, 3, 20, 0.45, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, 14, 0.4, 0.35)
		U.flash(position + root.CFrame.LookVector * 2.2 + UP * 2, STAR, 6, 0.25)
		U.light(position, WIND, 5, 26, 0.5)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(8)
		end
	end)
end

---------------------------------------------------------------------------
-- Movement: a green dash on the wind, and the gust under his air jump
---------------------------------------------------------------------------

local DASH_VECTORS = {
	Front = Vector3.new(0, 0, -1),
	Back = Vector3.new(0, 0, 1),
	Left = Vector3.new(-1, 0, 0),
	Right = Vector3.new(1, 0, 0),
}

VFX.RegisterKitEffect("Wind", "Dash", function(data)
	local character: Model? = data.character
	local root = U.getRoot(character)
	if not character or not root then
		return
	end
	local direction = if type(data.direction) == "string" then data.direction else "Front"
	U.afterimage(character, WIND, 0.3)
	for i = 1, 3 do
		task.delay(i * 0.05, function()
			if character.Parent then
				U.afterimage(character, if i == 3 then WIND_WHITE else WIND, 0.25)
			end
		end)
	end
	U.bodyTrail(character, WIND, 0.28)
	local ground = U.groundBelow(root.Position, { character })
	local feet = if ground then ground.Position else root.Position - UP * 3
	U.ringBurst(CFrame.new(feet + UP * 0.1), WIND, 0.6, 3.8, 0.25, 0.14)
	local away = -(root.CFrame:VectorToWorldSpace(DASH_VECTORS[direction] or DASH_VECTORS.Front))
	U.burst(root.Position - UP * 0.5, {
		color = WIND_WHITE,
		count = 10,
		size = 0.35,
		speed = NumberRange.new(16, 30),
		lifetime = NumberRange.new(0.12, 0.25),
		streaks = true,
		spread = 35,
		direction = away,
	})
	U.light(root.Position, WIND, 2, 10, 0.25)
end)

VFX.RegisterKitEffect("Wind", "AirJump", function(data)
	local character: Model? = data.character
	local root = U.getRoot(character)
	if not character or not root then
		return
	end
	local feet = root.Position - UP * 3
	U.ringBurst(CFrame.new(feet), WIND, 0.8, 4.2, 0.3, 0.16)
	U.burst(feet, {
		color = WIND_WHITE,
		count = 12,
		size = 0.4,
		speed = NumberRange.new(12, 26),
		lifetime = NumberRange.new(0.15, 0.3),
		streaks = true,
		spread = 50,
		direction = -UP,
	})
	U.afterimage(character, WIND, 0.2)
end)

function Kit.OnSkill(data)
	local character = data.character
	if typeof(character) ~= "Instance" or not character:IsA("Model") then
		return
	end
	local root = U.getRoot(character)
	local handler = handlers[data.skill]
	if root and handler then
		handler(data, character, root)
	end
end

return Kit
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="38">
              <Properties>
                <string name="Name">Animations</string>
                <string name="Source"><![CDATA[--[[
	Prince of Wind (Yuno) animation data.

	GENERATED by tools/anim/yuno_anims.py (feet checked against an R6 model
	of the rig at every keyframe and in between). Edit the Python and re-run
	it instead of editing this file by hand.

	Each animation: keys = { {time, pose, easingStyle?, easingDirection?}, ... }
	  rot(x, y, z)          torso/head/leg rotation (degrees)
	  body(dy, x, y, z)     torso lowered/raised dy studs, then rotated
	  limb(pitch, yaw, roll) arm/leg aim (degrees)
]]

local rad = math.rad

local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

local function body(dy: number, x: number, y: number?, z: number?): CFrame
	return CFrame.new(0, dy, 0) * CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

local function limb(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, rad(yaw or 0), 0) * CFrame.Angles(0, 0, rad(roll or 0)) * CFrame.Angles(rad(pitch), 0, 0)
end

local Animations = {}

-- Standing: calm, turned a little, the left hand loose in front where the wind gathers.
Animations.Idle = {
	loop = true,
	delays = { Head = 0.12, RightArm = 0.1, LeftArm = 0.2 },
	keys = {
		{
			0,
			{
				Torso = body(0.093, -3, 12),
				Head = rot(2, -10),
				RightArm = limb(12, 4, 10),
				LeftArm = limb(30, -8, -16),
				RightLeg = rot(-4, 0, 6),
				LeftLeg = rot(6, 0, -7),
			},
		},
		{
			1.4,
			{
				Torso = body(0.079, -1, 12),
				Head = rot(4, -14),
				RightArm = limb(15, 4, 11),
				LeftArm = limb(34, -8, -18),
				RightLeg = rot(-4, 0, 6),
				LeftLeg = rot(6, 0, -7),
			},
			"Sine",
			"InOut",
		},
		{
			2.8,
			{
				Torso = body(0.093, -3, 12),
				Head = rot(2, -10),
				RightArm = limb(12, 4, 10),
				LeftArm = limb(30, -8, -16),
				RightLeg = rot(-4, 0, 6),
				LeftLeg = rot(6, 0, -7),
			},
			"Sine",
			"InOut",
		},
	},
}

-- Moving: a light sprint, both arms swinging. Plays with the distance travelled (RUN_STRIDE studs a loop).
Animations.Run = {
	loop = true,
	delays = { Head = 0.03, RightArm = 0.03, LeftArm = 0.03 },
	keys = {
		{
			0,
			{
				Torso = body(0.03, -14.05, 0, 3),
				Head = rot(12.84, 0, -3),
				RightArm = limb(6, 0, 8),
				LeftArm = limb(6, 0, -8),
				RightLeg = limb(21, 0, -1.8),
				LeftLeg = limb(21, 0, -1.8),
			},
		},
		{
			0.062,
			{
				Torso = body(0.04, -14.07, -2.3, 2.77),
				Head = rot(12.81, 2.3, -2.77),
				RightArm = limb(-11.6, -3.06, 8.44),
				LeftArm = limb(23.6, -3.06, -8.44),
				RightLeg = limb(40.13, 2.3, -1.66),
				LeftLeg = limb(1.87, 2.3, -1.66),
			},
			"Linear",
			"Out",
		},
		{
			0.125,
			{
				Torso = body(0.09, -14.49, -4.24, 2.12),
				Head = rot(12.24, 4.24, -2.12),
				RightArm = limb(-26.53, -5.66, 9.5),
				LeftArm = limb(38.53, -5.66, -9.5),
				RightLeg = limb(56.36, 4.24, -1.27),
				LeftLeg = limb(-14.36, 4.24, -1.27),
			},
			"Linear",
