      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">BlackMoon</string>
          <string name="Source"><![CDATA[--[[
	BlackMoon
	The timeline of Black Moon (Asta's Black Form 4th move): he hurls them
	into the sky, night falls, he hangs in front of a giant moon, then flies
	through them and cuts them down.

	Shared so the server (which holds both fighters on these paths) and
	every client (which draws them there smoothly, with the camera work and
	effects) agree on where everyone is at every moment. Everything is
	worked out from where he stood when he threw them. t = 0 is the throw.
]]

local BlackMoon = {}

-- About six seconds, plus the grab before it.
BlackMoon.Times = {
	Release = 0.15, -- they leave his hand
	Night = 0.5, -- night starts to fall
	Rise = 0.6, -- shot: watching them rise against the moon
	Leap = 1.0, -- he jumps up after them
	Apex = 1.35, -- they reach the top
	Perch = 1.4, -- he's hovering in front of the moon
	Close = 2.5, -- shot: close on him, the moon behind
	Point = 2.9, -- he levels the sword at them
	Glint = 3.4, -- the blade catches the moonlight
	Fly = 3.75, -- he flies at them
	Cut = 3.9, -- passing through them
	Arrive = 4.0, -- stopped past them, back turned; everything goes still
	Land = 4.9, -- the cut lands; both are let go
	Done = 5.9, -- the camera comes back
}

local UP = Vector3.yAxis
local DRIFT = 1.2 -- studs a second they keep rising after the top

export type Plan = {
	origin: CFrame, -- his root at the throw, level
	forward: Vector3,
	right: Vector3,
	victimStart: Vector3,
	apex: Vector3, -- where they hang in the sky
	cut: Vector3, -- where they are when he passes through them
	perch: Vector3, -- where he waits, in front of the moon
	through: Vector3, -- direction of his flight
	beyond: Vector3, -- where he stops after the cut
	moonCamera: Vector3, -- the camera for the moon shot
	moon: Vector3, -- the moon, behind him from that camera
	moonRadius: number,
}

local function flat(v: Vector3, fallback: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else fallback
end

local function easeOut(a: number): number
	return 1 - (1 - a) * (1 - a)
end

function BlackMoon.Plan(origin: CFrame, victimStart: Vector3): Plan
	local forward = flat(origin.LookVector, Vector3.new(0, 0, -1))
	local right = forward:Cross(UP)
	local level = CFrame.lookAt(origin.Position, origin.Position + forward)
	local apex = origin.Position + forward * 5 + UP * 34
	local perch = apex - forward * 22 - UP * 5 + right * 5
	-- They keep drifting up while he hovers, so he aims where they'll be.
	local cut = apex + UP * (BlackMoon.Times.Cut - BlackMoon.Times.Apex) * DRIFT
	local through = (cut - perch).Unit
	local beyond = cut + through * 14
	-- The moon shot looks up at him from below, so the moon sits behind him.
	local moonCamera = apex + (perch - apex) * 0.2 + right * 2.5 - UP * 7
	local moon = perch + (perch - moonCamera).Unit * 280 + UP * 10
	return {
		origin = level,
		forward = forward,
		right = right,
		victimStart = victimStart,
		apex = apex,
		cut = cut,
		perch = perch,
		through = through,
		beyond = beyond,
		moonCamera = moonCamera,
		moon = moon,
		moonRadius = 95,
	}
end

-- Where Asta's root is at time t.
function BlackMoon.Attacker(plan: Plan, t: number): CFrame
	local T = BlackMoon.Times
	local toVictim = flat(plan.apex - plan.perch, plan.forward)
	if t < T.Leap then
		return plan.origin
	elseif t < T.Perch then
		-- The leap: an arc up to the perch.
		local a = (t - T.Leap) / (T.Perch - T.Leap)
		local p = plan.origin.Position:Lerp(plan.perch, easeOut(a)) + UP * math.sin(a * math.pi) * 4
		return CFrame.lookAt(p, p + toVictim)
	elseif t < T.Fly then
		-- Hovering on his wings: rising and falling with the beats, drifting.
		local hover = t - T.Perch
		local p = plan.perch + UP * math.sin(hover * 5.3) * 0.6 + plan.right * math.sin(hover * 1.8) * 0.35
		return CFrame.lookAt(p, p + toVictim)
	elseif t < T.Arrive then
		-- Straight through them, flat out.
		local a = (t - T.Fly) / (T.Arrive - T.Fly)
		local p = plan.perch:Lerp(plan.beyond, a)
		return CFrame.lookAt(p, p + toVictim)
	end
	return CFrame.lookAt(plan.beyond, plan.beyond + toVictim)
end

-- Where the victim's root is at time t: hurled up, drifting and tumbling
-- at the top, then frozen still from the cut until it lands.
function BlackMoon.Victim(plan: Plan, t: number): CFrame
	local T = BlackMoon.Times
	local facing = flat(plan.perch - plan.apex, -plan.forward)
	local held = math.min(t, T.Cut)
	local p
	if held < T.Release then
		p = plan.victimStart
	elseif held < T.Apex then
		p = plan.victimStart:Lerp(plan.apex, easeOut((held - T.Release) / (T.Apex - T.Release)))
	else
		p = plan.apex + UP * (held - T.Apex) * DRIFT
	end
	local tumble = math.max(held - T.Release, 0) * math.rad(110)
	return CFrame.lookAt(p, p + facing) * CFrame.Angles(-tumble, 0, 0)
end

--[[
	The camera for the two people in the cutscene: (cframe, field of view).
	Shots: the throw from low behind him; a wide low shot of them rising
	against the moon as he leaps after them; the moon shot (him a
	silhouette in front of it, slowly pushing in); a close-up circling him
	as he levels the sword; the flight straight at the camera through them;
	the frozen moment after the cut, circling slowly. After the cut lands
	the client follows them down.
]]
local function orbit(center: Vector3, eye: Vector3, degrees: number): Vector3
	return center + CFrame.Angles(0, math.rad(degrees), 0):VectorToWorldSpace(eye - center)
end

function BlackMoon.Camera(plan: Plan, t: number): (CFrame, number)
	local T = BlackMoon.Times
	local attacker = BlackMoon.Attacker(plan, t).Position
	local victim = BlackMoon.Victim(plan, t).Position
	if t < T.Rise then
		local eye = (plan.origin * CFrame.new(5.5, 1.2, 7)).Position
		return CFrame.lookAt(eye, (attacker + UP * 2):Lerp(victim, 0.65)), 70
	elseif t < T.Perch then
		-- From the ground out in front, looking back up past them at the moon.
		local eye = plan.origin.Position + plan.forward * 26 + plan.right * 6 + UP * 2.5
		return CFrame.lookAt(eye, victim:Lerp(plan.perch, 0.35)), 62
	elseif t < T.Close then
		local eye = plan.moonCamera:Lerp(plan.perch, 0.05 * (t - T.Perch))
		return CFrame.lookAt(eye, attacker + UP * 0.5), 45
	elseif t < T.Fly then
		-- Close and a little below him, drifting round; the moon fills the back.
		local start = plan.perch + (plan.moonCamera - plan.perch).Unit * 10 - UP * 1.5
		local eye = orbit(plan.perch, start, (t - T.Close) * 10 - 6)
		return CFrame.lookAt(eye, attacker + UP * 1), 38
	elseif t < T.Arrive then
		local eye = plan.cut + plan.through * 10 + plan.right * 3 + UP * 1.5
		return CFrame.lookAt(eye, plan.perch), 55
	end
	local start = plan.beyond + plan.through * 8 - plan.right * 2.5 + UP * 1
	local eye = orbit(plan.beyond, start, (t - T.Arrive) * -14)
	return CFrame.lookAt(eye, plan.beyond - plan.through * 6), 50
end

return BlackMoon
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">CombatState</string>
          <string name="Source"><![CDATA[--[[
	CombatState
	Combat state is stored as attributes on the character model. Attributes
	replicate, so the server writes them and clients read them to gate input
	and drive the HUD. Timestamps use server time so both sides agree.
]]

local CombatState = {}

local DEFAULTS = {
	StunUntil = 0,
	BusyUntil = 0, -- swinging: slowed, can't jump
	CastUntil = 0, -- using a skill: locked out of everything else
	IFrameUntil = 0,
	Blocking = false,
	BlockStart = 0,
	Ragdolled = false,
	Evasive = 0,
	Awakening = 0, -- meter, 0 to Config.Awakening.Max
	Awakened = false,
	Rooted = false, -- can't move (e.g. during a spawn entrance)
}

-- Skill slots 1-4. "CD<n>" is the server time the skill is ready again,
-- "CDLen<n>" how long that cooldown was (for drawing the HUD sweep).
CombatState.SkillSlots = 4
-- The R special uses the same attributes as slot 5. It isn't part of the
-- move set, so awakening doesn't reset it.
CombatState.SpecialSlot = 5

local function now(): number
	return workspace:GetServerTimeNow()
end
CombatState.Now = now

function CombatState.Setup(character: Model)
	for name, value in DEFAULTS do
		character:SetAttribute(name, value)
	end
	CombatState.ResetCooldowns(character)
	CombatState.ResetSpecial(character)
end

function CombatState.ResetCooldowns(character: Model)
	for slot = 1, CombatState.SkillSlots do
		character:SetAttribute("CD" .. slot, 0)
		character:SetAttribute("CDLen" .. slot, 1)
	end
end

function CombatState.ResetSpecial(character: Model)
	character:SetAttribute("CD" .. CombatState.SpecialSlot, 0)
	character:SetAttribute("CDLen" .. CombatState.SpecialSlot, 1)
end

function CombatState.IsAlive(character: Model?): boolean
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") ~= nil
end

function CombatState.IsStunned(character: Model): boolean
	return (tonumber(character:GetAttribute("StunUntil")) or 0) > now()
end

function CombatState.IsBusy(character: Model): boolean
	return (tonumber(character:GetAttribute("BusyUntil")) or 0) > now()
end

function CombatState.IsCasting(character: Model): boolean
	return (tonumber(character:GetAttribute("CastUntil")) or 0) > now()
end

function CombatState.IsAwakened(character: Model): boolean
	return character:GetAttribute("Awakened") == true
end

-- Seconds left on a skill's cooldown, and the cooldown's full length.
function CombatState.Cooldown(character: Model, slot: number): (number, number)
	local readyAt = tonumber(character:GetAttribute("CD" .. slot)) or 0
	local length = tonumber(character:GetAttribute("CDLen" .. slot)) or 1
	return math.max(readyAt - now(), 0), length
end

function CombatState.IsRagdolled(character: Model): boolean
	return character:GetAttribute("Ragdolled") == true
end

function CombatState.IsBlocking(character: Model): boolean
	return character:GetAttribute("Blocking") == true
end

function CombatState.HasIFrames(character: Model): boolean
	return (tonumber(character:GetAttribute("IFrameUntil")) or 0) > now()
end

-- Alive, not stunned and not ragdolled. Busy (mid-swing) and casting are
-- checked separately.
function CombatState.CanAct(character: Model): boolean
	return CombatState.IsAlive(character)
		and not CombatState.IsStunned(character)
		and not CombatState.IsRagdolled(character)
end

-- Setters below are only meaningful on the server.

function CombatState.Stun(character: Model, duration: number)
	local untilTime = math.max(tonumber(character:GetAttribute("StunUntil")) or 0, now() + duration)
	character:SetAttribute("StunUntil", untilTime)
end

function CombatState.ClearStun(character: Model)
	character:SetAttribute("StunUntil", 0)
end

function CombatState.SetCasting(character: Model, duration: number)
	character:SetAttribute("CastUntil", now() + duration)
end

function CombatState.ClearCasting(character: Model)
	character:SetAttribute("CastUntil", 0)
end

function CombatState.StartCooldown(character: Model, slot: number, duration: number)
	character:SetAttribute("CD" .. slot, now() + duration)
	character:SetAttribute("CDLen" .. slot, math.max(duration, 0.01))
end

function CombatState.SetBusy(character: Model, duration: number)
	character:SetAttribute("BusyUntil", now() + duration)
end

function CombatState.GiveIFrames(character: Model, duration: number)
	character:SetAttribute("IFrameUntil", now() + duration)
end

function CombatState.SetBlocking(character: Model, blocking: boolean)
	character:SetAttribute("Blocking", blocking)
	if blocking then
		character:SetAttribute("BlockStart", now())
	end
end

return CombatState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Every tunable combat number lives here so balancing never means digging
	through logic. Times are in seconds, speeds in studs/second.
]]

local Config = {}

Config.Debug = {
	-- Draws a red box wherever a hitbox is checked (server-side, visible to everyone).
	ShowHitboxes = false,
}

Config.Movement = {
	WalkSpeed = 16,
	JumpHeight = 4.5, -- studs (Roblox default is 7.2)
	-- The air jump some kits get (Yuno, Kits airJumps): a small hop, about
	-- 4 studs, to pair with air moves rather than replace the jump.
	AirJumpSpeed = 24,
	AirJumpTime = 0.1,
	AttackingSpeed = 10,
	BlockingSpeed = 7,
	StunnedSpeed = 3,
	CastingSpeed = 5,
}

Config.M1 = {
	ComboLength = 4,
	Damage = 3.5,
	FinisherDamage = 5,

	-- Swing timings match the swing animations (SWING_TIMES in tools/anim).
	SwingCooldown = 0.36, -- time between swings in a string
	ResetTime = 1.2, -- idle time before the combo counter resets
	EndLag = 1.1, -- lockout after the final hit
	Busy = 0.42, -- slowed and can't jump while swinging (> SwingCooldown, so a full string stays grounded)
	FinisherBusy = 0.52,
	WindUp = 0.1, -- delay between the swing starting and the hitbox
	FinisherWindUp = 0.17, -- the 4th hit winds up longer (matches its animation)
	InputTolerance = 0.1, -- accept swings this early to absorb network jitter

	HitStun = 0.66, -- longer than SwingCooldown + WindUp (plus slack for ping), so strings are true combos
	-- The 3rd hit sets up the finisher: long enough to jump and downslam
	-- (3 hits, jump, hit) on a real player, ping included.
	SetupStun = 1.0,
	DownslamJumpAfter = 0.12, -- free to jump this soon after the 3rd hit
	UppercutStun = 1.1,
	-- The uppercut is a launcher: short end lag and an early jump, so you
	-- can go up after them and carry on in the air.
	UppercutEndLag = 0.4,
	UppercutJumpAfter = 0.2,
	UppercutGravity = 1.6, -- the launched body falls this much harder: a snappy arc
	JuggleTime = 0.85, -- how long a launched body can still be hit in the air

	HitboxSize = Vector3.new(5.5, 6, 6),
	HitboxOffset = 3.25, -- studs in front of the root

	Push = 10, -- pushes the victim about as far as the swing steps you in, so the spacing holds
	PushTime = 0.18,
	LungeSpeed = 13, -- attacker steps forward a little on every swing (eased out)
	LungeTime = 0.16,
	AirFloat = 0.45, -- air hits hold both players up this long (bridges the gap to the next swing)

	KnockbackForce = 65,
	KnockbackLift = 18,
	UppercutForce = 85, -- a ragdoll launch: about 10 studs up on 1.6x gravity (up and down in half a second)
	UppercutRagdoll = 1.1,
	DownslamForce = 75,
}

Config.Block = {
	PerfectWindow = 0.2, -- block pressed this recently = perfect block
	ParryStun = 1.25, -- attacker stun after being perfect blocked
	GuardBreakStun = 1.75,
	Cooldown = 0.4, -- after releasing block, stops perfect-block spam
	Pushback = 14,
	FacingDot = 0, -- > 0 means the attacker must be in front (180 degree cone)
}

Config.Dash = {
	Cooldown = 2, -- front and back dashes
	Duration = 0.28,
	-- Side dashes are a smaller hop (about 10 studs to the front dash's 19)
	-- on a cooldown of their own.
	SideCooldown = 1.5,
	SideDuration = 0.2,
	Tolerance = 0.2, -- server allows the client to be this early (latency)
	Speed = {
		Front = 85,
		Back = 70,
		Left = 60,
		Right = 60,
	},
}

-- Awakening: fills by dealing (and a bit by taking) damage. G when full.
-- About 90 damage dealt (or 200 taken) fills it: it should take a real fight.
Config.Awakening = {
	Max = 100,
	GainPerDamageDealt = 1.1,
	GainPerDamageTaken = 0.5,
}

-- Timed states moves can put on people (Yuno's Neverland): PowerUntil hits
-- harder, WeakUntil hits softer, SlowUntil moves slower.
Config.States = {
	PowerMultiplier = 1.15,
	WeakMultiplier = 0.75,
	SlowMultiplier = 0.6,
}

-- Switching characters is blocked this long after dealing or taking damage.
Config.KitSwitchCombatLock = 5

Config.Ragdoll = {
	Duration = 1.5,
}

Config.Physics = {
	-- Heavy hits freeze the victim for a split second before launching
	-- them, which sells the impact.
	HitStop = 0.06,
	-- Launched ragdolls tumble: spin (rad/s) per stud/s of launch speed.
	TumbleSpin = 0.12,
	MaxTumble = 10,
	-- How much of a launch's sideways speed a ragdoll carries (the height
	-- is kept exactly), so knockback reads as a throw, not a teleport.
	RagdollCarry = 0.7,
	-- Gentler pushes than this on a ragdoll hold it (air hits, hangs);
	-- faster ones throw it.
	RagdollHoldSpeed = 20,
	-- A ragdoll moving at least this fast that suddenly stops (floor, wall)
	-- kicks up a body impact effect.
	ImpactSpeed = 35,
}

-- Evasive: fills as you take damage. When full, Q while stunned or
-- ragdolled breaks you out of the combo.
Config.Evasive = {
	Max = 100,
	GainPerDamage = 5,
	RegenPerSecond = 1.5,
	IFrames = 0.6,
	Speed = 55,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Impulse</string>
          <string name="Source"><![CDATA[--[[
	Impulse
	Pushes a character for a short time using a LinearVelocity. A plain
	AssemblyLinearVelocity gets eaten by the Humanoid's controller, this
	doesn't. Must run on whoever owns the physics: the client for its own
	character, the server for NPCs and ragdolled characters.
]]

local RunService = game:GetService("RunService")

local Impulse = {}

-- Applies `velocity` for `duration` seconds. Only one impulse per `name`
-- exists at a time, so a new dash replaces an old dash. Vertical force is
-- only applied when velocity has a Y component, so gravity still works on
-- flat pushes. `taper` (a fraction of the duration) eases the push out to
-- a stop over its last part instead of cutting it dead, which is what makes
-- knockback feel snappy rather than jerky. Returns the LinearVelocity so
-- callers can steer it (steered pushes shouldn't taper).
function Impulse.Apply(
	root: BasePart,
	velocity: Vector3,
	duration: number,
	name: string?,
	taper: number?
): LinearVelocity
	local id = "Impulse_" .. (name or "Default")
	local existing = root:FindFirstChild(id)
	if existing then
		existing:Destroy()
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = id
	attachment.Parent = root

	local mover = Instance.new("LinearVelocity")
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	local vertical = if math.abs(velocity.Y) > 0.01 then 1e6 else 0
	mover.MaxAxesForce = Vector3.new(1e6, vertical, 1e6)
	mover.VectorVelocity = velocity
	mover.Parent = attachment

	if taper and taper > 0 and duration > 0 then
		local start = os.clock()
		local easeFrom = duration * (1 - math.min(taper, 1))
		local from: Vector3? = nil
		local connection
		connection = RunService.Heartbeat:Connect(function()
			if not mover.Parent then
				connection:Disconnect()
				return
			end
			local t = os.clock() - start
			if t < easeFrom then
				return
			end
			from = from or mover.VectorVelocity
			local a = math.clamp((t - easeFrom) / (duration - easeFrom), 0, 1)
			mover.VectorVelocity = (from :: Vector3) * (1 - a * a * (3 - 2 * a))
		end)
	end

	task.delay(duration, function()
		attachment:Destroy()
	end)

	return mover
end

function Impulse.Clear(root: BasePart)
	for _, child in root:GetChildren() do
		if child:IsA("Attachment") and string.sub(child.Name, 1, 8) == "Impulse_" then
			child:Destroy()
		end
	end
end

return Impulse
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Kits</string>
          <string name="Source"><![CDATA[--[[
	Kits
	The character roster. Everything both sides need to know about a
	character lives here: name, colors, M1 tuning, skills (name, cooldown,
	attack type) and awakening. The server logic for each kit is in
	ServerScriptService.Server.Kits, the animations and VFX in
	StarterPlayerScripts.Client.Kits.

	Attack types decide which counters work against what:
	  Melee | Bolt | Explosion | Swarm | Zone
]]

export type SkillInfo = {
	name: string,
	cooldown: number,
	type: string,
	-- Has an air version that holds the player up: the client keeps them in
	-- the air from the moment of the press (see Input.holdInAir).
	airHold: boolean?,
}

-- One of a character's weapons (Asta's swords): its name and the moves 1
-- and 2 it gives him while awakened.
export type SwordInfo = {
	name: string,
	skills: { SkillInfo },
}

export type KitInfo = {
	id: string,
	title: string, -- shown in the character picker
	description: string,
	color: Color3,
	playable: boolean,
	-- Overrides for Config.M1 (hitbox, damage, ...). Missing keys use Config.M1.
	m1: { [string]: any },
	skills: { SkillInfo },
	-- The R special: one per character, kept through awakening.
	special: SkillInfo?,
	-- Awakening swaps the move set (like Vessel -> Sukuna, Hero Hunter -> Rampage).
	awakenedSkills: { SkillInfo }?,
	-- A different R while awakened (Asta: swap to another of his swords).
	awakenedSpecial: SkillInfo?,
	-- Weapons that change moves 1 and 2 while awakened, by the character's
	-- "Sword" attribute (see Kits.SkillsOf).
	swords: { [string]: SwordInfo }?,
	awakening: {
		name: string,
		duration: number,
		damageMultiplier: number,
		cooldownMultiplier: number,
		speedBonus: number,
	}?,
	-- Extra jumps in the air (Yuno rides the wind: one more).
	airJumps: number?,
	-- A second, stronger stage of the awakening (Yuno: Full-Crown): once
	-- `charge` is reached in the first stage, G can be pressed again. It
	-- charges with damage dealt, or, with `chargeByKit`, only when the kit
	-- says so (Yuno: each landed Tempest Dive is 1). Its own moves and stats,
	-- and the awakening's timer restarts at `duration`.
	ascension: {
		name: string,
		duration: number,
		charge: number,
		chargeByKit: boolean?,
		damageMultiplier: number,
		cooldownMultiplier: number,
		speedBonus: number,
		skills: { SkillInfo },
	}?,
}

local Kits = {}

Kits.Default = "AntiMagic"

-- Picker order.
Kits.Order = { "AntiMagic", "Wind", "Water", "Dark", "Flame", "Lightning" }

local function comingSoon(id: string, title: string, description: string, color: Color3): KitInfo
	return {
		id = id,
		title = title,
		description = description,
		color = color,
		playable = false,
		m1 = {},
		skills = {},
	}
end

Kits.List = {
	AntiMagic = {
		id = "AntiMagic",
		title = "Anti-Magic Knight",
		description = "No magic at all. A demon-slaying greatsword that cuts through every spell.",
		color = Color3.fromRGB(205, 35, 45),
		playable = true,
		m1 = {
			-- The greatsword reaches further than fists.
			HitboxSize = Vector3.new(7, 6, 7),
			HitboxOffset = 3.75,
			Damage = 4,
			FinisherDamage = 6,
			-- Hits land as the blade sweeps through the middle of the swing.
			WindUp = 0.11,
			FinisherWindUp = 0.18,
		},
		-- Close-range rushdown, built like Vessel (JJS) / Hero Hunter (TSB):
		-- rush combo, grab, timing-crit heavy, counter.
		skills = {
			{ name = "Bull Thrust", cooldown = 10, type = "Melee", airHold = true },
			{ name = "Black Meteorite", cooldown = 13, type = "Melee", airHold = true },
			{ name = "Black Divider", cooldown = 11, type = "Melee", airHold = true },
			{ name = "Anti-Magic Deflect", cooldown = 14, type = "Counter", airHold = true },
		},
		-- Leap off a blast of anti-magic; R again in the air to plunge.
		special = { name = "Anti-Magic Leap", cooldown = 10, type = "Melee", airHold = true },
		awakenedSkills = {
			{ name = "Black Hurricane", cooldown = 9, type = "Melee", airHold = true },
			{ name = "Black Slash", cooldown = 7, type = "Bolt", airHold = true },
			{ name = "Grand Divider", cooldown = 13, type = "Explosion", airHold = true },
			{ name = "Black Moon", cooldown = 25, type = "Melee" },
		},
		-- In Black Form R draws another of his swords from the grimoire, at
		-- random; moves 1 and 2 come from the sword in his hand.
		awakenedSpecial = { name = "Swap Sword", cooldown = 10, type = "Melee" },
		swords = {
			Slayer = {
				name = "Demon-Slayer Sword",
				skills = {
					{ name = "Black Hurricane", cooldown = 9, type = "Melee", airHold = true },
					{ name = "Slayer Recall", cooldown = 12, type = "Bolt", airHold = true },
				},
			},
			Dweller = {
				name = "Demon-Dweller Sword",
				skills = {
					{ name = "Black Slash", cooldown = 7, type = "Bolt", airHold = true },
					{ name = "Conquering Eon", cooldown = 15, type = "Counter", airHold = true },
				},
			},
			Destroyer = {
				name = "Demon-Destroyer Sword",
				skills = {
					{ name = "Causality Break", cooldown = 15, type = "Zone", airHold = true },
					{ name = "Severance", cooldown = 12, type = "Melee", airHold = true },
				},
			},
			Slasher = {
				name = "Demon-Slasher Katana",
				skills = {
					{ name = "Infinite Slash", cooldown = 13, type = "Melee", airHold = true },
					{ name = "Zetten", cooldown = 16, type = "Counter", airHold = true },
				},
			},
		},
		awakening = {
			name = "Black Form",
			duration = 55,
			damageMultiplier = 1.25,
			cooldownMultiplier = 0.8,
			speedBonus = 6,
		},
	} :: KitInfo,

	Wind = {
		id = "Wind",
		title = "Prince of Wind",
		description = "Wind magic blessed by the spirit Sylph, and star magic. Fights from range and is never where you left him.",
		color = Color3.fromRGB(90, 220, 150),
		playable = true,
		m1 = {
			-- Wind-wrapped strikes reach a little further than bare fists.
			HitboxOffset = 3.5,
		},
		-- He rides the wind: one more jump in the air, for chasing air combos.
		airJumps = 1,
		-- Mid-range zoner (Asta's opposite): a rain of blades to pin people
		-- down, a homing hawk, a launcher, a six-arrow volley. Less damage
		-- per move than Asta's sword, but from where the sword can't reach.
		skills = {
			{ name = "Wind Blades Shower", cooldown = 11, type = "Swarm", airHold = true },
			{ name = "Swift White Hawk", cooldown = 8, type = "Bolt", airHold = true },
			{ name = "Heavenly Wind Ark", cooldown = 12, type = "Zone", airHold = true },
			{ name = "Gale White Bow", cooldown = 15, type = "Bolt", airHold = true },
		},
		-- Star magic: place a star, press R again to be there.
		special = { name = "Conjunction", cooldown = 10, type = "Melee" },
		-- Half-Crown Spirit of Zephyr (G): Sylph on his left side.
		awakenedSkills = {
			{ name = "Spirit Storm", cooldown = 12, type = "Bolt", airHold = true },
			{ name = "Tempest Dive", cooldown = 16, type = "Melee", airHold = true },
			{ name = "Quartile Scutum", cooldown = 16, type = "Counter" },
			{ name = "Quartile Hasta", cooldown = 14, type = "Bolt", airHold = true },
		},
		awakening = {
			name = "Half-Crown",
			duration = 45,
			damageMultiplier = 1.15,
			cooldownMultiplier = 0.85,
			speedBonus = 4,
		},
		-- Full-Crown Spirit of Zephyr: G again once Tempest Dive (Half-Crown
		-- 2) has landed twice. Stronger than Black Form, but only 30 seconds.
		ascension = {
			name = "Full-Crown",
			duration = 30,
			charge = 2,
			chargeByKit = true,
			damageMultiplier = 1.3,
			cooldownMultiplier = 0.75,
			speedBonus = 8,
			skills = {
				{ name = "Spirit of Notos", cooldown = 12, type = "Counter" },
				{ name = "Spirit of Zephyrus", cooldown = 13, type = "Bolt", airHold = true },
				{ name = "Spirit of Euros", cooldown = 18, type = "Bolt", airHold = true },
				{ name = "Neverland", cooldown = 30, type = "Melee" },
			},
		},
	} :: KitInfo,
	Water = comingSoon("Water", "Water Princess", "Royal water magic.", Color3.fromRGB(80, 160, 255)),
	Dark = comingSoon("Dark", "Dark Captain", "Dark magic that slices space.", Color3.fromRGB(120, 70, 190)),
	Flame = comingSoon("Flame", "Flame Lioness", "Overwhelming flame magic.", Color3.fromRGB(255, 120, 40)),
	Lightning = comingSoon("Lightning", "Battle Maniac", "Lightning-fast magic.", Color3.fromRGB(255, 225, 70)),
} :: { [string]: KitInfo }

function Kits.Get(id: string?): KitInfo?
	if id == nil then
		return nil
	end
	return Kits.List[id]
end

-- The move list a character has right now (awakened moves while awakened).
function Kits.SkillsOf(character: Model): { SkillInfo }
	local kit = Kits.Of(character)
	if not kit then
		return {}
	end
	if character:GetAttribute("Awakened") == true and kit.ascension and character:GetAttribute("Ascended") == true then
		return kit.ascension.skills
	end
	if character:GetAttribute("Awakened") == true and kit.awakenedSkills then
		-- Moves 1 and 2 come from the sword in his hand.
		local sword = character:GetAttribute("Sword")
		local weapon = if kit.swords and type(sword) == "string" then kit.swords[sword] else nil
		if weapon then
			local merged = table.clone(kit.awakenedSkills)
			for slot, skill in weapon.skills do
				merged[slot] = skill
			end
			return merged
		end
		return kit.awakenedSkills
	end
	return kit.skills
end

-- The kit a character is using (nil for kit-less NPCs like the dummies).
function Kits.Of(character: Model): KitInfo?
	return Kits.Get(character:GetAttribute("Kit") :: string?)
end

return Kits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MeteorVortex</string>
          <string name="Source"><![CDATA[--[[
	MeteorVortex
	Black Meteorite after the grab, start to finish:
	  1. the vortex: holding them out by the throat, Asta whirls round,
	     bobbing up and down as it carries him into the sky, and finishes
	     facing the way he started;
	  2. the flip: he tips forward over the top until he's head-down;
	  3. the dive: head-first, spinning like a drill (a whole number of
	     turns, faster as he falls) down into the ground with them;
	  4. the recovery: the somersault finishes and he lands on his feet.

	Shared so the server (which holds him on the path) and every client
	(which draws him on it smoothly) agree on where he is. t = 0 is the
	start of the spin; `origin` is his root then, level.
]]

local MeteorVortex = {}

MeteorVortex.Length = 1.2 -- seconds of spinning up
MeteorVortex.Turns = 3 -- whole turns, so he ends facing forward
MeteorVortex.Top = 20 -- studs he ends up above where he started (on the ground)
MeteorVortex.AirTop = 8 -- the same, when it starts in the air
MeteorVortex.Bob = 4 -- how far each bob dips and rises
MeteorVortex.Radius = 1.5 -- the little circle his body traces

MeteorVortex.Flip = 0.14 -- tipping over head-down at the top
MeteorVortex.DiveSpeed = 45 -- studs/s, on average, on the way down
MeteorVortex.SpinRate = 9 -- turns per second while diving
MeteorVortex.Recover = 0.26 -- rolling back over onto his feet
MeteorVortex.ImpactHeight = 3.2 -- his root above the ground when he hits (head-first)
MeteorVortex.NoFloorDrop = 16 -- how far he dives when there's no ground in reach

local UP = Vector3.yAxis

export type Plan = {
	origin: CFrame,
	top: number,
	floorY: number?, -- the ground under him (nil: none in reach)
	topPosition: Vector3, -- where the spin ends
	diveEnd: Vector3, -- where he hits
	drop: number,
	spins: number, -- whole turns in the dive
	flipAt: number,
	diveAt: number,
	impactAt: number,
	length: number,
}

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

-- Everything about one Meteorite, worked out from where he grabbed them.
function MeteorVortex.Plan(origin: CFrame, top: number, floorY: number?): Plan
	local topPosition = origin.Position + UP * top
	local forward = origin.LookVector
	local endY = if floorY then floorY + MeteorVortex.ImpactHeight else topPosition.Y - MeteorVortex.NoFloorDrop
	endY = math.min(endY, topPosition.Y - 2)
	local drop = topPosition.Y - endY
	local dive = math.clamp(drop / MeteorVortex.DiveSpeed, 0.35, 0.9)
	local flipAt = MeteorVortex.Length
	local diveAt = flipAt + MeteorVortex.Flip
	local impactAt = diveAt + dive
	return {
		origin = origin,
		top = top,
		floorY = floorY,
		topPosition = topPosition,
		diveEnd = Vector3.new(topPosition.X, endY, topPosition.Z) + forward * 1.8,
		drop = drop,
		spins = math.max(2, math.floor(MeteorVortex.SpinRate * dive + 0.5)),
		flipAt = flipAt,
		diveAt = diveAt,
		impactAt = impactAt,
		length = impactAt + MeteorVortex.Recover,
	}
end

-- How far round he has turned (radians) at fraction a of the spin-up: slow
-- to start, fastest in the middle, easing out facing forward again.
function MeteorVortex.Angle(a: number): number
	return MeteorVortex.Turns * 2 * math.pi * smooth(math.clamp(a, 0, 1))
end

-- The spin-up alone: his root at time t (0 to Length).
function MeteorVortex.Spin(origin: CFrame, t: number, top: number?): CFrame
	local a = math.clamp(t / MeteorVortex.Length, 0, 1)
	local angle = MeteorVortex.Angle(a)
	-- Rising overall, bobbing down and up twice on the way (the bobs ease in
	-- and out, so it starts and ends without a jolt).
	local height = (top or MeteorVortex.Top) * smooth(a)
		+ MeteorVortex.Bob * math.sin(a * math.pi * 4) * math.sin(a * math.pi)
	local circle = (origin.RightVector * math.sin(angle) + origin.LookVector * (math.cos(angle) - 1))
		* MeteorVortex.Radius
	local position = origin.Position + UP * height + circle
	-- He banks into the turn and leans back against their weight, most at
	-- full speed.
	local pull = 4 * a * (1 - a)
	return CFrame.new(position)
		* origin.Rotation
		* CFrame.Angles(0, -angle, 0)
		* CFrame.Angles(math.rad(10) * pull, 0, -math.rad(12) * pull)
end

-- His root at time t, over the whole move. Each stage starts exactly where
-- the last one left him, so nothing snaps.
function MeteorVortex.At(plan: Plan, t: number): CFrame
	if t <= plan.flipAt then
		return MeteorVortex.Spin(plan.origin, t, plan.top)
	end
	local forward = plan.origin.LookVector
	if t <= plan.diveAt then
		-- Tipping forward over the top until he's head-down.
		local a = (t - plan.flipAt) / (plan.diveAt - plan.flipAt)
		local e = smooth(a)
		local position = plan.topPosition + UP * math.sin(a * math.pi) * 1.2 + forward * 0.6 * e
		return CFrame.new(position) * plan.origin.Rotation * CFrame.Angles(-math.pi * e, 0, 0)
	end
	if t <= plan.impactAt then
		-- Head-first, spinning like a drill, faster as he falls.
		local a = (t - plan.diveAt) / (plan.impactAt - plan.diveAt)
		local from = plan.topPosition + forward * 0.6
		local position = from:Lerp(plan.diveEnd, a) - UP * plan.drop * (a ^ 1.7 - a)
		local spin = plan.spins * 2 * math.pi * a
		return CFrame.new(position) * CFrame.Angles(0, -spin, 0) * plan.origin.Rotation * CFrame.Angles(-math.pi, 0, 0)
	end
	-- The somersault finishes and he lands on his feet.
	local a = math.clamp((t - plan.impactAt) / (plan.length - plan.impactAt), 0, 1)
	local e = smooth(a)
	local landY = if plan.floorY then plan.floorY + 3 else plan.diveEnd.Y
	local position = Vector3.new(plan.diveEnd.X, plan.diveEnd.Y + (landY - plan.diveEnd.Y) * e, plan.diveEnd.Z)
		+ UP * math.sin(a * math.pi) * 1.5
		+ forward * 1.5 * e
	return CFrame.new(position) * plan.origin.Rotation * CFrame.Angles(-math.pi * (1 + e), 0, 0)
end

return MeteorVortex
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Neverland</string>
          <string name="Source"><![CDATA[--[[
	Neverland
	Yuno's Full-Crown cutscene, start to finish:
	  1. time stops: the star dome flashes over them and the victim is
	     lifted off the ground, frozen;
	  2. the triangle: three stars stand round them, and he warps from star
	     to star, punching them up each time (two laps, six punches), the
	     triangle rising with them;
	  3. the hammer: he's above them at the top and brings both fists down;
	  4. they fall through the middle of it all into the ground, and he
	     glides down after them.

	Shared so the server (which holds them both on the paths) and every
	client (which draws them on it smoothly) agree on where they are.
	t = 0 is the grab.
]]

local Neverland = {}

local UP = Vector3.yAxis

Neverland.Times = {
	Freeze = 0.45, -- time has stopped; they're lifted
	Strikes = { 0.55, 0.85, 1.15, 1.45, 1.75, 2.05 },
	Apex = 2.3, -- he's above them
	Slam = 2.45, -- the hammer lands
	Land = 2.8, -- they hit the ground
	Length = 3.25, -- he's down too
}
Neverland.Warp = 0.08 -- he appears at the next star this long before each punch
Neverland.Rise = 4.2 -- how far each punch knocks them up
Neverland.Lift = 2 -- lifted off the ground as time stops
Neverland.Radius = 4.6 -- the triangle round them
Neverland.Above = 3.5 -- how far above them he is for the hammer

export type Plan = {
	origin: CFrame, -- him at the grab
	start: Vector3, -- them at the grab
	forward: Vector3, -- flat, from him to them
	floorY: number,
}

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

function Neverland.Plan(origin: CFrame, victimPosition: Vector3, floorY: number): Plan
	local toward = victimPosition - origin.Position
	local forward = Vector3.new(toward.X, 0, toward.Z)
	if forward.Magnitude < 1e-3 then
		forward = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
	end
	return {
		origin = origin,
		start = victimPosition,
		forward = if forward.Magnitude > 1e-3 then forward.Unit else Vector3.new(0, 0, -1),
		floorY = floorY,
	}
end

-- How high they are above where they started at time t.
function Neverland.Height(t: number): number
	local times = Neverland.Times
	local height = Neverland.Lift * smooth(t / times.Freeze)
	for _, at in times.Strikes do
		height += Neverland.Rise * smooth((t - at) / 0.16)
	end
	return height
end

-- Corner `index` (1 to 3) of the triangle of stars round them, at height
-- `height` above where they started.
function Neverland.Corner(plan: Plan, index: number, height: number): Vector3
	local right = plan.forward:Cross(UP)
	local angle = math.pi + (index - 1) * (math.pi * 2 / 3)
	local direction = plan.forward * math.cos(angle) + right * math.sin(angle)
	return plan.start + UP * height + direction * Neverland.Radius
end

-- Which punch (1 to 6) he's on at time t, if any.
function Neverland.StrikeAt(t: number): number?
	local times = Neverland.Times
	local current = nil
	for i, at in times.Strikes do
		if t >= at - Neverland.Warp then
			current = i
		end
	end
	return if current and t < times.Apex - 0.05 then current else nil
end

local function top(plan: Plan): Vector3
	return plan.start + UP * Neverland.Height(Neverland.Times.Slam)
end

local function landing(plan: Plan): Vector3
	return Vector3.new(plan.start.X, plan.floorY + 3, plan.start.Z)
end

function Neverland.Victim(plan: Plan, t: number): CFrame
	local times = Neverland.Times
	local facing = -plan.forward
	if t <= times.Slam then
		local position = plan.start + UP * Neverland.Height(t)
		-- Tipping back as they're knocked up.
		local tip = math.rad(55) * smooth((t - times.Strikes[1]) / (times.Slam - times.Strikes[1]))
		return CFrame.lookAt(position, position + facing) * CFrame.Angles(tip, 0, 0)
	end
	-- Down, faster and faster, turning over onto their back.
	local a = math.clamp((t - times.Slam) / (times.Land - times.Slam), 0, 1)
	local position = top(plan):Lerp(landing(plan), a * a)
	return CFrame.lookAt(position, position + facing) * CFrame.Angles(math.rad(55) + math.rad(35) * a, 0, 0)
end

function Neverland.Attacker(plan: Plan, t: number): CFrame
	local times = Neverland.Times
	local strike = Neverland.StrikeAt(t)
	if t < times.Strikes[1] - Neverland.Warp then
		return plan.origin
	end
	if strike then
		-- At the star for this punch, punching in; he rises a little with
		-- them after it.
		local at = times.Strikes[strike]
		local height = Neverland.Height(at)
		local follow = Neverland.Rise * 0.6 * smooth((t - at) / 0.2)
		local corner = Neverland.Corner(plan, ((strike - 1) % 3) + 1, height - 0.5) + UP * follow
		local target = plan.start + UP * (height + follow)
		return CFrame.lookAt(corner, Vector3.new(target.X, corner.Y, target.Z))
	end
	local above = top(plan) + UP * Neverland.Above
	if t < times.Slam then
		return CFrame.lookAt(above, above + plan.forward)
	end
	-- Gliding down after them, landing just short of the crater.
	local a = math.clamp((t - times.Slam) / (times.Length - times.Slam), 0, 1)
	local eased = 1 - (1 - a) * (1 - a)
	local down = landing(plan) - plan.forward * 4
	local position = above:Lerp(down, eased)
	return CFrame.lookAt(position, position + plan.forward)
end

return Neverland
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	The server creates every RemoteEvent; clients wait for them.

	Action       client -> server   ("M1", {jump, airborne}) | ("Block", bool) | ("Dash", dir) | ("Evasive") | ("AirJump")
	                                | ("Skill", slot, {airborne}) | ("Special", {airborne}) | ("Awaken")
	                                | ("SelectKit", kitId)
	VFX          server -> clients  (effectName, data)
	CameraShake  server -> client   (intensity 0-1)
	Impulse      server -> client   (velocity, duration, {steer?}) applied to your own character
	Notify       server -> client   (text, color?) toast message
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = { "Action", "VFX", "CameraShake", "Impulse", "Notify" }

local Remotes: { [string]: RemoteEvent } = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in NAMES do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in NAMES do
		Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">TempestDive</string>
          <string name="Source"><![CDATA[--[[
	TempestDive
	Yuno's Half-Crown grab, start to finish:
	  1. the drag: he flies straight up, dragging them by the collar below
	     him;
	  2. the turn: at the top he swings over them, both head-down;
	  3. the dive: he drives them straight down head-first, spinning, faster
	     and faster, and a tornado forms behind them on the way down, its
	     funnel standing over the crater when they hit;
	  4. he flips back off the crater onto his feet.

	Shared so the server (which holds them both on the paths) and every
	client (which draws them on it smoothly) agree on where they are.
	t = 0 is the grab.
]]

local TempestDive = {}

local UP = Vector3.yAxis

TempestDive.Times = {
	Lift = 1.1, -- dragged to the top
	Flip = 1.55, -- a beat up there, then he's over them, both head-down
	Ticks = { 1.85, 2.1, 2.3 }, -- the tornado cuts them on the way down
	Land = 2.5, -- into the ground
	Length = 3.1, -- he's back on his feet
}
TempestDive.Height = 34 -- how high he drags them
TempestDive.Hold = 2.6 -- how far above them he flies, dragging them
TempestDive.Spins = 4 -- drill turns on the way down

export type Plan = {
	origin: CFrame,
	start: Vector3,
	forward: Vector3,
	floorY: number,
}

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

function TempestDive.Plan(origin: CFrame, victimPosition: Vector3, floorY: number): Plan
	local toward = victimPosition - origin.Position
	local forward = Vector3.new(toward.X, 0, toward.Z)
	if forward.Magnitude < 1e-3 then
		forward = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
	end
	return {
		origin = origin,
		start = victimPosition,
		forward = if forward.Magnitude > 1e-3 then forward.Unit else Vector3.new(0, 0, -1),
		floorY = floorY,
	}
end

local function facing(direction: Vector3): CFrame
	return CFrame.lookAt(Vector3.zero, direction)
end

local function rise(a: number): number
	return TempestDive.Height * (1 - (1 - math.clamp(a, 0, 1)) ^ 2)
end

-- Where they are, head-down, when their head meets the ground.
function TempestDive.Impact(plan: Plan): Vector3
	return Vector3.new(plan.start.X, plan.floorY + 2.5, plan.start.Z)
end

local function top(plan: Plan): Vector3
	return plan.start + UP * TempestDive.Height
end

-- Where they are at fraction a of the dive: faster and faster.
function TempestDive.DiveAt(plan: Plan, a: number): Vector3
	return top(plan):Lerp(TempestDive.Impact(plan), a * a)
end

function TempestDive.Victim(plan: Plan, t: number): CFrame
	local times = TempestDive.Times
	local toward = facing(-plan.forward) -- facing him
	if t <= times.Lift then
		-- Dragged straight up by the collar, legs swinging.
		local a = t / times.Lift
		return CFrame.new(plan.start + UP * rise(a))
			* toward
			* CFrame.Angles(math.rad(-15) * math.sin(a * math.pi), 0, 0)
	end
	if t <= times.Flip then
		local a = smooth((t - times.Lift) / (times.Flip - times.Lift))
		return CFrame.new(top(plan)) * toward * CFrame.Angles(math.pi * a, 0, 0)
	end
	local a = math.clamp((t - times.Flip) / (times.Land - times.Flip), 0, 1)
	local spin = a * TempestDive.Spins * 2 * math.pi
	return CFrame.new(TempestDive.DiveAt(plan, a)) * CFrame.Angles(0, -spin, 0) * toward * CFrame.Angles(math.pi, 0, 0)
end

function TempestDive.Attacker(plan: Plan, t: number): CFrame
	local times = TempestDive.Times
	local ahead = facing(plan.forward)
	local holding = UP * TempestDive.Hold - plan.forward * 0.8
	if t <= times.Lift then
		-- Flying straight up above them, dragging them.
		local position = plan.start + UP * rise(t / times.Lift) + holding
		return CFrame.new(plan.origin.Position:Lerp(position, smooth(t / 0.2))) * ahead
	end
	local above = top(plan) + UP * 3.2
	if t <= times.Flip then
		-- Swinging over them, turning head-down.
		local a = smooth((t - times.Lift) / (times.Flip - times.Lift))
		local position = (top(plan) + holding):Lerp(above, a) + UP * math.sin(a * math.pi) * 1.5
		return CFrame.new(position) * ahead * CFrame.Angles(math.pi * a, 0, 0)
	end
	if t <= times.Land then
		-- Driving them down, right on top of them.
		local a = (t - times.Flip) / (times.Land - times.Flip)
		local spin = a * TempestDive.Spins * 2 * math.pi
		return CFrame.new(TempestDive.DiveAt(plan, a) + UP * 3.2)
			* CFrame.Angles(0, -spin, 0)
			* ahead
			* CFrame.Angles(math.pi, 0, 0)
	end
	-- Off the crater in a backflip, landing on his feet just short of it.
	local a = math.clamp((t - times.Land) / (times.Length - times.Land), 0, 1)
	local from = TempestDive.Impact(plan) + UP * 3.2
	local to = Vector3.new(plan.start.X, plan.floorY + 3, plan.start.Z) - plan.forward * 5
	local position = from:Lerp(to, smooth(a)) + UP * math.sin(a * math.pi) * 5
	return CFrame.new(position) * ahead * CFrame.Angles(math.pi * (1 + smooth(a)), 0, 0)
end

return TempestDive
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Server entry point.
]]

local Players = game:GetService("Players")

local CharacterLoader = require(script.CharacterLoader)
local CombatService = require(script.CombatService)
local Dummies = require(script.Dummies)

CombatService.Start()

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(CombatService.Register)
	if player.Character then
		task.spawn(CombatService.Register, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- After combat hooks are in place, so the first spawn gets registered.
CharacterLoader.Start()

Dummies.Start()
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CharacterLoader</string>
          <string name="Source"><![CDATA[--[[
	CharacterLoader
	Puts every player in an R6 body while keeping their own avatar look
	(skin colors, clothes, face, accessories). Battlegrounds animations and
	ragdolls are built for R6, and this works without publishing the place
	or changing Game Settings.

	How: an R6 rig named "StarterCharacter" in StarterPlayer makes Roblox
	spawn everyone as that rig. We spawn players ourselves and then dress
	the rig in their avatar.
]]

local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")

local CharacterLoader = {}

local descriptions: { [Player]: HumanoidDescription } = {}

local function getDescription(player: Player): HumanoidDescription
	local cached = descriptions[player]
	if cached then
		return cached
	end
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserIdAsync(player.UserId)
	end)
	if not ok or not description then
		-- Local test servers use fake negative user ids with no avatar.
		description = Instance.new("HumanoidDescription")
	end
	descriptions[player] = description
	return description
end

local function spawnCharacter(player: Player)
	if not player.Parent then
		return
	end
	player:LoadCharacterAsync()

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return
	end

	local ok, err = pcall(function()
		humanoid:ApplyDescriptionAsync(getDescription(player))
	end)
	if not ok then
		warn("[CharacterLoader] Couldn't apply avatar for", player.Name, err)
	end
	-- Applying the avatar can rebuild body parts, so weapons are only
	-- attached after this (see CombatService.Register).
	character:SetAttribute("AvatarLoaded", true)

	humanoid.Died:Connect(function()
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == character then
				spawnCharacter(player)
			end
		end)
	end)
end

function CharacterLoader.Start()
	Players.CharacterAutoLoads = false

	if not StarterPlayer:FindFirstChild("StarterCharacter") then
		local rig = Players:CreateHumanoidModelFromDescriptionAsync(
			Instance.new("HumanoidDescription"),
			Enum.HumanoidRigType.R6
		)
		rig.Name = "StarterCharacter"
		rig.Parent = StarterPlayer
	end

	Players.PlayerAdded:Connect(spawnCharacter)
	Players.PlayerRemoving:Connect(function(player)
		descriptions[player] = nil
	end)
	-- Anyone who joined before this ran may have auto-spawned as R15: respawn them.
	for _, player in Players:GetPlayers() do
		task.spawn(spawnCharacter, player)
	end
end

return CharacterLoader
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--[[
	CombatService
	Server-authoritative combat: M1 strings, blocking, perfect blocks, guard
	breaks, dashes, ragdolls, Evasive, and the character kit layer (skills,
	cooldowns, counters, awakening, switching characters).

	Players and NPCs go through the same functions, so dummies fight with
	the real rules. Kit modules (Server/Kits/*) get this module through their
	context and use its public API to deal hits, move people and fire VFX.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatState = require(Shared.CombatState)
local Config = require(Shared.Config)
local Impulse = require(Shared.Impulse)
local Kits = require(Shared.Kits)
local Remotes = require(Shared.Remotes)

local Hitbox = require(script.Parent.Hitbox)
local Ragdoll = require(script.Parent.Ragdoll)

type Counter = {
	untilTime: number,
	types: { [string]: boolean },
	onCounter: (attacker: Model, hit: HitInfo) -> (),
	-- Only hits this accepts are countered (e.g. from the front); the rest land.
	filter: ((attacker: Model, hit: HitInfo) -> boolean)?,
}

export type CharData = {
	humanoid: Humanoid,
	combo: number,
	lastM1: number,
	nextM1: number,
	nextBlock: number,
	nextDash: number,
	nextSideDash: number,
	ragdollToken: number,
	juggleUntil: number, -- launched by an uppercut: can still be hit in the air until then
	awakenToken: number,
	lastDamaged: number, -- last time this character took damage
	lastCombat: number, -- last time it dealt or took a hit (blocks character switching)
	counter: Counter?,
	-- When each skill key was last pressed while already on cooldown. Lets a
	-- running skill read follow-up presses (timing inputs like Black Divider).
	skillInputs: { [number]: number },
	-- Whether that press was made in the air (the player's own client says).
	skillInputAir: { [number]: boolean },
	-- Bumped whenever a skill, special or awakening starts, so a move that
	-- listens for follow-ups (Anti-Magic Leap) knows another move took over.
	moveToken: number,
	grabbedBy: Model?,
}

export type HitInfo = {
	damage: number,
	stun: number,
	attackType: string?, -- "Melee" (default) | "Bolt" | "Explosion" | "Swarm" | "Zone"
	guardBreak: boolean?,
	unblockable: boolean?,
	variant: string?, -- M1 finishers: "Normal" | "Knockback" | "Uppercut" | "Downslam"
	airborne: boolean?, -- M1 hit while in the air
	velocity: Vector3?, -- knockback (world space)
	velocityTime: number?,
	ragdoll: number?, -- seconds of ragdoll
	hitsDowned: boolean?, -- can hit someone lying on the floor (the air Black Divider)
	noShake: boolean?, -- no camera shake for either of them (Black Meteorite)
	heavy: boolean?, -- bigger hit effect
	effect: string?, -- VFX name to play instead of Hit / HeavyHit
}

-- Handed to kit skill functions.
export type Context = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	player: Player?,
	data: CharData,
	kit: Kits.KitInfo,
	awakened: boolean,
	-- In the air when the move was used (the player's own client says so,
	-- see onAction; the server's view of them is a ping behind).
	airborne: boolean,
	combat: any, -- this module
}

local DASH_DIRECTIONS = { Front = true, Back = true, Left = true, Right = true }

local registry: { [Model]: CharData } = {}

-- Server kit modules, by kit id.
local serverKits: { [string]: any } = {}
for _, module in script.Parent:WaitForChild("Kits"):GetChildren() do
	if module:IsA("ModuleScript") then
		serverKits[module.Name] = require(module) :: any
	end
end

local CombatService = {}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

local function getRoot(character: Model): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function flat(vector: Vector3): Vector3
	local v = Vector3.new(vector.X, 0, vector.Z)
	return if v.Magnitude > 1e-3 then v.Unit else Vector3.new(0, 0, -1)
end

local function addMeter(character: Model, attribute: string, amount: number, max: number)
	local current = tonumber(character:GetAttribute(attribute)) or 0
	local value = math.clamp(current + amount, 0, max)
	if value ~= current then
		character:SetAttribute(attribute, value)
	end
end

-- Kit-specific M1 tuning, falling back to Config.M1.
local function m1Value(character: Model, key: string): any
	local kit = Kits.Of(character)
	local override = kit and kit.m1[key]
	if override ~= nil then
		return override
	end
	return (Config.M1 :: any)[key]
end

local function awakeningOf(character: Model)
	local kit = Kits.Of(character)
	if not kit or not CombatState.IsAwakened(character) then
		return nil
	end
	if kit.ascension and character:GetAttribute("Ascended") == true then
		return kit.ascension
	end
	return kit.awakening
end

-- The second stage a character can still reach in this awakening, if any.
local function pendingAscension(character: Model)
	local kit = Kits.Of(character)
	if kit and kit.ascension and CombatState.IsAwakened(character) and character:GetAttribute("Ascended") ~= true then
		return kit.ascension
	end
	return nil
end

-- Charges the second stage for kits that do it themselves (Kits ascension
-- chargeByKit): Yuno's landed Tempest Dives.
function CombatService.ChargeAscension(character: Model, amount: number)
	local ascension = pendingAscension(character)
	if ascension then
		addMeter(character, "Ascension", amount, ascension.charge)
	end
end

-- Timed states a move can put on someone (Yuno's Neverland): stronger or
-- weaker hits, slowed down. Server-only, so os.clock() times.
local function stateActive(character: Model, attribute: string): boolean
	return (tonumber(character:GetAttribute(attribute)) or 0) > os.clock()
end
CombatService.StateActive = stateActive

function CombatService.Flat(vector: Vector3): Vector3
	return flat(vector)
end

function CombatService.GetData(character: Model): CharData?
	return registry[character]
end

function CombatService.FireVFX(name: string, data: { [string]: any })
	Remotes.VFX:FireAllClients(name, data)
end

function CombatService.Shake(character: Model, intensity: number)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		Remotes.CameraShake:FireClient(player, intensity)
	end
end

-- Shakes everyone's camera near a point, falling off with distance.
function CombatService.ShakeArea(position: Vector3, radius: number, intensity: number)
	for _, player in Players:GetPlayers() do
		local root = player.Character and getRoot(player.Character)
		if root then
			local distance = (root.Position - position).Magnitude
			if distance < radius then
				Remotes.CameraShake:FireClient(player, intensity * (1 - distance / radius))
			end
		end
	end
end

function CombatService.Notify(character: Model, text: string, color: Color3?)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		Remotes.Notify:FireClient(player, text, color)
	end
end

-- Moves a character, routing to whoever owns its physics.
-- `options.steer` (degrees per second) lets a player curve the push with
-- their camera / movement keys while it lasts (e.g. Bull Thrust).
-- `options.landStop`: a downward push (a dive) turns into a skid once the
-- player touches down, keeping `landKeep` of its speed.
function CombatService.ApplyVelocity(
	character: Model,
	velocity: Vector3,
	duration: number,
	options: { steer: number?, landStop: boolean?, landKeep: number? }?
)
	local root = getRoot(character)
	if not root then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if Ragdoll.IsActive(character) then
		-- Server owns ragdolls, and a ragdoll has no Humanoid fighting the
		-- velocity. A gentle push (an air hit holding them up, the hang after
		-- an uppercut) holds the body there, still turning and limp; anything
		-- faster throws it.
		if duration > 0.05 and velocity.Magnitude <= Config.Physics.RagdollHoldSpeed then
			Impulse.Apply(root, velocity, duration, "Knockback", 0.45)
		else
			CombatService.Tumble(root, velocity)
		end
	elseif player then
		Remotes.Impulse:FireClient(player, velocity, duration, options)
	else
		Impulse.Apply(root, velocity, duration, "Knockback", if options then nil else 0.45)
	end
end

-- Throws a ragdolled body: velocity plus a head-over-heels spin around the
-- axis across the direction of travel.
function CombatService.Tumble(root: BasePart, velocity: Vector3)
	local carry = Config.Physics.RagdollCarry
	local thrown = Vector3.new(velocity.X * carry, velocity.Y, velocity.Z * carry)
	local spin = Vector3.zero
	local across = Vector3.new(velocity.X, 0, velocity.Z):Cross(Vector3.yAxis)
	if across.Magnitude > 0.1 then
		spin = -across.Unit * math.min(velocity.Magnitude * Config.Physics.TumbleSpin, Config.Physics.MaxTumble)
	end
	-- The whole body flies, not just the torso: a ragdoll's limbs are their
	-- own assemblies, and launching the torso alone gets averaged out over
	-- the joints into a weak flop. Each part gets the velocity it would have
	-- if the body were turning as one piece.
	local character = root.Parent
	if character then
		for _, part in character:GetChildren() do
			if part:IsA("BasePart") and not part.Anchored and part ~= root then
				part.AssemblyLinearVelocity = thrown + spin:Cross(part.Position - root.Position)
				part.AssemblyAngularVelocity = spin
			end
		end
	end
	root.AssemblyLinearVelocity = thrown
	root.AssemblyAngularVelocity = spin
end

-- Knockback for a hit. Ragdolled victims of heavy hits go limp for a split
-- second first (hit-stop), then fly. (Not by anchoring them: anchoring and
-- releasing a body mid-air restarts its physics replication, which every
-- screen sees as a hitch right as the launch starts.)
function CombatService.Launch(victim: Model, velocity: Vector3, duration: number, hitStop: number?)
	local root = getRoot(victim)
	if not root then
		return
	end
	if not hitStop or hitStop <= 0 or not Ragdoll.IsActive(victim) then
		CombatService.ApplyVelocity(victim, velocity, duration)
		return
	end
	task.delay(hitStop, function()
		if root.Parent and Ragdoll.IsActive(victim) then
			CombatService.Tumble(root, velocity)
		end
	end)
end

-- Heavier gravity on a ragdoll for `duration` (a multiplier on the world's):
-- a snappy launch that goes up fast and comes straight back down. Gone when
-- the time is up or the ragdoll ends.
function CombatService.HeavyFall(character: Model, multiplier: number, duration: number)
	local extra = workspace.Gravity * (multiplier - 1)
	if extra <= 0 then
		return
	end
	local forces: { Instance } = {}
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and not part.Massless then
			local attachment = Instance.new("Attachment")
			attachment.Name = "HeavyFall"
			attachment.Parent = part
			local force = Instance.new("VectorForce")
			force.Attachment0 = attachment
			force.RelativeTo = Enum.ActuatorRelativeTo.World
			force.ApplyAtCenterOfMass = true
			force.Force = Vector3.new(0, -extra * part:GetMass(), 0)
			force.Parent = attachment
			table.insert(forces, attachment)
		end
	end
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if os.clock() - started < duration and Ragdoll.IsActive(character) then
			return
		end
		connection:Disconnect()
		for _, attachment in forces do
			attachment:Destroy()
		end
	end)
end

function CombatService.IsAirborne(character: Model): boolean
	local root = getRoot(character)
	if not root then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	-- R6 stands with its root 3 studs up; a little more than that is air.
	return workspace:Raycast(root.Position, Vector3.new(0, -3.6, 0), params) == nil
end

-- In the air: for players, exactly what their own client says (their
-- physics are theirs; the server sees them a ping late both taking off and
-- landing). The server's raycast only decides for NPCs, which send nothing.
local function inAir(character: Model, clientSaysAirborne: boolean?): boolean
	if clientSaysAirborne ~= nil then
		return clientSaysAirborne
	end
	return CombatService.IsAirborne(character)
end

function CombatService.Ragdoll(character: Model, duration: number)
	local data = registry[character]
	if not data then
		return
	end
	data.ragdollToken += 1
	local token = data.ragdollToken

	CombatState.SetBlocking(character, false)
	Ragdoll.Enable(character)
	CombatState.Stun(character, duration)

	task.delay(duration, function()
		if registry[character] == data and data.ragdollToken == token and CombatState.IsAlive(character) then
			Ragdoll.Disable(character)
		end
	end)
end

-- Characters in a box / sphere, excluding `attacker`.
CombatService.Box = Hitbox.Box
CombatService.Sphere = Hitbox.Sphere

-- While active, a hit of one of `types` on `character` calls onCounter
-- instead of landing.
function CombatService.SetCounter(
	character: Model,
	duration: number,
	types: { [string]: boolean },
	onCounter: (attacker: Model, hit: HitInfo) -> (),
	filter: ((attacker: Model, hit: HitInfo) -> boolean)?
)
	local data = registry[character]
	if data then
		data.counter = { untilTime = os.clock() + duration, types = types, onCounter = onCounter, filter = filter }
	end
end

function CombatService.ClearCounter(character: Model)
	local data = registry[character]
	if data then
		data.counter = nil
	end
end

-- Ki reading (Asta's Zetten): while watching, the first character within
-- `radius` of `character` to start a skill or special calls onStart with
-- them. Fires once, then stops.
type SkillWatch = { radius: number, untilTime: number, onStart: (user: Model) -> () }
local skillWatchers: { [Model]: SkillWatch } = {}

function CombatService.WatchSkills(character: Model, radius: number, duration: number, onStart: (user: Model) -> ())
	skillWatchers[character] = { radius = radius, untilTime = os.clock() + duration, onStart = onStart }
end

function CombatService.StopWatchingSkills(character: Model)
	skillWatchers[character] = nil
end

local function notifySkillStart(user: Model)
	local userRoot = getRoot(user)
	if not userRoot then
		return
	end
	for watcher, watch in skillWatchers do
		local watcherRoot = getRoot(watcher)
		if os.clock() > watch.untilTime or not watcherRoot then
			skillWatchers[watcher] = nil
		elseif watcher ~= user and (watcherRoot.Position - userRoot.Position).Magnitude <= watch.radius then
			skillWatchers[watcher] = nil
			task.spawn(watch.onStart, user)
		end
	end
end

-- True if `slot`'s key was pressed (while on cooldown) after `since`.
-- Whether the last on-cooldown press of `slot` was made in the air.
function CombatService.PressedAirborne(character: Model, slot: number): boolean
	local data = registry[character]
	return data ~= nil and data.skillInputAir[slot] == true
end

-- Changes whenever another skill, special or awakening starts.
function CombatService.MoveToken(character: Model): number
	local data = registry[character]
	return if data then data.moveToken else -1
end

function CombatService.PressedSince(character: Model, slot: number, since: number): boolean
	local data = registry[character]
	local pressed = data and data.skillInputs[slot]
	return pressed ~= nil and pressed >= since
end

function CombatService.Heal(character: Model, amount: number)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.Health + amount, humanoid.MaxHealth)
	end
end

--[[
	Grabs: the victim is pinned in front of the attacker (the server takes
	over its physics) until the returned release() is called or `maxTime`
	passes. `offset` is relative to the attacker's root. The victim is
	stunned for the whole grab.
]]
--[[
	Holds `victim` at `offset` from the attacker's root (server side: what
	hitboxes see) for up to `maxTime`. Every client draws them pinned to
	the attacker's `hand` part instead, playing their "Grabbed" struggle
	(see Client/Moves), so the hold looks solid at any ping. Returns
	release() and hold(newOffset) for moves that change grip mid-grab.
]]
function CombatService.Grab(
	attacker: Model,
	victim: Model,
	offset: CFrame,
	maxTime: number,
	hand: string?
): (() -> (), (CFrame) -> ())
	local victimData = registry[victim]
	local victimRoot = getRoot(victim)
	local attackerRoot = getRoot(attacker)
	local humanoid = victimData and victimData.humanoid
	if not victimData or not victimRoot or not attackerRoot or not humanoid then
		return function() end, function() end
	end

	victimData.grabbedBy = attacker
	CombatState.SetBlocking(victim, false)
	CombatState.Stun(victim, maxTime + 0.2)
	local player = Players:GetPlayerFromCharacter(victim)
	if player then
		pcall(victimRoot.SetNetworkOwner, victimRoot, nil)
	end
	humanoid.PlatformStand = true
	CombatService.FireVFX("Grabbed", {
		victim = victim,
		attacker = attacker,
		offset = offset,
		duration = maxTime,
		hand = hand,
	})

	local released = false
	local connection
	local function release()
		if released then
			return
		end
		released = true
		connection:Disconnect()
		victimData.grabbedBy = nil
		if humanoid.Parent then
			humanoid.PlatformStand = false
		end
		if player and victimRoot.Parent and not Ragdoll.IsActive(victim) then
			pcall(victimRoot.SetNetworkOwner, victimRoot, player)
		end
		CombatService.FireVFX("GrabReleased", { victim = victim })
	end

	connection = RunService.Heartbeat:Connect(function()
		if not attackerRoot.Parent or not victimRoot.Parent or humanoid.Health <= 0 then
			release()
			return
		end
		victimRoot.AssemblyLinearVelocity = Vector3.zero
		victimRoot.CFrame = attackerRoot.CFrame * offset
	end)
	task.delay(maxTime, release)
	return release, function(newOffset: CFrame)
		offset = newOffset
	end
end

--[[
	Cutscenes: holds characters on scripted paths. Each root is anchored and
	moved every frame to paths[character](t) until `length` (or stop()),
	then players get their physics back. Clients draw the same paths
	themselves for smoothness (see Shared/BlackMoon).
]]
function CombatService.Cutscene(paths: { [Model]: (number) -> CFrame }, length: number): () -> ()
	type Held = { character: Model, root: BasePart, path: (number) -> CFrame, player: Player? }
	local held: { Held } = {}
	for character, path in paths do
		local root = getRoot(character)
		if root then
			root.Anchored = true
			table.insert(held, {
				character = character,
				root = root,
				path = path,
				player = Players:GetPlayerFromCharacter(character),
			})
		end
	end

	local start = os.clock()
	local stopped = false
	local connection
	local function stop()
		if stopped then
			return
		end
		stopped = true
		connection:Disconnect()
		for _, entry in held do
			local root = entry.root
			if root.Parent then
				root.Anchored = false
				root.AssemblyLinearVelocity = Vector3.zero
				if entry.player and not Ragdoll.IsActive(entry.character) then
					pcall(root.SetNetworkOwner, root, entry.player)
				end
			end
		end
	end
	connection = RunService.Heartbeat:Connect(function()
		local t = math.min(os.clock() - start, length)
		for _, entry in held do
			if entry.root.Parent then
				entry.root.CFrame = entry.path(t)
			end
		end
		if t >= length then
			stop()
		end
	end)
	return stop
end

-- Fires the crater effect roughly when a downslammed victim reaches the ground.
local function scheduleCrater(victim: Model, attacker: Model)
	local root = getRoot(victim)
	if not root then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { victim, attacker }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -80, 0), params)
	if not result then
		return
	end
	local fallTime = math.clamp((root.Position.Y - result.Position.Y - 2) / Config.M1.DownslamForce, 0, 1)
	task.delay(fallTime, function()
		CombatService.FireVFX("Crater", { position = result.Position, small = true })
		CombatService.Shake(victim, 0.5)
		CombatService.Shake(attacker, 0.4)
	end)
end

---------------------------------------------------------------------------
-- Hits
---------------------------------------------------------------------------

--[[
	Lands (or fails to land) a hit. Returns what happened:
	"Hit" | "Blocked" | "Parried" | "GuardBreak" | "Countered" | "Immune" | "None"
]]
function CombatService.Hit(attacker: Model, victim: Model, hit: HitInfo): string
	local humanoid = victim:FindFirstChildOfClass("Humanoid")
	local victimRoot = getRoot(victim)
	local attackerRoot = getRoot(attacker)
	if not humanoid or not victimRoot or not attackerRoot or humanoid.Health <= 0 then
		return "None"
	end
	local attackerData = registry[attacker]
	local victimData = registry[victim]
	local now = os.clock()
	-- No hitting people on the floor: stops infinites. A body still in the
	-- air from an uppercut can be hit for a moment, so the combo carries on.
	local juggled = victimData ~= nil and now < victimData.juggleUntil and CombatService.IsAirborne(victim)
	if CombatState.HasIFrames(victim) or (CombatState.IsRagdolled(victim) and not juggled and not hit.hitsDowned) then
		return "Immune"
	end

	if attackerData then
		attackerData.lastCombat = now
	end
	if victimData then
		victimData.lastCombat = now
	end

	local attackType = hit.attackType or "Melee"
	local counter = victimData and victimData.counter
	if
		counter
		and now <= counter.untilTime
		and counter.types[attackType]
		and (not counter.filter or counter.filter(attacker, hit))
	then
		victimData.counter = nil
		task.spawn(counter.onCounter, attacker, hit)
		return "Countered"
	end

	local toAttacker = flat(attackerRoot.Position - victimRoot.Position)
	local look = flat(attackerRoot.CFrame.LookVector)
	local contact = victimRoot.Position + toAttacker * 1.2
	-- Whose weapons met, so clients can draw the right clash (sword sparks...).
	local clash = {
		position = contact,
		victim = victim,
		attacker = attacker,
		kit = attacker:GetAttribute("Kit"),
		victimKit = victim:GetAttribute("Kit"),
	}

	local facing = victimRoot.CFrame.LookVector:Dot(toAttacker) > Config.Block.FacingDot
	if CombatState.IsBlocking(victim) and facing and not hit.unblockable then
		local blockAge = CombatState.Now() - (tonumber(victim:GetAttribute("BlockStart")) or 0)

		if blockAge <= Config.Block.PerfectWindow then
			CombatState.Stun(attacker, Config.Block.ParryStun)
			CombatService.FireVFX("PerfectBlock", clash)
			CombatService.Shake(attacker, 0.6)
			CombatService.Shake(victim, 0.35)
			return "Parried"
		end

		if hit.guardBreak then
			CombatState.SetBlocking(victim, false)
			CombatState.Stun(victim, Config.Block.GuardBreakStun)
			CombatService.FireVFX("GuardBreak", clash)
			CombatService.Shake(attacker, 0.4)
			CombatService.Shake(victim, 0.6)
			return "GuardBreak"
		end

		CombatService.FireVFX("Block", clash)
		CombatService.ApplyVelocity(victim, -toAttacker * Config.Block.Pushback, 0.12)
		CombatService.Shake(victim, 0.12)
		return "Blocked"
	end

	-- The hit lands.
	local awakening = awakeningOf(attacker)
	local damage = hit.damage * (if awakening then awakening.damageMultiplier else 1)
	if stateActive(attacker, "PowerUntil") then
		damage *= Config.States.PowerMultiplier
	end
	if stateActive(attacker, "WeakUntil") then
		damage *= Config.States.WeakMultiplier
	end
	humanoid:TakeDamage(damage)
	CombatState.SetBlocking(victim, false)
	CombatState.Stun(victim, hit.stun)

	if victimData then
		victimData.lastDamaged = now
	end
	addMeter(victim, "Evasive", damage * Config.Evasive.GainPerDamage, Config.Evasive.Max)
	if not CombatState.IsAwakened(attacker) then
		addMeter(attacker, "Awakening", damage * Config.Awakening.GainPerDamageDealt, Config.Awakening.Max)
	else
		-- Fighting in the first stage charges the second (Yuno's Full-Crown).
		local ascension = pendingAscension(attacker)
		if ascension and not ascension.chargeByKit then
			addMeter(attacker, "Ascension", damage, ascension.charge)
		end
	end
	if not CombatState.IsAwakened(victim) then
		addMeter(victim, "Awakening", damage * Config.Awakening.GainPerDamageTaken, Config.Awakening.Max)
	end

	local variant = hit.variant
	local heavy = hit.heavy == true or (variant ~= nil and variant ~= "Normal")
	-- The finishers that knock them down end a juggle.
	if victimData and (variant == "Knockback" or variant == "Downslam") then
		victimData.juggleUntil = 0
	end
	if variant == "Knockback" then
		CombatService.Ragdoll(victim, Config.Ragdoll.Duration)
		CombatService.Launch(
			victim,
			look * Config.M1.KnockbackForce + Vector3.new(0, Config.M1.KnockbackLift, 0),
			0.2,
			Config.Physics.HitStop
		)
	elseif variant == "Uppercut" then
		-- Knocked off their feet and sent up tumbling, high and fast: about
		-- 10 studs on heavier gravity, so it snaps up and comes straight back
		-- down. They can still be hit on the way: jump after them.
		CombatService.Ragdoll(victim, Config.M1.UppercutRagdoll)
		if victimData then
			victimData.juggleUntil = now + Config.M1.JuggleTime
		end
		CombatService.Launch(victim, Vector3.new(0, Config.M1.UppercutForce, 0) + look * 5, 0.2, Config.Physics.HitStop)
		CombatService.HeavyFall(victim, Config.M1.UppercutGravity, Config.M1.UppercutRagdoll)
	elseif variant == "Downslam" then
		CombatService.Ragdoll(victim, Config.Ragdoll.Duration)
		CombatService.Launch(
			victim,
			look * 10 + Vector3.new(0, -Config.M1.DownslamForce, 0),
			0.2,
			Config.Physics.HitStop
		)
		scheduleCrater(victim, attacker)
	elseif variant == "Normal" then
		if juggled and victimData then
			-- Kept up in the air (and limp) while the hits keep coming.
			CombatService.Ragdoll(victim, Config.M1.AirFloat + 0.9)
			victimData.juggleUntil = now + Config.M1.AirFloat + 0.6
		end
		if hit.airborne then
			local float = Vector3.new(0, 3, 0) + look * 3
			CombatService.ApplyVelocity(victim, float, Config.M1.AirFloat)
			CombatService.ApplyVelocity(attacker, float, Config.M1.AirFloat)
		else
			CombatService.ApplyVelocity(victim, look * Config.M1.Push, Config.M1.PushTime)
		end
	else
		-- Skill hits.
		if hit.ragdoll then
			CombatService.Ragdoll(victim, hit.ragdoll)
		end
		if hit.velocity then
			CombatService.Launch(
				victim,
				hit.velocity,
				hit.velocityTime or 0.2,
				if heavy then Config.Physics.HitStop else nil
			)
		end
	end

	CombatService.FireVFX(hit.effect or (if heavy then "HeavyHit" else "Hit"), {
		position = contact,
		direction = look,
		attacker = attacker,
		victim = victim,
		damage = math.floor(damage * 10 + 0.5) / 10,
		variant = variant,
		kit = attacker:GetAttribute("Kit"),
		hitConfirm = true,
	})
	if not hit.noShake then
		CombatService.Shake(attacker, if heavy then 0.45 else 0.18)
		CombatService.Shake(victim, if heavy then 0.7 else 0.3)
	end
	return "Hit"
end

---------------------------------------------------------------------------
-- Core moves
---------------------------------------------------------------------------

-- One swing of the M1 string. `jump` = jump held, turns the finisher into an uppercut.
function CombatService.M1(character: Model, jump: boolean?, clientAirborne: boolean?, clientIndex: number?)
	local data = registry[character]
	if
		not data
		or not CombatState.CanAct(character)
		or CombatState.IsBlocking(character)
		or CombatState.IsCasting(character)
		or character:GetAttribute("SwordAway") == true
	then
		return
	end
	local t = os.clock()
	if t < data.nextM1 - Config.M1.InputTolerance then
		return
	end
	if t - data.lastM1 > Config.M1.ResetTime then
		data.combo = 0
	end

	data.combo += 1
	-- Follow the player's own count of the string (the swing they see),
	-- so a click dropped on the way or a reset that landed differently
	-- here can't turn their uppercut into a normal hit and the next swing
	-- into a downslam. Swing timing is still enforced above.
	if clientIndex and clientIndex >= 1 and clientIndex <= Config.M1.ComboLength then
		data.combo = clientIndex
	end
	data.lastM1 = t
	local index = data.combo
	local finisher = index >= Config.M1.ComboLength
	local airborne = inAir(character, clientAirborne)

	local variant = "Normal"
	if finisher then
		data.combo = 0
		data.nextM1 = t + Config.M1.EndLag
		-- In the air the finisher is always the downslam (holding Space from
		-- the jump shouldn't turn it into an uppercut).
		if airborne then
			variant = "Downslam"
		elseif jump then
			variant = "Uppercut"
			data.nextM1 = t + Config.M1.UppercutEndLag
		else
			variant = "Knockback"
		end
	else
		data.nextM1 = t + Config.M1.SwingCooldown
	end
	CombatState.SetBusy(
		character,
		if variant == "Uppercut"
			then Config.M1.UppercutJumpAfter + 0.05 -- free to jump after them almost at once
			elseif finisher then Config.M1.FinisherBusy
			elseif index == Config.M1.ComboLength - 1 then Config.M1.DownslamJumpAfter -- jump for the downslam
			else Config.M1.Busy
	)

	CombatService.FireVFX("Swing", {
		character = character,
		index = index,
		finisher = finisher,
		variant = variant,
	})

	task.delay(if finisher then m1Value(character, "FinisherWindUp") else m1Value(character, "WindUp"), function()
		-- Getting hit during wind-up cancels the swing.
		if not CombatState.CanAct(character) then
			return
		end
		local root = getRoot(character)
		if not root then
			return
		end
		local hitboxCFrame = root.CFrame * CFrame.new(0, 0, -m1Value(character, "HitboxOffset"))
		local hitboxSize = m1Value(character, "HitboxSize")
		if variant == "Downslam" then
			-- Swung down from the top of a jump: reaches the ground below.
			hitboxCFrame *= CFrame.new(0, -3.5, -0.5)
			hitboxSize += Vector3.new(1, 7, 1)
		end
		for _, victim in Hitbox.Box(character, hitboxCFrame, hitboxSize) do
			CombatService.Hit(character, victim, {
				damage = if finisher then m1Value(character, "FinisherDamage") else m1Value(character, "Damage"),
				stun = if variant == "Uppercut"
					then Config.M1.UppercutStun
					elseif index == Config.M1.ComboLength - 1 then Config.M1.SetupStun
					else Config.M1.HitStun,
				attackType = "Melee",
				variant = variant,
				airborne = airborne,
			})
		end
	end)
end

function CombatService.SetBlock(character: Model, wantBlock: boolean)
	local data = registry[character]
	if not data then
		return
	end
	if wantBlock then
		if
			CombatState.IsBlocking(character)
			or not CombatState.CanAct(character)
			or CombatState.IsBusy(character)
			or CombatState.IsCasting(character)
		then
			return
		end
		if os.clock() < data.nextBlock then
			return
		end
		CombatState.SetBlocking(character, true)
	elseif CombatState.IsBlocking(character) then
		CombatState.SetBlocking(character, false)
		data.nextBlock = os.clock() + Config.Block.Cooldown
	end
end

-- Movement is client-side (the client owns its character), the server only
-- validates the cooldown and tells everyone else to draw the effect.
function CombatService.Dash(character: Model, direction: string): boolean
	local data = registry[character]
	if
		not data
		or not DASH_DIRECTIONS[direction]
		or not CombatState.CanAct(character)
		or CombatState.IsCasting(character)
	then
		return false
	end
	-- Front/back and side dashes have separate cooldowns.
	local t = os.clock()
	local side = direction == "Left" or direction == "Right"
	if t < (if side then data.nextSideDash else data.nextDash) - Config.Dash.Tolerance then
		return false
	end
	local awakening = awakeningOf(character)
	local multiplier = if awakening then awakening.cooldownMultiplier else 1
	if side then
		data.nextSideDash = t + Config.Dash.SideCooldown * multiplier
	else
		data.nextDash = t + Config.Dash.Cooldown * multiplier
	end
	CombatState.SetBlocking(character, false)
	return true
end

-- Breaks out of a combo or ragdoll when the Evasive bar is full.
function CombatService.Evasive(character: Model): boolean
	local data = registry[character]
	if not data or not CombatState.IsAlive(character) then
		return false
	end
	if not (CombatState.IsStunned(character) or CombatState.IsRagdolled(character)) then
		return false
	end
	if (tonumber(character:GetAttribute("Evasive")) or 0) < Config.Evasive.Max then
		return false
	end

	data.ragdollToken += 1
	character:SetAttribute("Evasive", 0)
	Ragdoll.Disable(character, true)
	CombatState.ClearStun(character)
	CombatState.ClearCasting(character)
	CombatState.GiveIFrames(character, Config.Evasive.IFrames)

	local root = getRoot(character)
	if root then
		local back = -flat(root.CFrame.LookVector)
		CombatService.ApplyVelocity(character, back * Config.Evasive.Speed + Vector3.new(0, 8, 0), 0.2)
	end
	CombatService.FireVFX("Evasive", { character = character })
	return true
end

---------------------------------------------------------------------------
-- Kits: skills, awakening, switching
---------------------------------------------------------------------------

local function makeContext(character: Model, airborne: boolean?): Context?
	local data = registry[character]
	local kit = Kits.Of(character)
	local root = getRoot(character)
	if not data or not kit or not root then
		return nil
	end
	return {
		character = character,
		humanoid = data.humanoid,
		root = root,
		player = Players:GetPlayerFromCharacter(character),
		data = data,
		kit = kit,
		awakened = CombatState.IsAwakened(character),
		airborne = airborne == true,
		combat = CombatService,
	}
end

function CombatService.UseSkill(character: Model, slot: number, clientAirborne: boolean?)
	local ctx = makeContext(character, inAir(character, clientAirborne))
	if not ctx then
		return
	end
	local info = Kits.SkillsOf(character)[slot]
	local serverKit = serverKits[ctx.kit.id]
	local moveSet = serverKit and (if ctx.awakened then serverKit.AwakenedSkills else serverKit.Skills)
	local run = moveSet and moveSet[slot]
	if not info or not run then
		return
	end
	-- Small tolerance for clients whose clock/ping makes them a hair early.
	if CombatState.Cooldown(character, slot) > 0.1 then
		-- Pressing a key that's on cooldown can still matter to the skill
		-- that's running (e.g. timing the Black Divider).
		ctx.data.skillInputs[slot] = os.clock()
		ctx.data.skillInputAir[slot] = ctx.airborne
		return
	end
	if not CombatState.CanAct(character) or CombatState.IsCasting(character) then
		return
	end
	ctx.data.skillInputs[slot] = nil

	local awakening = awakeningOf(character)
	CombatState.StartCooldown(character, slot, info.cooldown * (if awakening then awakening.cooldownMultiplier else 1))
	CombatState.SetBlocking(character, false)
	ctx.data.moveToken += 1
	notifySkillStart(character)
	task.spawn(run, ctx)
end

-- The R special (Kits.special, run by the server kit's Special). Presses
-- while it's on cooldown are recorded like skill presses (PressedSince with
-- CombatState.SpecialSlot), so a special can have a follow-up.
function CombatService.UseSpecial(character: Model, clientAirborne: boolean?)
	local ctx = makeContext(character, inAir(character, clientAirborne))
	if not ctx then
		return
	end
	-- Awakened, a kit can have a different special (Asta swaps swords).
	local serverKit = serverKits[ctx.kit.id]
	local awakenedSpecial = ctx.awakened and ctx.kit.awakenedSpecial ~= nil and serverKit and serverKit.AwakenedSpecial
	local info = if awakenedSpecial then ctx.kit.awakenedSpecial else ctx.kit.special
	local run = if awakenedSpecial then serverKit.AwakenedSpecial else serverKit and serverKit.Special
	if not info or not run then
		return
	end
	local slot = CombatState.SpecialSlot
	if CombatState.Cooldown(character, slot) > 0.1 then
		ctx.data.skillInputs[slot] = os.clock()
		ctx.data.skillInputAir[slot] = ctx.airborne
		return
	end
	if not CombatState.CanAct(character) or CombatState.IsCasting(character) then
		return
	end
	ctx.data.skillInputs[slot] = nil
	local awakening = awakeningOf(character)
	CombatState.StartCooldown(character, slot, info.cooldown * (if awakening then awakening.cooldownMultiplier else 1))
	CombatState.SetBlocking(character, false)
	ctx.data.moveToken += 1
	notifySkillStart(character)
	task.spawn(run, ctx)
end

local function endAwakening(character: Model)
	local data = registry[character]
	if data then
		data.awakenToken += 1
	end
	if CombatState.IsAwakened(character) then
		character:SetAttribute("Awakened", false)
		character:SetAttribute("Ascended", false)
		character:SetAttribute("Ascension", 0)
		CombatState.ResetCooldowns(character)
		local kit = Kits.Of(character)
		local serverKit = kit and serverKits[kit.id]
		local ctx = makeContext(character)
		if serverKit and serverKit.AwakenEnd and ctx then
			task.spawn(serverKit.AwakenEnd, ctx)
		end
	end
end

-- The meter drains over `duration`, and the awakening ends when it's empty.
-- A new drain (the second stage starting) replaces the old one.
local function drainAwakening(character: Model, data: CharData, duration: number)
	data.awakenToken += 1
	local token = data.awakenToken
	character:SetAttribute("Awakening", Config.Awakening.Max)
	task.spawn(function()
		local start = os.clock()
		while data.awakenToken == token and registry[character] == data do
			local remaining = 1 - (os.clock() - start) / duration
			if remaining <= 0 then
				character:SetAttribute("Awakening", 0)
				endAwakening(character)
				break
			end
			character:SetAttribute("Awakening", Config.Awakening.Max * remaining)
			task.wait(0.25)
		end
	end)
end

-- G again while awakened, once the second stage is charged (Kits ascension):
-- its own moves, stats and a fresh timer.
local function ascend(ctx: Context)
	local character, data = ctx.character, ctx.data
	local ascension = pendingAscension(character)
	local serverKit = serverKits[ctx.kit.id]
	if not ascension or not serverKit or not serverKit.Ascend then
		return
	end
	if not CombatState.CanAct(character) or CombatState.IsCasting(character) then
		return
	end
	if (tonumber(character:GetAttribute("Ascension")) or 0) < ascension.charge then
		return
	end
	character:SetAttribute("Ascended", true)
	character:SetAttribute("Ascension", 0)
	CombatState.ResetCooldowns(character)
	data.moveToken += 1
	drainAwakening(character, data, ascension.duration)
	task.spawn(serverKit.Ascend, ctx)
end

function CombatService.Awaken(character: Model)
	local ctx = makeContext(character)
	if not ctx then
		return
	end
	local awakening = ctx.kit.awakening
	local serverKit = serverKits[ctx.kit.id]
	if not awakening or not serverKit or not serverKit.Awaken then
		return
	end
	if CombatState.IsAwakened(character) then
		ascend(ctx)
		return
	end
	if not CombatState.CanAct(character) or CombatState.IsCasting(character) then
		return
	end
	if (tonumber(character:GetAttribute("Awakening")) or 0) < Config.Awakening.Max then
		return
	end

	local data = ctx.data
	character:SetAttribute("Awakened", true)
	character:SetAttribute("Ascension", 0)
	CombatState.ResetCooldowns(character) -- fresh awakened move set
	ctx.awakened = true
	data.moveToken += 1
	drainAwakening(character, data, awakening.duration)
	task.spawn(serverKit.Awaken, ctx)
end

-- Puts `kitId` on a character: weapon model, fresh cooldowns, no awakening.
function CombatService.EquipKit(character: Model, kitId: string)
	local oldId = character:GetAttribute("Kit")
	if type(oldId) == "string" and serverKits[oldId] and serverKits[oldId].Unequip then
		serverKits[oldId].Unequip(character)
	end
	endAwakening(character)
	character:SetAttribute("Awakening", 0)
	CombatState.ResetCooldowns(character)
	CombatState.ResetSpecial(character)
	CombatService.ClearCounter(character)

	-- Weapon first, then the attribute: clients react to "Kit" by animating
	-- the weapon, so it should already be there when they see the change.
	local serverKit = serverKits[kitId]
	if serverKit and serverKit.Equip then
		serverKit.Equip(character)
	end
	character:SetAttribute("Kit", kitId)
end

-- A kit's spawn entrance, if it has one. Slightly delayed so clients have
-- the freshly spawned character (and its weapon) before it starts.
function CombatService.PlayEntrance(character: Model)
	task.delay(0.35, function()
		local ctx = makeContext(character)
		local serverKit = ctx and serverKits[ctx.kit.id]
		if ctx and serverKit and serverKit.Entrance and CombatState.IsAlive(character) then
			serverKit.Entrance(ctx)
		end
	end)
end

function CombatService.SelectKit(player: Player, kitId: string)
	local kit = Kits.Get(kitId)
	if not kit or not kit.playable then
		return
	end
	local character = player.Character
	local data = character and registry[character]
	if not character or not data or not CombatState.IsAlive(character) then
		player:SetAttribute("Kit", kitId) -- applies on next spawn
		return
	end
	-- Same character again is allowed: it re-equips in place, which also
	-- repairs a missing weapon or a half-applied kit.
	if
		os.clock() - data.lastCombat < Config.KitSwitchCombatLock
		or not CombatState.CanAct(character)
		or CombatState.IsCasting(character)
	then
		CombatService.Notify(character, "You can't switch characters in combat!", Color3.fromRGB(255, 90, 90))
		return
	end

	player:SetAttribute("Kit", kitId)
	CombatService.EquipKit(character, kitId)
	CombatService.FireVFX("KitSwitch", { character = character, kit = kitId })
	CombatService.PlayEntrance(character)
	CombatService.Notify(character, "Now playing: " .. kit.title, kit.color)
end

---------------------------------------------------------------------------
-- Registration and the main loop
---------------------------------------------------------------------------

function CombatService.Register(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid or registry[character] then
		return
	end
	character:WaitForChild("HumanoidRootPart", 10)

	CombatState.Setup(character)
	humanoid.BreakJointsOnDeath = false
	-- Ragdolls swap the Neck motor for a socket; a player's own client kills
	-- them the moment their neck "breaks" unless this is off.
	humanoid.RequiresNeck = false
	humanoid.UseJumpPower = false
	-- Only our ragdoll should knock people over. (For players this has to be
	-- repeated on their client, see Input.)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

	local data: CharData = {
		humanoid = humanoid,
		combo = 0,
		lastM1 = 0,
		nextM1 = 0,
		nextBlock = 0,
		nextDash = 0,
		nextSideDash = 0,
		ragdollToken = 0,
		juggleUntil = 0,
		awakenToken = 0,
		lastDamaged = 0,
		lastCombat = 0,
		counter = nil,
		skillInputs = {},
		skillInputAir = {},
		moveToken = 0,
		grabbedBy = nil,
	}
	registry[character] = data

	humanoid.Died:Connect(function()
		data.ragdollToken += 1 -- stop any pending get-up
		endAwakening(character)
		Ragdoll.Enable(character)
	end)

	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			registry[character] = nil
			Ragdoll.Forget(character)
		end
	end)

	-- Players get their chosen character's kit. Dummies stay kit-less.
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		-- Wait for the avatar to be applied: it can replace the limbs a
		-- weapon would be welded to.
		local waited = 0
		while character:GetAttribute("AvatarLoaded") ~= true and waited < 6 and character.Parent do
			waited += task.wait(0.1)
		end
		if not character.Parent then
			return
		end
		local kitId = player:GetAttribute("Kit")
		local kit = Kits.Get(if type(kitId) == "string" then kitId else nil)
		if not kit or not kit.playable then
			kitId = Kits.Default
			player:SetAttribute("Kit", kitId)
		end
		CombatService.EquipKit(character, kitId :: string)
		CombatService.PlayEntrance(character)
	end
end

local lastAirJump: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any

local function onAction(player: Player, action: unknown, payload: unknown, extra: unknown)
	-- Moves that have an air version say whether the player was in the air.
	-- nil when the client didn't say (the server's raycast decides then).
	local function saysAirborne(value: unknown): boolean?
		if type(value) ~= "table" or type((value :: any).airborne) ~= "boolean" then
			return nil
		end
		return (value :: any).airborne
	end
	local character = player.Character
	if type(action) ~= "string" then
		return
	end
	if action == "SelectKit" then
		if type(payload) == "string" then
			CombatService.SelectKit(player, payload)
		end
		return
	end
	if not character or not registry[character] then
		return
	end

	if action == "M1" then
		local jump = type(payload) == "table" and (payload :: any).jump == true
		local index = if type(payload) == "table" and type((payload :: any).index) == "number"
			then math.floor((payload :: any).index)
			else nil
		CombatService.M1(character, jump, saysAirborne(payload), index)
	elseif action == "Block" then
		CombatService.SetBlock(character, payload == true)
	elseif action == "Dash" then
		if type(payload) == "string" and CombatService.Dash(character, payload) then
			-- The dasher already drew their own effect.
			for _, other in Players:GetPlayers() do
				if other ~= player then
					Remotes.VFX:FireClient(other, "Dash", { character = character, direction = payload })
				end
			end
		end
	elseif action == "AirJump" then
		-- The jump itself is the player's own movement; everyone else just
		-- sees the gust. Only kits that can (Kits airJumps), not too often.
		local kit = Kits.Of(character)
		local now = os.clock()
		if kit and kit.airJumps and CombatState.IsAlive(character) and now - (lastAirJump[character] or 0) > 0.2 then
			lastAirJump[character] = now
			for _, other in Players:GetPlayers() do
				if other ~= player then
					Remotes.VFX:FireClient(other, "AirJump", { character = character })
				end
			end
		end
	elseif action == "Evasive" then
		CombatService.Evasive(character)
	elseif action == "Skill" then
		if type(payload) == "number" and payload >= 1 and payload <= CombatState.SkillSlots then
			CombatService.UseSkill(character, math.floor(payload), saysAirborne(extra))
		end
	elseif action == "Special" then
		CombatService.UseSpecial(character, saysAirborne(payload))
	elseif action == "Awaken" then
		CombatService.Awaken(character)
	end
end

-- Movement speed follows combat state every frame.
local function updateMovement()
	for character, data in registry do
		local humanoid = data.humanoid
		if humanoid.Health > 0 then
			local awakening = awakeningOf(character)
			local bonus = if awakening then awakening.speedBonus else 0
			local speed, jump = Config.Movement.WalkSpeed + bonus, Config.Movement.JumpHeight
			if CombatState.IsRagdolled(character) or character:GetAttribute("Rooted") == true then
				speed, jump = 0, 0
			elseif CombatState.IsStunned(character) then
				speed, jump = Config.Movement.StunnedSpeed, 0
			elseif CombatState.IsCasting(character) then
				speed, jump = Config.Movement.CastingSpeed, 0
			elseif CombatState.IsBlocking(character) then
				speed, jump = Config.Movement.BlockingSpeed, 0
			elseif CombatState.IsBusy(character) then
				speed, jump = Config.Movement.AttackingSpeed + bonus, 0
			end
			if stateActive(character, "SlowUntil") then
				speed *= Config.States.SlowMultiplier
			end
			if humanoid.WalkSpeed ~= speed then
				humanoid.WalkSpeed = speed
			end
			if humanoid.JumpHeight ~= jump then
				humanoid.JumpHeight = jump
			end
		end
	end
end

function CombatService.Start()
	Remotes.Action.OnServerEvent:Connect(onAction)

	-- Body impacts: a fast ragdoll that suddenly stops hit the floor or a wall.
	local lastVelocity: { [Model]: Vector3 } = {}
	local lastImpact: { [Model]: number } = {}
	local function detectImpacts()
		local now = os.clock()
		for character in registry do
			local root = getRoot(character)
			local data = registry[character]
			-- (Coming down from an uppercut is a soft landing, not a slam.)
			local juggling = data ~= nil and now < data.juggleUntil + 0.6
			if root and Ragdoll.IsActive(character) and not root.Anchored and not juggling then
				local velocity = root.AssemblyLinearVelocity
				local previous = lastVelocity[character]
				if
					previous
					and previous.Magnitude > Config.Physics.ImpactSpeed
					and (previous - velocity).Magnitude > previous.Magnitude * 0.5
					and now - (lastImpact[character] or 0) > 0.35
				then
					lastImpact[character] = now
					local strength = math.clamp(previous.Magnitude / 90, 0.3, 1)
					CombatService.FireVFX("BodyImpact", { position = root.Position, strength = strength })
					CombatService.ShakeArea(root.Position, 35, 0.3 * strength)
				end
				lastVelocity[character] = velocity
			else
				lastVelocity[character] = nil
			end
		end
		for character in lastImpact do
			if not registry[character] then
				lastImpact[character] = nil
			end
		end
	end

	local regenTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		updateMovement()
		detectImpacts()

		-- Attribute writes replicate, so the passive regen ticks 4 times a second.
		regenTimer += dt
		if regenTimer >= 0.25 then
			for character in registry do
				addMeter(character, "Evasive", Config.Evasive.RegenPerSecond * regenTimer, Config.Evasive.Max)
			end
			regenTimer = 0
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Dummies</string>
          <string name="Source"><![CDATA[--[[
	Dummies
	Test NPCs in front of spawn. They use the real combat rules:
	  Dummy           - stands still, heals after a few seconds
	  Blocking Dummy  - always blocks and faces you (test guard breaks)
	  Attacking Dummy - throws full M1 strings at you (test blocks, perfect blocks, Evasive)
]]

local Players = game:GetService("Players")

local CombatService = require(script.Parent.CombatService)
local CombatState = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").CombatState)

type Spec = {
	name: string,
	behavior: "Idle" | "Block" | "Attack",
	color: Color3,
	position: Vector3,
}

local SPECS: { Spec } = {
	{ name = "Dummy", behavior = "Idle", color = Color3.fromRGB(225, 225, 225), position = Vector3.new(-12, 3, -28) },
	{
		name = "Blocking Dummy",
		behavior = "Block",
		color = Color3.fromRGB(80, 140, 255),
		position = Vector3.new(0, 3, -28),
	},
	{
		name = "Attacking Dummy",
		behavior = "Attack",
		color = Color3.fromRGB(255, 90, 90),
		position = Vector3.new(12, 3, -28),
	},
}

local RESPAWN_TIME = 3
local REGEN_DELAY = 3
local AGGRO_RANGE = 25
local ATTACK_RANGE = 6.5

local folder = Instance.new("Folder")
folder.Name = "Dummies"
folder.Parent = workspace

local Dummies = {}

local function nearestPlayerRoot(position: Vector3, range: number): BasePart?
	local best, bestDistance = nil, range
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and CombatState.IsAlive(character) then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = root, distance
			end
		end
	end
	return best
end

local function face(root: BasePart, target: Vector3)
	local flatTarget = Vector3.new(target.X, root.Position.Y, target.Z)
	if (flatTarget - root.Position).Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(root.Position, flatTarget)
	end
end

local function runBehavior(model: Model, spec: Spec, humanoid: Humanoid, root: BasePart)
	while model.Parent and humanoid.Health > 0 do
		local data = CombatService.GetData(model)

		-- Heal back to full when left alone.
		if data and os.clock() - data.lastDamaged > REGEN_DELAY and humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end

		local target = nearestPlayerRoot(root.Position, AGGRO_RANGE)
		local canAct = CombatState.CanAct(model)

		if spec.behavior == "Block" then
			if target and canAct then
				face(root, target.Position)
			end
			if canAct and not CombatState.IsBlocking(model) then
				CombatService.SetBlock(model, true)
			end
			task.wait(0.1)
		elseif spec.behavior == "Attack" then
			if target and canAct then
				face(root, target.Position)
				if (target.Position - root.Position).Magnitude <= ATTACK_RANGE then
					-- A full 4 hit string, then a breather.
					for _ = 1, 4 do
						if not CombatState.CanAct(model) then
							break
						end
						face(root, target.Position)
						CombatService.M1(model)
						task.wait(0.34)
					end
					task.wait(2)
				end
			end
			task.wait(0.1)
		else
			task.wait(0.5)
		end
	end
end

local function spawnDummy(spec: Spec)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = spec.color
	description.TorsoColor = spec.color
	description.LeftArmColor = spec.color
	description.RightArmColor = spec.color
	description.LeftLegColor = spec.color
	description.RightLegColor = spec.color

	local model = Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R6)
	model.Name = spec.name

	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	humanoid.DisplayName = spec.name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer

	model:PivotTo(CFrame.lookAt(spec.position, Vector3.new(0, spec.position.Y, 0)))
	model.Parent = folder
	root:SetNetworkOwner(nil)

	CombatService.Register(model)

	humanoid.Died:Connect(function()
		task.delay(RESPAWN_TIME, function()
			model:Destroy()
			spawnDummy(spec)
		end)
	end)

	task.spawn(runBehavior, model, spec, humanoid, root)
end

function Dummies.Start()
	for _, spec in SPECS do
		task.spawn(spawnDummy, spec)
	end
end

return Dummies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Hitbox</string>
          <string name="Source"><![CDATA[--[[
	Hitbox
	Spatial queries that return the characters (anything with a Humanoid)
	inside a region. Each character is returned at most once.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CombatState = require(Shared.CombatState)

local Hitbox = {}

local function characterFromPart(part: BasePart): Model?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

local function visualize(cframe: CFrame, size: Vector3)
	local box = Instance.new("Part")
	box.Name = "HitboxDebug"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.Material = Enum.Material.ForceField
	box.Color = Color3.fromRGB(255, 40, 40)
	box.CFrame = cframe
	box.Size = size
	box.Parent = workspace
	Debris:AddItem(box, 0.25)
end

function Hitbox.Box(attacker: Model, cframe: CFrame, size: Vector3): { Model }
	if Config.Debug.ShowHitboxes then
		visualize(cframe, size)
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { attacker }

	local found: { Model } = {}
	local seen: { [Model]: boolean } = {}
	for _, part in workspace:GetPartBoundsInBox(cframe, size, params) do
		local character = characterFromPart(part)
		if character and not seen[character] and CombatState.IsAlive(character) then
			seen[character] = true
			table.insert(found, character)
		end
	end
	return found
end

function Hitbox.Sphere(attacker: Model, position: Vector3, radius: number): { Model }
	if Config.Debug.ShowHitboxes then
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Anchored = true
		ball.CanCollide = false
		ball.CanQuery = false
		ball.CanTouch = false
		ball.Material = Enum.Material.ForceField
		ball.Color = Color3.fromRGB(255, 40, 40)
		ball.Size = Vector3.one * radius * 2
		ball.Position = position
		ball.Parent = workspace
		Debris:AddItem(ball, 0.25)
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { attacker }

	local found: { Model } = {}
	local seen: { [Model]: boolean } = {}
	for _, part in workspace:GetPartBoundsInRadius(position, radius, params) do
		local character = characterFromPart(part)
		if character and not seen[character] and CombatState.IsAlive(character) then
			seen[character] = true
			table.insert(found, character)
		end
	end
	return found
end

return Hitbox
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Kits</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">AntiMagic</string>
            <string name="Source"><![CDATA[--[[
	Anti-Magic Knight (Asta), server side.

	Built like Vessel (JJS) / Hero Hunter (TSB): a close-range rushdown
	character with a rush combo, a grab, a timing-based heavy and a counter.
	Awakening swaps to a whole new move set like Sukuna / Rampage Mode.

	Base
	  1 Bull Thrust         charge in sword-first; on contact, a five-hit sword combo
	                        ending in a thrust (in the air: dives diagonally down,
	                        and if it catches no one he slams the ground, guard break)
	  2 Black Meteorite     standing anti-magic grab (no dash), carry them up, slam into
	                        a crater (unblockable)
	  3 Black Divider       charged cleave. Press 3 again on the red flash for a
	                        perfect Divider: huge damage, unblockable
	  4 Anti-Magic Deflect  counters EVERY attack type. Melee attackers get slashed
	                        aside, ranged attacks are sent back as a Black Slash
	Black Form (G). R swaps to another of his swords at random; moves 1 and 2
	belong to the sword in his hand:
	  Demon-Slayer Sword    1 Black Hurricane: spinning charge that drags enemies along
	                        2 Slayer Recall: boomerang throw, press 2 again to call it back
	  Demon-Dweller Sword   1 Black Slash: piercing anti-magic slash wave
	                        2 Conquering Eon: absorbs spells and siphons mana, then
	                          releases it all as one huge slash
	  Demon-Destroyer Sword 1 Causality Break: planted blade breaks the magic (counters,
	                          guard, stances) of the 4 closest enemies
	                        2 Severance: dash-through draw cut that seals their moves
	  Demon-Slasher Katana  1 Infinite Slash: unblockable cut along a straight line
	                        2 Zetten: ki-reading iai stance, cuts down whoever moves
	  3 Grand Divider       massive cleave plus a giant slash wave (guard break)
	  4 Black Moon          cutscene grab: hurls them into the sky, hangs in front
	                        of a giant moon, flies through them and cuts them down

	All visuals are in StarterPlayerScripts.Client.Kits.AntiMagic, which gets
	("Skill", {skill, phase, ...}) events from here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BlackMoon = require(ReplicatedStorage:WaitForChild("Shared").BlackMoon)
local MeteorVortex = require(ReplicatedStorage:WaitForChild("Shared").MeteorVortex)
local CombatState = require(ReplicatedStorage:WaitForChild("Shared").CombatState)
local Projectile = require(script.Parent.Parent.Projectile)

local KIT_ID = "AntiMagic"
local UP = Vector3.yAxis

-- Anti-magic cuts through everything.
-- Holds a character in the air (a tiny upward velocity switches on the
-- vertical force, so gravity stops pulling).
local HOVER = Vector3.new(0, 0.05, 0)
local ALL_TYPES = { Melee = true, Bolt = true, Explosion = true, Swarm = true, Zone = true }

local Kit = {}

---------------------------------------------------------------------------
-- Demon-Slayer Sword model
---------------------------------------------------------------------------

local function swordPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	className: string?
): BasePart
	local part = Instance.new(className or "Part") :: BasePart
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Massless = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

type BladeMarks = {
	guard: number, -- blade-local Y of the guard end
	tip: number, -- where effects treat as the business end
	point: number, -- the very point
}

-- Joins a sword built around its handle at the origin, marks out its blade
-- for the clients' effects (see alongBlade in the client kit) and gives it a
-- swing trail. Every sword has a "Handle" (gripped) and a "Blade".
local function assemble(model: Model, handle: BasePart, parts: { BasePart }, marks: BladeMarks): Model
	-- Plain Welds with the offset written into C0, not WeldConstraints:
	-- a WeldConstraint works its offset out from where the parts happen to
	-- be when it switches on, which differs between the server (builds the
	-- sword) and the client (simulates the character), so pieces ended up
	-- floating off or falling. C0 replicates, so every machine agrees.
	for _, part in parts do
		local weld = Instance.new("Weld")
		weld.Name = "Join"
		weld.Part0 = handle
		weld.Part1 = part
		weld.C0 = part.CFrame -- built relative to the handle at the origin
		weld.Parent = part
		part.Parent = model
	end

	local blade = model:FindFirstChild("Blade") :: Part
	blade:SetAttribute("GuardY", marks.guard)
	blade:SetAttribute("TipY", marks.tip)
	blade:SetAttribute("PointY", marks.point)
	-- Swing trail between the blade's base and tip. Clients switch it on during attacks.
	local base = Instance.new("Attachment")
	base.Name = "TrailBase"
	base.Position = Vector3.new(0, marks.guard + 0.23, 0)
	base.Parent = blade
	local tip = Instance.new("Attachment")
	tip.Name = "TrailTip"
	tip.Position = Vector3.new(0, marks.tip - 0.46, 0)
	tip.Parent = blade
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = base
	trail.Attachment1 = tip
	-- Subtle: just enough to read the blade's path.
	trail.Color = ColorSequence.new(Color3.fromRGB(30, 30, 34), Color3.fromRGB(90, 90, 100))
	trail.Transparency = NumberSequence.new(0.55, 1)
	trail.LightEmission = 0
	trail.LightInfluence = 0
	trail.Lifetime = 0.12
	trail.MinLength = 0
	trail.Enabled = false
	trail.Parent = blade
	return model
end

-- The Demon-Slayer Sword, as in the series: a huge, broad black greatsword
-- (about as tall as Asta), battered and stained, with a pointed tip, a faint
-- ridge down the middle and worn edges; a thin bronze crossbar and a long
-- two-handed grip ending in a round pommel. The blade runs along the
-- handle's +Y axis; built around the handle at the origin, then welded.
-- (Only the look: hitboxes don't depend on it. The animation checker in
-- tools/anim/rig.py models the blade from 0.86 to the tip, keep in step.)
local function buildSlayer(): Model
	local model = Instance.new("Model")
	model.Name = "KitWeapon"

	local black = Color3.fromRGB(22, 22, 26)
	local ridge = Color3.fromRGB(44, 44, 52)
	local worn = Color3.fromRGB(64, 64, 72)
	local stain = Color3.fromRGB(46, 48, 56)
	local nick = Color3.fromRGB(14, 14, 16)
	local bronze = Color3.fromRGB(92, 70, 42)
	local darkBronze = Color3.fromRGB(52, 40, 28)
	local wrap = Color3.fromRGB(60, 44, 30)
	local band = Color3.fromRGB(34, 26, 20)
	local metal, cloth = Enum.Material.Metal, Enum.Material.Fabric

	local handle = swordPart("Handle", Vector3.new(0.28, 0.95, 0.28), CFrame.new(), wrap, cloth)
	handle.Parent = model
	model.PrimaryPart = handle

	local function flat(name: string, size: Vector3, y: number, z: number, tilt: number): BasePart
		-- A patch lying on both flats of the blade, turned `tilt` degrees.
		return swordPart(
			name,
			size,
			CFrame.new(0, y, z) * CFrame.Angles(math.rad(tilt), 0, 0),
			stain,
			Enum.Material.Slate
		)
	end

	local pommel = swordPart("Pommel", Vector3.new(0.32, 0.32, 0.32), CFrame.new(0, -0.92, 0), bronze, metal) :: Part
	pommel.Shape = Enum.PartType.Ball

	local parts = {
		-- Long two-handed grip, wrapped, with a round pommel.
		swordPart("GripLower", Vector3.new(0.26, 0.4, 0.26), CFrame.new(0, -0.67, 0), wrap, cloth),
		swordPart("WrapA", Vector3.new(0.3, 0.05, 0.3), CFrame.new(0, -0.76, 0), band, cloth),
		swordPart("WrapB", Vector3.new(0.3, 0.05, 0.3), CFrame.new(0, -0.5, 0), band, cloth),
		swordPart("WrapC", Vector3.new(0.32, 0.05, 0.32), CFrame.new(0, -0.15, 0), band, cloth),
		swordPart("WrapD", Vector3.new(0.32, 0.05, 0.32), CFrame.new(0, 0.2, 0), band, cloth),
		pommel,
		-- Thin crossbar, a little wider than the blade, capped at the ends.
		swordPart("Guard", Vector3.new(0.2, 0.15, 1.8), CFrame.new(0, 0.6, 0), bronze, metal),
		swordPart("GuardCapA", Vector3.new(0.24, 0.22, 0.12), CFrame.new(0, 0.6, 0.94), darkBronze, metal),
		swordPart("GuardCapB", Vector3.new(0.24, 0.22, 0.12), CFrame.new(0, 0.6, -0.94), darkBronze, metal),
		swordPart("Collar", Vector3.new(0.26, 0.2, 0.72), CFrame.new(0, 0.77, 0), darkBronze, metal),
		-- The blade: full width right up to the guard (from 0.86 to 4.6), then
		-- a triangular point: both edges run in to meet on the centre line at
		-- 5.8 (two mirrored wedges). The thin side faces forward so swings
		-- lead with an edge.
		swordPart("Blade", Vector3.new(0.2, 3.74, 1.4), CFrame.new(0, 2.73, 0), black, metal),
		swordPart("TipA", Vector3.new(0.2, 1.2, 0.7), CFrame.new(0, 5.2, -0.35), black, metal, "WedgePart"),
		swordPart(
			"TipB",
			Vector3.new(0.2, 1.2, 0.7),
			CFrame.new(0, 5.2, 0.35) * CFrame.Angles(0, math.pi, 0),
			black,
			metal,
			"WedgePart"
		),
		swordPart("Ridge", Vector3.new(0.22, 4.2, 0.12), CFrame.new(0, 3.1, 0), ridge, Enum.Material.SmoothPlastic),
		-- Worn edges down both sides, carried on up the point to its tip.
		swordPart("EdgeA", Vector3.new(0.14, 3.67, 0.08), CFrame.new(0, 2.765, -0.69), worn, metal),
		swordPart("EdgeB", Vector3.new(0.14, 3.67, 0.08), CFrame.new(0, 2.765, 0.69), worn, metal),
		swordPart(
			"PointEdgeA",
			Vector3.new(0.22, 0.1, 1.39),
			CFrame.new(0, 5.175, -0.307) * CFrame.Angles(math.rad(-59.74), 0, 0),
			worn,
			metal
		),
		swordPart(
			"PointEdgeB",
			Vector3.new(0.22, 0.1, 1.39),
			CFrame.new(0, 5.175, 0.307) * CFrame.Angles(math.rad(59.74), 0, 0),
			worn,
			metal
		),
		-- Stains and scars across the flats.
		flat("StainA", Vector3.new(0.215, 0.9, 0.45), 1.7, 0.25, 20),
		flat("StainB", Vector3.new(0.215, 0.6, 0.35), 2.6, -0.3, -15),
		flat("StainC", Vector3.new(0.215, 1.1, 0.4), 3.6, 0.2, 10),
		flat("StainD", Vector3.new(0.215, 0.5, 0.3), 4.1, 0.25, 30),
		-- Nicks along the edges.
		swordPart("NickA", Vector3.new(0.16, 0.22, 0.1), CFrame.new(0, 1.9, -0.66), nick, metal),
		swordPart("NickB", Vector3.new(0.16, 0.16, 0.1), CFrame.new(0, 3.2, 0.66), nick, metal),
		swordPart("NickC", Vector3.new(0.16, 0.26, 0.1), CFrame.new(0, 3.9, -0.66), nick, metal),
		swordPart("NickD", Vector3.new(0.16, 0.18, 0.1), CFrame.new(0, 2.5, 0.66), nick, metal),
	}
	return assemble(model, handle, parts, { guard = -1.87, tip = 2.62, point = 3.07 })
end

local function ball(part: BasePart): BasePart
	(part :: Part).Shape = Enum.PartType.Ball
	return part
end

-- Where a point given in the handle's space sits along the blade (its local
-- Y), for curved blades whose point isn't on the first piece's axis.
local function alongBlade(blade: BasePart, point: Vector3): number
	return blade.CFrame:PointToObjectSpace(point).Y
end

-- The Demon-Dweller Sword: a straight, narrow pointed blade, dirt-stained,
-- black markings down the flat (they light up with whatever magic it has
-- taken in), an ornate four-sided guard, a spiral-wrapped grip and a round
-- pommel. About 4.2 studs.
local function buildDweller(): Model
	local model = Instance.new("Model")
	model.Name = "KitWeapon"
	local steel = Color3.fromRGB(50, 50, 55)
	local hilt = Color3.fromRGB(65, 62, 58)
	local dirt = Color3.fromRGB(100, 85, 65)
	local mark = Color3.fromRGB(10, 10, 10)
	local metal = Enum.Material.Metal

	local handle = swordPart("Handle", Vector3.new(0.24, 0.95, 0.24), CFrame.new(), hilt, metal)
	handle.Parent = model
	model.PrimaryPart = handle
	local parts = {
		ball(swordPart("Pommel", Vector3.one * 0.32, CFrame.new(0, -0.62, 0), hilt, metal)),
		-- The four-sided guard: two crossed bars (a + seen from the point),
		-- each end knobbed.
		swordPart("Guard", Vector3.new(0.16, 0.14, 0.9), CFrame.new(0, 0.55, 0), hilt, metal),
		swordPart("GuardCross", Vector3.new(0.52, 0.14, 0.16), CFrame.new(0, 0.55, 0), hilt, metal),
		-- The blade (0.62 to 3.52) and its point (to 3.97).
		swordPart("Blade", Vector3.new(0.12, 2.9, 0.38), CFrame.new(0, 2.07, 0), steel, metal),
		swordPart("TipA", Vector3.new(0.12, 0.45, 0.19), CFrame.new(0, 3.745, -0.095), steel, metal, "WedgePart"),
		swordPart(
			"TipB",
			Vector3.new(0.12, 0.45, 0.19),
			CFrame.new(0, 3.745, 0.095) * CFrame.Angles(0, math.pi, 0),
			steel,
			metal,
			"WedgePart"
		),
		-- The markings (neon, black until it absorbs something).
		swordPart("Mark0", Vector3.new(0.13, 2.3, 0.04), CFrame.new(0, 2.0, 0), mark, Enum.Material.Neon),
		swordPart("DirtA", Vector3.new(0.125, 0.5, 0.16), CFrame.new(0, 1.5, 0.09), dirt, Enum.Material.Slate),
		swordPart("DirtB", Vector3.new(0.125, 0.4, 0.14), CFrame.new(0, 2.9, -0.1), dirt, Enum.Material.Slate),
	}
	for i, offset in
		{ Vector3.new(0, 0, 0.47), Vector3.new(0, 0, -0.47), Vector3.new(0.28, 0, 0), Vector3.new(-0.28, 0, 0) }
	do
		table.insert(
			parts,
			ball(
				swordPart(
					"GuardKnob" .. i,
					Vector3.one * 0.16,
					CFrame.new(Vector3.new(0, 0.55, 0) + offset),
					hilt,
					metal
				)
			)
		)
	end
	for i, y in { -0.36, -0.12, 0.12, 0.36 } do
		-- The spiral grip: wrap rings tipped one way, then the other.
		local tilt = math.rad(if i % 2 == 0 then 14 else -14)
		table.insert(
			parts,
			swordPart(
				"Spiral" .. i,
				Vector3.new(0.3, 0.05, 0.3),
				CFrame.new(0, y, 0) * CFrame.Angles(tilt, 0, 0),
				Color3.fromRGB(40, 38, 36),
				metal
			)
		)
	end
	for i, y in { 1.2, 1.85, 2.5, 3.1 } do
		table.insert(
			parts,
			swordPart(
				"Mark" .. i,
				Vector3.one * 0.13,
				CFrame.new(0, y, 0) * CFrame.Angles(math.rad(45), 0, 0),
				mark,
				Enum.Material.Neon
			)
		)
	end
	return assemble(model, handle, parts, { guard = -1.45, tip = 1.68, point = 1.9 })
end

-- The Demon-Destroyer Sword: a single-edged blade that curves back and
-- widens into a broad head with a white clover on its spine end; a short
-- bar guard with a round plate that glows (Asta and Liebe united, as in
-- Black Form). About 4 studs.
local function buildDestroyer(): Model
	local model = Instance.new("Model")
	model.Name = "KitWeapon"
	local black = Color3.fromRGB(22, 22, 25)
	local edge = Color3.fromRGB(72, 72, 80)
	local metal = Enum.Material.Metal

	local handle = swordPart(
		"Handle",
		Vector3.new(0.26, 0.9, 0.26),
		CFrame.new(),
		Color3.fromRGB(45, 36, 30),
		Enum.Material.Fabric
	)
	handle.Parent = model
	model.PrimaryPart = handle
	local plate = swordPart(
		"GuardPlate",
		Vector3.new(0.12, 0.5, 0.5),
		CFrame.new(0, 0.55, 0),
		Color3.fromRGB(120, 15, 25),
		Enum.Material.Neon
	);
	(plate :: Part).Shape = Enum.PartType.Cylinder -- along X: the disc faces the flats
	local parts = {
		swordPart("Pommel", Vector3.new(0.3, 0.2, 0.3), CFrame.new(0, -0.55, 0), black, metal),
		swordPart("Guard", Vector3.new(0.18, 0.16, 0.85), CFrame.new(0, 0.55, 0), black, metal),
		plate,
	}
	-- Four pieces, each turned a little further back and a little wider,
	-- the edge (front, -Z) running along their front faces.
	local at = CFrame.new(0, 0.63, 0)
	local blade: BasePart? = nil
	for i, width in { 0.34, 0.42, 0.52, 0.62 } do
		local piece = swordPart(
			if i == 1 then "Blade" else "Blade" .. i,
			Vector3.new(0.14, 0.68, width),
			at * CFrame.new(0, 0.33, width / 2 - 0.17),
			black,
			metal
		)
		blade = blade or piece
		table.insert(parts, piece)
		table.insert(
			parts,
			swordPart("Edge" .. i, Vector3.new(0.1, 0.68, 0.06), at * CFrame.new(0, 0.33, -0.16), edge, metal)
		)
		at = at * CFrame.new(0, 0.66, 0) * CFrame.Angles(math.rad(5), 0, 0)
	end
	-- The broad head, its point at the edge side.
	local head = at * CFrame.new(0, 0.3, 0.18)
	table.insert(parts, swordPart("Head", Vector3.new(0.14, 0.6, 0.7), head, black, metal))
	table.insert(parts, swordPart("HeadEdge", Vector3.new(0.1, 0.6, 0.06), head * CFrame.new(0, 0, -0.34), edge, metal))
	local tipFrame = head * CFrame.new(0, 0.55, 0) * CFrame.Angles(0, math.pi, 0)
	table.insert(parts, swordPart("HeadTip", Vector3.new(0.14, 0.5, 0.7), tipFrame, black, metal, "WedgePart"))
	-- The clover, white on the spine end of the head.
	local clover = head * CFrame.new(0, 0.05, 0.2)
	for i, leaf in
		{ Vector3.new(0, 0.09, 0), Vector3.new(0, -0.09, 0), Vector3.new(0, 0, 0.09), Vector3.new(0, 0, -0.09) }
	do
		table.insert(
			parts,
			ball(
				swordPart(
					"Clover" .. i,
					Vector3.one * 0.16,
					clover * CFrame.new(leaf),
					Color3.fromRGB(230, 230, 230),
					Enum.Material.SmoothPlastic
				)
			)
		)
	end
	local bladePart = blade :: BasePart
	local point = (head * CFrame.new(0, 0.8, -0.35)).Position
	local pointY = alongBlade(bladePart, point)
	return assemble(model, handle, parts, {
		guard = alongBlade(bladePart, Vector3.new(0, 0.63, 0)),
		tip = pointY - 0.2,
		point = pointY,
	})
end

-- The Demon-Slasher Katana: Yami's katana, blackened by anti-magic. A slim,
-- gently curved single-edged blade with a pale edge line, a round guard, a
-- brass collar and a black-wrapped grip with pale diamonds. About 3.4 studs.
local function buildSlasher(): Model
	local model = Instance.new("Model")
	model.Name = "KitWeapon"
	local steel = Color3.fromRGB(15, 15, 17)
	local edge = Color3.fromRGB(90, 90, 96)
	local fitting = Color3.fromRGB(55, 52, 48)
	local metal = Enum.Material.Metal

	local handle =
		swordPart("Handle", Vector3.new(0.2, 0.9, 0.22), CFrame.new(), Color3.fromRGB(28, 28, 32), Enum.Material.Fabric)
	handle.Parent = model
	model.PrimaryPart = handle
	local tsuba = swordPart(
		"Tsuba",
		Vector3.new(0.06, 0.52, 0.52),
		CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		fitting,
		metal
	);
	(tsuba :: Part).Shape = Enum.PartType.Cylinder -- turned to lie across the blade
	local parts = {
		swordPart("Kashira", Vector3.new(0.22, 0.08, 0.24), CFrame.new(0, -0.49, 0), fitting, metal),
		tsuba,
		swordPart("Habaki", Vector3.new(0.12, 0.12, 0.2), CFrame.new(0, 0.58, 0), Color3.fromRGB(150, 120, 60), metal),
	}
	for i, y in { -0.3, -0.05, 0.2 } do
		table.insert(
			parts,
			swordPart(
				"Diamond" .. i,
				Vector3.new(0.21, 0.11, 0.11),
				CFrame.new(0, y, 0) * CFrame.Angles(math.rad(45), 0, 0),
				Color3.fromRGB(140, 140, 145),
				Enum.Material.Fabric
			)
		)
	end
	-- Four pieces, each turned a touch further back (the curve), the pale
	-- edge line along their front.
	local at = CFrame.new(0, 0.64, 0)
	local blade: BasePart? = nil
	for i = 1, 4 do
		local piece = swordPart(
			if i == 1 then "Blade" else "Blade" .. i,
			Vector3.new(0.09, 0.62, 0.19),
			at * CFrame.new(0, 0.31, 0),
			steel,
			metal
		)
		blade = blade or piece
		table.insert(parts, piece)
		table.insert(
			parts,
			swordPart("Hamon" .. i, Vector3.new(0.095, 0.62, 0.04), at * CFrame.new(0, 0.31, -0.08), edge, metal)
		)
		at = at * CFrame.new(0, 0.62, 0) * CFrame.Angles(math.rad(3), 0, 0)
	end
	-- The point sweeps up from the edge to the spine side.
	table.insert(
		parts,
		swordPart("Kissaki", Vector3.new(0.09, 0.3, 0.19), at * CFrame.new(0, 0.15, 0), steel, metal, "WedgePart")
	)
	local bladePart = blade :: BasePart
	local pointY = alongBlade(bladePart, (at * CFrame.new(0, 0.3, 0.09)).Position)
	return assemble(model, handle, parts, {
		guard = alongBlade(bladePart, Vector3.new(0, 0.64, 0)),
		tip = pointY - 0.15,
		point = pointY,
	})
end

-- Asta's swords (Black Form's R swaps between them at random).
local SWORDS: { [string]: () -> Model } = {
	Slayer = buildSlayer,
	Dweller = buildDweller,
	Destroyer = buildDestroyer,
	Slasher = buildSlasher,
}

-- Puts a built sword in his right hand. A Motor6D rather than a Weld so
-- clients can animate it like a wrist (resting it on the shoulder, angling
-- it through swings); the blade sits 35 degrees forward of the arm.
local function wield(character: Model, sword: Model)
	local handle = sword.PrimaryPart :: BasePart
	local weld = Instance.new("Motor6D")
	weld.Name = "SwordGrip"
	weld.Part1 = handle
	weld.Parent = handle

	local function currentArm(): BasePart?
		local arm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand")
		return if arm and arm:IsA("BasePart") then arm else nil
	end

	local function attach()
		local arm = currentArm()
		if not arm then
			return
		end
		local grip = CFrame.new(0, -arm.Size.Y / 2, 0) * CFrame.Angles(math.rad(215), 0, 0)
		-- Place the whole sword at the hand first, then join it.
		for _, part in sword:GetChildren() do
			if part:IsA("BasePart") then
				local join = part:FindFirstChild("Join") :: Weld?
				part.CFrame = arm.CFrame * grip * (if join then join.C0 else CFrame.identity)
			end
		end
		weld.Part0 = arm
		weld.C0 = grip
	end
	attach()
	sword.Parent = character

	-- Watchdog: if the arm gets rebuilt (avatar changes) or the grip breaks,
	-- re-grip instead of leaving the sword on the floor. Stops when this
	-- sword is put away (or swapped for another).
	task.spawn(function()
		local warned = false
		while sword.Parent == character and character.Parent do
			local arm = currentArm()
			if arm and (weld.Part0 ~= arm or not weld.Parent) then
				attach()
			elseif arm and (handle.Position - arm.Position).Magnitude > 6 then
				if not warned then
					warned = true
					warn("[AntiMagic] Sword drifted away from the hand, re-gripping.", character.Name)
				end
				attach()
			end
			task.wait(0.5)
		end
	end)
end

-- Swaps the sword in his hand for another of his swords (see SWORDS). The
-- "Sword" attribute says which he's holding; moves 1 and 2 in Black Form
-- follow it.
local function setSword(character: Model, kind: string)
	local build = SWORDS[kind]
	if not build then
		return
	end
	local old = character:FindFirstChild("KitWeapon")
	if old then
		old:Destroy()
	end
	character:SetAttribute("Sword", kind)
	wield(character, build())
end

function Kit.Equip(character: Model)
	character:WaitForChild("Right Arm", 5)
	setSword(character, "Slayer")
end

function Kit.Unequip(character: Model)
	local sword = character:FindFirstChild("KitWeapon")
	if sword then
		sword:Destroy()
	end
	character:SetAttribute("Sword", nil)
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

local function fx(ctx, skill: string, phase: string, extra: { [string]: any }?)
	local data: { [string]: any } = { character = ctx.character, kit = KIT_ID, skill = skill, phase = phase }
	if extra then
		for key, value in extra do
			data[key] = value
		end
	end
	ctx.combat.FireVFX("Skill", data)
end

local function look(ctx): Vector3
	return ctx.combat.Flat(ctx.root.CFrame.LookVector)
end

-- Interrupted by getting hit, ragdolled or dying.
local function interrupted(ctx): boolean
	local character = ctx.character
	return not CombatState.IsAlive(character) or CombatState.IsStunned(character) or CombatState.IsRagdolled(character)
end

-- How long the server (a ping behind) gets to see a dive leave the ground.
-- If it never does (a dive from a tiny hop), being on the ground after
-- this counts as having landed.
local TAKEOFF_GRACE = 0.25

-- Charges forward for `duration`, returning the first character caught.
-- With `steer` (degrees per second) the player can curve it as it goes; the
-- hitbox follows their root, so it catches whatever they curve into.
-- A downward lunge (an air version) skids along the ground once it lands
-- instead of pushing into it (the player's client handles that: landStop).
-- With `untilLanded` it stops dead where it lands instead, and ends right
-- there; the second result says it landed.
local function lunge(
	ctx,
	velocity: Vector3,
	duration: number,
	reach: Vector3,
	steer: number?,
	untilLanded: boolean?
): (Model?, boolean)
	local options = if steer or velocity.Y < 0
		then { steer = steer, landStop = velocity.Y < 0, landKeep = if untilLanded then 0 else 0.7 }
		else nil
	ctx.combat.ApplyVelocity(ctx.character, velocity, duration, options)
	local start = os.clock()
	local seenAir = false
	while os.clock() - start < duration + 0.05 do
		if interrupted(ctx) then
			return nil, false
		end
		local hits = ctx.combat.Box(ctx.character, ctx.root.CFrame * CFrame.new(0, 0, -reach.Z / 2), reach)
		if #hits > 0 then
			ctx.combat.ApplyVelocity(ctx.character, Vector3.zero, 0.05)
			return hits[1], false
		end
		if untilLanded then
			local up = ctx.combat.IsAirborne(ctx.character)
			seenAir = seenAir or up
			if not up and (seenAir or os.clock() - start > TAKEOFF_GRACE) then
				return nil, true
			end
		end
		task.wait()
	end
	return nil, false
end

-- The server sees a player's own movement about a ping late: wait (with a
-- limit) until it has seen them leave the ground before treating "not
-- airborne" as having landed.
local function waitForTakeoff(ctx, timeout: number)
	local start = os.clock()
	while not ctx.combat.IsAirborne(ctx.character) and os.clock() - start < timeout do
		if interrupted(ctx) then
			return
		end
		task.wait()
	end
end

local function waitForGround(ctx, timeout: number)
	local start = os.clock()
	repeat
		task.wait()
	until not ctx.combat.IsAirborne(ctx.character) or os.clock() - start > timeout
end

local function groundBelow(ctx): Vector3
	return ctx.root.Position - Vector3.new(0, 3, 0)
end

-- Anti-magic slash wave. Used by Black Slash, Grand Divider and Deflect.
local function blackSlash(
	ctx,
	origin: Vector3,
	direction: Vector3,
	options: {
		damage: number,
		size: Vector3?,
		speed: number?,
		range: number?,
		grand: boolean?,
		skip: { [Model]: boolean }?,
	}
)
	local speed = options.speed or 130
	local range = options.range or 90
	local size = options.size or Vector3.new(9, 4, 2)
	fx(ctx, "BlackSlash", "Projectile", {
		origin = origin,
		direction = direction,
		speed = speed,
		range = range,
		width = size.X,
		grand = options.grand == true,
	})
	Projectile.Fire({
		owner = ctx.character,
		origin = origin,
		direction = direction,
		speed = speed,
		range = range,
		size = size,
		pierce = true,
		onHit = function(victim)
			if options.skip and options.skip[victim] then
				return
			end
			ctx.combat.Hit(ctx.character, victim, {
				damage = options.damage,
				stun = 0.9,
				attackType = "Bolt",
				heavy = true,
				guardBreak = options.grand == true,
				velocity = direction * 38 + UP * 14,
				velocityTime = 0.2,
				ragdoll = if options.grand then 1.4 else nil,
			})
		end,
	})
end

---------------------------------------------------------------------------
-- Base moves
---------------------------------------------------------------------------

-- Bull Thrust: propels himself forward on a burst of anti-magic, catches
-- the first person in the way and cuts them up in a five-hit combo, the
-- last a thrust that leaves them stunned in range so he can M1 straight
-- into a string (a combo starter, like Vessel's Cursed Strikes).
local PROPEL_SPEED = 85
local PROPEL_TIME = 0.55 -- the Propel animation holds for this long
local PROPEL_STEER = 200 -- degrees per second: up to a ~110 degree curve

-- The combo. Each hit lands on its strike key in the BullCombo animation
-- (COMBO_STRIKES in tools/anim/asta_anims.py), so keep `at` in step with
-- it. Until the next hit they're held `reach` studs in front of him while
-- he steps on at `drift` studs per second.
local COMBO = {
	{ kind = "Rising", at = 0.14, damage = 1.5, reach = 3.8, drift = 5 },
	{ kind = "Sweep", at = 0.3, damage = 1.5, reach = 3.8, drift = 3 },
	{ kind = "Spin", at = 0.54, damage = 1.5, reach = 3.8, drift = 3 },
	-- Knocked back a step, clear of the point while he coils for the thrust.
	{ kind = "Chop", at = 0.76, damage = 2, reach = 4.6, drift = 0 },
	-- The finisher: nothing holds them after it (see THRUST_PUSH).
	{ kind = "Thrust", at = 1.1, damage = 3, reach = 0, drift = 0 },
}
-- The thrust drives them back about 2.5 studs, still stunned: an M1 still
-- reaches them.
local THRUST_PUSH = 17
local MAX_PULL = 30 -- fastest (studs per second) they're eased back in front of him

-- The air version, when the dive catches no one: he drives the sword into
-- the ground where he lands and the blast breaks guards all around him.
local SLAM_RADIUS = 11
local SLAM_DAMAGE = 6
local SLAM_RECOVERY = 0.45 -- the PlungeImpact stab he lands in
-- Still falling when the propel runs out (dove from high up): how long he
-- has to reach the ground for the slam to happen.
local LAND_WINDOW = 0.5

-- How fast to move someone so that `time` from now they're `reach` studs in
-- front of him, while he steps on at `drift`. Flat, so gravity still works.
local function holdInFront(ctx, target: Model, forward: Vector3, reach: number, drift: number, time: number): Vector3
	local velocity = forward * drift
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if targetRoot then
		local offset = ctx.root.Position + forward * reach - targetRoot.Position
		local pull = Vector3.new(offset.X, 0, offset.Z) / time
		if pull.Magnitude > MAX_PULL then
			pull = pull.Unit * MAX_PULL
		end
		velocity += pull
	end
	return velocity
end

-- True once he's on the ground, within `timeout`.
local function landsWithin(ctx, timeout: number): boolean
	local start = os.clock()
	while os.clock() - start < timeout do
		if interrupted(ctx) then
			return false
		end
		if not ctx.combat.IsAirborne(ctx.character) then
			return true
		end
		task.wait()
	end
	return false
end

-- The air version's landing: the sword goes into the ground and anti-magic
-- blows a crater out around him, throwing everyone in it up and away.
local function bullSlam(ctx)
	local c, character = ctx.combat, ctx.character
	local forward = look(ctx)
	c.ApplyVelocity(character, Vector3.zero, 0.05)
	-- Where the blade bites, just in front of his feet.
	local impact = groundBelow(ctx) + forward * 1.5
	local victims = c.Sphere(character, impact + UP * 2, SLAM_RADIUS)
	fx(ctx, "BullThrust", "Land", { position = impact, targets = victims })
	c.ShakeArea(impact, 45, 0.55)
	for _, victim in victims do
		local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		if victimRoot then
			local away = victimRoot.Position - impact
			local out = if Vector3.new(away.X, 0, away.Z).Magnitude > 0.5 then c.Flat(away) else forward
			c.Hit(character, victim, {
				damage = SLAM_DAMAGE,
				stun = 1,
				attackType = "Melee",
				guardBreak = true,
				heavy = true,
				ragdoll = 1,
				velocity = out * 40 + UP * 38,
			})
		end
	end
	CombatState.SetCasting(character, SLAM_RECOVERY)
end

local function bullThrust(ctx)
	local c, character = ctx.combat, ctx.character
	local forward = look(ctx)
	local airborne = ctx.airborne
	local direction = if airborne then (forward + UP * -0.6).Unit else forward

	CombatState.SetCasting(character, PROPEL_TIME + 0.25)
	fx(ctx, "BullThrust", "Propel", { airborne = airborne, direction = direction, duration = PROPEL_TIME })
	-- The air version ends the moment it lands (the slam replaces the skid).
	local target, landed =
		lunge(ctx, direction * PROPEL_SPEED, PROPEL_TIME, Vector3.new(6, 6, 7), PROPEL_STEER, airborne)
	if not target then
		-- Dove from high up: still falling when the propel runs out.
		if airborne and not landed and not interrupted(ctx) then
			CombatState.SetCasting(character, LAND_WINDOW + 0.1)
			landed = landsWithin(ctx, LAND_WINDOW)
		end
		if landed and not interrupted(ctx) then
			bullSlam(ctx)
			return
		end
		fx(ctx, "BullThrust", "Whiff")
		-- Whiffing it leaves him open.
		CombatState.SetCasting(character, 0.45)
		return
	end

	-- Wherever they curved to is forward now.
	forward = look(ctx)
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	local contact = if targetRoot then targetRoot.Position else ctx.root.Position + forward * 3
	if c.Hit(character, target, { damage = 2, stun = 1.6, attackType = "Melee" }) ~= "Hit" then
		CombatState.SetCasting(character, 0.4)
		return
	end
	fx(ctx, "BullThrust", "Catch", { target = target, position = contact })

	-- The combo: five hits, each on its own swing, with them held in front
	-- of him the whole way.
	CombatState.SetCasting(character, COMBO[#COMBO].at + 0.2)
	fx(ctx, "BullThrust", "Combo", { target = target })
	local first = COMBO[1]
	c.ApplyVelocity(target, holdInFront(ctx, target, forward, first.reach, 0, first.at), first.at)
	c.ApplyVelocity(character, Vector3.zero, first.at)
	local start = os.clock()
	for index, cut in COMBO do
		-- Timed from the start so the waits don't add up and fall behind the animation.
		local remaining = cut.at - (os.clock() - start)
		if remaining > 0 then
			task.wait(remaining)
		end
		if interrupted(ctx) or not CombatState.IsAlive(target) then
			fx(ctx, "BullThrust", "Interrupted")
			CombatState.SetCasting(character, 0.3)
			return
		end
		local nextCut = COMBO[index + 1]
		local hit: { [string]: any } = { damage = cut.damage, stun = 1, attackType = "Melee" }
		if nextCut then
			hit.velocity = holdInFront(ctx, target, forward, cut.reach, cut.drift, nextCut.at - cut.at)
			hit.velocityTime = nextCut.at - cut.at
		else
			-- The thrust: drives them back, still stunned, so an M1 string
			-- connects right after.
			hit.stun = 1.1
			hit.heavy = true
			hit.velocity = forward * THRUST_PUSH + UP * 4
			hit.velocityTime = 0.15
		end
		if c.Hit(character, target, hit) ~= "Hit" then
			-- They broke out (Evasive) or can't be hit any more.
			fx(ctx, "BullThrust", "Interrupted")
			CombatState.SetCasting(character, 0.3)
			return
		end
		fx(ctx, "BullThrust", "Strike", { target = target, index = index, kind = cut.kind })
		if nextCut then
			c.ApplyVelocity(character, forward * cut.drift, nextCut.at - cut.at)
		end
	end
	CombatState.ClearCasting(character)
	-- Start a fresh M1 string.
	ctx.data.combo = 0
	ctx.data.nextM1 = 0
end

-- Where his free (left) hand holds a grabbed victim, in root space and
-- facing him, roughly matching the animations (tools/anim). This is what
-- the server's hitboxes see; every client pins them to the actual hand.
local FACING = CFrame.Angles(0, math.pi, 0)
local HOLD_SEIZE = CFrame.new(-1.6, 0.35, -1.75) * FACING
-- Kept level with him server-side so they never end up under the floor on
-- landing; clients show them driven down in front of him.
-- In the head-first dive: out in front of his face, upside down like him.
local HOLD_DRILL = CFrame.new(-0.6, 0.6, -2.4) * FACING
-- Held out at arm's length while he spins them round.
local HOLD_SPIN = CFrame.new(-1.7, 0.5, -2.3) * FACING

-- Seizes `target` by the throat with his free hand. Grabs can't be
-- blocked, but counters and i-frames still beat them, and leave him open
-- for a moment. Returns release() and hold() when it lands.
local function seize(ctx, target: Model, grabTime: number): ((() -> ())?, ((CFrame) -> ())?)
	local c, character = ctx.combat, ctx.character
	if c.Hit(character, target, { damage = 1, stun = 2, attackType = "Melee", unblockable = true }) ~= "Hit" then
		CombatState.SetCasting(character, 0.5)
		return nil, nil
	end
	CombatState.SetCasting(character, grabTime + 0.2)
	CombatState.GiveIFrames(character, grabTime)
	return c.Grab(character, target, HOLD_SEIZE, grabTime, "Left Arm")
end

-- The grab (Black Meteorite and Black Moon): no dash. He plants (in the air he hangs there)
-- and his free hand shoots out. At full stretch it seizes whoever is right
-- in front of him, for a moment. The startup is the MeteorReach
-- animation's thrust (REACH_AT in tools/anim/asta_anims.py): keep them in
-- step.
local REACH_STARTUP = 0.16
local REACH_WINDOW = 0.1 -- the hand stays open this long (slack for ping)
-- Reaches 5.5 studs out in front of him: catches someone about 6 studs away.
local REACH_BOX = Vector3.new(5, 7, 5)
local REACH_STEP = 6 -- studs per second: the half-step he takes into it
local REACH_WHIFF = 0.55 -- left open after grabbing at nothing

-- The closest person in reach who can be grabbed (not on the floor, not
-- untouchable).
local function inReach(ctx): Model?
	local c, character = ctx.combat, ctx.character
	local box = ctx.root.CFrame * CFrame.new(0, if ctx.airborne then -0.5 else 0, -(0.5 + REACH_BOX.Z / 2))
	local closest: Model? = nil
	local closestDistance = math.huge
	for _, victim in c.Box(character, box, REACH_BOX) do
		local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		if victimRoot and not CombatState.HasIFrames(victim) and not CombatState.IsRagdolled(victim) then
			local distance = (victimRoot.Position - ctx.root.Position).Magnitude
			if distance < closestDistance then
				closest, closestDistance = victim, distance
			end
		end
	end
	return closest
end

local function reachGrab(ctx, grabTime: number, skill: string?): (Model?, (() -> ())?, ((CFrame) -> ())?)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, REACH_STARTUP + REACH_WINDOW + 0.1)
	local name = skill or "BlackMeteorite"
	fx(ctx, name, "Reach", { airborne = airborne })
	if airborne then
		c.ApplyVelocity(character, HOVER, REACH_STARTUP + REACH_WINDOW)
	else
		c.ApplyVelocity(character, look(ctx) * REACH_STEP, REACH_STARTUP)
	end
	task.wait(REACH_STARTUP)
	if interrupted(ctx) then
		fx(ctx, name, "Cancel")
		return nil, nil, nil
	end
	if not airborne then
		-- Planted while the hand is out.
		c.ApplyVelocity(character, Vector3.zero, REACH_WINDOW)
	end

	local start = os.clock()
	local target = inReach(ctx)
	while not target and os.clock() - start < REACH_WINDOW do
		task.wait()
		if interrupted(ctx) then
			fx(ctx, name, "Cancel")
			return nil, nil, nil
		end
		target = inReach(ctx)
	end
	if not target then
		-- The hand closes on nothing and he's left open.
		fx(ctx, name, "Whiff", { airborne = airborne })
		CombatState.SetCasting(character, REACH_WHIFF)
		return nil, nil, nil
	end
	local release, hold = seize(ctx, target, grabTime)
	if not release then
		return nil, nil, nil
	end
	return target, release, hold
end

-- The grab. His free hand shoots out (no dash), seizes them by the throat
-- and hoists them up while anti-magic surges through them. Then a vortex:
-- he whirls round with them held out, bobbing up and down as it carries
-- them into the sky (Shared/MeteorVortex), and slams them down like a
-- meteor. In the air: hangs there, seizes whoever is in front of him and
-- does the same from where he is, with a shorter climb.
local SEIZE_TIME = 0.4 -- the Seize animation's hoist
local SURGE_AT = 0.2

local function blackMeteorite(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	-- (The grab lasts the whole move: spin, flip, the longest dive, landing.)
	local target, release, hold = reachGrab(ctx, (if airborne then 0.3 else SEIZE_TIME) + MeteorVortex.Length + 1.8)
	if not target or not release or not hold then
		return
	end
	local forward = look(ctx)

	-- The seize: he plants and hoists them up. In the air he rises a little
	-- with them, so the spike has somewhere to fall from.
	fx(ctx, "BlackMeteorite", "Seize", { target = target, airborne = airborne })
	local seize = if airborne then 0.3 else SEIZE_TIME
	c.ApplyVelocity(character, if airborne then UP * 10 else Vector3.zero, seize)
	task.wait(SURGE_AT)
	if interrupted(ctx) then
		release()
		return
	end
	c.Hit(character, target, { damage = 2, stun = 1.5, attackType = "Melee", unblockable = true, noShake = true })
	task.wait(seize - SURGE_AT)
	if interrupted(ctx) then
		release()
		return
	end

	-- The vortex, the head-first dive and the landing: he's held on the
	-- shared path (Shared/MeteorVortex) the whole way; every client draws
	-- the same.
	hold(HOLD_SPIN)
	local origin = CFrame.lookAt(ctx.root.Position, ctx.root.Position + forward)
	local top = if airborne then MeteorVortex.AirTop else MeteorVortex.Top
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, target }
	local floor = workspace:Raycast(origin.Position + UP * 2, UP * -250, params)
	local floorY = if floor then floor.Position.Y else nil
	local plan = MeteorVortex.Plan(origin, top, floorY)
	CombatState.SetCasting(character, plan.length + 0.3)
	fx(ctx, "BlackMeteorite", "Vortex", {
		target = target,
		origin = origin,
		top = top,
		floorY = floorY,
		airborne = airborne,
	})
	local stop = c.Cutscene({
		[character] = function(t: number): CFrame
			return MeteorVortex.At(plan, t)
		end,
	}, plan.length)
	local start = os.clock()
	local function waitUntil(time: number): boolean
		while os.clock() - start < time do
			task.wait()
			if interrupted(ctx) or not CombatState.IsAlive(target) then
				stop()
				release()
				return false
			end
		end
		return true
	end

	-- The vortex tears at them as it spins: three small hits.
	for tick = 1, 3 do
		if not waitUntil(MeteorVortex.Length * tick / 3) then
			return
		end
		c.Hit(character, target, { damage = 1, stun = 1.5, attackType = "Melee", unblockable = true, noShake = true })
	end

	-- Over the top and down, head-first, spinning.
	hold(HOLD_DRILL)
	fx(ctx, "BlackMeteorite", "Slam", {
		target = target,
		airborne = airborne,
		dive = plan.impactAt - plan.flipAt,
	})
	if not waitUntil(plan.impactAt) then
		return
	end
	release()

	-- The client draws its own (much bigger) crater for this one.
	local impact = Vector3.new(plan.diveEnd.X, floorY or (plan.diveEnd.Y - 3), plan.diveEnd.Z)
	fx(ctx, "BlackMeteorite", "Impact", { position = impact, target = target, grounded = floorY ~= nil })
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	local away = if targetRoot then c.Flat(targetRoot.Position - ctx.root.Position) else Vector3.zero
	away = if away.Magnitude > 0.1 then away.Unit else forward
	c.Hit(character, target, {
		damage = if airborne then 4 else 6, -- plus the seize and the vortex's three
		stun = 1,
		attackType = "Melee",
		unblockable = true,
		heavy = true,
		noShake = true,
		ragdoll = 1.6,
		velocity = away * 25 + UP * 35,
	})
	-- He rolls back onto his feet (the rest of the path), then he's free.
	waitUntil(plan.length)
	CombatState.SetCasting(character, 0.2)
end

local DIVIDER_CHARGE = 0.62
local PERFECT_FROM, PERFECT_TO = 0.36, 0.66 -- generous for ping; client shows the flash at 0.38

-- In the air he hangs while it charges, then front-flips the blade down
-- onto whatever's below and in front, spiking them into the ground.
local function blackDivider(ctx)
	local c, character = ctx.combat, ctx.character
	local data = ctx.data
	local airborne = ctx.airborne
	CombatState.SetCasting(character, DIVIDER_CHARGE + 0.45)
	if airborne then
		c.ApplyVelocity(character, HOVER, DIVIDER_CHARGE + 0.05)
	end

	local start = os.clock()
	fx(ctx, "BlackDivider", "Charge", { flashAt = 0.38, airborne = airborne })

	-- Only the FIRST press after starting counts, so mashing doesn't work.
	local firstPress: number? = nil
	while os.clock() - start < DIVIDER_CHARGE do
		if interrupted(ctx) then
			fx(ctx, "BlackDivider", "Cancel")
			return
		end
		local pressed = data.skillInputs[3]
		if not firstPress and pressed and pressed > start then
			firstPress = pressed
		end
		task.wait()
	end
	local perfect = firstPress ~= nil and firstPress - start >= PERFECT_FROM and firstPress - start <= PERFECT_TO

	local forward = look(ctx)
	fx(ctx, "BlackDivider", "Release", { perfect = perfect, airborne = airborne })
	if airborne then
		-- Down onto whoever's below, all the way to the ground, and it hits
		-- people lying on the floor too (the ground version can't).
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		local floor = workspace:Raycast(ctx.root.Position, Vector3.new(0, -40, 0), params)
		local depth = if floor then ctx.root.Position.Y - floor.Position.Y + 1 else 8
		local height = math.clamp(depth + 3, 11, 40)
		local below = ctx.root.CFrame * CFrame.new(0, 3 - height / 2, -3)
		for _, victim in c.Box(character, below, Vector3.new(10, height, 10)) do
			c.Hit(character, victim, {
				damage = if perfect then 12 else 7,
				stun = if perfect then 1.2 else 1,
				attackType = "Melee", -- the air version can be blocked
				hitsDowned = true,
				heavy = true,
				ragdoll = if perfect then 1.6 else 1.3,
				velocity = forward * 18 + UP * -85,
				effect = if perfect then "PerfectDivider" else nil,
			})
		end
		-- The flip carries him up a touch before he drops.
		c.ApplyVelocity(character, UP * 22 + forward * 6, 0.12)
		c.ShakeArea(ctx.root.Position, if perfect then 60 else 25, if perfect then 0.8 else 0.35)
		CombatState.SetCasting(character, 0.35)
		return
	end
	local box = ctx.root.CFrame * CFrame.new(0, 0, -4.5)
	for _, victim in c.Box(character, box, Vector3.new(9, 7, 9)) do
		if perfect then
			c.Hit(character, victim, {
				damage = 17,
				stun = 1.2,
				attackType = "Melee",
				unblockable = true,
				heavy = true,
				ragdoll = 1.8,
				velocity = forward * 85 + UP * 25,
				effect = "PerfectDivider",
			})
		else
			c.Hit(character, victim, {
				damage = 11,
				stun = 1,
				attackType = "Melee",
				guardBreak = true,
				heavy = true,
				ragdoll = 1.4,
				velocity = forward * 60 + UP * 18,
			})
		end
	end
	c.ShakeArea(ctx.root.Position, if perfect then 60 else 25, if perfect then 0.8 else 0.35)
	CombatState.SetCasting(character, 0.35)
end

local DEFLECT_WINDOW = 0.65

local function antiMagicDeflect(ctx)
	local c, character = ctx.combat, ctx.character
	local countered = false
	CombatState.SetCasting(character, DEFLECT_WINDOW + 0.1)
	-- In the air he hangs there, guard up.
	local airborne = ctx.airborne
	if airborne then
		c.ApplyVelocity(character, HOVER, DEFLECT_WINDOW)
	end
	fx(ctx, "Deflect", "Stance", { airborne = airborne, window = DEFLECT_WINDOW })

	c.SetCounter(character, DEFLECT_WINDOW, ALL_TYPES, function(attacker: Model)
		countered = true
		CombatState.GiveIFrames(character, 0.7)
		CombatState.SetCasting(character, 0.45)
		local attackerRoot = attacker:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not attackerRoot then
			return
		end
		local offset = attackerRoot.Position - ctx.root.Position
		if offset.Magnitude <= 14 then
			-- Slash them aside, like Manji Kick.
			fx(ctx, "Deflect", "Counter", { target = attacker })
			c.Hit(character, attacker, {
				damage = 7,
				stun = 1.2,
				attackType = "Melee",
				unblockable = true,
				heavy = true,
				ragdoll = 1.4,
				velocity = ctx.root.CFrame.RightVector * 45 + UP * 22,
			})
		else
			-- Ranged attack: send it back as a Black Slash, like Prey's Peril.
			local direction = c.Flat(offset)
			fx(ctx, "Deflect", "Reflect", { direction = direction })
			blackSlash(ctx, ctx.root.Position + direction * 2 + UP * 0.5, direction, { damage = 6 })
		end
	end)

	task.wait(DEFLECT_WINDOW + 0.02)
	if not countered then
		-- Guessed wrong: a moment where he's wide open.
		c.ClearCounter(character)
		fx(ctx, "Deflect", "End")
		CombatState.SetCasting(character, 0.45)
	end
end

---------------------------------------------------------------------------
-- Black Form moves
---------------------------------------------------------------------------

-- Black Hurricane. In the air he drills down on them, spinning.
local function blackHurricane(ctx)
	local c, character = ctx.combat, ctx.character
	local forward = look(ctx)
	local airborne = ctx.airborne
	local push = if airborne then forward * 40 + UP * -35 else forward * 55
	CombatState.SetCasting(character, 1.15)
	fx(ctx, "BlackHurricane", "Spin", { duration = 0.9, airborne = airborne })
	c.ApplyVelocity(character, push, 0.9, if airborne then { landStop = true, landKeep = 0.8 } else nil)

	local caught: { [Model]: boolean } = {}
	for _ = 1, 9 do
		task.wait(0.1)
		if interrupted(ctx) then
			fx(ctx, "BlackHurricane", "Stop")
			return
		end
		for _, victim in c.Sphere(character, ctx.root.Position, 7) do
			-- Dragged along with the spin.
			if
				c.Hit(character, victim, {
					damage = 1,
					stun = 0.6,
					attackType = "Melee",
					velocity = Vector3.new(push.X, math.max(push.Y, 0), push.Z) + UP * 2,
					velocityTime = 0.12,
				}) == "Hit"
			then
				caught[victim] = true
			end
		end
	end

	fx(ctx, "BlackHurricane", "Finish", { airborne = airborne })
	for victim in caught do
		if CombatState.IsAlive(victim) then
			c.Hit(character, victim, {
				damage = 5,
				stun = 1,
				attackType = "Melee",
				heavy = true,
				ragdoll = 1.4,
				-- In the air they're driven into the ground instead of thrown up.
				velocity = if airborne then forward * 30 + UP * -60 else forward * 45 + UP * 45,
			})
		end
	end
	CombatState.SetCasting(character, 0.3)
end

-- How far a wave can fly along `direction` before it hits the ground (a wave
-- thrown down out of the air stops there instead of tunnelling on).
local function waveRange(ctx, origin: Vector3, direction: Vector3, maxRange: number): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ctx.character }
	local hit = workspace:Raycast(origin, direction * maxRange, params)
	return if hit then math.max((hit.Position - origin).Magnitude + 2, 8) else maxRange
end

-- Black Slash. In the air he hangs for the throw and hurls it down ahead.
local function blackSlashMove(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, 0.5)
	if airborne then
		c.ApplyVelocity(character, HOVER, 0.4)
	end
	fx(ctx, "BlackSlash", "Windup", { airborne = airborne })
	task.wait(0.22)
	if interrupted(ctx) then
		return
	end
	local forward = look(ctx)
	local direction = if airborne then (forward + UP * -0.45).Unit else forward
	local origin = ctx.root.Position + direction * 2 + UP * 0.5
	blackSlash(ctx, origin, direction, {
		damage = 9,
		range = if airborne then waveRange(ctx, origin, direction, 90) else nil,
	})
end

-- Grand Divider. In the air he hangs while it charges, then brings it down
-- on whatever is below and in front, and the wave is driven into the ground.
local function grandDivider(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, 1.3)
	if airborne then
		c.ApplyVelocity(character, HOVER, 0.75)
	end
	fx(ctx, "GrandDivider", "Charge", { airborne = airborne })
	task.wait(0.7)
	if interrupted(ctx) then
		fx(ctx, "GrandDivider", "Cancel")
		return
	end

	local forward = look(ctx)
	fx(ctx, "GrandDivider", "Release", { airborne = airborne })
	local struck: { [Model]: boolean } = {}
	local box = if airborne then ctx.root.CFrame * CFrame.new(0, -3, -4) else ctx.root.CFrame * CFrame.new(0, 0, -5)
	local size = if airborne then Vector3.new(14, 12, 12) else Vector3.new(12, 9, 10)
	for _, victim in c.Box(character, box, size) do
		struck[victim] = true
		c.Hit(character, victim, {
			damage = 10,
			stun = 1.2,
			attackType = "Explosion",
			guardBreak = true,
			heavy = true,
			ragdoll = 1.6,
			velocity = if airborne then forward * 20 + UP * -95 else forward * 70 + UP * 25,
		})
	end
	local direction = if airborne then (forward + UP * -0.6).Unit else forward
	local origin = ctx.root.Position + direction * 4 + UP * 1
	blackSlash(ctx, origin, direction, {
		damage = 9,
		size = Vector3.new(18, 8, 3),
		speed = 95,
		range = if airborne then waveRange(ctx, origin, direction, 55) else 55,
		grand = true,
		skip = struck,
	})
	if airborne then
		c.ApplyVelocity(character, UP * 22 + forward * 6, 0.12)
	end
	c.ShakeArea(ctx.root.Position, 70, 0.7)
	task.wait(0.3)
	CombatState.SetCasting(character, 0.3)
end

--[[
	Black Moon (Black Form 4): seizes them by the throat and hurls them into
	the sky. Night falls; he hangs in front of a giant moon, then flies
	through them, and a beat later the cut lands. A cutscene for the two of
	them: the timeline is Shared/BlackMoon, the camera work and effects are
	client side.
]]
local MOON_SEIZE = 0.4

local function blackMoon(ctx)
	local c, character = ctx.combat, ctx.character
	local target, release = reachGrab(ctx, MOON_SEIZE + 0.3, "BlackMoon")
	if not target or not release then
		return
	end
	fx(ctx, "BlackMoon", "Seize", { target = target })
	c.ApplyVelocity(character, Vector3.zero, MOON_SEIZE)
	task.wait(SURGE_AT)
	if interrupted(ctx) then
		release()
		return
	end
	c.Hit(character, target, { damage = 3, stun = 3.5, attackType = "Melee", unblockable = true })
	task.wait(MOON_SEIZE - SURGE_AT)
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if interrupted(ctx) or not targetRoot or not CombatState.IsAlive(target) then
		release()
		return
	end

	-- The cutscene takes over from the grab.
	local plan = BlackMoon.Plan(ctx.root.CFrame, targetRoot.Position)
	release()
	local length = BlackMoon.Times.Land
	CombatState.SetCasting(character, length + 0.6)
	CombatState.GiveIFrames(character, length + 0.4)
	CombatState.Stun(target, length + 0.6)
	fx(ctx, "BlackMoon", "Begin", { target = target, origin = plan.origin, victimStart = plan.victimStart })
	local stop = c.Cutscene({
		[character] = function(t)
			return BlackMoon.Attacker(plan, t)
		end,
		[target] = function(t)
			return BlackMoon.Victim(plan, t)
		end,
	}, length)
	task.wait(length)
	stop()

	-- The cut lands: they're cut down out of the sky.
	if CombatState.IsAlive(target) then
		c.Hit(character, target, {
			damage = 25,
			stun = 1.5,
			attackType = "Melee",
			unblockable = true,
			heavy = true,
			ragdoll = 2.4,
			velocity = UP * -110 + plan.forward * 8,
			effect = "BlackMoonCut",
		})
	end
	c.ShakeArea(plan.apex, 120, 0.7)
	-- He glides back down on his wing.
	c.ApplyVelocity(character, UP * -32 + plan.forward * 4, 1)
	CombatState.SetCasting(character, 0.7)
end

-- Spawn entrance: the grimoire appears, he draws the sword from it, twirls
-- it and slams it into the ground. Untouchable and rooted while it plays;
-- the animation itself is client-side (Client/Kits/AntiMagic).
local ENTRANCE_TIME = 2.45

function Kit.Entrance(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, ENTRANCE_TIME)
	CombatState.GiveIFrames(character, ENTRANCE_TIME)
	character:SetAttribute("Rooted", true)
	fx(ctx, "Entrance", "Start")
	task.wait(1.7)
	if CombatState.IsAlive(character) then
		c.ShakeArea(ctx.root.Position, 35, 0.3)
	end
	task.wait(ENTRANCE_TIME - 1.7)
	character:SetAttribute("Rooted", false)
end

---------------------------------------------------------------------------
-- Special (R): Anti-Magic Leap / Meteor Plunge
---------------------------------------------------------------------------

local SPECIAL = CombatState.SpecialSlot
local LEAP_TIME = 0.22
local PLUNGE_HANG = 0.12 -- the Plunge animation's wind-up

-- Meteor Plunge: hangs for a beat with the sword raised, dives behind it
-- (steerable) and stabs it into the ground, blasting everyone around away.
local function plunge(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, 1.2)
	fx(ctx, "Special", "Plunge")
	c.ApplyVelocity(character, HOVER, PLUNGE_HANG)
	task.wait(PLUNGE_HANG)
	if interrupted(ctx) then
		return
	end
	fx(ctx, "Special", "Dive")
	c.ApplyVelocity(character, look(ctx) * 40 + UP * -140, 1, { steer = 140, landStop = true, landKeep = 0 })
	waitForTakeoff(ctx, 0.5)
	waitForGround(ctx, 1)
	if interrupted(ctx) or c.IsAirborne(character) then
		CombatState.SetCasting(character, 0.2)
		return
	end
	c.ApplyVelocity(character, Vector3.zero, 0.05)
	local impact = groundBelow(ctx)
	fx(ctx, "Special", "Impact", { position = impact })
	c.ShakeArea(impact, 35, 0.45)
	for _, victim in c.Sphere(character, impact + UP * 2, 8) do
		local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		if victimRoot then
			c.Hit(character, victim, {
				damage = 5,
				stun = 0.9,
				attackType = "Melee",
				heavy = true,
				velocity = c.Flat(victimRoot.Position - impact) * 34 + UP * 30,
				velocityTime = 0.2,
			})
		end
	end
	CombatState.SetCasting(character, 0.35)
end

-- Anti-Magic Leap: blasts off the ground toward where he's heading
-- (steerable). Press R again in the air to turn it into the plunge. Stops
-- listening as soon as another move starts or he's back on the ground.
local function leap(ctx)
	local c, character = ctx.combat, ctx.character
	local token = c.MoveToken(character)
	local start = os.clock()
	CombatState.SetCasting(character, 0.25)
	fx(ctx, "Special", "Leap")
	c.ApplyVelocity(character, look(ctx) * 60 + UP * 62, LEAP_TIME, { steer = 200 })
	task.wait(0.15)
	local since = start + 0.1
	local seenAir = false
	while os.clock() - start < 1.6 do
		if interrupted(ctx) or c.MoveToken(character) ~= token then
			return
		end
		local up = c.IsAirborne(character)
		seenAir = seenAir or up
		if c.PressedSince(character, SPECIAL, since) then
			-- The press says whether he was in the air (his own client knows).
			if c.PressedAirborne(character, SPECIAL) then
				plunge(ctx)
				return
			end
			since = os.clock()
		end
		-- Landed, once the server (a ping behind) has seen him go up.
		if seenAir and not up then
			return
		end
		if not seenAir and os.clock() - start > 1 then
			return
		end
		task.wait()
	end
end

function Kit.Special(ctx)
	if ctx.airborne then
		plunge(ctx)
	else
		leap(ctx)
	end
end

---------------------------------------------------------------------------
-- Sword moves (Black Form 1 and 2 follow the sword in his hand)
---------------------------------------------------------------------------

local SEAL_COLOR = Color3.fromRGB(200, 25, 35)

local function rootOf(character: Model): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

--[[
	Slayer Recall (Demon-Slayer Sword 2): hurls the sword like a boomerang.
	It cuts whoever it passes on the way out, hangs spinning where it stops,
	and comes back when he presses 2 again (or on its own), cutting through
	them a second time and dragging them back to him. Unarmed (no M1s) until
	he catches it.
]]
local RECALL_RELEASE = 0.28 -- the RecallThrow animation lets go here
local RECALL_RANGE = 34
local RECALL_OUT = 0.42 -- seconds to fly out
local RECALL_HANG = 1.2 -- longest it waits before coming back by itself
local RECALL_SPEED = 95 -- studs per second on the way back
local RECALL_RADIUS = 5

local function slayerRecall(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, 0.45)
	if airborne then
		c.ApplyVelocity(character, HOVER, 0.4)
	end
	fx(ctx, "SlayerRecall", "Wind", { airborne = airborne })
	task.wait(RECALL_RELEASE)
	if interrupted(ctx) then
		fx(ctx, "SlayerRecall", "Cancel")
		return
	end
	local forward = look(ctx)
	local direction = if airborne then (forward + UP * -0.3).Unit else forward
	local origin = ctx.root.Position + direction * 2 + UP * 0.5
	local stop = origin + direction * math.min(waveRange(ctx, origin, direction, RECALL_RANGE), RECALL_RANGE)
	local thrownAt = os.clock()
	-- Starting another move snaps it straight back to his hand.
	local token = c.MoveToken(character)
	local function moved(): boolean
		return c.MoveToken(character) ~= token
	end
	character:SetAttribute("SwordAway", true)
	fx(ctx, "SlayerRecall", "Throw", { origin = origin, target = stop, out = RECALL_OUT })

	local cut: { [Model]: boolean } = {}
	local function sweep(position: Vector3, onHit: (Model) -> ())
		for _, victim in c.Sphere(character, position, RECALL_RADIUS) do
			if not cut[victim] then
				cut[victim] = true
				onHit(victim)
			end
		end
	end

	-- Out: fast at first, slowing to a stop.
	while os.clock() - thrownAt < RECALL_OUT and not moved() do
		local a = (os.clock() - thrownAt) / RECALL_OUT
		sweep(origin:Lerp(stop, 1 - (1 - a) ^ 2), function(victim)
			c.Hit(character, victim, {
				damage = 8,
				stun = 0.9,
				attackType = "Bolt",
				velocity = direction * 18 + UP * 6,
				velocityTime = 0.15,
			})
		end)
		task.wait()
	end

	-- Hanging there, spinning, until he calls it back.
	while os.clock() - thrownAt < RECALL_OUT + RECALL_HANG do
		if c.PressedSince(character, 2, thrownAt) or moved() or not CombatState.IsAlive(character) then
			break
		end
		task.wait()
	end

	-- Back, straight at him wherever he's got to, through whoever's between.
	table.clear(cut)
	local position = stop
	if not moved() then
		fx(ctx, "SlayerRecall", "Return", { from = position, speed = RECALL_SPEED })
	end
	local started = os.clock()
	local last = started
	while CombatState.IsAlive(character) and not moved() and os.clock() - started < 1.5 do
		task.wait()
		local now = os.clock()
		local offset = ctx.root.Position - position
		local step = RECALL_SPEED * (now - last)
		last = now
		if offset.Magnitude <= math.max(step, 2.5) then
			break
		end
		position += offset.Unit * step
		sweep(position, function(victim)
			local victimRoot = rootOf(victim)
			local toward = if victimRoot then ctx.root.Position - victimRoot.Position else -direction
			local pull = math.clamp((toward.Magnitude - 5) / 0.3, 0, 110)
			c.Hit(character, victim, {
				damage = 6,
				stun = 1.1,
				attackType = "Bolt",
				heavy = true,
				velocity = c.Flat(toward) * pull + UP * 8,
				velocityTime = 0.3,
			})
		end)
	end
	character:SetAttribute("SwordAway", nil)
	if CombatState.IsAlive(character) then
		fx(ctx, "SlayerRecall", "Catch", { instant = moved() })
	end
end

--[[
	Conquering Eon (Demon-Dweller Sword 2): raises the Dweller and it drinks
	in the magic around him. Spells that hit him are swallowed by the blade,
	and the mana of everyone close by is siphoned off. Each charge (up to 4)
	makes the slash he lets it all out in bigger; from 3 it breaks guards.
]]
local EON_CHARGE = 0.6
local EON_RADIUS = 18
local EON_MAX = 4
local SPELLS = { Bolt = true, Explosion = true, Swarm = true, Zone = true }

local function conqueringEon(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	local charges = 0
	CombatState.SetCasting(character, EON_CHARGE + 0.5)
	if airborne then
		c.ApplyVelocity(character, HOVER, EON_CHARGE + 0.2)
	end
	fx(ctx, "ConqueringEon", "Raise", { airborne = airborne, duration = EON_CHARGE })
	local raisedAt = os.clock()

	local function absorb(attacker: Model)
		charges = math.min(charges + 1, EON_MAX)
		local attackerRoot = rootOf(attacker)
		fx(ctx, "ConqueringEon", "Absorb", {
			from = if attackerRoot then attackerRoot.Position else ctx.root.Position + look(ctx) * 10,
			charges = charges,
		})
		local left = EON_CHARGE - (os.clock() - raisedAt)
		if left > 0.02 then
			c.SetCounter(character, left, SPELLS, absorb)
		end
	end
	c.SetCounter(character, EON_CHARGE, SPELLS, absorb)

	task.wait(0.2)
	if interrupted(ctx) then
		c.ClearCounter(character)
		fx(ctx, "ConqueringEon", "Cancel")
		return
	end
	local drained = {}
	for _, victim in c.Sphere(character, ctx.root.Position, EON_RADIUS) do
		if c.Hit(character, victim, { damage = 2, stun = 0.5, attackType = "Zone", unblockable = true }) == "Hit" then
			table.insert(drained, victim)
			charges = math.min(charges + 1, EON_MAX)
		end
	end
	if #drained > 0 then
		fx(ctx, "ConqueringEon", "Siphon", { targets = drained, charges = charges })
	end
	task.wait(EON_CHARGE - 0.2)
	c.ClearCounter(character)
	if interrupted(ctx) then
		fx(ctx, "ConqueringEon", "Cancel")
		return
	end

	local forward = look(ctx)
	local direction = if airborne then (forward + UP * -0.5).Unit else forward
	local origin = ctx.root.Position + direction * 3 + UP * 0.8
	fx(ctx, "ConqueringEon", "Release", { airborne = airborne, charges = charges })
	blackSlash(ctx, origin, direction, {
		damage = 8 + 2 * charges,
		size = Vector3.new(10 + 2.5 * charges, 5 + charges, 3),
		speed = 105,
		range = if airborne then waveRange(ctx, origin, direction, 70) else 70,
		grand = charges >= 3,
	})
	c.ShakeArea(ctx.root.Position, 40 + 8 * charges, 0.3 + 0.1 * charges)
	task.wait(0.3)
	CombatState.SetCasting(character, 0.25)
end

--[[
	Causality Break (Demon-Destroyer Sword 1): drives the Destroyer into the
	ground and its curse-breaking anti-magic runs out through the earth to
	the four closest enemies around him. It cuts them and wipes out whatever
	they had going: a counter, their guard, a Zetten stance.
]]
local CAUSALITY_STAB = 0.42 -- the CausalityPlant animation's stab
local CAUSALITY_RADIUS = 18
local CAUSALITY_TARGETS = 4

local function causalityBreak(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, 1.0)
	if airborne then
		c.ApplyVelocity(character, HOVER, CAUSALITY_STAB + 0.35)
	end
	fx(ctx, "CausalityBreak", "Plant", { airborne = airborne })
	task.wait(CAUSALITY_STAB)
	if interrupted(ctx) then
		fx(ctx, "CausalityBreak", "Cancel")
		return
	end

	local center = ctx.root.Position
	local nearby = c.Sphere(character, center, CAUSALITY_RADIUS)
	local function distance(victim: Model): number
		local victimRoot = rootOf(victim)
		return if victimRoot then (victimRoot.Position - center).Magnitude else math.huge
	end
	table.sort(nearby, function(a, b)
		return distance(a) < distance(b)
	end)
	local targets = {}
	for i = 1, math.min(#nearby, CAUSALITY_TARGETS) do
		table.insert(targets, nearby[i])
	end
	fx(ctx, "CausalityBreak", "Break", { targets = targets, airborne = airborne })
	for _, victim in targets do
		-- Their magic is broken first, so nothing they had up stops it.
		c.ClearCounter(victim)
		c.StopWatchingSkills(victim)
		CombatState.SetBlocking(victim, false)
		c.Hit(character, victim, {
			damage = 10,
			stun = 0.8,
			attackType = "Zone",
			unblockable = true,
			heavy = true,
			velocity = UP * 24,
			velocityTime = 0.15,
		})
	end
	c.ShakeArea(center, 45, 0.5)
	task.wait(0.25)
	if CombatState.IsAlive(character) then
		fx(ctx, "CausalityBreak", "Pull")
	end
	CombatState.SetCasting(character, 0.3)
end

--[[
	Severance (Demon-Destroyer Sword 2): one draw-cut as he dashes straight
	through them. A beat later the cut lands, and whoever it cut is severed
	from their magic: every move they have is sealed for a few seconds.
]]
local SEVER_DASH_AT = 0.12 -- the Severance animation's crouch
local SEVER_DASH = 0.2
local SEVER_SPEED = 95
local SEVER_DELAY = 0.35
local SEAL_TIME = 3

local function severance(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, 0.75)
	fx(ctx, "Severance", "Draw", { airborne = ctx.airborne })
	task.wait(SEVER_DASH_AT)
	if interrupted(ctx) then
		fx(ctx, "Severance", "Cancel")
		return
	end
	local forward = look(ctx)
	local from = ctx.root.Position
	CombatState.GiveIFrames(character, SEVER_DASH + 0.1)
	c.ApplyVelocity(character, forward * SEVER_SPEED + (if ctx.airborne then HOVER else Vector3.zero), SEVER_DASH)
	fx(ctx, "Severance", "Dash", { from = from, direction = forward })
	local cut: { Model } = {}
	local seen: { [Model]: boolean } = {}
	local start = os.clock()
	while os.clock() - start < SEVER_DASH + 0.03 do
		for _, victim in c.Box(character, ctx.root.CFrame * CFrame.new(0, 0, -1), Vector3.new(6, 7, 7)) do
			if not seen[victim] then
				seen[victim] = true
				table.insert(cut, victim)
			end
		end
		task.wait()
	end
	c.ApplyVelocity(character, forward * 8, 0.1)
	fx(ctx, "Severance", "Sheathe", { from = from, to = ctx.root.Position, targets = cut })
	task.wait(SEVER_DELAY)
	for _, victim in cut do
		if
			CombatState.IsAlive(victim)
			and c.Hit(character, victim, {
					damage = 11,
					stun = 1.1,
					attackType = "Melee",
					heavy = true,
					velocity = forward * 10 + UP * 8,
					velocityTime = 0.15,
				})
				== "Hit"
		then
			for _, slot in { 1, 2, 3, 4, CombatState.SpecialSlot } do
				if CombatState.Cooldown(victim, slot) < SEAL_TIME then
					CombatState.StartCooldown(victim, slot, SEAL_TIME)
				end
			end
			fx(ctx, "Severance", "Seal", { target = victim, duration = SEAL_TIME })
			c.Notify(victim, "SEVERED: moves sealed", SEAL_COLOR)
		end
	end
	CombatState.SetCasting(character, 0.2)
end

--[[
	Infinite Slash (Demon-Slasher Katana 1): Yami's move. The katana raised
	overhead comes down once, and a cut opens along everything in a straight
	line ahead of him, as far as it goes. It cuts only what he means to cut:
	nothing blocks it.
]]
local INFINITE_RAISE = 0.55
local INFINITE_RANGE = 60

local function infiniteSlash(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, INFINITE_RAISE + 0.45)
	if airborne then
		c.ApplyVelocity(character, HOVER, INFINITE_RAISE + 0.25)
	end
	fx(ctx, "InfiniteSlash", "Raise", { airborne = airborne, duration = INFINITE_RAISE })
	task.wait(INFINITE_RAISE)
	if interrupted(ctx) then
		fx(ctx, "InfiniteSlash", "Cancel")
		return
	end
	local forward = look(ctx)
	local direction = if airborne then (forward + UP * -0.35).Unit else forward
	local origin = ctx.root.Position + direction * 1.5
	local length = waveRange(ctx, origin, direction, INFINITE_RANGE)
	fx(ctx, "InfiniteSlash", "Cut", { origin = origin, direction = direction, length = length })
	local box = CFrame.lookAt(origin + direction * (length / 2), origin + direction * length)
	for _, victim in c.Box(character, box, Vector3.new(3.5, 7, length)) do
		c.Hit(character, victim, {
			damage = 11,
			stun = 1.1,
			attackType = "Melee",
			unblockable = true,
			heavy = true,
			ragdoll = 1.2,
			velocity = direction * 25 + UP * 22,
		})
	end
	c.ShakeArea(origin, 50, 0.45)
	task.wait(0.3)
	CombatState.SetCasting(character, 0.2)
end

--[[
	Zetten (Demon-Slasher Katana 2): an iai stance, reading ki. The first
	enemy close by to make a move (start a skill, or swing at him) is cut
	down before it lands: he's past them in a flash. If nobody moves, the
	stance ends in one quick cut ahead.
]]
local ZETTEN_STANCE = 1.0
local ZETTEN_RADIUS = 20

local function zetten(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	local done = false
	CombatState.SetCasting(character, ZETTEN_STANCE + 0.1)
	if airborne then
		c.ApplyVelocity(character, HOVER, ZETTEN_STANCE)
	end
	fx(ctx, "Zetten", "Stance", { airborne = airborne, duration = ZETTEN_STANCE })

	local function strike(target: Model)
		local targetRoot = rootOf(target)
		if done or interrupted(ctx) or not targetRoot or not CombatState.IsAlive(target) then
			return
		end
		done = true
		c.StopWatchingSkills(character)
		c.ClearCounter(character)
		local from = ctx.root.Position
		local through = c.Flat(targetRoot.Position - from)
		local to = targetRoot.Position + through * 4
		-- Not through a wall.
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character, target }
		local wall = workspace:Raycast(targetRoot.Position, through * 4, params)
		if wall then
			to = wall.Position - through * 1.5
		end
		CombatState.GiveIFrames(character, 0.5)
		CombatState.SetCasting(character, 0.55)
		ctx.root.CFrame = CFrame.lookAt(to, to + through)
		c.ApplyVelocity(character, if airborne then HOVER else Vector3.zero, 0.3)
		fx(ctx, "Zetten", "Strike", { from = from, to = to, target = target })
		c.Hit(character, target, {
			damage = 15,
			stun = 1.3,
			attackType = "Melee",
			guardBreak = true,
			heavy = true,
			ragdoll = 1.3,
			velocity = through * 30 + UP * 26,
		})
		c.ShakeArea(to, 50, 0.5)
	end

	c.WatchSkills(character, ZETTEN_RADIUS, ZETTEN_STANCE, strike)
	c.SetCounter(character, ZETTEN_STANCE, { Melee = true }, strike)
	local start = os.clock()
	while not done and os.clock() - start < ZETTEN_STANCE do
		if interrupted(ctx) then
			done = true
			c.StopWatchingSkills(character)
			c.ClearCounter(character)
			fx(ctx, "Zetten", "Cancel")
			return
		end
		task.wait()
	end
	if done then
		return
	end
	done = true
	c.StopWatchingSkills(character)
	c.ClearCounter(character)
	-- Nobody moved: one quick cut ahead.
	fx(ctx, "Zetten", "Cut", { airborne = airborne })
	for _, victim in c.Box(character, ctx.root.CFrame * CFrame.new(0, 0, -4.5), Vector3.new(9, 7, 9)) do
		c.Hit(character, victim, {
			damage = 7,
			stun = 0.8,
			attackType = "Melee",
			heavy = true,
			velocity = look(ctx) * 30 + UP * 10,
		})
	end
	CombatState.SetCasting(character, 0.35)
end

Kit.Skills = { bullThrust, blackMeteorite, blackDivider, antiMagicDeflect }

-- In Black Form, moves 1 and 2 belong to the sword in his hand (the
-- "Sword" attribute; names and cooldowns in Shared/Kits swords).
local SWORD_MOVES: { [string]: { (any) -> () } } = {
	Slayer = { blackHurricane, slayerRecall },
	Dweller = { blackSlashMove, conqueringEon },
	Destroyer = { causalityBreak, severance },
	Slasher = { infiniteSlash, zetten },
}
local function swordMove(slot: number): (any) -> ()
	return function(ctx)
		local moves = SWORD_MOVES[ctx.character:GetAttribute("Sword")] or SWORD_MOVES.Slayer
		moves[slot](ctx)
	end
end
Kit.AwakenedSkills = { swordMove(1), swordMove(2), grandDivider, blackMoon }

-- R in Black Form: one of his other swords, at random, out of the grimoire.
-- The new one is in his hand when the SwordSwap animation draws it.
local SWORD_KINDS = { "Slayer", "Dweller", "Destroyer", "Slasher" }
local SWAP_DRAW = 0.22

function Kit.AwakenedSpecial(ctx)
	local character = ctx.character
	local current = character:GetAttribute("Sword")
	if character:GetAttribute("SwordAway") then
		return -- the Slayer's still out (Slayer Recall)
	end
	local choices = {}
	for _, kind in SWORD_KINDS do
		if kind ~= current and SWORDS[kind] then
			table.insert(choices, kind)
		end
	end
	if #choices == 0 then
		return
	end
	local kind = choices[math.random(1, #choices)]
	CombatState.SetCasting(character, 0.4)
	fx(ctx, "SwordSwap", "Swap", { sword = kind })
	task.wait(SWAP_DRAW)
	if CombatState.IsAlive(character) and character.Parent then
		setSword(character, kind)
	end
end

---------------------------------------------------------------------------
-- Awakening: Black Form (Devil Union)
---------------------------------------------------------------------------

-- Matches the client's Awaken animation (tools/anim): anti-magic gathers
-- while he crouches, bursts out on the roar at 0.92s, then he drops into
-- his Black Form stance. Rooted and untouchable the whole time.
local AWAKEN_BURST = 0.92
local AWAKEN_TIME = 2.0

function Kit.Awaken(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, AWAKEN_TIME)
	CombatState.GiveIFrames(character, AWAKEN_TIME + 0.1)
	character:SetAttribute("Rooted", true)
	fx(ctx, "Awaken", "Start")
	c.ShakeArea(ctx.root.Position, 40, 0.25)
	task.wait(AWAKEN_BURST)

	if CombatState.IsAlive(character) then
		fx(ctx, "Awaken", "Burst")
		c.ShakeArea(ctx.root.Position, 90, 0.9)
		-- The anti-magic burst blows everyone nearby away.
		for _, victim in c.Sphere(character, ctx.root.Position, 18) do
			local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
			if victimRoot and not CombatState.HasIFrames(victim) and not CombatState.IsRagdolled(victim) then
				c.Ragdoll(victim, 1)
				c.ApplyVelocity(victim, c.Flat(victimRoot.Position - ctx.root.Position) * 65 + UP * 24, 0.2)
			end
		end
	end

	task.wait(AWAKEN_TIME - AWAKEN_BURST)
	if character.Parent then
		character:SetAttribute("Rooted", false)
	end
end

function Kit.AwakenEnd(ctx)
	fx(ctx, "Awaken", "End")
	-- Out of Black Form he's back to the Demon-Slayer Sword.
	local character = ctx.character
	if character:GetAttribute("Sword") ~= "Slayer" and character.Parent then
		setSword(character, "Slayer")
	end
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Wind</string>
            <string name="Source"><![CDATA[--[[
	Prince of Wind (Yuno), server side.

	A mid-range zoner, Asta's opposite: wind spells that pin people down and
	push them around from where a sword can't reach, star magic to be
	somewhere else in an instant. Less damage per move than Asta, more
	range and control. Spells are Bolt / Swarm / Zone attacks, so Asta's
	Deflect sends them back and his Conquering Eon drinks them in.

	Base: Prince of Wind
	  1 Wind Blades Shower   a rain of wind blades on whoever he faces (or a
	                         way ahead): six waves of hits, the last pops them up
	  2 Swift White Hawk     a hawk of wind that flies at them, curving after
	                         them, and blows them away
	  3 Heavenly Wind Ark    a crescent of wind rises out of the ground ahead and
	                         carries them and him up together, held there for an
	                         air string that ends in the downslam (air: it sweeps
	                         down and spikes them)
	  4 Gale White Bow       a great bow of wind; six big arrows, aimed at whoever
	                         he faces
	  R Conjunction          a star goes down where he's moving (ahead if he's
	                         still); R again within 4s and he's there
	Half-Crown Spirit of Zephyr (G): Sylph on his left side
	  1 Spirit Storm         a dense beam of swirling wind out of his palm
	  2 Tempest Dive         grab: he drags them straight up into the sky, then
	                         drives them head-first down into the ground, a
	                         tornado forming behind them on the way down.
	                         Landing it twice is what unlocks the Full-Crown
	  3 Quartile Scutum      four stars and the light between them: a wall in
	                         front that stops everything, melee thrown back off it
	  4 Quartile Hasta       four star beams converge into one: guard-breaking
	Full-Crown Spirit of Zephyr (G again, once Tempest Dive has landed twice)
	  1 Spirit of Notos      the south wind bursts out of him, and blows spells
	                         thrown at him back where they came from
	  2 Spirit of Zephyrus   he leaps into the sky, wind arrows form floating round
	                         him, then rain down on them
	  3 Spirit of Euros      a recurve bow of wind; one arrow, too fast to see,
	                         through everything in a line (unblockable)
	  4 Neverland            cutscene grab: in the stopped time of the star dome he
	                         warps round a triangle of stars punching them up,
	                         hammers them down, and the dome lingers over them
	Air combos: he can jump again in the air (Kits airJumps), and from the air
	the hawk holds them up and pulls him in, the blades and arrows keep them
	up there (the last spikes them down), Tempest Dive takes them both up.

	All visuals are in StarterPlayerScripts.Client.Kits.Wind, which gets
	("Skill", {skill, phase, ...}) events from here.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatState = require(ReplicatedStorage:WaitForChild("Shared").CombatState)
local NeverlandPlan = require(ReplicatedStorage:WaitForChild("Shared").Neverland)
local DivePlan = require(ReplicatedStorage:WaitForChild("Shared").TempestDive)
local Projectile = require(script.Parent.Parent.Projectile)

local KIT_ID = "Wind"
local UP = Vector3.yAxis
-- Holds a character in the air (a tiny upward velocity switches on the
-- vertical force, so gravity stops pulling).
local HOVER = Vector3.new(0, 0.05, 0)
local SPELLS = { Bolt = true, Explosion = true, Swarm = true, Zone = true }
local ALL_TYPES = { Melee = true, Bolt = true, Explosion = true, Swarm = true, Zone = true }

local Kit = {}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

local function fx(ctx, skill: string, phase: string, extra: { [string]: any }?)
	local data: { [string]: any } = { character = ctx.character, kit = KIT_ID, skill = skill, phase = phase }
	if extra then
		for key, value in extra do
			data[key] = value
		end
	end
	ctx.combat.FireVFX("Skill", data)
end

local function look(ctx): Vector3
	return ctx.combat.Flat(ctx.root.CFrame.LookVector)
end

local function rootOf(character: Model): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Interrupted by getting hit, ragdolled or dying.
local function interrupted(ctx): boolean
	local character = ctx.character
	return not CombatState.IsAlive(character) or CombatState.IsStunned(character) or CombatState.IsRagdolled(character)
end

local function rayParams(ctx): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ctx.character }
	return params
end

local function isCharacterPart(part: Instance): boolean
	local model = part:FindFirstAncestorWhichIsA("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- How far a spell can go along `direction` before it meets the ground or a
-- wall (people don't stop it).
local function reach(ctx, origin: Vector3, direction: Vector3, maxRange: number): number
	local hit = workspace:Raycast(origin, direction * maxRange, rayParams(ctx))
	if hit and not isCharacterPart(hit.Instance) then
		return math.max((hit.Position - origin).Magnitude + 1, 6)
	end
	return maxRange
end

-- The floor under a point (or 3 studs under it when there's none in reach),
-- looking past anyone standing there.
local function floorUnder(ctx, position: Vector3): Vector3
	local params = rayParams(ctx)
	local ignore: { Instance } = { ctx.character }
	for _ = 1, 4 do
		local hit = workspace:Raycast(position + UP * 2, Vector3.new(0, -60, 0), params)
		if not hit then
			break
		end
		local model = hit.Instance:FindFirstAncestorWhichIsA("Model")
		if not (model and model:FindFirstChildOfClass("Humanoid")) then
			return hit.Position
		end
		table.insert(ignore, model)
		params.FilterDescendantsInstances = ignore
	end
	return position - UP * 3
end

-- Who he's most likely aiming at: the closest enemy within `range` studs
-- and `cone` degrees of where he faces.
local function softTarget(ctx, range: number, cone: number): Model?
	local forward = look(ctx)
	local minDot = math.cos(math.rad(cone))
	local best, bestDistance = nil, math.huge
	for _, victim in ctx.combat.Sphere(ctx.character, ctx.root.Position, range) do
		local victimRoot = rootOf(victim)
		if victimRoot then
			local offset = victimRoot.Position - ctx.root.Position
			if ctx.combat.Flat(offset):Dot(forward) >= minDot and offset.Magnitude < bestDistance then
				best, bestDistance = victim, offset.Magnitude
			end
		end
	end
	return best
end

-- Where a spell aims: straight at the soft target if there is one, else
-- ahead (and down at an angle from the air).
local function aimFrom(ctx, origin: Vector3, target: Model?, dip: number): Vector3
	local targetRoot = target and rootOf(target)
	if targetRoot then
		return (targetRoot.Position - origin).Unit
	end
	local forward = look(ctx)
	return if ctx.airborne then (forward + UP * -dip).Unit else forward
end

-- Everyone along a line (a beam).
local function lineVictims(ctx, origin: Vector3, direction: Vector3, length: number, width: number): { Model }
	local box = CFrame.lookAt(origin + direction * (length / 2), origin + direction * length)
	return ctx.combat.Box(ctx.character, box, Vector3.new(width, width + 1, length))
end

---------------------------------------------------------------------------
-- Base moves: Prince of Wind
---------------------------------------------------------------------------

-- Wind Blades Shower: blades of wind form in the sky over whoever he faces
-- (or a way ahead) and rain down in waves. The waves pin them in place; the
-- last one pops them up. The blades keep falling even if he's hit.
local SHOWER_CAST = 0.35
local SHOWER_WAVES = 6
local SHOWER_GAP = 0.15
local SHOWER_RADIUS = 9

local function windBladesShower(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, SHOWER_CAST + 0.25)
	if ctx.airborne then
		c.ApplyVelocity(character, HOVER, SHOWER_CAST + 0.3)
	end
	local target = softTarget(ctx, 40, 50)
	local targetRoot = target and rootOf(target)
	local center = floorUnder(ctx, if targetRoot then targetRoot.Position else ctx.root.Position + look(ctx) * 18)
	fx(ctx, "WindBladesShower", "Cast", {
		center = center,
		radius = SHOWER_RADIUS,
		waves = SHOWER_WAVES,
		gap = SHOWER_GAP,
		delay = SHOWER_CAST,
		airborne = ctx.airborne,
	})
	task.wait(SHOWER_CAST)
	if interrupted(ctx) then
		fx(ctx, "WindBladesShower", "Cancel")
		return
	end
	for wave = 1, SHOWER_WAVES do
		local last = wave == SHOWER_WAVES
		for _, victim in c.Sphere(character, center + UP * 3, SHOWER_RADIUS + 2) do
			local victimRoot = rootOf(victim)
			local offset = if victimRoot then victimRoot.Position - center else Vector3.zero
			if victimRoot and Vector3.new(offset.X, 0, offset.Z).Magnitude <= SHOWER_RADIUS then
				-- Someone in the air is held up there by the blades, and the
				-- last wave throws them higher: a juggle.
				local aloft = c.IsAirborne(victim)
				c.Hit(character, victim, {
					damage = if last then 2.5 else 1.4,
					stun = if last then 0.8 else 0.5,
					attackType = "Swarm",
					heavy = last,
					velocity = if last then UP * (if aloft then 40 else 26) elseif aloft then HOVER else nil,
					velocityTime = if last then 0.15 else 0.2,
				})
			end
		end
		task.wait(SHOWER_GAP)
	end
end

-- Swift White Hawk: a hawk of wind that flies at them, curving after whoever
-- he faced when he threw it, and blows them away when it strikes.
local HAWK_CAST = 0.22
local HAWK_SPEED = 80
local HAWK_RANGE = 75
local HAWK_TURN = math.rad(140) -- per second

local function swiftWhiteHawk(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, HAWK_CAST + 0.2)
	if ctx.airborne then
		c.ApplyVelocity(character, HOVER, HAWK_CAST + 0.2)
	end
	fx(ctx, "SwiftWhiteHawk", "Cast", { airborne = ctx.airborne })
	task.wait(HAWK_CAST)
	if interrupted(ctx) then
		return
	end
	local target = softTarget(ctx, HAWK_RANGE, 45)
	local position = ctx.root.Position + look(ctx) * 2.5 + UP * 0.6
	local direction = aimFrom(ctx, position, nil, 0.3)
	fx(ctx, "SwiftWhiteHawk", "Fly", {
		origin = position,
		direction = direction,
		target = target,
		speed = HAWK_SPEED,
		turn = HAWK_TURN,
		range = HAWK_RANGE,
	})
	local params = rayParams(ctx)
	local travelled = 0
	local last = os.clock()
	while travelled < HAWK_RANGE do
		task.wait()
		local now = os.clock()
		local dt = now - last
		last = now
		local targetRoot = target and rootOf(target)
		if targetRoot and CombatState.IsAlive(target :: Model) then
			local want = (targetRoot.Position - position).Unit
			local angle = math.acos(math.clamp(direction:Dot(want), -1, 1))
			if angle > 1e-3 then
				direction = direction:Lerp(want, math.min(1, HAWK_TURN * dt / angle)).Unit
			end
		end
		local step = HAWK_SPEED * dt
		local wall = workspace:Raycast(position, direction * step, params)
		if wall and not isCharacterPart(wall.Instance) then
			fx(ctx, "SwiftWhiteHawk", "Burst", { position = wall.Position })
			return
		end
		position += direction * step
		travelled += step
		local victims = c.Sphere(character, position, 3.5)
		if #victims > 0 then
			-- Thrown from the air it holds them up there and pulls him in after
			-- them, for an air string; from the ground it blows them away.
			for _, victim in victims do
				c.Hit(character, victim, {
					damage = 8,
					stun = if airborne then 1.2 else 0.9,
					attackType = "Bolt",
					heavy = true,
					velocity = if airborne then HOVER else c.Flat(direction) * 38 + UP * 14,
					velocityTime = if airborne then 1 else 0.2,
				})
			end
			local offset = position - ctx.root.Position
			if airborne and offset.Magnitude > 5 and not interrupted(ctx) then
				c.ApplyVelocity(character, offset.Unit * math.min((offset.Magnitude - 3) / 0.25, 90), 0.25)
				task.delay(0.25, function()
					if CombatState.IsAlive(character) then
						c.ApplyVelocity(character, HOVER, 0.6)
					end
				end)
			end
			fx(ctx, "SwiftWhiteHawk", "Burst", { position = position })
			return
		end
	end
	fx(ctx, "SwiftWhiteHawk", "Burst", { position = position, fade = true })
end

-- Heavenly Wind Ark: a great crescent of wind rises out of the ground in
-- front of him and carries whoever it catches up into the air, and him
-- right behind them; both hang there for an air string (M1s in the air
-- keep them both up, the 4th slams them down). In the air the ark sweeps
-- down beneath him instead and spikes them into the ground.
local ARK_CAST = 0.18
local ARK_RISE = 46 -- studs a second, for ARK_RISE_TIME: about 14 studs up
local ARK_RISE_TIME = 0.3
local ARK_HANG = 0.9

local function heavenlyWindArk(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, ARK_CAST + 0.35)
	if airborne then
		c.ApplyVelocity(character, HOVER, ARK_CAST + 0.1)
	end
	fx(ctx, "HeavenlyWindArk", "Cast", { airborne = airborne })
	task.wait(ARK_CAST)
	if interrupted(ctx) then
		return
	end
	local forward = look(ctx)
	fx(ctx, "HeavenlyWindArk", "Rise", { airborne = airborne, origin = ctx.root.Position, direction = forward })
	if airborne then
		for _, victim in c.Box(character, ctx.root.CFrame * CFrame.new(0, -4, -4), Vector3.new(12, 11, 12)) do
			c.Hit(character, victim, {
				damage = 8,
				stun = 1,
				attackType = "Zone",
				heavy = true,
				ragdoll = 1.2,
				velocity = forward * 10 + UP * -70,
			})
		end
		c.ApplyVelocity(character, UP * 18, 0.12)
		return
	end
	local launched = {}
	for _, victim in c.Box(character, ctx.root.CFrame * CFrame.new(0, 1, -5.5), Vector3.new(11, 9, 11)) do
		if c.Hit(character, victim, { damage = 7, stun = 1.6, attackType = "Zone", heavy = true }) == "Hit" then
			table.insert(launched, victim)
		end
	end
	if #launched == 0 then
		return
	end
	fx(ctx, "HeavenlyWindArk", "Carry", { targets = launched, rise = ARK_RISE_TIME + ARK_HANG })
	for _, victim in launched do
		c.ApplyVelocity(victim, UP * ARK_RISE, ARK_RISE_TIME)
	end
	c.ApplyVelocity(character, UP * ARK_RISE + forward * 3, ARK_RISE_TIME)
	task.wait(ARK_RISE_TIME)
	for _, victim in launched do
		if CombatState.IsAlive(victim) then
			c.ApplyVelocity(victim, HOVER, ARK_HANG)
		end
	end
	if CombatState.IsAlive(character) and not interrupted(ctx) then
		c.ApplyVelocity(character, HOVER, ARK_HANG)
	end
end

-- Gale White Bow: a great bow of wind and six big arrows, one after the
-- other, each aimed at whoever he faces at that moment. The first five keep
-- them stunned, the sixth knocks them back.
local BOW_DRAW = 0.35
local BOW_ARROWS = 6
local BOW_GAP = 0.12

local function galeWhiteBow(ctx)
	local c, character = ctx.combat, ctx.character
	local volley = BOW_DRAW + BOW_ARROWS * BOW_GAP
	CombatState.SetCasting(character, volley + 0.2)
	if ctx.airborne then
		c.ApplyVelocity(character, HOVER, volley + 0.1)
	end
	fx(ctx, "GaleWhiteBow", "Draw", { airborne = ctx.airborne, draw = BOW_DRAW, arrows = BOW_ARROWS, gap = BOW_GAP })
	task.wait(BOW_DRAW)
	for i = 1, BOW_ARROWS do
		if interrupted(ctx) then
			fx(ctx, "GaleWhiteBow", "Cancel")
			return
		end
		local last = i == BOW_ARROWS
		local side = ctx.root.CFrame.RightVector * (if i % 2 == 0 then 0.5 else -0.5)
		local origin = ctx.root.Position + look(ctx) * 2 + UP * 0.8 + side
		local direction = aimFrom(ctx, origin, softTarget(ctx, 90, 30), 0.3)
		fx(
			ctx,
			"GaleWhiteBow",
			"Arrow",
			{ origin = origin, direction = direction, speed = 170, range = 90, last = last }
		)
		Projectile.Fire({
			owner = character,
			origin = origin,
			direction = direction,
			speed = 170,
			range = 90,
			size = Vector3.new(2.5, 2.5, 5),
			onHit = function(victim)
				-- In the air the arrows pin them there; the last spikes them down.
				local aloft = c.IsAirborne(victim)
				local push = if last and aloft
					then c.Flat(direction) * 12 + UP * -60
					elseif last then c.Flat(direction) * 40 + UP * 15
					elseif aloft then HOVER
					else c.Flat(direction) * 6
				c.Hit(character, victim, {
					damage = if last then 3 else 2,
					stun = if last then 0.9 else 0.55,
					attackType = "Bolt",
					heavy = last,
					ragdoll = if last and aloft then 1.2 else nil,
					velocity = push,
					velocityTime = if aloft and not last then 0.25 else 0.15,
				})
			end,
		})
		task.wait(BOW_GAP)
	end
	CombatState.SetCasting(character, 0.2)
end

---------------------------------------------------------------------------
-- R: Conjunction (star magic)
---------------------------------------------------------------------------

-- A star goes down 22 studs the way he's moving (to the side or back for a
-- dodge), or straight ahead when he's standing still. R again within 4s and
-- he's there in an instant. A press while he's stunned does nothing.
local STAR_DISTANCE = 22
local STAR_LIFE = 4

function Kit.Special(ctx)
	local c, character = ctx.combat, ctx.character
	local velocity = ctx.root.AssemblyLinearVelocity
	local moving = Vector3.new(velocity.X, 0, velocity.Z)
	local direction = if moving.Magnitude > 4 then moving.Unit else look(ctx)
	local origin = ctx.root.Position
	local wall = workspace:Raycast(origin, direction * STAR_DISTANCE, rayParams(ctx))
	local star = if wall and not isCharacterPart(wall.Instance)
		then wall.Position - direction * 2
		else origin + direction * STAR_DISTANCE
	local placedAt = os.clock()
	local since = placedAt
	fx(ctx, "Conjunction", "Place", { origin = origin, star = star, life = STAR_LIFE })
	while os.clock() - placedAt < STAR_LIFE and CombatState.IsAlive(character) do
		task.wait()
		if c.PressedSince(character, CombatState.SpecialSlot, since) then
			if not CombatState.CanAct(character) or CombatState.IsCasting(character) then
				since = os.clock()
				continue
			end
			local from = ctx.root.Position
			CombatState.GiveIFrames(character, 0.3)
			ctx.root.CFrame = CFrame.lookAt(star, star + c.Flat(ctx.root.CFrame.LookVector))
			c.ApplyVelocity(character, Vector3.zero, 0.05)
			fx(ctx, "Conjunction", "Warp", { from = from, star = star })
			return
		end
	end
	fx(ctx, "Conjunction", "Fade", { star = star })
end

---------------------------------------------------------------------------
-- Half-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Spirit Storm: mana gathered in his palm, let out as a dense beam of
-- swirling wind that drags them along it; the last of it blows them away.
local STORM_CHARGE = 0.45
local STORM_TICKS = 6
local STORM_TICK = 0.1
local STORM_LENGTH = 50

local function spiritStorm(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	local beam = STORM_TICKS * STORM_TICK
	CombatState.SetCasting(character, STORM_CHARGE + beam + 0.3)
	if airborne then
		c.ApplyVelocity(character, HOVER, STORM_CHARGE + beam + 0.1)
	end
	fx(ctx, "SpiritStorm", "Charge", { airborne = airborne, duration = STORM_CHARGE })
	task.wait(STORM_CHARGE)
	if interrupted(ctx) then
		fx(ctx, "SpiritStorm", "Cancel")
		return
	end
	local origin = ctx.root.Position + look(ctx) * 2 + UP * 0.6
	local direction = aimFrom(ctx, origin, softTarget(ctx, STORM_LENGTH, 25), 0.4)
	local length = reach(ctx, origin, direction, STORM_LENGTH)
	fx(ctx, "SpiritStorm", "Fire", { origin = origin, direction = direction, length = length, duration = beam })
	for tick = 1, STORM_TICKS do
		local last = tick == STORM_TICKS
		for _, victim in lineVictims(ctx, origin, direction, length, 5) do
			c.Hit(character, victim, {
				damage = if last then 3 else 1.6,
				stun = if last then 1 else 0.45,
				attackType = "Bolt",
				heavy = last,
				velocity = direction * (if last then 55 else 22) + UP * (if last then 18 else 2),
				velocityTime = if last then 0.2 else 0.12,
			})
		end
		task.wait(STORM_TICK)
	end
	CombatState.SetCasting(character, 0.25)
end

--[[
	Tempest Dive (Half-Crown 2): a grab. His hand shoots out; whoever it
	catches he drags straight up into the sky by the collar, then swings
	over them and drives them head-first down into the ground, hard enough
	to bounce them, a tornado forming behind them on the way down (it cuts
	them twice). The timeline is Shared/TempestDive. Landing it charges the
	Full-Crown: twice, and G can be pressed again.
]]
local DIVE_REACH = 0.16

local function tempestDive(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, DIVE_REACH + 0.5)
	if ctx.airborne then
		c.ApplyVelocity(character, HOVER, DIVE_REACH + 0.3)
	end
	fx(ctx, "TempestDive", "Reach")
	task.wait(DIVE_REACH)
	if interrupted(ctx) then
		return
	end
	local target: Model? = nil
	for _, victim in c.Box(character, ctx.root.CFrame * CFrame.new(0, 0, -3.5), Vector3.new(6, 7, 7)) do
		if not CombatState.HasIFrames(victim) and not CombatState.IsRagdolled(victim) then
			target = victim
			break
		end
	end
	local targetRoot = target and rootOf(target)
	if
		not target
		or not targetRoot
		or c.Hit(
				character,
				target,
				{ damage = 2, stun = 3, attackType = "Melee", unblockable = true, noShake = true }
			)
			~= "Hit"
	then
		fx(ctx, "TempestDive", "Whiff")
		CombatState.SetCasting(character, 0.55)
		return
	end

	local plan = DivePlan.Plan(ctx.root.CFrame, targetRoot.Position, floorUnder(ctx, targetRoot.Position).Y)
	local times = DivePlan.Times
	CombatState.SetCasting(character, times.Length + 0.25)
	CombatState.GiveIFrames(character, times.Length + 0.15)
	CombatState.Stun(target, times.Land + 0.6)
	fx(ctx, "TempestDive", "Begin", { target = target, origin = plan.origin, start = plan.start, floorY = plan.floorY })
	local stopHim = c.Cutscene({
		[character] = function(t)
			return DivePlan.Attacker(plan, t)
		end,
	}, times.Length)
	local stopThem = c.Cutscene({
		[target] = function(t)
			return DivePlan.Victim(plan, t)
		end,
	}, times.Land)
	local started = os.clock()
	local function waitUntil(at: number)
		task.wait(math.max(at - (os.clock() - started), 0))
	end
	for _, at in times.Ticks do
		waitUntil(at)
		if CombatState.IsAlive(target) then
			c.Hit(
				character,
				target,
				{ damage = 1.4, stun = 3, attackType = "Melee", unblockable = true, noShake = true }
			)
		end
	end

	-- Into the ground, hard enough to bounce them.
	waitUntil(times.Land)
	stopThem()
	local impact = Vector3.new(plan.start.X, plan.floorY, plan.start.Z)
	if CombatState.IsAlive(target) then
		c.Hit(character, target, {
			damage = 12,
			stun = 1.4,
			attackType = "Melee",
			unblockable = true,
			heavy = true,
			ragdoll = 2,
			velocity = UP * 26 + plan.forward * 8,
		})
		c.ChargeAscension(character, 1)
	end
	fx(ctx, "TempestDive", "Impact", { position = impact })
	c.ShakeArea(impact, 70, 0.7)
	waitUntil(times.Length)
	stopHim()
end

-- Quartile Scutum: four stars in a rectangle in front of him and beams of
-- light between them, a wall that stops anything from the front for 2.5s
-- (even moves that break guards); whoever runs into it in melee is thrown
-- back off the light. He can still walk, slowly, but not attack.
local SCUTUM_TIME = 2.5

local function quartileScutum(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, SCUTUM_TIME)
	if ctx.airborne then
		c.ApplyVelocity(character, HOVER, SCUTUM_TIME)
	end
	local raisedAt = os.clock()
	fx(ctx, "QuartileScutum", "Raise", { duration = SCUTUM_TIME })
	local function inFront(attacker: Model): boolean
		local attackerRoot = rootOf(attacker)
		return attackerRoot ~= nil and c.Flat(attackerRoot.Position - ctx.root.Position):Dot(look(ctx)) > 0.1
	end
	local function absorb(attacker: Model, hit: any)
		local attackerRoot = rootOf(attacker)
		fx(ctx, "QuartileScutum", "Block", { from = if attackerRoot then attackerRoot.Position else nil })
		local close = attackerRoot ~= nil and (attackerRoot.Position - ctx.root.Position).Magnitude < 14
		if close and (hit.attackType or "Melee") == "Melee" and attackerRoot then
			c.Hit(character, attacker, {
				damage = 3,
				stun = 0.6,
				attackType = "Zone",
				unblockable = true,
				velocity = c.Flat(attackerRoot.Position - ctx.root.Position) * 45 + UP * 12,
				velocityTime = 0.18,
			})
		end
		local left = SCUTUM_TIME - (os.clock() - raisedAt)
		if left > 0.05 then
			c.SetCounter(character, left, ALL_TYPES, absorb, inFront)
		end
	end
	c.SetCounter(character, SCUTUM_TIME, ALL_TYPES, absorb, inFront)
	task.wait(SCUTUM_TIME)
	c.ClearCounter(character)
	fx(ctx, "QuartileScutum", "Drop")
end

-- Quartile Hasta: four stars around his outstretched hand, their beams
-- converging into one far bigger: a single, guard-breaking lance of light.
local HASTA_CHARGE = 0.5
local HASTA_LENGTH = 60

local function quartileHasta(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, HASTA_CHARGE + 0.45)
	if airborne then
		c.ApplyVelocity(character, HOVER, HASTA_CHARGE + 0.3)
	end
	fx(ctx, "QuartileHasta", "Stars", { airborne = airborne, duration = HASTA_CHARGE })
	task.wait(HASTA_CHARGE)
	if interrupted(ctx) then
		fx(ctx, "QuartileHasta", "Cancel")
		return
	end
	local origin = ctx.root.Position + look(ctx) * 3 + UP * 0.8
	local direction = aimFrom(ctx, origin, softTarget(ctx, HASTA_LENGTH, 25), 0.4)
	local length = reach(ctx, origin, direction, HASTA_LENGTH)
	fx(ctx, "QuartileHasta", "Fire", { origin = origin, direction = direction, length = length })
	for _, victim in lineVictims(ctx, origin, direction, length, 6) do
		c.Hit(character, victim, {
			damage = 14,
			stun = 1.2,
			attackType = "Bolt",
			guardBreak = true,
			heavy = true,
			ragdoll = 1.3,
			velocity = c.Flat(direction) * 55 + UP * 18,
		})
	end
	c.ShakeArea(origin, 45, 0.4)
	task.wait(0.3)
	CombatState.SetCasting(character, 0.2)
end

---------------------------------------------------------------------------
-- Full-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- Spirit of Notos: the south wind bursts out of him and throws everyone
-- near away; for a moment after, spells thrown at him are blown back at
-- whoever threw them.
local NOTOS_RADIUS = 16
local NOTOS_GUARD = 0.8

local function spiritOfNotos(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, 0.45)
	if ctx.airborne then
		c.ApplyVelocity(character, HOVER, 0.45)
	end
	fx(ctx, "SpiritOfNotos", "Blast", { airborne = ctx.airborne })
	task.wait(0.1)
	for _, victim in c.Sphere(character, ctx.root.Position, NOTOS_RADIUS) do
		local victimRoot = rootOf(victim)
		if victimRoot then
			c.Hit(character, victim, {
				damage = 6,
				stun = 0.9,
				attackType = "Zone",
				heavy = true,
				ragdoll = 1,
				velocity = c.Flat(victimRoot.Position - ctx.root.Position) * 70 + UP * 22,
			})
		end
	end
	local guardFrom = os.clock()
	local function blowBack(attacker: Model)
		local attackerRoot = rootOf(attacker)
		if attackerRoot then
			local origin = ctx.root.Position + UP * 0.6
			local direction = (attackerRoot.Position - origin).Unit
			fx(ctx, "SpiritOfNotos", "Gust", { origin = origin, direction = direction })
			Projectile.Fire({
				owner = character,
				origin = origin + direction * 2,
				direction = direction,
				speed = 120,
				range = 90,
				size = Vector3.new(6, 6, 3),
				onHit = function(victim)
					c.Hit(character, victim, {
						damage = 7,
						stun = 0.9,
						attackType = "Bolt",
						heavy = true,
						velocity = c.Flat(direction) * 45 + UP * 15,
					})
				end,
			})
		end
		local left = NOTOS_GUARD - (os.clock() - guardFrom)
		if left > 0.02 then
			c.SetCounter(character, left, SPELLS, blowBack)
		end
	end
	c.SetCounter(character, NOTOS_GUARD, SPELLS, blowBack)
	c.ShakeArea(ctx.root.Position, 40, 0.35)
end

-- Spirit of Zephyrus (the west wind): he leaps into the sky on a burst of
-- wind; hanging there, wind arrows form one by one in a ring floating
-- round him, then rain down one after another on whoever is nearest
-- below: they keep them pinned, the last one knocks them down. Then he
-- glides back down. From the air he leaps less high.
local ZEPHYRUS_RISE = 0.35
local ZEPHYRUS_GATHER = 0.6
local ZEPHYRUS_ARROWS = 14
local ZEPHYRUS_GAP = 0.06
local ZEPHYRUS_RING = 4.5

-- Where floating arrow i is, `t` seconds after they start forming (the
-- client draws them with the same numbers).
local function floatingArrow(root: BasePart, i: number, t: number): Vector3
	local angle = i / ZEPHYRUS_ARROWS * math.pi * 2 + t * 1.5
	return root.Position
		+ Vector3.new(math.cos(angle) * ZEPHYRUS_RING, 1.2 + math.sin(angle * 2) * 0.6, math.sin(angle) * ZEPHYRUS_RING)
end

local function nearestEnemy(ctx, radius: number): Model?
	local best, bestDistance = nil, math.huge
	for _, victim in ctx.combat.Sphere(ctx.character, ctx.root.Position, radius) do
		local victimRoot = rootOf(victim)
		local distance = if victimRoot then (victimRoot.Position - ctx.root.Position).Magnitude else math.huge
		if distance < bestDistance then
			best, bestDistance = victim, distance
		end
	end
	return best
end

local function spiritOfZephyrus(ctx)
	local c, character = ctx.combat, ctx.character
	local hang = ZEPHYRUS_GATHER + ZEPHYRUS_ARROWS * ZEPHYRUS_GAP
	CombatState.SetCasting(character, ZEPHYRUS_RISE + hang + 0.4)
	fx(ctx, "SpiritOfZephyrus", "Leap", { rise = ZEPHYRUS_RISE })
	c.ApplyVelocity(character, UP * (if ctx.airborne then 30 else 62), ZEPHYRUS_RISE)
	task.wait(ZEPHYRUS_RISE)
	if interrupted(ctx) then
		return
	end
	c.ApplyVelocity(character, HOVER, hang + 0.2)
	fx(ctx, "SpiritOfZephyrus", "Gather", { gather = ZEPHYRUS_GATHER, arrows = ZEPHYRUS_ARROWS })
	local started = os.clock()
	task.wait(ZEPHYRUS_GATHER)
	for i = 1, ZEPHYRUS_ARROWS do
		if interrupted(ctx) then
			fx(ctx, "SpiritOfZephyrus", "Cancel")
			return
		end
		local last = i == ZEPHYRUS_ARROWS
		local target = nearestEnemy(ctx, 55)
		local targetRoot = target and rootOf(target)
		-- The first arrows land round them, closing in.
		local scatter = if last then 0 else 3 * (1 - i / ZEPHYRUS_ARROWS) + 0.5
		local aim = if targetRoot then targetRoot.Position else ctx.root.Position + look(ctx) * 16 - UP * 20
		aim += Vector3.new(math.random(-10, 10) / 10, 0, math.random(-10, 10) / 10) * scatter
		local origin = floatingArrow(ctx.root, i, os.clock() - started)
		local direction = (aim - origin).Unit
		fx(ctx, "SpiritOfZephyrus", "Arrow", { index = i, aim = aim, speed = 160, range = 90, last = last })
		Projectile.Fire({
			owner = character,
			origin = origin,
			direction = direction,
			speed = 160,
			range = 90,
			size = Vector3.new(2, 2, 4),
			onHit = function(victim)
				c.Hit(character, victim, {
					damage = if last then 4 else 1.4,
					stun = if last then 1 else 0.5,
					attackType = "Bolt",
					heavy = last,
					ragdoll = if last then 1.2 else nil,
					velocity = if last then UP * -40 + c.Flat(direction) * 10 else c.Flat(direction) * 3,
					velocityTime = 0.15,
				})
			end,
		})
		task.wait(ZEPHYRUS_GAP)
	end
	c.ApplyVelocity(character, UP * -20 + look(ctx) * 4, 0.5)
	CombatState.SetCasting(character, 0.3)
end

-- Spirit of Euros: a recurve bow of wind, drawn while the wind spirals into
-- the arrow. Loosed, it's too fast to see: everyone along its line is hit
-- at once, through guards and through each other.
local EUROS_DRAW = 0.8
local EUROS_RANGE = 120

local function spiritOfEuros(ctx)
	local c, character = ctx.combat, ctx.character
	local airborne = ctx.airborne
	CombatState.SetCasting(character, EUROS_DRAW + 0.35)
	if airborne then
		c.ApplyVelocity(character, HOVER, EUROS_DRAW + 0.2)
	else
		character:SetAttribute("Rooted", true)
	end
	fx(ctx, "SpiritOfEuros", "Draw", { airborne = airborne, duration = EUROS_DRAW })
	task.wait(EUROS_DRAW)
	character:SetAttribute("Rooted", false)
	if interrupted(ctx) then
		fx(ctx, "SpiritOfEuros", "Cancel")
		return
	end
	local origin = ctx.root.Position + look(ctx) * 2 + UP * 0.8
	local direction = aimFrom(ctx, origin, softTarget(ctx, EUROS_RANGE, 20), 0.3)
	local length = reach(ctx, origin, direction, EUROS_RANGE)
	fx(ctx, "SpiritOfEuros", "Loose", { origin = origin, direction = direction, length = length })
	for _, victim in lineVictims(ctx, origin, direction, length, 3.5) do
		c.Hit(character, victim, {
			damage = 16,
			stun = 1.3,
			attackType = "Bolt",
			unblockable = true,
			heavy = true,
			ragdoll = 1.4,
			velocity = c.Flat(direction) * 70 + UP * 14,
		})
	end
	c.ShakeArea(origin, 40, 0.35)
end

--[[
	Neverland (Full-Crown 4): a cutscene grab. His hand shoots out; whoever
	it catches is caught in the stopped time of the star dome. Three stars
	stand round them and he warps from star to star punching them up through
	the triangle, then hammers them down from above into the ground. The
	timeline is Shared/Neverland, the camera work and effects client side.
	Then the dome lingers over the crater for a few seconds: inside it,
	enemies are slower and weaker and he hits harder.
]]
local NEVERLAND_REACH = 0.15
local NEVERLAND_LINGER = 4
local NEVERLAND_RADIUS = 20

local function neverland(ctx)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, NEVERLAND_REACH + 0.5)
	if ctx.airborne then
		c.ApplyVelocity(character, HOVER, NEVERLAND_REACH + 0.3)
	end
	fx(ctx, "Neverland", "Reach")
	task.wait(NEVERLAND_REACH)
	if interrupted(ctx) then
		return
	end
	local target: Model? = nil
	for _, victim in c.Box(character, ctx.root.CFrame * CFrame.new(0, 0, -3.5), Vector3.new(6, 7, 7)) do
		if not CombatState.HasIFrames(victim) and not CombatState.IsRagdolled(victim) then
			target = victim
			break
		end
	end
	local targetRoot = target and rootOf(target)
	if
		not target
		or not targetRoot
		or c.Hit(
				character,
				target,
				{ damage = 2, stun = 4, attackType = "Melee", unblockable = true, noShake = true }
			)
			~= "Hit"
	then
		fx(ctx, "Neverland", "Whiff")
		CombatState.SetCasting(character, 0.55)
		return
	end

	local plan = NeverlandPlan.Plan(ctx.root.CFrame, targetRoot.Position, floorUnder(ctx, targetRoot.Position).Y)
	local times = NeverlandPlan.Times
	CombatState.SetCasting(character, times.Length + 0.3)
	CombatState.GiveIFrames(character, times.Length + 0.2)
	CombatState.Stun(target, times.Length + 0.6)
	fx(ctx, "Neverland", "Begin", { target = target, origin = plan.origin, start = plan.start, floorY = plan.floorY })
	local stopHim = c.Cutscene({
		[character] = function(t)
			return NeverlandPlan.Attacker(plan, t)
		end,
	}, times.Length)
	local stopThem = c.Cutscene({
		[target] = function(t)
			return NeverlandPlan.Victim(plan, t)
		end,
	}, times.Land)
	local started = os.clock()
	local function waitUntil(at: number)
		task.wait(math.max(at - (os.clock() - started), 0))
	end
	for _, at in times.Strikes do
		waitUntil(at)
		if CombatState.IsAlive(target) then
			c.Hit(character, target, { damage = 2, stun = 3, attackType = "Melee", unblockable = true, noShake = true })
		end
	end

	-- They hit the ground.
	waitUntil(times.Land)
	stopThem()
	local center = Vector3.new(plan.start.X, plan.floorY, plan.start.Z)
	if CombatState.IsAlive(target) then
		c.Hit(character, target, {
			damage = 14,
			stun = 1.4,
			attackType = "Melee",
			unblockable = true,
			heavy = true,
			ragdoll = 2.2,
			velocity = UP * -20 + plan.forward * 4,
		})
	end
	fx(ctx, "Neverland", "Impact", { position = center })
	c.ShakeArea(center, 80, 0.7)
	waitUntil(times.Length)
	stopHim()

	-- The dome lingers over them.
	fx(ctx, "Neverland", "Dome", { center = center, radius = NEVERLAND_RADIUS, duration = NEVERLAND_LINGER })
	local opened = os.clock()
	while os.clock() - opened < NEVERLAND_LINGER and character.Parent do
		local now = os.clock()
		for _, victim in c.Sphere(character, center, NEVERLAND_RADIUS) do
			victim:SetAttribute("WeakUntil", now + 0.4)
			victim:SetAttribute("SlowUntil", now + 0.4)
		end
		if (ctx.root.Position - center).Magnitude <= NEVERLAND_RADIUS then
			character:SetAttribute("PowerUntil", now + 0.4)
		end
		task.wait(0.2)
	end
end

---------------------------------------------------------------------------
-- Move sets
---------------------------------------------------------------------------

Kit.Skills = { windBladesShower, swiftWhiteHawk, heavenlyWindArk, galeWhiteBow }

-- Awakened, the moves follow the stage: Half-Crown, or Full-Crown once he's
-- ascended (the "Ascended" attribute; names and cooldowns in Shared/Kits).
local HALF_CROWN = { spiritStorm, tempestDive, quartileScutum, quartileHasta }
local FULL_CROWN = { spiritOfNotos, spiritOfZephyrus, spiritOfEuros, neverland }
local function stageMove(slot: number): (any) -> ()
	return function(ctx)
		local moves = if ctx.character:GetAttribute("Ascended") == true then FULL_CROWN else HALF_CROWN
		moves[slot](ctx)
	end
end
Kit.AwakenedSkills = { stageMove(1), stageMove(2), stageMove(3), stageMove(4) }

---------------------------------------------------------------------------
-- Half-Crown / Full-Crown Spirit of Zephyr
---------------------------------------------------------------------------

-- The client's Awaken / Ascend animations: wind gathers round him, Sylph
-- merges into him at the burst, and he settles into the new stance. Rooted
-- and untouchable the whole time.
local TRANSFORM_TIME = 1.5
local TRANSFORM_BURST = 0.8

local function transform(ctx, skill: string, radius: number)
	local c, character = ctx.combat, ctx.character
	CombatState.SetCasting(character, TRANSFORM_TIME)
	CombatState.GiveIFrames(character, TRANSFORM_TIME + 0.1)
	character:SetAttribute("Rooted", true)
	fx(ctx, skill, "Start")
	c.ShakeArea(ctx.root.Position, 30, 0.2)
	task.wait(TRANSFORM_BURST)
	if CombatState.IsAlive(character) then
		fx(ctx, skill, "Burst")
		c.ShakeArea(ctx.root.Position, 70, 0.6)
		for _, victim in c.Sphere(character, ctx.root.Position, radius) do
			local victimRoot = rootOf(victim)
			if victimRoot and not CombatState.HasIFrames(victim) and not CombatState.IsRagdolled(victim) then
				c.ApplyVelocity(victim, c.Flat(victimRoot.Position - ctx.root.Position) * 55 + UP * 18, 0.2)
			end
		end
	end
	task.wait(TRANSFORM_TIME - TRANSFORM_BURST)
	if character.Parent then
		character:SetAttribute("Rooted", false)
	end
end

function Kit.Awaken(ctx)
	transform(ctx, "Awaken", 14)
end

function Kit.Ascend(ctx)
	transform(ctx, "Ascend", 18)
end

-- Spawn entrance: wind gathers round him and his grimoire comes down out of
-- the sky to him, Sylph darting round him; he raises a hand, the clover
-- flares and the wind bursts out. Untouchable and rooted while it plays
-- (the animation and effects are client side).
local ENTRANCE_TIME = 2.2

function Kit.Entrance(ctx)
	local character = ctx.character
	CombatState.SetCasting(character, ENTRANCE_TIME)
	CombatState.GiveIFrames(character, ENTRANCE_TIME + 0.1)
	character:SetAttribute("Rooted", true)
	fx(ctx, "Entrance", "Start")
	task.wait(ENTRANCE_TIME)
	if character.Parent then
		character:SetAttribute("Rooted", false)
	end
end

function Kit.AwakenEnd(ctx)
	fx(ctx, "Awaken", "End")
end

function Kit.Unequip(character: Model)
	for _, attribute in { "PowerUntil", "WeakUntil", "SlowUntil", "Rooted" } do
		character:SetAttribute(attribute, nil)
	end
end

return Kit
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Projectile</string>
          <string name="Source"><![CDATA[--[[
	Projectile
	Server-simulated projectiles: moved every frame, swept hitbox between
	frames (fast projectiles can't skip past people), stopped by walls.
	The server only does the hit detection. Clients draw the projectile
	themselves from (origin, direction, speed, range), so nothing is sent
	per frame.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Hitbox = require(script.Parent.Hitbox)

export type Options = {
	owner: Model,
	origin: Vector3,
	direction: Vector3,
	speed: number,
	range: number,
	size: Vector3, -- hitbox: X width, Y height, Z extra length
	pierce: boolean?, -- keep going through people
	onHit: (victim: Model, position: Vector3) -> (),
	onEnd: ((position: Vector3) -> ())?,
}

local Projectile = {}

local function wallParams(owner: Model): RaycastParams
	local ignore: { Instance } = { owner }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	local dummies = workspace:FindFirstChild("Dummies")
	if dummies then
		table.insert(ignore, dummies)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	return params
end

function Projectile.Fire(options: Options)
	local direction = options.direction.Unit
	local position = options.origin
	local travelled = 0
	local alreadyHit: { [Model]: boolean } = {}
	local params = wallParams(options.owner)

	local connection
	local function finish()
		connection:Disconnect()
		if options.onEnd then
			task.spawn(options.onEnd, position)
		end
	end

	connection = RunService.Heartbeat:Connect(function(dt)
		local step = math.min(options.speed * dt, options.range - travelled)
		local wall = workspace:Raycast(position, direction * step, params)
		local nextPosition = if wall then wall.Position else position + direction * step

		-- Sweep the hitbox over everything covered this frame.
		local center = (position + nextPosition) / 2
		local length = (nextPosition - position).Magnitude + options.size.Z
		local box = CFrame.lookAt(center, center + direction)
		for _, victim in Hitbox.Box(options.owner, box, Vector3.new(options.size.X, options.size.Y, length)) do
			if not alreadyHit[victim] then
				alreadyHit[victim] = true
				task.spawn(options.onHit, victim, center)
				if not options.pierce then
					position = center
					finish()
					return
				end
			end
		end

		travelled += step
		position = nextPosition
		if wall or travelled >= options.range then
			finish()
		end
	end)
end

return Projectile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Ragdoll</string>
          <string name="Source"><![CDATA[--[[
	Ragdoll
	Swaps a character's Motor6Ds for BallSocketConstraints so it flops. The
	server takes network ownership while ragdolled so knockback is smooth and
	can't be ignored by the client. Works with R6 and R15.

	Physics tuning:
	  - Per-joint limits so limbs bend like a body, not like rope.
	  - Joint friction damps flailing without making limbs stiff.
	  - No bounce and decent friction, so bodies skid and settle.
	  - Getting up is a short smooth rise instead of a teleport.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local GROUP = "Ragdoll"
if not PhysicsService:IsCollisionGroupRegistered(GROUP) then
	PhysicsService:RegisterCollisionGroup(GROUP)
end
-- Body parts of a ragdoll don't collide with each other (stops jitter at the joints).
PhysicsService:CollisionGroupSetCollidable(GROUP, GROUP, false)

-- The root joint stays a motor so the HumanoidRootPart follows the torso.
local KEEP_JOINTS = {
	RootJoint = true,
	Root = true,
}

type JointSettings = { upper: number, twistLower: number, twistUpper: number, friction: number }

-- Degrees. The cone (upper) is the forward/back swing, twist the sideways
-- swing for limbs (nod for the neck). Friction is a fraction of what it
-- takes to hold the limb up against gravity, so limbs still fall naturally.
local JOINT_SETTINGS: { [string]: JointSettings } = {
	Neck = { upper = 35, twistLower = -30, twistUpper = 30, friction = 15 },
	["Right Shoulder"] = { upper = 100, twistLower = -55, twistUpper = 55, friction = 25 },
	["Left Shoulder"] = { upper = 100, twistLower = -55, twistUpper = 55, friction = 25 },
	["Right Hip"] = { upper = 70, twistLower = -20, twistUpper = 20, friction = 40 },
	["Left Hip"] = { upper = 70, twistLower = -20, twistUpper = 20, friction = 40 },
}
local DEFAULT_SETTINGS: JointSettings = { upper = 60, twistLower = -35, twistUpper = 35, friction = 20 }

-- Density, friction, elasticity, frictionWeight, elasticityWeight. The huge
-- elasticity weight makes "no bounce" win against whatever the floor is.
local BODY_PHYSICS = PhysicalProperties.new(0.9, 0.6, 0, 1, 100)

local GET_UP_TIME = 0.25

type Record = {
	created: { Instance },
	motors: { Motor6D },
	groups: { [BasePart]: string },
	physics: { [BasePart]: PhysicalProperties? },
}

local active: { [Model]: Record } = {}
local gettingUp: { [Model]: RBXScriptConnection } = {}

local Ragdoll = {}

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- Where the character should stand when it gets up: upright, on the
-- ground, facing the way the body was lying.
local function standingCFrame(character: Model, humanoid: Humanoid, root: BasePart): CFrame
	local facing = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if facing.Magnitude < 0.2 then
		-- Lying on its back/front: the head direction is the best guess.
		facing = root.CFrame.UpVector * Vector3.new(1, 0, 1)
	end
	if facing.Magnitude < 0.01 then
		facing = Vector3.new(0, 0, -1)
	end

	local position = root.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local ground = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), params)
	if ground then
		local legLength = if humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else humanoid.HipHeight
		position = Vector3.new(position.X, ground.Position.Y + legLength + root.Size.Y / 2, position.Z)
	end
	return CFrame.lookAt(position, position + facing.Unit)
end

local function cancelGetUp(character: Model)
	local connection = gettingUp[character]
	if connection then
		connection:Disconnect()
		gettingUp[character] = nil
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = false
		end
	end
end

function Ragdoll.IsActive(character: Model): boolean
	return active[character] ~= nil
end

function Ragdoll.Enable(character: Model)
	if active[character] then
		return
	end
	cancelGetUp(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return
	end

	local record: Record = { created = {}, motors = {}, groups = {}, physics = {} }
	active[character] = record
	-- The Neck motor goes off below: without this a player dies on the spot.
	humanoid.RequiresNeck = false

	for _, joint in character:GetDescendants() do
		-- Body joints only: a weapon's grip (Part1 inside the weapon model) stays rigid.
		if
			joint:IsA("Motor6D")
			and not KEEP_JOINTS[joint.Name]
			and joint.Part0
			and joint.Part1
			and joint.Part1.Parent == character
		then
			local settings = JOINT_SETTINGS[joint.Name] or DEFAULT_SETTINGS

			local a0 = Instance.new("Attachment")
			a0.Name = "RagdollAttachment"
			a0.CFrame = joint.C0
			a0.Parent = joint.Part0

			local a1 = Instance.new("Attachment")
			a1.Name = "RagdollAttachment"
			a1.CFrame = joint.C1
			a1.Parent = joint.Part1

			local socket = Instance.new("BallSocketConstraint")
			socket.Name = "RagdollSocket"
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.LimitsEnabled = true
			socket.UpperAngle = settings.upper
			socket.TwistLimitsEnabled = true
			socket.TwistLowerAngle = settings.twistLower
			socket.TwistUpperAngle = settings.twistUpper
			socket.MaxFrictionTorque = settings.friction
			socket.Restitution = 0
			socket.Parent = joint.Parent

			joint.Enabled = false
			table.insert(record.motors, joint)
			table.insert(record.created, a0)
			table.insert(record.created, a1)
			table.insert(record.created, socket)
		end
	end

	-- Limbs normally don't collide, so give each one an invisible collider.
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") then
			record.groups[part] = part.CollisionGroup
			record.physics[part] = part.CustomPhysicalProperties
			part.CollisionGroup = GROUP
			part.CustomPhysicalProperties = BODY_PHYSICS

			if part ~= root then
				local collider = Instance.new("Part")
				collider.Name = "RagdollCollider"
				collider.Size = part.Size * 0.95
				collider.CFrame = part.CFrame
				collider.Transparency = 1
				collider.Massless = true
				collider.CanQuery = false
				collider.CanTouch = false
				collider.CollisionGroup = GROUP
				collider.CustomPhysicalProperties = BODY_PHYSICS

				local weld = Instance.new("Weld")
				weld.Part0 = part
				weld.Part1 = collider
				weld.Parent = collider

				collider.Parent = part
				table.insert(record.created, collider)
			end
		end
	end

	if Players:GetPlayerFromCharacter(character) then
		pcall(root.SetNetworkOwner, root, nil)
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	character:SetAttribute("Ragdolled", true)
end

local function finishGettingUp(character: Model, humanoid: Humanoid, root: BasePart)
	character:SetAttribute("Ragdolled", false)
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		pcall(root.SetNetworkOwner, root, player)
	end
end

-- Ends the ragdoll. By default the body rises smoothly to its feet over a
-- quarter second; `instant` snaps upright (used by the Evasive breakout).
function Ragdoll.Disable(character: Model, instant: boolean?)
	local record = active[character]
	if not record then
		return
	end
	active[character] = nil

	for _, instance in record.created do
		instance:Destroy()
	end
	for _, motor in record.motors do
		if motor.Parent then
			motor.Enabled = true
		end
	end
	for part, group in record.groups do
		if part.Parent then
			part.CollisionGroup = group
			part.CustomPhysicalProperties = record.physics[part]
		end
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		character:SetAttribute("Ragdolled", false)
		return
	end

	local target = standingCFrame(character, humanoid, root)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	if instant then
		root.CFrame = target
		finishGettingUp(character, humanoid, root)
		return
	end

	-- Rise smoothly: the root is held (anchored) and eased from how the
	-- body was lying to standing. Still counts as ragdolled until done, so
	-- people can't be hit while getting up.
	local from = root.CFrame
	local start = os.clock()
	root.Anchored = true
	gettingUp[character] = RunService.Heartbeat:Connect(function()
		local alpha = smooth((os.clock() - start) / GET_UP_TIME)
		if root.Parent then
			root.CFrame = from:Lerp(target, alpha)
		end
		if alpha >= 1 or not root.Parent or humanoid.Health <= 0 then
			gettingUp[character]:Disconnect()
			gettingUp[character] = nil
			root.Anchored = false
			if humanoid.Health > 0 then
				finishGettingUp(character, humanoid, root)
			else
				character:SetAttribute("Ragdolled", false)
			end
		end
	end)
end

-- Drops bookkeeping for a character that was removed from the game.
function Ragdoll.Forget(character: Model)
	active[character] = nil
	local connection = gettingUp[character]
	if connection then
		connection:Disconnect()
		gettingUp[character] = nil
	end
end

return Ragdoll
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="27">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="28">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="29">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client entry point.
]]

local StarterGui = game:GetService("StarterGui")

local CameraShake = require(script.CameraShake)
local HUD = require(script.HUD)
local Input = require(script.Input)
local Moves = require(script.Moves)
local ShiftLock = require(script.ShiftLock)
local TopBar = require(script.TopBar)
local VFX = require(script.VFX)

-- Our HUD replaces the default health bar.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

CameraShake.Start()
VFX.Start()
Moves.Start()
HUD.Start()
Input.Start()
ShiftLock.Start()
TopBar.Start()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CameraShake</string>
            <string name="Source"><![CDATA[--[[
	CameraShake
	Trauma-based shake: hits add trauma, trauma decays, and the shake is
	trauma squared so small hits stay subtle and big hits really kick.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local MAX_ANGLE = 4 -- degrees at full trauma (math.noise is roughly -0.5..0.5)
local DECAY = 1.8 -- trauma lost per second
local FREQUENCY = 25
local BASE_FOV = 70

local CameraShake = {}

local trauma = 0
local seed = math.random() * 1000

function CameraShake.Add(amount: number)
	trauma = math.clamp(trauma + amount, 0, 1)
end

-- Quick field-of-view punch for dashes and heavy hits.
function CameraShake.FovKick(amount: number)
	local camera = workspace.CurrentCamera
	camera.FieldOfView = BASE_FOV + amount
	TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		FieldOfView = BASE_FOV,
	}):Play()
end

function CameraShake.Start()
	Remotes.CameraShake.OnClientEvent:Connect(function(intensity)
		if type(intensity) == "number" then
			CameraShake.Add(intensity)
		end
	end)

	RunService:BindToRenderStep("CloverCameraShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if trauma <= 0 then
			return
		end
		trauma = math.max(0, trauma - dt * DECAY)
		local amount = trauma * trauma * MAX_ANGLE
		local t = os.clock() * FREQUENCY
		local camera = workspace.CurrentCamera
		camera.CFrame = camera.CFrame
			* CFrame.Angles(
				math.rad(math.noise(seed, t) * amount),
				math.rad(math.noise(seed + 10, t) * amount),
				math.rad(math.noise(seed + 20, t) * amount * 0.5)
			)
	end)
end

return CameraShake
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Cinematic</string>
            <string name="Source"><![CDATA[--[[
	Cinematic
	Tools for cutscenes (e.g. Asta's Black Moon):
	  Cinematic.Camera(shot, length)  a scripted camera for the people in the
	      cutscene: letterbox bars slide in, the HUD hides, shift lock lets
	      go, and shot(t) places the camera every frame. Returns finish().
	  Cinematic.Night(fadeIn)  night falls: the sky turns to midnight, the
	      light goes cold and dim. Returns lift(fadeOut). Nested nights are
	      counted, so overlapping cutscenes don't fight over the lighting.
	Both always put everything back, even if the cutscene is cut short.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer

local BASE_FOV = 70 -- same as CameraShake
local BAR_HEIGHT = 0.11 -- letterbox bars, fraction of the screen each

local Cinematic = {}

local function tween(instance: Instance, duration: number, goals: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		goals
	)
	t:Play()
	return t
end

---------------------------------------------------------------------------
-- Camera
---------------------------------------------------------------------------

function Cinematic.Camera(shot: (number) -> (CFrame?, number?), length: number): () -> ()
	local camera = workspace.CurrentCamera
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	local character = localPlayer.Character

	-- Everything else on screen goes away.
	local hidden: { ScreenGui } = {}
	if playerGui then
		for _, gui in playerGui:GetChildren() do
			if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "Cinematic" then
				gui.Enabled = false
				table.insert(hidden, gui)
			end
		end
	end

	local bars = Instance.new("ScreenGui")
	bars.Name = "Cinematic"
	bars.IgnoreGuiInset = true
	bars.DisplayOrder = 50
	bars.ResetOnSpawn = false
	bars.Parent = playerGui
	local function bar(edge: number): Frame
		local frame = Instance.new("Frame")
		frame.BackgroundColor3 = Color3.new(0, 0, 0)
		frame.BorderSizePixel = 0
		frame.AnchorPoint = Vector2.new(0, edge)
		frame.Position = UDim2.fromScale(0, edge)
		frame.Size = UDim2.fromScale(1, 0)
		frame.Parent = bars
		tween(frame, 0.35, { Size = UDim2.fromScale(1, BAR_HEIGHT) })
		return frame
	end
	local top, bottom = bar(0), bar(1)

	if character then
		character:SetAttribute("Cinematic", true)
	end
	camera.CameraType = Enum.CameraType.Scriptable

	local start = os.clock()
	local finished = false
	local function finish()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("CloverCinematic")
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = BASE_FOV
		if character then
			character:SetAttribute("Cinematic", nil)
		end
		tween(top, 0.3, { Size = UDim2.fromScale(1, 0) })
		tween(bottom, 0.3, { Size = UDim2.fromScale(1, 0) })
		task.delay(0.32, function()
			bars:Destroy()
			for _, gui in hidden do
				if gui.Parent then
					gui.Enabled = true
				end
			end
		end)
	end

	-- At camera priority, so CameraShake (just after) still shakes it.
	RunService:BindToRenderStep("CloverCinematic", Enum.RenderPriority.Camera.Value, function()
		local t = os.clock() - start
		if t > length then
			finish()
			return
		end
		local ok, cframe, fov = pcall(shot, t)
		if not ok then
			finish()
			return
		end
		if cframe then
			camera.CFrame = cframe
		end
		if fov then
			camera.FieldOfView = fov
		end
	end)
	task.delay(length + 1, finish) -- whatever happens, give the camera back
	return finish
end

---------------------------------------------------------------------------
-- Night
---------------------------------------------------------------------------

local nights = 0
-- The daylight to go back to. Kept until the fade back has finished, so a
-- night that starts mid-fade doesn't take the half-dark sky for daylight.
local saved: { [string]: any }? = nil
local grade: ColorCorrectionEffect? = nil
local generation = 0 -- bumped whenever a night starts or lifts

-- Moonlit rather than pitch black: dark sky, but you can still read the fight.
local NIGHT_LIGHTING = {
	ClockTime = 23.8,
	Brightness = 2,
	Ambient = Color3.fromRGB(72, 72, 98),
	OutdoorAmbient = Color3.fromRGB(106, 110, 148),
	ExposureCompensation = 0.3,
}

function Cinematic.Night(fadeIn: number): (fadeOut: number?) -> ()
	nights += 1
	if nights == 1 then
		generation += 1
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if not saved then
			local before: { [string]: any } = {
				ClockTime = Lighting.ClockTime,
				Brightness = Lighting.Brightness,
				Ambient = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
				ExposureCompensation = Lighting.ExposureCompensation,
			}
			if atmosphere then
				before.atmosphere = { Density = atmosphere.Density, Haze = atmosphere.Haze, Color = atmosphere.Color }
			end
			saved = before
		end
		if atmosphere then
			-- A clear night: the moon shouldn't fade into the haze.
			tween(atmosphere, fadeIn, { Density = 0.06, Haze = 0, Color = Color3.fromRGB(82, 90, 132) })
		end
		tween(Lighting, fadeIn, NIGHT_LIGHTING, Enum.EasingStyle.Sine)
		-- Still fading out from the last night? Bring the same grade back.
		local effect = if grade and grade.Parent then grade else Instance.new("ColorCorrectionEffect")
		effect.Name = "CinematicNight"
		effect.Parent = Lighting
		tween(effect, fadeIn, {
			Saturation = -0.2,
			Contrast = 0.1,
			Brightness = 0.07,
			TintColor = Color3.fromRGB(224, 230, 255),
		}, Enum.EasingStyle.Sine)
		grade = effect
	end

	local lifted = false
	return function(fadeOut: number?)
		if lifted then
			return
		end
		lifted = true
		nights -= 1
		if nights > 0 or not saved then
			return
		end
		local duration = fadeOut or 1
		local before = saved
		generation += 1
		local lifting = generation
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere and before.atmosphere then
			tween(atmosphere, duration, before.atmosphere)
		end
		local restore = table.clone(before)
		restore.atmosphere = nil
		tween(Lighting, duration, restore, Enum.EasingStyle.Sine)
		local effect = grade
		if effect then
			tween(effect, duration, { Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1) })
		end
		task.delay(duration + 0.05, function()
			if generation ~= lifting then
				return -- another night fell before this one finished lifting
			end
			saved = nil
			if effect then
				effect:Destroy()
			end
			if grade == effect then
				grade = nil
			end
		end)
	end
end

return Cinematic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[
	HUD
	Top right (in the top bar): small health bar; under it the Evasive bar
	           and, beside that, a tiny bar for R (the special's cooldown).
	Bottom:    awakening bar over the move icons (skills 1-4) with cooldowns.
	Right:     combo counter.
	Top:       toast messages from the server.
	Built in code so it can be restyled without touching Studio.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatState = require(Shared.CombatState)
local Config = require(Shared.Config)
local Kits = require(Shared.Kits)
local Remotes = require(Shared.Remotes)

local localPlayer = Players.LocalPlayer

local COLORS = {
	Panel = Color3.fromRGB(0, 0, 0),
	Back = Color3.fromRGB(40, 40, 46),
	Health = Color3.fromRGB(90, 220, 110),
	HealthLow = Color3.fromRGB(230, 60, 60),
	Evasive = Color3.fromRGB(120, 235, 255),
	Awakening = Color3.fromRGB(220, 40, 50),
	Special = Color3.fromRGB(255, 205, 110),
	SpecialCharging = Color3.fromRGB(150, 125, 85),
	Text = Color3.fromRGB(240, 240, 240),
	SubText = Color3.fromRGB(170, 170, 180),
	Locked = Color3.fromRGB(60, 60, 68),
}

local COMBO_TIMEOUT = 1.6
local SLOT_SIZE = 54
local SLOT_GAP = 6
local STATUS_WIDTH = 206
local SPECIAL_WIDTH = 40 -- the R bar

type Slot = {
	frame: Frame,
	stroke: UIStroke,
	name: TextLabel,
	overlay: Frame,
	timer: TextLabel,
}

local HUD = {}

local ui: {
	healthFill: Frame,
	healthText: TextLabel,
	evasiveFill: Frame,
	evasiveStroke: UIStroke,
	special: Frame,
	specialFill: Frame,
	specialKey: TextLabel,
	awakening: Frame,
	awakeningFill: Frame,
	awakeningStroke: UIStroke,
	awakeningLabel: TextLabel,
	skills: { Slot },
	comboLabel: TextLabel,
	comboScale: UIScale,
	toast: TextLabel,
} =
	{} :: any

local comboCount = 0
local lastComboHit = 0
local shownHealth = 1
local shownKit: string? = "?"
local shownAwakened = false
local shownSword: string? = nil
local shownAscended = false
local awakeningColor = COLORS.Awakening
local toastToken = 0

local function corner(parent: Instance, radius: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = COLORS.Text
	l.TextStrokeTransparency = 0.6
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

local function bar(parent: Instance, position: UDim2, size: UDim2, color: Color3): (Frame, Frame)
	local back = Instance.new("Frame")
	back.Position = position
	back.Size = size
	back.BackgroundColor3 = COLORS.Back
	back.BorderSizePixel = 0
	back.Parent = parent
	corner(back, UDim.new(1, 0))

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	corner(fill, UDim.new(1, 0))

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170))
	gradient.Rotation = 90
	gradient.Parent = fill

	return back, fill
end

local function slot(parent: Instance, key: string, order: number): Slot
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE)
	frame.BackgroundColor3 = COLORS.Panel
	frame.BackgroundTransparency = 0.35
	frame.LayoutOrder = order
	frame.ClipsDescendants = true
	frame.Parent = parent
	corner(frame, UDim.new(0, 7))

	local stroke = Instance.new("UIStroke")
	stroke.Color = COLORS.Locked
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame

	label(frame, {
		Text = key,
		Font = Enum.Font.GothamBlack,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(5, 3),
		Size = UDim2.fromOffset(14, 12),
		ZIndex = 4,
	})

	local name = label(frame, {
		Text = "",
		TextWrapped = true,
		TextSize = 10,
		Position = UDim2.new(0, 3, 0, 14),
		Size = UDim2.new(1, -6, 1, -16),
		ZIndex = 4,
	})

	-- Dark curtain that shrinks as the cooldown finishes.
	local overlay = Instance.new("Frame")
	overlay.AnchorPoint = Vector2.new(0, 1)
	overlay.Position = UDim2.fromScale(0, 1)
	overlay.Size = UDim2.fromScale(1, 0)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 0.35
	overlay.BorderSizePixel = 0
	overlay.ZIndex = 2
	overlay.Parent = frame

	local timer = label(frame, {
		Text = "",
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
		TextStrokeTransparency = 0.2,
	})

	return { frame = frame, stroke = stroke, name = name, overlay = overlay, timer = timer }
end

local function setSlotCooldown(s: Slot, remaining: number, length: number)
	s.overlay.Size = UDim2.fromScale(1, math.clamp(remaining / math.max(length, 0.01), 0, 1))
	s.timer.Text = if remaining > 0 then string.format(if remaining < 10 then "%.1f" else "%d", remaining) else ""
	s.name.TextTransparency = if remaining > 0 then 0.6 else 0
end

local function buildStatus(playerGui: Instance)
	-- Lives in the top right corner of the screen, at the same height as
	-- Roblox's top bar buttons.
	local gui = Instance.new("ScreenGui")
	gui.Name = "Status"
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.Parent = playerGui

	local area = Instance.new("Frame")
	area.BackgroundTransparency = 1
	area.Size = UDim2.fromScale(1, 1)
	area.Parent = gui

	local panel = Instance.new("Frame")
	panel.Name = "Bars"
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.BackgroundColor3 = COLORS.Panel
	panel.BackgroundTransparency = 0.3
	panel.Parent = area
	corner(panel, UDim.new(0, 10))

	local healthBack
	healthBack, ui.healthFill = bar(panel, UDim2.new(0, 8, 0.5, -10), UDim2.new(1, -16, 0, 13), COLORS.Health)
	ui.healthText = label(healthBack, {
		TextSize = 10,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		TextStrokeTransparency = 0.4,
	})

	local evasiveBack
	evasiveBack, ui.evasiveFill =
		bar(panel, UDim2.new(0, 8, 0.5, 6), UDim2.new(1, -36 - SPECIAL_WIDTH, 0, 4), COLORS.Evasive)

	-- R (the special) as a tiny bar at the end of the row: fills back up
	-- while it's on cooldown, bright when it's ready.
	ui.special, ui.specialFill =
		bar(panel, UDim2.new(1, -8 - SPECIAL_WIDTH, 0.5, 6), UDim2.fromOffset(SPECIAL_WIDTH, 4), COLORS.Special)
	ui.specialKey = label(ui.special, {
		Text = "R",
		TextSize = 9,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0, -3, 0.5, 0),
		Size = UDim2.fromOffset(8, 10),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	ui.evasiveStroke = Instance.new("UIStroke")
	ui.evasiveStroke.Color = COLORS.Evasive
	ui.evasiveStroke.Thickness = 1.5
	ui.evasiveStroke.Transparency = 1
	ui.evasiveStroke.Parent = evasiveBack

	-- Same vertical placement as the top bar buttons (see TopBar).
	local function align()
		local barHeight = GuiService.TopbarInset.Height
		if barHeight <= 0 then
			barHeight = 58
		end
		local height = math.clamp(barHeight - 14, 28, 44)
		panel.Size = UDim2.fromOffset(STATUS_WIDTH, height)
		panel.Position = UDim2.new(1, -16, 0, math.max(barHeight - height - 2, 0))
	end
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(align)
	align()
end

local function buildMoves(gui: ScreenGui)
	-- Skills 1-4.
	local width = 4 * SLOT_SIZE + 3 * SLOT_GAP

	local holder = Instance.new("Frame")
	holder.Name = "Moves"
	holder.AnchorPoint = Vector2.new(0.5, 1)
	holder.Position = UDim2.new(0.5, 0, 1, -14)
	holder.Size = UDim2.fromOffset(width, SLOT_SIZE + 24)
	holder.BackgroundTransparency = 1
	holder.Parent = gui

	-- Awakening bar over the moves, with the key and the form's name.
	ui.awakening = Instance.new("Frame")
	ui.awakening.BackgroundTransparency = 1
	ui.awakening.Size = UDim2.new(1, 0, 0, 18)
	ui.awakening.Parent = holder

	ui.awakeningLabel = label(ui.awakening, {
		Text = "",
		TextSize = 10,
		TextColor3 = COLORS.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 10),
	})
	local awakeningBack
	awakeningBack, ui.awakeningFill =
		bar(ui.awakening, UDim2.fromOffset(0, 12), UDim2.new(1, 0, 0, 5), COLORS.Awakening)
	ui.awakeningStroke = Instance.new("UIStroke")
	ui.awakeningStroke.Color = COLORS.Awakening
	ui.awakeningStroke.Thickness = 1.5
	ui.awakeningStroke.Transparency = 1
	ui.awakeningStroke.Parent = awakeningBack

	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.AnchorPoint = Vector2.new(0, 1)
	row.Position = UDim2.fromScale(0, 1)
	row.Size = UDim2.new(1, 0, 0, SLOT_SIZE)
	row.Parent = holder

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, SLOT_GAP)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row

	ui.skills = {}
	for i = 1, CombatState.SkillSlots do
		ui.skills[i] = slot(row, tostring(i), i)
	end
end

local function build()
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "CombatHUD"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	buildStatus(playerGui)
	buildMoves(gui)

	ui.comboLabel = label(gui, {
		Name = "Combo",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -40, 0.45, 0),
		Size = UDim2.fromOffset(260, 70),
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Rotation = -6,
	})
	ui.comboScale = Instance.new("UIScale")
	ui.comboScale.Parent = ui.comboLabel

	ui.toast = label(gui, {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 20),
		Size = UDim2.fromOffset(600, 30),
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
end

-- Kit-dependent labels (skill names, colors) only change on switch/awaken.
local function refreshKit(character: Model?)
	local kitId = if character then character:GetAttribute("Kit") :: string? else nil
	local awakened = character ~= nil and CombatState.IsAwakened(character)
	local sword = if character then character:GetAttribute("Sword") :: string? else nil
	local ascended = character ~= nil and character:GetAttribute("Ascended") == true
	if kitId == shownKit and awakened == shownAwakened and sword == shownSword and ascended == shownAscended then
		return
	end
	shownKit = kitId
	shownAwakened = awakened
	shownSword = sword
	shownAscended = ascended
	local kit = Kits.Get(kitId)
	local skills = if character then Kits.SkillsOf(character) else {}

	for i, s in ui.skills do
		local skill = skills[i]
		s.name.Text = if skill then skill.name else ""
		s.stroke.Color = if skill and kit then kit.color else COLORS.Locked
		s.frame.BackgroundTransparency = if skill then 0.35 else 0.7
	end
	local awakening = kit and kit.awakening
	ui.awakening.Visible = awakening ~= nil
	awakeningColor = if kit then kit.color else COLORS.Awakening
	ui.awakeningFill.BackgroundColor3 = awakeningColor
	ui.awakeningStroke.Color = awakeningColor
	ui.special.Visible = kit ~= nil and (kit.special ~= nil or kit.awakenedSpecial ~= nil)
	ui.awakeningLabel.Text = if awakening then "[G]  " .. string.upper(awakening.name) else ""
end

local function onHitConfirm(data)
	if type(data) ~= "table" or not data.hitConfirm or data.attacker ~= localPlayer.Character then
		return
	end
	local t = os.clock()
	comboCount = if t - lastComboHit < COMBO_TIMEOUT then comboCount + 1 else 1
	lastComboHit = t

	ui.comboLabel.Text = comboCount .. " HIT" .. (if comboCount == 1 then "" else "S")
	ui.comboLabel.TextTransparency = 0
	ui.comboLabel.TextStrokeTransparency = 0
	ui.comboScale.Scale = 1.5
	TweenService:Create(ui.comboScale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local function update(dt: number)
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	refreshKit(character)

	if character and humanoid then
		local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
		shownHealth += (ratio - shownHealth) * math.min(dt * 12, 1)
		ui.healthFill.Size = UDim2.fromScale(shownHealth, 1)
		ui.healthFill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.Health, ratio)
		ui.healthText.Text = tostring(math.ceil(humanoid.Health))

		local pulse = 0.3 + 0.4 * math.sin(os.clock() * 8)

		local evasive = math.clamp((tonumber(character:GetAttribute("Evasive")) or 0) / Config.Evasive.Max, 0, 1)
		ui.evasiveFill.Size = UDim2.fromScale(evasive, 1)
		ui.evasiveStroke.Transparency = if evasive >= 1 then pulse else 1

		local awakening = math.clamp((tonumber(character:GetAttribute("Awakening")) or 0) / Config.Awakening.Max, 0, 1)
		local awakened = CombatState.IsAwakened(character)
		ui.awakeningFill.Size = UDim2.fromScale(awakening, 1)
		ui.awakeningStroke.Transparency = if awakening >= 1 or awakened then pulse else 1
		ui.awakeningLabel.TextColor3 = if awakening >= 1 or awakened then awakeningColor else COLORS.SubText

		-- A second stage (Yuno's Full-Crown): how close it is, then G again.
		local kit = Kits.Of(character)
		local ascension = kit and kit.ascension
		if kit and ascension and kit.awakening then
			local first, second = string.upper(kit.awakening.name), string.upper(ascension.name)
			local text = "[G]  " .. first
			if awakened and character:GetAttribute("Ascended") == true then
				text = second
			elseif awakened then
				local value = tonumber(character:GetAttribute("Ascension")) or 0
				local progress = if ascension.chargeByKit
					then math.floor(value) .. "/" .. ascension.charge
					else math.floor(math.clamp(value / ascension.charge, 0, 1) * 100) .. "%"
				text = if value >= ascension.charge
					then "[G]  " .. second
					else first .. "   ·   " .. second .. " " .. progress
			end
			ui.awakeningLabel.Text = text
		end

		for i, s in ui.skills do
			setSlotCooldown(s, CombatState.Cooldown(character, i))
		end

		local remaining, length = CombatState.Cooldown(character, CombatState.SpecialSlot)
		local ready = remaining <= 0
		ui.specialFill.Size = UDim2.fromScale(if ready then 1 else math.clamp(1 - remaining / length, 0, 1), 1)
		ui.specialFill.BackgroundColor3 = if ready then COLORS.Special else COLORS.SpecialCharging
		ui.specialKey.TextColor3 = if ready then COLORS.Text else COLORS.SubText
	end

	if comboCount > 0 and os.clock() - lastComboHit > COMBO_TIMEOUT then
		comboCount = 0
		TweenService:Create(ui.comboLabel, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 })
			:Play()
	end
end

-- Short message at the top of the screen.
function HUD.Toast(text: string, color: Color3?)
	toastToken += 1
	local token = toastToken
	ui.toast.Text = text
	ui.toast.TextColor3 = color or COLORS.Text
	ui.toast.TextTransparency = 0
	ui.toast.TextStrokeTransparency = 0.3
	task.delay(2.2, function()
		if toastToken == token then
			TweenService:Create(ui.toast, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 })
				:Play()
		end
	end)
end

function HUD.Start()
	build()
	Remotes.VFX.OnClientEvent:Connect(function(_, data)
		onHitConfirm(data)
	end)
	Remotes.Notify.OnClientEvent:Connect(function(text, color)
		if type(text) == "string" then
			HUD.Toast(text, if typeof(color) == "Color3" then color else nil)
		end
	end)
	RunService.RenderStepped:Connect(update)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--[[
	Input
	Keyboard / mouse / gamepad / touch controls.
	  M1 (click, hold to chain)   basic attack, hold Space on the 4th hit to uppercut
	  Q                           dash in your movement direction (Evasive when stunned)
	  F (hold)                    block, press right before a hit to perfect block
	  1-4                         character skills (sent even on cooldown: some skills
	                              read follow-up presses, like timing Black Divider)
	  R                           the character's special (also sent on cooldown)
	  G                           awaken when the meter is full
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CombatState = require(Shared.CombatState)
local Impulse = require(Shared.Impulse)
local Kits = require(Shared.Kits)
local Remotes = require(Shared.Remotes)

local CameraShake = require(script.Parent.CameraShake)
local Moves = require(script.Parent.Moves)
local VFX = require(script.Parent.VFX)

local localPlayer = Players.LocalPlayer

local DASH_VECTORS = {
	Front = Vector3.new(0, 0, -1),
	Back = Vector3.new(0, 0, 1),
	Left = Vector3.new(-1, 0, 0),
	Right = Vector3.new(1, 0, 0),
}

local BLOCK_RETRY = 0.12

local Input = {}

local m1Held = false
local blockHeld = false
local lastBlockSent = 0
local dashReadyAt = 0 -- front and back
-- The front dash's push while it lasts: an M1 cuts it short.
local frontDash: Instance? = nil
-- Extra jumps in the air (Kits airJumps), used since leaving the ground.
local airJumpsUsed = 0
local jumpReleasedInAir = false
local sideDashReadyAt = 0 -- left and right: their own, shorter cooldown

-- Mirror of the server's combo counter so our animation plays instantly.
-- The server still decides what actually hits.
local predictedCombo = 0
local lastM1 = 0
local nextM1 = 0
-- Jumping is locked while swinging. The server enforces it too (JumpHeight 0),
-- but locking it here as well means there's no ping delay.
local noJumpUntil = 0
-- The uppercut is thrown with Space held: that same press mustn't then jump
-- you up after them. Jumping waits until Space has been let go.
local jumpNeedsRelease = false
-- Space already held when the 3rd hit lands: they're lining up the uppercut,
-- so stay on the ground for the 4th (until it's thrown, the string runs out,
-- or Space is let go: a fresh press then jumps, for the downslam).
local uppercutPrimedUntil = 0
local jumpEnabled = true

local function getCharacter(): (Model?, Humanoid?, BasePart?)
	local character = localPlayer.Character
	if not character or not CombatState.IsAlive(character) then
		return nil, nil, nil
	end
	return character,
		character:FindFirstChildOfClass("Humanoid"),
		character:FindFirstChild("HumanoidRootPart") :: BasePart
end

-- Camera yaw only, so "forward" means where you're looking, flat on the ground.
local function cameraBasis(): CFrame
	local look = workspace.CurrentCamera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(Vector3.zero, flat.Unit)
end

local function dashDirection(humanoid: Humanoid): string
	local move = humanoid.MoveDirection
	if move.Magnitude < 0.1 then
		return "Front"
	end
	local relative = cameraBasis():VectorToObjectSpace(move)
	if math.abs(relative.X) > math.abs(relative.Z) then
		return if relative.X > 0 then "Right" else "Left"
	end
	return if relative.Z > 0 then "Back" else "Front"
end

local function jumpHeld(humanoid: Humanoid): boolean
	return UserInputService:IsKeyDown(Enum.KeyCode.Space)
		or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
		or humanoid.Jump
end

local lastJumpRequest = 0

-- In the air, from our own physics (exact; the server sees us a ping
-- late). A jump pressed this very frame counts too: it only lifts off on
-- the next physics step.
local function airborne(): boolean
	local _, humanoid = getCharacter()
	if not humanoid then
		return false
	end
	if humanoid.FloorMaterial == Enum.Material.Air then
		return true
	end
	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then
		return true
	end
	return jumpEnabled and humanoid.JumpHeight > 0 and os.clock() - lastJumpRequest < 0.06
end

-- The server's hover or dive for an air move reaches us a round trip late,
-- and a jump only lasts ~0.4s, so hold still where the key was pressed
-- until it arrives. Same "Knockback" name as Remotes.Impulse, so the real
-- impulse replaces it. Only for moves that are ready (a rejected press or a
-- follow-up tap, like timing Black Divider, never freezes you).
local AIR_HOLD = Vector3.new(0, 0.05, 0)
local AIR_HOLD_TIME = 0.4

local function holdInAir(slot: number, airHold: boolean?)
	local character, _, root = getCharacter()
	if not character or not root or not airHold then
		return
	end
	if not CombatState.CanAct(character) or CombatState.IsCasting(character) then
		return
	end
	if CombatState.Cooldown(character, slot) > 0.1 then
		return
	end
	Impulse.Apply(root, AIR_HOLD, AIR_HOLD_TIME, "Knockback")
end

local function tryM1()
	local character, humanoid, root = getCharacter()
	if not character or not humanoid or not root then
		return
	end
	if
		not CombatState.CanAct(character)
		or CombatState.IsBlocking(character)
		or CombatState.IsCasting(character)
		or character:GetAttribute("SwordAway") == true -- thrown (Slayer Recall)
	then
		return
	end
	local t = os.clock()
	if t < nextM1 then
		return
	end
	-- An M1 during a front dash cuts the dash short and swings out of it.
	if frontDash then
		if frontDash.Parent then
			frontDash:Destroy()
		end
		frontDash = nil
	end
	if t - lastM1 > Config.M1.ResetTime then
		predictedCombo = 0
	end
	predictedCombo += 1
	lastM1 = t

	local index = predictedCombo
	local inAir = humanoid.FloorMaterial == Enum.Material.Air
	-- Jump only means uppercut on the ground; in the air it's the downslam.
	local jump = not inAir and jumpHeld(humanoid)
	local variant = "Normal"
	if index >= Config.M1.ComboLength then
		predictedCombo = 0
		uppercutPrimedUntil = 0
		nextM1 = t + Config.M1.EndLag
		noJumpUntil = t + Config.M1.FinisherBusy
		if inAir then
			variant = "Downslam"
		elseif jump then
			-- A launcher: back in action quickly, and free to jump after them.
			variant = "Uppercut"
			nextM1 = t + Config.M1.UppercutEndLag
			noJumpUntil = t + Config.M1.UppercutJumpAfter
			jumpNeedsRelease = true
		else
			variant = "Knockback"
		end
	else
		nextM1 = t + Config.M1.SwingCooldown
		noJumpUntil = t + (if index == Config.M1.ComboLength - 1 then Config.M1.DownslamJumpAfter else Config.M1.Busy)
		-- Jumping after the 3rd hit is the downslam (3 hits, jump, hit). But
		-- Space already held here means the uppercut is coming: no hop.
		if index == Config.M1.ComboLength - 1 and jumpHeld(humanoid) then
			uppercutPrimedUntil = t + Config.M1.ResetTime
		end
	end

	-- Our count of the string goes along, so the server's swing is the one we see.
	Remotes.Action:FireServer("M1", { jump = jump, airborne = inAir, index = index })
	Moves.PlayM1(character, index, variant)

	-- Step into the swing a little so strings stay connected.
	local look = root.CFrame.LookVector
	local forward = Vector3.new(look.X, 0, look.Z).Unit
	Impulse.Apply(root, forward * Config.M1.LungeSpeed, Config.M1.LungeTime, "Lunge", 0.6)
end

-- Someone right in front, for a front dash to stop at.
local function enemyAhead(character: Model, root: BasePart): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	for _, part in workspace:GetPartBoundsInBox(root.CFrame * CFrame.new(0, 0, -3), Vector3.new(4.5, 5, 4), params) do
		local model = part:FindFirstAncestorWhichIsA("Model")
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and model ~= character then
			return true
		end
	end
	return false
end

local function performDash(direction: string)
	local character, _, root = getCharacter()
	if not character or not root then
		return
	end
	local speed = Config.Dash.Speed[direction]
	local localVector = DASH_VECTORS[direction]
	local basis = cameraBasis()
	-- Side dashes are a quicker, smaller hop.
	local duration = if direction == "Left" or direction == "Right"
		then Config.Dash.SideDuration
		else Config.Dash.Duration
	local mover = Impulse.Apply(root, basis:VectorToWorldSpace(localVector) * speed, duration, "Dash")
	if direction == "Front" then
		frontDash = mover.Parent
	end

	-- Front dash steers with the camera, side and back dashes keep their line.
	local start = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not mover.Parent then
			connection:Disconnect()
			return
		end
		if direction == "Front" then
			basis = cameraBasis()
			-- Every front dash goes into an M1: reaching someone, it stops
			-- and swings at them.
			if enemyAhead(character, root) then
				connection:Disconnect()
				if mover.Parent then
					mover.Parent:Destroy()
				end
				frontDash = nil
				tryM1()
				return
			end
		end
		local alpha = (os.clock() - start) / duration
		mover.VectorVelocity = basis:VectorToWorldSpace(localVector) * speed * (1 - alpha * 0.4)
	end)

	VFX.Play("Dash", { character = character, direction = direction })
	CameraShake.FovKick(6)
end

local function tryDash()
	local character, humanoid = getCharacter()
	if not character or not humanoid then
		return
	end

	-- While stunned or ragdolled, Q is the Evasive breakout instead.
	if CombatState.IsStunned(character) or CombatState.IsRagdolled(character) then
		if (tonumber(character:GetAttribute("Evasive")) or 0) >= Config.Evasive.Max then
			Remotes.Action:FireServer("Evasive")
		end
		return
	end

	if CombatState.IsCasting(character) then
		return
	end
	local direction = dashDirection(humanoid)
	local side = direction == "Left" or direction == "Right"
	local t = os.clock()
	if t < (if side then sideDashReadyAt else dashReadyAt) then
		return
	end
	local kit = Kits.Of(character)
	local awakening = kit and CombatState.IsAwakened(character) and kit.awakening
	local multiplier = if awakening then awakening.cooldownMultiplier else 1
	if side then
		sideDashReadyAt = t + Config.Dash.SideCooldown * multiplier
	else
		dashReadyAt = t + Config.Dash.Cooldown * multiplier
	end

	Remotes.Action:FireServer("Dash", direction)
	performDash(direction)
end

-- A steerable push from a skill (Bull Thrust): it turns toward where you're
-- heading (movement keys, or the camera when none are held) at up to
-- `turnRate` degrees per second, keeping its speed, and you face the way
-- you're going. Shift lock lets go of your facing meanwhile.
local function steerImpulse(
	mover: LinearVelocity,
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	turnRate: number
)
	local autoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false
	character:SetAttribute("Steering", true)
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		if not mover.Parent or not root.Parent then
			connection:Disconnect()
			character:SetAttribute("Steering", nil)
			humanoid.AutoRotate = autoRotate
			return
		end
		local velocity = mover.VectorVelocity
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		local speed = flat.Magnitude
		if speed < 1 then
			return
		end
		local want = humanoid.MoveDirection
		if want.Magnitude < 0.1 then
			want = cameraBasis().LookVector
		end
		want = Vector3.new(want.X, 0, want.Z)
		if want.Magnitude < 1e-3 then
			return
		end
		want = want.Unit
		local current = flat / speed
		local angle = math.acos(math.clamp(current:Dot(want), -1, 1))
		if angle > 1e-3 then
			local turn = math.min(angle, math.rad(turnRate) * dt)
			local sign = if current:Cross(want).Y > 0 then 1 else -1
			current = CFrame.Angles(0, turn * sign, 0):VectorToWorldSpace(current)
		end
		mover.VectorVelocity = current * speed + Vector3.new(0, velocity.Y, 0)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + current)
	end)
end

local function setBlock(held: boolean)
	blockHeld = held
	lastBlockSent = os.clock()
	Remotes.Action:FireServer("Block", held)
end

-- Server owns ragdoll physics, but the client's Humanoid state must match
-- or it fights the ragdoll / stays floppy after getting up.
local function onCharacterAdded(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	jumpEnabled = true
	character:GetAttributeChangedSignal("Ragdolled"):Connect(function()
		if character:GetAttribute("Ragdolled") then
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		else
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
	-- Ragdolls disable the Neck motor: don't die of a "broken neck".
	humanoid.RequiresNeck = false
	-- Don't let the default "fall over" states interrupt combat.
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
end

function Input.Start()
	ContextActionService:BindAction("CloverM1", function(_, state)
		if state == Enum.UserInputState.Begin then
			m1Held = true
			tryM1()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			m1Held = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

	ContextActionService:BindAction("CloverDash", function(_, state)
		if state == Enum.UserInputState.Begin then
			tryDash()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)

	ContextActionService:BindAction("CloverBlock", function(_, state)
		if state == Enum.UserInputState.Begin then
			setBlock(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			setBlock(false)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonL2)

	ContextActionService:SetTitle("CloverM1", "M1")
	ContextActionService:SetTitle("CloverDash", "Dash")
	ContextActionService:SetTitle("CloverBlock", "Block")

	-- Skills 1-4 and awakening. The server checks cooldowns and state.
	local skillKeys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
	for slot, key in skillKeys do
		local action = "CloverSkill" .. slot
		ContextActionService:BindAction(action, function(_, state)
			if state == Enum.UserInputState.Begin and getCharacter() then
				local inAir = airborne()
				if inAir then
					local info = Kits.SkillsOf(localPlayer.Character :: Model)[slot]
					holdInAir(slot, info and info.airHold)
				end
				Remotes.Action:FireServer("Skill", slot, { airborne = inAir })
			end
			return Enum.ContextActionResult.Sink
		end, true, key)
		ContextActionService:SetTitle(action, tostring(slot))
	end
	ContextActionService:BindAction("CloverSpecial", function(_, state)
		if state == Enum.UserInputState.Begin and getCharacter() then
			local inAir = airborne()
			if inAir then
				local kit = Kits.Of(localPlayer.Character :: Model)
				holdInAir(CombatState.SpecialSlot, kit and kit.special and kit.special.airHold)
			end
			Remotes.Action:FireServer("Special", { airborne = inAir })
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("CloverSpecial", "R")
	ContextActionService:BindAction("CloverAwaken", function(_, state)
		if state == Enum.UserInputState.Begin and getCharacter() then
			Remotes.Action:FireServer("Awaken")
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.G)
	ContextActionService:SetTitle("CloverAwaken", "G")

	RunService.Heartbeat:Connect(function()
		if m1Held then
			tryM1()
		end

		local character, humanoid = getCharacter()
		if humanoid and not jumpHeld(humanoid) then
			jumpNeedsRelease = false
			uppercutPrimedUntil = 0
		end
		-- Air jumps come back on landing, and need a fresh press in the air.
		if humanoid then
			if humanoid.FloorMaterial ~= Enum.Material.Air then
				airJumpsUsed = 0
				jumpReleasedInAir = false
			elseif not jumpHeld(humanoid) then
				jumpReleasedInAir = true
			end
		end
		if character and humanoid then
			local canJump = os.clock() >= noJumpUntil
				and not jumpNeedsRelease
				and os.clock() >= uppercutPrimedUntil
				and CombatState.CanAct(character)
				and not CombatState.IsBlocking(character)
				and not CombatState.IsBusy(character)
				and not CombatState.IsCasting(character)
			if canJump ~= jumpEnabled then
				jumpEnabled = canJump
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, canJump)
			end
			-- The server gives the jump back a ping late after a move ends;
			-- don't eat a jump pressed in between.
			if
				canJump
				and humanoid.JumpHeight < Config.Movement.JumpHeight
				and character:GetAttribute("Rooted") ~= true
			then
				humanoid.JumpHeight = Config.Movement.JumpHeight
			end
		end

		-- Holding F through a swing or stun: block as soon as it's allowed.
		if blockHeld and character and not CombatState.IsBlocking(character) then
			if os.clock() - lastBlockSent > BLOCK_RETRY then
				lastBlockSent = os.clock()
				Remotes.Action:FireServer("Block", true)
			end
		end
	end)

	Remotes.Impulse.OnClientEvent:Connect(function(velocity, duration, options)
		local character, humanoid, root = getCharacter()
		if not (character and humanoid and root) or typeof(velocity) ~= "Vector3" or type(duration) ~= "number" then
			return
		end
		-- Plain knockback eases out; dives and steered pushes keep their speed.
		local plain = type(options) ~= "table"
		local mover =
			Impulse.Apply(root, velocity, math.clamp(duration, 0, 1), "Knockback", if plain then 0.45 else nil)
		-- Dives (air Bull Thrust, the Meteorite slam, Plunge): once we touch down,
		-- stop pushing into the floor and carry on as a skid.
		if type(options) == "table" and options.landStop == true and velocity.Y < 0 then
			local connection
			connection = RunService.Heartbeat:Connect(function()
				if not mover.Parent or not root.Parent then
					connection:Disconnect()
					return
				end
				if humanoid.FloorMaterial ~= Enum.Material.Air then
					connection:Disconnect()
					local v = mover.VectorVelocity
					local keep = if type(options.landKeep) == "number" then options.landKeep else 1
					mover.VectorVelocity = Vector3.new(v.X, 0, v.Z) * keep
					mover.MaxAxesForce = Vector3.new(1e6, 0, 1e6)
				end
			end)
		end
		if type(options) == "table" and type(options.steer) == "number" then
			steerImpulse(mover, character, humanoid, root, options.steer)
		end
	end)

	UserInputService.JumpRequest:Connect(function()
		lastJumpRequest = os.clock()
		-- One more jump in the air for kits that ride the wind (Yuno).
		local character, humanoid, root = getCharacter()
		local kit = character and Kits.Of(character)
		if
			not character
			or not humanoid
			or not root
			or not kit
			or (kit.airJumps or 0) <= airJumpsUsed
			or humanoid.FloorMaterial ~= Enum.Material.Air
			or not jumpReleasedInAir
			or not CombatState.CanAct(character)
			or CombatState.IsCasting(character)
			or CombatState.IsBlocking(character)
			or character:GetAttribute("Rooted") == true
		then
			return
		end
		airJumpsUsed += 1
		jumpReleasedInAir = false
		local velocity = root.AssemblyLinearVelocity
		Impulse.Apply(
			root,
			Vector3.new(velocity.X, Config.Movement.AirJumpSpeed, velocity.Z),
			Config.Movement.AirJumpTime,
			"AirJump"
		)
		VFX.Play("AirJump", { character = character })
		Remotes.Action:FireServer("AirJump")
	end)

	localPlayer.CharacterAdded:Connect(onCharacterAdded)
	if localPlayer.Character then
		task.spawn(onCharacterAdded, localPlayer.Character)
	end
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="34">
          <Properties>
            <string name="Name">Kits</string>
          </Properties>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">AntiMagic</string>
              <string name="Source"><![CDATA[--[[
	Anti-Magic Knight (Asta), client side: sword animations, skill VFX and
	the Black Form look. The server sends ("Skill", {skill, phase, ...})
	events; see ServerScriptService.Server.Kits.AntiMagic for the gameplay.

	Visual language: black anti-magic with dark red edges, black smoke,
	sharp slash arcs and rock-cracking impacts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local BlackMoon = require(ReplicatedStorage:WaitForChild("Shared").BlackMoon)
local MeteorVortex = require(ReplicatedStorage:WaitForChild("Shared").MeteorVortex)

local CameraShake = require(script.Parent.Parent.CameraShake)
local Cinematic = require(script.Parent.Parent.Cinematic)
local PoseAnimator = require(script.Parent.Parent.PoseAnimator)
local Reactions = require(script.Parent.Parent.Reactions)
local VFX = require(script.Parent.Parent.VFX)

local U = VFX.Util

type Animation = PoseAnimator.Animation

local BLACK = Color3.fromRGB(8, 8, 10)
local RED = Color3.fromRGB(200, 25, 35)
local DARK_RED = Color3.fromRGB(110, 8, 18)
local RIM_RED = Color3.fromRGB(235, 40, 50) -- Black Form's outline: bright, a touch of glow
local WHITE = Color3.new(1, 1, 1)

local rad = math.rad
local UP = Vector3.yAxis

local Kit = {}

VFX.SetPalette("AntiMagic", {
	hit = Color3.fromRGB(220, 50, 60),
	heavy = Color3.fromRGB(170, 15, 25),
	flash = Color3.fromRGB(255, 225, 225),
	cleanM1 = true, -- sleek sword M1s: no sparks or rings on hit
})

---------------------------------------------------------------------------
-- Animations (generated by tools/anim, see Animations.luau)
---------------------------------------------------------------------------

local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

-- The grip the server welds the sword with (see Server/Kits/AntiMagic).
local GRIP = CFrame.Angles(rad(215), 0, 0)
local BLADE_REST = GRIP:VectorToWorldSpace(Vector3.yAxis) -- blade direction in arm space, neutral wrist

-- Wrist rotation that points the blade along `direction` (character space),
-- given the torso and arm poses of the same keyframe.
local function solveWrist(torso: CFrame, arm: CFrame, direction: Vector3): CFrame
	local armRotation = torso.Rotation * arm.Rotation
	local target = armRotation:VectorToObjectSpace(direction.Unit)
	local axis = BLADE_REST:Cross(target)
	local angle = math.acos(math.clamp(BLADE_REST:Dot(target), -1, 1))
	if axis.Magnitude < 1e-5 then
		return if angle < 1 then CFrame.identity else CFrame.fromAxisAngle(Vector3.xAxis, math.pi)
	end
	return CFrame.fromAxisAngle(axis.Unit, angle)
end

-- Turns generated animation data (Animations.luau) into a playable Animation.
local function build(raw: { [string]: any }): Animation
	local keyframes = {}
	for _, key in raw.keys do
		local pose: { [string]: CFrame } = {}
		local sword = nil
		for name, value in key[2] do
			if name == "Sword" then
				sword = value
			else
				pose[name] = value
			end
		end
		pose.Sword = if type(sword) == "table"
			then solveWrist(pose.Torso or CFrame.identity, pose.RightArm or CFrame.identity, sword.aim)
			else CFrame.identity
		table.insert(keyframes, {
			time = key[1],
			pose = pose,
			easing = if key[3] then (Enum.EasingStyle :: any)[key[3]] else nil,
			direction = if key[4] then (Enum.EasingDirection :: any)[key[4]] else nil,
		})
	end
	return {
		keyframes = keyframes,
		loop = raw.loop,
		fadeIn = raw.fadeIn,
		fadeOut = raw.fadeOut,
		additive = raw.additive,
		delays = raw.delays,
		events = raw.events,
	}
end

local Generated = require(script.Animations)
local ANIMS: { [string]: Animation } = {}
for name, raw in Generated do
	ANIMS[name] = build(raw)
end

-- Signature stance: wide footing, the greatsword resting on the right
-- shoulder, slow breathing. Sprints leaning in with the sword riding on his
-- shoulder, walks upright when slowed down; knee up and free arm out in the
-- air. The strides are how far one loop (two steps) of each cycle carries
-- him (RUN_STRIDE / WALK_STRIDE in tools/anim/asta_anims.py): the legs keep
-- pace with the ground instead of scurrying.
Kit.Idle = {
	stand = ANIMS.Idle,
	move = ANIMS.Run,
	walk = ANIMS.Walk,
	air = ANIMS.Air,
	moveSpeed = 16,
	walkSpeed = 8,
	moveStride = 11.32,
	walkStride = 6.57,
}

-- Getting hit / blocking, with the sword (see Client/Reactions for the names).
Kit.Reactions = {
	FlinchA = ANIMS.FlinchA,
	FlinchB = ANIMS.FlinchB,
	FlinchBack = ANIMS.FlinchBack,
	HitHeavy = ANIMS.HitHeavy,
	Guard = ANIMS.Guard,
	GuardHit = ANIMS.GuardHit,
	Stagger = ANIMS.Stagger,
	Grabbed = ANIMS.Grabbed,
	Launched = ANIMS.Launched,
}

---------------------------------------------------------------------------
-- Effects
---------------------------------------------------------------------------

local function getSword(character: Model): Model?
	return character:FindFirstChild("KitWeapon") :: Model?
end

-- Turns the blade's swing trail on for `duration` (locally).
local function swordTrail(character: Model, duration: number)
	local sword = getSword(character)
	local blade = sword and sword:FindFirstChild("Blade")
	local trail = blade and blade:FindFirstChild("SwingTrail")
	if trail and trail:IsA("Trail") then
		trail.Enabled = true
		task.delay(duration, function()
			trail.Enabled = false
		end)
	end
end

-- Red glow on the sword (charging, perfect timing flash).
local function swordGlow(character: Model, color: Color3, duration: number, fill: number?)
	local sword = getSword(character)
	if not sword then
		return
	end
	local glow = Instance.new("Highlight")
	glow.Adornee = sword
	glow.FillColor = color
	glow.OutlineColor = color
	glow.FillTransparency = fill or 0.2
	glow.OutlineTransparency = 0
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.Parent = U.folder
	U.tween(
		glow,
		duration,
		{ FillTransparency = 1, OutlineTransparency = 1 },
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In
	)
	task.delay(duration, glow.Destroy, glow)
end

-- Black anti-magic smoke burst.
local function blackSmoke(position: Vector3, count: number, size: number, speed: number?)
	U.burst(position, {
		texture = U.textures.Smoke,
		color = BLACK,
		count = count,
		size = size,
		speed = NumberRange.new((speed or 10) * 0.5, speed or 10),
		lifetime = NumberRange.new(0.4, 0.8),
		lightEmission = 0,
		transparency = 0.1,
		drag = 4,
	})
end

local function redSparks(position: Vector3, count: number, size: number?, direction: Vector3?)
	U.burst(position, {
		color = RED,
		count = count,
		size = size or 1,
		speed = NumberRange.new(25, 50),
		streaks = true,
		direction = direction,
		spread = if direction then 40 else nil,
	})
end

-- Jagged black lightning with a red sheath, crackling out around a point.
local function blackLightning(position: Vector3, count: number, radius: number, life: number?)
	for _ = 1, count do
		local from = position + U.randomUnit() * radius * 0.2
		U.lightning(from, position + U.randomUnit() * radius, BLACK, RED, 0.1 + radius * 0.012, life or 0.2)
	end
end

local function play(character: Model, animation: Animation, onEvent: ((string) -> ())?)
	PoseAnimator.Play(character, animation, onEvent)
end

---------------------------------------------------------------------------
-- M1
---------------------------------------------------------------------------

local STRING = { "Slash1", "Slash2", "Slash3" }
local FINISHERS = { Knockback = "Cleave", Uppercut = "Rising", Downslam = "Chop" }

-- M1s are just the sword swinging: no trails, no extra effects.
function Kit.PlayM1(character: Model, index: number, variant: string)
	local name = if variant ~= "Normal" then FINISHERS[variant] or "Cleave" else STRING[((index - 1) % #STRING) + 1]
	play(character, ANIMS[name])
end

---------------------------------------------------------------------------
-- Skills
---------------------------------------------------------------------------

--[[
	Anti-magic slash wave, drawn locally from the server's launch info: a
	tapered crescent (red glow, black core, a white-hot leading edge)
	flying out across the direction of travel, trailing black smoke and
	embers, lighting up what it passes and carving a glowing groove into
	the ground when it flies low. `grand` waves are flat and huge.
]]
local WAVE_POINTS = 12

local function slashWave(data)
	local origin: Vector3 = data.origin
	local direction: Vector3 = data.direction
	local speed: number = data.speed or 130
	local range: number = data.range or 90
	local width: number = data.width or 9
	local grand = data.grand == true
	local scale = width / 9

	local frame = CFrame.lookAt(origin, origin + direction)
	local holder = U.newPart({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = frame })
	local tilt = CFrame.Angles(0, 0, if grand then 0 else rad(25))
	local bulge = width * 0.32

	-- Points along the crescent: tips level with the holder, the middle
	-- bulging forward (-Z).
	local function ring(lead: number): { Attachment }
		local list = {}
		for i = 0, WAVE_POINTS do
			local theta = -math.pi / 2 + math.pi * i / WAVE_POINTS
			local a = Instance.new("Attachment")
			a.Position =
				tilt:PointToWorldSpace(Vector3.new(math.sin(theta) * width / 2, 0, -math.cos(theta) * (bulge + lead)))
			a.Parent = holder
			list[i] = a
		end
		return list
	end
	local body = ring(0)
	local front = ring(width * 0.06)
	local function profile(i: number): number
		return math.sin(math.pi * i / WAVE_POINTS) ^ 0.8
	end
	local function layer(
		points: { Attachment },
		color: Color3,
		emission: number,
		thickness: number,
		transparency: number,
		z: number
	)
		for i = 0, WAVE_POINTS - 1 do
			local b = Instance.new("Beam")
			b.Attachment0 = points[i]
			b.Attachment1 = points[i + 1]
			b.FaceCamera = true
			b.Segments = 2
			b.Color = ColorSequence.new(color)
			b.LightEmission = emission
			b.LightInfluence = 0
			b.ZOffset = z
			b.Width0 = thickness * profile(i)
			b.Width1 = thickness * profile(i + 1)
			b.Transparency = NumberSequence.new(transparency)
			b.Parent = holder
		end
	end
	layer(body, RED, 1, 2.6 * scale, 0.3, 0)
	layer(body, BLACK, 0, 1.7 * scale, 0, 0.05)
	layer(front, Color3.fromRGB(255, 190, 190), 1, 0.35 * scale, 0.1, 0.1)

	local glow = Instance.new("PointLight")
	glow.Color = RED
	glow.Brightness = 4
	glow.Range = 10 * scale + 4
	glow.Shadows = false
	glow.Parent = holder

	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = U.textures.Smoke
	smoke.Color = ColorSequence.new(BLACK)
	smoke.LightEmission = 0
	smoke.LightInfluence = 0
	smoke.Size = NumberSequence.new(2.4 * scale, 0.5)
	smoke.Transparency = NumberSequence.new(0.2, 1)
	smoke.Lifetime = NumberRange.new(0.3, 0.6)
	smoke.Rate = 80
	smoke.Speed = NumberRange.new(2, 6)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Parent = holder
	local embers = Instance.new("ParticleEmitter")
	embers.Texture = U.textures.Spark
	embers.Color = ColorSequence.new(RED, DARK_RED)
	embers.LightEmission = 1
	embers.LightInfluence = 0
	embers.Size = NumberSequence.new(0.35 * scale + 0.1, 0)
	embers.Lifetime = NumberRange.new(0.2, 0.45)
	embers.Rate = 60
	embers.Speed = NumberRange.new(6, 14)
	embers.SpreadAngle = Vector2.new(60, 60)
	embers.EmissionDirection = Enum.NormalId.Back
	embers.Orientation = Enum.ParticleOrientation.VelocityParallel
	embers.Squash = NumberSequence.new(1.4)
	embers.Parent = holder

	-- Flying low: it carves a glowing groove behind it, following the ground
	-- (and leaving none where it passes over a drop).
	local lastGroove = origin
	local nextDust = 0

	local travelled = 0
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		travelled += speed * dt
		holder.CFrame = frame + direction * travelled
		local here = holder.Position
		if (here - lastGroove).Magnitude > 3 then
			local floorA = U.groundBelow(lastGroove)
			local floorB = U.groundBelow(here)
			lastGroove = here
			if floorA and floorB and here.Y - floorB.Position.Y < 4.5 then
				local a = floorA.Position + UP * 0.05
				local b = floorB.Position + UP * 0.05
				local length = (b - a).Magnitude
				local look = CFrame.lookAt((a + b) / 2, b)
				local groove = U.newPart({
					Size = Vector3.new(0.9 * scale + 0.4, 0.06, length + 0.3),
					CFrame = look,
					Color = Color3.fromRGB(14, 13, 13),
					Material = Enum.Material.SmoothPlastic,
				})
				local hot = U.newPart({
					Size = Vector3.new(0.35 * scale + 0.15, 0.08, length + 0.3),
					CFrame = look + Vector3.new(0, 0.01, 0),
					Color = RED,
				})
				U.tween(hot, 0.8, { Transparency = 1, Size = Vector3.new(0.05, 0.08, length) })
				task.delay(1.6, function()
					U.tween(groove, 0.6, { Transparency = 1 })
				end)
				task.delay(2.3, function()
					groove:Destroy()
					hot:Destroy()
				end)
				if travelled >= nextDust then
					nextDust = travelled + (if grand then 6 else 9)
					U.burst(b, {
						texture = U.textures.Smoke,
						color = Color3.fromRGB(150, 140, 130),
						count = if grand then 5 else 3,
						size = 2.5 * scale + 1,
						speed = NumberRange.new(4, 10),
						lifetime = NumberRange.new(0.4, 0.8),
						lightEmission = 0,
						transparency = 0.5,
						drag = 3,
						spread = 60,
					})
					if grand then
						U.groundRocks(b, 4, 2, 1.3)
					end
				end
			end
		end
		if travelled >= range then
			connection:Disconnect()
			smoke.Enabled = false
			embers.Enabled = false
			glow:Destroy()
			blackSmoke(here, if grand then 16 else 8, 3 * scale, 10)
			U.flash(here, BLACK, 4 * scale + 2, 0.2)
			redSparks(here, if grand then 16 else 8, 0.8)
			for _, child in holder:GetChildren() do
				if child:IsA("Attachment") or child:IsA("Beam") then
					child:Destroy()
				end
			end
			task.delay(0.7, holder.Destroy, holder)
		end
	end)
end

local handlers: { [string]: (data: any, character: Model, root: BasePart) -> () } = {}

---------------------------------------------------------------------------
-- Shared skill effects
---------------------------------------------------------------------------

local function bladeOf(character: Model): BasePart?
	local sword = getSword(character)
	local blade = sword and sword:FindFirstChild("Blade")
	return if blade and blade:IsA("BasePart") then blade else nil
end

-- Distances along the blade below are written for the original sword:
-- -1.8 at the guard, 2.1 out at the tip. They map onto the real blade from
-- the guard and tip points the sword carries (blade-local Y).
local function bladeY(blade: BasePart, along: number): number
	local guard, tip = blade:GetAttribute("GuardY"), blade:GetAttribute("TipY")
	if type(guard) == "number" and type(tip) == "number" then
		return guard + (along + 1.8) / 3.9 * (tip - guard)
	end
	return along * blade.Size.Y / 3.6
end

local function alongBlade(blade: BasePart, along: number): CFrame
	return blade.CFrame * CFrame.new(0, bladeY(blade, along), 0)
end

-- A point along the blade: 0 is its middle, 2.1 the tip, -1.8 the guard.
local function bladePoint(character: Model, along: number): Vector3?
	local blade = bladeOf(character)
	return if blade then alongBlade(blade, along).Position else nil
end

-- Heavy swing trail for skills: a black core inside a wider red glow that
-- runs past the tip. Built on the spot and thrown away after.
local function heavyTrail(character: Model, duration: number)
	local blade = bladeOf(character)
	if not blade then
		return
	end
	local made: { Instance } = {}
	local function attachment(y: number): Attachment
		local a = Instance.new("Attachment")
		a.Position = Vector3.new(0, bladeY(blade, y), 0)
		a.Parent = blade
		table.insert(made, a)
		return a
	end
	local function trail(from: number, to: number, color: ColorSequence, emission: number, lifetime: number, t0: number)
		local t = Instance.new("Trail")
		t.Attachment0 = attachment(from)
		t.Attachment1 = attachment(to)
		t.Color = color
		t.LightEmission = emission
		t.LightInfluence = 0
		t.Lifetime = lifetime
		t.MinLength = 0
		t.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, t0),
			NumberSequenceKeypoint.new(0.6, 0.55 + t0 * 0.4),
			NumberSequenceKeypoint.new(1, 1),
		})
		t.WidthScale = NumberSequence.new(1, 0.35)
		t.Parent = blade
		table.insert(made, t)
	end
	trail(-1.9, 2.5, ColorSequence.new(RED, DARK_RED), 1, 0.2, 0.25)
	trail(-1.5, 2.0, ColorSequence.new(BLACK), 0, 0.15, 0)
	task.delay(duration, function()
		for _, instance in made do
			if instance:IsA("Trail") then
				instance.Enabled = false
			end
		end
		task.wait(0.3)
		for _, instance in made do
			instance:Destroy()
		end
	end)
end

-- A particle emitter living on a part for `duration` (emits from the part's volume).
local function partEmitter(part: BasePart, props: { [string]: any }, duration: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.LightInfluence = 0
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = part
	task.delay(duration, function()
		emitter.Enabled = false
		task.wait(1.2)
		emitter:Destroy()
	end)
	return emitter
end

-- Anti-magic coating the blade: black wisps peeling off it, red embers.
local function swordAura(character: Model, duration: number, rate: number)
	local blade = bladeOf(character)
	if not blade then
		return
	end
	partEmitter(blade, {
		Texture = U.textures.Smoke,
		Color = ColorSequence.new(BLACK),
		LightEmission = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1.4) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.25, 0.45),
		Rate = rate,
		Speed = NumberRange.new(0.5, 2.5),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 5, 0),
		Drag = 2,
	}, duration)
	partEmitter(blade, {
		Texture = U.textures.Spark,
		Color = ColorSequence.new(RED),
		LightEmission = 1,
		Size = NumberSequence.new(0.22, 0),
		Lifetime = NumberRange.new(0.2, 0.4),
		Rate = rate * 0.35,
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(180, 180),
	}, duration)
end

--[[
	A crescent slash sweeping from `from` to `to` (degrees around him: 0 is
	straight ahead, positive is his right) at `radius`, tilted `tilt`
	degrees about his forward axis (0 flat, 90 vertical). Drawn segment by
	segment over `sweep` seconds so it trails the blade, tapered at both
	ends: a black core, a red glow and a hot outer edge. Follows the root.
]]
type CrescentOptions = {
	center: CFrame?,
	radius: number,
	from: number,
	to: number,
	tilt: number?,
	width: number,
	sweep: number?,
	fade: number?,
	-- Glowing slashes: a soft red aura round the cut and a white-hot line
	-- along it (both emissive, so they bloom). 0 or nil for none.
	glow: number?,
}

local CRESCENT_SEGMENTS = 14

local function crescent(character: Model, options: CrescentOptions)
	local root = U.getRoot(character)
	if not root then
		return
	end
	local holder = U.newPart({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = root.CFrame })
	local frame = (options.center or CFrame.identity) * CFrame.Angles(0, 0, rad(options.tilt or 0))
	local n = CRESCENT_SEGMENTS

	local function ring(radius: number): { Attachment }
		local list = {}
		for i = 0, n do
			local angle = rad(options.from + (options.to - options.from) * i / n)
			local a = Instance.new("Attachment")
			a.Position = frame:PointToWorldSpace(Vector3.new(math.sin(angle) * radius, 0, -math.cos(angle) * radius))
			a.Parent = holder
			list[i] = a
		end
		return list
	end
	local inner = ring(options.radius)
	local outer = ring(options.radius + options.width * 0.42)

	-- Thickest just past the middle, pointed at both ends.
	local function profile(i: number): number
		local x = i / n
		return math.sin(math.pi * x ^ 0.85) ^ 0.7
	end

	type Layer = { beam: Beam, width: number, base: number }
	local segments: { { Layer } } = {}
	local function layer(
		a0: Attachment,
		a1: Attachment,
		color: Color3,
		emission: number,
		width: number,
		z: number
	): Beam
		local b = Instance.new("Beam")
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.FaceCamera = true
		b.Segments = 2
		b.Color = ColorSequence.new(color)
		b.LightEmission = emission
		b.LightInfluence = 0
		b.ZOffset = z
		b.Width0 = width
		b.Width1 = width
		b.Transparency = NumberSequence.new(1)
		b.Parent = holder
		return b
	end
	local w = options.width
	local shine = options.glow or 0
	for i = 0, n - 1 do
		local list: { Layer } = {}
		local glow = layer(inner[i], inner[i + 1], RED, 1, 0, 0)
		local core = layer(inner[i], inner[i + 1], BLACK, 0, 0, 0.05)
		local edge = layer(outer[i], outer[i + 1], Color3.fromRGB(255, 170, 170), 1, 0, 0.1)
		table.insert(list, { beam = glow, width = w * 1.6, base = 0.3 })
		table.insert(list, { beam = core, width = w, base = 0 })
		table.insert(list, { beam = edge, width = w * 0.16, base = 0.1 })
		if shine > 0 then
			local aura = layer(inner[i], inner[i + 1], RED, 1, 0, -0.05)
			local hot = layer(outer[i], outer[i + 1], Color3.fromRGB(255, 228, 228), 1, 0, 0.15)
			table.insert(list, { beam = aura, width = w * 2.8 * shine, base = 0.62 })
			table.insert(list, { beam = hot, width = w * 0.07 * (1 + shine), base = 0 })
		end
		segments[i + 1] = list
	end

	local sweep = options.sweep or 0.08
	local fade = options.fade or 0.25
	local hold = 0.04
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		if root.Parent then
			holder.CFrame = root.CFrame
		end
		for i, list in segments do
			local appear = sweep * (i - 1) / n
			local alpha = if t < appear then -1 else math.clamp((t - appear - hold) / fade, 0, 1)
			local w0, w1 = profile(i - 1), profile(i)
			for _, entry in list do
				local beam = entry.beam
				if alpha < 0 then
					beam.Transparency = NumberSequence.new(1)
				else
					local thin = 1 - 0.65 * alpha
					beam.Width0 = entry.width * w0 * thin
					beam.Width1 = entry.width * w1 * thin
					beam.Transparency = NumberSequence.new(entry.base + (1 - entry.base) * alpha)
				end
			end
		end
		if t > sweep + hold + fade then
			connection:Disconnect()
			holder:Destroy()
		end
	end)
end

-- A dark mote with a red tail streaking into `target` (anti-magic gathering).
local function inflow(target: Vector3, radius: number)
	local from = target + U.randomUnit() * radius
	local orb = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (0.25 + math.random() * 0.25),
		CFrame = CFrame.new(from),
		Color = BLACK,
		Material = Enum.Material.SmoothPlastic,
	})
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.12, 0)
	a0.Parent = orb
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.12, 0)
	a1.Parent = orb
	local tail = Instance.new("Trail")
	tail.Attachment0 = a0
	tail.Attachment1 = a1
	tail.Color = ColorSequence.new(BLACK, DARK_RED)
	tail.LightEmission = 0
	tail.LightInfluence = 0
	tail.Lifetime = 0.12
	tail.MinLength = 0
	tail.FaceCamera = true
	tail.WidthScale = NumberSequence.new(1, 0)
	tail.Parent = orb
	U.tween(
		orb,
		0.2,
		{ CFrame = CFrame.new(target), Size = Vector3.one * 0.05 },
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In
	)
	task.delay(0.35, orb.Destroy, orb)
end

-- Little black bolts snapping around a part for `duration`.
local function crackle(part: BasePart, duration: number, interval: number, radius: number)
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < duration and part.Parent do
			local from = part.Position + U.randomUnit() * radius * 0.3
			U.lightning(from, from + U.randomUnit() * radius, BLACK, RED, 0.1, 0.14, false)
			task.wait(interval)
		end
	end)
end

-- One-frame monochrome "impact frame", for the people involved in a big hit.
local function impactFrame(strength: number?)
	local k = strength or 1
	U.colorGrade({ Brightness = 0.25 * k, Contrast = 0.85 * k, Saturation = -1 }, 0, 0.06, 0.22)
end

local function involves(data, character: Model): boolean
	return U.isLocal(character) or U.isLocal(data.target)
end

-- Bumped whenever a skill phase starts, so a charge loop stops as soon as
-- that skill is released or cancelled.
local castTokens: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local function bump(character: Model): number
	local token = (castTokens[character] or 0) + 1
	castTokens[character] = token
	return token
end
local function live(character: Model, token: number): boolean
	return castTokens[character] == token and character.Parent ~= nil
end

-- Smoke that hangs over a spot for a while after a big impact.
local function lingerSmoke(position: Vector3, duration: number, size: number)
	local holder = U.newPart({ Size = Vector3.new(size, 0.2, size), Transparency = 1, CFrame = CFrame.new(position) })
	partEmitter(holder, {
		Texture = U.textures.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(28, 26, 28)),
		LightEmission = 0,
		Size = NumberSequence.new(size * 0.4, size * 0.8),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(1, 1.6),
		Rate = 14,
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(60, 60),
		Acceleration = Vector3.new(0, 2, 0),
		EmissionDirection = Enum.NormalId.Top,
	}, duration)
	task.delay(duration + 1.8, holder.Destroy, holder)
end

---------------------------------------------------------------------------
-- Bull Thrust: propel, catch, then a five-hit sword combo (in the air, a
-- dive that slams the ground if it catches no one)
---------------------------------------------------------------------------

-- Attaches a short-lived particle emitter to a part (a continuous trail).
local function trailEmitter(part: BasePart, props: { [string]: any }, duration: number): ParticleEmitter
	local attachment = Instance.new("Attachment")
	attachment.Parent = part
	local emitter = Instance.new("ParticleEmitter")
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = attachment
	task.delay(duration, function()
		emitter.Enabled = false
		task.wait(1)
		attachment:Destroy()
	end)
	return emitter
end

-- A slash mark drawn on the target: black blade core with a red glow,
-- slicing in fast and thinning out. Faces the camera.
local function slashMark(position: Vector3, angle: number, length: number, duration: number)
	local camera = workspace.CurrentCamera
	local base = CFrame.lookAt(position, camera.CFrame.Position) * CFrame.Angles(0, 0, angle)
	local glow = U.newPart({ Size = Vector3.new(0.1, 0.32, 0.03), CFrame = base, Color = RED, Transparency = 0.2 })
	local core = U.newPart({
		Size = Vector3.new(0.1, 0.14, 0.03),
		CFrame = base * CFrame.new(0, 0, 0.02),
		Color = BLACK,
		Material = Enum.Material.SmoothPlastic,
	})
	U.tween(glow, duration * 0.35, { Size = Vector3.new(length * 1.08, 0.32, 0.03) })
	U.tween(core, duration * 0.35, { Size = Vector3.new(length, 0.14, 0.03) })
	task.delay(duration * 0.35, function()
		U.tween(glow, duration * 0.65, { Size = Vector3.new(length * 1.1, 0.02, 0.02), Transparency = 1 })
		U.tween(core, duration * 0.65, { Size = Vector3.new(length, 0.01, 0.01), Transparency = 1 })
	end)
	task.delay(duration + 0.05, function()
		glow:Destroy()
		core:Destroy()
	end)
end

-- The slashMark angle that lines the mark up with `direction` (world space)
-- as this camera sees it.
local function markAngle(position: Vector3, direction: Vector3): number
	local facing = CFrame.lookAt(position, workspace.CurrentCamera.CFrame.Position)
	local along = facing:VectorToObjectSpace(direction)
	return math.atan2(along.Y, along.X)
end

local function feetOf(character: Model, root: BasePart): Vector3
	local ground = U.groundBelow(root.Position, { character })
	return if ground then ground.Position else root.Position - UP * 3
end

---------------------------------------------------------------------------
-- Glow: emissive light for the big moments. Reds this deep don't bloom on
-- their own, so these lay a hot, near-white core inside the red, add real
-- light, and swell the bloom for whoever's close.
---------------------------------------------------------------------------

local HOT = Color3.fromRGB(255, 110, 110)
local WHITE_HOT = Color3.fromRGB(255, 225, 225)

-- The blade's edges and point burn red for `duration` (glowing lines laid
-- along them and a light on the blade), then fade.
local function edgeGlow(character: Model, duration: number, strength: number?)
	local blade = bladeOf(character)
	if not blade then
		return
	end
	local k = strength or 1
	local half = blade.Size.Z / 2
	local top = blade.Size.Y / 2
	local guard = bladeY(blade, -1.8)
	local pointY = blade:GetAttribute("PointY")
	local point = if type(pointY) == "number" then pointY else top + 0.6
	local made: { Instance } = {}
	local function at(y: number, z: number): Attachment
		local a = Instance.new("Attachment")
		a.Position = Vector3.new(0, y, z)
		a.Parent = blade
		table.insert(made, a)
		return a
	end
	local apex = at(point, 0)
	local beams: { Beam } = {}
	for _, side in { -1, 1 } do
		local base, shoulder = at(guard, side * half), at(top, side * half)
		for _, pair in { { base, shoulder }, { shoulder, apex } } do
			for layer = 1, 2 do
				local beam = Instance.new("Beam")
				beam.Attachment0 = pair[1]
				beam.Attachment1 = pair[2]
				beam.FaceCamera = true
				beam.Segments = 1
				beam.LightEmission = 1
				beam.LightInfluence = 0
				beam.Color = ColorSequence.new(if layer == 1 then RED else HOT)
				local width = (if layer == 1 then 0.6 else 0.16) * k
				beam.Width0 = width
				beam.Width1 = width
				beam.Transparency = NumberSequence.new(1)
				beam.Parent = blade
				table.insert(beams, beam)
				table.insert(made, beam)
			end
		end
	end
	local glow = Instance.new("PointLight")
	glow.Color = RED
	glow.Range = 10
	glow.Brightness = 0
	glow.Shadows = false
	glow.Parent = blade
	table.insert(made, glow)
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local a = if t < 0.06 then t / 0.06 elseif t < duration then 1 else 1 - (t - duration) / 0.25
		if a <= 0 or not blade.Parent then
			connection:Disconnect()
			for _, instance in made do
				instance:Destroy()
			end
			return
		end
		local flicker = 0.88 + 0.12 * math.sin(t * 38)
		for i, beam in beams do
			local base = if i % 2 == 1 then 0.4 else 0.05
			beam.Transparency = NumberSequence.new(1 - (1 - base) * a * flicker)
		end
		glow.Brightness = 3 * k * a
	end)
end

-- A bright burst: a white-hot core inside a red halo (both bloom), hot
-- sparks and a light that touches everything round it.
local function glowBurst(position: Vector3, size: number, duration: number?)
	local life = duration or 0.3
	local halo = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size * 0.4,
		CFrame = CFrame.new(position),
		Color = RED,
		Transparency = 0.3,
	})
	local core = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size * 0.16,
		CFrame = CFrame.new(position),
		Color = WHITE_HOT,
	})
	U.tween(halo, life, { Size = Vector3.one * size * 1.4, Transparency = 1 })
	U.tween(core, life * 0.6, { Size = Vector3.one * size * 0.45, Transparency = 1 })
	task.delay(life + 0.05, function()
		halo:Destroy()
		core:Destroy()
	end)
	U.burst(position, {
		color = HOT,
		count = math.floor(6 + size * 2),
		size = 0.45,
		speed = NumberRange.new(10, 26),
		lifetime = NumberRange.new(0.15, 0.35),
		streaks = true,
		spread = 180,
	})
	U.light(position, RED, 8, size * 4, life * 1.5)
end

-- The scene's bloom swells for a moment, so the brightest effects glow.
-- Only for people close enough to see it; overlapping swells are fine.
local bloomSwells = 0
local bloomBase: { Intensity: number, Threshold: number }? = nil
local function bloomPulse(position: Vector3, strength: number, duration: number)
	if (workspace.CurrentCamera.CFrame.Position - position).Magnitude > 140 then
		return
	end
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if not bloom then
		return
	end
	bloomBase = bloomBase or { Intensity = bloom.Intensity, Threshold = bloom.Threshold }
	local base = bloomBase :: { Intensity: number, Threshold: number }
	bloomSwells += 1
	U.tween(bloom, 0.06, {
		Intensity = base.Intensity + 0.7 * strength,
		Threshold = math.max(base.Threshold - 0.5 * strength, 0.8),
	})
	task.delay(duration, function()
		bloomSwells -= 1
		if bloomSwells == 0 then
			U.tween(bloom, 0.35, { Intensity = base.Intensity, Threshold = base.Threshold })
		end
	end)
end

-- The black meteor tail and air rings while diving (Meteorite slam, Plunge,
-- air Bull Thrust). `alive` cuts it short when it turns false (he's landed).
local function meteorTail(root: BasePart, duration: number, alive: (() -> boolean)?)
	local smoke = trailEmitter(root, {
		Texture = U.textures.Smoke,
		Color = ColorSequence.new(BLACK),
		LightEmission = 0,
		Size = NumberSequence.new(1.8, 4),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.3, 0.55),
		Rate = 140,
		Speed = NumberRange.new(4, 10),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(30, 30),
		Drag = 3,
	}, duration)
	local sparks = trailEmitter(root, {
		Texture = U.textures.Spark,
		Color = ColorSequence.new(RED, DARK_RED),
		LightEmission = 1,
		Size = NumberSequence.new(0.4, 0),
		Lifetime = NumberRange.new(0.15, 0.3),
		Rate = 70,
		Speed = NumberRange.new(14, 24),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(25, 25),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Squash = NumberSequence.new(1.6),
	}, duration)
	if alive then
		local start = os.clock()
		task.spawn(function()
			while os.clock() - start < duration and alive() do
				task.wait()
			end
			smoke.Enabled = false
			sparks.Enabled = false
		end)
	end
	for i = 0, math.floor(duration / 0.06) do
		task.delay(i * 0.06, function()
			if root.Parent and (not alive or alive()) then
				U.ringBurst(
					CFrame.new(root.Position - UP * 3.4),
					if i % 2 == 0 then BLACK else RED,
					1.2,
					3.8,
					0.18,
					0.15
				)
			end
		end)
	end
end

--[[
	The combo's four cuts, started by the BullCombo animation's events so
	they keep time with the blade. Each crescent follows that swing's actual
	path (fitted to the blade tip in tools/anim): centred on his sword
	shoulder (on him for the turn), tilted and swept the way the blade goes.
]]
local COMBO_SWINGS: { [string]: CrescentOptions } = {
	-- From low behind him on the right, up through them to high on his left.
	Rising = {
		center = CFrame.new(1, 0.5, 0) * CFrame.Angles(rad(5), 0, 0),
		radius = 5.2,
		from = 130,
		to = -80,
		tilt = -41,
		width = 1.7,
		sweep = 0.06,
		fade = 0.24,
	},
	-- Back across the waist, left to right.
	Sweep = {
		center = CFrame.new(1, 0.5, 0) * CFrame.Angles(rad(-5), 0, 0),
		radius = 5,
		from = -100,
		to = 122,
		tilt = -2,
		width = 1.7,
		sweep = 0.06,
		fade = 0.24,
	},
	-- The turn: round behind him, then on through them, dipping in front.
	Spin = {
		center = CFrame.new(0, 0.5, 0) * CFrame.Angles(rad(-12), 0, 0),
		radius = 5.9,
		from = 160,
		to = 425,
		tilt = 3,
		width = 2.1,
		sweep = 0.16,
		fade = 0.3,
	},
	-- Up over his head and straight down through them.
	Chop = {
		center = CFrame.new(0.4, 0.8, 0) * CFrame.Angles(0, rad(5), 0),
		radius = 5,
		from = 135,
		to = -28,
		tilt = 90,
		width = 2.3,
		sweep = 0.06,
		fade = 0.3,
	},
}

-- How each hit lands: the way the blade travels through them (in his
-- space: X right, Y up, -Z forward) and how big the hit is.
local COMBO_CUTS: { [string]: { cut: Vector3, size: number } } = {
	Rising = { cut = Vector3.new(-0.75, 0.65, 0), size = 1 },
	Sweep = { cut = Vector3.new(1, 0, 0), size = 1 },
	Spin = { cut = Vector3.new(1, 0.05, 0), size = 1.25 },
	Chop = { cut = Vector3.new(0, -1, 0.25), size = 1.5 },
}

-- Flat direction from him to them (his facing if they're on top of him).
local function towardTarget(root: BasePart, targetRoot: BasePart): Vector3
	local offset = targetRoot.Position - root.Position
	local flat = Vector3.new(offset.X, 0, offset.Z)
	return if flat.Magnitude > 0.1 then flat.Unit else root.CFrame.LookVector
end

-- One beat of the combo animation: a swing starting, the coil, the thrust.
local function comboSwing(character: Model, root: BasePart, event: string)
	local swing = COMBO_SWINGS[event]
	if swing then
		heavyTrail(character, (swing.sweep or 0.06) + 0.06)
		swing.glow = swing.glow or 0.7 -- the cuts glow
		crescent(character, swing)
		edgeGlow(character, (swing.sweep or 0.06) + 0.1, 0.8)
		-- His footwork scuffs up a little anti-magic.
		blackSmoke(feetOf(character, root) + UP * 0.3, 3, 1.6, 5)
		if event == "Spin" then
			-- The turn throws a ring of wind off him.
			U.ringBurst(CFrame.new(root.Position + UP * 0.2), BLACK, 1.5, 7, 0.28, 0.22)
			task.delay(0.06, U.ringBurst, CFrame.new(root.Position + UP * 0.3), DARK_RED, 1.2, 5.5, 0.24, 0.14)
			task.delay(0.08, function()
				if character.Parent then
					U.afterimage(character, DARK_RED, 0.18)
				end
			end)
		elseif event == "Chop" then
			-- The blade catches the light at the top of the swing.
			local tip = bladePoint(character, 2.1)
			if tip then
				U.glint(tip, 1.2, RED)
			end
		end
	elseif event == "Coil" then
		-- Drawn back for the thrust: anti-magic floods the blade and the air
		-- pulls in around him.
		swordGlow(character, RED, 0.18, 0.35)
		swordAura(character, 0.16, 40)
		U.ringBurst(CFrame.new(feetOf(character, root) + UP * 0.1), BLACK, 5, 1.2, 0.16, 0.2)
		local blade = bladeOf(character)
		if blade then
			for _ = 1, 5 do
				inflow(blade.Position, 3.5)
			end
			crackle(blade, 0.14, 0.04, 2)
		end
		task.delay(0.06, function()
			local tip = bladePoint(character, 2.1)
			if tip and character.Parent then
				U.glint(tip, 1.6, RED)
				task.delay(0.03, U.glint, tip, 1, WHITE)
			end
		end)
		if U.isLocal(character) then
			CameraShake.FovKick(-4)
		end
	elseif event == "Thrust" then
		heavyTrail(character, 0.14)
		U.afterimage(character, BLACK, 0.2)
		local feet = feetOf(character, root)
		blackSmoke(feet + UP * 0.3, 6, 2.2, 10)
		U.ringBurst(CFrame.new(feet + UP * 0.1), BLACK, 0.8, 5, 0.25, 0.2)
	end
end

-- One of the four cuts landing: its slash across them along the swing,
-- sparks thrown the way the blade travels, a flash and a ring sized to it.
local function comboImpact(data, character: Model, root: BasePart)
	local target = data.target
	local targetRoot = U.getRoot(target)
	local how = COMBO_CUTS[data.kind] or COMBO_CUTS.Sweep
	if not targetRoot then
		return
	end
	local k = how.size
	local center = targetRoot.Position + UP * 0.4
	local cut = root.CFrame:VectorToWorldSpace(how.cut).Unit
	local toward = towardTarget(root, targetRoot)
	slashMark(center, markAngle(center, cut), 4 + 1.6 * k, 0.2 + 0.05 * k)
	U.flash(center, WHITE, 1.6 * k, 0.07)
	U.flash(center, BLACK, 3 * k, 0.16)
	glowBurst(center, 2.2 * k, 0.22)
	redSparks(center, math.floor(8 * k), 0.45 + 0.15 * k, cut)
	U.impactRing(center, toward, RED, 0.4 * k, 3.2 * k, 0.2)
	task.delay(0.03, U.impactRing, center, toward, BLACK, 0.3 * k, 2.6 * k, 0.2)
	blackLightning(center, if k > 1 then 3 else 2, 2 + k, 0.15)
	U.light(center, RED, 4 * k, 8 + 4 * k, 0.15)
	if data.kind == "Chop" then
		-- Driven down through them into the ground at their feet.
		local feet = feetOf(target, targetRoot)
		U.groundCracks(feet, 5, 4, RED, 1.2)
		U.groundRocks(feet, 6, 2.2, 1)
		U.ringBurst(CFrame.new(feet + UP * 0.1), BLACK, 0.8, 6, 0.3, 0.25)
		blackSmoke(feet + UP * 0.3, 6, 2.4, 10)
	elseif data.kind == "Spin" then
		-- The turn's wind rings out around them.
		U.ringBurst(CFrame.new(center), WHITE, 0.6, 4.5, 0.2, 0.08)
	end
	if involves(data, character) then
		CameraShake.Add(0.05 + 0.05 * k)
	end
end

-- The point punching out through their back: a black spike in a red glow
-- that shoots out and thins away.
local function pierce(from: Vector3, direction: Vector3, length: number)
	local frame = CFrame.lookAt(from, from + direction)
	local out = frame * CFrame.new(0, 0, -length / 2)
	local glow = U.newPart({ Size = Vector3.new(0.5, 0.5, 0.4), CFrame = frame, Color = RED, Transparency = 0.15 })
	local core = U.newPart({
		Size = Vector3.new(0.22, 0.22, 0.4),
		CFrame = frame,
		Color = BLACK,
		Material = Enum.Material.SmoothPlastic,
	})
	U.tween(glow, 0.08, { Size = Vector3.new(0.45, 0.45, length), CFrame = out })
	U.tween(core, 0.08, { Size = Vector3.new(0.2, 0.2, length * 0.95), CFrame = out })
	task.delay(0.08, function()
		U.tween(glow, 0.24, { Size = Vector3.new(0.02, 0.02, length * 1.1), Transparency = 1 })
		U.tween(core, 0.24, { Size = Vector3.new(0.01, 0.01, length), Transparency = 1 })
	end)
	task.delay(0.35, function()
		glow:Destroy()
		core:Destroy()
	end)
end

-- The finisher: the thrust goes clean through them and blows them back.
local function comboFinisher(data, character: Model, root: BasePart)
	local target = data.target
	local targetRoot = U.getRoot(target)
	if not targetRoot then
		return
	end
	local toward = towardTarget(root, targetRoot)
	local center = targetRoot.Position + UP * 0.2
	pierce(center - toward * 1.2, toward, 8)
	U.flash(center, WHITE, 5, 0.1)
	U.flash(center, BLACK, 9, 0.24)
	U.flash(center, RED, 6, 0.18)
	glowBurst(center, 6, 0.35)
	task.delay(0.05, glowBurst, center + toward * 4, 3.5, 0.3)
	edgeGlow(character, 0.35, 1.2)
	bloomPulse(center, 0.9, 0.25)
	U.shockwave(center, RED, 1.5, 9, 0.3)
	U.impactRing(center, toward, WHITE, 0.8, 7, 0.25)
	task.delay(0.04, U.impactRing, center + toward * 1.5, toward, RED, 0.6, 6, 0.28)
	task.delay(0.08, U.impactRing, center + toward * 3, toward, BLACK, 0.5, 8, 0.32)
	blackSmoke(center + toward * 1.5, 16, 3.2, 22)
	U.burst(center, {
		color = RED,
		count = 24,
		size = 0.7,
		speed = NumberRange.new(35, 60),
		lifetime = NumberRange.new(0.15, 0.35),
		streaks = true,
		spread = 25,
		direction = toward,
	})
	blackLightning(center, 6, 5.5, 0.25)
	U.light(center, RED, 12, 22, 0.35)
	U.highlight(target, RED, 0.25)
	U.bodyTrail(target, DARK_RED, 0.35)
	-- They skid back across the ground.
	local feet = feetOf(target, targetRoot)
	U.ringBurst(CFrame.new(feet + UP * 0.1), BLACK, 1, 8, 0.3, 0.3)
	U.burst(feet, {
		texture = U.textures.Smoke,
		color = Color3.fromRGB(150, 140, 130),
		count = 8,
		size = 3,
		speed = NumberRange.new(8, 16),
		lifetime = NumberRange.new(0.4, 0.8),
		lightEmission = 0,
		transparency = 0.45,
		drag = 3,
		spread = 50,
		direction = (toward + UP).Unit,
	})
	if involves(data, character) then
		impactFrame()
		CameraShake.Add(0.3)
		CameraShake.FovKick(8)
	end
end

--[[
	Air Bull Thrust landing on nobody: the sword is driven into the ground
	and anti-magic blows a crater out as far as the hit reaches (11 studs).
	A black dome and a red shockwave, rings racing out along the ground,
	the ground split open and thrown up, a black pillar out of the middle
	and black lightning crawling out over it all, then smoke rolling out.
]]
local function bullSlam(data, character: Model)
	local position: Vector3 = data.position
	local center = position + UP
	U.flash(center, WHITE, 6, 0.08)
	U.flash(center, BLACK, 15, 0.32)
	U.flash(center, RED, 10, 0.24)
	glowBurst(center, 9, 0.45)
	bloomPulse(center, 1, 0.3)
	U.shockwave(position, BLACK, 4, 26, 0.45, Enum.Material.Glass, 0.4)
	U.shockwave(position, RED, 3, 22, 0.4)
	task.delay(0.1, U.shockwave, position, BLACK, 2, 32, 0.55, Enum.Material.Glass, 0.55)
	U.ringBurst(CFrame.new(position + UP * 0.2), BLACK, 1.5, 18, 0.45, 0.6)
	task.delay(0.05, U.ringBurst, CFrame.new(position + UP * 0.3), RED, 1, 13, 0.38, 0.3)
	task.delay(0.1, U.ringBurst, CFrame.new(position + UP * 0.4), WHITE, 0.5, 9, 0.25, 0.12)

	-- The ground splits open and is thrown up around the blade.
	U.groundCracks(position, 11, 12, RED, 2.8)
	U.groundRocks(position, 14, 5.5, 2.6)
	task.delay(0.05, U.groundRocks, position, 8, 2.6, 1.8)
	U.debris(position, 18, 50, 1.3)
	U.pillar(position, BLACK, 2.6, 22, 0.5, Enum.Material.SmoothPlastic, 0.15)
	U.pillar(position, RED, 1.3, 26, 0.4)

	-- Black lightning: crackling over the crater and crawling out across
	-- the ground to the edge of the blast.
	blackLightning(center, 7, 7, 0.28)
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2 + math.random() * 0.45
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		U.lightning(position + UP * 0.4, position + out * (8 + math.random() * 5) + UP * 0.3, BLACK, RED, 0.18, 0.28)
	end

	blackSmoke(center, 22, 5.5, 28)
	U.burst(position, {
		texture = U.textures.Smoke,
		color = Color3.fromRGB(150, 140, 130),
		count = 14,
		size = 6,
		speed = NumberRange.new(18, 34),
		lifetime = NumberRange.new(0.7, 1.2),
		lightEmission = 0,
		transparency = 0.4,
		drag = 2,
		spread = 70,
	})
	redSparks(center, 24, 1.2)
	U.light(position + UP * 2, RED, 12, 34, 0.5)
	lingerSmoke(position, 1.2, 6)

	-- The blade, buried in the ground, flares red.
	swordGlow(character, RED, 0.3, 0.3)
	task.delay(0.05, function()
		local point = bladePoint(character, 0)
		if point and character.Parent then
			U.glint(point, 1.6, RED)
		end
	end)

	-- Whoever was caught in it lights up red; for them and for him, an
	-- impact frame (the server shakes everyone's camera nearby).
	local mine = U.isLocal(character)
	if type(data.targets) == "table" then
		for _, victim in data.targets do
			if typeof(victim) == "Instance" and victim:IsA("Model") then
				U.highlight(victim, RED, 0.3)
				mine = mine or U.isLocal(victim)
			end
		end
	end
	if mine then
		impactFrame()
		CameraShake.Add(0.2)
		CameraShake.FovKick(12)
	end
end

function handlers.BullThrust(data, character, root)
	local phase = data.phase
	if phase == "Propel" then
		local direction: Vector3 = if typeof(data.direction) == "Vector3"
			then data.direction
			else root.CFrame.LookVector
		-- The server says how long the (steerable) propel lasts.
		local duration = if type(data.duration) == "number" then data.duration else 0.55
		local air = data.airborne == true
		play(character, if air then ANIMS.AirPropel else ANIMS.Propel)
		swordTrail(character, duration + 0.05)

		-- Ignition: an anti-magic blast behind him.
		local back = root.Position - direction * 1.5
		U.flash(back, BLACK, 6, 0.18)
		U.impactRing(back, direction, BLACK, 0.8, 5.5, 0.25)
		task.delay(0.05, U.impactRing, back, direction, RED, 0.6, 4, 0.22)
		blackSmoke(back, 14, 3.2, 16)
		U.burst(back, {
			color = RED,
			count = 14,
			size = 0.5,
			speed = NumberRange.new(25, 45),
			lifetime = NumberRange.new(0.15, 0.35),
			streaks = true,
			spread = 35,
			direction = -direction,
		})
		U.light(back, RED, 6, 14, 0.3)
		U.flash(back, RED, 3.5, 0.12)
		blackLightning(back, 3, 3, 0.2)
		task.delay(0.08, U.impactRing, back, direction, BLACK, 0.5, 6.5, 0.28)
		-- The glow: the blade's edges burn the whole way, a hot core flares
		-- at the ignition and a glowing jet streams off behind him.
		glowBurst(back, 5, 0.3)
		edgeGlow(character, duration + 0.1, 1)
		bloomPulse(root.Position, 0.6, 0.25)
		trailEmitter(root, {
			Texture = U.textures.Spark,
			Color = ColorSequence.new(WHITE_HOT, HOT),
			LightEmission = 1,
			Size = NumberSequence.new(0.7, 0),
			Transparency = NumberSequence.new(0.1, 1),
			Lifetime = NumberRange.new(0.12, 0.22),
			Rate = 80,
			Speed = NumberRange.new(6, 12),
			EmissionDirection = Enum.NormalId.Back,
			SpreadAngle = Vector2.new(12, 12),
		}, duration)
		if air then
			-- Diving out of the sky like a meteor, until he lands (the
			-- server's Land, where the slam goes off) or catches someone.
			local token = bump(character)
			meteorTail(root, duration, function()
				return live(character, token)
			end)
		else
			U.ringBurst(CFrame.new(feetOf(character, root) + UP * 0.1), BLACK, 0.8, 5, 0.3, 0.2)
			task.delay(0.05, U.ringBurst, CFrame.new(feetOf(character, root) + UP * 0.15), RED, 0.6, 4, 0.25, 0.15)
		end

		-- The jet: smoke and embers streaming off his back, afterimages,
		-- speed lines, dust kicked up along the ground.
		trailEmitter(root, {
			Texture = U.textures.Smoke,
			Color = ColorSequence.new(BLACK),
			LightEmission = 0,
			Size = NumberSequence.new(1.4, 3.2),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.35, 0.6),
			Rate = 110,
			Speed = NumberRange.new(2, 6),
			EmissionDirection = Enum.NormalId.Back,
			SpreadAngle = Vector2.new(25, 25),
			Drag = 3,
		}, duration)
		trailEmitter(root, {
			Texture = U.textures.Spark,
			Color = ColorSequence.new(RED, DARK_RED),
			LightEmission = 1,
			Size = NumberSequence.new(0.35, 0),
			Lifetime = NumberRange.new(0.15, 0.3),
			Rate = 60,
			Speed = NumberRange.new(10, 18),
			EmissionDirection = Enum.NormalId.Back,
			SpreadAngle = Vector2.new(30, 30),
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			Squash = NumberSequence.new(1.5),
		}, duration)
		U.bodyTrail(character, BLACK, duration + 0.05)
		U.speedLines(root, if air then direction else nil, duration)
		for i = 0, math.floor(duration / 0.06) do
			task.delay(i * 0.06, function()
				if character.Parent then
					U.afterimage(character, if i % 2 == 0 then BLACK else DARK_RED, 0.28)
					if i % 3 == 1 then
						blackLightning(root.Position, 1, 2.2, 0.12) -- anti-magic crackling off him
					end
					if not air then
						blackSmoke(feetOf(character, root) + UP * 0.3, 2, 1.6, 4)
					end
				end
			end)
		end
		if U.isLocal(character) then
			CameraShake.FovKick(10)
			CameraShake.Add(0.15)
		end
	elseif phase == "Catch" then
		local position: Vector3 = data.position
		local direction = root.CFrame.LookVector
		U.flash(position, BLACK, 5, 0.15)
		U.flash(position, WHITE, 3, 0.08)
		U.impactRing(position, direction, RED, 0.6, 4.5, 0.22)
		redSparks(position, 16, 0.8, direction)
		blackLightning(position, 4, 3.2)
		U.light(position, RED, 8, 14, 0.25)
		task.delay(0.04, U.impactRing, position, direction, BLACK, 0.5, 5.5, 0.24)
		U.highlight(data.target, RED, 0.15)
		if U.isLocal(character) or U.isLocal(data.target) then
			CameraShake.Add(0.25)
		end
	elseif phase == "Combo" then
		-- The cuts follow the animation's beats, so they keep time with the blade.
		local token = bump(character)
		play(character, ANIMS.BullCombo, function(event)
			if live(character, token) then
				comboSwing(character, root, event)
			end
		end)
		swordTrail(character, 1.2)
	elseif phase == "Strike" then
		if data.kind == "Thrust" then
			comboFinisher(data, character, root)
		else
			comboImpact(data, character, root)
		end
	elseif phase == "Land" then
		-- Air version, nobody caught: he lands driving the sword into the
		-- ground and the slam goes off.
		bump(character)
		play(character, ANIMS.PlungeImpact)
		bullSlam(data, character)
	elseif phase == "Interrupted" then
		-- Cut short (he got hit, or they broke out): no more swings.
		bump(character)
		if PoseAnimator.Current(character) == ANIMS.BullCombo then
			PoseAnimator.FadeOut(character, 0.2)
		end
	end
end

---------------------------------------------------------------------------
-- Black Meteorite: standing grab, carry them up, crater slam (Black Moon's
-- lunge grab is drawn here too)
---------------------------------------------------------------------------

-- His free hand's fist, where the grab closes.
local function gripPoint(character: Model): Vector3?
	local hand = character:FindFirstChild("Left Arm")
	return if hand and hand:IsA("BasePart") then (hand.CFrame * CFrame.new(0, -1, 0)).Position else nil
end

-- Anti-magic winding round his free hand: black and red ribbons orbiting
-- the forearm and fist, closing in as it goes. Follows the arm; `alive`
-- cuts it short.
local function handSwirl(arm: BasePart, duration: number, alive: () -> boolean)
	local colors = { BLACK, RED, BLACK, DARK_RED }
	local ribbons: { BasePart } = {}
	for _, color in colors do
		local part = U.newPart({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = arm.CFrame })
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.14, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.14, 0)
		a1.Parent = part
		local dark = color == BLACK
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(color)
		trail.LightEmission = if dark then 0 else 1
		trail.LightInfluence = 0
		trail.Lifetime = 0.16
		trail.MinLength = 0
		trail.FaceCamera = true
		trail.Transparency = NumberSequence.new(if dark then 0.05 else 0.15, 1)
		trail.WidthScale = NumberSequence.new(1, 0)
		trail.Parent = part
		table.insert(ribbons, part)
	end
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - start) / duration
		if t >= 1 or not arm.Parent or not alive() then
			connection:Disconnect()
			for _, part in ribbons do
				for _, child in part:GetChildren() do
					if child:IsA("Trail") then
						child.Enabled = false
					end
				end
				task.delay(0.3, part.Destroy, part)
			end
			return
		end
		local radius = 1.2 * (1 - 0.6 * t)
		for i, part in ribbons do
			local angle = t * math.pi * 6 + (i / #ribbons) * math.pi * 2
			-- Half round the fist, half further up the forearm.
			local along = if i % 2 == 0 then -0.95 else -0.4
			part.CFrame = arm.CFrame * CFrame.new(math.cos(angle) * radius, along, math.sin(angle) * radius)
		end
	end)
end

-- Black lightning crawling down his arm, shoulder to fist, hop by hop.
local function armCrawl(arm: BasePart, duration: number, alive: () -> boolean)
	local start = os.clock()
	task.spawn(function()
		local hop = 0
		while os.clock() - start < duration and arm.Parent and alive() do
			-- R6 arms are 2 studs long: the shoulder is at +1, the fist at -1.
			local from = 0.9 - (hop % 4) * 0.45
			local a = arm.CFrame:PointToWorldSpace(Vector3.new(0, from, 0) + U.randomUnit() * 0.3)
			local b = arm.CFrame:PointToWorldSpace(Vector3.new(0, from - 0.65, 0) + U.randomUnit() * 0.35)
			U.lightning(a, b, BLACK, RED, 0.08, 0.12, false)
			hop += 1
			task.wait(0.035)
		end
	end)
end

-- The hand at full stretch, when the server checks for someone to seize: a
-- grasp flash at the fist, a ring snapping shut on it and a jolt of
-- anti-magic out ahead. On the ground his front foot bites in.
local function grasp(character: Model, root: BasePart, air: boolean)
	local at = gripPoint(character)
	if not at then
		return
	end
	local forward = root.CFrame.LookVector
	U.flash(at, WHITE, 2, 0.06)
	U.flash(at, BLACK, 4.5, 0.2)
	U.flash(at, RED, 2.6, 0.12)
	U.glint(at, 0.8, RED)
	U.impactRing(at, forward, RED, 2.4, 0.2, 0.1)
	task.delay(0.03, U.impactRing, at + forward * 0.5, forward, BLACK, 0.4, 3.4, 0.22)
	U.burst(at, {
		color = RED,
		count = 10,
		size = 0.4,
		speed = NumberRange.new(18, 34),
		lifetime = NumberRange.new(0.1, 0.25),
		streaks = true,
		spread = 30,
		direction = forward,
	})
	blackSmoke(at, 5, 1.6, 6)
	blackLightning(at, 3, 2.4, 0.16)
	U.light(at, RED, 7, 12, 0.3)
	if not air then
		local feet = feetOf(character, root)
		U.ringBurst(CFrame.new(feet + UP * 0.1), BLACK, 0.6, 4, 0.25, 0.16)
		U.groundCracks(feet + forward * 0.8, 4, 3, RED, 1)
		blackSmoke(feet + UP * 0.3, 4, 1.6, 5)
	end
	if U.isLocal(character) then
		CameraShake.Add(0.12)
	end
end

function handlers.BlackMeteorite(data, character, root)
	local phase = data.phase
	if phase == "Reach" then
		-- No dash: he plants (or hangs there, in the air) and his free hand
		-- shoots out for their throat, anti-magic winding round it.
		local air = data.airborne == true
		local token = bump(character)
		local function alive(): boolean
			return live(character, token)
		end
		play(character, if air then ANIMS.AirMeteorReach else ANIMS.MeteorReach, function(event)
			if event == "Grasp" and alive() then
				grasp(character, root, air)
			end
		end)
		local arm = character:FindFirstChild("Left Arm")
		if arm and arm:IsA("BasePart") then
			handSwirl(arm, 0.45, alive)
			armCrawl(arm, 0.4, alive)
			-- Black wisps peeling off the arm, red embers.
			partEmitter(arm, {
				Texture = U.textures.Smoke,
				Color = ColorSequence.new(BLACK),
				LightEmission = 0,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1.3) }),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.2),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = NumberRange.new(0.25, 0.45),
				Rate = 40,
				Speed = NumberRange.new(0.5, 2),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 4, 0),
				Drag = 2,
			}, 0.4)
			partEmitter(arm, {
				Texture = U.textures.Spark,
				Color = ColorSequence.new(RED),
				LightEmission = 1,
				Size = NumberSequence.new(0.2, 0),
				Lifetime = NumberRange.new(0.15, 0.35),
				Rate = 18,
				Speed = NumberRange.new(2, 5),
				SpreadAngle = Vector2.new(180, 180),
			}, 0.4)
		end
		-- Anti-magic streaking in to the hand as it draws back.
		for i = 0, 5 do
			task.delay(i * 0.025, function()
				local at = gripPoint(character)
				if at and alive() then
					inflow(at, 3)
				end
			end)
		end
		U.light(root.Position, RED, 3, 10, 0.45)
	elseif phase == "Whiff" then
		-- Nobody there: the hand closes on nothing and the anti-magic
		-- gutters out of it.
		bump(character)
		local at = gripPoint(character)
		if at then
			U.flash(at, BLACK, 2.4, 0.18)
			blackSmoke(at, 7, 1.4, 4)
			U.burst(at, {
				color = RED,
				count = 6,
				size = 0.3,
				speed = NumberRange.new(2, 6),
				lifetime = NumberRange.new(0.4, 0.7),
				acceleration = Vector3.new(0, -14, 0),
				drag = 1,
			})
		end
	elseif phase == "Cancel" then
		-- Hit out of the reach.
		bump(character)
		local current = PoseAnimator.Current(character)
		if current == ANIMS.MeteorReach or current == ANIMS.AirMeteorReach then
			PoseAnimator.FadeOut(character, 0.15)
		end
	elseif phase == "Seize" then
		-- The grab: his free hand clamps on their throat and hoists them,
		-- anti-magic pouring out of his grip and through them.
		local air = data.airborne == true
		play(character, if air then ANIMS.AirSeize else ANIMS.Seize)
		local target = data.target
		task.delay(0.07, function()
			local at = gripPoint(character)
			if not at or not character.Parent then
				return
			end
			U.flash(at, WHITE, 3, 0.08)
			U.flash(at, BLACK, 5, 0.18)
			U.impactRing(at, root.CFrame.LookVector, RED, 0.4, 3.5, 0.2)
			redSparks(at, 12, 0.7)
			U.highlight(target, BLACK, 0.3)
			if air then
				-- Nothing under them: the burst rings out around the grip.
				blackSmoke(at, 6, 2.2, 6)
				U.ringBurst(CFrame.new(at) * CFrame.Angles(rad(90), 0, 0), BLACK, 0.8, 5, 0.25, 0.2)
			else
				blackSmoke(feetOf(character, root) + UP * 0.3, 6, 2.2, 6)
				U.ringBurst(CFrame.new(feetOf(character, root) + UP * 0.1), BLACK, 0.8, 5, 0.25, 0.2)
			end
			blackLightning(at, 3, 2.5, 0.2)
		end)
		-- The surge (it lands with the server's 2-damage hit).
		task.delay(0.2, function()
			local at = gripPoint(character)
			local targetRoot = U.getRoot(target)
			if not at or not targetRoot or not character.Parent then
				return
			end
			for _ = 1, 6 do
				local point = targetRoot.Position + U.randomUnit() * Vector3.new(1.1, 1.8, 0.6)
				U.lightning(at, point, BLACK, RED, 0.12, 0.2)
			end
			crackle(targetRoot, 0.25, 0.04, 2.5)
			U.highlight(target, RED, 0.25)
			U.flash(targetRoot.Position, RED, 5, 0.15)
			U.light(targetRoot.Position, RED, 9, 14, 0.3)
			for _ = 1, 4 do
				inflow(at, 3.5)
			end
		end)
	elseif phase == "Vortex" then
		-- The vortex: he whirls round with them held out, bobbing up and down
		-- as it carries them into the sky (Shared/MeteorVortex).
		play(character, ANIMS.MeteorSpin)
		local target = data.target
		local air = data.airborne == true
		local length = MeteorVortex.Length
		if typeof(data.origin) == "CFrame" then
			-- The whole move from here: spin, flip, head-first dive, landing.
			local top = if type(data.top) == "number" then data.top else MeteorVortex.Top
			local floorY = if type(data.floorY) == "number" then data.floorY else nil
			local plan = MeteorVortex.Plan(data.origin, top, floorY)
			local start = os.clock()
			local bind = "CloverVortex" .. tostring(start)
			-- After shift lock and the camera, so the path has the last word.
			RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
				local t = os.clock() - start
				if t >= plan.length or not root.Parent then
					RunService:UnbindFromRenderStep(bind)
					return
				end
				root.CFrame = MeteorVortex.At(plan, t)
			end)
		end

		-- Take-off: the ground blows out under them.
		local ground = U.groundBelow(root.Position, { character })
		if ground and not air then
			local feet = ground.Position
			U.flash(feet + UP, BLACK, 9, 0.25)
			U.shockwave(feet, RED, 2, 14, 0.35)
			U.ringBurst(CFrame.new(feet + UP * 0.15), BLACK, 1, 12, 0.35, 0.45)
			task.delay(0.04, U.ringBurst, CFrame.new(feet + UP * 0.2), RED, 0.8, 8, 0.3, 0.2)
			U.groundCracks(feet, 8, 6, RED, 2)
			U.groundRocks(feet, 8, 3, 1.6)
			U.debris(feet, 8, 38, 1)
			blackSmoke(feet + UP * 0.5, 16, 3.5, 18)
			U.light(feet, RED, 8, 18, 0.35)
		else
			U.flash(root.Position, BLACK, 8, 0.25)
			U.ringBurst(CFrame.new(root.Position), BLACK, 1, 10, 0.35, 0.4)
		end

		-- The vortex itself: spirals, swirling smoke, the blade's circles,
		-- rings of wind and lightning crawling round them.
		U.bodyTrail(character, BLACK, length)
		U.bodyTrail(target, DARK_RED, length)
		U.spiral(root, BLACK, 4.8, 3, length, 5, 0.9, 0.15)
		U.spiral(root, RED, 3.8, 3, length, 3, 0.3, 0.15)
		partEmitter(root, {
			Texture = U.textures.Smoke,
			Color = ColorSequence.new(BLACK),
			LightEmission = 0,
			Size = NumberSequence.new(1.8, 4.5),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.4, 0.7),
			Rate = 110,
			Speed = NumberRange.new(6, 14),
			SpreadAngle = Vector2.new(180, 30),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-360, 360),
		}, length)
		crackle(root, length, 0.08, 5)
		for turn = 0, MeteorVortex.Turns - 1 do
			-- A full circle of steel each time round (faster in the middle).
			local at = length * (0.18 + turn * 0.27)
			task.delay(at, function()
				if character.Parent then
					crescent(character, {
						center = CFrame.new(0, 0.2, 0),
						radius = 6,
						from = 90,
						to = 450,
						tilt = 0,
						width = 1.6,
						sweep = 0.16,
						fade = 0.22,
					})
				end
			end)
		end
		for i = 0, math.floor(length / 0.1) - 1 do
			task.delay(i * 0.1, function()
				if not character.Parent then
					return
				end
				local here = root.Position
				U.ringBurst(CFrame.new(here - UP * 1.5), if i % 2 == 0 then BLACK else RED, 3, 9, 0.25, 0.25)
				if i % 3 == 0 then
					blackLightning(here, 2, 5, 0.15)
				end
				-- The ground below gets torn up into the vortex.
				local below = if not air then U.groundBelow(here, { character }, 40) else nil
				if below and i % 2 == 0 then
					U.ringBurst(CFrame.new(below.Position + UP * 0.2), BLACK, 4, 12, 0.3, 0.35)
					U.debris(below.Position, 3, 30, 0.8)
				end
			end)
		end

		-- At the top: the blade drinks in anti-magic before the slam.
		task.delay(MeteorVortex.Length - 0.3, function()
			if not character.Parent then
				return
			end
			swordGlow(character, BLACK, 0.3, 0)
			swordAura(character, 0.5, 45)
			local tip = bladePoint(character, 2.1)
			if tip then
				U.glint(tip, 1.8, RED)
				blackLightning(tip, 4, 3)
				U.light(tip, RED, 8, 14, 0.3)
			end
			for _ = 1, 6 do
				local blade = bladeOf(character)
				if blade then
					inflow(blade.Position, 4)
				end
			end
		end)
	elseif phase == "Slam" then
		-- Over the top and down head-first, spinning like a drill (the TSB
		-- "Head First" dive), the meteor's tail streaming up behind them.
		local dive = if type(data.dive) == "number" then data.dive else 0.55
		play(character, ANIMS.MeteorDrill)
		heavyTrail(character, dive)
		U.bodyTrail(character, RED, dive)
		U.bodyTrail(data.target, BLACK, dive)
		U.speedLines(root, -UP, dive)
		U.spiral(root, BLACK, 3.4, 3, dive, 4, 0.9, 0.12)
		U.spiral(root, RED, 2.6, 3, dive, 3, 0.3, 0.12)
		-- Spinning afterimages all the way down.
		for i = 0, math.floor((dive - MeteorVortex.Flip) / 0.05) do
			task.delay(MeteorVortex.Flip + i * 0.05, function()
				if character.Parent then
					U.afterimage(character, if i % 2 == 0 then BLACK else DARK_RED, 0.22)
				end
			end)
		end
		-- A meteor's tail: black smoke and red streaks pouring off upward
		-- (he's head-down, so that's off the bottom of him).
		trailEmitter(root, {
			Texture = U.textures.Smoke,
			Color = ColorSequence.new(BLACK),
			LightEmission = 0,
			Size = NumberSequence.new(1.8, 4),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.3, 0.55),
			Rate = 140,
			Speed = NumberRange.new(4, 10),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(30, 30),
			Drag = 3,
		}, dive)
		trailEmitter(root, {
			Texture = U.textures.Spark,
			Color = ColorSequence.new(RED, DARK_RED),
			LightEmission = 1,
			Size = NumberSequence.new(0.4, 0),
			Lifetime = NumberRange.new(0.15, 0.3),
			Rate = 70,
			Speed = NumberRange.new(14, 24),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(25, 25),
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			Squash = NumberSequence.new(1.6),
		}, dive)
		-- Air compressing under them on the way down.
		for i = 0, math.floor(dive / 0.06) do
			task.delay(i * 0.06, function()
				if root.Parent then
					U.ringBurst(
						CFrame.new(root.Position - UP * 3.4),
						if i % 2 == 0 then BLACK else RED,
						1.2,
						3.8,
						0.18,
						0.15
					)
				end
			end)
		end
	elseif phase == "Impact" then
		local position: Vector3 = data.position
		-- (He rolls back over onto his feet: the end of the shared path.)
		play(character, ANIMS.MeteorLand)
		local victim = data.target
		U.flash(position + UP, WHITE, 6, 0.08)
		U.flash(position + UP, BLACK, 16, 0.35)
		U.flash(position + UP, RED, 10, 0.25)
		U.shockwave(position, BLACK, 4, 30, 0.5, Enum.Material.Glass, 0.35)
		U.shockwave(position, RED, 3, 24, 0.45)
		U.ringBurst(CFrame.new(position + UP * 0.2), BLACK, 1.5, 20, 0.5, 0.7)
		task.delay(0.05, U.ringBurst, CFrame.new(position + UP * 0.3), RED, 1, 15, 0.4, 0.35)
		task.delay(0.1, U.ringBurst, CFrame.new(position + UP * 0.4), WHITE, 0.5, 10, 0.25, 0.12)
		task.delay(0.12, U.shockwave, position, BLACK, 2, 36, 0.6, Enum.Material.Glass, 0.5)
		blackLightning(position + UP, 8, 8, 0.3)
		U.groundCracks(position, 12, 13, RED, 3)
		U.groundRocks(position, 16, 6, 2.8)
		task.delay(0.05, U.groundRocks, position, 9, 2.8, 2)
		U.debris(position, 22, 55, 1.5)
		U.pillar(position, BLACK, 3.2, 26, 0.55, Enum.Material.SmoothPlastic, 0.15)
		U.pillar(position, RED, 1.6, 30, 0.45)
		blackSmoke(position + UP, 26, 6, 32)
		U.burst(position, {
			texture = U.textures.Smoke,
			color = Color3.fromRGB(150, 140, 130),
			count = 18,
			size = 7,
			speed = NumberRange.new(20, 40),
			lifetime = NumberRange.new(0.8, 1.4),
			lightEmission = 0,
			transparency = 0.35,
			drag = 2,
			spread = 30,
			direction = (UP + Vector3.new(0.01, 0, 0)).Unit,
		})
		for i = 1, 10 do
			local angle = (i / 10) * math.pi * 2 + math.random() * 0.4
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			U.lightning(position + UP * 0.4, position + out * (9 + math.random() * 7) + UP * 0.3, BLACK, RED, 0.2, 0.3)
		end
		redSparks(position + UP, 30, 1.4)
		U.light(position + UP * 2, RED, 14, 40, 0.6)
		lingerSmoke(position, 1.5, 7)
		if victim then
			U.highlight(victim, RED, 0.35)
		end
		if involves(data, character) then
			impactFrame()
		end
	end
end

---------------------------------------------------------------------------
-- Black Divider: charged cleave; press again on the red flash for a perfect
---------------------------------------------------------------------------

function handlers.BlackDivider(data, character, root)
	local phase = data.phase
	local token = bump(character)
	if phase == "Charge" then
		play(character, if data.airborne then ANIMS.AirDividerCharge else ANIMS.DividerCharge)
		local flashAt = data.flashAt or 0.38
		swordGlow(character, BLACK, 0.62, 0.35)
		swordAura(character, 0.62, 30)
		-- The air gets pulled in toward him (around him when he's hanging in the air).
		local center = if data.airborne then root.Position else feetOf(character, root) + UP * 0.1
		U.ringBurst(CFrame.new(center), BLACK, 9, 1.5, 0.6, 0.25)
		task.delay(0.2, U.ringBurst, CFrame.new(center + UP * 0.02), DARK_RED, 7, 1, 0.42, 0.15)
		blackSmoke(center + UP * 0.2, 8, 2.4, 6)
		if not data.airborne then
			task.delay(0.15, U.groundCracks, center, 5, 3.5, RED, 1.2)
		end

		-- The edges burn brighter as it builds, and a glowing orb swells at
		-- the point.
		edgeGlow(character, 0.62, 0.7)
		local orb = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Color = HOT, Transparency = 0.2 })
		local orbHalo =
			U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.4, Color = RED, Transparency = 0.5 })
		local orbStart = os.clock()
		local orbConnection
		orbConnection = RunService.RenderStepped:Connect(function()
			local t = os.clock() - orbStart
			local tip = bladePoint(character, 2.1)
			if t > 0.7 or not tip or not live(character, token) then
				orbConnection:Disconnect()
				orb:Destroy()
				orbHalo:Destroy()
				return
			end
			local grow = math.min(t / 0.6, 1)
			local pulse = 1 + 0.12 * math.sin(t * 30)
			orb.CFrame = CFrame.new(tip)
			orb.Size = Vector3.one * (0.3 + 0.9 * grow) * pulse
			orbHalo.CFrame = CFrame.new(tip)
			orbHalo.Size = Vector3.one * (0.6 + 2 * grow) * pulse
		end)

		-- Anti-magic streaming into the blade, crackling as it builds.
		local start = os.clock()
		task.spawn(function()
			while os.clock() - start < 0.6 and live(character, token) do
				local blade = bladeOf(character)
				if blade then
					inflow(blade.Position, 4.5)
					if math.random() < 0.45 then
						blackLightning(blade.Position, 1, 2.2, 0.12)
					end
				end
				if U.isLocal(character) then
					CameraShake.Add(0.03)
				end
				task.wait(0.045)
			end
		end)

		-- The timing flash: press 3 right now for a perfect Divider.
		task.delay(flashAt, function()
			if not live(character, token) then
				return
			end
			swordGlow(character, RED, 0.25, 0)
			local tip = bladePoint(character, 1.6)
			if tip then
				U.glint(tip, 2.4, RED)
				task.delay(0.03, U.glint, tip, 1.4, WHITE)
				U.impactRing(tip, workspace.CurrentCamera.CFrame.Position - tip, RED, 0.3, 3.2, 0.2)
				U.light(tip, RED, 12, 16, 0.25)
				redSparks(tip, 10, 0.6)
				glowBurst(tip, 3, 0.22)
				bloomPulse(tip, 0.7, 0.2)
			end
			if U.isLocal(character) then
				CameraShake.FovKick(-5)
			end
		end)
	elseif phase == "Cancel" then
		local blade = bladeOf(character)
		if blade then
			blackSmoke(blade.Position, 6, 2, 5)
		end
	elseif phase == "Release" and data.airborne then
		-- Air version: a front flip, the blade going all the way round and
		-- down onto whoever is below.
		local perfect = data.perfect == true
		local look = root.CFrame.LookVector
		play(character, ANIMS.AirDividerRelease)
		heavyTrail(character, 0.35)
		crescent(character, {
			center = CFrame.new(0, 0.3, 0),
			radius = if perfect then 6.4 else 5.6,
			from = 150,
			to = -170,
			tilt = 90,
			width = if perfect then 2.8 else 2,
			sweep = 0.18,
			fade = 0.3,
			glow = if perfect then 1.4 else 1,
		})
		edgeGlow(character, 0.35, if perfect then 1.4 else 1)
		bloomPulse(root.Position, if perfect then 1.1 else 0.7, 0.3)
		blackSmoke(root.Position, if perfect then 16 else 8, 3.5, 14)
		U.burst(root.Position - UP * 2 + look * 2, {
			color = RED,
			count = if perfect then 24 else 12,
			size = 0.7,
			speed = NumberRange.new(35, 65),
			lifetime = NumberRange.new(0.15, 0.35),
			streaks = true,
			spread = 35,
			direction = (look - UP * 1.4).Unit,
		})
		-- The blow lands on the ground below.
		task.delay(0.16, function()
			local ground = U.groundBelow(root.Position + look * 3, { character })
			if not ground then
				return
			end
			local spot = ground.Position
			U.flash(spot + UP, BLACK, if perfect then 12 else 7, 0.25)
			U.ringBurst(CFrame.new(spot + UP * 0.2), BLACK, 1, if perfect then 14 else 9, 0.35, 0.4)
			task.delay(0.04, U.ringBurst, CFrame.new(spot + UP * 0.3), RED, 0.8, if perfect then 10 else 6, 0.3, 0.2)
			U.groundCracks(spot, if perfect then 10 else 6, if perfect then 9 else 5, RED, 2)
			U.groundRocks(spot, if perfect then 10 else 6, 3, 1.6)
			blackSmoke(spot + UP, if perfect then 16 else 8, 4, 18)
			U.light(spot + UP, RED, if perfect then 12 else 6, 22, 0.35)
			if perfect then
				U.shockwave(spot, RED, 2, 18, 0.4)
				U.debris(spot, 12, 40, 1.1)
				blackLightning(spot + UP, 8, 7, 0.28)
			end
		end)
		if perfect then
			U.popup(root.Position + UP * 4.5, "PERFECT DIVIDER", RED, 1.8)
			if U.isLocal(character) then
				impactFrame()
				U.screenFlash(RED, 0.35)
				CameraShake.FovKick(14)
			end
		elseif U.isLocal(character) then
			CameraShake.FovKick(7)
		end
	elseif phase == "Release" then
		local perfect = data.perfect == true
		local look = root.CFrame.LookVector
		play(character, ANIMS.DividerRelease)
		heavyTrail(character, 0.3)
		-- The cleave: a wide crescent sweeping right to left with the blade.
		crescent(character, {
			center = CFrame.new(0, 0.2, 0.3),
			radius = if perfect then 6.6 else 5.8,
			from = 120,
			to = -125,
			tilt = -6,
			width = if perfect then 3 else 2.1,
			sweep = 0.09,
			fade = if perfect then 0.35 else 0.26,
			glow = if perfect then 1.4 else 1,
		})
		if perfect then
			task.delay(0.03, crescent, character, {
				center = CFrame.new(0, 0.5, 0.3),
				radius = 8.2,
				from = 100,
				to = -105,
				tilt = -10,
				width = 1.2,
				sweep = 0.09,
				fade = 0.3,
				glow = 1,
			})
		end
		-- The cut burns: glowing edges, hot flares along the arc, the bloom swells.
		edgeGlow(character, 0.3, if perfect then 1.4 else 1)
		for i, angle in { 60, 0, -60 } do
			local along = root.CFrame
				* CFrame.Angles(0, rad(angle), 0)
				* CFrame.new(0, 0.2, -(if perfect then 6.6 else 5.8))
			task.delay(0.02 * i, glowBurst, along.Position, if perfect then 3.4 else 2.4, 0.25)
		end
		bloomPulse(root.Position, if perfect then 1.2 else 0.75, 0.3)

		local front = root.Position + look * 5
		local feet = feetOf(character, root)
		-- The cut's wind: rings, dust and a cone of sparks.
		U.ringBurst(CFrame.new(root.Position + UP * 0.2), WHITE, 2, if perfect then 16 else 10, 0.3, 0.12)
		U.ringBurst(CFrame.new(root.Position + UP * 0.2), BLACK, 2, if perfect then 20 else 12, 0.4, 0.35)
		task.delay(
			0.05,
			U.ringBurst,
			CFrame.new(root.Position + UP * 0.3),
			RED,
			1.5,
			if perfect then 15 else 9,
			0.35,
			0.2
		)
		blackLightning(front, if perfect then 6 else 4, 5, 0.22)
		U.light(front, RED, 9, 18, 0.3)
		blackSmoke(front, if perfect then 20 else 10, 4, 24)
		U.burst(front, {
			color = RED,
			count = if perfect then 26 else 14,
			size = 0.7,
			speed = NumberRange.new(35, 65),
			lifetime = NumberRange.new(0.15, 0.35),
			streaks = true,
			spread = 50,
			direction = look,
		})
		U.burst(feet, {
			texture = U.textures.Smoke,
			color = Color3.fromRGB(150, 140, 130),
			count = 10,
			size = 3.5,
			speed = NumberRange.new(10, 20),
			lifetime = NumberRange.new(0.5, 0.9),
			lightEmission = 0,
			transparency = 0.45,
			drag = 3,
			spread = 75,
		})
		U.light(front, RED, if perfect then 14 else 7, if perfect then 30 else 18, 0.35)

		if perfect then
			U.popup(root.Position + UP * 4.5, "PERFECT DIVIDER", RED, 1.8)
			task.delay(0.08, function()
				U.flash(front, BLACK, 14, 0.3)
				U.shockwave(front, RED, 3, 22, 0.4)
				U.shockwave(front, BLACK, 4, 18, 0.35, Enum.Material.Glass, 0.4)
				blackLightning(front, 10, 9, 0.28)
				U.groundCracks(front, 9, 10, RED, 2.5)
				U.debris(front, 12, 40, 1.1)
				-- The cut keeps going: a black crescent rushing on ahead.
				slashWave({
					origin = root.Position + UP * 0.4 + look * 3,
					direction = look,
					speed = 150,
					range = 26,
					width = 16,
					grand = true,
				})
			end)
			if U.isLocal(character) then
				impactFrame()
				U.screenFlash(RED, 0.35)
				CameraShake.FovKick(14)
			end
		elseif U.isLocal(character) then
			CameraShake.FovKick(7)
		end
	end
end

---------------------------------------------------------------------------
-- Anti-Magic Deflect: an anti-magic barrier on the blade that counters
-- anything; melee gets slashed aside, projectiles get sent back
---------------------------------------------------------------------------

local barriers: { [Model]: (shatter: boolean) -> () } = setmetatable({}, { __mode = "k" }) :: any

-- A shimmering black disc held up in front of him with a spinning red rim.
local function openBarrier(character: Model, root: BasePart, duration: number)
	local offset = CFrame.new(0, 0.6, -2.4)
	local face = CFrame.Angles(0, rad(90), 0) -- cylinders run along X; turn X forward
	local radius = 3.2
	local disc = U.newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 0.5, 0.5),
		Color = BLACK,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
	})
	local shimmer = U.newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 0.5, 0.5),
		Color = RED,
		Material = Enum.Material.ForceField,
	})
	local rim: { BasePart } = {}
	local count = 20
	for i = 1, count do
		table.insert(
			rim,
			U.newPart({
				Size = Vector3.new(2 * math.pi * radius / count * 0.75, 0.12, 0.12),
				Color = if i % 2 == 0 then RED else DARK_RED,
			})
		)
	end
	local inner: { BasePart } = {}
	for i = 1, 10 do
		table.insert(
			inner,
			U.newPart({
				Size = Vector3.new(2 * math.pi * radius * 0.5 / 10 * 0.6, 0.08, 0.08),
				Color = RED,
				Transparency = 0.3,
			})
		)
	end
	local all: { BasePart } = { disc, shimmer }
	for _, part in rim do
		table.insert(all, part)
	end
	for _, part in inner do
		table.insert(all, part)
	end

	local start = os.clock()
	local closed = false
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local grow = math.min(t / 0.08, 1)
		local scale = (0.3 + 0.7 * grow) * (1 + 0.04 * math.sin(t * 22))
		local base = root.CFrame * offset
		local r = radius * scale
		disc.Size = Vector3.new(0.1, r * 2, r * 2)
		disc.CFrame = base * face
		shimmer.Size = Vector3.new(0.12, r * 2.05, r * 2.05)
		shimmer.CFrame = base * face
		for i, part in rim do
			part.CFrame = base * CFrame.Angles(0, 0, t * 2.5 + (i / count) * math.pi * 2) * CFrame.new(0, r, 0)
		end
		for i, part in inner do
			part.CFrame = base * CFrame.Angles(0, 0, -t * 4 + (i / 10) * math.pi * 2) * CFrame.new(0, r * 0.5, -0.05)
		end
		if t > duration + 0.5 then
			barriers[character] = nil
			connection:Disconnect()
			for _, part in all do
				part:Destroy()
			end
		end
	end)

	local function close(shatter: boolean)
		if closed then
			return
		end
		closed = true
		barriers[character] = nil
		local center = disc.Position
		if shatter then
			U.shards(center, BLACK, 10)
			U.shards(center, RED, 6)
			U.flash(center, WHITE, 5, 0.1)
			U.impactRing(center, root.CFrame.LookVector, RED, radius, radius * 2.2, 0.22)
		end
		connection:Disconnect()
		for _, part in all do
			if shatter then
				part:Destroy()
			else
				U.tween(part, 0.15, { Transparency = 1 })
				task.delay(0.16, part.Destroy, part)
			end
		end
	end
	barriers[character] = close
	task.delay(duration, close, false)
end

local function closeBarrier(character: Model, shatter: boolean)
	local close = barriers[character]
	if close then
		close(shatter)
	end
end

function handlers.Deflect(data, character, root)
	local phase = data.phase
	local look = root.CFrame.LookVector
	if phase == "Stance" then
		local air = data.airborne == true
		play(character, if air then ANIMS.AirDeflectStance else ANIMS.DeflectStance)
		swordGlow(character, BLACK, 0.85, 0.25)
		swordAura(character, 0.8, 26)
		task.delay(0.08, function()
			local tip = bladePoint(character, 1.8)
			if tip and character.Parent then
				U.glint(tip, 1.6, RED)
			end
		end)
		local window = if type(data.window) == "number" then data.window else 0.65
		openBarrier(character, root, window)
		-- The guard glows: the blade's edges burn for the whole window, a hot
		-- flare as the barrier opens and its red light on everything in front.
		edgeGlow(character, window, 0.9)
		glowBurst(root.Position + root.CFrame.LookVector * 2.4 + UP * 0.6, 3, 0.25)
		U.light(root.Position + root.CFrame.LookVector * 2.4, RED, 4, 14, window)
		local base = if air then root.Position - UP * 2.8 else feetOf(character, root) + UP * 0.1
		U.ringBurst(CFrame.new(base), DARK_RED, 1, 5, 0.3, 0.15)
		task.delay(0.05, U.ringBurst, CFrame.new(base + UP * 0.1), BLACK, 0.8, 6, 0.3, 0.2)
		blackSmoke(base + UP * 0.2, 6, 2, 5)
		U.flash(root.Position + root.CFrame.LookVector * 1.5, BLACK, 4, 0.15)
		U.light(root.Position, RED, 5, 12, 0.3)
		if U.isLocal(character) then
			CameraShake.FovKick(-3)
		end
	elseif phase == "Counter" then
		closeBarrier(character, true)
		play(character, ANIMS.DeflectCounter)
		local target = data.target
		local targetRoot = U.getRoot(target)
		local contact = if targetRoot
			then (root.Position + targetRoot.Position) / 2 + UP * 0.6
			else root.Position + look * 2.5
		local toward = if targetRoot then targetRoot.Position - root.Position else look
		local flat = Vector3.new(toward.X, 0, toward.Z)
		flat = if flat.Magnitude > 0.1 then flat.Unit else look

		-- Their attack lands on the anti-magic blade.
		U.sparks(contact, (flat + UP * 0.6).Unit, 1.6)
		U.flash(contact, WHITE, 6, 0.12)
		glowBurst(contact, 5, 0.3)
		bloomPulse(contact, 1, 0.3)
		if involves(data, character) then
			impactFrame(1.2)
			CameraShake.Add(0.45)
			CameraShake.FovKick(12)
		end
		PoseAnimator.Freeze(character, 0.08)
		U.popup(root.Position + UP * 4, "DEFLECT", RED, 1.6)

		-- Then the answer: a diagonal slash that throws them aside (the
		-- swing lands at 0.13s, plus the 0.08s freeze).
		task.delay(0.14, function()
			heavyTrail(character, 0.25)
			crescent(character, {
				center = CFrame.new(0, 0.6, 0),
				radius = 6,
				from = -110,
				to = 110,
				tilt = -35,
				width = 2.6,
				sweep = 0.07,
				fade = 0.3,
				glow = 1.1,
			})
			edgeGlow(character, 0.3, 1.2)
		end)
		task.delay(0.2, function()
			if not targetRoot then
				return
			end
			local p = targetRoot.Position + UP * 0.5
			local side = root.CFrame.RightVector
			slashMark(p, -0.6, 8, 0.35)
			task.delay(0.03, slashMark, p, -0.52, 6, 0.3)
			blackLightning(p, 6, 4.5)
			U.impactRing(p, side, RED, 0.8, 7, 0.3)
			task.delay(0.04, U.impactRing, p, side, BLACK, 0.6, 6, 0.3)
			blackSmoke(p, 14, 3.5, 20)
			U.burst(p, {
				color = RED,
				count = 18,
				size = 0.7,
				speed = NumberRange.new(30, 55),
				lifetime = NumberRange.new(0.15, 0.35),
				streaks = true,
				spread = 35,
				direction = side,
			})
			U.light(p, RED, 12, 22, 0.35)
		end)
	elseif phase == "Reflect" then
		closeBarrier(character, true)
		play(character, ANIMS.DeflectReflect)
		local direction: Vector3 = if typeof(data.direction) == "Vector3" then data.direction else look
		heavyTrail(character, 0.3)
		-- Wind-up to the left until 0.08s, then the swing across.
		task.delay(0.07, crescent, character, {
			center = CFrame.new(0, 0.4, 0),
			radius = 5.6,
			from = -120,
			to = 70,
			tilt = 4,
			width = 2.2,
			sweep = 0.08,
			fade = 0.26,
			glow = 1,
		})
		edgeGlow(character, 0.35, 1.1)
		local front = root.Position + direction * 3
		task.delay(0.12, glowBurst, front, 4, 0.28)
		task.delay(0.12, bloomPulse, front, 0.8, 0.25)
		task.delay(0.15, blackLightning, front, 4, 3.5, 0.2)
		task.delay(0.15, U.flash, front, RED, 4, 0.12)
		U.sparks(front, direction, 1.3)
		U.flash(front, BLACK, 8, 0.2)
		U.impactRing(front, direction, RED, 0.6, 6, 0.25)
		task.delay(0.05, U.impactRing, front + direction, direction, BLACK, 0.5, 5, 0.25)
		blackSmoke(front, 10, 3, 18)
		U.popup(root.Position + UP * 4, "REFLECT", RED, 1.5)
		if U.isLocal(character) then
			CameraShake.FovKick(8)
			CameraShake.Add(0.25)
		end
	elseif phase == "End" then
		closeBarrier(character, false)
	end
end

---------------------------------------------------------------------------
-- Black Form moves
---------------------------------------------------------------------------

-- Black Hurricane: four spins with the blade out, a black tornado around
-- him, a full circle of steel every turn, the ground torn up under him,
-- and a final outward blast.
-- The emitters of a spin in progress, so a hit can cut it short.
local hurricaneEmitters: { [Model]: { ParticleEmitter } } = setmetatable({}, { __mode = "k" }) :: any

function handlers.BlackHurricane(data, character, root)
	local token = bump(character)
	local spinning = hurricaneEmitters[character]
	hurricaneEmitters[character] = nil
	if spinning and data.phase ~= "Finish" then
		for _, emitter in spinning do
			emitter.Enabled = false
		end
	end
	if data.phase == "Spin" then
		local duration = if type(data.duration) == "number" then data.duration else 0.9
		local air = data.airborne == true
		play(character, ANIMS.Hurricane)
		local emitters: { ParticleEmitter } = {}
		hurricaneEmitters[character] = emitters
		heavyTrail(character, duration + 0.1)
		U.spiral(root, BLACK, 4.6, 3, duration + 0.05, 5, 0.9, 0.15)
		U.spiral(root, RED, 3.8, 3, duration + 0.05, 3, 0.3, 0.15)
		emitters[1] = partEmitter(root, {
			Texture = U.textures.Smoke,
			Color = ColorSequence.new(BLACK),
			LightEmission = 0,
			Size = NumberSequence.new(1.6, 4),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.4, 0.7),
			Rate = 90,
			Speed = NumberRange.new(8, 16),
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(25, 25),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-300, 300),
		}, duration)
		local blade = bladeOf(character)
		if blade then
			emitters[2] = partEmitter(blade, {
				Texture = U.textures.Spark,
				Color = ColorSequence.new(RED, DARK_RED),
				LightEmission = 1,
				Size = NumberSequence.new(0.35, 0),
				Lifetime = NumberRange.new(0.15, 0.35),
				Rate = 70,
				Speed = NumberRange.new(14, 28),
				SpreadAngle = Vector2.new(40, 40),
				Orientation = Enum.ParticleOrientation.VelocityParallel,
				Squash = NumberSequence.new(1.4),
			}, duration)
		end
		crackle(root, duration, 0.05, 4.5)
		-- A full circle of steel each turn (the body turns clockwise, blade out right).
		for i = 0, 3 do
			task.delay(0.1 + i * 0.2, function()
				if live(character, token) then
					crescent(character, {
						center = CFrame.new(0, 0.1, 0),
						radius = 5.4,
						from = 90,
						to = 450,
						tilt = 0,
						width = 1.5,
						sweep = 0.18,
						fade = 0.22,
					})
				end
			end)
		end
		if air then
			-- Drilling down out of the sky.
			local dive = root.CFrame.LookVector * 40 - UP * 35
			U.speedLines(root, dive.Unit, duration)
			U.bodyTrail(character, BLACK, duration)
		end
		-- Tearing up the ground as he goes; in the air, a vortex of
		-- anti-magic spinning off beneath him until he touches down.
		for i = 0, 8 do
			task.delay(i * 0.1, function()
				if not live(character, token) then
					return
				end
				local ground = U.groundBelow(root.Position, { character })
				if ground and root.Position.Y - ground.Position.Y < 4.5 then
					local feet = ground.Position
					U.groundCracks(feet, 3, 2.5, RED, 1)
					U.ringBurst(CFrame.new(feet + UP * 0.1), BLACK, 2, 7, 0.25, 0.25)
					U.debris(feet, 3, 26, 0.7)
					U.burst(feet, {
						texture = U.textures.Smoke,
						color = Color3.fromRGB(150, 140, 130),
						count = 3,
						size = 3,
						speed = NumberRange.new(8, 16),
						lifetime = NumberRange.new(0.4, 0.7),
						lightEmission = 0,
						transparency = 0.5,
						drag = 3,
						spread = 80,
					})
				else
					local below = root.Position - UP * 2.6
					U.ringBurst(CFrame.new(below), if i % 2 == 0 then BLACK else RED, 1.5, 6.5, 0.22, 0.2)
					blackSmoke(below, 3, 2.2, 8)
					redSparks(below, 4, 0.6, -UP)
				end
				if U.isLocal(character) then
					CameraShake.Add(0.05)
				end
			end)
		end
		if U.isLocal(character) then
			CameraShake.FovKick(8)
		end
	elseif data.phase == "Stop" then
		-- Knocked out of the spin: the trails above are already cut off.
		blackSmoke(root.Position, 8, 3, 8)
	elseif data.phase == "Finish" then
		local position = root.Position
		local ground = U.groundBelow(position, { character })
		local grounded = ground ~= nil and position.Y - ground.Position.Y < 4.5
		local feet = if ground and grounded then ground.Position else position - UP * 3
		-- The last turn carries on round into the finishing cut (right to back-left).
		crescent(character, {
			center = CFrame.new(0, 0.2, 0),
			radius = 7,
			from = 80,
			to = -150,
			tilt = -8,
			width = 2.4,
			sweep = 0.09,
			fade = 0.3,
		})
		U.flash(position, BLACK, 14, 0.3)
		U.flash(position, RED, 9, 0.22)
		U.shockwave(position, RED, 2, 20, 0.4)
		if grounded then
			U.shockwave(feet, BLACK, 3, 18, 0.45, Enum.Material.Glass, 0.4)
			U.ringBurst(CFrame.new(feet + UP * 0.2), BLACK, 1, 16, 0.4, 0.6)
			task.delay(0.04, U.ringBurst, CFrame.new(feet + UP * 0.3), RED, 1, 12, 0.35, 0.3)
			U.groundCracks(feet, 10, 8, RED, 2.5)
			U.debris(feet, 14, 45, 1.1)
		else
			-- In the air: the cut spikes them down, a blast ringing out beneath.
			U.impactRing(position - UP * 2, -UP, BLACK, 1.5, 16, 0.45)
			task.delay(0.04, U.impactRing, position - UP * 3, -UP, RED, 1, 11, 0.35)
			redSparks(position, 20, 1, -UP)
		end
		blackLightning(position, 10, 9, 0.3)
		blackSmoke(position, 20, 5, 26)
		redSparks(position + UP, 30, 1.2)
		U.light(position, RED, 12, 30, 0.45)
		if U.isLocal(character) then
			impactFrame(0.8)
			CameraShake.Add(0.4)
		end
	end
end

-- Black Slash: anti-magic floods the blade as he winds up, then the wave
-- is thrown off it.
function handlers.BlackSlash(data, character, root)
	if data.phase == "Windup" then
		play(character, ANIMS.BlackSlash)
		swordGlow(character, RED, 0.3, 0.3)
		swordAura(character, 0.3, 40)
		task.delay(0.11, heavyTrail, character, 0.25)
		for i = 0, 5 do
			task.delay(i * 0.03, function()
				local blade = bladeOf(character)
				if blade then
					inflow(blade.Position, 5)
				end
			end)
		end
	elseif data.phase == "Projectile" then
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local grand = data.grand == true
		slashWave(data)
		U.flash(origin, BLACK, if grand then 16 else 8, 0.22)
		U.flash(origin, RED, if grand then 10 else 5, 0.15)
		U.impactRing(origin, direction, RED, 1, if grand then 12 else 7, 0.25)
		task.delay(0.04, U.impactRing, origin + direction * 2, direction, BLACK, 0.8, if grand then 10 else 6, 0.25)
		U.burst(origin, {
			color = RED,
			count = if grand then 28 else 14,
			size = 0.7,
			speed = NumberRange.new(35, 65),
			lifetime = NumberRange.new(0.15, 0.35),
			streaks = true,
			spread = 30,
			direction = direction,
		})
		blackLightning(origin, if grand then 8 else 4, if grand then 7 else 4)
		U.light(origin, RED, if grand then 12 else 7, if grand then 30 else 18, 0.35)
		if U.isLocal(character) then
			CameraShake.FovKick(if grand then 12 else 6)
			CameraShake.Add(if grand then 0.3 else 0.12)
		end
	end
end

-- A fissure splitting open along the ground: dark cracks with a red glow,
-- rocks bursting up and black lightning running along it, one step at a time.
local function fissure(start: Vector3, direction: Vector3, length: number)
	local ground = U.groundBelow(start)
	if not ground then
		return
	end
	local floorY = ground.Position.Y
	local flat = Vector3.new(direction.X, 0, direction.Z).Unit
	local steps = math.floor(length / 3)
	-- The ground under a point along the line (cast from above, so it climbs
	-- slopes too); nil past a ledge, so the cracks stop at the edge.
	local function floorAt(distance: number): Vector3?
		local p = Vector3.new(start.X, floorY, start.Z) + flat * distance
		local hit = U.groundBelow(p + UP * 3)
		if not hit or hit.Position.Y < floorY - 4.5 then
			return nil
		end
		return hit.Position + UP * 0.05
	end
	for i = 0, steps - 1 do
		task.delay(i * 0.025, function()
			local a, b = floorAt(i * 3), floorAt(i * 3 + 3)
			if not (a and b) then
				return
			end
			local look = CFrame.lookAt((a + b) / 2, b)
			local segment = (b - a).Magnitude + 0.2
			local width = 1.6 * (1 - i / steps) + 0.5
			local crack = U.newPart({
				Size = Vector3.new(width, 0.08, segment),
				CFrame = look,
				Color = Color3.fromRGB(12, 11, 11),
				Material = Enum.Material.SmoothPlastic,
			})
			local hot = U.newPart({
				Size = Vector3.new(width * 0.45, 0.1, segment),
				CFrame = look + Vector3.new(0, 0.01, 0),
				Color = RED,
			})
			U.tween(hot, 1.2, { Transparency = 1 })
			task.delay(2.4, function()
				U.tween(crack, 0.6, { Transparency = 1 })
			end)
			task.delay(3.1, function()
				crack:Destroy()
				hot:Destroy()
			end)
			if i % 2 == 0 then
				U.groundRocks(b, 4, 1.6 + width * 0.5, 1.2 + width * 0.6)
				U.lightning(a + UP * 0.3, b + UP * 0.3 + U.randomUnit() * 0.8, BLACK, RED, 0.16, 0.25)
			end
			if i % 3 == 0 then
				blackSmoke(b + UP * 0.5, 4, 2.5, 6)
			end
		end)
	end
end

-- A giant anti-magic blade grown out of the sword while Grand Divider charges.
local grandBlades: { [Model]: () -> () } = setmetatable({}, { __mode = "k" }) :: any

local function growGrandBlade(character: Model, duration: number)
	local blade = bladeOf(character)
	if not blade then
		return
	end
	local core = U.newPart({ Size = Vector3.new(0.5, 0.1, 1.6), Color = BLACK, Material = Enum.Material.SmoothPlastic })
	local glow = U.newPart({ Size = Vector3.new(0.9, 0.1, 2.3), Color = RED, Transparency = 0.55 })
	local start = os.clock()
	local length = 0
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not blade.Parent then
			connection:Disconnect()
			core:Destroy()
			glow:Destroy()
			return
		end
		local t = os.clock() - start
		length = 10
			* TweenService:GetValue(math.clamp(t / duration, 0, 1), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local wobble = 1 + 0.06 * math.sin(t * 40)
		local base = alongBlade(blade, 2.1) * CFrame.new(0, length / 2, 0)
		core.Size = Vector3.new(0.45 * wobble, length + 0.1, 1.5)
		core.CFrame = base
		glow.Size = Vector3.new(0.9 * wobble, length + 0.6, 2.4 * wobble)
		glow.CFrame = base
	end)
	local function dissolve()
		grandBlades[character] = nil
		connection:Disconnect()
		U.tween(core, 0.3, { Transparency = 1, Size = core.Size * Vector3.new(0.2, 1, 0.2) })
		U.tween(glow, 0.25, { Transparency = 1 })
		task.delay(0.35, function()
			core:Destroy()
			glow:Destroy()
		end)
	end
	grandBlades[character] = dissolve
	task.delay(duration + 1.5, function()
		if grandBlades[character] == dissolve then
			dissolve()
		end
	end)
end

-- Grand Divider: the sword raised to the sky grows a giant blade of
-- anti-magic, then comes down in one cleave that splits the ground open.
function handlers.GrandDivider(data, character, root)
	local phase = data.phase
	local token = bump(character)
	local air = data.airborne == true
	if phase == "Charge" then
		play(character, if air then ANIMS.AirDividerCharge else ANIMS.GrandCharge)
		swordGlow(character, BLACK, 0.75, 0.25)
		swordAura(character, 0.75, 50)
		growGrandBlade(character, 0.6)
		if air then
			-- Hanging in the sky: the rings close in around him instead.
			U.ringBurst(CFrame.new(root.Position), BLACK, 12, 2, 0.7, 0.35)
			task.delay(0.3, U.ringBurst, CFrame.new(root.Position), DARK_RED, 10, 1.5, 0.4, 0.2)
			U.ringBurst(CFrame.new(root.Position) * CFrame.Angles(rad(90), 0, 0), BLACK, 10, 2, 0.7, 0.3)
			blackSmoke(root.Position, 12, 3, 8)
		else
			local feet = feetOf(character, root)
			U.ringBurst(CFrame.new(feet + UP * 0.1), BLACK, 12, 2, 0.7, 0.35)
			task.delay(0.3, U.ringBurst, CFrame.new(feet + UP * 0.12), DARK_RED, 10, 1.5, 0.4, 0.2)
			task.delay(0.25, U.groundCracks, feet, 8, 6, RED, 2)
			blackSmoke(feet + UP * 0.3, 12, 3, 8)
		end
		-- Anti-magic piling in from everywhere, a column rising off the blade.
		local start = os.clock()
		task.spawn(function()
			while os.clock() - start < 0.7 and live(character, token) do
				local tip = bladePoint(character, 2.1)
				if tip then
					inflow(tip, 9)
					inflow(tip, 6)
					if math.random() < 0.5 then
						blackLightning(tip + UP * 3, 1, 4, 0.14)
					end
				end
				if U.isLocal(character) then
					CameraShake.Add(0.04)
				end
				task.wait(0.04)
			end
		end)
		for _, at in { 0.2, 0.45 } do
			task.delay(at, function()
				local tip = bladePoint(character, 2.1)
				if tip and live(character, token) then
					U.pillar(tip, BLACK, 1.2, 40, 0.5, Enum.Material.SmoothPlastic, 0.2)
					U.pillar(tip, RED, 0.6, 46, 0.4)
				end
			end)
		end
		if U.isLocal(character) then
			CameraShake.FovKick(-6)
		end
	elseif phase == "Cancel" then
		local dissolve = grandBlades[character]
		if dissolve then
			dissolve()
		end
		blackSmoke(root.Position + UP * 3, 8, 3, 6)
	elseif phase == "Release" then
		play(character, if air then ANIMS.AirDividerRelease else ANIMS.GrandRelease)
		heavyTrail(character, 0.35)
		crescent(character, {
			center = CFrame.new(0, 0.6, 0),
			radius = 10,
			from = 100,
			to = if air then -260 else -40, -- in the air, a whole front flip of steel
			tilt = 90,
			width = 3.6,
			sweep = if air then 0.16 else 0.1,
			fade = 0.35,
		})
		task.delay(0.35, function()
			local dissolve = grandBlades[character]
			if dissolve then
				dissolve()
			end
		end)
		local look = root.CFrame.LookVector
		local forward = Vector3.new(look.X, 0, look.Z).Unit
		-- The ground takes the blow (in the air, wherever the cleave comes down).
		local function groundStrike(strike: Vector3)
			U.flash(strike + UP, WHITE, 6, 0.08)
			U.flash(strike + UP, BLACK, 16, 0.35)
			U.flash(strike + UP, RED, 10, 0.25)
			U.shockwave(strike, BLACK, 4, 28, 0.5, Enum.Material.Glass, 0.35)
			U.shockwave(strike, RED, 3, 22, 0.45)
			U.ringBurst(CFrame.new(strike + UP * 0.2), BLACK, 1, 18, 0.45, 0.7)
			task.delay(0.05, U.ringBurst, CFrame.new(strike + UP * 0.3), RED, 1, 13, 0.4, 0.35)
			U.groundCracks(strike, 12, 10, RED, 3)
			U.groundRocks(strike, 14, 5, 2.6)
			U.debris(strike, 18, 50, 1.3)
			blackSmoke(strike + UP, 24, 6, 30)
			blackLightning(strike + UP, 10, 9, 0.3)
			U.light(strike + UP * 2, RED, 14, 40, 0.5)
			fissure(strike, forward, 42)
		end
		task.delay(0.08, function()
			if not character.Parent then
				return
			end
			if air then
				-- The cleave bursts out below and in front of him.
				local burst = root.Position + forward * 4 - UP * 3
				U.flash(burst, WHITE, 5, 0.08)
				U.flash(burst, BLACK, 13, 0.3)
				U.flash(burst, RED, 8, 0.22)
				U.impactRing(burst, -UP, BLACK, 2, 18, 0.45)
				task.delay(0.04, U.impactRing, burst, -UP, RED, 1.5, 13, 0.4)
				blackLightning(burst, 8, 7, 0.28)
				redSparks(burst, 24, 1.1, -UP)
				U.light(burst, RED, 12, 30, 0.4)
				local ground = U.groundBelow(burst, { character }, 60)
				if ground then
					local drop = burst.Y - ground.Position.Y
					task.delay(math.clamp(drop / 150, 0, 0.35), function()
						groundStrike(ground.Position)
					end)
				end
			else
				groundStrike(feetOf(character, root) + forward * 4.5)
			end
			if U.isLocal(character) then
				impactFrame(1.2)
				U.screenFlash(RED, 0.35)
				CameraShake.FovKick(14)
				CameraShake.Add(0.5)
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Special (R): Anti-Magic Leap / Meteor Plunge
---------------------------------------------------------------------------

function handlers.Special(data, character, root)
	local phase = data.phase
	if phase == "Leap" then
		play(character, ANIMS.Leap)
		local feet = feetOf(character, root)
		-- Blasting off a burst of anti-magic.
		U.flash(feet + UP * 0.5, BLACK, 8, 0.22)
		U.shockwave(feet, RED, 2, 12, 0.3)
		U.ringBurst(CFrame.new(feet + UP * 0.15), BLACK, 1, 9, 0.32, 0.4)
		task.delay(0.04, U.ringBurst, CFrame.new(feet + UP * 0.2), RED, 0.8, 6, 0.28, 0.18)
		U.groundCracks(feet, 6, 4.5, RED, 1.6)
		U.debris(feet, 7, 34, 0.9)
		blackSmoke(feet + UP * 0.4, 14, 3.2, 16)
		U.burst(feet, {
			texture = U.textures.Smoke,
			color = Color3.fromRGB(150, 140, 130),
			count = 10,
			size = 3.5,
			speed = NumberRange.new(10, 20),
			lifetime = NumberRange.new(0.5, 0.9),
			lightEmission = 0,
			transparency = 0.45,
			drag = 3,
			spread = 75,
		})
		U.light(feet, RED, 7, 16, 0.3)
		U.bodyTrail(character, BLACK, 0.6)
		U.speedLines(root, nil, 0.3)
		swordTrail(character, 0.5)
		for i = 0, 3 do
			task.delay(i * 0.06, function()
				if character.Parent then
					U.afterimage(character, if i % 2 == 0 then BLACK else DARK_RED, 0.25)
				end
			end)
		end
		if U.isLocal(character) then
			CameraShake.FovKick(10)
			CameraShake.Add(0.15)
		end
	elseif phase == "Plunge" then
		play(character, ANIMS.Plunge)
		swordGlow(character, BLACK, 0.4, 0.1)
		swordAura(character, 0.6, 40)
		crackle(root, 0.15, 0.04, 2.5)
		U.ringBurst(CFrame.new(root.Position), BLACK, 1, 5, 0.2, 0.15)
		task.delay(0.08, function()
			local tip = bladePoint(character, 2.1)
			if tip and character.Parent then
				U.glint(tip, 1.6, RED)
			end
		end)
	elseif phase == "Dive" then
		heavyTrail(character, 0.6)
		U.bodyTrail(character, RED, 0.6)
		U.speedLines(root, nil, 0.6)
		meteorTail(root, 0.5)
		if U.isLocal(character) then
			CameraShake.FovKick(10)
		end
	elseif phase == "Impact" then
		local position: Vector3 = data.position
		play(character, ANIMS.PlungeImpact)
		U.flash(position + UP, WHITE, 4, 0.07)
		U.flash(position + UP, BLACK, 11, 0.28)
		U.flash(position + UP, RED, 7, 0.2)
		U.shockwave(position, RED, 2, 17, 0.35)
		U.shockwave(position, BLACK, 3, 20, 0.4, Enum.Material.Glass, 0.45)
		U.ringBurst(CFrame.new(position + UP * 0.2), BLACK, 1, 13, 0.4, 0.5)
		task.delay(0.05, U.ringBurst, CFrame.new(position + UP * 0.3), RED, 0.8, 9, 0.32, 0.25)
		U.groundCracks(position, 9, 8, RED, 2.2)
		U.groundRocks(position, 10, 4, 2)
		U.debris(position, 12, 45, 1.1)
		U.pillar(position, BLACK, 1.6, 14, 0.4, Enum.Material.SmoothPlastic, 0.2)
		blackSmoke(position + UP, 18, 4.5, 24)
		for i = 1, 6 do
			local angle = (i / 6) * math.pi * 2 + math.random() * 0.5
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			U.lightning(
				position + UP * 0.4,
				position + out * (6 + math.random() * 5) + UP * 0.3,
				BLACK,
				RED,
				0.16,
				0.25
			)
		end
		redSparks(position + UP, 18, 1)
		U.light(position + UP * 2, RED, 10, 26, 0.45)
		lingerSmoke(position, 1, 5)
		if U.isLocal(character) then
			CameraShake.FovKick(10)
		end
	end
end

---------------------------------------------------------------------------
-- Black Form look: a devil wing with its own idle, a horn, black flames
---------------------------------------------------------------------------

--[[
	The wing is a two-bone arm (shoulder to wrist, wrist to tip) with
	feathers fanned off it, posed every frame from a few numbers:
	  lift  how high the upper bone rises (degrees)
	  back  how far it sweeps behind him
	  bend  the forearm's angle at the wrist (negative droops)
	  fan   how far the feathers spread apart
	  sway  how much the feathers ripple
	  beat  flap strength, at `rate` flaps per second
	Each state below sets targets and the live values ease toward them, so
	the wing breathes slowly when he stands, tucks back and flutters when he
	runs, beats hard in the air and snaps open in a big stretch now and then.
]]
type WingParams = {
	lift: number,
	back: number,
	bend: number,
	fan: number,
	sway: number,
	beat: number,
	rate: number,
}

local WING_STATES: { [string]: WingParams } = {
	folded = { lift = -65, back = 55, bend = -125, fan = 0.1, sway = 0, beat = 0, rate = 0.4 },
	stand = { lift = 30, back = 26, bend = -32, fan = 1, sway = 1, beat = 0.22, rate = 0.42 },
	run = { lift = 26, back = 60, bend = -28, fan = 1.15, sway = 0.7, beat = 0.08, rate = 2.4 },
	air = { lift = 26, back = 22, bend = -12, fan = 1.25, sway = 0.45, beat = 1, rate = 1.35 },
	-- Cutscene poses (BlackFormVisual.setPose): opened all the way with slow,
	-- heavy beats, and swept back for speed.
	spread = { lift = 40, back = 10, bend = 0, fan = 1.4, sway = 0.5, beat = 0.55, rate = 0.85 },
	glide = { lift = 16, back = 62, bend = -24, fan = 0.8, sway = 0.3, beat = 0.06, rate = 3 },
}

local UPPER_BONE, FOREARM = 2.2, 2.6

-- Feathers: which bone, where along it (0 to 1), fan angle out from
-- hanging straight down, length and width. Longest out at the tip.
local FEATHERS = {
	{ bone = 1, at = 0.25, angle = 4, length = 1.7, width = 0.55 },
	{ bone = 1, at = 0.55, angle = 10, length = 2.1, width = 0.58 },
	{ bone = 1, at = 0.85, angle = 16, length = 2.5, width = 0.6 },
	{ bone = 2, at = 0.15, angle = 22, length = 2.9, width = 0.6 },
	{ bone = 2, at = 0.4, angle = 30, length = 3.3, width = 0.6 },
	{ bone = 2, at = 0.62, angle = 40, length = 3.5, width = 0.58 },
	{ bone = 2, at = 0.82, angle = 52, length = 3.4, width = 0.55 },
	{ bone = 2, at = 1.0, angle = 66, length = 3.0, width = 0.5 },
	{ bone = 2, at = 1.0, angle = 84, length = 2.4, width = 0.45 },
}

-- Horn segments from the base up, curling out and back in.
local HORN = {
	{ size = Vector3.new(0.3, 0.42, 0.3), bend = rot(-10, 0, 14) },
	{ size = Vector3.new(0.23, 0.4, 0.23), bend = rot(-12, 0, 12) },
	{ size = Vector3.new(0.16, 0.36, 0.16), bend = rot(-14, 0, 10) },
	{ size = Vector3.new(0.09, 0.32, 0.09), bend = rot(0) },
}

-- Asta's grimoire (defined further down, with the sword swap that uses it).
type Grimoire = { open: (number) -> (), close: () -> (), burst: () -> () }
local grimoire: (character: Model, root: BasePart, place: ((t: number) -> CFrame)?) -> Grimoire

type BlackFormVisual = {
	-- His grimoire, circling him while Black Form lasts.
	book: Grimoire?,
	flap: (() -> ())?,
	-- Force a wing pose (a WING_STATES name), or nil to go back to normal.
	setPose: ((string?) -> ())?,
	-- A second wing on his right, for cutscenes (he normally has one).
	setPair: ((boolean) -> ())?,
	cleanup: { () -> () },
}
local awakenedVisuals: { [Model]: BlackFormVisual } = {}

local function lerpParams(from: WingParams, to: WingParams, alpha: number): WingParams
	local out = {} :: any
	for key, value in from do
		out[key] = value + ((to :: any)[key] - value) * alpha
	end
	return out
end

local function setAwakened(character: Model, on: boolean)
	local existing = awakenedVisuals[character]
	if existing then
		awakenedVisuals[character] = nil
		for _, cleanup in existing.cleanup do
			cleanup()
		end
	end
	if not on then
		return
	end

	local torso = character:FindFirstChild("Torso")
	local head = character:FindFirstChild("Head")
	local root = U.getRoot(character)
	if not (torso and torso:IsA("BasePart") and head and head:IsA("BasePart") and root) then
		return
	end
	local cleanup: { () -> () } = {}
	local visual: BlackFormVisual = { cleanup = cleanup }
	awakenedVisuals[character] = visual

	local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
		local e = Instance.new("ParticleEmitter")
		e.LightInfluence = 0
		for key, value in props do
			(e :: any)[key] = value
		end
		e.Parent = parent
		table.insert(cleanup, function()
			e.Enabled = false
			task.delay(1.2, e.Destroy, e)
		end)
		return e
	end

	-- Black flames rolling up off him, licks of dark red at the edges.
	emitter(torso, {
		Texture = U.textures.Smoke,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, BLACK),
			ColorSequenceKeypoint.new(0.7, BLACK),
			ColorSequenceKeypoint.new(1, DARK_RED),
		}),
		LightEmission = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 3.4) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.7),
			NumberSequenceKeypoint.new(0.25, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.6, 1),
		Rate = 40,
		Speed = NumberRange.new(2, 4),
		Acceleration = Vector3.new(0, 8, 0),
		SpreadAngle = Vector2.new(70, 70),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
	})
	emitter(torso, {
		Texture = U.textures.Smoke,
		Color = ColorSequence.new(BLACK),
		LightEmission = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) }),
		Squash = NumberSequence.new(-0.6),
		Transparency = NumberSequence.new(0.15, 1),
		Lifetime = NumberRange.new(0.35, 0.6),
		Rate = 30,
		Speed = NumberRange.new(4, 8),
		Acceleration = Vector3.new(0, 16, 0),
		SpreadAngle = Vector2.new(40, 40),
		EmissionDirection = Enum.NormalId.Top,
	})
	emitter(torso, {
		Texture = U.textures.Spark,
		Color = ColorSequence.new(RED),
		LightEmission = 1,
		Size = NumberSequence.new(0.25, 0),
		Lifetime = NumberRange.new(0.5, 0.9),
		Rate = 16,
		Speed = NumberRange.new(3, 7),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 5, 0),
	})

	-- Anti-magic swallowing the right arm.
	local arm = character:FindFirstChild("Right Arm")
	if arm and arm:IsA("BasePart") then
		local original = arm.Color
		arm.Color = BLACK
		emitter(arm, {
			Texture = U.textures.Smoke,
			Color = ColorSequence.new(BLACK),
			LightEmission = 0,
			Size = NumberSequence.new(0.7, 1.4),
			Transparency = NumberSequence.new(0.3, 1),
			Lifetime = NumberRange.new(0.3, 0.5),
			Rate = 18,
			Speed = NumberRange.new(0.5, 2),
			Acceleration = Vector3.new(0, 6, 0),
			SpreadAngle = Vector2.new(180, 180),
		})
		table.insert(cleanup, function()
			if arm.Parent then
				arm.Color = original
			end
		end)
	end

	-- The sword smoulders too, and stays dark and rimmed in red. Whichever
	-- sword he's holding: a swap (R in Black Form) dresses the new one.
	local swordDressing: { Instance } = {}
	local function dressSword()
		for _, instance in swordDressing do
			instance:Destroy()
		end
		table.clear(swordDressing)
		local sword = getSword(character)
		local blade = bladeOf(character)
		if not sword or not blade then
			return
		end
		table.insert(
			swordDressing,
			emitter(blade, {
				Texture = U.textures.Smoke,
				Color = ColorSequence.new(BLACK),
				LightEmission = 0,
				Size = NumberSequence.new(0.5, 1.1),
				Transparency = NumberSequence.new(0.35, 1),
				Lifetime = NumberRange.new(0.25, 0.45),
				Rate = 14,
				Speed = NumberRange.new(0.5, 2),
				Acceleration = Vector3.new(0, 5, 0),
				SpreadAngle = Vector2.new(180, 180),
			})
		)
		table.insert(
			swordDressing,
			emitter(blade, {
				Texture = U.textures.Spark,
				Color = ColorSequence.new(RED),
				LightEmission = 1,
				Size = NumberSequence.new(0.18, 0),
				Lifetime = NumberRange.new(0.2, 0.4),
				Rate = 5,
				Speed = NumberRange.new(1, 3),
				SpreadAngle = Vector2.new(180, 180),
			})
		)
		local swordLook = Instance.new("Highlight")
		swordLook.Adornee = sword
		swordLook.FillColor = BLACK
		swordLook.FillTransparency = 0.6
		swordLook.OutlineColor = RIM_RED
		swordLook.OutlineTransparency = 0.2
		swordLook.DepthMode = Enum.HighlightDepthMode.Occluded
		swordLook.Parent = U.folder
		table.insert(swordDressing, swordLook)
	end
	dressSword()
	local swordAdded = character.ChildAdded:Connect(function(child)
		if child.Name == "KitWeapon" then
			task.defer(dressSword)
		end
	end)
	table.insert(cleanup, function()
		swordAdded:Disconnect()
		for _, instance in swordDressing do
			instance:Destroy()
		end
	end)

	-- A red rim that breathes slowly (see the frame loop below), with the
	-- faintest red glow over him; his avatar shows through.
	local outline = Instance.new("Highlight")
	outline.Adornee = character
	outline.FillColor = Color3.fromRGB(45, 4, 10)
	outline.FillTransparency = 0.8
	outline.OutlineColor = RIM_RED
	outline.OutlineTransparency = 0.12
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.Parent = character
	local rimGlow = Instance.new("PointLight")
	rimGlow.Color = RIM_RED
	rimGlow.Brightness = 0.6
	rimGlow.Range = 7
	rimGlow.Shadows = false
	rimGlow.Parent = torso
	table.insert(cleanup, function()
		outline:Destroy()
		rimGlow:Destroy()
	end)

	-----------------------------------------------------------------------
	-- Wing, horn and ground aura: anchored parts posed every frame.
	-----------------------------------------------------------------------
	local parts: { BasePart } = {}
	local function piece(props: { [string]: any }): BasePart
		local part = U.newPart(props)
		table.insert(parts, part)
		return part
	end
	local matte = Enum.Material.SmoothPlastic

	--[[
		One wing. mirror = 1 is his left wing (built out along -X from his
		left shoulder blade), -1 the same wing mirrored onto his right.
		Mirroring flips X offsets and the Y/Z rotations.
	]]
	type Wing = {
		parts: { BasePart },
		edges: { [BasePart]: boolean },
		emitters: { ParticleEmitter },
		shown: number,
		target: number,
		applied: number,
		pose: (
			torsoFrame: CFrame,
			lift: number,
			back: number,
			bend: number,
			fan: number,
			sweep: number,
			sway: number,
			beat: number,
			waveLag: number,
			t: number,
			running: boolean
		) -> (),
	}
	local function newWing(mirror: number, shown: number): Wing
		local m = mirror
		local wingParts: { BasePart } = {}
		local function wingPiece(props: { [string]: any }): BasePart
			local part = piece(props)
			table.insert(wingParts, part)
			return part
		end
		local upperBone = wingPiece({ Size = Vector3.new(UPPER_BONE, 0.32, 0.32), Color = BLACK, Material = matte })
		local forearm = wingPiece({ Size = Vector3.new(FOREARM, 0.24, 0.24), Color = BLACK, Material = matte })
		local upperEdge = wingPiece({ Size = Vector3.new(UPPER_BONE, 0.07, 0.07), Color = DARK_RED })
		local forearmEdge = wingPiece({ Size = Vector3.new(FOREARM, 0.06, 0.06), Color = DARK_RED })
		local wrist =
			wingPiece({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.42, Color = BLACK, Material = matte })
		local claw = wingPiece({ Size = Vector3.new(0.14, 0.7, 0.14), Color = BLACK, Material = matte })
		local feathers: { { plate: BasePart, tip: BasePart } } = {}
		for _, feather in FEATHERS do
			table.insert(feathers, {
				plate = wingPiece({
					Size = Vector3.new(feather.width, feather.length, 0.07),
					Color = BLACK,
					Material = matte,
				}),
				tip = wingPiece({
					Size = Vector3.new(feather.width * 0.7, feather.width * 0.7, 0.065),
					Color = BLACK,
					Material = matte,
				}),
			})
		end

		-- Smoke streaming off the wingtip, embers off the forearm.
		local wingEmitters = {
			emitter(feathers[#feathers - 1].tip, {
				Texture = U.textures.Smoke,
				Color = ColorSequence.new(BLACK),
				LightEmission = 0,
				Size = NumberSequence.new(0.6, 1.6),
				Transparency = NumberSequence.new(0.35, 1),
				Lifetime = NumberRange.new(0.4, 0.7),
				Rate = 16,
				Speed = NumberRange.new(0.5, 1.5),
				Acceleration = Vector3.new(0, 4, 0),
				SpreadAngle = Vector2.new(180, 180),
			}),
			emitter(forearm, {
				Texture = U.textures.Spark,
				Color = ColorSequence.new(RED),
				LightEmission = 1,
				Size = NumberSequence.new(0.2, 0),
				Lifetime = NumberRange.new(0.4, 0.8),
				Rate = 6,
				Speed = NumberRange.new(1, 3),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 3, 0),
			}),
		}

		local function pose(
			torsoFrame: CFrame,
			lift: number,
			back: number,
			bend: number,
			fan: number,
			sweep: number,
			sway: number,
			beat: number,
			waveLag: number,
			t: number,
			running: boolean
		)
			-- Bones.
			local shoulderFrame = torsoFrame
				* CFrame.new(-0.6 * m, 0.55, 0.55) -- upper back
				* CFrame.Angles(0, rad(back) * m, 0)
				* CFrame.Angles(0, 0, rad(-lift) * m)
			local wristFrame = shoulderFrame
				* CFrame.new(-UPPER_BONE * m, 0, 0)
				* CFrame.Angles(0, rad(10 + sweep * 0.2) * m, 0)
				* CFrame.Angles(0, 0, rad(-bend) * m)
			upperBone.CFrame = shoulderFrame * CFrame.new(-UPPER_BONE / 2 * m, 0, 0)
			upperEdge.CFrame = shoulderFrame * CFrame.new(-UPPER_BONE / 2 * m, 0.17, -0.05)
			forearm.CFrame = wristFrame * CFrame.new(-FOREARM / 2 * m, 0, 0)
			forearmEdge.CFrame = wristFrame * CFrame.new(-FOREARM / 2 * m, 0.13, -0.05)
			wrist.CFrame = wristFrame
			claw.CFrame = wristFrame * CFrame.Angles(0, 0, rad(40) * m) * CFrame.new(0, 0.4, 0)

			-- Feathers: fanned out, rippling from the root to the tip.
			for i, feather in FEATHERS do
				local frame = if feather.bone == 1 then shoulderFrame else wristFrame
				local length = if feather.bone == 1 then UPPER_BONE else FOREARM
				local ripple = math.sin(t * 2.6 - i * 0.45) * 4 * sway
					+ math.sin(t * 13 - i * 0.7) * 3 * (if running then 1 else 0)
				local twist = math.sin(t * 1.9 - i * 0.5) * 7 * sway - 9 * beat * waveLag
				local joint = frame
					* CFrame.new(-length * feather.at * m, 0, 0.03 * i)
					* CFrame.Angles(rad(twist), 0, 0)
					* CFrame.Angles(0, 0, rad(-(feather.angle * fan + ripple)) * m)
				local pair = feathers[i]
				pair.plate.CFrame = joint * CFrame.new(0, -feather.length / 2, 0)
				pair.tip.CFrame = joint * CFrame.new(0, -feather.length, 0) * CFrame.Angles(0, 0, rad(45))
			end
		end

		return {
			parts = wingParts,
			edges = { [upperEdge] = true, [forearmEdge] = true },
			emitters = wingEmitters,
			shown = shown,
			target = shown,
			applied = -1,
			pose = pose,
		}
	end
	local wings = { newWing(1, 1), newWing(-1, 0) }

	local hornParts: { BasePart } = {}
	for _, segment in HORN do
		table.insert(hornParts, piece({ Size = segment.size, Color = BLACK, Material = matte }))
	end
	local disc = piece({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.06, 7, 7),
		Color = BLACK,
		Material = matte,
		Transparency = 0.55,
	})
	local discRim = piece({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.05, 7.6, 7.6),
		Color = DARK_RED,
		Transparency = 0.65,
	})

	-- Hidden until the first frame poses them (they're built at the origin).
	for _, part in parts do
		part.Transparency = 1
	end

	local current: WingParams = table.clone(WING_STATES.folded)
	local phase = 0
	local state = "stand"
	local born = os.clock()
	local flapStart = -10
	local nextStretch = os.clock() + 4 + math.random() * 4
	local nextCrackle = os.clock() + 0.5
	local nextPulse = os.clock() + 1
	local groundY: number? = nil
	local nextGroundCheck = 0
	local fading: number? = nil
	local FADE = 0.4

	-- A big beat: the Stance in the awakening, and now and then when idle.
	visual.flap = function()
		flapStart = os.clock()
	end
	local forcedPose: string? = nil
	visual.setPose = function(name: string?)
		forcedPose = if name and WING_STATES[name] then name else nil
	end
	visual.setPair = function(on: boolean)
		local second = wings[2]
		second.target = if on then 1 else 0
		if on and second.shown < 0.5 then
			-- It forms out of black smoke.
			blackSmoke(torso.Position + torso.CFrame.RightVector * 2.5 + torso.CFrame.LookVector * -1, 10, 3, 6)
		end
	end
	local hornBase = CFrame.new(0.42, 0.42, -0.1) * rot(0, 0, -34)
	local face = CFrame.Angles(0, 0, rad(90)) -- cylinder X axis up

	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		if not torso.Parent or not head.Parent or not root.Parent then
			connection:Disconnect()
			for _, part in parts do
				part:Destroy()
			end
			return
		end
		-- The rim breathes: a slow, soft swell.
		local breath = 0.5 + 0.5 * math.sin((now - born) * 2.2)
		outline.OutlineTransparency = 0.18 - 0.12 * breath
		rimGlow.Brightness = 0.45 + 0.35 * breath

		-- What is he doing? Ground check a few times a second.
		if now >= nextGroundCheck then
			nextGroundCheck = now + 0.1
			local ground = U.groundBelow(root.Position, { character })
			groundY = if ground and root.Position.Y - ground.Position.Y < 4.4 then ground.Position.Y else nil
		end
		local velocity = root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		local newState = if groundY == nil then "air" elseif speed > 4 then "run" else "stand"
		if newState == "air" and state ~= "air" then
			phase = 0.25 -- start the first beat from the top
		end
		state = newState

		-- Ease toward the state's pose; unfurl from folded when it appears.
		local unfurl = math.clamp((now - born) / 0.55, 0, 1)
		local reveal = TweenService:GetValue(unfurl, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		local target = lerpParams(WING_STATES.folded, WING_STATES[forcedPose or state], reveal)
		local ease = 1 - math.exp(-dt * (if unfurl < 1 then 30 else 7))
		current = lerpParams(current, target, ease)
		phase = (phase + dt * current.rate) % 1

		-- Idle stretch every so often.
		if state == "stand" and now >= nextStretch then
			nextStretch = now + 7 + math.random() * 5
			flapStart = now
		end
		local flapAge = now - flapStart
		local flap = if flapAge < 0.9 then math.sin(math.pi * flapAge / 0.9) else 0
		local flapLag = if flapAge > 0.12 and flapAge < 1.02 then math.sin(math.pi * (flapAge - 0.12) / 0.9) else 0

		local wave = math.sin(phase * math.pi * 2)
		local waveLag = math.sin(phase * math.pi * 2 - 0.9)
		local lift = current.lift + 28 * current.beat * wave + 34 * flap
		local bend = current.bend + 22 * current.beat * waveLag + 26 * flapLag
		local back = current.back - 10 * flap
		local fan = current.fan + 0.3 * flap

		-- Both wings (the second only shows in cutscenes).
		local t = now - born
		for _, wing in wings do
			wing.shown += (wing.target - wing.shown) * math.min(dt * 6, 1)
			if wing.shown > 0.01 then
				wing.pose(
					torso.CFrame,
					lift,
					back,
					bend,
					fan,
					current.back,
					current.sway,
					current.beat,
					waveLag,
					t,
					state == "run" and forcedPose == nil
				)
			end
		end

		-- Horn.
		local hornFrame = head.CFrame * hornBase
		for i, segment in HORN do
			local height = segment.size.Y
			hornParts[i].CFrame = hornFrame * CFrame.new(0, height / 2, 0)
			hornFrame = hornFrame * CFrame.new(0, height * 0.9, 0) * segment.bend
		end

		-- Dark pool under his feet (only when standing on something).
		if groundY then
			local pulse = 1 + 0.06 * math.sin(t * 2)
			local spot = Vector3.new(root.Position.X, groundY + 0.06, root.Position.Z)
			disc.CFrame = CFrame.new(spot) * face
			disc.Size = Vector3.new(0.06, 7 * pulse, 7 * pulse)
			discRim.CFrame = CFrame.new(spot - Vector3.new(0, 0.01, 0)) * face
			discRim.Size = Vector3.new(0.05, 7.7 * pulse, 7.7 * pulse)
		end
		local poolShown = groundY ~= nil and not fading
		disc.Transparency = if poolShown then 0.55 else 1
		discRim.Transparency = if poolShown then 0.65 else 1

		-- Little things: crackles off his body, pressure rings on the ground.
		if not fading and now >= nextCrackle then
			nextCrackle = now + 0.45 + math.random() * 0.7
			local from = torso.Position + U.randomUnit() * 1.2
			U.lightning(from, from + U.randomUnit() * 3.2, BLACK, RED, 0.08, 0.14, false)
		end
		if not fading and groundY and now >= nextPulse then
			nextPulse = now + 1.6
			U.ringBurst(CFrame.new(root.Position.X, groundY + 0.1, root.Position.Z), DARK_RED, 2, 6, 0.6, 0.08)
		end

		-- Grow in when it appears, dissolve when Black Form ends.
		local visible = math.clamp((now - born) / 0.3, 0, 1)
		if fading then
			visible = 1 - (now - fading) / FADE
			if visible <= 0 then
				connection:Disconnect()
				for _, part in parts do
					part:Destroy()
				end
				return
			end
		end
		if visible < 1 or fading or now - born < 0.35 then
			for _, part in hornParts do
				part.Transparency = 1 - visible
			end
		end
		for _, wing in wings do
			local alpha = math.floor(visible * wing.shown * 50 + 0.5) / 50
			if alpha ~= wing.applied then
				wing.applied = alpha
				for _, part in wing.parts do
					local base = if wing.edges[part] then 0.2 else 0
					part.Transparency = base + (1 - base) * (1 - alpha)
				end
				for _, e in wing.emitters do
					e.Enabled = alpha > 0.5 and not fading
				end
			end
		end
	end)
	-- His grimoire comes out and circles him the whole time, open, bobbing
	-- on the air and turning to keep its pages towards him.
	local book = grimoire(character, root, function(t: number): CFrame
		local angle = t * 1.3
		local position = root.Position
			+ Vector3.new(math.cos(angle) * 2.8, 1.2 + math.sin(t * 2.1) * 0.35, math.sin(angle) * 2.8)
		return CFrame.lookAt(position, root.Position + UP * 1.2) * CFrame.Angles(rad(-15), 0, math.sin(t * 1.7) * 0.15)
	end)
	book.open(0.6)
	visual.book = book
	table.insert(cleanup, book.close)

	table.insert(cleanup, function()
		fading = os.clock()
		if torso.Parent then
			U.burst(torso.Position + torso.CFrame.LookVector * -1, {
				color = BLACK,
				count = 14,
				size = 0.5,
				speed = NumberRange.new(4, 10),
				lifetime = NumberRange.new(0.8, 1.4),
				lightEmission = 0,
				acceleration = Vector3.new(0, -6, 0),
				drag = 1,
			})
		end
	end)
end

---------------------------------------------------------------------------
-- Awakening: the transformation into Black Form
---------------------------------------------------------------------------

local AWAKEN_BURST = 0.92 -- the roar in the Awaken animation; the server bursts here too

-- When the Black Form look should pop in (at the burst, not before).
local revealAt: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any

local function refreshAwakened(character: Model)
	local on = character:GetAttribute("Awakened") == true
	if on and awakenedVisuals[character] then
		return
	end
	setAwakened(character, on)
end

-- What the burst consumes from the gathering: the pool and floating rocks.
local gathering: { [Model]: { BasePart } } = setmetatable({}, { __mode = "k" }) :: any

local function awakenGather(character: Model, root: BasePart)
	local feet = feetOf(character, root)
	local mine = U.isLocal(character)
	local made: { BasePart } = {}
	gathering[character] = made

	-- Darkness pooling out under him, a red rim at its edge.
	local face = CFrame.Angles(0, 0, rad(90))
	local pool = U.newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.08, 1, 1),
		CFrame = CFrame.new(feet + UP * 0.06) * face,
		Color = BLACK,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.15,
	})
	local rim = U.newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.06, 1.4, 1.4),
		CFrame = CFrame.new(feet + UP * 0.05) * face,
		Color = DARK_RED,
		Transparency = 0.45,
	})
	U.tween(pool, 0.9, { Size = Vector3.new(0.08, 22, 22) }, Enum.EasingStyle.Quart)
	U.tween(rim, 0.9, { Size = Vector3.new(0.06, 23.2, 23.2) }, Enum.EasingStyle.Quart)
	table.insert(made, pool)
	table.insert(made, rim)

	-- Rocks tearing loose and floating up around him.
	local ground = U.groundBelow(feet + UP)
	local rockColor = if ground and ground.Instance:IsA("BasePart")
		then ground.Instance.Color
		else Color3.fromRGB(90, 88, 85)
	local rockMaterial = if ground then ground.Material else Enum.Material.Slate
	for i = 1, 10 do
		local angle = (i / 10) * math.pi * 2 + math.random() * 0.5
		local distance = 3.5 + math.random() * 5
		local size = 0.5 + math.random() * 0.9
		local start = feet + Vector3.new(math.cos(angle) * distance, -size, math.sin(angle) * distance)
		local rock = U.newPart({
			Size = Vector3.one * size,
			CFrame = CFrame.new(start) * U.randomAngles(),
			Color = rockColor,
			Material = rockMaterial,
		})
		rock.CastShadow = true
		local lift = 1.5 + math.random() * 4
		U.tween(rock, 0.9, {
			CFrame = CFrame.new(start + UP * lift) * U.randomAngles(),
		}, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		table.insert(made, rock)
	end

	-- Anti-magic spiralling in and crawling up his body.
	U.spiral(root, BLACK, 6.5, 2.5, 0.9, 4, 0.7, 0.85)
	U.spiral(root, RED, 5.5, 2.5, 0.9, 2, 0.2, 0.85)
	task.delay(0.35, U.groundCracks, feet, 6, 5, RED, 2.5)
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < AWAKEN_BURST - 0.02 and root.Parent do
			local angle = math.random() * math.pi * 2
			local from = feet + Vector3.new(math.cos(angle), 0.2, math.sin(angle)) * (1 + math.random() * 2.5)
			U.lightning(from, root.Position + U.randomUnit() * Vector3.new(1, 2, 1), BLACK, RED, 0.1, 0.12)
			if math.random() < 0.5 then
				inflow(root.Position + UP * 0.5, 6)
			end
			if math.random() < 0.3 then
				blackSmoke(feet + U.randomUnit() * Vector3.new(4, 0, 4) + UP * 0.3, 2, 2.5, 3)
			end
			if mine then
				CameraShake.Add(0.035)
			end
			task.wait(0.06)
		end
	end)

	-- For whoever is transforming: the world dims and the view closes in.
	if mine then
		U.colorGrade({
			Brightness = -0.12,
			Contrast = 0.3,
			Saturation = -0.65,
			TintColor = Color3.fromRGB(255, 225, 225),
		}, 0.85, 0.05, 0.6)
		local camera = workspace.CurrentCamera
		TweenService
			:Create(
				camera,
				TweenInfo.new(0.88, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ FieldOfView = 56 }
			)
			:Play()
		-- The burst kicks it back out; if the burst never comes, restore it.
		task.delay(AWAKEN_BURST + 0.6, function()
			if camera.FieldOfView < 69 then
				TweenService:Create(camera, TweenInfo.new(0.3), { FieldOfView = 70 }):Play()
			end
		end)
	end
end

local function awakenBurst(character: Model, root: BasePart)
	local feet = feetOf(character, root)
	local center = root.Position

	-- The gathering gets blown away.
	local consumed = gathering[character]
	if consumed then
		for _, part in consumed do
			if part.Parent then
				if part.Shape == Enum.PartType.Cylinder then
					U.tween(part, 0.3, { Size = part.Size * Vector3.new(1, 1.6, 1.6), Transparency = 1 })
				else
					local out = part.Position - center
					out = Vector3.new(out.X, 0, out.Z).Unit
					U.tween(part, 0.4, {
						CFrame = CFrame.new(part.Position + out * 16 + UP * 5) * U.randomAngles(),
						Transparency = 1,
					}, Enum.EasingStyle.Quad)
				end
				task.delay(0.45, part.Destroy, part)
			end
		end
	end
	gathering[character] = nil

	-- The blast.
	U.flash(center, WHITE, 5, 0.08)
	U.flash(center, BLACK, 24, 0.45)
	U.flash(center, RED, 14, 0.3)
	U.shockwave(feet, BLACK, 4, 52, 0.7, Enum.Material.Glass, 0.3)
	U.shockwave(center, RED, 3, 40, 0.55)
	task.delay(0.08, U.shockwave, center, DARK_RED, 2, 28, 0.5)
	U.ringBurst(CFrame.new(feet + UP * 0.2), BLACK, 2, 34, 0.6, 0.9)
	task.delay(0.04, U.ringBurst, CFrame.new(feet + UP * 0.3), RED, 2, 26, 0.5, 0.45)
	task.delay(0.08, U.ringBurst, CFrame.new(feet + UP * 0.4), WHITE, 1, 18, 0.3, 0.15)
	U.impactRing(center, root.CFrame.LookVector, BLACK, 2, 18, 0.5)
	U.impactRing(center, root.CFrame.RightVector, RED, 2, 14, 0.45)

	-- A black pillar punching up into the sky.
	U.pillar(feet, BLACK, 4.5, 80, 1.1, Enum.Material.SmoothPlastic, 0.1)
	U.pillar(feet, RED, 2.4, 90, 0.9)
	task.delay(0.05, U.pillar, feet, WHITE, 1, 95, 0.4)

	-- The ground splits and erupts.
	U.groundCracks(feet, 16, 18, RED, 4)
	U.groundRocks(feet, 18, 8, 3)
	task.delay(0.06, U.groundRocks, feet, 10, 4, 2.2)
	U.debris(feet, 26, 65, 1.6)
	blackSmoke(center, 40, 7, 40)
	U.burst(feet, {
		texture = U.textures.Smoke,
		color = Color3.fromRGB(150, 140, 130),
		count = 24,
		size = 8,
		speed = NumberRange.new(30, 55),
		lifetime = NumberRange.new(0.9, 1.6),
		lightEmission = 0,
		transparency = 0.35,
		drag = 2.5,
		spread = 85,
	})
	for i = 1, 10 do
		local angle = (i / 10) * math.pi * 2 + math.random() * 0.3
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		U.lightning(feet + UP * 0.5, feet + out * (10 + math.random() * 10) + UP * 0.3, BLACK, RED, 0.24, 0.35)
	end
	for _ = 1, 5 do
		U.lightning(center, center + UP * (10 + math.random() * 8) + U.randomUnit() * 4, BLACK, RED, 0.22, 0.3)
	end
	redSparks(center, 40, 1.6)
	U.light(center, RED, 18, 60, 0.9)
	U.highlight(character, BLACK, 0.6, 0.65)
	U.popup(center + UP * 6, "BLACK FORM", RED, 2.4)
	lingerSmoke(feet, 2, 10)

	-- He keeps erupting while he roars.
	trailEmitter(root, {
		Texture = U.textures.Smoke,
		Color = ColorSequence.new(BLACK),
		LightEmission = 0,
		Size = NumberSequence.new(2, 5),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.5, 0.9),
		Rate = 120,
		Speed = NumberRange.new(8, 18),
		Acceleration = Vector3.new(0, 10, 0),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(25, 25),
		Drag = 2,
	}, 0.6)
	crackle(root, 0.6, 0.05, 4)

	if U.isLocal(character) then
		impactFrame(1.3)
		U.screenFlash(RED, 0.4)
		task.delay(0.1, U.colorGrade, {
			TintColor = Color3.fromRGB(255, 175, 175),
			Saturation = -0.3,
			Contrast = 0.2,
		}, 0, 0.3, 0.6)
		CameraShake.FovKick(18)
	end
end

-- The sword comes down into his Black Form stance and the wing beats once.
local function awakenStance(character: Model, root: BasePart)
	heavyTrail(character, 0.3)
	crescent(character, {
		center = CFrame.new(0, 0.5, 0),
		radius = 6,
		from = 55,
		to = -10,
		tilt = 45,
		width = 2.4,
		sweep = 0.1,
		fade = 0.35,
	})
	local feet = feetOf(character, root)
	U.ringBurst(CFrame.new(feet + UP * 0.15), BLACK, 1, 9, 0.35, 0.3)
	blackSmoke(feet + UP * 0.4, 10, 3, 12)
	local visual = awakenedVisuals[character]
	if visual and visual.flap then
		visual.flap()
	end
	local torso = character:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		-- Loose feathers shaken off by the beat.
		U.burst(torso.Position - torso.CFrame.RightVector * 2 - torso.CFrame.LookVector, {
			color = BLACK,
			count = 16,
			size = 0.6,
			speed = NumberRange.new(8, 18),
			lifetime = NumberRange.new(0.8, 1.4),
			lightEmission = 0,
			acceleration = Vector3.new(0, -8, 0),
			drag = 1.5,
		})
	end
	if U.isLocal(character) then
		CameraShake.Add(0.2)
	end
end

function handlers.Awaken(data, character, root)
	local phase = data.phase
	if phase == "Start" then
		-- The look pops in at the burst, not before.
		revealAt[character] = os.clock() + AWAKEN_BURST
		if awakenedVisuals[character] then
			setAwakened(character, false)
		end
		task.delay(AWAKEN_BURST, refreshAwakened, character)
		play(character, ANIMS.Awaken, function(event)
			if event == "Stance" and character.Parent then
				awakenStance(character, root)
			end
		end)
		awakenGather(character, root)
	elseif phase == "Burst" then
		awakenBurst(character, root)
	elseif phase == "End" then
		blackSmoke(root.Position, 16, 3.5, 10)
		U.afterimage(character, BLACK, 0.5)
		U.ringBurst(CFrame.new(feetOf(character, root) + UP * 0.1), DARK_RED, 1, 6, 0.4, 0.15)
	end
end

---------------------------------------------------------------------------
-- Black Moon (Black Form 4): the cutscene
---------------------------------------------------------------------------

local MOON_LIGHT = Color3.fromRGB(238, 234, 220)
local MOON_SHADE = Color3.fromRGB(212, 207, 194)
local MOON_HALO = Color3.fromRGB(255, 226, 214)
local MOON_CUT = rad(35) -- angle of the cut across the moon's face
local MOON_SEGMENTS = 24

local function smoothstep(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function newWedge(color: Color3): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Anchored = true
	wedge.CanCollide = false
	wedge.CanQuery = false
	wedge.CanTouch = false
	wedge.CastShadow = false
	wedge.Material = Enum.Material.Neon
	wedge.Color = color
	wedge.Transparency = 1
	wedge.Parent = U.folder
	return wedge
end

-- The triangle a-b-c as two wedges: their CFrames and sizes, in the
-- space a, b and c are given in.
local function triangle(a: Vector3, b: Vector3, c: Vector3, thickness: number): { { cframe: CFrame, size: Vector3 } }
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	return {
		{
			cframe = CFrame.fromMatrix((a + b) / 2, right, up, back),
			size = Vector3.new(thickness, height, math.abs(ab:Dot(back))),
		},
		{
			cframe = CFrame.fromMatrix((a + c) / 2, -right, up, -back),
			size = Vector3.new(thickness, height, math.abs(ac:Dot(back))),
		},
	}
end

type MoonPiece = { part: BasePart, offset: CFrame, side: number, alpha: number, ray: boolean? }
type Moon = {
	update: (center: CFrame, visible: number, split: number, scar: number, spin: number) -> (),
	destroy: () -> (),
}

--[[
	A giant full moon, built as a fan of flat triangles so it can be cut in
	half: the two halves sit either side of a line at MOON_CUT and slide
	apart as `split` goes 0 to 1. Faces the camera (center's -Z), with
	darker seas, a soft halo behind, and a red scar along the cut.
]]
local function buildMoon(radius: number): Moon
	local pieces: { MoonPiece } = {}
	for i = 0, MOON_SEGMENTS - 1 do
		local a0 = MOON_CUT + (i / MOON_SEGMENTS) * math.pi * 2
		local a1 = MOON_CUT + ((i + 1) / MOON_SEGMENTS) * math.pi * 2
		local p0 = Vector3.new(math.cos(a0), math.sin(a0), 0) * radius
		local p1 = Vector3.new(math.cos(a1), math.sin(a1), 0) * radius
		local side = if i < MOON_SEGMENTS / 2 then 1 else -1
		for _, tri in triangle(Vector3.zero, p0, p1, 0.4) do
			local part = newWedge(MOON_LIGHT)
			part.Size = tri.size
			table.insert(pieces, { part = part, offset = tri.cframe, side = side, alpha = 0 })
		end
	end
	local face = CFrame.Angles(0, rad(90), 0) -- cylinders run along X; turn them to face the camera
	local cut = Vector2.new(math.cos(MOON_CUT), math.sin(MOON_CUT))
	for _, sea in
		{
			{ 0.25, 0.3, 0.28 },
			{ -0.35, 0.1, 0.22 },
			{ -0.1, -0.4, 0.18 },
			{ 0.45, -0.25, 0.14 },
			{ -0.5, 0.45, 0.12 },
			{ 0.1, 0.62, 0.1 },
		}
	do
		local x, y, r = sea[1] * radius, sea[2] * radius, sea[3] * radius
		local part = U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, r * 2, r * 2),
			Color = MOON_SHADE,
			Transparency = 1,
		})
		local side = if cut.X * y - cut.Y * x > 0 then 1 else -1
		table.insert(pieces, { part = part, offset = CFrame.new(x, y, -0.35) * face, side = side, alpha = 0.15 })
	end
	-- A thin blood-red rim, split with the halves.
	local rimSegments = 36
	for i = 0, rimSegments - 1 do
		local angle = MOON_CUT + ((i + 0.5) / rimSegments) * math.pi * 2
		local part = U.newPart({
			Size = Vector3.new(2 * math.pi * radius * 1.015 / rimSegments * 1.1, radius * 0.025, 0.3),
			Color = RED,
			Transparency = 1,
		})
		table.insert(pieces, {
			part = part,
			offset = CFrame.Angles(0, 0, angle) * CFrame.new(radius * 1.015, 0, -0.2) * CFrame.Angles(0, 0, rad(90)),
			side = if i < rimSegments / 2 then 1 else -1,
			alpha = 0.3,
		})
	end
	-- Pale rays fanning out from behind it, slowly turning.
	for i = 1, 14 do
		local angle = (i / 14) * math.pi * 2 + (if i % 2 == 0 then 0.1 else -0.07)
		local length = radius * (if i % 2 == 0 then 1.9 else 1.4)
		local part = U.newPart({
			Size = Vector3.new(length, radius * (if i % 2 == 0 then 0.07 else 0.045), 0.2),
			Color = MOON_HALO,
			Transparency = 1,
		})
		table.insert(pieces, {
			part = part,
			offset = CFrame.Angles(0, 0, angle) * CFrame.new(radius * 0.95 + length / 2, 0, 3),
			side = 0,
			alpha = if i % 2 == 0 then 0.86 else 0.9,
			ray = true,
		})
	end
	for _, halo in { { 1.1, 0.68 }, { 1.28, 0.84 }, { 1.6, 0.93 } } do
		local part = U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, radius * 2 * halo[1], radius * 2 * halo[1]),
			Color = MOON_HALO,
			Transparency = 1,
		})
		table.insert(pieces, { part = part, offset = CFrame.new(0, 0, 1 + halo[1]) * face, side = 0, alpha = halo[2] })
	end
	local scarGlow = U.newPart({ Size = Vector3.new(radius * 2.3, 1, 0.3), Color = RED, Transparency = 1 })
	local scarCore = U.newPart({ Size = Vector3.new(radius * 2.3, 1, 0.3), Color = WHITE, Transparency = 1 })

	local across = Vector3.new(-math.sin(MOON_CUT), math.cos(MOON_CUT), 0) -- toward side 1
	return {
		update = function(center: CFrame, visible: number, split: number, scar: number, spin: number)
			for _, piece in pieces do
				local offset = piece.offset
				if piece.ray then
					offset = CFrame.Angles(0, 0, spin) * offset
				elseif piece.side ~= 0 then
					offset = CFrame.new(across * piece.side * split * radius * 0.4)
						* CFrame.Angles(0, 0, piece.side * split * 0.12)
						* offset
				end
				piece.part.CFrame = center * offset
				local shown = if piece.side == 0 then math.max(visible - split, 0) else visible
				piece.part.Transparency = 1 - shown * (1 - piece.alpha)
			end
			local line = center * CFrame.new(0, 0, -0.7) * CFrame.Angles(0, 0, MOON_CUT)
			scarGlow.CFrame = line
			scarGlow.Size = Vector3.new(radius * 2.3, math.max(scar * radius * 0.07, 0.05), 0.3)
			scarGlow.Transparency = 1 - scar * 0.85
			scarCore.CFrame = line * CFrame.new(0, 0, -0.1)
			scarCore.Size = Vector3.new(radius * 2.3, math.max(scar * radius * 0.02, 0.05), 0.3)
			scarCore.Transparency = 1 - scar
		end,
		destroy = function()
			for _, piece in pieces do
				piece.part:Destroy()
			end
			scarGlow:Destroy()
			scarCore:Destroy()
		end,
	}
end

local function launchedFor(victim: Model): Animation?
	if victim:GetAttribute("Kit") == "AntiMagic" then
		return ANIMS.Launched
	end
	return Reactions.Launched
end

-- A straight streak hanging in the air along his flight path.
local function flightStreak(from: Vector3, to: Vector3)
	local length = (to - from).Magnitude
	local cframe = CFrame.lookAt((from + to) / 2, to)
	local glow = U.newPart({ Size = Vector3.new(1.2, 1.2, length), CFrame = cframe, Color = RED, Transparency = 0.45 })
	local core = U.newPart({
		Size = Vector3.new(0.45, 0.45, length),
		CFrame = cframe,
		Color = BLACK,
		Material = Enum.Material.SmoothPlastic,
	})
	U.tween(glow, 0.6, { Size = Vector3.new(0.05, 0.05, length), Transparency = 1 })
	U.tween(core, 0.8, { Size = Vector3.new(0.02, 0.02, length), Transparency = 1 })
	task.delay(0.85, function()
		glow:Destroy()
		core:Destroy()
	end)
end

-- The crater where they come down.
local function moonCrater(position: Vector3)
	U.flash(position + UP, BLACK, 14, 0.3)
	U.flash(position + UP, RED, 8, 0.22)
	U.shockwave(position, RED, 3, 24, 0.45)
	U.shockwave(position, BLACK, 4, 28, 0.5, Enum.Material.Glass, 0.4)
	U.ringBurst(CFrame.new(position + UP * 0.2), BLACK, 1, 22, 0.5, 0.8)
	task.delay(0.05, U.ringBurst, CFrame.new(position + UP * 0.3), RED, 1, 16, 0.4, 0.35)
	U.groundCracks(position, 16, 16, RED, 4)
	U.groundRocks(position, 16, 7, 3)
	task.delay(0.05, U.groundRocks, position, 9, 3.5, 2.2)
	U.debris(position, 24, 60, 1.6)
	U.pillar(position, BLACK, 3, 30, 0.6, Enum.Material.SmoothPlastic, 0.15)
	blackSmoke(position + UP, 28, 6.5, 34)
	U.burst(position, {
		texture = U.textures.Smoke,
		color = Color3.fromRGB(150, 140, 130),
		count = 20,
		size = 7,
		speed = NumberRange.new(20, 42),
		lifetime = NumberRange.new(0.8, 1.5),
		lightEmission = 0,
		transparency = 0.35,
		drag = 2,
		spread = 35,
		direction = (UP + Vector3.new(0.01, 0, 0)).Unit,
	})
	for i = 1, 10 do
		local angle = (i / 10) * math.pi * 2 + math.random() * 0.4
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		U.lightning(position + UP * 0.4, position + out * (10 + math.random() * 8) + UP * 0.3, BLACK, RED, 0.22, 0.32)
	end
	U.light(position + UP * 2, RED, 14, 45, 0.6)
	lingerSmoke(position, 2.2, 10)
	local mine = U.getRoot(Players.LocalPlayer.Character)
	if mine then
		local distance = (mine.Position - position).Magnitude
		if distance < 70 then
			CameraShake.Add(0.6 * (1 - distance / 70))
		end
	end
end

--[[
	The night around the cutscene: a field of twinkling stars, cloud banks
	drifting across the moon, mist creeping over the ground, rocks lifting
	off the ground, ash and embers drifting through the air, and shooting
	stars. Fades in with the night and out again after.
]]
type NightSetting = { update: (t: number, visible: number) -> (), destroy: () -> () }

local function buildNightSetting(plan: BlackMoon.Plan): NightSetting
	local made: { Instance } = {}
	local function holder(cframe: CFrame, size: Vector3): BasePart
		local part = U.newPart({ Size = size, CFrame = cframe, Transparency = 1 })
		table.insert(made, part)
		return part
	end
	local center = plan.origin.Position + UP * 30

	-- Stars over the whole sky, thickest toward the moon.
	type Star = { part: BasePart, phase: number, speed: number, base: number }
	local stars: { Star } = {}
	local toMoon = (plan.moon - center).Unit
	for i = 1, 170 do
		local direction
		repeat
			direction = U.randomUnit()
		until direction.Y > 0.08
		if i % 3 == 0 then
			direction = (direction + toMoon * 1.2).Unit
		end
		local size = 0.6 + math.random() * 1.4
		local part = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			CFrame = CFrame.new(center + direction * (380 + math.random() * 60)),
			Color = if i % 5 == 0 then Color3.fromRGB(255, 220, 220) else Color3.fromRGB(225, 232, 255),
			Transparency = 1,
		})
		table.insert(made, part)
		table.insert(
			stars,
			{ part = part, phase = math.random() * 6.28, speed = 2 + math.random() * 4, base = math.random() * 0.3 }
		)
	end

	-- Cloud banks drifting across the face of the moon, and one low on the horizon.
	local function clouds(position: Vector3, size: Vector3, color: Color3, scale: number, count: number)
		local part = holder(CFrame.lookAt(position, plan.moonCamera), size)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = U.textures.Smoke
		emitter.Color = ColorSequence.new(color, color:Lerp(Color3.fromRGB(120, 130, 170), 0.35))
		emitter.LightEmission = 0.05
		emitter.LightInfluence = 0
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, scale * 0.7),
			NumberSequenceKeypoint.new(1, scale * 1.2),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.55),
			NumberSequenceKeypoint.new(0.75, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(6, 9)
		emitter.Rate = count / 7
		emitter.Speed = NumberRange.new(2, 5)
		emitter.SpreadAngle = Vector2.new(8, 8)
		emitter.EmissionDirection = Enum.NormalId.Right
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-4, 4)
		emitter.Parent = part
		emitter:Emit(count)
		return emitter
	end
	local toMoonFromPerch = (plan.moon - plan.perch).Unit
	local cloudFront = clouds(
		plan.perch + toMoonFromPerch * 140 + UP * 10,
		Vector3.new(260, 60, 30),
		Color3.fromRGB(26, 28, 44),
		46,
		14
	)
	local cloudLow = clouds(
		plan.perch + toMoonFromPerch * 210 - UP * 40,
		Vector3.new(420, 30, 40),
		Color3.fromRGB(20, 22, 36),
		70,
		12
	)

	-- Mist creeping over the ground (if there's ground under the fight at all).
	local ground = U.groundBelow(plan.origin.Position, nil, 300)
	local floorY = if ground then ground.Position.Y else plan.origin.Position.Y - 3
	local groundMist: ParticleEmitter? = nil
	if ground then
		local mistHolder =
			holder(CFrame.new(plan.origin.Position.X, floorY + 0.5, plan.origin.Position.Z), Vector3.new(110, 1, 110))
		local mist = Instance.new("ParticleEmitter")
		mist.Texture = U.textures.Smoke
		mist.Color = ColorSequence.new(Color3.fromRGB(150, 162, 200))
		mist.LightEmission = 0.1
		mist.LightInfluence = 0
		mist.Size = NumberSequence.new(8, 16)
		mist.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		})
		mist.Lifetime = NumberRange.new(3, 5)
		mist.Rate = 20
		mist.Speed = NumberRange.new(0.5, 1.5)
		mist.EmissionDirection = Enum.NormalId.Top
		mist.SpreadAngle = Vector2.new(70, 70)
		mist.Rotation = NumberRange.new(0, 360)
		mist.Parent = mistHolder
		mist:Emit(25)
		groundMist = mist
	end

	-- Ash and embers drifting through the air around the fight.
	local airHolder = holder(CFrame.new((plan.apex + plan.perch) / 2), Vector3.new(70, 40, 70))
	local ash = Instance.new("ParticleEmitter")
	ash.Texture = U.textures.Spark
	ash.Color = ColorSequence.new(BLACK)
	ash.LightEmission = 0
	ash.LightInfluence = 0
	ash.Size = NumberSequence.new(0.35, 0.2)
	ash.Lifetime = NumberRange.new(2, 4)
	ash.Rate = 40
	ash.Speed = NumberRange.new(0.5, 2)
	ash.Acceleration = Vector3.new(0, -1.5, 0)
	ash.Rotation = NumberRange.new(0, 360)
	ash.RotSpeed = NumberRange.new(-90, 90)
	ash.SpreadAngle = Vector2.new(180, 180)
	ash.Parent = airHolder
	local embers = Instance.new("ParticleEmitter")
	embers.Texture = U.textures.Spark
	embers.Color = ColorSequence.new(RED)
	embers.LightEmission = 1
	embers.LightInfluence = 0
	embers.Size = NumberSequence.new(0.3, 0)
	embers.Lifetime = NumberRange.new(1.5, 3)
	embers.Rate = 18
	embers.Speed = NumberRange.new(0.5, 2)
	embers.Acceleration = Vector3.new(0, 1.5, 0)
	embers.SpreadAngle = Vector2.new(180, 180)
	embers.Parent = airHolder
	local emitters = { cloudFront, cloudLow, ash, embers }
	if groundMist then
		table.insert(emitters, groundMist)
	end
	-- Each emitter's own fade curve, so the live particles can fade with the night.
	local baseFade: { { NumberSequenceKeypoint } } = {}
	for i, emitter in emitters do
		baseFade[i] = emitter.Transparency.Keypoints
	end
	local lastFade = -1

	-- Rocks tearing loose from the ground and floating up.
	type Rock = { part: BasePart, from: CFrame, rise: number, spin: Vector3 }
	local rocks: { Rock } = {}
	local rockColor = if ground and ground.Instance:IsA("BasePart")
		then ground.Instance.Color
		else Color3.fromRGB(90, 88, 85)
	for i = 1, if ground then 14 else 0 do
		local angle = (i / 14) * math.pi * 2 + math.random() * 0.4
		local distance = 9 + math.random() * 20
		local size = 0.7 + math.random() * 1.6
		local from = CFrame.new(
			plan.origin.Position.X + math.cos(angle) * distance,
			floorY - size * 0.4,
			plan.origin.Position.Z + math.sin(angle) * distance
		) * U.randomAngles()
		local part = U.newPart({
			Size = Vector3.one * size,
			CFrame = from,
			Color = rockColor,
			Material = if ground then ground.Material else Enum.Material.Slate,
			Transparency = 1,
		})
		part.CastShadow = true
		table.insert(made, part)
		table.insert(rocks, { part = part, from = from, rise = 3 + math.random() * 7, spin = U.randomUnit() * 0.8 })
	end

	-- Shooting stars streaking across behind the moon.
	local function shootingStar()
		local side = plan.right * (if math.random() < 0.5 then 1 else -1)
		local from = plan.moon + side * 220 + UP * (60 + math.random() * 60)
		local to = from - side * 260 - UP * 70
		local streak = U.newPart({
			Size = Vector3.new(0.6, 0.6, 26),
			CFrame = CFrame.lookAt(from, to),
			Color = Color3.fromRGB(235, 240, 255),
			Transparency = 0.1,
		})
		U.tween(
			streak,
			0.7,
			{ CFrame = CFrame.lookAt(to, to + (to - from)), Transparency = 1 },
			Enum.EasingStyle.Linear
		)
		task.delay(0.75, streak.Destroy, streak)
	end
	task.delay(BlackMoon.Times.Perch + 0.4, shootingStar)
	task.delay(BlackMoon.Times.Close + 0.7, shootingStar)

	local stopped = false
	return {
		update = function(t: number, visible: number)
			for _, star in stars do
				local twinkle = 0.5 + 0.5 * math.sin(t * star.speed + star.phase)
				star.part.Transparency = 1 - visible * (1 - star.base - 0.35 * twinkle)
			end
			local lift =
				TweenService:GetValue(math.clamp(visible, 0, 1), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			for _, rock in rocks do
				local drift = math.sin(t * 1.3 + rock.rise) * 0.25
				rock.part.CFrame = rock.from + UP * (rock.rise * lift + drift * lift)
				rock.part.CFrame *= CFrame.Angles(rock.spin.X * t, rock.spin.Y * t, rock.spin.Z * t)
				rock.part.Transparency = if visible > 0.02 then 0 else 1
			end
			-- Changing the curve fades particles already out there too, so no dark
			-- clouds are left hanging in the daylight afterwards.
			local fade = math.floor((1 - math.clamp(visible, 0, 1)) * 40 + 0.5) / 40
			if fade ~= lastFade then
				lastFade = fade
				for i, emitter in emitters do
					local points = {}
					for j, point in baseFade[i] do
						points[j] = NumberSequenceKeypoint.new(point.Time, point.Value + (1 - point.Value) * fade)
					end
					emitter.Transparency = NumberSequence.new(points)
				end
			end
			for _, emitter in emitters do
				emitter.Enabled = visible > 0.5 and not stopped
			end
		end,
		destroy = function()
			stopped = true
			for _, emitter in emitters do
				emitter.Enabled = false
				emitter:Clear()
			end
			for _, rock in rocks do
				U.tween(rock.part, 0.6, { CFrame = rock.from - UP * 1, Transparency = 1 })
			end
			task.delay(2.5, function()
				for _, instance in made do
					instance:Destroy()
				end
			end)
		end,
	}
end

local function playBlackMoon(data, character: Model, root: BasePart)
	if typeof(data.origin) ~= "CFrame" or typeof(data.victimStart) ~= "Vector3" then
		return
	end
	local T = BlackMoon.Times
	local plan = BlackMoon.Plan(data.origin, data.victimStart)
	local victim: Model? = if typeof(data.target) == "Instance" and data.target:IsA("Model") then data.target else nil
	local victimRoot = U.getRoot(victim)
	local start = os.clock()
	local mine = U.isLocal(character) or U.isLocal(victim)
	local myRoot = U.getRoot(Players.LocalPlayer.Character)
	local nearby = mine or (myRoot ~= nil and (myRoot.Position - plan.origin.Position).Magnitude < 180)
	local cutAt = plan.cut

	-- Runs `fn` at `time` seconds into the cutscene (if he's still around).
	local function at(time: number, fn: () -> ())
		task.delay(math.max(time - (os.clock() - start), 0), function()
			if character.Parent then
				fn()
			end
		end)
	end

	-- Both of them on the shared paths (smooth on every screen), the moon
	-- and the night around it.
	local moon = buildMoon(plan.moonRadius)
	-- The sky dressing only for people near enough to see the night fall.
	local setting = if nearby then buildNightSetting(plan) else nil
	local bind = "CloverBlackMoon" .. tostring(start)
	local done = false
	local function finish()
		if done then
			return
		end
		done = true
		RunService:UnbindFromRenderStep(bind)
		moon.destroy()
		if setting then
			setting.destroy()
		end
	end
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - start
		if t <= T.Land then
			if root.Parent then
				root.CFrame = BlackMoon.Attacker(plan, t)
			end
			if victimRoot and victimRoot.Parent then
				victimRoot.CFrame = BlackMoon.Victim(plan, t)
			end
		end
		local visible = smoothstep((t - T.Night) / 0.6) * (1 - smoothstep((t - T.Land - 0.3) / 1.2))
		local split = TweenService:GetValue(
			math.clamp((t - T.Land) / 0.9, 0, 1),
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		)
		local scar = if t < T.Cut then 0 else math.min((t - T.Cut) / 0.08, 1) * (1 - smoothstep((t - T.Land) / 0.5))
		moon.update(CFrame.lookAt(plan.moon, workspace.CurrentCamera.CFrame.Position), visible, split, scar, t * 0.05)
		if setting then
			setting.update(t, visible)
		end
		if t > T.Land + 1.6 then
			finish()
		end
	end)
	task.delay(T.Land + 3, finish)

	-- The camera, for the two of them.
	if mine then
		Cinematic.Camera(function(t)
			if t < T.Land then
				return BlackMoon.Camera(plan, t)
			end
			-- Following them down out of the sky.
			local v = if victimRoot and victimRoot.Parent then victimRoot.Position else plan.apex
			return CFrame.lookAt(v + plan.right * 14 + UP * 7 - plan.forward * 4, v), 65
		end, T.Done)
	end

	-- Night falls over everyone nearby.
	local lift: ((number?) -> ())? = nil
	if nearby then
		at(T.Night, function()
			lift = Cinematic.Night(0.9)
		end)
		task.delay(T.Land + 0.3, function()
			if lift then
				lift(1.3)
			end
		end)
	end

	-- Soft blue moonlight on the two of them, so the fight still reads at
	-- night. Kept gentle on him: up close a strong light washes him out.
	local moonlights: { PointLight } = {}
	local MOONLIT = { 1.1, 2 } -- him, them
	for _, part in { root, victimRoot } :: { BasePart? } do
		if part then
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(165, 180, 235)
			light.Brightness = 0
			light.Range = 18
			light.Shadows = false
			light.Parent = part
			table.insert(moonlights, light)
		end
	end
	task.delay(T.Night, function()
		for i, light in moonlights do
			U.tween(light, 0.6, { Brightness = MOONLIT[i] or 2 })
		end
	end)
	task.delay(T.Land, function()
		for _, light in moonlights do
			U.tween(light, 0.4, { Brightness = 0 })
			task.delay(0.45, light.Destroy, light)
		end
	end)

	-- Afterwards the wings go back to normal (the second one dissolves).
	task.delay(T.Land + 0.9, function()
		local visual = awakenedVisuals[character]
		if visual then
			if visual.setPose then
				visual.setPose(nil)
			end
			if visual.setPair then
				visual.setPair(false)
			end
		end
	end)

	-- The throw.
	play(character, ANIMS.MoonThrow)
	at(T.Release, function()
		if victim then
			local animation = launchedFor(victim)
			if animation then
				PoseAnimator.Play(victim, animation)
			end
		end
		local hand = character:FindFirstChild("Left Arm")
		local from = if hand and hand:IsA("BasePart")
			then (hand.CFrame * CFrame.new(0, -1, 0)).Position
			else root.Position
		U.flash(from, WHITE, 4, 0.1)
		U.flash(from, BLACK, 7, 0.2)
		U.ringBurst(CFrame.new(from), BLACK, 1, 9, 0.3, 0.35)
		task.delay(0.04, U.ringBurst, CFrame.new(from + UP), RED, 0.8, 6, 0.25, 0.2)
		local feet = feetOf(character, root)
		if U.groundBelow(root.Position, { character }) then
			U.groundCracks(feet, 7, 5, RED, 2)
			U.debris(feet, 8, 30, 0.9)
			blackSmoke(feet + UP * 0.4, 12, 3, 14)
		end
		if victimRoot then
			trailEmitter(victimRoot, {
				Texture = U.textures.Smoke,
				Color = ColorSequence.new(BLACK),
				LightEmission = 0,
				Size = NumberSequence.new(1.6, 3.2),
				Transparency = NumberSequence.new(0.25, 1),
				Lifetime = NumberRange.new(0.35, 0.6),
				Rate = 90,
				Speed = NumberRange.new(1, 3),
				SpreadAngle = Vector2.new(180, 180),
				Drag = 3,
			}, 0.55)
			trailEmitter(victimRoot, {
				Texture = U.textures.Spark,
				Color = ColorSequence.new(RED, DARK_RED),
				LightEmission = 1,
				Size = NumberSequence.new(0.35, 0),
				Lifetime = NumberRange.new(0.2, 0.4),
				Rate = 50,
				Speed = NumberRange.new(4, 10),
				SpreadAngle = Vector2.new(180, 180),
			}, 0.55)
			U.bodyTrail(victim, BLACK, 0.6)
			U.speedLines(victimRoot, (UP + Vector3.new(0.01, 0, 0)).Unit, 0.45)
		end
		if mine then
			CameraShake.Add(0.3)
		end
	end)

	-- He leaps up after them.
	at(T.Leap, function()
		play(character, ANIMS.Leap)
		local feet = feetOf(character, root)
		U.flash(feet + UP * 0.5, BLACK, 8, 0.22)
		U.shockwave(feet, RED, 2, 12, 0.3)
		U.ringBurst(CFrame.new(feet + UP * 0.15), BLACK, 1, 10, 0.32, 0.45)
		if U.groundBelow(root.Position, { character }) then
			U.debris(feet, 8, 36, 1)
			blackSmoke(feet + UP * 0.4, 14, 3.2, 16)
		end
		U.bodyTrail(character, BLACK, 0.35)
		for i = 0, 3 do
			task.delay(i * 0.05, function()
				if character.Parent then
					U.afterimage(character, if i % 2 == 0 then BLACK else DARK_RED, 0.3)
				end
			end)
		end
	end)

	-- Perched in front of the moon: shadowed, with a red rim (his avatar
	-- still shows through).
	local silhouette: Highlight? = nil
	at(T.Perch, function()
		play(character, ANIMS.MoonPerch)
		local outline = Instance.new("Highlight")
		outline.Adornee = character
		outline.FillColor = BLACK
		outline.FillTransparency = 0.72
		outline.OutlineColor = RIM_RED
		outline.OutlineTransparency = 0.05
		outline.DepthMode = Enum.HighlightDepthMode.Occluded
		outline.Parent = character -- goes with him if he leaves mid-cutscene
		silhouette = outline
		task.delay(T.Fly - T.Perch + 0.1, outline.Destroy, outline)
		-- Both wings out, wide open, beating slowly in front of the moon.
		local visual = awakenedVisuals[character]
		if visual then
			if visual.setPair then
				visual.setPair(true)
			end
			if visual.setPose then
				visual.setPose("spread")
			end
			if visual.flap then
				visual.flap()
			end
		end
		-- No moonlight on him here: he's a silhouette against the moon.
		if moonlights[1] then
			U.tween(moonlights[1], 0.2, { Brightness = 0 })
		end
		blackSmoke(root.Position, 14, 3.5, 7)
		redSparks(root.Position, 14, 0.8)
		-- Each wing beat sheds smoke and embers and pulses the aura.
		for beat = 0, 4 do
			at(T.Perch + 0.15 + beat * 0.42, function()
				local back = root.Position - root.CFrame.LookVector * 1.5 + UP
				blackSmoke(back, 6, 3, 10)
				redSparks(back, 8, 0.6, -UP)
				U.ringBurst(CFrame.new(root.Position) * CFrame.Angles(rad(90), 0, 0), BLACK, 2, 8, 0.4, 0.4)
				U.light(root.Position, RED, 4, 12, 0.3)
			end)
		end
		partEmitter(root, {
			Texture = U.textures.Smoke,
			Color = ColorSequence.new(BLACK),
			LightEmission = 0,
			Size = NumberSequence.new(1.6, 3.6),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.7),
				NumberSequenceKeypoint.new(0.3, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.5, 0.9),
			Rate = 45,
			Speed = NumberRange.new(2, 5),
			Acceleration = Vector3.new(0, 7, 0),
			SpreadAngle = Vector2.new(180, 180),
		}, T.Fly - T.Perch)
		partEmitter(root, {
			Texture = U.textures.Spark,
			Color = ColorSequence.new(RED),
			LightEmission = 1,
			Size = NumberSequence.new(0.25, 0),
			Lifetime = NumberRange.new(0.5, 0.9),
			Rate = 20,
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(180, 180),
		}, T.Fly - T.Perch)
	end)

	-- He levels the sword at them: anti-magic flares off him and the blade.
	at(T.Point, function()
		swordGlow(character, RED, 0.5, 0.5)
		swordAura(character, T.Fly - T.Point, 40)
		local tip = bladePoint(character, 2.1)
		if tip then
			blackLightning(tip, 7, 4.5)
			U.light(tip, RED, 8, 16, 0.4)
			U.impactRing(tip, workspace.CurrentCamera.CFrame.Position - tip, RED, 0.5, 6, 0.35)
			U.flash(tip, RED, 4, 0.15)
		end
		U.ringBurst(CFrame.new(root.Position) * CFrame.Angles(rad(90), 0, 0), BLACK, 1, 9, 0.45, 0.3)
		blackSmoke(root.Position, 16, 4, 10)
		redSparks(root.Position, 18, 1)
		local visual = awakenedVisuals[character]
		if visual and visual.flap then
			visual.flap()
		end
		if mine then
			CameraShake.Add(0.15)
		end
	end)

	-- The blade catches the moonlight.
	at(T.Glint, function()
		local tip = bladePoint(character, 2.1)
		if tip then
			U.glint(tip, 2.6, RED)
			task.delay(0.03, U.glint, tip, 1.4, WHITE)
			U.impactRing(tip, workspace.CurrentCamera.CFrame.Position - tip, RED, 0.3, 4, 0.25)
			U.light(tip, RED, 12, 18, 0.3)
		end
	end)

	-- He flies straight through them.
	at(T.Fly, function()
		play(character, ANIMS.MoonFlight)
		if silhouette then
			silhouette:Destroy()
			silhouette = nil
		end
		local visual = awakenedVisuals[character]
		if visual and visual.setPose then
			visual.setPose("glide") -- swept back for speed
		end
		if moonlights[1] then
			U.tween(moonlights[1], 0.15, { Brightness = MOONLIT[1] })
		end
		heavyTrail(character, 0.45)
		U.bodyTrail(character, BLACK, 0.3)
		U.speedLines(root, plan.through, 0.25)
		U.flash(plan.perch, BLACK, 10, 0.2)
		U.impactRing(plan.perch, plan.through, RED, 1, 7, 0.25)
		blackSmoke(plan.perch, 14, 3.5, 16)
		for i = 1, 5 do
			task.delay(i * 0.025, function()
				local along = plan.perch:Lerp(plan.beyond, i / 6)
				U.impactRing(along, plan.through, if i % 2 == 0 then RED else BLACK, 0.6, 6 + i, 0.3)
			end)
		end
		U.flash(plan.perch, RED, 6, 0.15)
		for i = 0, 6 do
			task.delay(i * 0.03, function()
				if character.Parent then
					U.afterimage(character, if i % 2 == 0 then BLACK else DARK_RED, 0.35)
				end
			end)
		end
	end)

	-- The cut.
	at(T.Cut, function()
		PoseAnimator.Freeze(character, 0.1)
		if victim then
			-- They hang there, stopped mid-tumble, until the cut lands.
			PoseAnimator.Freeze(victim, T.Land - T.Cut + 0.4)
		end
		flightStreak(plan.perch, plan.beyond)
		U.flash(cutAt, WHITE, 8, 0.1)
		U.flash(cutAt, BLACK, 12, 0.25)
		slashMark(cutAt, -0.5, 16, 0.5)
		U.burst(cutAt, {
			color = RED,
			count = 24,
			size = 0.7,
			speed = NumberRange.new(35, 70),
			lifetime = NumberRange.new(0.15, 0.4),
			streaks = true,
			spread = 30,
			direction = plan.through,
		})
		U.light(cutAt, RED, 12, 24, 0.3)
		redSparks(cutAt, 30, 1.1, plan.through)
		blackLightning(cutAt, 6, 5, 0.25)
		U.impactRing(cutAt, plan.through, WHITE, 0.4, 9, 0.25)
		task.delay(0.03, U.impactRing, cutAt, plan.through, RED, 0.5, 13, 0.3)
		if mine then
			impactFrame(1.4)
			CameraShake.Add(0.4)
		end
	end)

	-- Past them, back turned. Everything goes still.
	at(T.Arrive, function()
		swordAura(character, T.Land - T.Arrive, 20)
		local hang = U.newPart({ Size = Vector3.new(3, 4, 3), Transparency = 1, CFrame = CFrame.new(cutAt) })
		partEmitter(hang, {
			Texture = U.textures.Spark,
			Color = ColorSequence.new(RED, DARK_RED),
			LightEmission = 1,
			Size = NumberSequence.new(0.3, 0),
			Lifetime = NumberRange.new(0.6, 1.1),
			Rate = 30,
			Speed = NumberRange.new(0.5, 2),
			Acceleration = Vector3.new(0, 1.5, 0),
			SpreadAngle = Vector2.new(180, 180),
		}, T.Land - T.Arrive)
		U.light(cutAt, RED, 3, 10, T.Land - T.Arrive)
		task.delay(T.Land - T.Arrive + 1.5, hang.Destroy, hang)
		local visual = awakenedVisuals[character]
		if visual and visual.setPose then
			visual.setPose("spread") -- flared open as he stops
		end
		if mine then
			-- Drained of colour, not of light: he mustn't wash out white.
			U.colorGrade({ Saturation = -0.7, Contrast = 0.25, Brightness = 0.02 }, 0.05, T.Land - T.Arrive - 0.1, 0.15)
		end
	end)

	-- The cut lands.
	at(T.Land, function()
		slashMark(cutAt, 0.6, 18, 0.6)
		task.delay(0.04, slashMark, cutAt, -0.5, 18, 0.6)
		U.flash(cutAt, WHITE, 6, 0.08)
		U.flash(cutAt, BLACK, 22, 0.4)
		U.flash(cutAt, RED, 14, 0.3)
		U.shockwave(cutAt, BLACK, 4, 40, 0.6, Enum.Material.Glass, 0.3)
		U.shockwave(cutAt, RED, 3, 32, 0.5)
		local toCamera = workspace.CurrentCamera.CFrame.Position - cutAt
		U.impactRing(cutAt, toCamera, BLACK, 2, 22, 0.5)
		task.delay(0.05, U.impactRing, cutAt, toCamera, RED, 1.5, 16, 0.45)
		blackLightning(cutAt, 12, 10, 0.35)
		blackSmoke(cutAt, 30, 7, 35)
		redSparks(cutAt, 40, 1.6)
		U.light(cutAt, RED, 16, 60, 0.7)
		U.popup(cutAt + UP * 5, "BLACK MOON", RED, 2.6)
		task.delay(0.08, U.shockwave, cutAt, WHITE, 2, 30, 0.45, Enum.Material.Glass, 0.6)
		U.pillar(cutAt - UP * 6, BLACK, 2.4, 22, 0.5, Enum.Material.SmoothPlastic, 0.2)
		U.pillar(cutAt - UP * 6, RED, 1.2, 26, 0.45)
		U.burst(cutAt, {
			color = RED,
			count = 30,
			size = 0.6,
			speed = NumberRange.new(30, 60),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		lingerSmoke(cutAt, 2.5, 14)
		if mine then
			-- A sharp frame, not a white-out.
			impactFrame(0.9)
			U.screenFlash(RED, 0.35)
			CameraShake.Add(0.8)
		end
		-- Watch them fall and make the crater where they hit.
		if victimRoot then
			local fallStart = os.clock()
			local connection
			connection = RunService.Heartbeat:Connect(function()
				if not victimRoot.Parent or os.clock() - fallStart > 1.6 then
					connection:Disconnect()
					return
				end
				local ground = U.groundBelow(victimRoot.Position, { victim :: Model })
				if ground and victimRoot.Position.Y - ground.Position.Y < 4 then
					connection:Disconnect()
					moonCrater(ground.Position)
				end
			end)
		end
	end)
end

function handlers.BlackMoon(data, character, root)
	if data.phase == "Begin" then
		playBlackMoon(data, character, root)
	else
		-- The lunge and the seize are drawn with Black Meteorite's.
		handlers.BlackMeteorite(data, character, root)
	end
end

-- The cut landing (damage numbers; the cutscene draws the rest).
VFX.Register("BlackMoonCut", function(data)
	U.highlight(data.victim, RED, 0.4)
	if data.damage and typeof(data.position) == "Vector3" then
		U.popup(data.position, string.format("%g", data.damage), RED, 1.6)
	end
end)

---------------------------------------------------------------------------
-- Spawn entrance
---------------------------------------------------------------------------

local function easeInOut(alpha: number): number
	return TweenService:GetValue(alpha, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

local function setSwordVisible(character: Model, visible: boolean, fade: number?)
	local sword = getSword(character)
	if not sword then
		return
	end
	for _, part in sword:GetDescendants() do
		if part:IsA("BasePart") then
			if fade and visible then
				part.Transparency = 1
				U.tween(part, fade, { Transparency = 0 })
			else
				part.Transparency = if visible then 0 else 1
			end
		end
	end
end

-- Asta's grimoire: a tattered black book with a five-leaf clover floating
-- over it. Anchored parts posed every frame around a moving anchor.
-- `place` (seconds since it appeared -> where the book is) moves it
-- somewhere other than beside him, with its pages fluttering.
function grimoire(character: Model, root: BasePart, place: ((t: number) -> CFrame)?): Grimoire
	local parts: { { part: BasePart, offset: CFrame, side: number } } = {}
	local function piece(size: Vector3, color: Color3, material: Enum.Material, offset: CFrame, side: number): BasePart
		local part = U.newPart({ Size = size, Color = color, Material = material, Transparency = 1 })
		table.insert(parts, { part = part, offset = offset, side = side })
		return part
	end
	local cover = Color3.fromRGB(24, 22, 26)
	local paper = Color3.fromRGB(205, 195, 170)
	-- side -1 = left half (rotates open one way), 1 = right half, 0 = fixed
	piece(Vector3.new(1.1, 1.45, 0.08), cover, Enum.Material.Fabric, CFrame.new(-0.55, 0, 0), -1)
	piece(Vector3.new(1.1, 1.45, 0.08), cover, Enum.Material.Fabric, CFrame.new(0.55, 0, 0), 1)
	piece(Vector3.new(1, 1.35, 0.12), paper, Enum.Material.SmoothPlastic, CFrame.new(-0.5, 0, -0.08), -1)
	piece(Vector3.new(1, 1.35, 0.12), paper, Enum.Material.SmoothPlastic, CFrame.new(0.5, 0, -0.08), 1)
	piece(Vector3.new(0.14, 1.45, 0.14), cover, Enum.Material.Fabric, CFrame.new(0, 0, 0.02), 0)
	-- Five-leaf clover hovering over the pages.
	for i = 1, 5 do
		local angle = (i / 5) * math.pi * 2
		piece(
			Vector3.new(0.34, 0.34, 0.06),
			BLACK,
			Enum.Material.SmoothPlastic,
			CFrame.new(math.cos(angle) * 0.24, 1.1 + math.sin(angle) * 0.24, -0.4) * CFrame.Angles(0, 0, angle),
			0
		)
	end
	local glowHolder = piece(Vector3.one * 0.1, RED, Enum.Material.Neon, CFrame.new(0, 1.1, -0.4), 0)
	local glow = Instance.new("PointLight")
	glow.Color = RED
	glow.Brightness = 0
	glow.Range = 8
	glow.Parent = glowHolder

	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = U.textures.Smoke
	smoke.Color = ColorSequence.new(BLACK)
	smoke.LightEmission = 0
	smoke.Size = NumberSequence.new(0.8, 1.6)
	smoke.Transparency = NumberSequence.new(0.5, 1)
	smoke.Lifetime = NumberRange.new(0.5, 0.9)
	smoke.Rate = 25
	smoke.Speed = NumberRange.new(0.5, 1.5)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Acceleration = Vector3.new(0, 2, 0)
	smoke.Parent = glowHolder

	local openAngle, visible = 0, 0
	local anchorOffset = CFrame.new(-1.9, 0.6, -1.7)
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not root.Parent then
			-- He's gone (died, left): the book goes with him.
			connection:Disconnect()
			for _, entry in parts do
				entry.part:Destroy()
			end
			return
		end
		local t = os.clock() - start
		local base, flutter
		if place then
			base, flutter = place(t), math.sin(t * 6) * 7 + math.sin(t * 13) * 3
		else
			local position = (root.CFrame * anchorOffset).Position + Vector3.new(0, math.sin(t * 3) * 0.12, 0)
			-- Faces Asta, tilted back like it's being read.
			base = CFrame.lookAt(position, root.Position + Vector3.new(0, 0.6, 0)) * CFrame.Angles(rad(-20), 0, 0)
			flutter = 0
		end
		for _, entry in parts do
			local hinge = CFrame.Angles(0, -entry.side * rad(openAngle + flutter * visible), 0)
			local spin = if entry.side == 0 and entry.offset.Y > 0.5
				then CFrame.new(0, 1.1, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.1, 0.4)
				else CFrame.identity
			entry.part.CFrame = base * hinge * spin * entry.offset
			entry.part.Transparency = 1 - visible
		end
		glowHolder.Transparency = 1
		glow.Brightness = 3 * visible
	end)

	local function animateTo(duration: number, toOpen: number, toVisible: number)
		local fromOpen, fromVisible = openAngle, visible
		local t0 = os.clock()
		local c
		c = RunService.RenderStepped:Connect(function()
			local a = math.min((os.clock() - t0) / duration, 1)
			local e = easeInOut(a)
			openAngle = fromOpen + (toOpen - fromOpen) * e
			visible = fromVisible + (toVisible - fromVisible) * e
			if a >= 1 then
				c:Disconnect()
			end
		end)
	end

	return {
		open = function(duration: number)
			animateTo(duration, 65, 1)
		end,
		burst = function()
			blackSmoke(glowHolder.Position, 10, 2.5, 8)
			U.flash(glowHolder.Position, RED, 3, 0.2)
			U.light(glowHolder.Position, RED, 6, 12, 0.3)
		end,
		close = function()
			animateTo(0.3, 0, 0)
			smoke.Enabled = false
			task.delay(0.35, function()
				blackSmoke(glowHolder.Position, 6, 1.5, 4)
				connection:Disconnect()
				for _, entry in parts do
					entry.part:Destroy()
				end
			end)
		end,
	}
end

function handlers.Entrance(data, character, root)
	if data.phase ~= "Start" then
		return
	end
	setSwordVisible(character, false)
	blackSmoke(root.Position - UP * 2.6, 10, 3, 6)
	U.ringBurst(CFrame.new(root.Position - UP * 2.9), BLACK, 1, 7, 0.4, 0.25)

	local book: any = nil
	local finished = false
	local function cleanup()
		if finished then
			return
		end
		finished = true
		setSwordVisible(character, true)
		if book then
			book.close()
		end
	end
	-- Whatever happens (death, interruption), never leave the sword hidden.
	task.delay(3, cleanup)

	play(character, ANIMS.Entrance, function(event)
		if not character.Parent then
			cleanup()
			return
		end
		if event == "Grimoire" then
			book = grimoire(character, root)
			book.open(0.45)
		elseif event == "Draw" then
			if book then
				book.burst()
			end
			setSwordVisible(character, true, 0.08)
			redSparks(root.Position + UP * 1.5, 10, 0.8)
		elseif event == "Slam" then
			local sword = getSword(character)
			local blade = sword and sword:FindFirstChild("Blade")
			local tip = if blade and blade:IsA("BasePart")
				then alongBlade(blade, 2.1).Position
				else root.Position + root.CFrame.LookVector * 5
			U.groundRocks(tip, 9, 2, 1.4)
			blackSmoke(tip, 12, 3.5, 14)
			U.ringBurst(CFrame.new(tip + UP * 0.2), BLACK, 0.6, 9, 0.35, 0.3)
			blackLightning(tip + UP, 5, 5)
			U.light(tip, RED, 6, 18, 0.35)
			if U.isLocal(character) then
				CameraShake.Add(0.35)
			end
		elseif event == "Settle" then
			cleanup()
		end
	end)
end

---------------------------------------------------------------------------
-- Sword swap (R in Black Form): another of his swords out of the grimoire
---------------------------------------------------------------------------

local SWORD_NAMES = {
	Slayer = "DEMON-SLAYER SWORD",
	Dweller = "DEMON-DWELLER SWORD",
	Destroyer = "DEMON-DESTROYER SWORD",
	Slasher = "DEMON-SLASHER KATANA",
}

-- The old sword dissolves into black smoke while the grimoire opens beside
-- him; the new one (the server swaps the model 0.22s in) forms in his hand
-- out of anti-magic as he draws it, and its name flashes up.
function handlers.SwordSwap(data, character, root)
	local kind = data.sword
	play(character, ANIMS.SwordSwap)
	local old = getSword(character)
	if old then
		for _, part in old:GetDescendants() do
			if part:IsA("BasePart") then
				U.tween(part, 0.2, { Transparency = 1 })
			end
		end
		local blade = bladeOf(character)
		if blade then
			blackSmoke(blade.Position, 12, 3, 8)
			redSparks(blade.Position, 10, 0.6)
			swordAura(character, 0.2, 40)
		end
	end
	-- In Black Form it's the grimoire already circling him; otherwise one
	-- opens beside him for the draw.
	local visual = awakenedVisuals[character]
	local book = visual and visual.book
	if not book then
		local beside = grimoire(character, root)
		beside.open(0.18)
		task.delay(0.65, beside.close)
		book = beside
	end

	local arrived = false
	local connection
	connection = character.ChildAdded:Connect(function(child)
		if child.Name ~= "KitWeapon" or arrived then
			return
		end
		arrived = true
		connection:Disconnect()
		task.defer(function()
			-- It forms out of anti-magic.
			for _, part in child:GetDescendants() do
				if part:IsA("BasePart") then
					local shown = part.Transparency
					part.Transparency = 1
					U.tween(part, 0.15, { Transparency = shown })
				end
			end
			book.burst()
			local blade = bladeOf(character)
			if blade then
				glowBurst(blade.Position, 4, 0.3)
				edgeGlow(character, 0.45, 1)
				blackLightning(blade.Position, 4, 3, 0.2)
				blackSmoke(blade.Position, 8, 2.5, 8)
			end
			U.ringBurst(CFrame.new(root.Position - UP * 2.8), BLACK, 1, 9, 0.35, 0.3)
			U.popup(root.Position + UP * 4.5, SWORD_NAMES[kind] or "", RED, 1.6)
			if U.isLocal(character) then
				CameraShake.Add(0.15)
			end
		end)
	end)
	task.delay(1, function()
		if connection.Connected then
			connection:Disconnect()
		end
	end)
end

---------------------------------------------------------------------------
-- Sword moves (Black Form 1 and 2 follow the sword in his hand)
---------------------------------------------------------------------------

-- A straight cut through the air from `from` to `to`: a white-hot line with
-- black either side of it in a red glow. It hangs for `hold`, then parts
-- (the dark opens up) and fades.
local function cutLine(from: Vector3, to: Vector3, width: number, hold: number)
	local length = (to - from).Magnitude
	if length < 0.1 then
		return
	end
	local cframe = CFrame.lookAt(from:Lerp(to, 0.5), to)
	local glow = U.newPart({
		Size = Vector3.new(0.05, width * 2.6, length),
		CFrame = cframe,
		Color = RED,
		Transparency = 0.45,
	})
	local dark = U.newPart({
		Size = Vector3.new(0.08, width * 1.2, length),
		CFrame = cframe,
		Color = BLACK,
		Material = Enum.Material.SmoothPlastic,
	})
	local core = U.newPart({ Size = Vector3.new(0.12, width * 0.4, length), CFrame = cframe, Color = WHITE_HOT })
	task.delay(hold, function()
		U.tween(glow, 0.35, { Size = Vector3.new(0.05, width * 5, length), Transparency = 1 })
		U.tween(dark, 0.35, { Size = Vector3.new(0.08, width * 3, length), Transparency = 1 })
		U.tween(core, 0.2, { Size = Vector3.new(0.12, 0.01, length), Transparency = 1 })
	end)
	task.delay(hold + 0.4, function()
		glow:Destroy()
		dark:Destroy()
		core:Destroy()
	end)
end

-- Hides his sword, returning a function that puts it back as it was.
local function hideSword(character: Model): () -> ()
	local sword = getSword(character)
	local shown: { [BasePart]: number } = {}
	if sword then
		for _, part in sword:GetDescendants() do
			if part:IsA("BasePart") then
				shown[part] = part.Transparency
				part.Transparency = 1
			end
		end
	end
	return function()
		for part, transparency in shown do
			part.Transparency = transparency
		end
	end
end

-- A copy of his sword loose in the world (Slayer Recall's throw): the
-- handle anchored, everything else welded on, so it's posed by the handle.
local function looseSword(character: Model): (Model?, BasePart?)
	local sword = getSword(character)
	if not sword or not sword:FindFirstChild("Handle") then
		return nil, nil
	end
	local copy = sword:Clone()
	for _, item in copy:GetDescendants() do
		if item:IsA("JointInstance") then
			local inside = item.Part0 ~= nil
				and item.Part0:IsDescendantOf(copy)
				and item.Part1 ~= nil
				and item.Part1:IsDescendantOf(copy)
			if not inside then
				item:Destroy()
			end
		elseif item:IsA("BasePart") then
			item.Anchored = item.Name == "Handle"
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
			item.Massless = true
		elseif item:IsA("Trail") then
			item.Enabled = true
		end
	end
	copy.Parent = U.folder
	return copy, copy:FindFirstChild("Handle") :: BasePart?
end

-- Slayer Recall: the thrown sword, spinning flat like a boomerang about the
-- middle of its blade, out to where the server stops it, hanging there,
-- then flying back to his hand (black lightning pulling it in).
type Recall = {
	copy: Model,
	handle: BasePart,
	restore: () -> (),
	origin: Vector3,
	target: Vector3,
	out: number,
	position: Vector3,
	phase: string, -- "out" | "hang" | "back" | "home"
	speed: number,
	born: number,
}
local recalls: { [Model]: Recall } = {}
local RECALL_MIDDLE = 2.6 -- grip to the middle of the Slayer's blade

local function endRecall(character: Model)
	local recall = recalls[character]
	if recall then
		recalls[character] = nil
		recall.copy:Destroy()
		recall.restore()
	end
end

local function driveRecall(character: Model, recall: Recall)
	local spin = 0
	local lastBolt = 0
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		if recalls[character] ~= recall then
			connection:Disconnect()
			return
		end
		local now = os.clock()
		local age = now - recall.born
		if age > 4 or not character.Parent then
			connection:Disconnect()
			endRecall(character)
			return
		end
		spin += dt * (if recall.phase == "hang" then 20 else 32)
		local root = U.getRoot(character)
		if recall.phase == "out" then
			local a = math.clamp(age / recall.out, 0, 1)
			recall.position = recall.origin:Lerp(recall.target, 1 - (1 - a) ^ 2)
			if a >= 1 then
				recall.phase = "hang"
			end
		elseif recall.phase == "back" and root then
			local offset = root.Position - recall.position
			local step = recall.speed * dt
			if offset.Magnitude <= math.max(step, 2.5) then
				recall.position = root.Position
				recall.phase = "home"
			else
				recall.position += offset.Unit * step
			end
			if now - lastBolt > 0.05 then
				lastBolt = now
				local arm = character:FindFirstChild("Left Arm") :: BasePart?
				if arm then
					U.lightning((arm.CFrame * CFrame.new(0, -1, 0)).Position, recall.position, BLACK, RED, 0.1, 0.08)
				end
			end
		end
		local bob = if recall.phase == "hang" then UP * math.sin(age * 7) * 0.3 else Vector3.zero
		recall.handle.CFrame = CFrame.new(recall.position + bob)
			* CFrame.Angles(0, spin, 0)
			* CFrame.Angles(0, 0, math.pi / 2)
			* CFrame.new(0, -RECALL_MIDDLE, 0)
	end)
end

function handlers.SlayerRecall(data, character, root)
	local phase = data.phase
	if phase == "Wind" then
		play(character, ANIMS.RecallThrow)
		swordGlow(character, RED, 0.35, 0.3)
		swordAura(character, 0.3, 40)
		edgeGlow(character, 0.35, 0.8)
		for i = 0, 4 do
			task.delay(i * 0.05, function()
				local point = bladePoint(character, 1)
				if point then
					inflow(point, 5)
				end
			end)
		end
	elseif phase == "Throw" then
		endRecall(character)
		local copy, handle = looseSword(character)
		local restore = hideSword(character)
		if not copy or not handle then
			restore()
			return
		end
		local origin: Vector3 = data.origin
		local target: Vector3 = data.target
		local blade = copy:FindFirstChild("Blade", true)
		if blade and blade:IsA("BasePart") then
			local glow = Instance.new("PointLight")
			glow.Color = RED
			glow.Range = 14
			glow.Brightness = 3
			glow.Parent = blade
			partEmitter(blade, {
				Texture = U.textures.Smoke,
				Color = ColorSequence.new(BLACK),
				Size = NumberSequence.new(1.4, 0),
				Transparency = NumberSequence.new(0.35, 1),
				Lifetime = NumberRange.new(0.25, 0.4),
				Rate = 70,
				Speed = NumberRange.new(0, 1),
				LightEmission = 0,
			}, 4)
		end
		local recall: Recall = {
			copy = copy,
			handle = handle,
			restore = restore,
			origin = origin,
			target = target,
			out = data.out or 0.42,
			position = origin,
			phase = "out",
			speed = 95,
			born = os.clock(),
		}
		recalls[character] = recall
		driveRecall(character, recall)
		local direction = if (target - origin).Magnitude > 0.1 then (target - origin).Unit else root.CFrame.LookVector
		glowBurst(origin, 3, 0.25)
		U.impactRing(origin, direction, RED, 1, 7, 0.25)
		task.delay(0.04, U.impactRing, origin + direction * 2, direction, BLACK, 0.8, 6, 0.25)
		U.burst(origin, {
			color = RED,
			count = 14,
			size = 0.5,
			speed = NumberRange.new(30, 55),
			lifetime = NumberRange.new(0.15, 0.3),
			streaks = true,
			spread = 25,
			direction = direction,
		})
		if U.isLocal(character) then
			CameraShake.Add(0.12)
			CameraShake.FovKick(5)
		end
	elseif phase == "Return" then
		local recall = recalls[character]
		if recall then
			recall.phase = "back"
			recall.speed = data.speed or recall.speed
			glowBurst(recall.position, 3.5, 0.3)
			blackLightning(recall.position, 3, 3, 0.2)
		end
		play(character, ANIMS.RecallCall)
	elseif phase == "Catch" then
		endRecall(character)
		if data.instant then
			return -- snapped back for another move: that move's animation plays
		end
		play(character, ANIMS.RecallCatch)
		local point = bladePoint(character, 0.5) or root.Position
		glowBurst(point, 3.5, 0.3)
		edgeGlow(character, 0.4, 1)
		redSparks(point, 12, 0.6)
		blackSmoke(point, 6, 2.5, 6)
		U.ringBurst(CFrame.new(root.Position), RED, 1, 6, 0.25, 0.2)
		if U.isLocal(character) then
			CameraShake.Add(0.12)
		end
	end
end

-- Conquering Eon: the Demon-Dweller's markings fill with what it drinks in.
local MARK_DARK = Color3.fromRGB(10, 10, 10)
local function lightMarks(character: Model, charges: number)
	local sword = getSword(character)
	if not sword then
		return
	end
	for i = 0, 4 do
		local mark = sword:FindFirstChild("Mark" .. i, true)
		if mark and mark:IsA("BasePart") then
			local on = charges > 0 and i <= charges
			U.tween(mark, 0.15, { Color = if not on then MARK_DARK elseif i == 0 then RED else HOT })
		end
	end
end

function handlers.ConqueringEon(data, character, root)
	local phase = data.phase
	local air = data.airborne == true
	if phase == "Raise" then
		local token = bump(character)
		local duration = data.duration or 0.6
		play(character, if air then ANIMS.AirDividerCharge else ANIMS.GrandCharge)
		lightMarks(character, 0)
		edgeGlow(character, duration, 0.6)
		swordAura(character, duration, 30)
		-- Its pull: rings closing in from the edge of its reach, mana
		-- streaming into the blade.
		local feet = feetOf(character, root)
		U.ringBurst(CFrame.new(feet + UP * 0.2), BLACK, 18, 2, duration, 0.4)
		U.ringBurst(CFrame.new(feet + UP * 0.25), RED, 18, 2, duration * 0.85, 0.15)
		task.spawn(function()
			local start = os.clock()
			while live(character, token) and os.clock() - start < duration do
				local point = bladePoint(character, 1.2)
				if point then
					inflow(point, 9)
					inflow(point, 5)
				end
				task.wait(0.05)
			end
		end)
		if U.isLocal(character) then
			CameraShake.Add(0.08)
		end
	elseif phase == "Absorb" then
		local charges = data.charges or 1
		lightMarks(character, charges)
		local point = bladePoint(character, 1.2)
		if point and typeof(data.from) == "Vector3" then
			U.lightning(data.from, point, BLACK, RED, 0.24, 0.2, true)
			U.lightning(data.from, point, RED, HOT, 0.08, 0.15)
			glowBurst(point, 2.5 + charges * 0.6, 0.25)
			U.burst(point, {
				color = HOT,
				count = 10,
				size = 0.4,
				speed = NumberRange.new(8, 20),
				lifetime = NumberRange.new(0.15, 0.3),
			})
		end
		if U.isLocal(character) then
			CameraShake.Add(0.1)
		end
	elseif phase == "Siphon" then
		lightMarks(character, data.charges or 1)
		for _, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				U.highlight(target, RED, 0.45, 0.35)
				redSparks(targetRoot.Position, 8, 0.5)
				blackSmoke(targetRoot.Position, 5, 2, 4)
				for i = 0, 5 do
					task.delay(i * 0.06, function()
						local point = bladePoint(character, 1.2)
						if point and targetRoot.Parent then
							U.lightning(targetRoot.Position, point, BLACK, RED, 0.14, 0.1, i % 2 == 0)
						end
					end)
				end
			end
		end
	elseif phase == "Release" then
		bump(character)
		local charges = data.charges or 0
		play(character, if air then ANIMS.AirDividerRelease else ANIMS.GrandRelease)
		heavyTrail(character, 0.3)
		crescent(character, {
			center = CFrame.new(0, 0.6, 0),
			radius = 7 + charges,
			from = 100,
			to = if air then -120 else -40,
			tilt = 90,
			width = 2 + 0.4 * charges,
			sweep = 0.1,
			fade = 0.35,
			glow = 0.5 + 0.12 * charges,
		})
		local point = bladePoint(character, 2) or root.Position
		glowBurst(point, 4 + 1.5 * charges, 0.35)
		bloomPulse(root.Position, 0.4 + 0.2 * charges, 0.45)
		edgeGlow(character, 0.4, 1)
		U.shockwave(root.Position, RED, 2, 10 + 3 * charges, 0.35)
		blackLightning(point, 3 + charges, 4 + charges)
		task.delay(0.45, lightMarks, character, 0)
		if U.isLocal(character) then
			CameraShake.Add(0.15 + 0.06 * charges)
			CameraShake.FovKick(6 + 2 * charges)
			if charges >= 3 then
				impactFrame(0.6)
			end
		end
	elseif phase == "Cancel" then
		bump(character)
		lightMarks(character, 0)
	end
end

-- Causality Break: the Demon-Destroyer's clover guard and plate flare up.
local function destroyerFlare(character: Model, duration: number)
	local sword = getSword(character)
	if not sword then
		return
	end
	for _, part in sword:GetDescendants() do
		if part:IsA("BasePart") and (part.Name == "GuardPlate" or part.Name:sub(1, 6) == "Clover") then
			local color = part.Color
			U.tween(part, 0.1, { Color = WHITE_HOT })
			task.delay(duration, function()
				if part.Parent then
					U.tween(part, 0.3, { Color = color })
				end
			end)
		end
	end
end

function handlers.CausalityBreak(data, character, root)
	local phase = data.phase
	if phase == "Plant" then
		bump(character)
		play(character, ANIMS.CausalityPlant)
		edgeGlow(character, 0.5, 0.8)
		swordAura(character, 0.45, 40)
		destroyerFlare(character, 0.7)
		task.delay(0.25, heavyTrail, character, 0.2)
	elseif phase == "Break" then
		local tip = bladePoint(character, 2.1) or root.Position + root.CFrame.LookVector * 3
		local ground = U.groundBelow(tip + UP * 1.5, { character }, 6)
		local point = if ground then ground.Position else tip
		-- The blade bites in: a white-hot flash, the ground splits round it,
		-- and a ring of broken causality spreads out to its reach.
		glowBurst(point, 5, 0.35)
		bloomPulse(point, 0.7, 0.5)
		U.groundCracks(point, 9, 9, RED, 1.6)
		U.groundRocks(point, 8, 5, 1.2)
		U.debris(point, 10, 30, 0.8)
		U.pillar(point, RED, 1.2, 16, 0.35)
		U.ringBurst(CFrame.new(point + UP * 0.3), WHITE, 2, 18, 0.4, 0.25)
		task.delay(0.05, U.ringBurst, CFrame.new(point + UP * 0.3), RED, 2, 18, 0.5, 0.45)
		task.delay(0.1, U.ringBurst, CFrame.new(point + UP * 0.3), BLACK, 2, 16, 0.55, 0.6)
		blackLightning(point, 6, 5)
		-- It runs through the ground to each of them and breaks what they had.
		for i, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				task.delay(0.03 * i, function()
					if not targetRoot.Parent then
						return
					end
					local feet = targetRoot.Position - UP * 2.8
					U.lightning(point, feet, BLACK, RED, 0.25, 0.25, true)
					U.lightning(point + UP * 0.2, feet + UP * 0.2, RED, HOT, 0.08, 0.2)
					U.ringBurst(CFrame.new(feet + UP * 0.2), WHITE, 4, 0.5, 0.3, 0.12)
					U.shards(targetRoot.Position, WHITE, 8)
					U.shards(targetRoot.Position, RED, 6)
					glowBurst(targetRoot.Position, 3, 0.25)
					U.highlight(target, WHITE, 0.25, 0.5)
					U.popup(targetRoot.Position + UP * 3.5, "BROKEN", WHITE, 1)
				end)
			end
		end
		if U.isLocal(character) or #data.targets > 0 and involves({ target = data.targets[1] }, character) then
			CameraShake.Add(0.3)
			CameraShake.FovKick(8)
			impactFrame(0.5)
		end
	elseif phase == "Pull" then
		play(character, ANIMS.CausalityPull)
		heavyTrail(character, 0.25)
		local tip = bladePoint(character, 2.1)
		if tip then
			blackSmoke(tip, 8, 3, 6)
			redSparks(tip, 10, 0.6, UP)
		end
	elseif phase == "Cancel" then
		bump(character)
	end
end

function handlers.Severance(data, character, root)
	local phase = data.phase
	if phase == "Draw" then
		play(character, ANIMS.Severance)
		swordGlow(character, RED, 0.3, 0.4)
		edgeGlow(character, 0.55, 0.9)
		destroyerFlare(character, 0.4)
		local point = bladePoint(character, 1.5)
		if point then
			U.glint(point, 1.6, WHITE_HOT)
		end
	elseif phase == "Dash" then
		local direction: Vector3 = data.direction
		U.speedLines(root, direction, 0.25, RED)
		U.bodyTrail(character, RED, 0.25)
		heavyTrail(character, 0.2)
		for i = 0, 3 do
			task.delay(i * 0.05, U.afterimage, character, BLACK, 0.3)
		end
		glowBurst(data.from, 2.5, 0.2)
		if U.isLocal(character) then
			CameraShake.FovKick(10)
		end
	elseif phase == "Sheathe" then
		local from: Vector3 = data.from
		local to: Vector3 = data.to
		-- The cut hangs in the air along his path, then lands all at once.
		cutLine(from + UP * 0.6, to + UP * 0.6, 0.5, 0.35)
		for _, target in data.targets do
			local targetRoot = U.getRoot(target)
			if targetRoot then
				local direction = if (to - from).Magnitude > 0.1 then (to - from).Unit else root.CFrame.LookVector
				slashMark(targetRoot.Position, markAngle(targetRoot.Position, direction), 6, 0.45)
				task.delay(0.35, function()
					if not targetRoot.Parent then
						return
					end
					glowBurst(targetRoot.Position, 3.5, 0.3)
					U.impactRing(targetRoot.Position, direction, RED, 1, 7, 0.3)
					U.burst(targetRoot.Position, {
						color = RED,
						count = 18,
						size = 0.6,
						speed = NumberRange.new(30, 60),
						lifetime = NumberRange.new(0.15, 0.35),
						streaks = true,
						spread = 40,
						direction = direction,
					})
					blackLightning(targetRoot.Position, 4, 4)
				end)
			end
		end
		if #data.targets > 0 and (U.isLocal(character) or involves({ target = data.targets[1] }, character)) then
			task.delay(0.35, function()
				CameraShake.Add(0.25)
				impactFrame(0.6)
			end)
		end
	elseif phase == "Seal" then
		-- Severed from their magic: red seal rings close round them.
		local target = data.target
		local targetRoot = U.getRoot(target)
		if not targetRoot then
			return
		end
		U.popup(targetRoot.Position + UP * 3.5, "SEALED", RED, 1.3)
		U.highlight(target, RED, 0.5, 0.4)
		local duration = data.duration or 3
		for i = 0, math.floor(duration / 0.4) do
			task.delay(i * 0.4, function()
				if targetRoot.Parent then
					local tilt = CFrame.Angles(math.rad(15 * math.sin(i)), 0, math.rad(15 * math.cos(i)))
					U.ringBurst(CFrame.new(targetRoot.Position + UP * (i % 3 - 1) * 1.2) * tilt, RED, 3, 2.2, 0.35, 0.1)
				end
			end)
		end
	end
end

function handlers.InfiniteSlash(data, character, root)
	local phase = data.phase
	if phase == "Raise" then
		local token = bump(character)
		local duration = data.duration or 0.55
		play(character, ANIMS.InfiniteRaise)
		edgeGlow(character, duration, 0.7)
		swordAura(character, duration, 35)
		U.pillar(feetOf(character, root), BLACK, 2.5, 9, duration + 0.1, Enum.Material.ForceField, 0.2)
		task.spawn(function()
			local start = os.clock()
			while live(character, token) and os.clock() - start < duration do
				local point = bladePoint(character, 1.5)
				if point then
					inflow(point, 6)
				end
				task.wait(0.06)
			end
		end)
		if U.isLocal(character) then
			U.colorGrade({ Saturation = -0.5, Contrast = 0.25 }, 0.2, duration, 0.4)
			CameraShake.Add(0.06)
		end
	elseif phase == "Cut" then
		bump(character)
		play(character, ANIMS.InfiniteCut)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local length: number = data.length
		crescent(character, {
			center = CFrame.new(0, 0.6, 0),
			radius = 5,
			from = 100,
			to = -40,
			tilt = 90,
			width = 1.2,
			sweep = 0.06,
			fade = 0.25,
			glow = 0.8,
		})
		-- One straight cut through everything ahead, opening a beat later.
		local finish = origin + direction * length
		cutLine(origin, finish, 0.7, 0.2)
		glowBurst(origin, 3.5, 0.25)
		bloomPulse(origin, 0.6, 0.45)
		for along = 8, length, 8 do
			local point = origin + direction * along
			task.delay(along / 400, function()
				local ground = U.groundBelow(point, { character }, 6)
				if ground then
					U.groundCracks(ground.Position, 2, 4, RED, 1)
					U.debris(ground.Position, 3, 18, 0.5)
				end
				redSparks(point, 4, 0.4, direction)
			end)
		end
		glowBurst(finish, 2.5, 0.25)
		if U.isLocal(character) then
			CameraShake.Add(0.25)
			CameraShake.FovKick(9)
			impactFrame(0.6)
		end
	elseif phase == "Cancel" then
		bump(character)
	end
end

function handlers.Zetten(data, character, root)
	local phase = data.phase
	if phase == "Stance" then
		local token = bump(character)
		local duration = data.duration or 1
		play(character, ANIMS.ZettenStance)
		edgeGlow(character, duration, 0.4)
		-- Reading ki: faint rings washing out to the edge of what he senses.
		task.spawn(function()
			local start = os.clock()
			while live(character, token) and os.clock() - start < duration do
				U.ringBurst(CFrame.new(feetOf(character, root) + UP * 0.2), WHITE, 2, 20, 0.6, 0.06)
				task.wait(0.33)
			end
		end)
		if U.isLocal(character) then
			U.colorGrade({ Saturation = -0.35 }, 0.15, duration, 0.3)
		end
	elseif phase == "Strike" then
		bump(character)
		play(character, ANIMS.ZettenCut)
		local from: Vector3 = data.from
		local to: Vector3 = data.to
		local direction = if (to - from).Magnitude > 0.1 then (to - from).Unit else root.CFrame.LookVector
		-- He's past them in a flash: an afterimage where he stood, the line he
		-- took cut into the air, and the cut opening on them.
		cutLine(from + UP * 0.5, to + UP * 0.5, 0.35, 0.25)
		glowBurst(from, 2, 0.2)
		crescent(character, {
			center = CFrame.new(0, 0.4, 0),
			radius = 5,
			from = -110,
			to = 70,
			tilt = 55,
			width = 1.4,
			sweep = 0.07,
			fade = 0.3,
			glow = 0.9,
		})
		local targetRoot = U.getRoot(data.target)
		if targetRoot then
			glowBurst(targetRoot.Position, 4, 0.3)
			slashMark(targetRoot.Position, markAngle(targetRoot.Position, (direction + UP * 0.8).Unit), 7, 0.4)
			U.burst(targetRoot.Position, {
				color = RED,
				count = 20,
				size = 0.6,
				speed = NumberRange.new(30, 65),
				lifetime = NumberRange.new(0.15, 0.35),
				streaks = true,
				spread = 40,
				direction = direction,
			})
			blackLightning(targetRoot.Position, 5, 4)
		end
		bloomPulse(to, 0.6, 0.4)
		if involves(data, character) then
			CameraShake.Add(0.28)
			CameraShake.FovKick(10)
			impactFrame(0.8)
		end
	elseif phase == "Cut" then
		bump(character)
		play(character, ANIMS.ZettenCut)
		heavyTrail(character, 0.2)
		crescent(character, {
			center = CFrame.new(0, 0.4, 0),
			radius = 5,
			from = -110,
			to = 70,
			tilt = 55,
			width = 1.2,
			sweep = 0.08,
			fade = 0.3,
			glow = 0.6,
		})
		if U.isLocal(character) then
			CameraShake.Add(0.1)
		end
	elseif phase == "Cancel" then
		bump(character)
	end
end

function Kit.OnSkill(data)
	local character = data.character
	if typeof(character) ~= "Instance" or not character:IsA("Model") then
		return
	end
	local root = U.getRoot(character)
	local handler = handlers[data.skill]
	if root and handler then
		handler(data, character, root)
	end
end

-- Asta's dash: leans into it with the sword trailing, leaving black
-- afterimages and anti-magic smoke, red sparks streaming off behind.
local DASH_DIRECTIONS = {
	Front = Vector3.new(0, 0, -1),
	Back = Vector3.new(0, 0, 1),
	Left = Vector3.new(-1, 0, 0),
	Right = Vector3.new(1, 0, 0),
}

VFX.RegisterKitEffect("AntiMagic", "Dash", function(data)
	local character: Model? = data.character
	local root = U.getRoot(character)
	if not character or not root then
		return
	end
	local direction = if type(data.direction) == "string" then data.direction else "Front"
	local animation = ANIMS["Dash" .. direction]
	if animation then
		play(character, animation)
	end
	swordTrail(character, 0.26)

	U.afterimage(character, BLACK, 0.3)
	for i = 1, 3 do
		task.delay(i * 0.05, function()
			if character.Parent then
				U.afterimage(character, if i == 3 then DARK_RED else BLACK, 0.25)
			end
		end)
	end

	local ground = U.groundBelow(root.Position, { character })
	local feet = if ground then ground.Position else root.Position - UP * 3
	blackSmoke(feet + UP * 0.4, 6, 2.2, 7)
	U.ringBurst(CFrame.new(feet + UP * 0.1), BLACK, 0.6, 3.5, 0.25, 0.14)

	-- Sparks fly off opposite to the dash.
	local away = -(root.CFrame:VectorToWorldSpace(DASH_DIRECTIONS[direction] or DASH_DIRECTIONS.Front))
	U.burst(root.Position - UP * 0.5, {
		color = RED,
		count = 7,
		size = 0.35,
		speed = NumberRange.new(14, 26),
		lifetime = NumberRange.new(0.12, 0.25),
		streaks = true,
		spread = 30,
		direction = away,
	})
end)

-- Sword clashes: whenever Asta's sword is blocked, or he blocks with it,
-- molten orange sparks fly off the contact point.
local function clashDirection(data): Vector3
	local victimRoot = U.getRoot(data.victim)
	local attackerRoot = U.getRoot(data.attacker)
	if victimRoot and attackerRoot then
		local toward = attackerRoot.Position - victimRoot.Position
		return (Vector3.new(toward.X, 0, toward.Z).Unit + UP * 0.7).Unit
	end
	return UP
end

VFX.RegisterKitEffect("AntiMagic", "Block", function(data)
	local position: Vector3 = data.position
	U.sparks(position, clashDirection(data), 1)
	U.highlight(data.victim, Color3.fromRGB(255, 170, 80), 0.1)
	if U.isLocal(data.attacker) or U.isLocal(data.victim) then
		CameraShake.Add(0.12)
	end
end)

VFX.RegisterKitEffect("AntiMagic", "GuardBreak", function(data)
	local position: Vector3 = data.position
	local direction = clashDirection(data)
	U.sparks(position, direction, 1.8)
	task.delay(0.05, U.sparks, position, (direction + U.randomUnit() * 0.4).Unit, 1.2)
	U.shards(position, Color3.fromRGB(255, 160, 60), 12)
	U.flash(position, Color3.fromRGB(255, 190, 110), 6, 0.2)
	U.light(position, Color3.fromRGB(255, 140, 50), 10, 18, 0.35)
	U.highlight(data.victim, Color3.fromRGB(255, 140, 50), 0.35)
	U.popup(position + UP * 2, "GUARD BREAK", Color3.fromRGB(255, 170, 60), 1.5)
	if U.isLocal(data.attacker) or U.isLocal(data.victim) then
		CameraShake.Add(0.4)
	end
end)

VFX.RegisterKitEffect("AntiMagic", "PerfectBlock", function(data)
	VFX.PlayDefault("PerfectBlock", data)
	U.sparks(data.position, clashDirection(data), 1.4)
end)

function Kit.SetAwakened(character: Model, on: boolean)
	-- During the transformation the look waits for the burst.
	if on and (revealAt[character] or 0) > os.clock() then
		return
	end
	setAwakened(character, on)
end

-- A brighter, black-lightning version of the heavy hit for perfect Dividers.
VFX.Register("PerfectDivider", function(data)
	VFX.Play("HeavyHit", data)
	local position: Vector3 = data.position
	blackLightning(position, 8, 6)
	blackSmoke(position, 12, 4, 20)
	U.flash(position, BLACK, 9, 0.25)
	if U.isLocal(data.attacker) or U.isLocal(data.victim) then
		CameraShake.Add(0.5)
	end
end)

return Kit
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="36">
              <Properties>
                <string name="Name">Animations</string>
                <string name="Source"><![CDATA[--[[
	Anti-Magic Knight animation data.

	GENERATED by tools/anim/emit.py from tools/anim/asta_anims.py. Every
	keyframe and the in-betweens are checked against an R6 model of the rig
	(blade clear of the body, tip above the floor), so edit the Python and
	re-run it instead of editing this file by hand.

	Each animation: keys = { {time, pose, easingStyle?, easingDirection?}, ... }
	  rot(x, y, z)          torso/head/leg rotation (degrees)
	  body(dy, x, y, z)     torso lowered/raised dy studs, then rotated (the
	                        feet are planted on the floor this way)
	  limb(pitch, yaw, roll) arm/leg aim (degrees)
	  aim(x, y, z)          which way the blade points, in character space
	                        (X right, Y up, -Z forward); the wrist is solved
	                        from it when the clip is built
]]

local rad = math.rad

local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

local function body(dy: number, x: number, y: number?, z: number?): CFrame
	return CFrame.new(0, dy, 0) * CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

local function limb(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, rad(yaw or 0), 0) * CFrame.Angles(0, 0, rad(roll or 0)) * CFrame.Angles(rad(pitch), 0, 0)
end

local function aim(x: number, y: number, z: number): { aim: Vector3 }
	return { aim = Vector3.new(x, y, z) }
end

