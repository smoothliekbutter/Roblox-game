end
for u,v in m do
local w=if v.bone==4 then v.at else k[v.bone]*v.at
t.feathers[u]=CFrame.new(w*s,-v.drop,v.layer)
end
q[s]=t
end
local r:{CFrame}={}
local s:{CFrame}={}
for t,u in m do
r[t]=CFrame.new(0,-u.length/2,0)
s[t]=CFrame.new(0,-u.length*0.47,0.01)
end
local t=CFrame.new(0,0,0.12)
local u=CFrame.new(0,0,0.05)

function i.Bones(v:CFrame,w:number,x:Hold,y:number):(CFrame,CFrame,CFrame)
local z=q[w]
local A=x.beat

local B=x.lift+10*A*math.sin(y)
local C=x.sweep+12*A*math.sin(y-0.5)
local D=x.elbow+7*A*math.sin(y-0.9)
local E=x.wrist+11*A*math.sin(y-1.6)
local F=v
*z.root
*CFrame.Angles(0,b(-C)*w,b(B)*w)
*CFrame.Angles(b(-x.twist),0,0)
local G=F*z.bones[1]*CFrame.Angles(0,0,b(D)*w)

local H=G*z.bones[2]*CFrame.Angles(0,b(-10)*w,b(E)*w)
return F,G,H
end

function i.Pose(
v:{CFrame},
w:CFrame,
x:number,
y:Hold,
z:number,
A:number,
B:number
)
local C=q[x]
local D,E,F=i.Bones(w,x,y,z)
local G={D,E,F,w*C.root}
local H=10*y.beat*math.cos(z-0.9)-A*4
local I=0
for J,K in m do
local L=2.5*math.sin(B*2.3-J*0.55)+A*2*math.sin(B*15-J*1.3)
local M=G[K.bone]
*C.feathers[J]
*CFrame.Angles(b(H*K.flex),0,b(K.angle+L*K.flex)*x)
I+=1
v[I]=M*r[J]
if K.quill then
I+=1
v[I]=M*s[J]
end
end
for J=1,3 do
I+=1
v[I]=G[J]*C.middles[J]
end
I+=1
v[I]=E*t
I+=1
v[I]=F*t
I+=1
v[I]=D*u
end



export type Maker=(props:{[string]:any},base:number,wedge:boolean?)->BasePart

export type Wing={
parts:{BasePart},
frames:{CFrame},
trails:{Trail},
emitters:{ParticleEmitter},
beams:{Beam},
