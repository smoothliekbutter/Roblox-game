}

function i.new(v:Maker,w:number):Wing
local x:{BasePart}={}
for y,z in o do
local A=v({
Shape=if z.shape=="Ball"then Enum.PartType.Ball else Enum.PartType.Block,
Size=z.size,
Color=z.color,
},z.transparency)
if z.shape=="Feather"then

local B=Instance.new("SpecialMesh")
B.MeshType=Enum.MeshType.Sphere
B.Parent=A
end
table.insert(x,A)
end
local y=table.create(#x,CFrame.identity)

local z:{Trail}={}
local A:{ParticleEmitter}={}
local B=0
for C,D in m do
B+=1
local E=x[B]
if D.trail then
local F=-D.length/2
table.insert(
z,
a.trail(E,Vector3.new(0,F+0.55,0),Vector3.new(0,F+0.05,0),{
