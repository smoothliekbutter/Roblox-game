      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">BlackMoon</string>
          <string name="Source"><![CDATA[

local a={}


a.Times={
Release=0.15,
Night=0.5,
Rise=0.6,
Leap=1.0,
Apex=1.35,
Perch=1.4,
Close=2.5,
Point=2.9,
Glint=3.4,
Fly=3.75,
Cut=3.9,
Arrive=4.0,
Land=4.9,
Done=5.9,
}

local b=Vector3.yAxis
local c=1.2

export type Plan={
origin:CFrame,
forward:Vector3,
right:Vector3,
victimStart:Vector3,
apex:Vector3,
cut:Vector3,
perch:Vector3,
through:Vector3,
beyond:Vector3,
moonCamera:Vector3,
moon:Vector3,
moonRadius:number,
}

local function d(e:Vector3,f:Vector3):Vector3
local g=Vector3.new(e.X,0,e.Z)
return if g.Magnitude>1e-3 then g.Unit else f
end

local function e(f:number):number
return 1-(1-f)*(1-f)
end

function a.Plan(f:CFrame,g:Vector3):Plan
local h=d(f.LookVector,Vector3.new(0,0,-1))
local i=h:Cross(b)
local j=CFrame.lookAt(f.Position,f.Position+h)
local k=f.Position+h*5+b*34
local l=k-h*22-b*5+i*5

local m=k+b*(a.Times.Cut-a.Times.Apex)*c
local n=(m-l).Unit
local o=m+n*14

local p=k+(l-k)*0.2+i*2.5-b*7
local q=l+(l-p).Unit*280+b*10
return{
origin=j,
forward=h,
right=i,
victimStart=g,
apex=k,
cut=m,
perch=l,
through=n,
beyond=o,
moonCamera=p,
moon=q,
moonRadius=95,
}
end


function a.Attacker(f:Plan,g:number):CFrame
local h=a.Times
local i=d(f.apex-f.perch,f.forward)
if g<h.Leap then
return f.origin
elseif g<h.Perch then

local j=(g-h.Leap)/(h.Perch-h.Leap)
local k=f.origin.Position:Lerp(f.perch,e(j))+b*math.sin(j*math.pi)*4
return CFrame.lookAt(k,k+i)
elseif g<h.Fly then

local j=g-h.Perch
local k=f.perch+b*math.sin(j*5.3)*0.6+f.right*math.sin(j*1.8)*0.35
return CFrame.lookAt(k,k+i)
elseif g<h.Arrive then

local j=(g-h.Fly)/(h.Arrive-h.Fly)
local k=f.perch:Lerp(f.beyond,j)
return CFrame.lookAt(k,k+i)
end
return CFrame.lookAt(f.beyond,f.beyond+i)
end

function a.Victim(f:Plan,g:number):CFrame
local h=a.Times
local i=d(f.perch-f.apex,-f.forward)
local j=math.min(g,h.Cut)
local k
if j<h.Release then
k=f.victimStart
elseif j<h.Apex then
k=f.victimStart:Lerp(f.apex,e((j-h.Release)/(h.Apex-h.Release)))
else
k=f.apex+b*(j-h.Apex)*c
end
local l=math.max(j-h.Release,0)*math.rad(110)
return CFrame.lookAt(k,k+i)*CFrame.Angles(-l,0,0)
end

local function f(g:Vector3,h:Vector3,i:number):Vector3
return g+CFrame.Angles(0,math.rad(i),0):VectorToWorldSpace(h-g)
end

function a.Camera(g:Plan,h:number):(CFrame,number)
local i=a.Times
local j=a.Attacker(g,h).Position
local k=a.Victim(g,h).Position
if h<i.Rise then
local l=(g.origin*CFrame.new(5.5,1.2,7)).Position
return CFrame.lookAt(l,(j+b*2):Lerp(k,0.65)),70
elseif h<i.Perch then

local l=g.origin.Position+g.forward*26+g.right*6+b*2.5
return CFrame.lookAt(l,k:Lerp(g.perch,0.35)),62
elseif h<i.Close then
local l=g.moonCamera:Lerp(g.perch,0.05*(h-i.Perch))
return CFrame.lookAt(l,j+b*0.5),45
elseif h<i.Fly then

local l=g.perch+(g.moonCamera-g.perch).Unit*10-b*1.5
local m=f(g.perch,l,(h-i.Close)*10-6)
return CFrame.lookAt(m,j+b*1),38
elseif h<i.Arrive then
local l=g.cut+g.through*10+g.right*3+b*1.5
return CFrame.lookAt(l,g.perch),55
end
local l=g.beyond+g.through*8-g.right*2.5+b*1
local m=f(g.beyond,l,(h-i.Arrive)*-14)
return CFrame.lookAt(m,g.beyond-g.through*6),50
end

return a]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CombatState</string>
          <string name="Source"><![CDATA[

local a={}

local b={
StunUntil=0,
BusyUntil=0,
CastUntil=0,
IFrameUntil=0,
Blocking=false,
BlockStart=0,
Ragdolled=false,
Evasive=0,
Awakening=0,
Awakened=false,
Rooted=false,
}

a.SkillSlots=4
a.SpecialSlot=5

local function c():number
return workspace:GetServerTimeNow()
end
a.Now=c

function a.Setup(d:Model)
for e,f in b do
d:SetAttribute(e,f)
end
a.ResetCooldowns(d)
a.ResetSpecial(d)
end

function a.ResetCooldowns(d:Model)
for e=1,a.SkillSlots do
d:SetAttribute("CD"..e,0)
d:SetAttribute("CDLen"..e,1)
end
end

function a.ResetSpecial(d:Model)
d:SetAttribute("CD"..a.SpecialSlot,0)
d:SetAttribute("CDLen"..a.SpecialSlot,1)
end

function a.IsAlive(d:Model?):boolean
if not d then
return false
end
local e=d:FindFirstChildOfClass("Humanoid")
return e~=nil and e.Health>0 and d:FindFirstChild("HumanoidRootPart")~=nil
end

function a.IsStunned(d:Model):boolean
return(tonumber(d:GetAttribute("StunUntil"))or 0)>c()
end

function a.IsBusy(d:Model):boolean
return(tonumber(d:GetAttribute("BusyUntil"))or 0)>c()
end

function a.IsCasting(d:Model):boolean
return(tonumber(d:GetAttribute("CastUntil"))or 0)>c()
end

function a.IsAwakened(d:Model):boolean
return d:GetAttribute("Awakened")==true
end


function a.Cooldown(d:Model,e:number):(number,number)
local f=tonumber(d:GetAttribute("CD"..e))or 0
local g=tonumber(d:GetAttribute("CDLen"..e))or 1
return math.max(f-c(),0),g
end

function a.IsRagdolled(d:Model):boolean
return d:GetAttribute("Ragdolled")==true
end

function a.IsBlocking(d:Model):boolean
return d:GetAttribute("Blocking")==true
end

function a.HasIFrames(d:Model):boolean
return(tonumber(d:GetAttribute("IFrameUntil"))or 0)>c()
end



function a.CanAct(d:Model):boolean
return a.IsAlive(d)
and not a.IsStunned(d)
and not a.IsRagdolled(d)
end



function a.Stun(d:Model,e:number)
local f=math.max(tonumber(d:GetAttribute("StunUntil"))or 0,c()+e)
d:SetAttribute("StunUntil",f)
end

function a.ClearStun(d:Model)
d:SetAttribute("StunUntil",0)
end

function a.SetCasting(d:Model,e:number)
d:SetAttribute("CastUntil",c()+e)
end

function a.ClearCasting(d:Model)
d:SetAttribute("CastUntil",0)
end

function a.StartCooldown(d:Model,e:number,f:number)
d:SetAttribute("CD"..e,c()+f)
d:SetAttribute("CDLen"..e,math.max(f,0.01))
end

function a.SetBusy(d:Model,e:number)
d:SetAttribute("BusyUntil",c()+e)
end

function a.GiveIFrames(d:Model,e:number)
d:SetAttribute("IFrameUntil",c()+e)
end

function a.SetBlocking(d:Model,e:boolean)
d:SetAttribute("Blocking",e)
if e then
d:SetAttribute("BlockStart",c())
end
end

return a]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[

local a={}

a.Debug={

ShowHitboxes=false,
}


a.PlayTest={
InfiniteAwakening=true,
}

a.Movement={
WalkSpeed=16,
JumpHeight=4.5,
AirJumpSpeed=24,
