or h.IsBlocking(R)
or h.IsCasting(R)
or R:GetAttribute("SwordAway")==true
then
return
end
local U=os.clock()
if U<C then
return
end

if w then
if w.Parent then
w:Destroy()
end
w=nil
end
if U-B>g.M1.ResetTime then
A=0
end
A+=1
B=U

local V=A
local W=S.FloorMaterial==Enum.Material.Air

local X=not W and K(S)
local Y="Normal"
if V>=g.M1.ComboLength then
A=0
F=0
C=U+g.M1.EndLag
D=U+g.M1.FinisherBusy
if W then
Y="Downslam"
elseif X then

Y="Uppercut"
C=U+g.M1.UppercutEndLag
D=U+g.M1.UppercutJumpAfter
E=true
else
Y="Knockback"
end
else
C=U+g.M1.SwingCooldown
D=U+(if V==g.M1.ComboLength-1 then g.M1.DownslamJumpAfter else g.M1.Busy)
