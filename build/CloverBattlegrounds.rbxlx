local m:{Feather}={}
local function n(o:{[string]:any},p:{{number}})
for q,r in p do
table.insert(m,{
bone=r[1],
at=r[2],
angle=r[3],
length=r[4]*j,
width=r[5]*j,

layer=o.layer+q*0.006,
drop=o.drop,
color=o.color,
transparency=o.transparency,
quill=o.quill==true,
flex=o.flex,
trail=o.trail==true and q>=#p-2,
})
end
end


n({layer=0,drop=0.1,color=d:Lerp(e,0.25),transparency=0.56,quill=true,flex=0.6},{
