local t=o[r+1]
if t and t~=""then
local u={}
for v in t:sub(2):gmatch("%S+")do
table.insert(u,tonumber(v)::number)
end
q[s]=f[t:sub(1,1)](table.unpack(u))
end
end
local r=p[2]
table.insert(m,{
tonumber(p[1]),
q,
r and g[r:sub(1,1)],
r and h[r:sub(2,2)],
})
end
k.keys=m
return k
end

