          <string name="Source"><![CDATA[

local a={}

local b=Vector3.yAxis

local c=2
local d=0.9

a.Radius=4.6
a.Lift=1.6

local e=6
local f=2.6

local function g(h:number):number
h=math.clamp(h,0,1)
return h*h*(3-2*h)
end


local function h(i:number):number
local j,k=0,1
for l=1,40 do
local m=(j+k)/2
if g(m)<i then
j=m
else
k=m
end
end
return(j+k)/2*d
end


local i={}
for j=1,c*2 do
table.insert(i,h((j-0.5)/(c*2)))
end

a.Times={
Cuts=i,
Out=d,
Thrust=1.0,
Length=1.3,
}

export type Plan={
center:Vector3,
out:Vector3,
side:Vector3,
start:number,
height:number,
}

function a.Plan(j:Vector3,k:Vector3):Plan
local l=Vector3.new(j.X-k.X,0,j.Z-k.Z)
local m=if l.Magnitude>1e-3 then l.Unit else Vector3.new(0,0,1)
return{
center=k,
out=m,
side=b:Cross(m).Unit,
start=math.max(l.Magnitude,1.5),
height=j.Y-k.Y,
}
end


local function j(k:number):number
return c*2*math.pi*g(k/d)
end

local function k(l:Plan,m:number):number
local n=a.Times
local o=l.start+(a.Radius-l.start)*g(m/0.15)

o+=(e-a.Radius)*g((m-(d-0.14))/0.2)

local p=math.clamp((m-(n.Thrust-0.1))/0.1,0,1)
o+=(f-e)*p*p
return o
end

local function l(m:number):number
return a.Lift*g(m/0.3)
end

function a.Attacker(m:Plan,n:number):CFrame
local o=j(n)
local p=m.out*math.cos(o)+m.side*math.sin(o)
local q=m.center+p*k(m,n)+b*(m.height+l(n))
local r=1.5*c*2*math.pi/d
local s=if n<d then(6*(n/d)*(1-n/d))*c*2*math.pi/d else 0
local t=s/r
local u=math.rad(18)*t
local v=-p*math.cos(u)+b:Cross(p).Unit*math.sin(u)
return CFrame.lookAt(q,q+v)*CFrame.Angles(math.rad(-14)*t,0,0)
end


local function m(n:number,o:number):number
if n<=o then
return 0
end
local p=(n-o)/0.08
return p*math.exp(1-p)
end

function a.Victim(n:Plan,o:number):CFrame
local p=n.center+b*l(o)

local q,r=0,0
for s,t in a.Times.Cuts do
local u=m(o,t)
q+=(if s%2==1 then 14 else-14)*u
r-=8*u
end
return CFrame.lookAt(p,p+n.out)*CFrame.Angles(math.rad(r),0,math.rad(q))
end

return a]]></string>
