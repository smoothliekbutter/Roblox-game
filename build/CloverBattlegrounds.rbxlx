          <string name="Source"><![CDATA[

local a=game:GetService("Players")
local b=game:GetService("ReplicatedStorage")
local c=game:GetService("RunService")

local d=b:WaitForChild("Shared")
local e=require(d.CombatState)
local f=require(d.Config)
local g=require(d.Impulse)
local h=require(d.Kits)
local i=require(d.Remotes)

local j=require(script.Parent.Hitbox)
local k=require(script.Parent.Ragdoll)

type Counter={
untilTime:number,
types:{[string]:boolean},
onCounter:(attacker:Model,hit:HitInfo)->(),

filter:((attacker:Model,hit:HitInfo)->boolean)?,
}

export type CharData={
humanoid:Humanoid,
combo:number,
lastM1:number,
nextM1:number,
nextBlock:number,
nextDash:number,
nextSideDash:number,
ragdollToken:number,
juggleUntil:number,
awakenToken:number,
lastDamaged:number,
lastCombat:number,
counter:Counter?,
skillInputs:{[number]:number},

skillInputAir:{[number]:boolean},
skillHeld:{[number]:boolean},
moveToken:number,
grabbedBy:Model?,
}

export type HitInfo={
damage:number,
stun:number,
attackType:string?,
guardBreak:boolean?,
unblockable:boolean?,
variant:string?,
airborne:boolean?,
velocity:Vector3?,
velocityTime:number?,
ragdoll:number?,
hitsDowned:boolean?,
noShake:boolean?,
noReaction:boolean?,
reflected:boolean?,
heavy:boolean?,
effect:string?,
}


export type Context={
character:Model,
humanoid:Humanoid,
root:BasePart,
player:Player?,
data:CharData,
kit:h.KitInfo,
awakened:boolean,
airborne:boolean,
combat:any,
}

local l={Front=true,Back=true,Left=true,Right=true}

local m:{[Model]:CharData}={}


local n:{[string]:any}={}
for o,p in script.Parent:WaitForChild("Kits"):GetChildren()do
if p:IsA("ModuleScript")then
n[p.Name]=require(p)::any
end
end

local o={}



local function p(q:Model):BasePart?
return q:FindFirstChild("HumanoidRootPart")::BasePart?
end

local function q(r:Vector3):Vector3
local s=Vector3.new(r.X,0,r.Z)
return if s.Magnitude>1e-3 then s.Unit else Vector3.new(0,0,-1)
end

local function r(s:Model,t:string,u:number,v:number)
local w=tonumber(s:GetAttribute(t))or 0
local x=math.clamp(w+u,0,v)
if x~=w then
s:SetAttribute(t,x)
end
end


local function s(t:Model,u:string):any
local v=h.Of(t)
local w=v and v.m1[u]
if w~=nil then
return w
end
return(f.M1::any)[u]
end

local function t(u:Model)
local v=h.Of(u)
if not v or not e.IsAwakened(u)then
return nil
end
if v.ascension and u:GetAttribute("Ascended")==true then
return v.ascension
end
return v.awakening
end


local function u(v:Model)
local w=h.Of(v)
if w and w.ascension and e.IsAwakened(v)and v:GetAttribute("Ascended")~=true then
return w.ascension
end
return nil
end

function o.ChargeAscension(v:Model,w:number)
local x=u(v)
if x then
r(v,"Ascension",w,x.charge)
end
end

local function v(w:Model,x:string):boolean
return(tonumber(w:GetAttribute(x))or 0)>os.clock()
end
o.StateActive=v

function o.Flat(w:Vector3):Vector3
return q(w)
end

function o.GetData(w:Model):CharData?
return m[w]
end

function o.FireVFX(w:string,x:{[string]:any})
i.VFX:FireAllClients(w,x)
end

function o.Shake(w:Model,x:number)
local y=a:GetPlayerFromCharacter(w)
if y then
i.CameraShake:FireClient(y,x)
end
end


function o.ShakeArea(w:Vector3,x:number,y:number)
for z,A in a:GetPlayers()do
local B=A.Character and p(A.Character)
if B then
local C=(B.Position-w).Magnitude
if C<x then
i.CameraShake:FireClient(A,y*(1-C/x))
end
end
end
end

function o.Notify(w:Model,x:string,y:Color3?)
local z=a:GetPlayerFromCharacter(w)
if z then
i.Notify:FireClient(z,x,y)
end
end

function o.ApplyVelocity(
w:Model,
x:Vector3,
y:number,
z:{steer:number?,landStop:boolean?,landKeep:number?}?
)
local A=p(w)
if not A then
return
end
local B=a:GetPlayerFromCharacter(w)
if k.IsActive(w)then
if y>0.05 and x.Magnitude<=f.Physics.RagdollHoldSpeed then
g.Apply(A,x,y,"Knockback",0.45)
else
o.Tumble(A,x)
end
elseif B then
i.Impulse:FireClient(B,x,y,z)
else
g.Apply(A,x,y,"Knockback",if z then nil else 0.45)
end
end

function o.Tumble(w:BasePart,x:Vector3)
local y=f.Physics.RagdollCarry
local z=Vector3.new(x.X*y,x.Y,x.Z*y)
local A=Vector3.zero
local B=Vector3.new(x.X,0,x.Z):Cross(Vector3.yAxis)
if B.Magnitude>0.1 then
A=-B.Unit*math.min(x.Magnitude*f.Physics.TumbleSpin,f.Physics.MaxTumble)
end
local C=w.Parent
if C then
for D,E in C:GetChildren()do
if E:IsA("BasePart")and not E.Anchored and E~=w then
E.AssemblyLinearVelocity=z+A:Cross(E.Position-w.Position)
E.AssemblyAngularVelocity=A
end
end
end
w.AssemblyLinearVelocity=z
w.AssemblyAngularVelocity=A
end

function o.Launch(w:Model,x:Vector3,y:number,z:number?)
local A=p(w)
if not A then
return
end
if not z or z<=0 or not k.IsActive(w)then
o.ApplyVelocity(w,x,y)
return
end
task.delay(z,function()
if A.Parent and k.IsActive(w)then
o.Tumble(A,x)
end
end)
end

function o.HeavyFall(w:Model,x:number,y:number)
local z=workspace.Gravity*(x-1)
if z<=0 then
return
end
local A:{Instance}={}
for B,C in w:GetChildren()do
if C:IsA("BasePart")and not C.Massless then
local D=Instance.new("Attachment")
D.Name="HeavyFall"
D.Parent=C
local E=Instance.new("VectorForce")
E.Attachment0=D
E.RelativeTo=Enum.ActuatorRelativeTo.World
E.ApplyAtCenterOfMass=true
E.Force=Vector3.new(0,-z*C:GetMass(),0)
E.Parent=D
table.insert(A,D)
end
end
local B=os.clock()
local C
C=c.Heartbeat:Connect(function()
if os.clock()-B<y and k.IsActive(w)then
return
end
C:Disconnect()
for D,E in A do
E:Destroy()
end
end)
end

function o.IsAirborne(w:Model):boolean
local x=p(w)
if not x then
return false
end
local y=RaycastParams.new()
y.FilterType=Enum.RaycastFilterType.Exclude
y.FilterDescendantsInstances={w}

return workspace:Raycast(x.Position,Vector3.new(0,-3.6,0),y)==nil
end

local function w(x:Model,y:boolean?):boolean
if y~=nil then
return y
end
return o.IsAirborne(x)
end

function o.Ragdoll(x:Model,y:number)
local z=m[x]
if not z then
return
end
z.ragdollToken+=1
local A=z.ragdollToken

e.SetBlocking(x,false)
k.Enable(x)
e.Stun(x,y)

task.delay(y,function()
if m[x]==z and z.ragdollToken==A and e.IsAlive(x)then
k.Disable(x)
end
end)
end


o.Box=j.Box
o.Sphere=j.Sphere



function o.SetCounter(
x:Model,
y:number,
z:{[string]:boolean},
A:(attacker:Model,hit:HitInfo)->(),
B:((attacker:Model,hit:HitInfo)->boolean)?
)
local C=m[x]
if C then
C.counter={untilTime=os.clock()+y,types=z,onCounter=A,filter=B}
end
end

function o.ClearCounter(x:Model)
local y=m[x]
if y then
y.counter=nil
end
end

type SkillWatch={radius:number,untilTime:number,onStart:(user:Model)->()}
