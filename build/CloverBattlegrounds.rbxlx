local L=K.MoveDirection
if L.Magnitude<0.1 then
return"Front"
end
local M=I():VectorToObjectSpace(L)
if math.abs(M.X)>math.abs(M.Z)then
return if M.X>0 then"Right"else"Left"
end
return if M.Z>0 then"Back"else"Front"
end

local function K(L:Humanoid):boolean
return e:IsKeyDown(Enum.KeyCode.Space)
or e:IsGamepadButtonDown(Enum.UserInputType.Gamepad1,Enum.KeyCode.ButtonA)
or L.Jump
end

local L=0

local function M():boolean
local N,O=H()
if not O then
return false
end
if O.FloorMaterial==Enum.Material.Air then
return true
end
local P=O:GetState()
if P==Enum.HumanoidStateType.Jumping or P==Enum.HumanoidStateType.Freefall then
return true
