            <string name="Source"><![CDATA[

local a=require(script.Parent.PoseAnimator)

type Animation=a.Animation

local b=math.rad
local c,d,e=Enum.EasingStyle.Quart,Enum.EasingStyle.Sine,Enum.EasingStyle.Linear
