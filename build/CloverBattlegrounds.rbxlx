          <string name="Source"><![CDATA[

local a=game:GetService("Players")

local b=require(script.Parent.CombatService)
local c=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").CombatState)

type Spec={
name:string,
behavior:"Idle"|"Block"|"Attack",
color:Color3,
position:Vector3,
}

local d:{Spec}={
{name="Dummy",behavior="Idle",color=Color3.fromRGB(225,225,225),position=Vector3.new(-12,3,-28)},
{
name="Blocking Dummy",
behavior="Block",
color=Color3.fromRGB(80,140,255),
position=Vector3.new(0,3,-28),
},
{
name="Attacking Dummy",
behavior="Attack",
color=Color3.fromRGB(255,90,90),
position=Vector3.new(12,3,-28),
},
}

local e=3
local f=3
local g=25
local h=6.5

local i=Instance.new("Folder")
i.Name="Dummies"
i.Parent=workspace

local j={}

local function k(l:Vector3,m:number):BasePart?
local n,o=nil,m
for p,q in a:GetPlayers()do
local r=q.Character
local s=r and r:FindFirstChild("HumanoidRootPart")::BasePart?
if s and c.IsAlive(r)then
local t=(s.Position-l).Magnitude
if t<o then
n,o=s,t
end
end
end
return n
end

local function l(m:BasePart,n:Vector3)
local o=Vector3.new(n.X,m.Position.Y,n.Z)
if(o-m.Position).Magnitude>0.1 then
m.CFrame=CFrame.lookAt(m.Position,o)
end
end

local function m(n:Model,o:Spec,p:Humanoid,q:BasePart)
while n.Parent and p.Health>0 do
local r=b.GetData(n)


if r and os.clock()-r.lastDamaged>f and p.Health<p.MaxHealth then
p.Health=p.MaxHealth
end

local s=k(q.Position,g)
local t=c.CanAct(n)

if o.behavior=="Block"then
if s and t then
l(q,s.Position)
end
if t and not c.IsBlocking(n)then
b.SetBlock(n,true)
end
task.wait(0.1)
elseif o.behavior=="Attack"then
if s and t then
l(q,s.Position)
if(s.Position-q.Position).Magnitude<=h then

for u=1,4 do
if not c.CanAct(n)then
break
end
l(q,s.Position)
b.M1(n)
task.wait(0.34)
end
task.wait(2)
end
end
task.wait(0.1)
else
task.wait(0.5)
end
end
end

local function n(o:Spec)
local p=Instance.new("HumanoidDescription")
p.HeadColor=o.color
p.TorsoColor=o.color
p.LeftArmColor=o.color
p.RightArmColor=o.color
p.LeftLegColor=o.color
p.RightLegColor=o.color

local q=a:CreateHumanoidModelFromDescriptionAsync(p,Enum.HumanoidRigType.R6)
