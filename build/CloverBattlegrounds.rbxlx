for ae,af in i do
local ag=if ac<af.freezeUntil then af.frozenAt else ac-af.start
local ah=af.animation
local ai=ah.fadeIn or 0.04
local aj=af.fadeOutOverride or ah.fadeOut or 0.15
local B=af.length+aj

local C=not ae.Parent or ae:GetAttribute("Ragdolled")==true
