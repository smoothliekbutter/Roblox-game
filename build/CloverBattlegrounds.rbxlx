Animations.SaintLand = clip(
	{ fadeIn = 0.02, fadeOut = 0.3 },
	[[
0|b-.167 -38|r20|l40 6|l40 -6|r-40 0 8|r10 0 -8
.12 To|b-.043 -20 15|r12 -10|l40 10 50|l25 0 -25|r-50 0 10|r40 0 -10
.42 Sx|b-.064 -16 22|r6 38|l52 12 72|l25 0 -28|r-50 0 10|r40 0 -10
.68 Lo|b-.064 -16 22|r6 38|l52 12 72|l25 0 -28|r-50 0 10|r40 0 -10
1 Sx|b.111 -6 12|r4 -12|l20 6 30|l18 0 -18|r-8 0 6|r8 0 -6
]]
)

Animations.TempestDrag = clip(
	{ fadeIn = 0.08, fadeOut = 0.1 },
	[[
0|r4|r22|l15 0 4|l172 -6 -10|r-4|r6
.75 Lo|r4|r22|l15 0 4|l172 -6 -10|r-4|r6
]]
)

Animations.Entrance = clip(
	{ fadeOut = 0.25 },
	[[
0|b.093 -3 12|r2 -10|l12 4 10|l30 -8 -16|r-4 0 6|r6 0 -7
.5 Sx|b.108 4 10|r18 -10|l20 4 10|l100 26 -6|r-4 0 6|r6 0 -7
1 Sx|b.12 6 16|r14 -16|l16 4 12|l130 30 -10|r-4 0 6|r6 0 -7
1.2 To|b.09 10 -6|r20 6|l168 -6 14|l60 0 -60|r-16 0 8|r16 0 -8
1.6 Lo|b.09 10 -6|r20 6|l168 -6 14|l60 0 -60|r-16 0 8|r16 0 -8
2.2 Sx|b.093 -3 12|r2 -10|l12 4 10|l30 -8 -16|r-4 0 6|r6 0 -7
]]
)

Animations.Awaken = clip(
	{ fadeOut = 0.2 },
	[[
0|b.093 -3 12|r2 -10|l12 4 10|l30 -8 -16|r-4 0 6|r6 0 -7
.3 So|b.028 -16|r-20|l70 -44|l70 44|r-18 0 8|r18 0 -8
.8 Bo|b.097 10|r22|l140 0 46|l140 0 -46|r-20 0 10|r20 0 -10
1.1 Lo|b.097 10|r22|l140 0 46|l140 0 -46|r-20 0 10|r20 0 -10
1.5 Sx|b.093 -3 12|r2 -10|l12 4 10|l30 -8 -16|r-4 0 6|r6 0 -7
]]
)

