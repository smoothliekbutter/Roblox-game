local a=math.rad
local function b(c:number,d:number?,e:number?):CFrame
return CFrame.Angles(a(c),a(d or 0),a(e or 0))
end
local function c(d:number,e:number,f:number?,g:number?):CFrame
return CFrame.new(0,d,0)*CFrame.Angles(a(e),a(f or 0),a(g or 0))
end
local function d(e:number,f:number?,g:number?):CFrame
return CFrame.Angles(0,a(f or 0),0)*CFrame.Angles(0,0,a(g or 0))*CFrame.Angles(a(e),0,0)
end
local function e(f:number,g:number,h:number):{aim:Vector3}
return{aim=Vector3.new(f,g,h)}
end
local f:{[string]:(...number)->any}={r=b,b=c,l=d,a=e}
