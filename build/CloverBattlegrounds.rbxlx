then s(J.move,ac,C.phase*P)
else nil
local ah=if J.walk and r(J.walk)[ac]
then s(J.walk,ac,C.phase*Q)
else nil
local ai=if ag and ah then ah:Lerp(ag,T)else ag or ah
if ai then
if ac=="Torso"then
ai=CFrame.Angles(0,-Z*0.4,0)*CFrame.Angles(math.rad(14)*_,0,0)*ai
elseif ac=="Head"then
ai=CFrame.Angles(0,Z*0.4,0)*ai
elseif ac=="RightLeg"or ac=="LeftLeg"then
ai=CFrame.Angles(0,-Z*0.6,0)*ai
end
af=t(ad,ai)
end
af=af:Lerp(z(J.stand,ac,ad,aa)or ae,X)
local aj=z(J.air,ac,ad,aa)
if aj and Y>0 then
af=af:Lerp(aj,Y)
end
ab[ac]=af
end
return ab
end

local function aa(ab:number)
local ac=os.clock()

local ad:{[Model]:{[string]:CFrame}}={}
for ae,af in j do
if not ae.Parent then
j[ae]=nil
continue
end
if ae:GetAttribute("Ragdolled")==true then
continue
end
local ag=A(ae,af,ac,ab)
ad[ae]=ag
local ah=i[ae]
for ai,aj in ag do
if not(ah and ah.joints[ai])then
local B=af.joints[ai]
local C=if ai=="Torso"then x(ae,B,ab)else nil
v(B,if C then C*aj else aj)
end
