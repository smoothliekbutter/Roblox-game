            <Item class="ModuleScript" referent="51">
              <Properties>
                <string name="Name">Fx</string>
                <string name="Source"><![CDATA[local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local VFX = require(script.Parent.Parent.Parent.VFX)
local Soft = require(script.Parent.Parent.Parent.Soft)

type Animation = PoseAnimator.Animation

local U = VFX.Util
local UP = Vector3.yAxis

local WIND_WHITE = Soft.WIND_WHITE
local newWedge = Soft.newWedge

local function build(raw: { [string]: any }): Animation
	local keyframes = {}
	for _, key in raw.keys do
		table.insert(keyframes, {
			time = key[1],
			pose = key[2],
			easing = if key[3] then (Enum.EasingStyle :: any)[key[3]] else nil,
			direction = if key[4] then (Enum.EasingDirection :: any)[key[4]] else nil,
		})
	end
	return {
		keyframes = keyframes,
		loop = raw.loop,
		fadeIn = raw.fadeIn,
		fadeOut = raw.fadeOut,
		delays = raw.delays,
	}
end

local ANIMS: { [string]: Animation } = {}
for name, raw in require(script.Parent.Animations) do
	ANIMS[name] = build(raw)
end

local function play(character: Model, animation: Animation, onEvent: ((string) -> ())?)
	PoseAnimator.Play(character, animation, onEvent)
end

local handlers: { [string]: (data: any, character: Model, root: BasePart) -> () } = {}

local function involves(data, character: Model): boolean
	return U.isLocal(character) or U.isLocal(data.target)
end

local castTokens: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local function bump(character: Model): number
	local token = (castTokens[character] or 0) + 1
	castTokens[character] = token
	return token
end
local function live(character: Model, token: number): boolean
	return castTokens[character] == token and character.Parent ~= nil
end

local function handOf(character: Model, side: string): Vector3?
	local arm = character:FindFirstChild(side .. " Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.15, 0)).Position else nil
end

local function easeOut(u: number): number
	return 1 - (1 - math.clamp(u, 0, 1)) ^ 3
end

local function easeInOut(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

local function featherBurst(position: Vector3, count: number, speed: number)
	for _ = 1, count do
		local feather = newWedge({
			Size = Vector3.new(0.05, 0.28, 0.9),
			Color = WIND_WHITE,
			Material = Enum.Material.ForceField,
			Transparency = 0.1,
			CFrame = CFrame.new(position) * U.randomAngles(),
		})
		local out = U.randomUnit() * speed * (0.5 + math.random() * 0.5)
		local life = 0.45 + math.random() * 0.3
		U.tween(feather, life, {
			CFrame = CFrame.new(position + out * life + UP * 1.5) * U.randomAngles(),
			Transparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(life + 0.05, feather.Destroy, feather)
	end
end

return {
	ANIMS = ANIMS,
	play = play,
	handlers = handlers,
	involves = involves,
	bump = bump,
	live = live,
	handOf = handOf,
	easeOut = easeOut,
	easeInOut = easeInOut,
	featherBurst = featherBurst,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="52">
              <Properties>
                <string name="Name">Half</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DivePlan = require(ReplicatedStorage:WaitForChild("Shared").TempestDive)
local CameraShake = require(script.Parent.Parent.Parent.CameraShake)
local Cinematic = require(script.Parent.Parent.Parent.Cinematic)
local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local VFX = require(script.Parent.Parent.Parent.VFX)
local Soft = require(script.Parent.Parent.Parent.Soft)
local Nova = require(script.Parent.Nova)

local U = VFX.Util
local rad = math.rad
local UP = Vector3.yAxis

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE, SPARKLE = Soft.SMOKE, Soft.SPARKLE
local every, fadeOut, key = Soft.every, Soft.fadeOut, Soft.key
local bar, tube = Soft.bar, Soft.tube
local inflow, gust = Soft.inflow, Soft.gust
local makeStar = Soft.makeStar
local arcPoints, arcParts, poseArc = Soft.arcPoints, Soft.arcParts, Soft.poseArc
local worldAnchor, softBeam, fadeBeams, softRing = Soft.worldAnchor, Soft.softBeam, Soft.fadeBeams, Soft.softRing
local windRing, lightRing, windEmitter, windPuff = Soft.windRing, Soft.lightRing, Soft.windEmitter, Soft.windPuff
local twinkle, starDust, streaks = Soft.twinkle, Soft.starDust, Soft.streaks

local Fx = require(script.Parent.Fx)
local ANIMS, handlers, play, bump, live, involves = Fx.ANIMS, Fx.handlers, Fx.play, Fx.bump, Fx.live, Fx.involves
local handOf, easeInOut = Fx.handOf, Fx.easeInOut

local STORM_STRANDS = 3
local STORM_SEGMENTS = 18

function handlers.SpiritStorm(data, character, root)
	if data.phase == "Charge" then
		play(character, ANIMS.StormCharge)
		local token = bump(character)
		local orb = U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Color = WIND_WHITE })
		local halo =
			U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.4, Color = WIND, Transparency = 0.5 })
		local shell = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			Color = WIND,
			Material = Enum.Material.ForceField,
		})
		local rings = {}
		for _ = 1, 3 do
			table.insert(
				rings,
				arcParts(arcPoints(Vector3.zero, Vector3.xAxis, UP, 1, 0, math.pi * 2, 10), 0.08, WIND_WHITE, 0.15)
			)
		end
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 12
		light.Brightness = 1
		light.Parent = orb
		local glow = Soft.glow(orb, WIND, 6, 0.85)
		local whirl = softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1,
			width1 = 1,
			transparency = NumberSequence.new(0.5),
			texture = SMOKE,
			speed = 4,
			length = 3,
		})
		local well = U.newPart({
			Size = Vector3.one * 10,
			Transparency = 1,
			CFrame = CFrame.new(handOf(character, "Right") or root.Position),
		})
		local drawn = {
			windEmitter(well, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.2), key(1, 0.6) }),
				Size = NumberSequence.new({ key(0, 0.5), key(1, 0.1) }),
				Lifetime = NumberRange.new(0.4, 0.5),
				Speed = NumberRange.new(10, 12),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 40,
			}),
			windEmitter(well, {
				Size = NumberSequence.new({ key(0, 3), key(1, 0.6) }),
				Lifetime = NumberRange.new(0.4, 0.5),
				Speed = NumberRange.new(10, 12),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 18,
			}),
		}
		local floor = softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.4,
			width1 = 1.4,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 3,
			length = 4,
		})
		every(data.duration + 0.05, function(elapsed)
			local hand = handOf(character, "Right")
			if not live(character, token) or not hand then
				return false
			end
			local grow = math.min(elapsed / data.duration, 1)
			local center = hand + root.CFrame.LookVector * 0.7
			well.CFrame = CFrame.new(center)
			whirl.set(
				CFrame.lookAt(center, center + root.CFrame.LookVector) * CFrame.Angles(rad(90), elapsed * 9, 0),
				1.2 + 2 * grow
			)
			floor.set(CFrame.new(root.Position - UP * 2.9) * CFrame.Angles(0, elapsed * 3, 0), 7 - 5.5 * grow)
			orb.Size = Vector3.one * (0.3 + 1.1 * grow)
			halo.Size = Vector3.one * (0.8 + 2.4 * grow)
			shell.Size = Vector3.one * (1 + 3.2 * grow)
			orb.CFrame = CFrame.new(center)
			halo.CFrame = orb.CFrame
			shell.CFrame = orb.CFrame * CFrame.Angles(elapsed * 3, elapsed * 2, 0)
			for r, ring in rings do
				local tilt = CFrame.Angles(r * 1.1 + elapsed * (3 + r), elapsed * (4 - r), r * 0.7)
				poseArc(
					ring,
					arcPoints(center, tilt.RightVector, tilt.UpVector, 0.7 + 1.7 * grow + r * 0.25, 0, math.pi * 2, 10)
				)
			end
			inflow(center, 6)
			inflow(center, 4)
			light.Brightness = 1 + 5 * grow
			return true
		end, function()
			glow.Enabled = false
			for _, emitter in drawn do
				emitter.Enabled = false
			end
			task.delay(0.6, well.Destroy, well)
			whirl.fade(0.1)
			floor.fade(0.15)
			fadeOut({ orb, halo, shell }, 0.08)
			for _, ring in rings do
				fadeOut(ring, 0.08)
			end
		end)
		U.spiral(root, WIND, 2.2, 4, data.duration, 2, 0.08, 0.6)
		if U.isLocal(character) then
			CameraShake.Add(0.06)
		end
	elseif data.phase == "Fire" then
		play(character, ANIMS.StormFire)
		local token = bump(character)
		local origin: Vector3 = data.origin
		local direction: Vector3 = data.direction
		local length: number = data.length
		local finish = origin + direction * length
		local right = direction:Cross(UP)
		right = if right.Magnitude > 1e-3 then right.Unit else Vector3.xAxis
		local up = right:Cross(direction).Unit

		local core = tube(origin, finish, 1.2, WIND_WHITE, 0)
		local column = tube(origin, finish, 4.2, WIND, 0.5)
		local sheath = tube(origin, finish, 6.4, WIND, 0)
		sheath.Material = Enum.Material.ForceField
		local haze = tube(origin, finish, 9, WIND_DEEP, 0.9)
		local strands: { { BasePart } } = {}
		for k = 1, STORM_STRANDS do
			local strand = {}
			for _ = 1, STORM_SEGMENTS do
				table.insert(
					strand,
					bar(
						origin,
						origin + direction,
						if k == 1 then 0.3 else 0.22,
						if k == 1 then WIND_WHITE else WIND,
						0.1
					)
				)
			end
			table.insert(strands, strand)
		end
		local muzzle = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.lookAt(origin, finish) })
		local racing = Instance.new("ParticleEmitter")
		racing.Texture = U.textures.Spark
		racing.Color = ColorSequence.new(WIND_WHITE, WIND)
		racing.LightEmission = 1
		racing.LightInfluence = 0
		racing.EmissionDirection = Enum.NormalId.Front
		racing.Orientation = Enum.ParticleOrientation.VelocityParallel
		racing.Speed = NumberRange.new(150, 210)
		racing.Lifetime = NumberRange.new(length / 210, length / 150)
		racing.SpreadAngle = Vector2.new(5, 5)
		racing.Size = NumberSequence.new(0.7, 0.1)
		racing.Transparency = NumberSequence.new(0.1, 1)
		racing.Rate = 140
		racing.Parent = muzzle
		local light = Instance.new("PointLight")
		light.Color = WIND
		light.Range = 28
		light.Brightness = 5
		light.Parent = core
		local from, to = worldAnchor(origin, direction), worldAnchor(finish, direction)
		local flow = {
			softBeam(from, to, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 9,
				width1 = 11,
				transparency = NumberSequence.new({ key(0, 0.75), key(0.1, 0.55), key(0.9, 0.6), key(1, 0.85) }),
				texture = SMOKE,
				speed = 30,
				length = 12,
			}),
			softBeam(from, to, {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 2.4,
				width1 = 2.4,
				transparency = NumberSequence.new({ key(0, 0.6), key(0.1, 0.3), key(1, 0.45) }),
				texture = SPARKLE,
				wrap = true,
				length = 2.5,
				speed = 40,
			}),
			softBeam(from, to, {
				color = ColorSequence.new(WIND, WIND_DEEP),
				width0 = 16,
				width1 = 18,
				transparency = NumberSequence.new({ key(0, 0.95), key(0.15, 0.88), key(1, 0.9) }),
				texture = SMOKE,
				speed = 12,
				length = 20,
				emission = 0.6,
			}),
		}
		local stopHelix = Soft.helix(function()
			return origin, finish
		end, 3.4, 3, 0.3, 5, 0.9, data.duration)

		local nextRing, nextPulse, nextSplash = 0, 0, 0
		every(data.duration, function(elapsed)
			if not live(character, token) then
				return false
			end
			local spin = elapsed * 14
			for k, strand in strands do
				local phase = k * (math.pi * 2 / STORM_STRANDS) + spin
				local radius = 2.5 + 0.35 * math.sin(elapsed * 30 + k)
				local previous = origin
				for i, segment in strand do
					local s = i / #strand * length
					local angle = phase + s * 0.35
					local point = origin
						+ direction * s
						+ (right * math.cos(angle) + up * math.sin(angle)) * radius * math.min(s / 3, 1)
					segment.Size = Vector3.new(segment.Size.X, segment.Size.Y, (point - previous).Magnitude + 0.05)
					segment.CFrame = CFrame.lookAt(previous:Lerp(point, 0.5), point)
					previous = point
				end
			end
			local breathe = 1 + math.sin(elapsed * 40) * 0.07
			column.Size = Vector3.new(column.Size.X, 4.2 * breathe, 4.2 * breathe)
			core.Size =
				Vector3.new(core.Size.X, 1.2 + math.sin(elapsed * 55) * 0.18, 1.2 + math.sin(elapsed * 55) * 0.18)
			if elapsed >= nextRing then
				nextRing = elapsed + 0.035
				local at = origin + direction * (math.random() * length)
				if math.random() < 0.5 then
					U.impactRing(at, direction, WIND_WHITE, 2, 5.5, 0.2)
				else
					lightRing(at, direction, 2, 6, 0.2, WIND_WHITE)
				end
			end
			if elapsed >= nextPulse then
				nextPulse = elapsed + 0.1
				U.impactRing(origin, direction, WIND, 1.5, 7, 0.25)
				windRing(origin + direction * 2, direction, 1.5, 6, 0.25)
			end
			if elapsed >= nextSplash then
				nextSplash = elapsed + 0.09
				windPuff(finish, 3, -direction)
				streaks(finish, 6, 50, -direction, 60)
			end
			return true
		end, function()
			for _, strand in strands do
				for _, segment in strand do
					local out = segment.Position - (origin + direction * direction:Dot(segment.Position - origin))
					U.tween(segment, 0.3, {
						CFrame = segment.CFrame + (if out.Magnitude > 1e-3 then out.Unit * 2.5 else Vector3.zero),
						Transparency = 1,
					})
				end
				task.delay(0.32, function()
					for _, segment in strand do
						segment:Destroy()
					end
				end)
			end
			U.tween(core, 0.25, { Size = Vector3.new(core.Size.X, 0.05, 0.05) })
			fadeOut({ core, column, sheath, haze }, 0.3)
			for _, beam in flow do
				U.tween(beam, 0.3, { Width0 = 0.5, Width1 = 0.5 })
			end
			fadeBeams(flow, 0.32, { from, to })
			stopHelix()
			racing.Enabled = false
			task.delay(0.6, muzzle.Destroy, muzzle)
			gust(finish, 8, direction)
			U.shockwave(finish, WIND, 2, 14, 0.35)
			windRing(finish, direction, 2, 16, 0.4)
			lightRing(finish, direction, 1, 12, 0.3, WIND_WHITE)
		end)

		for along = 6, length, 6 do
			local ground = U.groundBelow(origin + direction * along, { character }, 7)
			if ground then
				task.delay(along / 300, function()
					U.groundCracks(ground.Position, 2, 4, WIND, 1.2)
					U.debris(ground.Position, 3, 25, 0.5)
				end)
			end
		end
		gust(origin, 6, direction)
		U.flash(origin, WIND_WHITE, 6, 0.2)
		twinkle(origin, 6, WIND, 0.25)
		U.impactRing(origin, direction, WIND_WHITE, 1, 9, 0.3)
		windRing(origin, direction, 1, 12, 0.35)
		U.light(origin, WIND, 6, 24, 0.7)
		if U.isLocal(character) then
			CameraShake.Add(0.25)
			CameraShake.FovKick(10)
		elseif (workspace.CurrentCamera.CFrame.Position - origin).Magnitude < 40 then
			CameraShake.Add(0.1)
		end
	elseif data.phase == "Cancel" then
		bump(character)
	end
end

local TORNADO_BANDS = 12
local TORNADO_PANELS = 16
local TORNADO_SHADES = { WIND, Color3.fromRGB(150, 176, 160), Color3.fromRGB(96, 120, 106) }

type Tornado = { update: (t: number, visible: number) -> (), destroy: () -> () }

local function makeTornado(base: Vector3, height: number): Tornado
	local bands = {}
	local emitters = {}
	for k = 1, TORNADO_BANDS do
		local fraction = (k - 0.5) / TORNADO_BANDS
		local radius = 2.5 + 11 * fraction ^ 1.25
		local hub = U.newPart({
			Size = Vector3.one * 0.2,
			Transparency = 1,
			CFrame = CFrame.new(base + UP * (height * fraction)),
		})
		local panels = {}
		local width = 2 * math.pi * radius / TORNADO_PANELS * 1.3
		for j = 1, TORNADO_PANELS do
			local shade = (j + k) % 3 + 1
			local panel = Instance.new("Part")
			panel.Anchored = false
			panel.CanCollide = false
			panel.CanQuery = false
			panel.CanTouch = false
			panel.CastShadow = false
			panel.Massless = true
			panel.Material = if shade == 1 then Enum.Material.Neon else Enum.Material.SmoothPlastic
			panel.Color = TORNADO_SHADES[shade]
			panel.Transparency = 1
			panel.Size = Vector3.new(width, height / TORNADO_BANDS + 0.8, 0.5)
			panel.CFrame = hub.CFrame
				* CFrame.Angles(0, j / TORNADO_PANELS * math.pi * 2, 0)
				* CFrame.new(0, 0, -radius)
				* CFrame.Angles(0, 0, rad(18))
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hub
			weld.Part1 = panel
			weld.Parent = panel
			panel.Parent = U.folder
			table.insert(panels, { part = panel, solid = if shade == 1 then 0.35 else 0.18 })
			if k % 2 == 0 and j % 4 == 0 then
				local dust = Instance.new("ParticleEmitter")
				dust.Texture = U.textures.Smoke
				dust.Color = ColorSequence.new(Color3.fromRGB(170, 190, 175))
				dust.LightInfluence = 0.6
				dust.Size = NumberSequence.new(2.5, 4.5)
				dust.Transparency = NumberSequence.new(0.45, 1)
				dust.Lifetime = NumberRange.new(0.5, 0.8)
				dust.Rate = 0
				dust.Speed = NumberRange.new(0, 1)
				dust.Parent = panel
				table.insert(emitters, dust)
			end
		end
		table.insert(bands, { hub = hub, panels = panels, height = height * fraction, radius = radius, shown = -1 })
	end
	local debris = {}
	for _ = 1, 18 do
		table.insert(
			debris,
			U.newPart({
				Size = Vector3.new(0.4, 0.3, 0.5) * (1 + math.random() * 1.5),
				Color = Color3.fromRGB(92, 86, 78),
				Material = Enum.Material.Slate,
				Transparency = 1,
			})
		)
	end

	local tornado = {}
	function tornado.update(t: number, visible: number)
		for k, band in bands do
			band.hub.CFrame = CFrame.new(base + UP * band.height) * CFrame.Angles(0, t * (9 - k * 0.35) + k * 0.5, 0)
			local risen = math.clamp(visible * TORNADO_BANDS - (k - 1), 0, 1)
			local shown = math.floor(risen * 20 + 0.5) / 20
			if shown ~= band.shown then
				band.shown = shown
				for _, panel in band.panels do
					panel.part.Transparency = 1 - (1 - panel.solid) * shown
				end
			end
		end
		for _, dust in emitters do
			dust.Rate = if visible > 0.5 then 12 else 0
		end
		for i, chunk in debris do
			local fraction = (i - 0.5) / #debris
			local angle = t * (6 + i % 3) + i
			local radius = (2.5 + 11 * fraction ^ 1.25) * 0.75
			local position = base
				+ Vector3.new(
					math.cos(angle) * radius,
					height * 0.9 * fraction + math.sin(t * 2 + i) * 1.5,
					math.sin(angle) * radius
				)
			chunk.CFrame = CFrame.new(position) * CFrame.Angles(t * 5 + i, t * 3, 0)
			chunk.Transparency = if visible > fraction then 0 else 1
		end
	end
	function tornado.destroy()
		for _, band in bands do
			band.hub:Destroy()
			for _, panel in band.panels do
				panel.part:Destroy()
			end
		end
		for _, chunk in debris do
			chunk:Destroy()
		end
	end
	return tornado
end

local function playTempestDive(data, character: Model, root: BasePart)
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = DivePlan.Plan(data.origin, data.start, data.floorY)
	PoseAnimator.SettleLift(character, DivePlan.Times.Length)
	local times = DivePlan.Times
	local started = os.clock()
	local mine = involves(data, character)
	local floorY = plan.floorY
	local base = Vector3.new(plan.start.X, floorY, plan.start.Z)

	play(character, ANIMS.TempestDrag)
	U.bodyTrail(character, WIND, times.Lift)
	if target then
		U.bodyTrail(target, WIND_WHITE, times.Lift)
	end
	gust(plan.start, 6, UP)
	U.ringBurst(CFrame.new(base + UP * 0.2), WIND, 1, 9, 0.4, 0.3)
	windRing(base + UP * 0.3, UP, 1, 12, 0.45)
	windPuff(base + UP, 4, UP)
	Soft.helix(function()
		local at = root.Position
		return at - UP * 6, at + UP * 3
	end, 3, 3, 0.35, 2.5, 0.8, times.Lift)
	local wakes: { Trail } = {}
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if torso then
		table.insert(
			wakes,
			Soft.trail(torso, Vector3.new(1.6, 0, 0), Vector3.new(-1.6, 0, 0), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.45), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.3) }),
				lifetime = 0.45,
				texture = SMOKE,
			})
		)
	end
	task.delay(times.Length, function()
		for _, wake in wakes do
			Soft.endTrail(wake)
		end
	end)

	local tornado = makeTornado(base, DivePlan.Height + 4)
	local formFrom = times.Flip - 0.25
	local standUntil = times.Land + 0.6
	local finishAt = standUntil + 0.4
	local bind = "CloverTempestDive" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	local flipped, dove, risen = false, false, false
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > finishAt then
			finish()
			return
		end
		if t <= times.Length and root.Parent then
			root.CFrame = DivePlan.Attacker(plan, t)
		end
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = DivePlan.Victim(plan, t)
		end
		if not flipped and t >= times.Lift then
			flipped = true
			play(character, ANIMS.BoreasForm)
			local top = plan.start + UP * DivePlan.Height
			U.flash(top, WIND_WHITE, 6, 0.2)
			U.ringBurst(CFrame.new(top), WIND, 1, 8, 0.35, 0.2)
			windRing(top, UP, 1, 12, 0.4)
			lightRing(top, UP, 0.5, 9, 0.3, WIND_WHITE)
			windPuff(top, 3)
			if mine then
				CameraShake.Add(0.1)
			end
		end
		if not risen and t >= formFrom then
			risen = true
			U.ringBurst(CFrame.new(base + UP * 0.2), WIND_WHITE, 2, 16, 0.4, 0.5)
			U.debris(base, 14, 40, 0.8)
			windRing(base + UP * 0.4, UP, 3, 20, 0.5)
			local height = DivePlan.Height + 4
			local stand = finishAt - formFrom
			local foot, head = worldAnchor(base, UP), worldAnchor(base + UP * height, UP)
			local eye = {
				softBeam(foot, head, {
					color = ColorSequence.new(WIND_WHITE, WIND),
					width0 = 6,
					width1 = 20,
					transparency = NumberSequence.new({ key(0, 0.85), key(0.15, 0.6), key(0.9, 0.7), key(1, 1) }),
					texture = SMOKE,
					speed = 10,
					length = 14,
				}),
				softBeam(foot, head, {
					color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
					width0 = 1.5,
					width1 = 3,
					transparency = NumberSequence.new({ key(0, 0.7), key(0.2, 0.45), key(1, 0.9) }),
					texture = SPARKLE,
					wrap = true,
					length = 3,
					speed = 18,
				}),
			}
			task.delay(stand - 0.4, fadeBeams, eye, 0.4, { foot, head })
			Soft.helix(function()
				return base, base + UP * height
			end, 9, 4, 0.6, 2, 1.4, stand)
			if mine or (workspace.CurrentCamera.CFrame.Position - base).Magnitude < 70 then
				CameraShake.Add(0.2)
			end
		end
		if not dove and t >= times.Flip then
			dove = true
			play(character, ANIMS.BoreasChop)
			if mine then
				CameraShake.FovKick(10)
				U.speedLines(root, -UP, times.Land - times.Flip, WIND_WHITE)
			end
		end
		if t >= formFrom then
			local rising = math.clamp((t - formFrom) / 0.3, 0, 1)
			local going = math.clamp((t - standUntil) / 0.4, 0, 1)
			tornado.update(t, rising * (1 - going))
		end
	end)
	task.delay(finishAt + 0.1, function()
		finish()
		tornado.destroy()
	end)

	if mine then
		Cinematic.Camera(function(t)
			local focus = DivePlan.Victim(plan, math.min(t, times.Land)).Position
			local right = plan.forward:Cross(UP)
			if t < times.Flip - 0.05 then
				local lift = -2 + 5 * easeInOut(t / times.Lift)
				local offset = right * 18 - plan.forward * 6 + UP * lift
				return CFrame.lookAt(focus + offset, focus), 72
			end
			local after = easeInOut((t - times.Land) / 0.6)
			local eye = focus + UP * (9 + 7 * after) + right * (1.5 + 4 * after) - plan.forward * (0.5 + 3 * after)
			return CFrame.lookAt(eye, focus), 88 - 12 * after
		end, times.Length + 0.2)
	end
end

function handlers.TempestDive(data, character, root)
	local phase = data.phase
	if phase == "Reach" then
		play(character, ANIMS.Hawk)
		local hand = handOf(character, "Right")
		if hand then
			gust(hand, 3, root.CFrame.LookVector)
		end
	elseif phase == "Whiff" then
		gust(root.Position + root.CFrame.LookVector * 4, 2)
	elseif phase == "Begin" then
		playTempestDive(data, character, root)
	elseif phase == "Impact" then
		local position: Vector3 = data.position
		U.shockwave(position, WIND, 3, 26, 0.45, Enum.Material.ForceField)
		U.shockwave(position, WIND_WHITE, 2, 12, 0.25)
		U.ringBurst(CFrame.new(position + UP * 0.2), WIND_WHITE, 2, 16, 0.4, 0.45)
		U.ringBurst(CFrame.new(position + UP * 0.3), WIND, 1, 11, 0.5, 0.25)
		U.groundCracks(position, 12, 11, WIND, 1.6)
		U.groundRocks(position, 12, 7, 1.8)
		U.debris(position, 18, 45, 1)
		U.pillar(position, WIND, 3, 22, 0.45, Enum.Material.ForceField, 0.25)
		gust(position + UP, 9, UP)
		windRing(position + UP * 0.3, UP, 2, 26, 0.5)
		windRing(position + UP * 0.5, UP, 1, 16, 0.4, WIND_WHITE)
		lightRing(position + UP * 0.2, UP, 1, 20, 0.4, WIND_WHITE)
		windPuff(position + UP, 6, UP)
		streaks(position + UP, 24, 90, UP, 50)
		U.light(position, WIND, 6, 40, 0.6)
		local near = (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 60
		if near then
			U.colorGrade({ Brightness = 0.2, Contrast = 0.5, Saturation = -0.6 }, 0, 0.06, 0.25)
			CameraShake.Add(0.45)
		end
	end
end

local barriers: { [Model]: { ripple: (Vector3?) -> (), drop: () -> () } } = {}

function handlers.QuartileScutum(data, character, root)
	if data.phase == "Raise" then
		play(character, ANIMS.Scutum)
		local corners = {
			Vector3.new(-3.6, -2.6, -3.2),
			Vector3.new(3.6, -2.6, -3.2),
			Vector3.new(3.6, 3.2, -3.2),
			Vector3.new(-3.6, 3.2, -3.2),
		}
		local cornerStars = {}
		for _ = 1, 4 do
			table.insert(cornerStars, makeStar(1.4))
		end
		local edges = {}
		for _ = 1, 4 do
			table.insert(edges, bar(Vector3.zero, UP, 0.18, STAR_WHITE, 0.05))
		end
		local pane = U.newPart({
			Size = Vector3.new(7.2, 5.8, 0.1),
			Color = STAR,
			Transparency = 0.82,
			Material = Enum.Material.ForceField,
		})
		local anchors: { Attachment } = {}
		for _ = 1, 4 do
			table.insert(anchors, worldAnchor(root.Position))
		end
		local streams: { Beam } = {}
		for i = 1, 4 do
			table.insert(streams, Soft.starStream(anchors[i], anchors[i % 4 + 1], 0.6, 3))
		end
		pane.CFrame = root.CFrame * CFrame.new(0, 0.3, -3.2)
		local shimmer = windEmitter(pane, {
			Texture = SPARKLE,
			Color = ColorSequence.new(STAR_WHITE, STAR),
			LightEmission = 1,
			Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.4), key(1, 1) }),
			Size = NumberSequence.new({ key(0, 0.3), key(0.5, 0.45), key(1, 0) }),
			Lifetime = NumberRange.new(0.5, 0.9),
			Speed = NumberRange.new(0.3, 1),
			SpreadAngle = Vector2.new(180, 180),
			Shape = Enum.ParticleEmitterShape.Box,
			Rate = 22,
		})
		local done = false
		local function drop()
			done = true
			barriers[character] = nil
			for _, star in cornerStars do
				star.fade(0.25)
			end
			for _, anchor in anchors do
				starDust(anchor.WorldPosition, 5, 12)
			end
			shimmer.Enabled = false
			fadeBeams(streams, 0.25, anchors)
			fadeOut(edges, 0.25)
			fadeOut({ pane }, 0.25)
		end
		barriers[character] = {
			ripple = function(from: Vector3?)
				U.impactRing(pane.Position, pane.CFrame.LookVector, STAR_WHITE, 0.5, 4, 0.3)
				lightRing(pane.Position, pane.CFrame.LookVector, 0.3, 4.5, 0.3)
				twinkle(pane.Position, 4, STAR, 0.2)
				U.flash(pane.Position, STAR, 5, 0.15)
				if from then
					U.burst(pane.Position, {
						color = STAR,
						count = 10,
						size = 0.3,
						speed = NumberRange.new(10, 25),
						lifetime = NumberRange.new(0.15, 0.3),
						streaks = true,
						spread = 50,
						direction = (from - pane.Position).Unit,
					})
				end
			end,
			drop = drop,
		}
		for i, corner in corners do
			task.delay((i - 1) * 0.03, function()
				if root.Parent then
					twinkle(root.CFrame:PointToWorldSpace(corner), 3, STAR, 0.22)
				end
			end)
		end
		windPuff(root.CFrame:PointToWorldSpace(Vector3.new(0, 0.3, -3.2)), 2.5, root.CFrame.LookVector)
		every(data.duration + 0.5, function(elapsed)
			if done or not root.Parent then
				return false
			end
			local frame = root.CFrame
			local world = {}
			for i, corner in corners do
				world[i] = frame:PointToWorldSpace(corner)
				cornerStars[i].place(world[i], elapsed * 2 + i)
				anchors[i].CFrame = CFrame.new(world[i])
			end
			for i, edge in edges do
				local a, b = world[i], world[i % 4 + 1]
				local grow = math.min(elapsed / 0.15, 1)
				local tip = a:Lerp(b, grow)
				edge.Size = Vector3.new(0.18, 0.18, (tip - a).Magnitude + 0.05)
				edge.CFrame = CFrame.lookAt(a:Lerp(tip, 0.5), tip)
			end
			pane.CFrame = frame * CFrame.new(0, 0.3, -3.2)
			return true
		end, function()
			if not done then
				drop()
			end
		end)
	elseif data.phase == "Block" then
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(data.from)
		end
	elseif data.phase == "Drop" then
		local barrier = barriers[character]
		if barrier then
			barrier.drop()
		end
	elseif data.phase == "Reflect" then
		local origin: Vector3 = data.origin
		local barrier = barriers[character]
		if barrier then
			barrier.ripple(nil)
		end
		U.flash(origin, STAR_WHITE, 6, 0.2)
		if data.direction then
			local direction: Vector3 = data.direction
			local star = makeStar(2.2)
			local position = origin
			local travelled = 0
			every(data.range / data.speed + 0.1, function(elapsed, dt)
				local step = data.speed * dt
				position += direction * step
				travelled += step
				star.place(position, elapsed * 12)
				local streak = bar(position, position - direction * 3.5, 0.35, STAR, 0.25)
				U.tween(streak, 0.2, { Transparency = 1, Size = Vector3.new(0.05, 0.05, 3.5) })
				task.delay(0.21, streak.Destroy, streak)
				return travelled < data.range
			end, function()
				star.fade(0.15)
				U.burst(position, {
					color = STAR,
					count = 12,
					size = 0.4,
					speed = NumberRange.new(14, 30),
					lifetime = NumberRange.new(0.15, 0.3),
					spread = 180,
				})
			end)
		else
			local target: Vector3 = data.target
			local ray = bar(origin, target, 0.4, STAR_WHITE, 0)
			local glow = bar(origin, target, 1.4, STAR, 0.5)
			fadeOut({ ray, glow }, 0.2)
			U.shockwave(target, STAR, 1, 8, 0.25)
			U.burst(target, {
				color = STAR,
				count = 16,
				size = 0.45,
				speed = NumberRange.new(18, 36),
				lifetime = NumberRange.new(0.15, 0.3),
				streaks = true,
				spread = 180,
			})
		end
		if involves(data, character) then
			CameraShake.Add(0.15)
		end
	end
end

local novaContext: Nova.Context = { anims = ANIMS, play = play }

function handlers.NovaVortex(data, character, root)
	Nova.Handle(novaContext, data, character, root)
end

return {}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="53">
              <Properties>
                <string name="Name">Hawk</string>
                <string name="Source"><![CDATA[local Soft = require(script.Parent.Parent.Parent.Soft)

local rad = math.rad
local key = Soft.key

local WIND, WIND_WHITE = Soft.WIND, Soft.WIND_WHITE
local STAR = Soft.STAR

local Hawk = {}

local ARM, HAND = 1.25, 1.45
local SHOULDER = Vector3.new(0.35, 0.12, -0.25)
local FLAP = 38
local FLICK = 30

export type Piece = {
	shape: "Feather" | "Box" | "Wedge",
	size: Vector3,
	color: Color3,
	transparency: number,
}

type Feather = { bone: number, at: number, angle: number, length: number, width: number, lift: number? }
local WING: { Feather } = {
	{ bone = 1, at = 0.12, angle = 2, length = 1.05, width = 0.56 },
	{ bone = 1, at = 0.4, angle = 6, length = 1.15, width = 0.56 },
	{ bone = 1, at = 0.68, angle = 10, length = 1.2, width = 0.56 },
	{ bone = 1, at = 0.95, angle = 15, length = 1.25, width = 0.54 },
	{ bone = 2, at = 0.12, angle = 22, length = 1.3, width = 0.5 },
	{ bone = 2, at = 0.36, angle = 34, length = 1.45, width = 0.48 },
	{ bone = 2, at = 0.6, angle = 47, length = 1.55, width = 0.44 },
	{ bone = 2, at = 0.82, angle = 60, length = 1.55, width = 0.4 },
	{ bone = 2, at = 1, angle = 74, length = 1.35, width = 0.34 },
	{ bone = 1, at = 0.3, angle = 8, length = 0.6, width = 0.5, lift = 0.05 },
	{ bone = 1, at = 0.75, angle = 12, length = 0.62, width = 0.5, lift = 0.05 },
	{ bone = 2, at = 0.25, angle = 30, length = 0.66, width = 0.45, lift = 0.05 },
	{ bone = 2, at = 0.65, angle = 50, length = 0.6, width = 0.4, lift = 0.05 },
}
local OUTERMOST = 9
local TAIL = { -28, -14, 0, 14, 28 }

local PIECES: { Piece } = {
	{ shape = "Feather", size = Vector3.new(0.85, 0.75, 2.3), color = WIND_WHITE, transparency = 0.12 },
	{ shape = "Feather", size = Vector3.new(1.7, 1.5, 3.4), color = WIND, transparency = 0.72 },
	{ shape = "Feather", size = Vector3.new(0.62, 0.6, 0.85), color = WIND_WHITE, transparency = 0.08 },
	{ shape = "Wedge", size = Vector3.new(0.14, 0.24, 0.42), color = STAR, transparency = 0 },
}
for _ in TAIL do
	table.insert(PIECES, { shape = "Feather", size = Vector3.new(0.42, 0.05, 1.45), color = WIND, transparency = 0.3 })
end
for _ = 1, 2 do
	table.insert(PIECES, { shape = "Box", size = Vector3.new(ARM, 0.12, 0.12), color = WIND_WHITE, transparency = 0.1 })
	table.insert(PIECES, { shape = "Box", size = Vector3.new(HAND, 0.1, 0.1), color = WIND_WHITE, transparency = 0.1 })
	for _, f in WING do
		table.insert(PIECES, {
			shape = "Feather",
			size = Vector3.new(f.width, 0.05, f.length),
			color = if f.lift
				then WIND:Lerp(WIND_WHITE, 0.45)
				elseif f.bone == 2 then WIND:Lerp(WIND_WHITE, 0.2)
				else WIND,
			transparency = if f.lift then 0.2 else 0.28,
		})
	end
end
local TIP = 4 + #TAIL + 2 + OUTERMOST

function Hawk.Pieces(): { Piece }
	return PIECES
end

function Hawk.Pose(frames: { CFrame }, frame: CFrame, phase: number, bank: number)
	local body = frame * CFrame.new(0, -0.1 * math.sin(phase), 0) * CFrame.Angles(0, 0, bank)
	frames[1] = body
	frames[2] = body
	frames[3] = body * CFrame.new(0, 0.18, -1.25) * CFrame.Angles(rad(-8), 0, 0)
	frames[4] = body * CFrame.new(0, 0.1, -1.72)
	local n = 4
	for _, spread in TAIL do
		n += 1
		frames[n] = body * CFrame.new(0, 0.05, 1.05) * CFrame.Angles(rad(6), rad(spread), 0) * CFrame.new(0, 0, 0.65)
	end
	local arm = FLAP * math.sin(phase)
	local hand = arm + FLICK * math.sin(phase - 0.7)
	for _, side in { 1, -1 } do
		local shoulder = body
			* CFrame.new(SHOULDER.X * side, SHOULDER.Y, SHOULDER.Z)
			* CFrame.Angles(0, rad(-8) * side, rad(arm) * side)
		local wrist = shoulder
			* CFrame.new(ARM * side, 0, 0)
			* CFrame.Angles(0, rad(-12) * side, rad(hand - arm) * side)
		n += 1
		frames[n] = shoulder * CFrame.new(ARM / 2 * side, 0, -0.05)
		n += 1
		frames[n] = wrist * CFrame.new(HAND / 2 * side, 0, -0.05)
		for _, f in WING do
			local bone, length = if f.bone == 1 then shoulder else wrist, if f.bone == 1 then ARM else HAND
			n += 1
			frames[n] = bone
				* CFrame.new(length * f.at * side, f.lift or 0, 0)
				* CFrame.Angles(0, rad(f.angle) * side, 0)
				* CFrame.new(0, 0, f.length / 2)
		end
	end
end

export type Hawk = {
	parts: { BasePart },
	frames: { CFrame },
	body: BasePart,
	trails: { Trail },
}

function Hawk.new(start: CFrame): Hawk
	local parts: { BasePart } = {}
	for _, piece in PIECES do
		local part: BasePart
		if piece.shape == "Wedge" then
			part = Soft.newWedge({ Size = piece.size, Color = piece.color, Transparency = piece.transparency })
		else
			part = Soft.U.newPart({ Size = piece.size, Color = piece.color, Transparency = piece.transparency })
			if piece.shape == "Feather" then
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = part
			end
		end
		table.insert(parts, part)
	end
	local hawk = {
		parts = parts,
		frames = table.create(#parts, CFrame.identity),
		body = parts[1],
		trails = {},
	}
	Hawk.Place(hawk, start, 0, 0)
	table.insert(
		hawk.trails,
		Soft.trail(parts[1], Vector3.new(0, 1, 0.4), Vector3.new(0, -1, 0.4), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new({ key(0, 0.35), key(1, 1) }),
			width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
			lifetime = 0.4,
			texture = Soft.SMOKE,
		})
	)
	for _, tip in { TIP, TIP + 2 + #WING } do
		local feather = parts[tip]
		local half = feather.Size.Z / 2
		table.insert(
			hawk.trails,
			Soft.trail(feather, Vector3.new(0, 0, half - 0.6), Vector3.new(0, 0, half), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
				lifetime = 0.22,
			})
		)
	end
	return hawk
end

function Hawk.Place(hawk: Hawk, frame: CFrame, phase: number, bank: number)
	Hawk.Pose(hawk.frames, frame, phase, bank)
	workspace:BulkMoveTo(hawk.parts, hawk.frames, Enum.BulkMoveMode.FireCFrameChanged)
end

function Hawk.Release(hawk: Hawk, fade: number)
	for _, trail in hawk.trails do
		Soft.endTrail(trail)
	end
	for _, part in hawk.parts do
		Soft.linger(part, fade, 0.55)
	end
end

return Hawk
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="54">
              <Properties>
                <string name="Name">Look</string>
                <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local CameraShake = require(script.Parent.Parent.Parent.CameraShake)
local VFX = require(script.Parent.Parent.Parent.VFX)
local Soft = require(script.Parent.Parent.Parent.Soft)
local Sword = require(script.Parent.Sword)
local Wings = require(script.Parent.Wings)

local U = VFX.Util
local rad = math.rad
local UP = Vector3.yAxis

local WIND, WIND_WHITE = Soft.WIND, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE, SPARKLE = Soft.SMOKE, Soft.SPARKLE
local every, fadeOut, key = Soft.every, Soft.fadeOut, Soft.key
local inflow, gust = Soft.inflow, Soft.gust
local makeSprite = Soft.makeSprite
local worldAnchor, softBeam, fadeBeams, softRing = Soft.worldAnchor, Soft.softBeam, Soft.fadeBeams, Soft.softRing
local windRing, lightRing, windEmitter, windPuff = Soft.windRing, Soft.lightRing, Soft.windEmitter, Soft.windPuff
local twinkle, starDust = Soft.twinkle, Soft.starDust

local Fx = require(script.Parent.Fx)
local ANIMS, handlers, play, easeOut, featherBurst = Fx.ANIMS, Fx.handlers, Fx.play, Fx.easeOut, Fx.featherBurst

local looks: { [Model]: { hideSword: number, blade: BasePart? } } = {}

local function hideSword(character: Model, duration: number)
	local look = looks[character]
	if look then
		look.hideSword = os.clock() + duration
	end
end

local function transformation(data, character: Model, root: BasePart, full: boolean)
	if data.phase == "Start" then
		play(character, if full then ANIMS.Ascend else ANIMS.Awaken)
		local sylph = makeSprite(1.4)
		every(0.8, function(elapsed)
			if not root.Parent then
				return false
			end
			local t = elapsed / 0.8
			local angle = t * math.pi * 4
			local radius = 5 * (1 - t) + 0.5
			sylph.place(
				CFrame.new(root.Position + Vector3.new(math.cos(angle) * radius, 3 - t * 2, math.sin(angle) * radius)),
				elapsed
			)
			inflow(root.Position, 7)
			return true
		end, function()
			sylph.fade(0.15)
		end)
		if full then
			U.spiral(root, WIND, 4, 10, 1.3, 4, 0.2, 0.5)
		end
		U.ringBurst(CFrame.new(root.Position - UP * 2.8), WIND, 12, 2, 0.8, 0.2)
		local feet = root.Position - UP * 2.85
		local circle = {
			softRing({
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 1.8,
				width1 = 1.8,
				transparency = NumberSequence.new(0.5),
				texture = SMOKE,
				speed = 3,
				length = 5,
			}),
			softRing({
				color = ColorSequence.new(if full then STAR_WHITE else WIND_WHITE, if full then STAR else WIND),
				width0 = 0.9,
				width1 = 0.9,
				transparency = NumberSequence.new(0.35),
				texture = SPARKLE,
				wrap = true,
				length = 1.4,
				speed = 2,
			}),
		}
		local well = U.newPart({ Size = Vector3.one * 16, Transparency = 1, CFrame = CFrame.new(root.Position) })
		local drawn = {
			windEmitter(well, {
				Size = NumberSequence.new({ key(0, 4), key(1, 1) }),
				Lifetime = NumberRange.new(0.5, 0.6),
				Speed = NumberRange.new(14, 16),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 40,
			}),
			windEmitter(well, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, if full then STAR else WIND_WHITE),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.2), key(1, 0.6) }),
				Size = NumberSequence.new({ key(0, 0.7), key(1, 0.1) }),
				Lifetime = NumberRange.new(0.5, 0.6),
				Speed = NumberRange.new(14, 16),
				Shape = Enum.ParticleEmitterShape.Sphere,
				ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Rate = 50,
			}),
		}
		Soft.helix(function()
			return root.Position - UP * 3, root.Position + UP * 4
		end, 3.5, if full then 4 else 3, 0.45, 2, 0.8, 0.8)
		every(0.8, function(elapsed)
			if not root.Parent then
				return false
			end
			local close = easeOut(elapsed / 0.8)
			circle[1].set(CFrame.new(feet) * CFrame.Angles(0, elapsed * 3, 0), 11 - 8 * close)
			circle[2].set(CFrame.new(feet + UP * 0.05) * CFrame.Angles(0, -elapsed * 2, 0), 12 - 8.5 * close)
			return true
		end, function()
			for _, ring in circle do
				ring.fade(0.15)
			end
			for _, emitter in drawn do
				emitter.Enabled = false
			end
			task.delay(0.7, well.Destroy, well)
		end)
	elseif data.phase == "Burst" then
		local position = root.Position
		U.shockwave(position, WIND, 3, if full then 40 else 28, 0.6, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, if full then 22 else 16, 0.5, 0.4)
		U.pillar(position - UP * 3, WIND, 4, if full then 40 else 26, 0.6, Enum.Material.ForceField, 0.3)
		U.burst(position, {
			color = WIND_WHITE,
			count = 40,
			size = 0.6,
			speed = NumberRange.new(40, 90),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if full then
			U.flash(position + UP * 3, STAR, 10, 0.3)
			twinkle(position + UP * 3, 16, STAR, 0.4)
			starDust(position + UP * 2, 30, 40)
		else
			twinkle(position + UP * 2, 10, WIND, 0.35)
		end
		local foot, head =
			worldAnchor(position - UP * 3, UP), worldAnchor(position + UP * (if full then 44 else 30), UP)
		local column = {
			softBeam(foot, head, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 8,
				width1 = 14,
				transparency = NumberSequence.new({ key(0, 0.8), key(0.15, 0.45), key(1, 1) }),
				texture = SMOKE,
				speed = 14,
				length = 14,
			}),
			softBeam(foot, head, {
				color = ColorSequence.new(STAR_WHITE, if full then STAR else WIND_WHITE),
				width0 = 2.5,
				width1 = 4,
				transparency = NumberSequence.new({ key(0, 0.6), key(0.15, 0.25), key(1, 1) }),
				texture = SPARKLE,
				wrap = true,
				length = 3,
				speed = 24,
			}),
		}
		for _, beam in column do
			U.tween(beam, 0.6, { Width0 = beam.Width0 * 0.2, Width1 = beam.Width1 * 0.2 })
		end
		fadeBeams(column, 0.6, { foot, head })
		windRing(position - UP * 2.6, UP, 2, if full then 30 else 22, 0.55)
		windRing(position, UP, 1, if full then 22 else 16, 0.45, WIND_WHITE)
		lightRing(position - UP * 2.7, UP, 1, if full then 26 else 18, 0.4, if full then STAR else WIND_WHITE)
		windPuff(position, 6)
		featherBurst(position + UP, if full then 22 else 14, 26)
		U.light(position, WIND, 6, 40, 0.8)
		if U.isLocal(character) then
			U.colorGrade({ Brightness = 0.15, Saturation = 0.3 }, 0, 0.1, 0.5)
			CameraShake.Add(0.35)
			CameraShake.FovKick(12)
		end
	elseif data.phase == "End" then
		gust(root.Position, 6)
		windRing(root.Position - UP * 2.6, UP, 1, 10, 0.4)
		featherBurst(root.Position + UP, 8, 14)
	end
end

function handlers.Awaken(data, character, root)
	transformation(data, character, root, false)
end

function handlers.Ascend(data, character, root)
	transformation(data, character, root, true)
end

local GRIMOIRE_COVER = Color3.fromRGB(28, 70, 58)
local GRIMOIRE_PAPER = Color3.fromRGB(226, 234, 214)

type Spike = { left: BasePart, right: BasePart, angle: number, height: number }
type Page = { part: BasePart, offset: CFrame, side: number }

local function buildLook(character: Model, full: boolean): () -> ()
	local torso = character:FindFirstChild("Torso") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	local root = U.getRoot(character)
	if not torso or not head or not root then
		return function() end
	end
	local look: { hideSword: number, blade: BasePart? } = { hideSword = 0, blade = nil }
	looks[character] = look
	local entries: { { part: BasePart, base: number } } = {}
	local baseOf: { [BasePart]: number } = {}
	local function part(props: { [string]: any }, base: number, wedge: boolean?): BasePart
		local p: BasePart
		if wedge then
			p = Instance.new("WedgePart")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			for key, value in props do
				(p :: any)[key] = value
			end
			p.Parent = U.folder
		else
			p = U.newPart(props)
		end
		p.Transparency = 1
		table.insert(entries, { part = p, base = base })
		baseOf[p] = base
		return p
	end
	local sides = if full then { -1, 1 } else { -1 }

	local wings: { Wings.Wing } = {}
	local emitters: { ParticleEmitter } = {}
	local wingTrails: { Trail } = {}
	local wingBeams: { Beam } = {}
	for _, side in sides do
		local wing = Wings.new(part, side)
		table.insert(wings, wing)
		for _, trail in wing.trails do
			table.insert(wingTrails, trail)
		end
		for _, beam in wing.beams do
			beam.Enabled = false
			table.insert(wingBeams, beam)
		end
		for _, emitter in wing.emitters do
			table.insert(emitters, emitter)
		end
	end
	local wingsStarted = false
	local phase = 0
	local glide, gliding = 0, 0

	local spikes: { Spike } = {}
	local spikeCount = if full then 10 else 5
	for i = 1, spikeCount do
		local angle, height
		if full then
			angle = (i - 1) / spikeCount * math.pi * 2
			height = if i == 1 then 1 elseif i % 2 == 1 then 0.72 else 0.48
		else
			local f = (i - 1) / (spikeCount - 1)
			angle = -(0.1 + 0.8 * f) * math.pi
			height = 0.45 + 0.5 * math.sin(f * math.pi)
		end
		table.insert(spikes, {
			left = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			right = part({ Size = Vector3.new(0.06, height, 0.15), Color = STAR }, 0.02, true),
			angle = angle,
			height = height,
		})
	end
	local bandCount = if full then 16 else 8
	local band = {}
	for _ = 1, bandCount do
		table.insert(band, part({ Size = Vector3.new(0.09, 0.14, 0.3), Color = STAR }, 0.05))
	end
	local gem = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.22, Color = WIND }, 0)

	local shells: { { part: BasePart, limb: BasePart, offset: CFrame } } = {}
	for _, side in sides do
		for _, name in { if side < 0 then "Left Arm" else "Right Arm", if side < 0 then "Left Leg" else "Right Leg" } do
			local limb = character:FindFirstChild(name) :: BasePart?
			if limb then
				table.insert(shells, {
					part = part({
						Size = limb.Size + Vector3.new(0.08, 0.08, 0.08),
						Color = WIND,
						Material = Enum.Material.ForceField,
					}, 0),
					limb = limb,
					offset = CFrame.identity,
				})
			end
		end
		table.insert(shells, {
			part = part({ Size = Vector3.new(1.06, 2.08, 1.08), Color = WIND, Material = Enum.Material.ForceField }, 0),
			limb = torso,
			offset = CFrame.new(side * 0.5, 0, 0),
		})
		local arm = character:FindFirstChild(if side < 0 then "Left Arm" else "Right Arm") :: BasePart?
		if arm then
			local wisp = Instance.new("ParticleEmitter")
			wisp.Texture = U.textures.Smoke
			wisp.Color = ColorSequence.new(WIND)
			wisp.LightEmission = 0.8
			wisp.LightInfluence = 0
			wisp.Size = NumberSequence.new(0.5, 0)
			wisp.Transparency = NumberSequence.new(0.5, 1)
			wisp.Lifetime = NumberRange.new(0.4, 0.7)
			wisp.Rate = 18
			wisp.Speed = NumberRange.new(0.5, 1.5)
			wisp.Acceleration = Vector3.new(0, 3, 0)
			wisp.Parent = arm
			table.insert(emitters, wisp)
		end
	end

	local book: { Page } = {}
	local function page(props: { [string]: any }, base: number, offset: CFrame, side: number)
		table.insert(book, { part = part(props, base), offset = offset, side = side })
	end
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = GRIMOIRE_PAPER, Material = Enum.Material.SmoothPlastic },
		0,
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = GRIMOIRE_COVER, Material = Enum.Material.Fabric },
		0,
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			0.05,
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, 0, CFrame.new(0, 1.05, -0.4), 0)
	local bookLight = Instance.new("PointLight")
	bookLight.Color = WIND
	bookLight.Range = 8
	bookLight.Brightness = 1.5
	bookLight.Parent = book[#book].part

	local sword: Sword.Sword? = nil
	if full then
		local made = Sword.new(part)
		sword = made
		look.blade = made.blade
	end
	local swordShown = true

	local hoverRing = softRing({
		color = ColorSequence.new(WIND_WHITE, WIND),
		width0 = 0.9,
		width1 = 0.9,
		transparency = NumberSequence.new(0.6),
		texture = U.textures.Smoke,
		speed = 2,
		length = 4,
	})
	local draft = U.newPart({ Size = Vector3.new(1.6, 0.2, 1.6), Transparency = 1 })
	local downdraft = windEmitter(draft, {
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 3.2) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(5, 9),
		SpreadAngle = Vector2.new(35, 35),
		EmissionDirection = Enum.NormalId.Bottom,
		Drag = 2,
		Rate = 14,
	})

	local start = os.clock()
	local last = start
	local faded = false
	local connection: RBXScriptConnection
	local function destroy()
		connection:Disconnect()
		if looks[character] == look then
			looks[character] = nil
		end
		hoverRing.fade(0.3)
		downdraft.Enabled = false
		for _, trail in wingTrails do
			trail.Enabled = false
		end
		Soft.fadeBeams(wingBeams, 0.3)
		if sword then
			for _, beam in sword.beams do
				beam.Enabled = false
			end
			for _, emitter in sword.emitters do
				emitter.Enabled = false
			end
		end
		task.delay(1, draft.Destroy, draft)
		for _, emitter in emitters do
			emitter.Enabled = false
			task.delay(1, emitter.Destroy, emitter)
		end
		local parts = {}
		for _, entry in entries do
			table.insert(parts, entry.part)
		end
		fadeOut(parts, 0.4)
	end
	connection = RunService.RenderStepped:Connect(function()
		if not torso.Parent or not head.Parent or not root.Parent then
			destroy()
			return
		end
		local now = os.clock()
		local t = now - start
		local dt = math.min(now - last, 0.1)
		last = now
		local alpha = math.min(t / 0.5, 1)
		local fading = not faded
		if fading then
			for _, entry in entries do
				entry.part.Transparency = 1 - (1 - entry.base) * alpha
			end
			if alpha >= 1 then
				faded = true
				for _, beam in wingBeams do
					beam.Enabled = true
				end
			end
		end
		hoverRing.set(
			CFrame.new(root.Position - UP * 2.95) * CFrame.Angles(0, t * 1.2, 0),
			(2.2 + 0.25 * math.sin(t * 2)) * alpha + 0.05
		)
		draft.CFrame = root.CFrame * CFrame.new(0, -1.1, 0)

		local velocity = root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		gliding += ((math.clamp((speed - 6) / 14, 0, 1) - glide) * 16 - gliding * 8) * dt
		glide += gliding * dt
		if glide <= 0 or glide >= 1 then
			glide = math.clamp(glide, 0, 1)
			gliding = 0
		end
		local hold = Wings.Blend(Wings.Hover, Wings.Glide, glide)
		phase = (phase + dt * hold.rate * math.pi * 2) % (math.pi * 2)
		for _, wing in wings do
			Wings.Place(wing, torso.CFrame, hold, phase, glide, t)
		end
		if not wingsStarted then
			wingsStarted = true
			for _, trail in wingTrails do
				Soft.beginTrail(trail)
			end
		end

		local crown = head.CFrame * CFrame.new(0, 0.3, 0)
		local function around(a: number): Vector3
			return Vector3.new(math.sin(a), 0, -math.cos(a))
		end
		local function along(a: number): Vector3
			return crown:VectorToWorldSpace(Vector3.new(math.cos(a), 0, math.sin(a)))
		end
		for i, segment in band do
			local a = if full then (i - 0.5) / bandCount * math.pi * 2 else -((i - 0.5) / bandCount) * math.pi
			local position = crown * (around(a) * 0.66)
			segment.CFrame = CFrame.lookAt(position, position + along(a), crown.UpVector)
		end
		for _, spike in spikes do
			local center = crown * (around(spike.angle) * 0.66) + crown.UpVector * (spike.height / 2 + 0.05)
			local frame = CFrame.lookAt(center, center + along(spike.angle), crown.UpVector)
			local half = spike.left.Size.Z / 2
			spike.left.CFrame = frame * CFrame.new(0, 0, -half)
			spike.right.CFrame = frame * CFrame.new(0, 0, half) * CFrame.Angles(0, math.pi, 0)
		end
		gem.CFrame =
			CFrame.new(crown * ((if full then around(0) else around(-math.pi / 2)) * 0.7 + Vector3.new(0, 0.12, 0)))

		for _, shell in shells do
			if shell.limb.Parent then
				shell.part.CFrame = shell.limb.CFrame * shell.offset
			end
		end

		local orbit = t * 1.15
		local position = root.Position
			+ Vector3.new(math.cos(orbit) * 3, 1.3 + math.sin(t * 2.1) * 0.3, math.sin(orbit) * 3)
		local bookFrame = CFrame.lookAt(position, root.Position + UP * 1.3) * CFrame.Angles(rad(-15), 0, 0)
		local open = rad((62 + math.sin(t * 6) * 6) * alpha)
		for _, p in book do
			local hinge = CFrame.Angles(0, -p.side * open, 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = bookFrame * hinge * spin * p.offset
		end

		if sword then
			local arm = character:FindFirstChild("Right Arm") :: BasePart?
			if arm then
				Sword.Place(sword, arm.CFrame * CFrame.new(0, -1.1, 0) * CFrame.Angles(rad(-90), 0, 0))
			end
			local hidden = now < look.hideSword
			if hidden and (swordShown or fading) then
				for _, p in sword.parts do
					p.Transparency = 1
				end
			elseif not hidden and not swordShown and not fading then
				for _, p in sword.parts do
					p.Transparency = baseOf[p]
				end
			end
			swordShown = not hidden
			for _, beam in sword.beams do
				beam.Enabled = not hidden and faded
			end
			for _, emitter in sword.emitters do
				emitter.Enabled = not hidden
			end
		end
	end)

	return function()
		if connection.Connected then
			destroy()
		end
	end
end

type Book = { place: (CFrame, number, number) -> (), fade: (number) -> () }

local function makeBook(): Book
	local pages: { { part: BasePart, offset: CFrame, side: number } } = {}
	local function page(props: { [string]: any }, offset: CFrame, side: number)
		table.insert(pages, { part = U.newPart(props), offset = offset, side = side })
	end
	local cover = Color3.fromRGB(28, 70, 58)
	local paper = Color3.fromRGB(226, 234, 214)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(-0.55, 0, 0),
		-1
	)
	page(
		{ Size = Vector3.new(1.1, 1.45, 0.08), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0.55, 0, 0),
		1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(-0.5, 0, -0.08),
		-1
	)
	page(
		{ Size = Vector3.new(1, 1.35, 0.12), Color = paper, Material = Enum.Material.SmoothPlastic },
		CFrame.new(0.5, 0, -0.08),
		1
	)
	page(
		{ Size = Vector3.new(0.14, 1.45, 0.14), Color = cover, Material = Enum.Material.Fabric },
		CFrame.new(0, 0, 0.02),
		0
	)
	for i = 1, 4 do
		local angle = (i - 1) * math.pi / 2 + math.pi / 4
		page(
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = WIND },
			CFrame.new(math.cos(angle) * 0.17, 1.05 + math.sin(angle) * 0.17, -0.4),
			0
		)
	end
	page({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, Color = STAR }, CFrame.new(0, 1.05, -0.4), 0)
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 8
	light.Brightness = 2
	light.Parent = pages[#pages].part
	local book = {}
	function book.place(frame: CFrame, open: number, t: number)
		for _, p in pages do
			local hinge = CFrame.Angles(0, -p.side * rad(open), 0)
			local spin = if p.side == 0 and p.offset.Y > 0.5
				then CFrame.new(0, 1.05, -0.4) * CFrame.Angles(0, 0, t * 1.5) * CFrame.new(0, -1.05, 0.4)
				else CFrame.identity
			p.part.CFrame = frame * hinge * spin * p.offset
		end
	end
	function book.fade(duration: number)
		light.Enabled = false
		local parts = {}
		for _, p in pages do
			table.insert(parts, p.part)
		end
		fadeOut(parts, duration)
	end
	return book
end

function handlers.Entrance(data, character, root)
	if data.phase ~= "Start" then
		return
	end
	play(character, ANIMS.Entrance)
	local book = makeBook()
	local sylph = makeSprite(1.2)
	every(2.2, function(elapsed)
		if not root.Parent then
			return false
		end
		local forward = root.CFrame.LookVector
		local right = root.CFrame.RightVector
		local position, open
		if elapsed < 0.6 then
			local eased = 1 - (1 - elapsed / 0.6) ^ 2
			position = root.Position + forward * 2.5 + UP * (1.5 + 18 * (1 - eased)) + right * 6 * (1 - eased)
			open = 0
		elseif elapsed < 1.2 then
			local a = (elapsed - 0.6) / 0.6
			local angle = a * math.pi * 2
			position = root.Position + (forward * math.cos(angle) + right * math.sin(angle)) * 2.5 + UP * 1.5
			open = 70 * a
		else
			position = root.Position + forward * 2.2 + UP * (1.8 + math.min((elapsed - 1.2) * 2, 0.8))
			open = 70
		end
		book.place(CFrame.lookAt(position, root.Position + UP * 1.5) * CFrame.Angles(rad(-15), 0, 0), open, elapsed)
		if elapsed < 1.2 then
			local angle = elapsed * 7
			sylph.place(
				CFrame.new(
					root.Position
						+ Vector3.new(math.cos(angle) * 3.5, 1.5 + math.sin(elapsed * 9), math.sin(angle) * 3.5)
				),
				elapsed
			)
			inflow(root.Position, 7)
		end
		return true
	end, function()
		book.fade(0.3)
	end)
	U.spiral(root, WIND, 3, 6, 1.2, 3, 0.1, 0.4)
	task.delay(1.2, function()
		sylph.fade(0.15)
		if not root.Parent then
			return
		end
		local position = root.Position
		gust(position + UP, 8, UP)
		U.shockwave(position, WIND, 3, 20, 0.45, Enum.Material.ForceField)
		U.ringBurst(CFrame.new(position - UP * 2.8), WIND_WHITE, 2, 14, 0.4, 0.35)
		windRing(position - UP * 2.7, UP, 1, 16, 0.45)
		lightRing(position - UP * 2.75, UP, 1, 12, 0.35, WIND_WHITE)
		featherBurst(position + UP, 12, 18)
		twinkle(position + root.CFrame.LookVector * 2.2 + UP * 2, 7, STAR, 0.3)
		U.flash(position + root.CFrame.LookVector * 2.2 + UP * 2, STAR, 6, 0.25)
		U.light(position, WIND, 5, 26, 0.5)
		if U.isLocal(character) then
			CameraShake.Add(0.2)
			CameraShake.FovKick(8)
		end
	end)
end

return {
	looks = looks,
	hideSword = hideSword,
	buildLook = buildLook,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="55">
              <Properties>
                <string name="Name">Nova</string>
                <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local Soft = require(script.Parent.Parent.Parent.Soft)

local U = Soft.U
local UP = Vector3.yAxis
local key = Soft.key

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE = Soft.SMOKE

type Animation = PoseAnimator.Animation

export type Context = {
	anims: { [string]: Animation },
	play: (Model, Animation) -> (),
}

local Nova = {}

local ARMS = 4
local SPIRAL_IN, SPIRAL_OUT = 1.2, 14
local TWIST = 2.4
local COLLAPSE = 0.15

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

local function handOf(character: Model): Vector3?
	local arm = character:FindFirstChild("Right Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.3, 0)).Position else nil
end

type Forming = { stop: () -> () }
local forming: { [Model]: Forming } = setmetatable({}, { __mode = "k" }) :: any

local function formStar(character: Model): Forming
	local star = Soft.makeStar(1.1)
	local alive = true
	Soft.every(0.6, function(elapsed)
		local hand = handOf(character)
		if not alive or not hand then
			return false
		end
		star.place(hand + UP * (0.6 + 0.2 * smooth(elapsed / 0.2)), elapsed * 6)
		return true
	end, function()
		if alive then
			alive = false
			star.fade(0.1)
		end
	end)
	for i = 0, 5 do
		task.delay(i * 0.04, function()
			local hand = handOf(character)
			if alive and hand then
				Soft.inflow(hand + UP * 0.8, 3.5, if i % 2 == 0 then WIND_WHITE else STAR)
			end
		end)
	end
	return {
		stop = function()
			if alive then
				alive = false
				star.fade(0.08)
			end
		end,
	}
end

local function throwStar(from: Vector3, eye: Vector3, flight: number)
	local star = Soft.makeStar(1.5)
	local holder = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(from) })
	local light = Soft.trail(holder, Vector3.new(0, 0.45, 0), Vector3.new(0, -0.45, 0), {
		color = ColorSequence.new(STAR_WHITE, STAR),
		transparency = NumberSequence.new({ key(0, 0.15), key(1, 1) }),
		width = NumberSequence.new({ key(0, 1), key(1, 0) }),
		lifetime = 0.25,
		off = true,
	})
	local wind = Soft.trail(holder, Vector3.new(0, 1.1, 0), Vector3.new(0, -1.1, 0), {
		color = ColorSequence.new(WIND_WHITE, WIND),
		transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
		width = NumberSequence.new({ key(0, 1), key(1, 0.3) }),
		lifetime = 0.3,
		texture = SMOKE,
		off = true,
	})
	local begun = false
	Soft.every(flight, function(elapsed)
		local u = elapsed / flight
		local at = from:Lerp(eye, u) + UP * math.sin(u * math.pi) * 2.5
		holder.CFrame = CFrame.lookAt(at, eye)
		star.place(at, elapsed * 16)
		if not begun then
			begun = true
			Soft.beginTrail(light)
			Soft.beginTrail(wind)
		end
		return true
	end, function()
		star.fade(0.08)
		Soft.endTrail(light)
		Soft.endTrail(wind)
		Soft.linger(holder, 0.05, 0.5)
		U.flash(eye, STAR_WHITE, 3, 0.1)
		Soft.twinkle(eye, 6, STAR, 0.25)
	end)
end

type Galaxy = { collapse: () -> (), fade: () -> () }
local galaxies: { [Model]: Galaxy } = setmetatable({}, { __mode = "k" }) :: any

local function drawIn(eye: Vector3, ground: Vector3, radius: number)
	local angle = math.random() * math.pi * 2
	local from = ground + Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius + UP * (0.4 + math.random() * 2.2)
	local to = eye:Lerp(from, 0.15)
	local wisp = Soft.bar(from, from + (to - from).Unit * 2.4, 0.12, WIND_WHITE, 0.35)
	U.tween(wisp, 0.3, { CFrame = CFrame.lookAt(to, to + (to - from).Unit), Transparency = 1 })
	task.delay(0.32, wisp.Destroy, wisp)
end

local function openGalaxy(eye: Vector3, ground: Vector3, reach: number): Galaxy
	local made: { Instance } = {}
	local plane = ground + UP * 0.7
	local born = os.clock()
	local collapsing: number? = nil
	local spin = 0

	local function spiral(base: number, s: number, scale: number): (Vector3, Vector3)
		local r = (SPIRAL_IN + (SPIRAL_OUT - SPIRAL_IN) * s) * scale
		local theta = base + TWIST * s
		local radial = Vector3.new(math.cos(theta), 0, math.sin(theta))
		local around = Vector3.new(-math.sin(theta), 0, math.cos(theta))
		local tangent = radial * (SPIRAL_OUT - SPIRAL_IN) * scale + around * r * TWIST
		return plane + radial * r, tangent
	end

	type Span = { a: Attachment, b: Attachment, beams: { Beam }, from: number, to: number, arm: number }
	local spans: { Span } = {}
	for arm = 1, ARMS do
		for half = 0, 1 do
			local a, b = Soft.worldAnchor(plane), Soft.worldAnchor(plane)
			table.insert(made, a)
			table.insert(made, b)
			local inner = half == 0
			local beams = {
				Soft.softBeam(a, b, {
					color = ColorSequence.new(WIND_WHITE, if arm % 2 == 0 then WIND else WIND_DEEP),
					width0 = if inner then 3.4 else 2.4,
					width1 = if inner then 2.4 else 0.8,
					transparency = NumberSequence.new({ key(0, 0.5), key(1, if inner then 0.6 else 0.85) }),
					texture = SMOKE,
					speed = 4,
					length = 6,
				}),
				Soft.starStream(a, b, if inner then 1.3 else 0.9, 3),
			}
			for _, beam in beams do
				table.insert(made, beam)
			end
			table.insert(spans, { a = a, b = b, beams = beams, from = half * 0.5, to = half * 0.5 + 0.5, arm = arm })
		end
	end

	type Mote = { part: BasePart, arm: number, s: number, lift: number, out: number, phase: number }
	local motes: { Mote } = {}
	for i = 1, 40 do
		local part = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (0.3 + math.random() * 0.5),
			Color = if i % 3 == 0 then STAR else STAR_WHITE,
			Transparency = 1,
		})
		table.insert(made, part)
		table.insert(motes, {
			part = part,
			arm = (i - 1) % ARMS + 1,
			s = math.random(),
			lift = 0.2 + math.random() * 1.6,
			out = (math.random() - 0.5) * 1.6,
			phase = math.random() * 6.28,
		})
	end

	local core = Soft.makeStar(3)
	for _, part in core.parts do
		table.insert(made, part)
	end

	local rings = {
		Soft.softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.4,
			width1 = 1.4,
			transparency = NumberSequence.new(0.6),
			texture = SMOKE,
			speed = 5,
			length = 6,
		}),
		Soft.softRing({
			color = ColorSequence.new(WIND_WHITE, WIND_DEEP),
			width0 = 2,
			width1 = 2,
			transparency = NumberSequence.new(0.7),
			texture = SMOKE,
			speed = -4,
			length = 8,
			segments = 16,
		}),
	}
	local edge = Soft.softRing({
		color = ColorSequence.new(STAR_WHITE, STAR),
		width0 = 0.3,
		width1 = 0.3,
		transparency = NumberSequence.new(0.55),
		segments = 20,
	})
	for _, ring in { rings[1], rings[2], edge } do
		table.insert(made, ring.hub)
	end

	local foot, top = Soft.worldAnchor(ground, UP), Soft.worldAnchor(ground + UP * 13, UP)
	table.insert(made, foot)
	table.insert(made, top)
	local column = Soft.softBeam(foot, top, {
		color = ColorSequence.new(WIND_WHITE, WIND),
		width0 = 2.6,
		width1 = 6,
		transparency = NumberSequence.new({ key(0, 0.55), key(1, 1) }),
		texture = SMOKE,
		speed = -10,
		length = 8,
	})
	table.insert(made, column)
	local stopHelix = Soft.helix(function()
		return ground, ground + UP * 12
	end, 1.8, 3, 0.45, 1.5, 0.7, 3, WIND_WHITE)

	local floor = U.newPart({
		Size = Vector3.new(reach * 1.4, 0.2, reach * 1.4),
		Transparency = 1,
		CFrame = CFrame.new(ground + UP * 0.2),
	})
	table.insert(made, floor)
	local dust = Soft.windEmitter(floor, {
		Color = ColorSequence.new(Color3.fromRGB(214, 222, 210), Color3.fromRGB(176, 196, 182)),
		LightEmission = 0,
		Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.86), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 2), key(1, 5) }),
		Lifetime = NumberRange.new(0.8, 1.2),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(30, 30),
		EmissionDirection = Enum.NormalId.Top,
		Rate = 26,
	})

	local nextDraw = 0
	local finished = false
	local connection: RBXScriptConnection
	local function destroy()
		if finished then
			return
		end
		finished = true
		connection:Disconnect()
		stopHelix()
		dust.Enabled = false
		for _, instance in made do
			instance:Destroy()
		end
	end
	connection = RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		local t = now - born
		local grow = 1 - (1 - math.clamp(t / 0.3, 0, 1)) ^ 3
		local shrink = if collapsing then 1 - smooth((now - collapsing) / COLLAPSE) else 1
		local scale = math.max(grow * shrink, 0.02)
		if collapsing and now - collapsing >= COLLAPSE then
			destroy()
			return
		end
		spin += dt * (1.6 + 1.2 * math.min(t, 2) + (if collapsing then 10 else 0))

		for _, span in spans do
			local base = spin + (span.arm - 1) * math.pi * 2 / ARMS
			local p0, t0 = spiral(base, span.from, scale)
			local p1, t1 = spiral(base, span.to, scale)
			Soft.aim(span.a, p0, t0)
			Soft.aim(span.b, p1, t1)
			local step = span.to - span.from
			for _, beam in span.beams do
				beam.CurveSize0 = t0.Magnitude * step / 3
				beam.CurveSize1 = t1.Magnitude * step / 3
			end
		end
		for _, mote in motes do
			local base = spin + (mote.arm - 1) * math.pi * 2 / ARMS
			local p, tangent = spiral(base, mote.s, scale)
			local side = tangent:Cross(UP).Unit
			mote.part.CFrame = CFrame.new(p + side * mote.out * scale + UP * mote.lift * scale)
			local glint = 0.5 + 0.5 * math.sin(t * 7 + mote.phase)
			mote.part.Transparency = 1 - math.min(grow, shrink) * (0.25 + 0.6 * glint)
		end
		core.place(eye, t * 3)
		rings[1].set(CFrame.new(plane + UP * 0.2) * CFrame.Angles(0, spin, 0), 8 * scale)
		rings[2].set(CFrame.new(plane + UP * 0.4) * CFrame.Angles(0, -spin * 0.6, 0), SPIRAL_OUT * scale)
		edge.set(CFrame.new(ground + UP * 0.3), reach * (0.6 + 0.4 * grow) * shrink)
		for _, beam in edge.beams do
			beam.Transparency = NumberSequence.new(0.55 + 0.25 * (0.5 + 0.5 * math.sin(t * 6)))
		end
		column.Width0 = 2.6 * scale
		column.Width1 = 6 * scale

		if not collapsing and t >= nextDraw then
			nextDraw = t + 0.05
			drawIn(eye, ground, reach * (0.6 + math.random() * 0.4))
		end
	end)

	local galaxy = {}
	function galaxy.collapse()
		if not collapsing then
			collapsing = os.clock()
			Soft.twinkle(eye, 10, STAR, COLLAPSE + 0.05)
			U.flash(eye, STAR_WHITE, 5, COLLAPSE)
		end
	end
	function galaxy.fade()
		if not collapsing then
			collapsing = os.clock()
		end
	end
	return galaxy
end

local function nova(eye: Vector3, ground: Vector3)
	local foot, top = Soft.worldAnchor(ground, UP), Soft.worldAnchor(ground + UP * 46, UP)
	local pillar = {
		Soft.softBeam(foot, top, {
			color = ColorSequence.new(STAR_WHITE),
			width0 = 3.2,
			width1 = 1.2,
			transparency = NumberSequence.new({ key(0, 0.05), key(1, 0.5) }),
		}),
		Soft.softBeam(foot, top, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 8,
			width1 = 3,
			transparency = NumberSequence.new({ key(0, 0.45), key(1, 0.85) }),
		}),
		Soft.softBeam(foot, top, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 13,
			width1 = 5,
			transparency = NumberSequence.new({ key(0, 0.65), key(1, 0.95) }),
			texture = SMOKE,
			speed = -22,
			length = 14,
		}),
	}
	table.insert(pillar, Soft.starStream(foot, top, 2.4, -30))
	local widths = Soft.widths(pillar)
	Soft.every(0.6, function(elapsed)
		local k = if elapsed < 0.06 then 0.2 + 1.1 * elapsed / 0.06 else 1.3 - 0.9 * (elapsed - 0.06) / 0.54
		Soft.scaleBeams(pillar, k, widths)
		return true
	end)
	task.delay(0.15, Soft.fadeBeams, pillar, 0.45, { foot, top })
	local stopSpiral = Soft.helix(function()
		return ground, ground + UP * 40
	end, 3.2, 4, 0.35, 2, 1.1, 0.45, STAR)
	task.delay(0.5, stopSpiral)

	Soft.windRing(ground + UP * 0.4, UP, 2, 22, 0.5)
	Soft.lightRing(ground + UP * 0.3, UP, 1, 18, 0.4, STAR)
	U.shockwave(ground, STAR, 2, 30, 0.45)
	U.groundCracks(ground, 10, 8, STAR, 1.6)
	U.debris(ground, 14, 40, 0.8)

	U.flash(eye, STAR_WHITE, 10, 0.25)
	Soft.twinkle(eye, 16, STAR, 0.4)
	Soft.starDust(eye, 40, 50)
	Soft.streaks(eye, 24, 80, UP, 50)
	Soft.windPuff(eye, 6, UP)
	U.light(eye, STAR, 6, 40, 0.5)
end

function Nova.Handle(ctx: Context, data, character: Model, root: BasePart)
	local phase = data.phase
	local anims = ctx.anims
	if phase == "Form" then
		ctx.play(character, if data.airborne then anims.NovaFormAir else anims.NovaForm)
		local old = forming[character]
		if old then
			old.stop()
		end
		forming[character] = formStar(character)
		Soft.twinkle(root.Position + root.CFrame.LookVector * 1.5 + UP * 1.5, 3, STAR, 0.25)
	elseif phase == "Cancel" then
		local star = forming[character]
		forming[character] = nil
		if star then
			star.stop()
		end
		local current = PoseAnimator.Current(character)
		if current == anims.NovaForm or current == anims.NovaFormAir then
			PoseAnimator.FadeOut(character, 0.15)
		end
	elseif phase == "Throw" then
		ctx.play(
			character,
			if PoseAnimator.Current(character) == anims.NovaFormAir then anims.NovaFlickAir else anims.NovaFlick
		)
		local star = forming[character]
		forming[character] = nil
		if star then
			star.stop()
		end
		if typeof(data.from) == "Vector3" and typeof(data.eye) == "Vector3" then
			throwStar(data.from, data.eye, tonumber(data.flight) or 0.2)
			Soft.windPuff(data.from, 2, (data.eye - data.from).Unit)
		end
	elseif phase == "Open" then
		if typeof(data.eye) ~= "Vector3" or typeof(data.ground) ~= "Vector3" then
			return
		end
		local old = galaxies[character]
		if old then
			old.fade()
		end
		galaxies[character] = openGalaxy(data.eye, data.ground, tonumber(data.reach) or 22)
		Soft.windRing(data.ground + UP * 0.5, UP, 1, 14, 0.35)
		Soft.lightRing(data.ground + UP * 0.4, UP, 0.5, 10, 0.3, STAR)
		Soft.twinkle(data.eye, 8, STAR, 0.3)
	elseif phase == "Nova" then
		local galaxy = galaxies[character]
		galaxies[character] = nil
		if galaxy then
			galaxy.collapse()
		end
		if typeof(data.eye) == "Vector3" and typeof(data.ground) == "Vector3" then
			local eye, ground = data.eye, data.ground
			task.delay(COLLAPSE, nova, eye, ground)
		end
	elseif phase == "Fizzle" then
		local galaxy = galaxies[character]
		galaxies[character] = nil
		if galaxy then
			galaxy.fade()
		end
	end
end

return Nova
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="56">
              <Properties>
                <string name="Name">Saint</string>
                <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SaintPlan = require(ReplicatedStorage:WaitForChild("Shared").SaintZephyr)
local CameraShake = require(script.Parent.Parent.Parent.CameraShake)
local Cinematic = require(script.Parent.Parent.Parent.Cinematic)
local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local Soft = require(script.Parent.Parent.Parent.Soft)

local U = Soft.U
local rad = math.rad
local UP = Vector3.yAxis

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE, SPARKLE = Soft.SMOKE, Soft.SPARKLE
local every, key = Soft.every, Soft.key
local worldAnchor, softBeam, fadeBeams, softRing = Soft.worldAnchor, Soft.softBeam, Soft.fadeBeams, Soft.softRing
local windRing, lightRing, windEmitter, windPuff = Soft.windRing, Soft.lightRing, Soft.windEmitter, Soft.windPuff
local twinkle, starDust, streaks = Soft.twinkle, Soft.starDust, Soft.streaks

type Animation = PoseAnimator.Animation

export type Context = {
	anims: { [string]: Animation },
	play: (Model, Animation) -> (),
	blade: (Model) -> BasePart?,
	hideSword: (Model, number) -> (),
}

local Saint = {}

local SAINT_BLADE = 40
local SHEER = 0.4

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

local function easeOut(u: number): number
	return 1 - (1 - math.clamp(u, 0, 1)) ^ 3
end

local function handOf(character: Model, side: string): Vector3?
	local arm = character:FindFirstChild(side .. " Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.15, 0)).Position else nil
end

local function across(direction: Vector3): (Vector3, Vector3)
	local side = direction:Cross(UP)
	side = if side.Magnitude > 1e-3 then side.Unit else Vector3.xAxis
	return side, side:Cross(direction).Unit
end

local function outline(character: Model?, color: Color3, duration: number)
	if not character then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = color
	highlight.FillTransparency = 0.92
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 1
	highlight.Adornee = character
	highlight.Parent = character
	U.tween(highlight, 0.3, { OutlineTransparency = 0.35 })
	task.delay(duration, function()
		U.tween(highlight, 0.4, { OutlineTransparency = 1, FillTransparency = 1 })
		task.delay(0.45, highlight.Destroy, highlight)
	end)
end

local function groundSigil(center: Vector3, radius: number, duration: number)
	local rings = {
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.45,
			width1 = 0.45,
			transparency = NumberSequence.new(0.15),
		}),
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 1.1,
			width1 = 1.1,
			transparency = NumberSequence.new(0.35),
			texture = SPARKLE,
			wrap = true,
			length = 1.6,
			speed = 2,
		}),
		softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.8,
			width1 = 1.8,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 3,
			length = 5,
		}),
		softRing({
			color = ColorSequence.new(STAR_WHITE),
			width0 = 0.25,
			width1 = 0.25,
			transparency = NumberSequence.new(0.3),
		}),
	}
	local hub = rings[1].hub
	local points: { Attachment } = {}
	for i = 1, 8 do
		local point = Instance.new("Attachment")
		point.Parent = hub
		points[i] = point
	end
	local lines: { Beam } = {}
	for i = 1, 8 do
		table.insert(
			lines,
			softBeam(points[i], points[(i + 2) % 8 + 1], {
				color = ColorSequence.new(STAR_WHITE, STAR),
				width0 = 0.3,
				width1 = 0.3,
				transparency = NumberSequence.new(0.25),
			}, hub)
		)
	end
	local floor = CFrame.new(center + UP * 0.12)
	every(duration, function(elapsed)
		local r = radius * easeOut(elapsed / 0.3) + 0.05
		rings[1].set(floor * CFrame.Angles(0, elapsed * 0.8, 0), r)
		rings[2].set(floor * CFrame.Angles(0, -elapsed * 0.5, 0), r * 1.1)
		rings[3].set(floor * CFrame.Angles(0, elapsed * 1.6, 0), r * 0.62)
		rings[4].set(floor * CFrame.Angles(0, -elapsed * 1.2, 0), r * 0.3)
		for i, point in points do
			local angle = (i - 1) / 8 * math.pi * 2
			point.Position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * r * 0.97
		end
		return true
	end, function()
		fadeBeams(lines, 0.35)
		for _, ring in rings do
			ring.fade(0.45)
		end
	end)
end

local function windColumn(base: Vector3, height: number, radius: number, duration: number)
	U.pillar(base, WIND, radius, height, duration, Enum.Material.ForceField, 0.55)
	local foot, head = worldAnchor(base, UP), worldAnchor(base + UP * height, UP)
	local beams = {
		softBeam(foot, head, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = radius * 2.4,
			width1 = radius * 3.6,
			transparency = NumberSequence.new({ key(0, 0.85), key(0.12, 0.5), key(0.85, 0.6), key(1, 1) }),
			texture = SMOKE,
			speed = 7,
			length = 12,
		}),
		softBeam(foot, head, {
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = radius * 0.5,
			width1 = radius * 0.25,
			transparency = NumberSequence.new({ key(0, 0.6), key(0.1, 0.3), key(0.9, 0.5), key(1, 1) }),
		}),
		softBeam(foot, head, {
			color = ColorSequence.new(WIND, WIND_DEEP),
			width0 = radius * 5,
			width1 = radius * 6,
			transparency = NumberSequence.new({ key(0, 0.95), key(0.2, 0.86), key(1, 1) }),
			texture = SMOKE,
			speed = 3,
			length = 20,
			emission = 0.6,
		}),
	}
	task.delay(duration * 0.55, fadeBeams, beams, duration * 0.45, { foot, head })
	local holder = U.newPart({
		Size = Vector3.new(radius * 2, 1, radius * 2),
		Transparency = 1,
		CFrame = CFrame.new(base),
	})
	local gusts = windEmitter(holder, {
		Size = NumberSequence.new({ key(0, radius * 0.6), key(1, radius * 1.5) }),
		Lifetime = NumberRange.new(0.45, 0.8),
		Speed = NumberRange.new(height * 1.1, height * 1.6),
		SpreadAngle = Vector2.new(6, 6),
		Drag = 1.5,
		EmissionDirection = Enum.NormalId.Top,
		Shape = Enum.ParticleEmitterShape.Disc,
		Rate = 90,
	})
	local rising = windEmitter(holder, {
		Texture = SPARKLE,
		Color = ColorSequence.new(WIND_WHITE),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.35), key(1, 0) }),
		Squash = NumberSequence.new(4),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(height * 1.8, height * 2.4),
		SpreadAngle = Vector2.new(4, 4),
		EmissionDirection = Enum.NormalId.Top,
		Shape = Enum.ParticleEmitterShape.Disc,
		Rate = 70,
	})
	task.delay(duration * 0.75, function()
		gusts.Enabled = false
		rising.Enabled = false
	end)
	task.delay(duration + 1, holder.Destroy, holder)
	Soft.helix(function()
		return base, base + UP * height
	end, radius * 1.4, 4, 0.5, 2.5, 0.9, duration)
	U.burst(base + UP * 0.5, {
		texture = SMOKE,
		color = Color3.fromRGB(196, 204, 194),
		count = 22,
		size = radius * 1.8,
		speed = NumberRange.new(22, 44),
		lifetime = NumberRange.new(0.5, 0.9),
		transparency = 0.5,
		lightEmission = 0,
		drag = 4,
		spread = 85,
		direction = UP,
	})
	windRing(base + UP * 0.3, UP, radius, radius * 5, 0.5)
	lightRing(base + UP * 0.2, UP, radius, radius * 4, 0.4, WIND_WHITE)
	U.groundCracks(base, 8, radius * 3, WIND, 1.2)
	U.groundRocks(base, 8, radius * 2, 1.3)
	U.debris(base, 12, 45, 0.7)
	U.light(base + UP * 4, WIND, 5, 40, duration)
end

type Circle = { update: (number, number) -> (), blowApart: () -> () }

local function skyCircle(center: Vector3, radius: number): Circle
	local rings = {
		outer = softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.5,
			width1 = 0.5,
			transparency = NumberSequence.new(0.25),
		}),
		glitter = softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 1.3,
			width1 = 1.3,
			transparency = NumberSequence.new(0.35),
			texture = SPARKLE,
			wrap = true,
			length = 2,
			speed = 3,
		}),
		wind = softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 2.4,
			width1 = 2.4,
			transparency = NumberSequence.new(0.62),
			texture = SMOKE,
			speed = 3,
			length = 6,
		}),
		inner = softRing({
			color = ColorSequence.new(WIND_WHITE),
			width0 = 0.35,
			width1 = 0.35,
			transparency = NumberSequence.new(0.35),
		}),
		slant = softRing({
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.3,
			width1 = 0.3,
			transparency = NumberSequence.new(0.45),
		}),
		cross = softRing({
			color = ColorSequence.new(WIND_WHITE, STAR),
			width0 = 0.25,
			width1 = 0.25,
			transparency = NumberSequence.new(0.5),
		}),
	}
	local spokes: { { Attachment } } = {}
	for _ = 1, 12 do
		local a0 = Instance.new("Attachment")
		a0.Parent = rings.outer.hub
		local a1 = Instance.new("Attachment")
		a1.Parent = rings.outer.hub
		table.insert(spokes, { a0, a1 })
		softBeam(a0, a1, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.2,
			width1 = 0.05,
			transparency = NumberSequence.new({ key(0, 0.4), key(1, 0.8) }),
		}, rings.outer.hub)
	end
	local current = 0
	local circle = {}
	function circle.update(t: number, open: number)
		local r = radius * open + 0.05
		current = r
		local at = CFrame.new(if open > 0 then center else center + UP * 5000)
		rings.outer.set(at * CFrame.Angles(0, t * 0.6, 0), r)
		rings.glitter.set(at * CFrame.Angles(0, -t * 0.35, 0), r * 1.07)
		rings.wind.set(at * CFrame.Angles(0, -t * 1.1, 0), r * 0.86)
		rings.inner.set(at * CFrame.Angles(0, t * 1.8, 0), r * 0.34)
		rings.slant.set(at * CFrame.Angles(0, t * 0.8, 0) * CFrame.Angles(rad(70), 0, 0), r * 1.05)
		rings.cross.set(at * CFrame.Angles(0, -t * 0.7 + 1.2, 0) * CFrame.Angles(rad(-62), 0, 0), r * 1.12)
		for i, pair in spokes do
			local angle = i / #spokes * math.pi * 2
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			pair[1].Position = out * r * 0.38
			pair[2].Position = out * r * 0.84
		end
	end
	function circle.blowApart()
		local from = current
		local frames: { [string]: CFrame } = {}
		for name, ring in rings do
			frames[name] = ring.hub.CFrame
		end
		every(0.45, function(elapsed)
			local grow = from * (1 + elapsed * 2.5)
			for name, ring in rings do
				ring.set(frames[name], grow * (if name == "inner" then 0.34 else 1))
			end
			return true
		end)
		for _, ring in rings do
			ring.fade(0.45)
		end
	end
	return circle
end

local function wingsOfWind(character: Model, duration: number)
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if not torso then
		return
	end
	type WingFeather = { vane: BasePart, glow: BasePart, side: number, index: number, length: number }
	local feathers: { WingFeather } = {}
	local trails: { Trail } = {}
	local shedding: { ParticleEmitter } = {}
	for side = -1, 1, 2 do
		for i = 1, 7 do
			local length = 5 + i * 0.8
			local vane = Soft.newWedge({
				Size = Vector3.new(0.12, 0.9, length),
				Color = WIND_WHITE,
				Material = Enum.Material.ForceField,
				Transparency = 0.15,
			})
			if i >= 5 then
				table.insert(
					shedding,
					windEmitter(vane, {
						Size = NumberSequence.new({ key(0, 0.8), key(1, 2.4) }),
						Lifetime = NumberRange.new(0.3, 0.6),
						Speed = NumberRange.new(2, 6),
						Drag = 3,
						Rate = 12,
						Enabled = false,
					})
				)
			end
			local glow = U.newPart({ Size = Vector3.new(0.05, 1.9, length + 0.8), Color = WIND, Transparency = 0.82 })
			if i % 2 == 1 then
				table.insert(
					trails,
					Soft.trail(
						glow,
						Vector3.new(0, 0.6, -(length + 0.8) / 2),
						Vector3.new(0, -0.6, -(length + 0.8) / 2),
						{
							color = ColorSequence.new(WIND_WHITE, WIND),
							transparency = NumberSequence.new({ key(0, 0.45), key(1, 1) }),
							lifetime = 0.3,
							off = true,
						}
					)
				)
			end
			table.insert(feathers, { vane = vane, glow = glow, side = side, index = i, length = length })
		end
	end
	every(duration, function(elapsed)
		if not torso.Parent then
			return false
		end
		local open = easeOut(elapsed / 0.3)
		local fold = math.clamp((elapsed - (duration - 0.25)) / 0.25, 0, 1)
		local spread = open * (1 - fold)
		local beat = math.sin(elapsed * 5) * 0.08
		local frame = torso.CFrame
		for _, f in feathers do
			local angle = rad(8 + (f.index - 1) * 15) * spread + beat
			local out = (
				frame.RightVector * f.side * math.cos(angle)
				+ frame.UpVector * math.sin(angle)
				- frame.LookVector * 0.35
			).Unit
			local base = (frame * CFrame.new(f.side * 0.45, 0.8, 0.55)).Position
			local length = f.length * (0.3 + 0.7 * spread)
			local pose = CFrame.lookAt(base, base + out, frame.LookVector) * CFrame.new(0, 0, -length / 2)
			f.vane.Size = Vector3.new(0.12, 0.9, length)
			f.vane.CFrame = pose
			f.glow.Size = Vector3.new(0.05, 1.9, length + 0.8)
			f.glow.CFrame = pose
		end
		for _, trail in trails do
			Soft.beginTrail(trail)
		end
		for _, emitter in shedding do
			emitter.Enabled = true
		end
		return true
	end, function()
		for _, trail in trails do
			Soft.endTrail(trail)
		end
		for _, f in feathers do
			Soft.fadeOut({ f.vane, f.glow }, 0.25)
		end
	end)
end

type Blade = {
	set: (Vector3, Vector3, number) -> (),
	tip: Attachment,
	dissolve: () -> (),
}

local function windBlade(): Blade
	local hub = U.newPart({ Size = Vector3.one, Transparency = 1 })
	local base = Instance.new("Attachment")
	base.Parent = hub
	local point = Instance.new("Attachment")
	point.Parent = hub
	local tipAnchor = worldAnchor(Vector3.zero)
	local layers = {
		softBeam(base, point, {
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 1.4,
			width1 = 0.45,
			transparency = NumberSequence.new({ key(0, 0.45), key(0.12, 0.05), key(0.88, 0.08), key(1, 0.5) }),
		}, hub),
		softBeam(base, point, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 2.8,
			width1 = 1.2,
			transparency = NumberSequence.new({ key(0, 0.75), key(0.2, 0.35), key(1, 0.45) }),
			texture = SPARKLE,
			wrap = true,
			length = 3,
			speed = 8,
		}, hub),
		softBeam(base, point, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 6,
			width1 = 2.5,
			transparency = NumberSequence.new({ key(0, 0.85), key(0.2, 0.5), key(1, 0.72) }),
			texture = SMOKE,
			speed = 3,
			length = 8,
		}, hub),
		softBeam(base, point, {
			color = ColorSequence.new(WIND, WIND_DEEP),
			width0 = 14,
			width1 = 7,
			transparency = NumberSequence.new({ key(0, 0.95), key(0.25, 0.82), key(1, 0.9) }),
			texture = SMOKE,
			speed = -2,
			length = 10,
		}, hub),
	}
	local flow = windEmitter(hub, {
		Size = NumberSequence.new({ key(0, 1.5), key(1, 4) }),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(15, 15),
		EmissionDirection = Enum.NormalId.Front,
		Shape = Enum.ParticleEmitterShape.Box,
		Drag = 2,
		Rate = 60,
	})
	local glitter = windEmitter(hub, {
		Texture = SPARKLE,
		Color = ColorSequence.new(STAR),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.6), key(1, 0) }),
		Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new(2, 6),
		SpreadAngle = Vector2.new(180, 180),
		Shape = Enum.ParticleEmitterShape.Box,
		Rate = 50,
	})
	local light = Instance.new("PointLight")
	light.Color = STAR
	light.Range = 50
	light.Brightness = 5
	light.Parent = hub
	local tip = Soft.softStar(5)
	local last = { from = Vector3.zero, to = Vector3.zero, length = 0 }
	local stopHelix = Soft.helix(function()
		return last.from, last.to
	end, 2.4, 3, 0.45, 3, 0.8, 4, WIND)
	local blade = { tip = tipAnchor }
	function blade.set(from: Vector3, direction: Vector3, length: number)
		local to = from + direction * length
		last.from, last.to, last.length = from, to, length
		hub.Size = Vector3.new(2, 2, math.max(length, 0.2))
		hub.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
		base.CFrame = CFrame.new(0, 0, length / 2)
		point.CFrame = CFrame.new(0, 0, -length / 2)
		tip.place(to, os.clock() * 6)
		tipAnchor.CFrame = CFrame.new(to)
	end
	function blade.dissolve()
		flow.Enabled = false
		glitter.Enabled = false
		light.Enabled = false
		stopHelix()
		for i = 1, 8 do
			windPuff(last.from:Lerp(last.to, i / 8), 2.5)
		end
		starDust(last.to, 16, 30)
		tip.fade(0.25)
		fadeBeams(layers, 0.3, { hub, tipAnchor })
	end
	return blade
end

local function windSeam(top: Vector3, ground: Vector3)
	local direction = (ground - top).Unit
	local from, to = top - direction * 90, ground + direction * 2
	local a = worldAnchor(from, direction)
	local b = worldAnchor(to, direction)
	local beams = {
		softBeam(a, b, {
			color = ColorSequence.new(STAR_WHITE),
			width0 = 1.3,
			width1 = 1.3,
			transparency = NumberSequence.new({ key(0, 0.7), key(0.2, 0.05), key(1, 0.05) }),
		}),
		softBeam(a, b, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 3,
			width1 = 2.4,
			transparency = NumberSequence.new({ key(0, 0.8), key(0.25, 0.3), key(1, 0.35) }),
			texture = SPARKLE,
			wrap = true,
			length = 4,
			speed = -20,
		}),
		softBeam(a, b, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 9,
			width1 = 7,
			transparency = NumberSequence.new({ key(0, 0.9), key(0.25, 0.5), key(1, 0.55) }),
			texture = SMOKE,
			speed = 8,
			length = 20,
		}),
		softBeam(a, b, {
			color = ColorSequence.new(WIND, WIND_DEEP),
			width0 = 40,
			width1 = 30,
			transparency = NumberSequence.new({ key(0, 0.96), key(0.3, 0.86), key(1, 0.88) }),
			texture = SMOKE,
			speed = 4,
			length = 30,
		}),
	}
	for i = 0, 8 do
		windPuff(from:Lerp(to, 0.35 + 0.65 * i / 8), 4, -direction)
	end
	task.delay(0.35, function()
		for _, beam in beams do
			U.tween(beam, 0.5, { Width0 = beam.Width0 * 0.05, Width1 = beam.Width1 * 0.05 })
		end
		fadeBeams(beams, 0.55, { a, b })
	end)
end

local function featherFall(center: Vector3, count: number, duration: number)
	for i = 1, count do
		local feather = Soft.newWedge({
			Size = Vector3.new(0.05, 0.3, 1),
			Color = WIND_WHITE,
			Material = Enum.Material.ForceField,
			Transparency = 1,
		})
		U.tween(feather, 0.3, { Transparency = Soft.sheerValue(0.2) })
		local from = center + Vector3.new(math.random(-70, 70) / 10, 5 + math.random() * 7, math.random(-70, 70) / 10)
		local life = duration * (0.7 + math.random() * 0.3)
		every(life, function(elapsed)
			local drift =
				Vector3.new(math.sin(elapsed * 2.6 + i) * 1.3, -elapsed * 2.4, math.cos(elapsed * 2 + i) * 0.8)
			feather.CFrame = CFrame.new(from + drift)
				* CFrame.Angles(elapsed * 1.5 + i, elapsed * 2.5, math.sin(elapsed * 4 + i) * 0.7)
			return true
		end, function()
			Soft.fadeOut({ feather }, 0.3)
		end)
	end
end

local function starfall(center: Vector3, radius: number, duration: number)
	local sky = U.newPart({
		Size = Vector3.new(radius * 2, 1, radius * 2),
		Transparency = 1,
		CFrame = CFrame.new(center + UP * 16),
	})
	local motes = windEmitter(sky, {
		Texture = SPARKLE,
		Color = ColorSequence.new(STAR_WHITE, STAR),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 1), key(0.15, 0.2), key(0.8, 0.4), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.35), key(0.5, 0.55), key(1, 0) }),
		Lifetime = NumberRange.new(1.4, 2.2),
		Speed = NumberRange.new(5, 9),
		SpreadAngle = Vector2.new(12, 12),
		EmissionDirection = Enum.NormalId.Bottom,
		Shape = Enum.ParticleEmitterShape.Box,
		Drag = 0.5,
		Rate = 45,
	})
	task.delay(duration, function()
		motes.Enabled = false
	end)
	task.delay(duration + 2.5, sky.Destroy, sky)
end

export type ZephyrSky = {
	update: (number) -> (),
	gather: () -> (),
	flare: () -> (),
	scatter: () -> (),
	close: (number) -> (),
}

local SKY_GOLD = Color3.fromRGB(255, 214, 140)
local SKY_SUN = Color3.fromRGB(255, 240, 200)

local function zephyrSky(plan: SaintPlan.Plan): ZephyrSky
	local center = plan.center
	local made: { Instance } = {}
	local beams: { { beam: Beam, base: number } } = {}
	local function track(beam: Beam, base: number): Beam
		table.insert(beams, { beam = beam, base = base })
		table.insert(made, beam)
		beam.Transparency = NumberSequence.new(1)
		return beam
	end
	local function anchor(position: Vector3, axis: Vector3?): Attachment
		local attachment = worldAnchor(position, axis)
		table.insert(made, attachment)
		return attachment
	end

	local toSun = Cinematic.DawnSun()
	toSun = Vector3.new(toSun.X, math.max(toSun.Y, 0.1), toSun.Z).Unit
	local sun = center + toSun * 420
	local halos: { { part: BasePart, base: number } } = {}
	for i, layer in { { 46, 0.5, SKY_SUN }, { 110, 0.76, SKY_GOLD }, { 210, 0.9, SKY_GOLD } } do
		local part = U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, layer[1], layer[1]),
			CFrame = CFrame.lookAt(sun - toSun * i, center) * CFrame.Angles(0, rad(90), 0),
			Color = layer[3],
			Transparency = 1,
		})
		table.insert(made, part)
		table.insert(halos, { part = part, base = layer[2] })
	end
	local sunAnchor = anchor(sun)
	local sunUp = (UP - toSun * toSun.Y).Unit
	local sunSide = toSun:Cross(sunUp).Unit
	for i = 1, 9 do
		local angle = rad(-80 + (i - 1) * 20)
		local out = sunUp * math.cos(angle) + sunSide * math.sin(angle)
		track(
			softBeam(sunAnchor, anchor(sun + out * 360 - toSun * 60), {
				color = ColorSequence.new(SKY_SUN, SKY_GOLD),
				width0 = 26,
				width1 = 90,
				transparency = NumberSequence.new(0),
				emission = 1,
			}),
			0.92
		)
	end

	type Twinkle = { part: BasePart, phase: number, speed: number }
	local stars: { Twinkle } = {}
	for i = 1, 140 do
		local direction
		repeat
			direction = U.randomUnit()
		until direction.Y > 0.12
		local part = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (1 + math.random() * 1.8),
			CFrame = CFrame.new(center + direction * (280 + math.random() * 40)),
			Color = if i % 4 == 0 then STAR else STAR_WHITE,
			Transparency = 1,
		})
		table.insert(made, part)
		table.insert(stars, { part = part, phase = math.random() * 6.28, speed = 2 + math.random() * 4 })
	end

	for i = 1, 6 do
		local angle = rad(i * 60 + math.random() * 20)
		local across = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local side = across:Cross(UP)
		local height = UP * (36 + i * 8)
		local from = center + height - across * 260 + side * (i * 14 - 50)
		local to = center + height + across * 260 + side * (i * 14 - 50)
		track(
			softBeam(anchor(from, across + UP * 0.15), anchor(to, across - UP * 0.15), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 14,
				width1 = 14,
				transparency = NumberSequence.new(0),
				texture = SMOKE,
				speed = 18 + i * 3,
				length = 60,
				curve0 = 40,
				curve1 = 40,
			}),
			0.88
		)
	end

	local eye = center + UP * 92
	type Swirl = { ring: Soft.Ring, radius: number, height: number, speed: number, tilt: number }
	local swirls: { Swirl } = {}
	for i, radius in { 34, 62, 95, 132, 175 } do
		local ring = softRing({
			color = ColorSequence.new(WIND_WHITE, if i % 2 == 0 then WIND else WIND_DEEP),
			width0 = 6 + i * 3,
			width1 = 6 + i * 3,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 6,
			length = 30,
			segments = 24,
		})
		table.insert(made, ring.hub)
		for _, beam in ring.beams do
			track(beam, 0.7 + i * 0.04)
		end
		table.insert(
			swirls,
			{ ring = ring, radius = radius, height = -i * 7, speed = 0.5 - i * 0.07, tilt = (i % 2) * 4 - 2 }
		)
	end
	type Arm = { from: Attachment, to: Attachment, beam: Beam, phase: number }
	local arms: { Arm } = {}
	for i = 1, 6 do
		local from, to = anchor(eye), anchor(eye)
		local beam = softBeam(from, to, {
			color = ColorSequence.new(WIND, WIND_WHITE),
			width0 = 22,
			width1 = 5,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 10,
			length = 40,
			segments = 20,
		})
		track(beam, 0.76)
		table.insert(arms, { from = from, to = to, beam = beam, phase = (i - 1) * math.pi / 3 })
	end

	local star = Soft.softStar(30)
	for _, part in star.parts do
		table.insert(made, part)
		part.Transparency = 1
	end
	local starLight = star.parts[1]:FindFirstChildOfClass("PointLight")
	if starLight then
		starLight.Enabled = false
	end
	local eyeAnchor = anchor(eye)
	local fall: { Beam } = {}
	for i = 1, 6 do
		local angle = (i - 1) * math.pi / 3
		local foot = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 16 - UP * 6
		table.insert(
			fall,
			track(
				softBeam(eyeAnchor, anchor(foot), {
					color = ColorSequence.new(SKY_SUN, STAR),
					width0 = 16,
					width1 = 4,
					transparency = NumberSequence.new(0),
					emission = 1,
				}),
				0.94
			)
		)
	end

	local shown = 0
	local target = 0
	local scale, scaleTarget = 1, 1
	local spin, spinTarget = 1, 1
	local spread, spreadTarget = 1, 1
	local sky = {} :: ZephyrSky
	function sky.update(t: number)
		shown += (target - shown) * 0.08
		scale += (scaleTarget - scale) * 0.12
		spin += (spinTarget - spin) * 0.05
		spread += (spreadTarget - spread) * 0.06
		local a = smooth(shown)
		for _, entry in beams do
			entry.beam.Transparency = NumberSequence.new(1 - (1 - entry.base) * a)
		end
		for _, halo in halos do
			halo.part.Transparency = 1 - (1 - halo.base) * a
		end
		for _, twinkle_ in stars do
			local glint = 0.5 + 0.5 * math.sin(t * twinkle_.speed + twinkle_.phase)
			twinkle_.part.Transparency = 1 - a * (0.25 + 0.45 * glint)
		end
		for _, swirl in swirls do
			swirl.ring.set(
				CFrame.new(eye + UP * swirl.height) * CFrame.Angles(rad(swirl.tilt), t * swirl.speed * spin, 0),
				swirl.radius * spread
			)
		end
		for _, arm in arms do
			local angle = arm.phase + t * 0.35 * spin
			local outer = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local inner = Vector3.new(math.cos(angle + 1.6), 0, math.sin(angle + 1.6))
			local outerAt = eye + outer * 160 * spread - UP * 30
			local innerAt = eye + inner * 22 * spread
			Soft.aim(arm.from, outerAt, Vector3.new(-outer.Z, 0, outer.X))
			Soft.aim(arm.to, innerAt, Vector3.new(-inner.Z, 0, inner.X))
			arm.beam.CurveSize0 = 70 * spread
			arm.beam.CurveSize1 = 18 * spread
		end
		star.place(eye, t * 0.6)
		local glow = a * (0.25 + 0.15 * math.sin(t * 3))
		for i, part in star.parts do
			part.Transparency = if i == 1 then 1 - 0.6 * a * math.min(scale, 1) else 1 - glow * 1.6 * math.min(scale, 1)
			if i == 1 then
				part.Size = Vector3.one * 30 * 0.32 * math.max(scale, 0.05)
			end
		end
	end
	function sky.gather()
		scaleTarget, spinTarget = 1.8, 2.2
	end
	function sky.flare()
		scale, scaleTarget = 2.8, 2.2
		for _, beam in fall do
			beam.Width0, beam.Width1 = 30, 10
			U.tween(beam, 0.5, { Width0 = 16, Width1 = 4 })
		end
		twinkle(eye, 60, STAR, 0.45)
		U.flash(eye, SKY_SUN, 40, 0.3)
	end
	function sky.scatter()
		spinTarget, spreadTarget, scaleTarget = 3, 1.6, 0
	end
	local born = os.clock()
	local connection = RunService.RenderStepped:Connect(function()
		sky.update(os.clock() - born)
	end)
	function sky.close(duration: number)
		target = 0
		task.delay(duration + 0.6, function()
			connection:Disconnect()
			for _, instance in made do
				instance:Destroy()
			end
		end)
	end
	sky.update(0)
	target = 1
	return sky
end

export type Spirit = { raise: () -> (), dissolve: (BasePart) -> (), close: () -> () }

local SPIRIT_HEIGHT = 84

local function sylphSpirit(plan: SaintPlan.Plan): Spirit
	local made: { Instance } = {}
	local H = SPIRIT_HEIGHT
	type Limb = { a: Attachment, b: Attachment, beam: Beam, base: number, curve: number }
	local limbs: { [string]: Limb } = {}
	local function limb(name: string, style: Soft.BeamStyle, base: number, curve: number?)
		local a, b = worldAnchor(plan.center), worldAnchor(plan.center)
		local beam = softBeam(a, b, style)
		beam.Transparency = NumberSequence.new(1)
		table.insert(made, a)
		table.insert(made, b)
		table.insert(made, beam)
		limbs[name] = { a = a, b = b, beam = beam, base = base, curve = curve or 0 }
	end
	local wind = ColorSequence.new(WIND_WHITE, WIND)
	limb("body", {
		color = ColorSequence.new(WIND_WHITE),
		width0 = 0.09 * H,
		width1 = 0.14 * H,
		transparency = NumberSequence.new(0),
	}, 0.82)
	limb("head", {
		color = ColorSequence.new(WIND_WHITE),
		width0 = 0.1 * H,
		width1 = 0.085 * H,
		transparency = NumberSequence.new(0),
	}, 0.76)
	limb("dress", {
		color = wind,
		width0 = 0.17 * H,
		width1 = 0.02 * H,
		transparency = NumberSequence.new(0),
		texture = SMOKE,
		speed = -8,
		length = 30,
	}, 0.86, 0.25)
	for _, side in { "L", "R" } do
		limb("arm" .. side, {
			color = ColorSequence.new(WIND_WHITE),
			width0 = 0.035 * H,
			width1 = 0.022 * H,
			transparency = NumberSequence.new(0),
		}, 0.84, 0.1)
		limb("wingHigh" .. side, {
			color = wind,
			width0 = 0.2 * H,
			width1 = 0.05 * H,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 5,
			length = 26,
		}, 0.9, 0.18)
		limb("wingLow" .. side, {
			color = wind,
			width0 = 0.16 * H,
			width1 = 0.03 * H,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 5,
			length = 26,
		}, 0.92, 0.15)
	end
	for i = 1, 3 do
		limb("hair" .. i, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 0.07 * H,
			width1 = 0.006 * H,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 6 + i,
			length = 18,
		}, 0.82, 0.14)
	end
	local halo = softRing({
		color = ColorSequence.new(STAR_WHITE, STAR),
		width0 = 0.012 * H,
		width1 = 0.012 * H,
		transparency = NumberSequence.new(0.2),
	})
	table.insert(made, halo.hub)
	local core = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(plan.center) })
	table.insert(made, core)
	local glow = Soft.glow(core, WIND_WHITE, 0.3 * H, 0.88)

	local shown, target = 0, 1
	local raise, raiseTarget = 0, 0
	local shrink = 0
	local into: BasePart? = nil
	local born = os.clock()
	local function place(t: number)
		local camera = workspace.CurrentCamera.CFrame.Position
		local toward = Vector3.new(plan.center.X - camera.X, 0, plan.center.Z - camera.Z)
		toward = if toward.Magnitude > 1 then toward.Unit else plan.forward
		local heart = plan.center + toward * 150 + UP * (34 + math.sin(t * 1.2) * 1.5)
		local look = (heart - camera).Unit
		local r = look:Cross(UP).Unit
		local u = r:Cross(look).Unit
		local size = H * (1 - 0.9 * shrink)
		if into and shrink > 0 then
			heart = heart:Lerp(into.Position + UP * 3, shrink * shrink)
		end
		local function at(x: number, y: number): Vector3
			return heart + (r * x + u * y) * size
		end
		local function pose(name: string, from: Vector3, to: Vector3, axisFrom: Vector3?, axisTo: Vector3?)
			local limb_ = limbs[name]
			Soft.aim(limb_.a, from, axisFrom or (to - from))
			Soft.aim(limb_.b, to, axisTo or (to - from))
			limb_.beam.CurveSize0 = limb_.curve * size
			limb_.beam.CurveSize1 = -limb_.curve * size * 0.5
		end
		local sway = math.sin(t * 1.7) * 0.02
		pose("body", at(0, 0.25), at(0.01, -0.14))
		pose("head", at(0, 0.285), at(0, 0.375))
		pose("dress", at(0.01, -0.12), at(0.16 + sway * 3, -0.66), -u, (-u + r * 0.6).Unit)
		for i, side in { "L", "R" } do
			local s = if i == 1 then -1 else 1
			local open = Vector3.new(s * 0.4, 0.3 + sway, 0)
			local up = Vector3.new(s * 0.15, 0.58, 0)
			local hand = open:Lerp(up, smooth(raise))
			pose("arm" .. side, at(s * 0.07, 0.22), at(hand.X, hand.Y), r * s + u * 0.4, u)
			local beat = math.sin(t * 1.4) * 0.04
			pose("wingHigh" .. side, at(s * 0.04, 0.18), at(s * 0.56, 0.64 + beat), r * s + u * 1.6, r * s + u * 0.4)
			pose("wingLow" .. side, at(s * 0.04, 0.1), at(s * 0.46, -0.16 + beat * 0.6), r * s - u * 0.2, r * s - u)
		end
		for i = 1, 3 do
			local wave = math.sin(t * 2.2 + i) * 0.03
			local tip = ({ Vector3.new(-0.4, 0.26), Vector3.new(-0.46, 0.36), Vector3.new(-0.34, 0.14) })[i]
			pose("hair" .. i, at(0, 0.37), at(tip.X, tip.Y + wave), -r + u * 0.3, -r - u * 0.2)
		end
		halo.set(CFrame.fromMatrix(at(0, 0.43), r, -look), 0.08 * size)
		core.CFrame = CFrame.new(at(0, 0.08))
		local a = smooth(shown) * (1 - shrink)
		for _, limb_ in limbs do
			limb_.beam.Transparency =
				NumberSequence.new({ key(0, 1 - (1 - limb_.base) * a), key(1, 1 - (1 - limb_.base) * a * 0.6) })
		end
		for _, beam in halo.beams do
			beam.Transparency = NumberSequence.new(1 - 0.5 * a)
		end
		glow.Enabled = a > 0.05
	end
	local connection = RunService.RenderStepped:Connect(function()
		shown += (target - shown) * 0.06
		raise += (raiseTarget - raise) * 0.1
		place(os.clock() - born)
	end)
	local closed = false
	local spirit = {} :: Spirit
	function spirit.raise()
		raiseTarget = 1
	end
	function spirit.dissolve(root: BasePart)
		into = root
		every(0.45, function(elapsed)
			shrink = smooth(elapsed / 0.45)
			return true
		end, function()
			shrink = 1
			spirit.close()
		end)
		windPuff(root.Position + UP * 3, 6)
		twinkle(root.Position + UP * 3, 10, STAR, 0.3)
	end
	function spirit.close()
		if closed then
			return
		end
		closed = true
		target = 0
		task.delay(0.8, function()
			connection:Disconnect()
			glow.Enabled = false
			for _, instance in made do
				instance:Destroy()
			end
		end)
	end
	place(0)
	return spirit
end

local function play(data, character: Model, root: BasePart, context: Context)
	local anims = context.anims
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = SaintPlan.Plan(data.origin, data.start, data.floorY)
	local times = SaintPlan.Times
	local cuts = times.Cuts
	local dive, landed = SaintPlan.DiveTimes()
	local started = os.clock()
	local mine = U.isLocal(character) or U.isLocal(target)
	local near = (workspace.CurrentCamera.CFrame.Position - plan.center).Magnitude < 120
	local forward, right = plan.forward, plan.right
	local center = plan.center
	local charge = cuts[1] - SaintPlan.Charge
	local passes = table.clone(cuts)
	table.insert(passes, times.Cross)

	PoseAnimator.SettleLift(character, times.Length)

	local unsheer = Soft.sheer(SHEER)
	task.delay(times.Length + 0.3, unsheer)

	outline(character, WIND_WHITE, times.Length)
	outline(target, STAR, times.Land)

	local nearby = mine or (workspace.CurrentCamera.CFrame.Position - plan.center).Magnitude < 180
	local sky: ZephyrSky? = nil
	local spirit: Spirit? = nil
	if nearby then
		task.delay(times.Lift - 0.35, function()
			local lift = Cinematic.Dawn(0.9)
			local opened = zephyrSky(plan)
			sky = opened
			task.delay(0.6, function()
				spirit = sylphSpirit(plan)
			end)
			task.delay(times.Land + 0.6 - (times.Lift - 0.35), function()
				opened.close(1.2)
				lift(1.4)
			end)
		end)
	end
	local bloom: BloomEffect? = nil
	local depth: DepthOfFieldEffect? = nil
	if mine or near then
		local effect = Instance.new("BloomEffect")
		effect.Intensity = 0
		effect.Size = 28
		effect.Threshold = 0.9
		effect.Parent = workspace.CurrentCamera
		U.tween(effect, 0.4, { Intensity = 0.6 })
		bloom = effect
	end
	if mine then
		local effect = Instance.new("DepthOfFieldEffect")
		effect.FarIntensity = 0.3
		effect.NearIntensity = 0.1
		effect.InFocusRadius = 16
		effect.FocusDistance = 20
		effect.Parent = workspace.CurrentCamera
		depth = effect
	end
	task.delay(times.Length + 0.2, function()
		for _, effect in { bloom, depth } :: { PostEffect? } do
			if effect then
				U.tween(
					effect,
					0.4,
					if effect:IsA("BloomEffect") then { Intensity = 0 } else { FarIntensity = 0, NearIntensity = 0 }
				)
				task.delay(0.45, effect.Destroy, effect)
			end
		end
	end)
	local function punch(intensity: number, decay: number)
		if bloom then
			bloom.Intensity = intensity
			U.tween(bloom, decay, { Intensity = 0.6 })
		end
	end

	local seal = Soft.softStar(3)
	local bindRings = {
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.4,
			width1 = 0.4,
			transparency = NumberSequence.new(0.3),
		}),
		softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.2,
			width1 = 1.2,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 3,
			length = 4,
		}),
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.7,
			width1 = 0.7,
			transparency = NumberSequence.new(0.45),
			texture = SPARKLE,
			wrap = true,
			length = 1.2,
			speed = 2,
		}),
	}
	local shackles: { Soft.Star } = {}
	for _ = 1, 3 do
		table.insert(shackles, Soft.softStar(0.9))
	end
	local swirlHolder = U.newPart({ Size = Vector3.one * 9, Transparency = 1, CFrame = CFrame.new(center) })
	local swirl = windEmitter(swirlHolder, {
		Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.85), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 3), key(1, 8) }),
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(3, 8),
		SpreadAngle = Vector2.new(180, 180),
		Shape = Enum.ParticleEmitterShape.Sphere,
		Drag = 1,
		Rate = 0,
	})

	local stars: { Soft.Star } = {}
	local starAnchors: { Attachment } = {}
	local lines: { Beam } = {}
	for _ = 1, #plan.stars do
		table.insert(stars, Soft.softStar(2.4))
		table.insert(starAnchors, worldAnchor(center))
	end
	for i = 1, #plan.stars do
		local a, b = starAnchors[i], starAnchors[i % #plan.stars + 1]
		local stream = Soft.starStream(a, b, 0.55, 3)
		local thread = softBeam(a, b, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.12,
			width1 = 0.12,
			transparency = NumberSequence.new({ key(0, 0.3), key(0.5, 0.6), key(1, 0.3) }),
		})
		stream.Enabled = false
		thread.Enabled = false
		table.insert(lines, stream)
		table.insert(lines, thread)
	end
	local homeStar = Soft.softStar(1.8)
	local circle = skyCircle(center, SaintPlan.Ring + 3)
	local slashes: { Soft.Slash } = {}
	local blade: Blade? = nil
	local tailTop = worldAnchor(center, UP)
	local tailEnd = worldAnchor(center, UP)
	local tail = {
		softBeam(tailEnd, tailTop, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 1.6,
			width1 = 0.2,
			transparency = NumberSequence.new({ key(0, 0.1), key(1, 1) }),
		}),
		softBeam(tailEnd, tailTop, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 5,
			width1 = 1,
			transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
			texture = SMOKE,
			speed = -6,
			length = 10,
		}),
		softBeam(tailEnd, tailTop, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 2.6,
			width1 = 0.6,
			transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
			texture = SPARKLE,
			wrap = true,
			length = 2.5,
			speed = -10,
		}),
	}
	for _, beam in tail do
		beam.Enabled = false
	end
	local burst = false

	local swordBlade = context.blade(character)
	local gathering: { Beam } = {}
	local gatherExtra: { Instance } = {}

	local bind = "CloverSaintZephyr" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > times.Length + 0.1 then
			finish()
			return
		end
		if root.Parent then
			root.CFrame = SaintPlan.Attacker(plan, t)
		end
		local victim = SaintPlan.Victim(plan, math.min(t, times.Land))
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = victim
		end

		if not burst then
			local at = victim.Position
			seal.place(at + victim.LookVector * 0.9 + UP * 0.4, t * 4)
			local grow = easeOut(t / 0.25)
			bindRings[1].set(CFrame.new(at + UP * 0.9) * CFrame.Angles(0, t * 3, 0), 2.6 * grow + 0.05)
			bindRings[2].set(CFrame.new(at - UP * 0.5) * CFrame.Angles(0, -t * 4, 0), 3 * grow + 0.05)
			bindRings[3].set(
				CFrame.new(at) * CFrame.Angles(0, t * 2, 0) * CFrame.Angles(rad(64), 0, 0),
				3.4 * grow + 0.05
			)
			for i, shackle in shackles do
				local angle = t * 3 + (i - 1) * math.pi * 2 / 3
				local ring = bindRings[1].hub.CFrame
				shackle.place(
					(ring * CFrame.new(math.cos(angle) * 2.6 * grow, 0, math.sin(angle) * 2.6 * grow)).Position,
					t * 6
				)
			end
			local placed: { Vector3 } = {}
			local opened: { boolean } = {}
			for i, star in stars do
				local open = math.clamp((t - times.Lift - i * 0.025) / 0.2, 0, 1)
				opened[i] = open > 0
				placed[i] = if open > 0 then center:Lerp(plan.stars[i], easeOut(open)) else center + UP * 5000
				star.place(placed[i], t * 2 + i)
				starAnchors[i].CFrame = CFrame.new(placed[i])
			end
			for i = 1, #stars do
				local shown = opened[i] and opened[i % #stars + 1]
				lines[i * 2 - 1].Enabled = shown
				lines[i * 2].Enabled = shown
			end
			circle.update(t, easeOut((t - times.Lift) / 0.35))
			local home = if t < times.Hover - 0.1 then center + UP * 5000 else plan.hover - UP * 1.2
			homeStar.place(home, t * 3)
		end

		if blade then
			local hand, other = handOf(character, "Right"), handOf(character, "Left")
			local hands = if hand and other then hand:Lerp(other, 0.5) else root.Position + UP * 2.5
			local grow = easeOut((t - (times.Rise - 0.1)) / 0.35)
			local down = (plan.ground - (plan.top + UP * SaintPlan.Drift)).Unit
			local swing = smooth((t - dive) / 0.1)
			local arc = math.acos(math.clamp(UP:Dot(down), -1, 1))
			local direction = CFrame.fromAxisAngle(right, swing * arc):VectorToWorldSpace(UP)
			blade.set(hands, direction, SAINT_BLADE * grow + 0.5)
		end

		if t >= times.Burst and t <= times.Land then
			local length = 4 + 26 * math.clamp((t - times.Burst) / (times.Land - times.Burst), 0, 1)
			tailEnd.CFrame = CFrame.new(victim.Position)
			tailTop.CFrame = CFrame.new(victim.Position + UP * length)
			for _, beam in tail do
				beam.Enabled = true
			end
		end
	end)

	twinkle(plan.start + UP, 9, STAR, 0.35)
	U.flash(plan.start + UP, STAR_WHITE, 4, 0.15)
	lightRing(plan.start + UP, UP, 0.5, 7, 0.35)
	lightRing(plan.start + UP, forward, 0.5, 5, 0.3)
	starDust(plan.start + UP, 18, 26)
	windPuff(plan.start + UP, 4)
	local ground = Vector3.new(plan.start.X, plan.floorY, plan.start.Z)
	groundSigil(ground, 7, times.Lift + 0.5)
	windColumn(ground, SaintPlan.Height + 14, 3.4, times.Lift + 0.5)
	if targetRoot then
		U.spiral(targetRoot, WIND_WHITE, 4, 5, times.Lift, 4, 0.6, 0.3)
	end
	task.delay(0.25, function()
		context.play(character, anims.SaintAscend)
		windPuff(root.Position - UP * 2.5, 3, UP)
		U.spiral(root, WIND, 3, 4, times.Lift, 3, 0.5, 0.3)
		U.bodyTrail(character, WIND, times.Lift)
	end)
	if mine then
		CameraShake.FovKick(4)
	end

	task.delay(times.Lift, function()
		local below = U.newPart({
			Size = Vector3.new(28, 1, 28),
			Transparency = 1,
			CFrame = CFrame.new(ground + UP * 0.5),
		})
		local stir = windEmitter(below, {
			Color = ColorSequence.new(Color3.fromRGB(205, 214, 204), Color3.fromRGB(170, 190, 175)),
			LightEmission = 0,
			Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.82), key(1, 1) }),
			Size = NumberSequence.new({ key(0, 3), key(1, 7) }),
			Lifetime = NumberRange.new(1.2, 1.8),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(60, 60),
			EmissionDirection = Enum.NormalId.Top,
			Shape = Enum.ParticleEmitterShape.Disc,
			Rate = 14,
		})
		task.delay(times.Burst - times.Lift, function()
			stir.Enabled = false
		end)
		task.delay(times.Burst - times.Lift + 2, below.Destroy, below)
	end)

	task.delay(times.Lift, function()
		swirl.Rate = 22
		windRing(center, UP, 2, SaintPlan.Ring + 6, 0.5)
		lightRing(center, UP, 1, SaintPlan.Ring + 4, 0.45)
		U.shockwave(center, WIND, 2, SaintPlan.Ring * 2.4, 0.5)
		U.light(center, STAR, 6, 70, times.Burst - times.Lift)
		for i, at in plan.stars do
			task.delay(i * 0.025 + 0.15, function()
				twinkle(at, 4, STAR, 0.3)
				lightRing(at, (center - at).Unit, 0.3, 3.5, 0.3)
				local from, into = worldAnchor(at), worldAnchor(center)
				local ray = softBeam(from, into, {
					color = ColorSequence.new(STAR_WHITE, STAR),
					width0 = 0.9,
					width1 = 0.15,
					transparency = NumberSequence.new({ key(0, 0.3), key(1, 0.8) }),
				})
				fadeBeams({ ray }, 0.4, { from, into })
			end)
		end
	end)
	task.delay(times.Hover - 0.1, function()
		context.play(character, anims.SaintPoise)
	end)
	task.delay(times.Hover - 0.05, function()
		twinkle(plan.hover - UP * 1.2, 3, STAR, 0.3)
		windRing(plan.hover - UP * 1.4, UP, 0.5, 4, 0.35)
	end)

	local torso = character:FindFirstChild("Torso") :: BasePart?
	task.delay(charge, function()
		windPuff(plan.hover, 3, -plan.passes[1])
		windRing(plan.hover, plan.passes[1], 1, 6, 0.3)
		U.afterimage(character, WIND, 0.4)
		twinkle(plan.hover - UP * 1.2, 4, STAR, 0.25)
		if not torso then
			return
		end
		local dance = times.Rise - charge
		local trails = {
			Soft.trail(torso, Vector3.new(0, 1.7, 0), Vector3.new(0, -1.7, 0), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.4), key(0.4, 0.65), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.35) }),
				lifetime = 0.75,
				texture = SMOKE,
			}),
			Soft.trail(torso, Vector3.new(0, 0.3, 0), Vector3.new(0, -0.3, 0), {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				transparency = NumberSequence.new({ key(0, 0.1), key(1, 1) }),
				lifetime = 0.22,
			}),
		}
		local aura = Soft.glow(torso, WIND, 5, 0.9)
		local lamp = Instance.new("PointLight")
		lamp.Color = WIND
		lamp.Range = 18
		lamp.Brightness = 3
		lamp.Shadows = false
		lamp.Parent = torso
		local dust = windEmitter(torso, {
			Texture = SPARKLE,
			Color = ColorSequence.new(STAR_WHITE, STAR),
			LightEmission = 1,
			Transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
			Size = NumberSequence.new({ key(0, 0.45), key(1, 0) }),
			Lifetime = NumberRange.new(0.3, 0.6),
			Speed = NumberRange.new(0.5, 2),
			SpreadAngle = Vector2.new(180, 180),
			Rate = 60,
		})
		local swordTrails: { Trail } = {}
		local swordGlitter: ParticleEmitter? = nil
		if swordBlade then
			table.insert(
				swordTrails,
				Soft.trail(swordBlade, Vector3.new(0, -2.6, 0), Vector3.new(0, 2.7, 0), {
					color = ColorSequence.new(WIND_WHITE, WIND),
					transparency = NumberSequence.new({ key(0, 0.1), key(1, 1) }),
					lifetime = 0.22,
					faceCamera = false,
				})
			)
			swordGlitter = windEmitter(swordBlade, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, STAR),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
				Size = NumberSequence.new({ key(0, 0.4), key(1, 0) }),
				Lifetime = NumberRange.new(0.2, 0.4),
				Speed = NumberRange.new(0),
				Shape = Enum.ParticleEmitterShape.Box,
				Rate = 70,
			})
		end
		task.delay(dance, function()
			for _, trail in trails do
				Soft.endTrail(trail)
			end
			for _, trail in swordTrails do
				Soft.endTrail(trail)
			end
			aura.Enabled = false
			dust.Enabled = false
			U.tween(lamp, 0.3, { Brightness = 0 })
			task.delay(0.35, lamp.Destroy, lamp)
			task.delay(1, aura.Destroy, aura)
			task.delay(1, dust.Destroy, dust)
			if swordGlitter then
				swordGlitter.Enabled = false
				task.delay(0.6, swordGlitter.Destroy, swordGlitter)
			end
		end)
	end)

	for i, at in passes do
		local direction = plan.passes[i]
		local last = i == #passes
		local swing = if last or i % 2 == 1 then anims.SaintCut else anims.SaintCutBack
		task.delay(math.max(at - 0.05, 0), function()
			context.play(character, swing)
		end)
		local side, lift = across(direction)
		local scale = if last then 1.5 else 0.68 + i * 0.04
		local reach = if last then 13 else 10
		task.delay(math.max(at - 0.025, 0), function()
			if burst then
				return
			end
			local bend = (if i % 2 == 1 then lift else side) * (2.4 + i * 0.25) * (if i % 4 < 2 then 1 else -1)
			table.insert(
				slashes,
				Soft.windSlash(center - direction * reach, center + direction * reach, bend, scale, 0.05)
			)
		end)
		task.delay(at, function()
			if burst then
				return
			end
			local a0, a1 =
				worldAnchor(center - direction * 5, direction), worldAnchor(center + direction * 6, direction)
			local stroke = {
				softBeam(a0, a1, {
					color = ColorSequence.new(STAR_WHITE),
					width0 = 0.15,
					width1 = 0.7,
					transparency = NumberSequence.new({ key(0, 0.6), key(0.5, 0), key(1, 0.3) }),
				}),
				softBeam(a0, a1, {
					color = ColorSequence.new(WIND_WHITE, WIND),
					width0 = 0.6,
					width1 = 2.6,
					transparency = NumberSequence.new({ key(0, 0.8), key(0.5, 0.35), key(1, 0.55) }),
					texture = SMOKE,
					speed = 6,
					length = 4,
				}),
			}
			fadeBeams(stroke, 0.16, { a0, a1 })
			twinkle(center + direction * 0.4, if last then 9 else 4.5, STAR, 0.22)
			lightRing(center, direction, 0.8, if last then 12 else 6, if last then 0.35 else 0.22)
			streaks(center + direction, if last then 30 else 12, if last then 110 else 80, direction)
			windPuff(center + direction * 2, if last then 4 else 2, direction)
			if target then
				U.highlight(target, WIND_WHITE, 0.1, 0.6)
			end
			if last then
				local mirror = Vector3.new(direction.X, -direction.Y, direction.Z).Unit
				table.insert(
					slashes,
					Soft.windSlash(center - mirror * reach, center + mirror * reach, right * 3, scale, 0.05)
				)
				windRing(center, side, 2, 20, 0.4)
				U.shockwave(center, WIND, 2, 22, 0.35)
				starDust(center, 30, 40)
				local rays: { Beam } = {}
				local ends: { Attachment } = {}
				local hub = worldAnchor(center)
				table.insert(ends, hub)
				for k = 1, 12 do
					local out = U.randomUnit()
					local tip = worldAnchor(center + out * (14 + math.random() * 8), out)
					table.insert(ends, tip)
					table.insert(
						rays,
						softBeam(hub, tip, {
							color = ColorSequence.new(STAR_WHITE, if k % 2 == 0 then STAR else WIND_WHITE),
							width0 = 1.6,
							width1 = 0.05,
							transparency = NumberSequence.new({ key(0, 0.15), key(1, 0.9) }),
						})
					)
				end
				for _, ray in rays do
					U.tween(ray, 0.3, { Width0 = 0.1 })
				end
				fadeBeams(rays, 0.32, ends)
				punch(1.2, 0.35)
				if mine or near then
					U.colorGrade({ Brightness = 0.08, Contrast = 0.25, Saturation = -0.3 }, 0, 0.05, 0.18)
				end
				if mine then
					CameraShake.FovKick(4)
				end
			end
		end)
		local star = plan.stars[i]
		if star and passes[i + 1] then
			local tipAt = (at + passes[i + 1]) / 2
			task.delay(tipAt - 0.02, function()
				if burst then
					return
				end
				U.afterimage(character, WIND, 0.35)
				twinkle(star, 3.2, STAR, 0.22)
				lightRing(star, (center - star).Unit, 0.3, 3, 0.25)
				windPuff(star, 1.4)
				local count = #plan.stars
				for _, line in { (i - 1) % count + 1, (i - 2) % count + 1 } do
					local stream = lines[line * 2 - 1]
					if stream.Parent then
						stream.Width0, stream.Width1 = 1.6, 1
						U.tween(stream, 0.3, { Width0 = 0.55, Width1 = 0.33 })
					end
				end
			end)
		end
	end

	task.delay(times.Rise - 0.35, function()
		if spirit then
			spirit.raise()
		end
	end)
	task.delay(times.Rise + 0.05, function()
		if spirit then
			spirit.dissolve(root)
		end
	end)
	task.delay(times.Rise + 0.12, function()
		if sky then
			sky.gather()
		end
	end)
	task.delay(times.Strike, function()
		if sky then
			sky.flare()
		end
		if mine then
			Soft.focusLines(0.35)
		end
	end)
	task.delay(times.Burst, function()
		if sky then
			sky.scatter()
		end
		if mine then
			Soft.focusLines(0.3)
		end
	end)
	task.delay(times.Length, function()
		if spirit then
			spirit.close()
		end
	end)
	task.delay(times.Rise - 0.1, function()
		context.play(character, anims.SaintRise)
		local hold = dive - (times.Rise - 0.1)
		context.hideSword(character, hold + 0.4)
		local made = windBlade()
		made.set(root.Position + UP * 2.5, UP, 0.5)
		blade = made
		wingsOfWind(character, hold + 0.3)
		windPuff(plan.top, 5)
		windRing(plan.top, forward, 2, 16, 0.45)
		lightRing(plan.top, UP, 1, 14, 0.4)
		U.shockwave(plan.top, WIND, 2, 18, 0.45)
		local gather = U.newPart({ Size = Vector3.one * 34, Transparency = 1, CFrame = CFrame.new(plan.top + UP * 12) })
		local inward = windEmitter(gather, {
			Size = NumberSequence.new({ key(0, 4), key(1, 1) }),
			Lifetime = NumberRange.new(0.5, 0.8),
			Speed = NumberRange.new(22, 34),
			Shape = Enum.ParticleEmitterShape.Sphere,
			ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
			Rate = 70,
		})
		task.delay(hold, function()
			inward.Enabled = false
		end)
		task.delay(hold + 1, gather.Destroy, gather)
		U.light(plan.top, STAR, 6, 60, hold + 0.2)
		local low, high = worldAnchor(plan.top, UP), worldAnchor(plan.top + UP * 220, UP)
		local shaft = {
			softBeam(low, high, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 7,
				width1 = 20,
				transparency = NumberSequence.new({ key(0, 0.6), key(1, 1) }),
				texture = SMOKE,
				speed = 5,
				length = 30,
			}),
			softBeam(low, high, {
				color = ColorSequence.new(STAR_WHITE),
				width0 = 1.2,
				width1 = 3,
				transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
			}),
			softBeam(low, high, {
				color = ColorSequence.new(STAR_WHITE, STAR),
				width0 = 3,
				width1 = 6,
				transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
				texture = SPARKLE,
				wrap = true,
				length = 5,
				speed = 12,
			}),
		}
		task.delay(hold, fadeBeams, shaft, 0.3, { low, high })
		local sylph = Soft.makeSprite(1.4)
		local into = dive - 0.18
		every(into - (times.Rise - 0.1) + 0.1, function(elapsed)
			local t = elapsed + (times.Rise - 0.1)
			local head = root.Position + UP * 2.5
			if t < into then
				local angle = elapsed * 7
				local at = head + Vector3.new(math.cos(angle) * 3.5, math.sin(elapsed * 5) * 1.2, math.sin(angle) * 3.5)
				sylph.place(CFrame.lookAt(at, at + Vector3.new(-math.sin(angle), 0, math.cos(angle))), elapsed)
			else
				local a = math.clamp((t - into) / 0.1, 0, 1)
				sylph.place(CFrame.new(head:Lerp(head + UP * SAINT_BLADE, a)), elapsed)
			end
			return true
		end, function()
			sylph.fade(0.1)
			twinkle(root.Position + UP * (SAINT_BLADE + 2.5), 8, STAR, 0.3)
			windPuff(root.Position + UP * (SAINT_BLADE + 2.5), 4)
		end)
		if mine then
			CameraShake.FovKick(3)
		end
	end)
	task.delay(times.Rise + 0.12, function()
		local current = blade
		if burst or not current then
			return
		end
		for i, anchor in starAnchors do
			table.insert(gathering, Soft.starStream(anchor, current.tip, 0.8, 9))
			twinkle(plan.stars[i], 3, STAR, 0.25)
		end
		local from = worldAnchor(center)
		table.insert(gathering, Soft.starStream(from, current.tip, 1.2, 12))
		table.insert(gatherExtra, from)
	end)

	task.delay(dive, function()
		context.play(character, anims.SaintStrike)
		fadeBeams(gathering, 0.15, gatherExtra)
		local top = plan.top + UP * SaintPlan.Drift
		local down = (plan.ground - top).Unit
		table.insert(slashes, Soft.windSlash(top + UP * 38, top + down * 38, -forward * 30, 3, 0.1))
	end)
	task.delay(times.Strike, function()
		windSeam(plan.top + UP * SaintPlan.Drift, plan.ground)
		twinkle(center, 18, STAR, 0.35)
		U.flash(center, STAR_WHITE, 9, 0.25)
		for k = 1, 3 do
			windRing(center, UP, 2, 14 + k * 9, 0.3 + k * 0.08, if k == 2 then STAR else WIND)
		end
		lightRing(center, UP, 1, 30, 0.35)
		lightRing(center, forward, 1, 18, 0.3)
		U.shockwave(center, WIND, 3, 36, 0.4)
		windPuff(center, 6)
		U.burst(center, {
			color = STAR_WHITE,
			count = 40,
			size = 0.6,
			speed = NumberRange.new(60, 120),
			lifetime = NumberRange.new(0.2, 0.45),
			streaks = true,
			spread = 180,
		})
		U.light(center, STAR_WHITE, 8, 90, 0.45)
		PoseAnimator.Freeze(character, 0.12)
		if target then
			PoseAnimator.Freeze(target, 0.12)
		end
		punch(1.5, 0.5)
		if mine or near then
			U.colorGrade({ Brightness = 0.25, Contrast = 0.85, Saturation = -1 }, 0, 0.07, 0.22)
		end
	end)
	task.delay(landed, function()
		context.play(character, anims.SaintLand)
		local feet = plan.ground - UP * 2.6
		windPuff(feet, 4, UP)
		windRing(feet, UP, 1, 12, 0.4)
		lightRing(feet + UP * 0.1, UP, 0.5, 8, 0.3, WIND_WHITE)
		U.groundCracks(feet, 6, 6, WIND, 1.4)
		U.burst(feet, {
			texture = SMOKE,
			color = Color3.fromRGB(196, 204, 194),
			count = 14,
			size = 3,
			speed = NumberRange.new(14, 30),
			lifetime = NumberRange.new(0.4, 0.8),
			transparency = 0.5,
			lightEmission = 0,
			drag = 4,
			spread = 80,
			direction = UP,
		})
		if blade then
			blade.dissolve()
			blade = nil
		end
	end)

	task.delay(times.Burst, function()
		burst = true
		swirl.Enabled = false
		task.delay(1.5, swirlHolder.Destroy, swirlHolder)
		for i, slash in slashes do
			task.delay((i - 1) * 0.03, function()
				slash.flare()
				task.delay(0.1, function()
					windPuff(slash.apex, 2.5)
					starDust(slash.apex, 8, 24)
					twinkle(slash.apex, 4, STAR, 0.2)
					slash.fade(0.25)
				end)
			end)
		end
		for i, star in stars do
			twinkle(plan.stars[i], 6, STAR, 0.3)
			starDust(plan.stars[i], 10, 30)
			windPuff(plan.stars[i], 2)
			star.fade(0.2)
		end
		homeStar.fade(0.2)
		fadeBeams(lines, 0.2, starAnchors)
		circle.blowApart()
		seal.fade(0.15)
		for _, shackle in shackles do
			shackle.fade(0.15)
		end
		for _, ring in bindRings do
			ring.fade(0.15)
		end
		local nova = Soft.softStar(9)
		nova.place(center, 0)
		task.delay(0.1, nova.fade, 0.45)
		twinkle(center, 22, STAR, 0.45)
		windRing(center, UP, 3, 40, 0.5, STAR)
		windRing(center, forward, 3, 32, 0.45)
		lightRing(center, UP, 2, 46, 0.5)
		U.shockwave(center, STAR, 3, 44, 0.5)
		windPuff(center, 8)
		U.burst(center, {
			color = STAR,
			count = 50,
			size = 0.6,
			speed = NumberRange.new(40, 100),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if targetRoot then
			U.spiral(targetRoot, WIND_WHITE, 3, -5, times.Land - times.Burst, 3, 0.6, 0.2)
			local smoke = windEmitter(targetRoot, {
				Size = NumberSequence.new({ key(0, 2), key(1, 5) }),
				Transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
				Lifetime = NumberRange.new(0.4, 0.8),
				Speed = NumberRange.new(1, 3),
				Rate = 70,
			})
			local glitter = windEmitter(targetRoot, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, STAR),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
				Size = NumberSequence.new({ key(0, 0.6), key(1, 0) }),
				Lifetime = NumberRange.new(0.4, 0.8),
				Speed = NumberRange.new(1, 4),
				SpreadAngle = Vector2.new(180, 180),
				Rate = 60,
			})
			task.delay(times.Land - times.Burst, function()
				smoke.Enabled = false
				glitter.Enabled = false
				task.delay(1, smoke.Destroy, smoke)
				task.delay(1, glitter.Destroy, glitter)
			end)
			for k = 1, 4 do
				task.delay(k * 0.07, function()
					if targetRoot.Parent then
						windRing(targetRoot.Position, UP, 1, 5 + k, 0.25)
					end
				end)
			end
		end
		if mine or near then
			U.colorGrade({ Brightness = 0.1, TintColor = Color3.fromRGB(255, 246, 222) }, 0, 0.08, 0.3)
		end
		punch(1.2, 0.4)
		if mine then
			CameraShake.FovKick(5)
		end
	end)

	task.delay(times.Land, function()
		fadeBeams(tail, 0.2, { tailTop, tailEnd })
		featherFall(plan.ground, 18, times.Length - times.Land + 1.2)
	end)
	task.delay(times.Length - 0.35, function()
		local hand = handOf(character, "Right")
		if hand then
			U.glint(hand, 2, STAR_WHITE)
			twinkle(hand, 3, STAR, 0.3)
		end
	end)
	task.delay(times.Length + 0.3, finish)

	if not mine then
		return
	end
	local origin, start, top, landing = plan.origin.Position, plan.start, plan.top, plan.ground
	local function him(t: number): Vector3
		return SaintPlan.Attacker(plan, t).Position
	end
	local function them(t: number): Vector3
		return SaintPlan.Victim(plan, math.min(t, times.Land)).Position
	end
	local followed: Vector3? = nil
	local lastT = 0
	local function follow(t: number): Vector3
		local dt = math.max(t - lastT, 0)
		lastT = t
		local target = him(t)
		followed = if followed then followed:Lerp(target, math.min(dt * 5, 1)) else target
		return followed :: Vector3
	end
	local x = plan.passes[#plan.passes]
	local xSide = Vector3.new(x.X, 0, x.Z)
	xSide = if xSide.Magnitude > 1e-3 then xSide.Unit:Cross(UP) else right
	type Shot = {
		from: number,
		to: number,
		blend: number,
		get: (number, number) -> (Vector3, Vector3, number, number),
	}
	local shots: { Shot } = {
		{
			from = 0,
			to = 0.35,
			blend = 0,
			get = function(u, t)
				local e = smooth(u)
				local eye = (origin - forward * 9.5 + right * 3.5 + UP * 2.4):Lerp(
					origin - forward * 7.5 + right * 3 + UP * 2,
					e
				)
				return eye, them(t):Lerp(him(t), 0.55) + UP * 0.3, -2 * e, 74 - 6 * e
			end,
		},
		{
			from = 0.35,
			to = times.Hover + 0.05,
			blend = 0.3,
			get = function(u, t)
				local e = smooth(u)
				local victim, attacker = them(t), him(t)
				local middle = victim:Lerp(attacker, 0.5)
				local angle = rad(-20 + 60 * e)
				local around = forward * math.sin(angle) + right * math.cos(angle)
				local eye = Vector3.new(start.X, start.Y + 1.5 + (middle.Y - start.Y) * 0.85, start.Z) + around * 16
				return eye, middle + UP, 3, 84 - 6 * e
			end,
		},
		{
			from = times.Hover + 0.05,
			to = cuts[1] - 0.04,
			blend = 0,
			get = function(u, _)
				local e = smooth(u)
				local behind = plan.hover - plan.passes[1] * (9 - 2 * e) + UP * 2.6 + right * 2.2
				return behind, center + UP * 0.5, -3, 72 - 4 * e
			end,
		},
		{
			from = cuts[1] - 0.04,
			to = times.Cross - 0.12,
			blend = 0.35,
			get = function(u, t)
				local angle = rad(-35) + u * rad(110)
				local radius = 23 - 3 * u
				local around = -forward * math.cos(angle) + right * math.sin(angle)
				local eye = center + around * radius + UP * (5 + 3 * math.sin(u * math.pi))
				return eye, center:Lerp(follow(t), 0.18), -3 + 2 * u, 66 + 6 * u
			end,
		},
		{
			from = times.Cross - 0.12,
			to = times.Rise - 0.05,
			blend = 0.25,
			get = function(u, t)
				local e = smooth(u)
				local rise = smooth((u - 0.35) / 0.65)
				local look = center:Lerp(him(t), 0.5 * rise)
				return center + xSide * (20 + 12 * rise) + UP * (1 + 4 * e), look, 3 * e, 66 - 4 * e + 10 * rise
			end,
		},
		{
			from = times.Rise - 0.05,
			to = dive,
			blend = 0.3,
			get = function(u, _)
				local e = smooth(u)
				local angle = rad(-30 + 50 * e)
				local around = right * math.cos(angle) + forward * math.sin(angle)
				local reveal = smooth((u - 0.15) / 0.6)
				local eye = center - UP * 4 + around * (24 + 10 * reveal)
				local focus = center:Lerp(top + UP * 6, 0.44):Lerp(top + UP * 19, reveal)
				return eye, focus, -5 + 3 * e, 78 - 4 * e
			end,
		},
		{
			from = dive,
			to = times.Burst + 0.05,
			blend = 0,
			get = function(u, _)
				return center + right * (48 + 6 * u) + UP * (1 + u), center - UP * 4, 0, 80 + 3 * u
			end,
		},
		{
			from = times.Burst + 0.05,
			to = times.Land + 0.1,
			blend = 0.25,
			get = function(_, t)
				local eye = start + UP * 18 + right * 30 + forward * 6
				return eye, them(t):Lerp(start, 0.4), 4, 80
			end,
		},
		{
			from = times.Land + 0.1,
			to = times.Length + 0.3,
			blend = 0.3,
			get = function(u, _)
				local e = smooth(u)
				local angle = rad(140 + 40 * e)
				local around = forward * math.cos(angle) + right * math.sin(angle)
				return landing + around * (13 - 5 * e) + UP * (2.4 - 0.6 * e),
					landing + UP * (1.6 + 0.2 * e),
					0,
					70 - 12 * e
			end,
		},
	}
	local function blow(t: number, at: number, amount: number): number
		if t < at then
			return 0
		end
		local u = (t - at) / 0.08
		return amount * u * math.exp(1 - u)
	end
	local function zoom(t: number): number
		local total = 0
		for i, at in passes do
			total += blow(t, at, if i == #passes then 6 else 2)
		end
		return total + blow(t, times.Strike, 8) + blow(t, times.Burst, 4)
	end
	local function evaluate(shot: Shot, t: number, hold: boolean): (CFrame, number)
		local u = (t - shot.from) / math.max(shot.to - shot.from, 1e-3)
		if hold then
			u = math.clamp(u, 0, 1)
		end
		local eye, focus, roll, fov = shot.get(u, t)
		return CFrame.lookAt(eye, focus) * CFrame.Angles(0, 0, rad(roll)), fov
	end
	Cinematic.Camera(function(t)
		local index = #shots
		for i, shot in shots do
			if t < shot.to then
				index = i
				break
			end
		end
		local shot = shots[index]
		local cframe, fov = evaluate(shot, t, true)
		local previous = shots[index - 1]
		if shot.blend > 0 and previous and t - shot.from < shot.blend then
			local b = smooth((t - shot.from) / shot.blend)
			local fromFrame, fromFov = evaluate(previous, t, false)
			cframe = fromFrame:Lerp(cframe, b)
			fov = fromFov + (fov - fromFov) * b
		end
		fov -= zoom(t)
		if depth then
			depth.FocusDistance = (cframe.Position - him(t)).Magnitude
		end
		return cframe, fov
	end, times.Length + 0.3)
end

local function impact(position: Vector3)
	twinkle(position + UP * 2, 14, STAR, 0.35)
	U.flash(position + UP * 2, STAR_WHITE, 10, 0.25)
	U.shockwave(position, WIND, 3, 50, 0.6)
	U.shockwave(position, STAR, 3, 36, 0.5)
	windRing(position + UP * 0.3, UP, 2, 30, 0.55)
	windRing(position + UP * 0.6, UP, 2, 40, 0.75, STAR)
	lightRing(position + UP * 0.2, UP, 1, 34, 0.5)
	U.groundCracks(position, 14, 16, WIND, 2.5)
	U.groundRocks(position, 14, 10, 2.2)
	U.debris(position, 26, 60, 1.2)
	windColumn(position, 70, 4.5, 1.2)
	starfall(position, 18, 1.4)
	U.burst(position + UP, {
		texture = SMOKE,
		color = Color3.fromRGB(170, 178, 170),
		count = 26,
		size = 6,
		speed = NumberRange.new(20, 45),
		lifetime = NumberRange.new(0.6, 1.2),
		lightEmission = 0,
		transparency = 0.45,
		spread = 80,
		direction = UP,
		drag = 3,
	})
	U.light(position, STAR, 6, 60, 0.9)
	local me = Players.LocalPlayer.Character
	local watching = me ~= nil and me:GetAttribute("Cinematic") == true
	if not watching and (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 80 then
		CameraShake.Add(0.2)
	end
end

function Saint.Handle(data, character: Model, root: BasePart, context: Context)
	local phase = data.phase
	if phase == "Flick" then
		context.play(character, context.anims.Conjunction)
		local hand = handOf(character, "Right") or root.Position
		local forward = root.CFrame.LookVector
		local range: number = data.range or 15
		local star = Soft.softStar(1.4)
		local from, at = worldAnchor(hand), worldAnchor(hand)
		local thread = Soft.starStream(from, at, 0.4, 6)
		twinkle(hand, 2.5, STAR, 0.2)
		windPuff(hand, 1.5, forward)
		every(0.2, function(elapsed)
			local position = hand + forward * range * (elapsed / 0.2)
			star.place(position, elapsed * 20)
			at.CFrame = CFrame.new(position)
			return true
		end, function()
			star.fade(0.15)
			fadeBeams({ thread }, 0.2, { from, at })
		end)
	elseif phase == "Whiff" then
		local at = root.Position + root.CFrame.LookVector * 15
		windPuff(at, 2)
		starDust(at, 10, 14)
	elseif phase == "Begin" then
		play(data, character, root, context)
	elseif phase == "Impact" then
		impact(data.position)
	end
end

return Saint
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="57">
              <Properties>
                <string name="Name">Sword</string>
                <string name="Source"><![CDATA[local Soft = require(script.Parent.Parent.Parent.Soft)

local rad = math.rad
local key = Soft.key

local WIND, WIND_WHITE = Soft.WIND, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE

local GRIP = Color3.fromRGB(22, 64, 48)
local GOLD = STAR
local GEM = WIND

local Sword = {}

local BASE, SWELL, TIP = 0.72, 4.6, 6.6
local BASE_WIDTH, WIDEST = 0.5, 0.86
local THICK = 0.12
local CORE = 3.5

export type Piece = {
	shape: "Box" | "Wedge" | "Ball" | "Feather",
	size: Vector3,
	color: Color3,
	transparency: number,
	offset: CFrame,
	material: Enum.Material?,
	core: boolean?,
}

local PIECES: { Piece } = {}
local function add(piece: Piece)
	table.insert(PIECES, piece)
end

add({
	shape = "Box",
	size = Vector3.new(0.2, 1.12, 0.2),
	color = GRIP,
	transparency = 0,
	offset = CFrame.new(0, -0.06, 0),
	material = Enum.Material.Fabric,
})
for _, y in { -0.36, -0.06, 0.24 } do
	add({
		shape = "Box",
		size = Vector3.new(0.235, 0.07, 0.235),
		color = GOLD,
		transparency = 0,
		offset = CFrame.new(0, y, 0),
	})
end
add({
	shape = "Box",
	size = Vector3.new(0.27, 0.08, 0.27),
	color = GOLD,
	transparency = 0,
	offset = CFrame.new(0, -0.62, 0),
})
add({ shape = "Ball", size = Vector3.one * 0.3, color = GOLD, transparency = 0, offset = CFrame.new(0, -0.8, 0) })
add({ shape = "Ball", size = Vector3.one * 0.16, color = GEM, transparency = 0, offset = CFrame.new(0, -0.95, 0) })

local GUARD = 0.56
add({
	shape = "Box",
	size = Vector3.new(0.3, 0.24, 0.46),
	color = GOLD,
	transparency = 0,
	offset = CFrame.new(0, GUARD, 0),
})
for _, x in { -0.12, 0.12 } do
	add({ shape = "Ball", size = Vector3.one * 0.2, color = GEM, transparency = 0, offset = CFrame.new(x, GUARD, 0) })
end
local GUARD_FEATHERS = {
	{ rise = 10, length = 0.95, width = 0.22 },
	{ rise = 34, length = 0.76, width = 0.19 },
	{ rise = 58, length = 0.54, width = 0.16 },
	{ rise = -28, length = 0.42, width = 0.14 },
}
for _, side in { -1, 1 } do
	for _, f in GUARD_FEATHERS do
		add({
			shape = "Feather",
			size = Vector3.new(0.07, f.length, f.width),
			color = GOLD,
			transparency = 0,
			offset = CFrame.new(0, GUARD, side * 0.2)
				* CFrame.Angles(rad(90 - f.rise) * side, 0, 0)
				* CFrame.new(0, f.length / 2, 0),
		})
	end
end

local DIAMOND = 0.95
add({
	shape = "Box",
	size = Vector3.new(0.17, 0.3, 0.3),
	color = GOLD,
	transparency = 0,
	offset = CFrame.new(0, DIAMOND, 0) * CFrame.Angles(rad(45), 0, 0),
})
for _, x in { -0.07, 0.07 } do
	add({ shape = "Ball", size = Vector3.one * 0.13, color = GEM, transparency = 0, offset = CFrame.new(x, DIAMOND, 0) })
end

local reach = SWELL - BASE
local flare = (WIDEST - BASE_WIDTH) / 2
local middle = (BASE + SWELL) / 2
add({
	shape = "Box",
	size = Vector3.new(THICK, reach, BASE_WIDTH),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, middle, 0),
})
local flareAt = BASE_WIDTH / 2 + flare / 2
add({
	shape = "Wedge",
	size = Vector3.new(THICK, reach, flare),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, middle, flareAt) * CFrame.Angles(math.pi, 0, 0),
})
add({
	shape = "Wedge",
	size = Vector3.new(THICK, reach, flare),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, middle, -flareAt) * CFrame.Angles(0, 0, math.pi),
})
local point = TIP - SWELL
add({
	shape = "Wedge",
	size = Vector3.new(THICK, point, WIDEST / 2),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, (SWELL + TIP) / 2, WIDEST / 4) * CFrame.Angles(0, math.pi, 0),
})
add({
	shape = "Wedge",
	size = Vector3.new(THICK, point, WIDEST / 2),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, (SWELL + TIP) / 2, -WIDEST / 4),
})
add({
	shape = "Box",
	size = Vector3.new(THICK + 0.015, reach - 0.3, 0.28),
	color = WIND_WHITE,
	transparency = 0.55,
	offset = CFrame.new(0, middle + 0.15, 0),
})
add({
	shape = "Box",
	size = Vector3.new(0.15, 5.3, 0.09),
	color = WIND_WHITE,
	transparency = 0,
	offset = CFrame.new(0, CORE, 0),
	core = true,
})
local function edge(fromY: number, fromZ: number, toY: number, toZ: number)
	local dy, dz = toY - fromY, toZ - fromZ
	add({
		shape = "Box",
		size = Vector3.new(THICK + 0.02, math.sqrt(dy * dy + dz * dz) + 0.03, 0.05),
		color = WIND_WHITE,
		transparency = 0.1,
		offset = CFrame.new(0, (fromY + toY) / 2, (fromZ + toZ) / 2) * CFrame.Angles(math.atan2(dz, dy), 0, 0),
	})
end
for _, side in { -1, 1 } do
	edge(BASE, side * BASE_WIDTH / 2, SWELL, side * WIDEST / 2)
	edge(SWELL, side * WIDEST / 2, TIP, 0)
end
add({
	shape = "Feather",
	size = Vector3.new(0.42, TIP - BASE + 0.6, WIDEST + 0.45),
	color = WIND,
	transparency = 0,
	offset = CFrame.new(0, (BASE + TIP) / 2 + 0.1, 0),
	material = Enum.Material.ForceField,
})

function Sword.Pieces(): { Piece }
	return PIECES
end

export type Maker = (props: { [string]: any }, base: number, wedge: boolean?) -> BasePart

export type Sword = {
	parts: { BasePart },
	frames: { CFrame },
	blade: BasePart,
	beams: { Beam },
	emitters: { ParticleEmitter },
}

function Sword.new(make: Maker): Sword
	local parts: { BasePart } = {}
	local blade: BasePart? = nil
	for _, piece in PIECES do
		local props: { [string]: any } = {
			Size = piece.size,
			Color = piece.color,
		}
		if piece.shape == "Ball" then
			props.Shape = Enum.PartType.Ball
		end
		if piece.material then
			props.Material = piece.material
		end
		local part = make(props, piece.transparency, piece.shape == "Wedge")
		if piece.shape == "Feather" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		if piece.core then
			blade = part
		end
		table.insert(parts, part)
	end
	assert(blade, "the sword has no fuller")

	local low = Instance.new("Attachment")
	low.Position = Vector3.new(0, -2.6, 0)
	low.Parent = blade
	local high = Instance.new("Attachment")
	high.Position = Vector3.new(0, 2.8, 0)
	high.Parent = blade
	local beams = {
		Soft.softBeam(low, high, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.5,
			width1 = 0.7,
			transparency = NumberSequence.new({ key(0, 0.86), key(0.3, 0.64), key(1, 0.82) }),
			texture = Soft.SMOKE,
			speed = 2.5,
			length = 3,
		}, blade),
		Soft.softBeam(low, high, {
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.5,
			width1 = 0.28,
			transparency = NumberSequence.new({ key(0, 0.75), key(0.5, 0.45), key(1, 0.7) }),
			texture = Soft.SPARKLE,
			wrap = true,
			length = 0.8,
			speed = 1.5,
		}, blade),
	}
	for _, beam in beams do
		beam.Enabled = false
	end
	local point = Instance.new("Attachment")
	point.Position = Vector3.new(0, TIP - CORE - 0.15, 0)
	point.Parent = blade
	local glint = Soft.windEmitter(point, {
		Texture = Soft.SPARKLE,
		Color = ColorSequence.new(STAR_WHITE),
		LightEmission = 1,
		Size = NumberSequence.new({ key(0, 0), key(0.3, 0.9), key(1, 0) }),
		Transparency = NumberSequence.new({ key(0, 0.1), key(1, 0.6) }),
		Lifetime = NumberRange.new(0.25, 0.35),
		Speed = NumberRange.new(0),
		RotSpeed = NumberRange.new(-90, 90),
		LockedToPart = true,
		Rate = 1.5,
	})

	return {
		parts = parts,
		frames = table.create(#parts, CFrame.identity),
		blade = blade,
		beams = beams,
		emitters = { glint },
	}
end

function Sword.Place(sword: Sword, grip: CFrame)
	for i, piece in PIECES do
		sword.frames[i] = grip * piece.offset
	end
	workspace:BulkMoveTo(sword.parts, sword.frames, Enum.BulkMoveMode.FireCFrameChanged)
end

return Sword
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="58">
              <Properties>
                <string name="Name">Waltz</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local WaltzPlan = require(ReplicatedStorage:WaitForChild("Shared").Zephyrus)
local Cinematic = require(script.Parent.Parent.Parent.Cinematic)
local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local Reactions = require(script.Parent.Parent.Parent.Reactions)
local Soft = require(script.Parent.Parent.Parent.Soft)

local U = Soft.U
local rad = math.rad
local UP = Vector3.yAxis
local key = Soft.key

local WIND, WIND_WHITE = Soft.WIND, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE = Soft.SMOKE

type Animation = PoseAnimator.Animation
type Sword = { hold: (number) -> (), point: () -> Vector3 }

export type Context = {
	anims: { [string]: Animation },
	play: (Model, Animation) -> (),
	sword: (Model) -> Sword?,
}

local Waltz = {}

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

function Waltz.Play(ctx: Context, data, character: Model, root: BasePart): (() -> ())?
	if typeof(data.attacker) ~= "Vector3" or typeof(data.victim) ~= "Vector3" then
		return nil
	end
	local times = WaltzPlan.Times
	local plan = WaltzPlan.Plan(data.attacker, data.victim)
	local victim: Model? = if typeof(data.target) == "Instance" and data.target:IsA("Model") then data.target else nil
	local victimRoot = U.getRoot(victim)
	local mine = U.isLocal(character) or U.isLocal(victim)
	local started = os.clock()
	local finished = false
	local through = -plan.out

	local function at(time: number, fn: () -> ())
		task.delay(math.max(time - (os.clock() - started), 0), function()
			if not finished and character.Parent then
				fn()
			end
		end)
	end
	local function them(t: number): Vector3
		return WaltzPlan.Victim(plan, math.min(t, times.Thrust)).Position
	end

	local bind = "CloverZephyrWaltz" .. tostring(started)
	local stop: () -> ()
	function stop()
		if finished then
			return
		end
		finished = true
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > times.Length then
			stop()
			return
		end
		if root.Parent then
			root.CFrame = WaltzPlan.Attacker(plan, t)
		end
		if victimRoot and victimRoot.Parent and t <= times.Thrust then
			victimRoot.CFrame = WaltzPlan.Victim(plan, t)
		end
	end)
	task.delay(times.Length + 0.5, stop)
	local sword = ctx.sword(character)
	if sword then
		sword.hold(times.Length + 0.2)
	end

	local center = plan.center
	Soft.windRing(center, plan.out, 1, 8, 0.3)
	Soft.lightRing(center, plan.out, 0.5, 6, 0.25, WIND_WHITE)
	Soft.twinkle(center, 5, WIND, 0.25)
	Soft.windPuff(center, 3, through)
	U.flash(center, WIND_WHITE, 3, 0.1)
	if victim then
		U.highlight(victim, WIND_WHITE, 0.1, 0.6)
		local flail = Reactions.Launched
		if flail then
			PoseAnimator.Play(victim, flail)
		end
	end

	local rings = {
		Soft.softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.6,
			width1 = 1.6,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 6,
			length = 5,
		}),
		Soft.softRing({
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.3,
			width1 = 0.3,
			transparency = NumberSequence.new(0.45),
		}),
	}
	local stopHelix = Soft.helix(function()
		local foot = them(os.clock() - started) - UP * 3
		return foot, foot + UP * 8
	end, 3.6, 3, 0.5, 1.5, 0.9, times.Out + 0.15, WIND)
	Soft.every(times.Out + 0.15, function(elapsed)
		local spin = WaltzPlan.Attacker(plan, math.min(elapsed, times.Out))
		local heart = them(elapsed)
		local grow = smooth(elapsed / 0.15)
		local turn = math.atan2(spin.Position.Z - heart.Z, spin.Position.X - heart.X)
		rings[1].set(CFrame.new(heart) * CFrame.Angles(0, -turn, 0), WaltzPlan.Radius * grow + 0.05)
		rings[2].set(CFrame.new(heart - UP * 2.4) * CFrame.Angles(0, turn, 0), (WaltzPlan.Radius + 0.8) * grow + 0.05)
		return true
	end, function()
		for _, ring in rings do
			ring.fade(0.25)
		end
		stopHelix()
	end)

	local torso = character:FindFirstChild("Torso") :: BasePart?
	if torso then
		local wake = Soft.trail(torso, Vector3.new(0, 1.4, 0), Vector3.new(0, -1.4, 0), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new({ key(0, 0.4), key(1, 1) }),
			width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
			lifetime = 0.45,
			texture = SMOKE,
		})
		task.delay(times.Out + 0.05, Soft.endTrail, wake)
	end
	for i = 0, 17 do
		at(0.06 + i * 0.045, function()
			U.afterimage(character, WIND, 0.4)
		end)
	end

	local slashes: { Soft.Slash } = {}
	for i, when in times.Cuts do
		at(when - 0.05, function()
			ctx.play(character, if i % 2 == 1 then ctx.anims.SaintCut else ctx.anims.SaintCutBack)
		end)
		at(when, function()
			local heart = them(when)
			local him = WaltzPlan.Attacker(plan, when)
			local across = UP:Cross((heart - him.Position).Unit)
			across = if across.Magnitude > 1e-3 then across.Unit else plan.side
			local tilt = UP * (if i % 2 == 1 then 1.4 else -1.4)
			local slash = Soft.windSlash(
				heart + across * 4 + tilt,
				heart - across * 4 - tilt,
				(heart - him.Position).Unit * 1.2 + UP * 0.3,
				0.8
			)
			table.insert(slashes, slash)
			Soft.twinkle(heart, 3, WIND, 0.18)
			Soft.lightRing(heart, across, 0.4, 4.5, 0.2, WIND_WHITE)
			Soft.windPuff(heart, 2, across)
			U.burst(heart, {
				color = WIND_WHITE,
				count = 8,
				size = 0.4,
				speed = NumberRange.new(24, 50),
				lifetime = NumberRange.new(0.1, 0.25),
				streaks = true,
				spread = 40,
				direction = across,
			})
			if victim then
				U.highlight(victim, WIND_WHITE, 0.08, 0.6)
			end
		end)
	end

	at(times.Out - 0.06, function()
		ctx.play(character, ctx.anims.ZephyrusDraw)
		for i = 0, 6 do
			task.delay(i * 0.015, function()
				local current = ctx.sword(character)
				if current then
					Soft.inflow(current.point(), 4, WIND_WHITE)
				end
			end)
		end
		Soft.twinkle(root.Position, 4, STAR, 0.2)
	end)
	at(times.Thrust - 0.07, function()
		ctx.play(character, ctx.anims.ZephyrusSkewer)
	end)

	at(times.Thrust, function()
		local hand = WaltzPlan.Attacker(plan, times.Thrust).Position + UP * 0.3
		local heart = them(times.Thrust)
		local tip = heart + through * 26
		local a, b = Soft.worldAnchor(hand, through), Soft.worldAnchor(hand, through)
		local spear = {
			Soft.softBeam(a, b, {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 1.1,
				width1 = 0.15,
				transparency = NumberSequence.new({ key(0, 0.1), key(1, 0.6) }),
			}),
			Soft.softBeam(a, b, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 5,
				width1 = 1.4,
				transparency = NumberSequence.new({ key(0, 0.55), key(1, 0.92) }),
				texture = SMOKE,
				speed = 14,
				length = 10,
			}),
		}
		table.insert(spear, Soft.starStream(a, b, 0.7, 16))
		Soft.every(0.07, function(elapsed)
			Soft.aim(b, hand:Lerp(tip, smooth(elapsed / 0.07)), through)
			return true
		end, function()
			Soft.aim(b, tip, through)
			task.delay(0.12, Soft.fadeBeams, spear, 0.32, { a, b })
		end)
		local stopSpiral = Soft.helix(function()
			return hand, tip
		end, 1.4, 4, 0.3, 3, 0.5, 0.4, WIND_WHITE)
		task.delay(0.4, stopSpiral)
		for i = 1, 6 do
			task.delay(i * 0.025, function()
				local ring = hand + through * (2 + i * 4)
				Soft.windRing(ring, through, 0.6, 3 + i * 0.8, 0.3)
				Soft.lightRing(ring, through, 0.5, 2.5 + i * 0.7, 0.25, WIND_WHITE)
			end)
		end
		U.flash(heart, STAR_WHITE, 5, 0.12)
		Soft.twinkle(heart, 9, STAR, 0.3)
		Soft.windRing(heart, through, 1, 12, 0.35)
		U.shockwave(heart, WIND, 1, 14, 0.3)
		Soft.windPuff(heart + through * 2, 4, through)
		Soft.streaks(heart + through, 18, 95, through, 25)
		for i, slash in slashes do
			task.delay(0.02 * i, function()
				slash.flare()
				slash.fade(0.22)
				Soft.twinkle(slash.apex, 3, WIND, 0.2)
			end)
		end
		if victimRoot and victimRoot.Parent then
			local comet = Soft.trail(victimRoot, Vector3.new(0, 1.2, 0), Vector3.new(0, -1.2, 0), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.35), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
				lifetime = 0.35,
				texture = SMOKE,
			})
			task.delay(0.7, Soft.endTrail, comet)
		end
		if mine then
			Soft.focusLines(0.3)
		end
	end)

	if mine then
		local release = Waltz.Camera(plan)
		local stopDrawing = stop
		stop = function()
			stopDrawing()
			release()
		end
	end
	return stop
end

function Waltz.Camera(plan: WaltzPlan.Plan): () -> ()
	local times = WaltzPlan.Times
	local function them(t: number): Vector3
		return WaltzPlan.Victim(plan, math.min(t, times.Thrust)).Position
	end
	local function blow(t: number, at: number, amount: number): number
		if t < at then
			return 0
		end
		local u = (t - at) / 0.07
		return amount * u * math.exp(1 - u)
	end
	return Cinematic.Camera(function(elapsed)
		local t = math.min(elapsed, times.Length)
		local counter = rad(-40) - rad(40) * smooth(t / times.Out)
		local behind = smooth((t - (times.Out - 0.35)) / 0.45)
		local angle = counter + (rad(18) - counter) * behind
		local radial = plan.out * math.cos(angle) + plan.side * math.sin(angle)
		local heart = them(t)
		local eye = heart + radial * (11 + 3 * behind) + UP * (0.6 + 1.6 * behind)
		local follow = smooth((t - times.Thrust) / 0.25)
		local focus = heart:Lerp(heart - plan.out * 8, follow) + UP * 0.4
		local fov = 72 - 4 * behind
		for _, cut in times.Cuts do
			fov -= blow(t, cut, 3)
		end
		fov -= blow(t, times.Thrust, 9)
		return CFrame.lookAt(eye, focus) * CFrame.Angles(0, 0, rad(3 - 5 * behind)), fov
	end, times.Length + 0.05)
end

return Waltz
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="59">
              <Properties>
                <string name="Name">Wings</string>
                <string name="Source"><![CDATA[local Soft = require(script.Parent.Parent.Parent.Soft)

local rad = math.rad
local key = Soft.key

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE

local Wings = {}

local SCALE = 0.92
local BONES = { 1.3 * SCALE, 1.8 * SCALE, 1.4 * SCALE }

local ROOT = Vector3.new(0.45, 0.55, 0.65)

export type Hold = {
	lift: number,
	elbow: number,
	wrist: number,
	sweep: number,
	twist: number,
	beat: number,
	rate: number,
}

Wings.Hover = { lift = 68, elbow = -20, wrist = -44, sweep = 24, twist = 8, beat = 1, rate = 0.4 } :: Hold
Wings.Glide = { lift = 22, elbow = -12, wrist = -30, sweep = 30, twist = 72, beat = 0.35, rate = 0.8 } :: Hold

function Wings.Blend(a: Hold, b: Hold, k: number): Hold
	return {
		lift = a.lift + (b.lift - a.lift) * k,
		elbow = a.elbow + (b.elbow - a.elbow) * k,
		wrist = a.wrist + (b.wrist - a.wrist) * k,
		sweep = a.sweep + (b.sweep - a.sweep) * k,
		twist = a.twist + (b.twist - a.twist) * k,
		beat = a.beat + (b.beat - a.beat) * k,
		rate = a.rate + (b.rate - a.rate) * k,
	}
end

type Feather = {
	bone: number,
	at: number,
	angle: number,
	length: number,
	width: number,
	layer: number,
	drop: number,
	color: Color3,
	transparency: number,
	quill: boolean,
	flex: number,
	trail: boolean,
}

local FEATHERS: { Feather } = {}
local function row(style: { [string]: any }, list: { { number } })
	for i, f in list do
		table.insert(FEATHERS, {
			bone = f[1],
			at = f[2],
			angle = f[3],
			length = f[4] * SCALE,
			width = f[5] * SCALE,
			layer = style.layer + i * 0.006,
			drop = style.drop,
			color = style.color,
			transparency = style.transparency,
			quill = style.quill == true,
			flex = style.flex,
			trail = style.trail == true and i >= #list - 2,
		})
	end
end

