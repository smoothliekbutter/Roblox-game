local function H():(Model?,Humanoid?,BasePart?)
local I=o.Character
if not I or not h.IsAlive(I)then
return nil,nil,nil
end
return I,
I:FindFirstChildOfClass("Humanoid"),
I:FindFirstChild("HumanoidRootPart")::BasePart
end


local function I():CFrame
local J=workspace.CurrentCamera.CFrame.LookVector
local K=Vector3.new(J.X,0,J.Z)
