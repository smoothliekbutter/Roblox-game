            <Item class="ModuleScript" referent="41">
              <Properties>
                <string name="Name">Base</string>
                <string name="Source"><![CDATA[

local a=game:GetService("ReplicatedStorage")
local b=game:GetService("RunService")

local c=require(a:WaitForChild("Shared").MeteorVortex)

local d=require(script.Parent.Parent.Parent.CameraShake)
local e=require(script.Parent.Parent.Parent.PoseAnimator)
local f=require(script.Parent.Parent.Parent.VFX)

local g=f.Util

local h=math.rad

local i=require(script.Parent.Fx)
local j,k,l,m,n,o=i.BLACK,i.RED,i.DARK_RED,i.WHITE,i.HOT,i.WHITE_HOT
local p,q,r,s,t,u=i.UP,i.ANIMS,i.handlers,i.play,i.bump,i.live
local v,w,x,y=i.involves,i.feetOf,i.bladeOf,i.bladePoint
local z,A,B,C=i.swordTrail,i.swordGlow,i.swordAura,i.heavyTrail
local D,E,F,G=i.edgeGlow,i.blackSmoke,i.redSparks,i.blackLightning
local H,I,J,K,L=i.crackle,i.crescent,i.inflow,i.slashWave,i.slashMark
local M,N,O,P=i.markAngle,i.impactFrame,i.lingerSmoke,i.partEmitter
local Q,R,S,T=i.trailEmitter,i.glowBurst,i.bloomPulse,i.meteorTail
type CrescentOptions=i.CrescentOptions




local U:{[string]:CrescentOptions}={

Rising={
center=CFrame.new(1,0.5,0)*CFrame.Angles(h(5),0,0),
radius=5.2,
from=130,
to=-80,
tilt=-41,
width=1.7,
sweep=0.06,
fade=0.24,
},

Sweep={
center=CFrame.new(1,0.5,0)*CFrame.Angles(h(-5),0,0),
radius=5,
from=-100,
to=122,
tilt=-2,
width=1.7,
sweep=0.06,
fade=0.24,
},

Spin={
center=CFrame.new(0,0.5,0)*CFrame.Angles(h(-12),0,0),
radius=5.9,
from=160,
to=425,
tilt=3,
width=2.1,
sweep=0.16,
fade=0.3,
},

Chop={
center=CFrame.new(0.4,0.8,0)*CFrame.Angles(0,h(5),0),
radius=5,
from=135,
to=-28,
tilt=90,
width=2.3,
sweep=0.06,
fade=0.3,
},
}

local V:{[string]:{cut:Vector3,size:number}}={
Rising={cut=Vector3.new(-0.75,0.65,0),size=1},
Sweep={cut=Vector3.new(1,0,0),size=1},
Spin={cut=Vector3.new(1,0.05,0),size=1.25},
Chop={cut=Vector3.new(0,-1,0.25),size=1.5},
}


local function W(X:BasePart,Y:BasePart):Vector3
local Z=Y.Position-X.Position
local _=Vector3.new(Z.X,0,Z.Z)
return if _.Magnitude>0.1 then _.Unit else X.CFrame.LookVector
end


local function X(Y:Model,Z:BasePart,_:string)
local aa=U[_]
if aa then
C(Y,(aa.sweep or 0.06)+0.06)
aa.glow=aa.glow or 0.7
I(Y,aa)
D(Y,(aa.sweep or 0.06)+0.1,0.8)

E(w(Y,Z)+p*0.3,3,1.6,5)
if _=="Spin"then

g.ringBurst(CFrame.new(Z.Position+p*0.2),j,1.5,7,0.28,0.22)
task.delay(0.06,g.ringBurst,CFrame.new(Z.Position+p*0.3),l,1.2,5.5,0.24,0.14)
task.delay(0.08,function()
if Y.Parent then
g.afterimage(Y,l,0.18)
end
end)
elseif _=="Chop"then

local ab=y(Y,2.1)
if ab then
g.glint(ab,1.2,k)
end
end
elseif _=="Coil"then


A(Y,k,0.18,0.35)
B(Y,0.16,40)
