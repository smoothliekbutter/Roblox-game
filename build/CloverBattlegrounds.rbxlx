r.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.Viewer

q:PivotTo(CFrame.lookAt(o.position,Vector3.new(0,o.position.Y,0)))
q.Parent=i
s:SetNetworkOwner(nil)

b.Register(q)

r.Died:Connect(function()
task.delay(e,function()
q:Destroy()
n(o)
end)
end)

task.spawn(m,q,o,r,s)
end

function j.Start()
for o,p in d do
task.spawn(n,p)
end
end

return j]]></string>
