          <string name="Name">BlackAscent</string>
          <string name="Source"><![CDATA[

local a={}

local b=Vector3.yAxis

a.Times={
Rise=0.32,
Cuts={0.4,0.58},
Spike=0.8,
Land=0.95,
Length=1.3,
}
a.Height=11

export type Key={t:number,p:Vector3,yaw:number,pitch:number}
export type Plan={
origin:CFrame,
start:Vector3,
forward:Vector3,
right:Vector3,
floorY:number,
top:Vector3,
keys:{Key},
}

local function c(d:Vector3,e:Vector3):Vector3
local f=Vector3.new(d.X,0,d.Z)
return if f.Magnitude>1e-3 then f.Unit else e
end


local function d(e:number,f:number,g:number):number
if e<=f then
return 0
end
local h=(e-f)/g
return h*math.exp(1-h)
end

function a.Plan(e:CFrame,f:Vector3,g:number):Plan
local h=f-e.Position
local i=c(h,c(e.LookVector,Vector3.new(0,0,-1)))
local j=i:Cross(b)
local k=Vector3.new(f.X,g+3,f.Z)
local l=k+b*a.Height
local m=a.Times
local n,o=m.Cuts[1],m.Cuts[2]
local p=Vector3.new(k.X,g+3,k.Z)-i*3
local q=e.Position
local r:{Key}={
{t=0,p=q,yaw=0,pitch=0},
{t=0.1,p=q+i*0.5+b*1.2,yaw=-6,pitch=-8},
{t=n-0.07,p=l-i*2.8+j*3.4-b*0.3,yaw=-40,pitch=-6},
{t=n,p=l-i*3.1+b*0.1,yaw=-6,pitch=-10},
{t=n+0.08,p=l-i*2.6-j*3.3-b*0.7,yaw=36,pitch=-4},
{t=o,p=l-i*2.7-j*0.9+b*1.1,yaw=22,pitch=-8},
{t=o+0.08,p=l-i*2.1+j*1.6+b*3.2,yaw=-12,pitch=-14},
{t=m.Spike-0.05,p=l-i*1.1+b*4.3,yaw=0,pitch=-38},
{t=m.Spike,p=l-i*1.4+b*2.9,yaw=0,pitch=-62},
{t=m.Land+0.07,p=p+b*0.4,yaw=0,pitch=-12},
{t=m.Land+0.15,p=p,yaw=0,pitch=0},
{t=m.Length,p=p,yaw=0,pitch=0},
}
return{
origin=e,
start=k,
forward=i,
right=j,
floorY=g,
top=l,
keys=r,
}
end

local function e(f:{Key},g:number,h:(Key)->any):any
if g==1 or g==#f then
return h(f[g])*0
end
local i,j=f[g-1],f[g+1]
return(h(j)-h(i))/(j.t-i.t)
end

local function f(g:{Key},h:number,i:(Key)->any):any
if h<=g[1].t then
return i(g[1])
end
for j=1,#g-1 do
local k,l=g[j],g[j+1]
if h<=l.t then
local m=l.t-k.t
local n=(h-k.t)/m
local o,p=n*n,n*n*n
return i(k)*(2*p-3*o+1)
+e(g,j,i)*(m*(p-2*o+n))
+i(l)*(-2*p+3*o)
+e(g,j+1,i)*(m*(p-o))
end
end
return i(g[#g])
end

local function g(h:Key):Vector3
return h.p
end
local function h(i:Key):number
return i.yaw
end
local function i(j:Key):number
return j.pitch
end

function a.Attacker(j:Plan,k:number):CFrame
local l:Vector3=f(j.keys,k,g)
if k>a.Times.Land then

l=Vector3.new(l.X,math.max(l.Y,j.floorY+3),l.Z)
end
local m=math.rad(f(j.keys,k,h)::number)
local n=math.rad(f(j.keys,k,i)::number)
local o=j.forward*math.cos(m)+j.right*math.sin(m)
return CFrame.lookAt(l,l+o)*CFrame.Angles(n,0,0)
end

function a.Victim(j:Plan,k:number):CFrame
local l=a.Times
local m,n=l.Cuts[1],l.Cuts[2]
local o=CFrame.lookAt(Vector3.zero,-j.forward).Rotation

local p=1-(1-math.clamp(k/l.Rise,0,1))^2.5
local q=j.start:Lerp(j.top,p)+b*0.7*math.max(k-l.Rise,0)

local r=d(k,m,0.09)
local s=d(k,n,0.1)
q+=-j.right*1.1*r+b*0.3*r+j.right*0.9*s+b*0.9*s
local t=-50*p
-18*math.min(math.max(k-m,0)/0.1,1)
-22*math.min(math.max(k-n,0)/0.12,1)
local u=14*r-18*s
if k<=l.Spike then
return CFrame.new(q)*o*CFrame.Angles(math.rad(t),0,math.rad(u))
end


local v=a.Victim(j,l.Spike)
local w=math.clamp((k-l.Spike)/(l.Land-l.Spike),0,1)
local x=Vector3.new(j.start.X,j.floorY+1.2,j.start.Z)
local y=v.Position:Lerp(x,0.45*w+0.55*w*w)
local z=CFrame.new(y)*o*CFrame.Angles(math.rad(-95),0,0)
return v.Rotation:Lerp(z.Rotation,math.min(w*1.4,1))+y
end

return a]]></string>
        </Properties>
