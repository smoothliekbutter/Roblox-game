              <Properties>
                <string name="Name">Ascent</string>
                <string name="Source"><![CDATA[

local a=game:GetService("ReplicatedStorage")
local b=game:GetService("RunService")

local c=require(a:WaitForChild("Shared").BlackAscent)
local d=require(script.Parent.Parent.Parent.CameraShake)
local e=require(script.Parent.Parent.Parent.Cinematic)
local f=require(script.Parent.Parent.Parent.PoseAnimator)
local g=require(script.Parent.Parent.Parent.Soft)

local h=g.U
local i=math.rad
local j=Vector3.yAxis
local k=g.key

local l=Color3.fromRGB(8,8,10)
local m=Color3.fromRGB(200,25,35)
local n=Color3.fromRGB(110,8,18)
local o=Color3.fromRGB(150,138,122)

type Animation=f.Animation
type Wings={flap:(()->())?,setPose:((string?)->())?,setPair:((boolean)->())?}


export type Context={
anims:{[string]:Animation},
play:(Model,Animation)->(),
launched:(Model)->Animation?,
wings:(Model)->Wings?,
crescent:(Model,{[string]:any})->(),
cutLine:(Vector3,Vector3,number,number)->(),
blackSmoke:(Vector3,number,number,number?)->(),
redSparks:(Vector3,number,number?,Vector3?)->(),
blackLightning:(Vector3,number,number,number?)->(),
glowBurst:(Vector3,number,number?)->(),
bloomPulse:(Vector3,number,number)->(),
heavyTrail:(Model,number)->(),
edgeGlow:(Model,number,number?)->(),
swordAura:(Model,number,number)->(),
trailEmitter:(BasePart,{[string]:any},number)->ParticleEmitter,
impactFrame:(number?)->(),
lingerSmoke:(Vector3,number,number)->(),
}

local p={}

local function q(r:number):number
r=math.clamp(r,0,1)
return r*r*(3-2*r)
end


local function r(
s:Vector3,
t:Vector3,
u:number,
v:number,
w:number,
x:Color3,
y:number
)
local z=g.softRing({
color=ColorSequence.new(x),
width0=y,
width1=y,
transparency=NumberSequence.new(0.2),
texture=g.SMOKE,
speed=3,
length=3,
emission=if x==l then 0 else 1,
})
local A=CFrame.lookAt(s,s+t)*CFrame.Angles(i(90),0,0)
z.set(A,u)
g.every(w,function(B)
local C=1-(1-B/w)^3
z.set(A,u+(v-u)*C)
return true
end)
z.fade(w)
end


local function s(t:Context,u:BasePart,v:number)
t.trailEmitter(u,{
Texture=h.textures.Smoke,
Color=ColorSequence.new(l,Color3.fromRGB(40,10,12)),
LightEmission=0,
Size=NumberSequence.new({k(0,1.8),k(1,3.6)}),
Transparency=NumberSequence.new({k(0,0.2),k(1,1)}),
Lifetime=NumberRange.new(0.25,0.4),
Rate=120,
Speed=NumberRange.new(1,3),
SpreadAngle=Vector2.new(40,40),
Drag=3,
},v)
local w=g.trail(u,Vector3.new(0,1,0),Vector3.new(0,-1,0),{
color=ColorSequence.new(m,n),
transparency=NumberSequence.new({k(0,0.25),k(1,1)}),
lifetime=0.2,
width=NumberSequence.new(1,0.2),
})
task.delay(v,g.endTrail,w)
end


function p.Play(t:Context,u,v:Model,w:BasePart):(()->())?
if typeof(u.origin)~="CFrame"or typeof(u.start)~="Vector3"then
return nil
end
local x=c.Times
local y=c.Plan(u.origin,u.start,tonumber(u.floorY)or u.start.Y-3)
local z=y.right
local A:Model?=if typeof(u.target)=="Instance"and u.target:IsA("Model")then u.target else nil
local B=h.getRoot(A)
local C=h.isLocal(v)or h.isLocal(A)
local D=os.clock()
local E=false
local F=Vector3.new(y.start.X,y.floorY,y.start.Z)

local function G(H:number,I:()->())
task.delay(math.max(H-(os.clock()-D),0),function()
if not E and v.Parent then
I()
end
end)
end
local function H(I:number):Vector3
if B and B.Parent and I<=x.Land then
return B.Position
end
return c.Victim(y,math.min(I,x.Land)).Position
end


local I="CloverBlackAscent"..tostring(D)
local J:()->()
function J()
if E then
return
end
E=true
pcall(function()
b:UnbindFromRenderStep(I)
end)
end
b:BindToRenderStep(I,Enum.RenderPriority.Camera.Value+3,function()
local K=os.clock()-D
if K>x.Length then
J()
return
end
if w.Parent then
w.CFrame=c.Attacker(y,K)
end
if B and B.Parent and K<=x.Land then
B.CFrame=c.Victim(y,K)
end
end)
task.delay(x.Length+0.5,J)

t.play(v,t.anims.Ascent)
if A then
local K=t.launched(A)
if K then
f.Play(A,K)
end
end
local K=t.wings(v)
local function L(M:string?,N:boolean?)
if K then
if K.setPose then
K.setPose(M)
end
if N and K.flap then
K.flap()
end
end
end

h.groundCracks(F,7,6,m,1.6)
h.debris(F,10,34,0.8)
h.burst(F+j*0.5,{
texture=h.textures.Smoke,
color=o,
count=14,
size=3.5,
speed=NumberRange.new(10,22),
lifetime=NumberRange.new(0.5,0.9),
lightEmission=0,
transparency=0.45,
drag=4,
spread=70,
})
r(F+j*0.4,j,1,10,0.4,Color3.fromRGB(70,62,56),1.8)
t.glowBurst(y.start+j,4,0.3)
t.redSparks(y.start,14,0.6,j)
if B then
s(t,B,x.Rise)
end


G(0.08,function()
local M=Vector3.new(w.Position.X,y.floorY,w.Position.Z)
h.ringBurst(CFrame.new(M+j*0.2),o,1,7,0.35,0.3)
t.blackSmoke(M+j*0.5,8,3,10)
h.groundCracks(M,4,3,m,1)
L("spread",true)
end)
h.bodyTrail(v,m,x.Land)
t.heavyTrail(v,x.Length)
t.swordAura(v,x.Length,30)


local M={
{from=70,to=-110,tilt=12,side=-z,line=z*5.5+j*0.8},
{from=-100,to=80,tilt=62,side=z+j*0.6,line=z*4.5+j*4},
}
for N,O in x.Cuts do
local P=M[N]
G(O-0.06,function()
t.edgeGlow(v,0.2,1)
t.crescent(v,{
center=CFrame.new(0,0.5,0),
radius=5.2,
from=P.from,
to=P.to,
tilt=P.tilt,
width=1.8,
sweep=0.07,
fade=0.3,
glow=0.8,
})
end)
G(O,function()
local Q=H(O)
local R=(P.side::Vector3).Unit
t.cutLine(Q-P.line,Q+P.line,0.32,x.Spike-O)
t.glowBurst(Q,4,0.25)
t.redSparks(Q,16,0.6,R)
t.blackLightning(Q,3,4,0.18)
h.impactRing(Q,R,m,1,6,0.25)
r(Q,R,1,7,0.3,l,1.4)
h.afterimage(v,m,0.3)
t.bloomPulse(Q,0.45,0.2)
end)
end



G(x.Spike-0.07,function()
L("spread",true)
t.edgeGlow(v,0.25,1.2)
t.crescent(v,{
center=CFrame.new(0,0.6,0),
radius=6,
from=110,
to=-60,
tilt=90,
width=2.2,
sweep=0.08,
fade=0.35,
glow=1,
})
end)
G(x.Spike,function()
local N=H(x.Spike)
t.cutLine(N+j*5,N-j*5,0.4,0.12)
t.glowBurst(N,6,0.3)
t.redSparks(N,20,0.7,-j)
t.blackLightning(N,5,6,0.2)
h.flash(N,l,7,0.18)
r(N,j,1.5,11,0.35,l,2)
g.lightRing(N,j,1,10,0.3,m)
t.bloomPulse(N,0.7,0.3)
if B then
s(t,B,x.Land-x.Spike+0.05)
end
if C then
t.impactFrame(0.45)
end
end)


G(x.Land,function()
h.shockwave(F,m,2,18,0.4)
h.shockwave(F,l,2,13,0.5)
h.groundCracks(F,10,9,m,2.2)
h.groundRocks(F,10,6,1.6)
h.debris(F,16,42,0.9)
r(F+j*0.5,j,2,16,0.55,Color3.fromRGB(80,72,64),2.6)
g.lightRing(F+j*0.3,j,1,14,0.4,m)
t.blackSmoke(F+j,14,4,12)
t.glowBurst(F+j,5,0.35)
t.blackLightning(F+j*0.5,5,7,0.22)
t.lingerSmoke(F,1.6,9)
t.bloomPulse(F,0.8,0.35)
h.light(F+j*2,m,8,24,0.45)
if C then
t.impactFrame(0.6)
elseif(workspace.CurrentCamera.CFrame.Position-F).Magnitude<50 then
d.Add(0.2)
end
end)

G(x.Land+0.15,function()
local N=Vector3.new(w.Position.X,y.floorY,w.Position.Z)
h.ringBurst(CFrame.new(N+j*0.2),o,1,6,0.3,0.25)
t.blackSmoke(N+j*0.5,6,2.5,6)
L(nil)
end)
task.delay(x.Length+0.6,function()
L(nil)
end)

if C then
h.colorGrade(
{Contrast=0.12,Saturation=-0.12,TintColor=Color3.fromRGB(255,238,238)},
0.15,
x.Length-0.25,
0.4
)
local N=p.Camera(y)
local O=J
J=function()
O()
N()
end
end
return J
end

function p.Camera(t:c.Plan):()->()
local u=c.Times
local v,w,x=t.forward,t.right,t.top
local function y(z:number):Vector3
return c.Attacker(t,z).Position
end
local function z(A:number):Vector3
return c.Victim(t,math.min(A,u.Land)).Position
end
local function A(B:number,C:number,D:number):number
if B<C then
return 0
end
local E=(B-C)/0.07
return D*E*math.exp(1-E)
end
local B=Vector3.new(t.start.X,t.floorY,t.start.Z)
return e.Camera(function(C)
local D=math.min(C,u.Length)
local E=q(D/0.45)
local F=i(25+25*q(D/0.35)+50*q((D-0.6)/0.35))
local G=-v*math.cos(F)+w*math.sin(F)
local H=t.start.Y+0.5+(x.Y-1.5-t.start.Y-0.5)*E
local I=Vector3.new(x.X,H,x.Z)+G*(11+3*E)


local J=q((D-u.Spike)/(u.Land+0.2-u.Spike))
I=I:Lerp(B+G*13+j*4,J*0.75)
local K=z(D):Lerp(y(D),0.4)
local L=K:Lerp(B+j*1.5-v*1,J)
local M=72-4*E+4*J
for N,O in u.Cuts do
M-=A(D,O,3+N)
end
M-=A(D,u.Spike,6)+A(D,u.Land,8)
return CFrame.lookAt(I,L)*CFrame.Angles(0,0,i(-2+4*E-2*J)),M
end,u.Length+0.05)
end

return p]]></string>
