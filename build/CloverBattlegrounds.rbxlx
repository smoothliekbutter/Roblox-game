          <string name="Name">TempestDive</string>
          <string name="Source"><![CDATA[

local a={}

local b=Vector3.yAxis

a.Times={
Lift=1.1,
Flip=1.55,
Ticks={1.85,2.1,2.3},
Land=2.5,
Length=3.1,
}
a.Height=34
a.Hold=2.6
a.Spins=3

export type Plan={
origin:CFrame,
start:Vector3,
forward:Vector3,
floorY:number,
}

local function c(d:number):number
d=math.clamp(d,0,1)
return d*d*(3-2*d)
end

function a.Plan(d:CFrame,e:Vector3,f:number):Plan
local g=e-d.Position
local h=Vector3.new(g.X,0,g.Z)
if h.Magnitude<1e-3 then
h=Vector3.new(d.LookVector.X,0,d.LookVector.Z)
end
return{
origin=d,
start=e,
forward=if h.Magnitude>1e-3 then h.Unit else Vector3.new(0,0,-1),
floorY=f,
}
end

local function d(e:Vector3):CFrame
return CFrame.lookAt(Vector3.zero,e)
end

local function e(f:number):number
return a.Height*(1-(1-math.clamp(f,0,1))^2)
end


function a.Impact(f:Plan):Vector3
return Vector3.new(f.start.X,f.floorY+2.5,f.start.Z)
end

local function f(g:Plan):Vector3
return g.start+b*a.Height
end


function a.DiveAt(g:Plan,h:number):Vector3
return f(g):Lerp(a.Impact(g),h*h)
end

function a.Spin(g:number):number
return g*g*a.Spins*2*math.pi
end

function a.Victim(g:Plan,h:number):CFrame
local i=a.Times
local j=d(-g.forward)
if h<=i.Lift then

local k=h/i.Lift
return CFrame.new(g.start+b*e(k))
*j
*CFrame.Angles(math.rad(-15)*math.sin(k*math.pi),0,0)
end
if h<=i.Flip then
local k=c((h-i.Lift)/(i.Flip-i.Lift))
return CFrame.new(f(g))*j*CFrame.Angles(math.pi*k,0,0)
end
local k=math.clamp((h-i.Flip)/(i.Land-i.Flip),0,1)
return CFrame.new(a.DiveAt(g,k))
*CFrame.Angles(0,-a.Spin(k),0)
*j
*CFrame.Angles(math.pi,0,0)
end

function a.Attacker(g:Plan,h:number):CFrame
local i=a.Times
local j=d(g.forward)
local k=b*a.Hold-g.forward*0.8
if h<=i.Lift then

local l=g.start+b*e(h/i.Lift)+k
return CFrame.new(g.origin.Position:Lerp(l,c(h/0.2)))*j
end
local l=f(g)+b*3.2
if h<=i.Flip then

local m=c((h-i.Lift)/(i.Flip-i.Lift))
local n=(f(g)+k):Lerp(l,m)+b*math.sin(m*math.pi)*1.5
return CFrame.new(n)*j*CFrame.Angles(math.pi*m,0,0)
end
if h<=i.Land then

local m=(h-i.Flip)/(i.Land-i.Flip)
return CFrame.new(a.DiveAt(g,m)+b*3.2)
*CFrame.Angles(0,-a.Spin(m),0)
*j
*CFrame.Angles(math.pi,0,0)
end

local m=math.clamp((h-i.Land)/(i.Length-i.Land),0,1)
local n=a.Impact(g)+b*3.2
local o=Vector3.new(g.start.X,g.floorY+3,g.start.Z)-g.forward*5
local p=n:Lerp(o,c(m))+b*math.sin(m*math.pi)*5
return CFrame.new(p)*j*CFrame.Angles(math.pi*(1+c(m)),0,0)
end

return a]]></string>
