        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">M1Animations</string>
            <string name="Source"><![CDATA[--[[
	M1Animations
	R6 punch/kick animations for the M1 string, built for PoseAnimator.

	The string is: right jab, left cross, right hook, then a finisher:
	  Knockback  spinning front kick
	  Uppercut   rising right uppercut (jump held)
	  Downslam   double-fist hammer (in the air)

	Timing lines up with the server: normal hits land ~0.08s after input
	(Config.M1.WindUp), finishers ~0.15s (Config.M1.FinisherWindUp).
	The "Strike" event is when the limb starts moving fast (trails turn on).
]]

local PoseAnimator = require(script.Parent.PoseAnimator)

type Animation = PoseAnimator.Animation

local rad = math.rad

-- Torso / head / leg rotation. x leans back (+) or forward (-), y twists left (+).
local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

-- Arm/leg aim. pitch raises the limb forward (90 = straight ahead, 180 = up),
-- yaw swings it horizontally (+ = toward the left), roll swings it out sideways
-- (+ = to the right).
local function limb(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, rad(yaw or 0), 0) * CFrame.Angles(0, 0, rad(roll or 0)) * CFrame.Angles(rad(pitch), 0, 0)
end

-- The legs twist against the torso so the feet stay planted. They're
-- additive, so walking still plays underneath.
local LEGS_ADDITIVE = { RightLeg = true, LeftLeg = true }

local Clips: { [string]: Animation } = {}

local M1Animations = {}
M1Animations.Clips = Clips

Clips.Jab = {
	fadeIn = 0.03,
	fadeOut = 0.16,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.04, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -6),
				RightArm = limb(60, 20),
				LeftArm = limb(75, -25),
				RightLeg = rot(0, 6),
				LeftLeg = rot(0, 6),
			},
		},
		{
			time = 0.04,
			pose = {
				Torso = rot(0, -16),
				RightArm = limb(45, 10),
				LeftArm = limb(80, -28),
				Head = rot(0, 14),
				RightLeg = rot(0, 16),
				LeftLeg = rot(0, 16),
			},
		},
		{
			time = 0.1,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-5, 22),
				RightArm = limb(94, 12),
				LeftArm = limb(62, -30),
				Head = rot(0, -18),
				RightLeg = rot(0, -22),
				LeftLeg = rot(0, -22),
			},
		},
		{
			time = 0.2,
			pose = {
				Torso = rot(-4, 18),
				RightArm = limb(90, 12),
				LeftArm = limb(62, -30),
				Head = rot(0, -15),
				RightLeg = rot(0, -18),
				LeftLeg = rot(0, -18),
			},
		},
	},
}

Clips.Cross = {
	fadeIn = 0.03,
	fadeOut = 0.16,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.04, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, 10),
				RightArm = limb(80, 28),
				LeftArm = limb(60, -18),
				RightLeg = rot(0, -10),
				LeftLeg = rot(0, -10),
			},
		},
		{
			time = 0.04,
			pose = {
				Torso = rot(0, 18),
				RightArm = limb(80, 28),
				LeftArm = limb(42, -10),
				Head = rot(0, -14),
				RightLeg = rot(0, -18),
				LeftLeg = rot(0, -18),
			},
		},
		{
			time = 0.1,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-6, -24),
				RightArm = limb(62, 30),
				LeftArm = limb(94, -12),
				Head = rot(0, 20),
				RightLeg = rot(0, 24),
				LeftLeg = rot(0, 24),
			},
		},
		{
			time = 0.2,
			pose = {
				Torso = rot(-5, -20),
				RightArm = limb(62, 30),
				LeftArm = limb(90, -12),
				Head = rot(0, 16),
				RightLeg = rot(0, 20),
				LeftLeg = rot(0, 20),
			},
		},
	},
}

Clips.Hook = {
	fadeIn = 0.03,
	fadeOut = 0.18,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.05, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -10),
				RightArm = limb(70, -10),
				LeftArm = limb(75, -25),
				RightLeg = rot(0, 10),
				LeftLeg = rot(0, 10),
			},
		},
		{
			-- Arm swings out wide to the right.
			time = 0.05,
			pose = {
				Torso = rot(0, -28),
				RightArm = limb(75, -55),
				LeftArm = limb(80, -28),
				Head = rot(0, 22),
				RightLeg = rot(0, 26),
				LeftLeg = rot(0, 26),
			},
		},
		{
			-- ...and sweeps across the body.
			time = 0.12,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-7, 32),
				RightArm = limb(88, 40),
				LeftArm = limb(65, -30),
				Head = rot(0, -26),
				RightLeg = rot(0, -30),
				LeftLeg = rot(0, -30),
			},
		},
		{
			time = 0.22,
			pose = {
				Torso = rot(-6, 28),
				RightArm = limb(85, 38),
				LeftArm = limb(65, -30),
				Head = rot(0, -22),
				RightLeg = rot(0, -26),
				LeftLeg = rot(0, -26),
			},
		},
	},
}

-- Knockback finisher: chambered front kick. Legs are fully posed here.
Clips.Kick = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -8),
				RightArm = limb(70, 20),
				LeftArm = limb(75, -25),
			},
		},
		{
			-- Chamber: knee comes back, body coils.
			time = 0.09,
			pose = {
				Torso = rot(8, -14),
				RightArm = limb(25, 0, 25),
				LeftArm = limb(60, -20),
				Head = rot(-6, 10),
				RightLeg = rot(-30),
				LeftLeg = rot(5),
			},
		},
		{
			-- Snap the leg straight out.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(20, 16),
				RightArm = limb(-20, 0, 45),
				LeftArm = limb(10, 0, -70),
				Head = rot(-18, -12),
				RightLeg = rot(98),
				LeftLeg = rot(-20), -- cancels the torso lean so the standing leg stays vertical
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(18, 14),
				RightArm = limb(-15, 0, 40),
				LeftArm = limb(10, 0, -65),
				Head = rot(-16, -10),
				RightLeg = rot(92),
				LeftLeg = rot(-18),
			},
		},
	},
}

Clips.Uppercut = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -8),
				RightArm = limb(60, 15),
				LeftArm = limb(75, -25),
			},
		},
		{
			-- Dip down and load the right arm low.
			time = 0.09,
			pose = {
				Torso = rot(-18, -18),
				RightArm = limb(-25, 5),
				LeftArm = limb(80, -28),
				Head = rot(12, 12),
				RightLeg = rot(-8, 18),
				LeftLeg = rot(15, 18),
			},
		},
		{
			-- Rip upward.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(14, 22),
				RightArm = limb(168, 10),
				LeftArm = limb(35, -20),
				Head = rot(-20, -16),
				RightLeg = rot(0, -20),
				LeftLeg = rot(0, -20),
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(12, 18),
				RightArm = limb(165, 10),
				LeftArm = limb(35, -20),
				Head = rot(-18, -14),
				RightLeg = rot(0, -16),
				LeftLeg = rot(0, -16),
			},
		},
	},
}

Clips.Downslam = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0),
				RightArm = limb(80, 10),
				LeftArm = limb(80, -10),
			},
		},
		{
			-- Both fists raised overhead, body arched back.
			time = 0.09,
			pose = {
				Torso = rot(18),
				RightArm = limb(172, 12),
				LeftArm = limb(172, -12),
				Head = rot(-15),
				RightLeg = rot(-20),
				LeftLeg = rot(10),
			},
		},
		{
			-- Hammer down.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-32),
				RightArm = limb(45, 15),
				LeftArm = limb(45, -15),
				Head = rot(18),
				RightLeg = rot(30),
				LeftLeg = rot(20),
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(-28),
				RightArm = limb(50, 15),
				LeftArm = limb(50, -15),
				Head = rot(15),
				RightLeg = rot(25),
				LeftLeg = rot(18),
			},
		},
	},
}

-- Which limbs leave a trail on each move.
M1Animations.Strikers = {
	Jab = { "Right Arm" },
	Cross = { "Left Arm" },
	Hook = { "Right Arm" },
	Kick = { "Right Leg" },
	Uppercut = { "Right Arm" },
	Downslam = { "Right Arm", "Left Arm" },
}

local STRING = { "Jab", "Cross", "Hook" }
local FINISHERS = { Knockback = "Kick", Uppercut = "Uppercut", Downslam = "Downslam" }

-- Animation name for combo hit `index` with finisher `variant`.
function M1Animations.NameFor(index: number, variant: string): string
	if variant ~= "Normal" then
		return FINISHERS[variant] or "Kick"
	end
	return STRING[((index - 1) % #STRING) + 1]
end

return M1Animations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Moves</string>
            <string name="Source"><![CDATA[--[[
	Moves
	Plays move animations + their VFX on characters, routed to each
	character's kit (Client/Kits/<KitId>). Characters without a kit (the
	dummies) use the default fist M1s.

	Your own M1s play instantly when you click (predicted by Input), so they
	feel responsive at any ping. Everyone else's play when the server's
	"Swing" event arrives. Skills are driven by the server's "Skill" events.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Kits = require(ReplicatedStorage:WaitForChild("Shared").Kits)
local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local M1Animations = require(script.Parent.M1Animations)
local PoseAnimator = require(script.Parent.PoseAnimator)
local Reactions = require(script.Parent.Reactions)
local VFX = require(script.Parent.VFX)

local localPlayer = Players.LocalPlayer

local TRAIL_TIME = 0.14

local clientKits: { [string]: any } = {}
for _, module in script.Parent:WaitForChild("Kits"):GetChildren() do
	if module:IsA("ModuleScript") then
		clientKits[module.Name] = require(module) :: any
	end
end

local Moves = {}

local function kitOf(character: Model): any
	local id = character:GetAttribute("Kit")
	return if type(id) == "string" then clientKits[id] else nil
end

-- Default M1s: punches and a kick.
local function playFistM1(character: Model, index: number, variant: string)
	local name = M1Animations.NameFor(index, variant)
	local animation = M1Animations.Clips[name]
	if not animation then
		return
	end
	local heavy = variant ~= "Normal"
	local strikers = M1Animations.Strikers[name] or {}

	PoseAnimator.Play(character, animation, function(event)
		if event == "Strike" then
			for _, limbName in strikers do
				VFX.LimbTrail(character, limbName, if heavy then TRAIL_TIME * 1.5 else TRAIL_TIME)
			end
			VFX.AirPop(character, heavy)
		end
	end)
end

function Moves.PlayM1(character: Model, index: number, variant: string)
	local kit = kitOf(character)
	if kit and kit.PlayM1 then
		kit.PlayM1(character, index, variant)
	else
		playFistM1(character, index, variant)
	end
end

---------------------------------------------------------------------------
-- Getting hit and blocking
---------------------------------------------------------------------------

-- A character's own reaction (Kit.Reactions) or the default one.
local function reactionFor(character: Model, name: string): PoseAnimator.Animation?
	local kit = kitOf(character)
	local own = kit and kit.Reactions and kit.Reactions[name]
	return own or Reactions[name]
end

local function asModel(value: unknown): Model?
	return if typeof(value) == "Instance" and value:IsA("Model") then value else nil
end

-- Characters being held in a grab (see pinGrab), by victim.
local grabs: { [Model]: { stop: () -> () } } = {}

local function react(character: Model, name: string)
	if character:GetAttribute("Ragdolled") == true then
		return -- the ragdoll is the reaction
	end
	if grabs[character] and name ~= "Grabbed" then
		return -- they keep struggling in the grip
	end
	local animation = reactionFor(character, name)
	if animation then
		PoseAnimator.Play(character, animation)
	end
end

local GUARD_ANIMS = { Guard = true, GuardHit = true }
local lastFlinchSide: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function isGuardPlaying(character: Model): boolean
	local current = PoseAnimator.Current(character)
	if not current then
		return false
	end
	for name in GUARD_ANIMS do
		if current == reactionFor(character, name) then
			return true
		end
	end
	return false
end

local function onLandedHit(name: string, data)
	local victim = data.victim
	if typeof(victim) ~= "Instance" or not victim:IsA("Model") then
		return
	end
	if name == "HeavyHit" or name == "PerfectDivider" then
		react(victim, "HitHeavy")
		return
	end
	-- Hit from behind throws them forward; otherwise alternate sides.
	local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
	local attacker = data.attacker
	local attackerRoot = if typeof(attacker) == "Instance"
		then attacker:FindFirstChild("HumanoidRootPart") :: BasePart?
		else nil
	if victimRoot and attackerRoot then
		local toAttacker = attackerRoot.Position - victimRoot.Position
		if victimRoot.CFrame.LookVector:Dot(Vector3.new(toAttacker.X, 0, toAttacker.Z).Unit) < -0.3 then
			react(victim, "FlinchBack")
			return
		end
	end
	local side = not lastFlinchSide[victim]
	lastFlinchSide[victim] = side
	react(victim, if side then "FlinchA" else "FlinchB")
end

--[[
	Grabs. The server holds the victim in place for hitboxes, but its
	position reaches us a ping late, which looks loose when the grabber is
	moving fast (Black Meteorite's rise and slam). So every client pins the
	victim to the grabber's hand itself, every frame: the hand's grip point
	is at their throat, facing the grabber, never sunk into the floor.
]]
local GRAB_NECK = 0.85 -- grip point to the victim's root
local GRAB_REACH = 0.6 -- the victim's root sits this far past the hand
local GRAB_FLOOR = 2.6 -- lowest the victim's root goes above the ground

local function pinGrab(data)
	local victim, attacker = asModel(data.victim), asModel(data.attacker)
	if not victim or not attacker then
		return
	end
	local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
	local attackerRoot = attacker:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not victimRoot or not attackerRoot then
		return
	end
	local existing = grabs[victim]
	if existing then
		existing.stop()
	end

	local offset: CFrame = if typeof(data.offset) == "CFrame" then data.offset else CFrame.new(0, 0, -3)
	local handName: string? = if type(data.hand) == "string" then data.hand else nil
	local duration = (tonumber(data.duration) or 2) + 0.3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { victim, attacker, VFX.Util.folder }
	local floorY: number? = nil
	local nextFloorCheck = 0
	local started = os.clock()

	local entry = {} :: { stop: () -> () }
	local connection
	entry.stop = function()
		if grabs[victim] ~= entry then
			return
		end
		grabs[victim] = nil
		connection:Disconnect()
		if PoseAnimator.Current(victim) == reactionFor(victim, "Grabbed") then
			PoseAnimator.FadeOut(victim, 0.2)
		end
	end
	grabs[victim] = entry

	connection = RunService.RenderStepped:Connect(function()
		if os.clock() - started > duration or not victimRoot.Parent or not attackerRoot.Parent then
			entry.stop()
			return
		end
		local target = attackerRoot.CFrame * offset
		local hand = if handName then attacker:FindFirstChild(handName) else nil
		if hand and hand:IsA("BasePart") then
			local grip = (hand.CFrame * CFrame.new(0, -1, 0)).Position
			local look = attackerRoot.CFrame.LookVector
			local forward = Vector3.new(look.X, 0, look.Z)
			forward = if forward.Magnitude > 1e-3 then forward.Unit else Vector3.new(0, 0, -1)
			local position = grip + forward * GRAB_REACH - Vector3.new(0, GRAB_NECK, 0)
			target = CFrame.lookAt(position, position - forward)
		end
		local now = os.clock()
		if now >= nextFloorCheck then
			nextFloorCheck = now + 0.1
			local hit = workspace:Raycast(target.Position + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), params)
			floorY = if hit then hit.Position.Y else nil
		end
		if floorY and target.Position.Y < floorY + GRAB_FLOOR then
			target += Vector3.new(0, floorY + GRAB_FLOOR - target.Position.Y, 0)
		end
		victimRoot.CFrame = target
	end)
	react(victim, "Grabbed")
end

-- Holding block shows the guard; letting go fades it out.
local function watchBlocking(character: Model)
	local function update()
		if character:GetAttribute("Blocking") == true then
			react(character, "Guard")
		elseif isGuardPlaying(character) then
			PoseAnimator.FadeOut(character, 0.15)
		end
	end
	character:GetAttributeChangedSignal("Blocking"):Connect(update)
	if character:GetAttribute("Blocking") == true then
		update()
	end
end

-- Kit stances and Black Form style looks follow the "Kit" and "Awakened"
-- attributes on every player.
local function watchCharacter(character: Model)
	-- The character can arrive before its joints have replicated.
	local torso = character:WaitForChild("Torso", 5)
	if torso then
		torso:WaitForChild("Right Shoulder", 5)
	end

	local function updateAwakened()
		local kit = kitOf(character)
		if kit and kit.SetAwakened then
			kit.SetAwakened(character, character:GetAttribute("Awakened") == true)
		end
	end
	local function updateKit()
		local kit = kitOf(character)
		PoseAnimator.SetIdle(character, if kit then kit.Idle else nil)
	end
	character:GetAttributeChangedSignal("Awakened"):Connect(updateAwakened)
	character:GetAttributeChangedSignal("Kit"):Connect(updateKit)
	updateAwakened()
	updateKit()
	watchBlocking(character)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
end

function Moves.Start()
	PoseAnimator.Start()

	-- Heavy hits: the attacker's swing also freezes for the hit-stop, so the
	-- impact feels like it connected.
	local HEAVY_EFFECTS = { HeavyHit = true, PerfectDivider = true }
	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if type(data) ~= "table" then
			return
		end
		if HEAVY_EFFECTS[name] and typeof(data.attacker) == "Instance" then
			PoseAnimator.Freeze(data.attacker :: Model, Config.Physics.HitStop)
		end

		if name == "Grabbed" then
			pinGrab(data)
			return
		elseif name == "GrabReleased" then
			local victim = asModel(data.victim)
			local grab = victim and grabs[victim]
			if grab then
				grab.stop()
			end
			return
		end

		-- Reactions on whoever got hit.
		if data.hitConfirm then
			onLandedHit(name, data)
		else
			local victim, attacker = asModel(data.victim), asModel(data.attacker)
			if name == "Block" and victim then
				react(victim, "GuardHit")
			elseif name == "GuardBreak" and victim then
				react(victim, "Stagger")
			elseif name == "PerfectBlock" and attacker then
				react(attacker, "Stagger")
			end
		end
	end)

	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if type(data) ~= "table" then
			return
		end
		local character = data.character
		if typeof(character) ~= "Instance" or not character:IsA("Model") then
			return
		end

		if name == "Swing" then
			-- Our own swing already played the moment we clicked.
			if character ~= localPlayer.Character then
				Moves.PlayM1(character, data.index or 1, data.variant or "Normal")
			end
		elseif name == "Skill" then
			local kit = if type(data.kit) == "string" then clientKits[data.kit] else nil
			if kit and kit.OnSkill then
				kit.OnSkill(data)
			end
		end
	end)

	-- Character switch: a flash in the new character's color.
	VFX.Register("KitSwitch", function(data)
		local character = data.character
		local kit = Kits.Get(data.kit)
		local root = VFX.Util.getRoot(character)
		if not root or not kit then
			return
		end
		VFX.Util.afterimage(character, kit.color, 0.5)
		VFX.Util.flash(root.Position, kit.color, 8, 0.3)
		VFX.Util.ringBurst(CFrame.new(root.Position - Vector3.new(0, 2.8, 0)), kit.color, 1, 8, 0.35, 0.25)
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end

	-- Dummies block too.
	task.spawn(function()
		local dummies = workspace:WaitForChild("Dummies", 30)
		if dummies then
			dummies.ChildAdded:Connect(function(child)
				if child:IsA("Model") then
					watchBlocking(child)
				end
			end)
			for _, child in dummies:GetChildren() do
				if child:IsA("Model") then
					watchBlocking(child)
				end
			end
		end
	end)
end

return Moves
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PoseAnimator</string>
            <string name="Source"><![CDATA[--[[
	PoseAnimator
	Keyframe animations defined in code, played by overriding Motor6D.Transform
	every frame. No uploaded animation assets needed, so they work in any place
	without animation permissions.

	Runs on every client for every character: the server tells clients
	"this character swung", each client animates it locally.

	Poses rotate a limb around its joint in the PARENT part's space:
	  Torso       RootJoint, relative to HumanoidRootPart
	  Head        Neck, relative to Torso
	  RightArm    Right Shoulder, relative to Torso
	  LeftArm     Left Shoulder
	  RightLeg    Right Hip
	  LeftLeg     Left Hip
	  Sword       SwordGrip (a weapon's wrist), relative to the right arm
	Axes: X = right, Y = up, Z = back. So for a limb hanging down,
	  +X rotation swings it forward, +Y turns it to the left,
	  +Z swings it out to the right. For the Torso, +X leans back.

	Two layers per character:
	  idle   a looping stance, one version for standing still and one for
	         moving, blended by how fast the character is going
	  track  one-shot animations (attacks, skills) that blend in from
	         wherever the body is and back out into the idle
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

export type Pose = { [string]: CFrame }

export type Keyframe = {
	time: number,
	pose: Pose,
	easing: Enum.EasingStyle?, -- easing INTO this keyframe (default Quad)
	direction: Enum.EasingDirection?, -- (default Out)
}

export type Animation = {
	keyframes: { Keyframe },
	fadeIn: number?,
	fadeOut: number?,
	loop: boolean?,
	-- Joints whose pose is layered on top of the layer below instead of
	-- replacing it (e.g. legs counter-twisting while still walking).
	additive: { [string]: boolean }?,
	-- Overlapping action: a joint with a delay follows the animation that
	-- many seconds late (negative leads), so the body leads and the arm and
	-- weapon drag behind like in hand-made animation.
	delays: { [string]: number }?,
	events: { { time: number, name: string } }?,
}

export type IdleSet = {
	stand: Animation?, -- played while standing still
	move: Animation?, -- played while moving (a run cycle)
	walk: Animation?, -- played while moving slowly; blends into `move` as speed picks up
	air: Animation?, -- played while jumping or falling
	-- The speeds the run and walk cycles are animated for; they play faster
	-- or slower with the character's actual speed so feet don't slide.
	moveSpeed: number?,
	walkSpeed: number?,
}

local JOINTS = {
	Torso = "RootJoint",
	Head = "Neck",
	RightArm = "Right Shoulder",
	LeftArm = "Left Shoulder",
	RightLeg = "Right Hip",
	LeftLeg = "Left Hip",
	Sword = "SwordGrip",
}

local STAND_SPEED = 1.5 -- studs/s; slower than this counts as standing still
local STANCE_BLEND = 8 -- how fast the idle switches between stand and move
local AIR_HEIGHT = 3.6 -- no ground this far under the root counts as airborne (R6 stands at 3)
local AIR_BLEND = 10
local TURN_BLEND = 10 -- how fast the legs swing round to a new movement direction

type Track = {
	animation: Animation,
	joints: { [string]: Motor6D },
	start: number,
	length: number,
	onEvent: ((name: string) -> ())?,
	firedEvents: { [number]: boolean },
	-- Where each joint actually was when this track started, so a new swing
	-- blends from the previous swing's pose instead of snapping to idle.
	from: { [string]: CFrame },
	-- Hit-stop: the animation holds still until this time.
	freezeUntil: number,
	frozenAt: number,
	-- Set when the track is told to stop early (FadeOut).
	fadeOutOverride: number?,
}

type Idle = {
	set: IdleSet,
	covered: { [string]: boolean },
	joints: { [string]: Motor6D },
	start: number,
	standWeight: number,
	airWeight: number,
	-- Where in the step cycle the legs are (0 to 1), shared by walk and run
	-- so they blend without the legs fighting.
	phase: number,
	-- Movement direction relative to facing (degrees, + is right), folded
	-- into -75..75; backWeight says it's actually backwards.
	moveYaw: number,
	backWeight: number,
	airborne: boolean,
	nextGroundCheck: number,
	rayParams: RaycastParams,
	nextJointScan: number,
}

local tracks: { [Model]: Track } = {}
local idles: { [Model]: Idle } = {}
-- What we wrote to each joint last frame. If the default Animator didn't
-- overwrite it, the joint has no base animation and its base is identity.
local lastWritten: { [Motor6D]: CFrame } = {}
local posedCache: { [Animation]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any

local PoseAnimator = {}

local function findJoints(character: Model): { [string]: Motor6D }
	local found = {}
	for poseName, jointName in JOINTS do
		local joint = character:FindFirstChild(jointName, true)
		if joint and joint:IsA("Motor6D") then
			found[poseName] = joint
		end
	end
	return found
end

local function ease(alpha: number, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): number
	return TweenService:GetValue(alpha, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
end

-- Smooth 0..1 ramp (no sudden starts/stops) for fading tracks in and out.
local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function lengthOf(animation: Animation): number
	local keyframes = animation.keyframes
	return keyframes[#keyframes].time
end

local function posed(animation: Animation): { [string]: boolean }
	local cached = posedCache[animation]
	if cached then
		return cached
	end
	local set = {}
	for _, keyframe in animation.keyframes do
		for poseName in keyframe.pose do
			set[poseName] = true
		end
	end
	posedCache[animation] = set
	return set
end

-- The animation's pose for one joint at time t (identity if never posed).
-- Applies the joint's delay; looping animations wrap around.
local function sample(animation: Animation, poseName: string, t: number): CFrame
	local delays = animation.delays
	if delays and delays[poseName] then
		t -= delays[poseName]
	end
	local keyframes = animation.keyframes
	if animation.loop then
		local length = keyframes[#keyframes].time
		if length > 0 then
			t %= length
		end
	end

	local previous = keyframes[1]
	if t <= previous.time then
		return previous.pose[poseName] or CFrame.identity
	end
	for i = 2, #keyframes do
		local nextFrame = keyframes[i]
		if t <= nextFrame.time then
			local span = nextFrame.time - previous.time
			local alpha = if span > 0 then (t - previous.time) / span else 1
			local from = previous.pose[poseName] or CFrame.identity
			local to = nextFrame.pose[poseName] or CFrame.identity
			return from:Lerp(to, ease(alpha, nextFrame.easing, nextFrame.direction))
		end
		previous = nextFrame
	end
	return previous.pose[poseName] or CFrame.identity
end

-- Parent-part-space pose -> the joint's own space.
local function toJointSpace(joint: Motor6D, pose: CFrame): CFrame
	local c0 = joint.C0.Rotation
	return c0:Inverse() * pose * c0
end

-- What the default Animator (walk/idle) set this frame, or identity if
-- nothing but us animates this joint.
local function animatorBase(joint: Motor6D): CFrame
	local current = joint.Transform
	return if lastWritten[joint] == current then CFrame.identity else current
end

local function write(joint: Motor6D, value: CFrame)
	joint.Transform = value
	lastWritten[joint] = value
end

local function release(track: Track, character: Model)
	-- Hand the joints back; the default Animator overwrites them next frame
	-- if it's animating them. Joints the idle covers stay put, the idle
	-- takes over next frame.
	local idle = idles[character]
	for poseName, joint in track.joints do
		if idle and idle.joints[poseName] then
			continue
		end
		if lastWritten[joint] then
			lastWritten[joint] = nil
			if joint.Parent then
				joint.Transform = CFrame.identity
			end
		end
	end
end

-- One idle animation's value for a joint (joint space), or nil if it doesn't pose it.
local function layer(animation: Animation?, poseName: string, joint: Motor6D, time: number): CFrame?
	if animation and posed(animation)[poseName] then
		return toJointSpace(joint, sample(animation, poseName, time))
	end
	return nil
end

-- The idle layer's value for every joint it covers this frame (joint space).
local function idleValues(character: Model, idle: Idle, now: number, dt: number): { [string]: CFrame }
	-- Joints can show up late (a weapon replicating after the kit was set)
	-- or get recreated (avatar applied), so look for missing ones now and then.
	if now >= idle.nextJointScan then
		idle.nextJointScan = now + 0.25
		local fresh: { [string]: Motor6D }? = nil
		for poseName in idle.covered do
			local joint = idle.joints[poseName]
			if not joint or not joint.Parent then
				fresh = fresh or findJoints(character)
				idle.joints[poseName] = (fresh :: { [string]: Motor6D })[poseName]
			end
		end
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local velocity = if root then root.AssemblyLinearVelocity else Vector3.zero
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	local set = idle.set

	-- Airborne means nothing under the feet. Unlike checking vertical
	-- speed, this holds through the top of a jump.
	if root and now >= idle.nextGroundCheck then
		idle.nextGroundCheck = now + 0.05
		idle.airborne = workspace:Raycast(root.Position, Vector3.new(0, -AIR_HEIGHT, 0), idle.rayParams) == nil
	end

	local standTarget = if speed < STAND_SPEED then 1 else 0
	idle.standWeight += (standTarget - idle.standWeight) * math.min(dt * STANCE_BLEND, 1)
	local airTarget = if set.air and idle.airborne then 1 else 0
	idle.airWeight += (airTarget - idle.airWeight) * math.min(dt * AIR_BLEND, 1)

	-- Which way he's moving compared to where he faces (shift lock strafing,
	-- backpedalling). Backwards runs the cycle in reverse.
	local yawTarget, backTarget = 0, 0
	if root and speed > STAND_SPEED then
		local direction = root.CFrame:VectorToObjectSpace(flat / speed)
		local angle = math.deg(math.atan2(direction.X, -direction.Z))
		local backLimit = if idle.backWeight > 0.5 then 95 else 115
		if math.abs(angle) > backLimit then
			backTarget = 1
			angle -= 180 * math.sign(angle)
		end
		yawTarget = math.clamp(angle, -75, 75)
	end
	local turn = math.min(dt * TURN_BLEND, 1)
	idle.moveYaw += (yawTarget - idle.moveYaw) * turn
	idle.backWeight += (backTarget - idle.backWeight) * turn

	-- Walk when slow, run when fast, both on the same step phase.
	local runLength = if set.move then lengthOf(set.move) else 1
	local walkLength = if set.walk then lengthOf(set.walk) else runLength
	local runSpeed = set.moveSpeed or 16
	local walkSpeed = set.walkSpeed or 8
	local runWeight = if set.walk then smooth((speed - walkSpeed * 1.2) / (runSpeed * 0.85 - walkSpeed * 1.2)) else 1
	local walkRate = math.clamp(speed / walkSpeed, 0.5, 1.8) / walkLength
	local runRate = math.clamp(speed / runSpeed, 0.5, 2) / runLength
	local rate = walkRate + (runRate - walkRate) * runWeight
	idle.phase = (idle.phase + dt * rate * (if backTarget == 1 then -1 else 1)) % 1

	local standW, airW = smooth(idle.standWeight), smooth(idle.airWeight)
	local yaw, back = math.rad(idle.moveYaw), idle.backWeight

	local t = now - idle.start
	local values = {}
	for poseName, joint in idle.joints do
		if not joint.Parent then
			continue
		end
		local base = animatorBase(joint)
		-- Moving (or the default walk), blended toward standing, then air.
		local value = base
		local run = if set.move and posed(set.move)[poseName]
			then sample(set.move, poseName, idle.phase * runLength)
			else nil
		local walk = if set.walk and posed(set.walk)[poseName]
			then sample(set.walk, poseName, idle.phase * walkLength)
			else nil
		local move = if run and walk then walk:Lerp(run, runWeight) else run or walk
		if move then
			-- Turn the stride toward the movement direction: hips most, the
			-- torso a little, the head back to facing forward. Lean back less
			-- when backpedalling.
			if poseName == "Torso" then
				move = CFrame.Angles(0, -yaw * 0.4, 0) * CFrame.Angles(math.rad(14) * back, 0, 0) * move
			elseif poseName == "Head" then
				move = CFrame.Angles(0, yaw * 0.4, 0) * move
			elseif poseName == "RightLeg" or poseName == "LeftLeg" then
				move = CFrame.Angles(0, -yaw * 0.6, 0) * move
			end
			value = toJointSpace(joint, move)
		end
		value = value:Lerp(layer(set.stand, poseName, joint, t) or base, standW)
		local air = layer(set.air, poseName, joint, t)
		if air and airW > 0 then
			value = value:Lerp(air, airW)
		end
		values[poseName] = value
	end
	return values
end

local function step(dt: number)
	local now = os.clock()

	local idleFrame: { [Model]: { [string]: CFrame } } = {}
	for character, idle in idles do
		if not character.Parent then
			idles[character] = nil
			continue
		end
		if character:GetAttribute("Ragdolled") == true then
			continue
		end
		local values = idleValues(character, idle, now, dt)
		idleFrame[character] = values
		local track = tracks[character]
		for poseName, value in values do
			if not (track and track.joints[poseName]) then
				write(idle.joints[poseName], value)
			end
		end
	end

	for character, track in tracks do
		local elapsed = if now < track.freezeUntil then track.frozenAt else now - track.start
		local animation = track.animation
		local fadeIn = animation.fadeIn or 0.04
		local fadeOut = track.fadeOutOverride or animation.fadeOut or 0.15
		local total = track.length + fadeOut

		local dead = not character.Parent or character:GetAttribute("Ragdolled") == true
		if dead or elapsed >= total then
			tracks[character] = nil
			release(track, character)
			continue
		end

		if animation.events and track.onEvent then
			for index, event in animation.events do
				if not track.firedEvents[index] and elapsed >= event.time then
					track.firedEvents[index] = true
					task.spawn(track.onEvent, event.name)
				end
			end
		end

		local fadingIn = elapsed < fadeIn
		local weight = 1
		if fadingIn then
			weight = smooth(elapsed / fadeIn)
		elseif elapsed > track.length then
			weight = 1 - smooth((elapsed - track.length) / fadeOut)
		end

		local additive = animation.additive or {}
		local idleValuesNow = idleFrame[character]
		local clampedTime = math.min(elapsed, track.length)
		for poseName, joint in track.joints do
			if not joint.Parent then
				continue
			end
			local base = (idleValuesNow and idleValuesNow[poseName]) or animatorBase(joint)
			local local_ = toJointSpace(joint, sample(animation, poseName, clampedTime))
			local target = if additive[poseName] then base * local_ else local_
			-- Fading in starts from wherever the joint really was (mid-swing
			-- from the previous track, for example), not from the base.
			local start = if fadingIn then track.from[poseName] or base else base
			write(joint, start:Lerp(target, weight))
		end
	end
end

-- Plays `animation` on `character`, replacing whatever this module was playing on it.
function PoseAnimator.Play(character: Model, animation: Animation, onEvent: ((name: string) -> ())?)
	local wanted = posed(animation)
	local joints = {}
	local from = {}
	for poseName, joint in findJoints(character) do
		if wanted[poseName] then
			joints[poseName] = joint
			from[poseName] = joint.Transform -- captured before the old track lets go
		end
	end

	local existing = tracks[character]
	if existing then
		tracks[character] = nil
		release(existing, character)
	end
	if next(joints) == nil then
		return -- not an R6 rig
	end

	tracks[character] = {
		animation = animation,
		joints = joints,
		start = os.clock(),
		length = lengthOf(animation),
		onEvent = onEvent,
		firedEvents = {},
		from = from,
		freezeUntil = 0,
		frozenAt = 0,
	}
end

function PoseAnimator.Stop(character: Model)
	local track = tracks[character]
	if track then
		tracks[character] = nil
		release(track, character)
	end
end

-- The animation currently playing on a character, if any.
function PoseAnimator.Current(character: Model): Animation?
	local track = tracks[character]
	return if track then track.animation else nil
end

-- Ends the current animation early, fading out from wherever it is now.
function PoseAnimator.FadeOut(character: Model, duration: number?)
	local track = tracks[character]
	if not track then
		return
	end
	local elapsed = os.clock() - track.start
	if elapsed < track.length then
		track.length = math.max(elapsed, 0)
	end
	track.fadeOutOverride = duration
end

-- Hit-stop: holds the character's current animation still for `duration`,
-- then lets it continue from the same point.
function PoseAnimator.Freeze(character: Model, duration: number)
	local track = tracks[character]
	if not track then
		return
	end
	local now = os.clock()
	if now < track.freezeUntil then
		return
	end
	track.frozenAt = now - track.start
	track.freezeUntil = now + duration
	track.start += duration
end

-- Sets (or clears, with nil) a character's idle layer.
function PoseAnimator.SetIdle(character: Model, set: IdleSet?)
	local old = idles[character]
	if old then
		idles[character] = nil
		for _, joint in old.joints do
			if lastWritten[joint] then
				lastWritten[joint] = nil
				joint.Transform = CFrame.identity
			end
		end
	end
	if not set then
		return
	end
	local covered: { [string]: boolean } = {}
	for _, animation in { set.stand, set.move, set.walk, set.air } :: { Animation? } do
		if animation then
			for poseName in posed(animation) do
				covered[poseName] = true
			end
		end
	end
	local joints = {}
	for poseName, joint in findJoints(character) do
		if covered[poseName] then
			joints[poseName] = joint
		end
	end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	idles[character] = {
		set = set,
		covered = covered,
		joints = joints,
		start = os.clock(),
		standWeight = 1,
		airWeight = 0,
		phase = 0,
		moveYaw = 0,
		backWeight = 0,
		airborne = false,
		nextGroundCheck = 0,
		rayParams = rayParams,
		nextJointScan = 0,
	}
end

function PoseAnimator.Start()
	-- PreSimulation runs after the default Animator has written its pose, so
	-- whatever we set here is what gets rendered.
	RunService.PreSimulation:Connect(step)
end

return PoseAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Reactions</string>
            <string name="Source"><![CDATA[--[[
	Reactions
	Default getting-hit and blocking animations, used by characters that
	don't bring their own (the dummies, and characters until they get custom
	ones). A kit can override any of these by name in Kit.Reactions.

	  FlinchA / FlinchB  hit from the front (alternating sides)
	  FlinchBack         hit from behind
	  HitHeavy           big hit that doesn't knock down
	  Guard              blocking stance, held until the block ends
	  GuardHit           a blocked hit pushes the guard back
	  Stagger            guard broken or parried
	  Grabbed            held up by the throat (faded out on release)
	  Launched           thrown high into the air, flailing (cutscenes end it)
]]

local PoseAnimator = require(script.Parent.PoseAnimator)

type Animation = PoseAnimator.Animation

local rad = math.rad
local QUART, SINE, LINEAR = Enum.EasingStyle.Quart, Enum.EasingStyle.Sine, Enum.EasingStyle.Linear
local OUT, IN_OUT = Enum.EasingDirection.Out, Enum.EasingDirection.InOut

local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

local function limb(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, rad(yaw or 0), 0) * CFrame.Angles(0, 0, rad(roll or 0)) * CFrame.Angles(rad(pitch), 0, 0)
end

local function clip(keys: { any }, options: { [string]: any }): Animation
	local keyframes = {}
	for _, key in keys do
		table.insert(keyframes, { time = key[1], pose = key[2], easing = key[3], direction = key[4] })
	end
	local animation: any = options
	animation.keyframes = keyframes
	return animation :: Animation
end

local LEGS = { RightLeg = true, LeftLeg = true }

local NEUTRAL = {
	Torso = rot(0),
	Head = rot(0),
	RightArm = limb(0),
	LeftArm = limb(0),
	RightLeg = rot(0),
	LeftLeg = rot(0),
}

local function settle(twist: number)
	return {
		Torso = rot(5, twist),
		Head = rot(-6, twist * 1.5),
		RightArm = limb(6, 0, 10),
		LeftArm = limb(6, 0, -12),
		RightLeg = rot(-2),
		LeftLeg = rot(2),
	}
end

local Reactions: { [string]: Animation } = {}

Reactions.FlinchA = clip({
	{ 0, NEUTRAL },
	{
		0.05,
		{
			Torso = rot(14, 14, 5),
			Head = rot(-20, 18),
			RightArm = limb(20, 0, 35),
			LeftArm = limb(15, 0, -40),
			RightLeg = rot(-6),
			LeftLeg = rot(6),
		},
		QUART,
		OUT,
	},
	{ 0.3, settle(4), SINE, OUT },
}, { fadeIn = 0.045, fadeOut = 0.22, additive = LEGS })

Reactions.FlinchB = clip({
	{ 0, NEUTRAL },
	{
		0.05,
		{
			Torso = rot(14, -14, -5),
			Head = rot(-20, -18),
			RightArm = limb(15, 0, 40),
			LeftArm = limb(20, 0, -35),
			RightLeg = rot(6),
			LeftLeg = rot(-6),
		},
		QUART,
		OUT,
	},
	{ 0.3, settle(-4), SINE, OUT },
}, { fadeIn = 0.045, fadeOut = 0.22, additive = LEGS })

Reactions.FlinchBack = clip({
	{ 0, NEUTRAL },
	{
		0.05,
		{
			Torso = rot(-16),
			Head = rot(18),
			RightArm = limb(-25, 0, 25),
			LeftArm = limb(-25, 0, -25),
			RightLeg = rot(-6),
			LeftLeg = rot(6),
		},
		QUART,
		OUT,
	},
	{ 0.3, settle(0), SINE, OUT },
}, { fadeIn = 0.045, fadeOut = 0.22, additive = LEGS })

Reactions.HitHeavy = clip({
	{ 0, NEUTRAL },
	{
		0.06,
		{
			Torso = rot(26),
			Head = rot(-35),
			RightArm = limb(110, 0, 40),
			LeftArm = limb(110, 0, -40),
			RightLeg = rot(20),
			LeftLeg = rot(-12),
		},
		QUART,
		OUT,
	},
	{ 0.5, settle(0), SINE, IN_OUT },
}, { fadeIn = 0.05, fadeOut = 0.25, additive = LEGS })

local GUARD = {
	Torso = rot(-8, 6),
	Head = rot(12),
	RightArm = limb(120, 42),
	LeftArm = limb(118, -42),
}
local GUARD_PUSHED = {
	Torso = rot(6, 10),
	Head = rot(-4),
	RightArm = limb(105, 48),
	LeftArm = limb(100, -36),
}

-- Held for a minute; the block ending fades it out early.
Reactions.Guard = clip({
	{ 0, { Torso = rot(0), Head = rot(0), RightArm = limb(0), LeftArm = limb(0) } },
	{ 0.08, GUARD, QUART, OUT },
	{ 60, GUARD, LINEAR },
}, { fadeIn = 0.05, fadeOut = 0.15 })

Reactions.GuardHit = clip({
	{ 0, GUARD },
	{ 0.05, GUARD_PUSHED, QUART, OUT },
	{ 0.2, GUARD, SINE, OUT },
	{ 60, GUARD, LINEAR },
}, { fadeIn = 0.02, fadeOut = 0.15 })

local STAGGER = {
	Torso = rot(20, -10),
	Head = rot(-25, 8),
	RightArm = limb(140, 0, 30),
	LeftArm = limb(120, 0, -35),
	RightLeg = rot(16),
	LeftLeg = rot(-14),
}

Reactions.Stagger = clip({
	{ 0, NEUTRAL },
	{ 0.08, STAGGER, QUART, OUT },
	{ 1.0, STAGGER, LINEAR },
	{ 1.3, settle(0), SINE, IN_OUT },
}, { fadeIn = 0.02, fadeOut = 0.25 })

-- Held up by the throat: head thrown back, both hands clawing at the grip,
-- legs kicking. Written out long (tracks don't loop); release fades it.
do
	local function grabbed(kick: number, arch: number)
		return {
			Torso = rot(10 + arch),
			Head = rot(-26 - arch),
			RightArm = limb(150 + arch * 2, -14, 6),
			LeftArm = limb(150 + arch * 2, 14, -6),
			RightLeg = rot(14 * kick),
			LeftLeg = rot(-12 * kick),
		}
	end
	local keys: { any } = { { 0, grabbed(0, 0) } }
	for i = 1, 14 do
		table.insert(
			keys,
			{ i * 0.18, grabbed(if i % 2 == 1 then 1 else -1, if i % 2 == 1 then 3 else 0), SINE, IN_OUT }
		)
	end
	Reactions.Grabbed = clip(keys, { fadeIn = 0.08, fadeOut = 0.2 })
end

do
	local function launched(flail: number)
		return {
			Torso = rot(20 + flail),
			Head = rot(-30),
			RightArm = limb(160 - flail * 3, 0, 30),
			LeftArm = limb(150 + flail * 3, 0, -35),
			RightLeg = rot(30 - flail * 2),
			LeftLeg = rot(-20 + flail * 2),
		}
	end
	local keys: { any } = { { 0, launched(0) } }
	for i = 1, 24 do -- long enough for the whole of Black Moon
		table.insert(keys, { i * 0.25, launched(if i % 2 == 1 then 6 else -6), SINE, IN_OUT })
	end
	Reactions.Launched = clip(keys, { fadeIn = 0.1, fadeOut = 0.2 })
end

return Reactions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ShiftLock</string>
            <string name="Source"><![CDATA[--[[
	ShiftLock
	Our own shift lock (Roblox's built-in one is turned off in StarterPlayer):
	LeftShift or the top bar button toggles it. While on, the mouse is locked
	to the center, the camera sits over the right shoulder and the character
	always faces where the camera looks, so attacks go where you aim.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CombatState = require(ReplicatedStorage:WaitForChild("Shared").CombatState)

local SHOULDER_OFFSET = Vector3.new(1.75, 0.25, 0)
local DOT_SIZE = 6

local localPlayer = Players.LocalPlayer

local ShiftLock = {}

local enabled = false
local suspended = false -- e.g. a menu is open and needs the mouse
local listeners: { (boolean) -> () } = {}
local dot: Frame? = nil

-- Small aiming dot in the middle of the screen (replaces the mouse cursor).
local function buildDot()
	local gui = Instance.new("ScreenGui")
	gui.Name = "ShiftLockDot"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromOffset(DOT_SIZE, DOT_SIZE)
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.Visible = false
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Transparency = 0.4
	stroke.Thickness = 1
	stroke.Parent = frame

	dot = frame
end

local function getHumanoid(): (Humanoid?, BasePart?)
	local character = localPlayer.Character
	if not character then
		return nil, nil
	end
	return character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function apply()
	local active = enabled and not suspended
	local humanoid = getHumanoid()
	if humanoid then
		humanoid.AutoRotate = not active
		humanoid.CameraOffset = if active then SHOULDER_OFFSET else Vector3.zero
	end
	UserInputService.MouseIconEnabled = not active
	if dot then
		dot.Visible = active
	end
	if not active then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end

function ShiftLock.IsEnabled(): boolean
	return enabled
end

function ShiftLock.Set(value: boolean)
	if enabled == value then
		return
	end
	enabled = value
	apply()
	for _, listener in listeners do
		task.spawn(listener, enabled)
	end
end

function ShiftLock.Toggle()
	ShiftLock.Set(not enabled)
end

-- Temporarily frees the mouse (menus) without turning shift lock off.
function ShiftLock.SetSuspended(value: boolean)
	suspended = value
	apply()
end

function ShiftLock.OnChanged(listener: (boolean) -> ())
	table.insert(listeners, listener)
end

function ShiftLock.Start()
	buildDot()
	ContextActionService:BindAction("CloverShiftLock", function(_, state)
		if state == Enum.UserInputState.Begin then
			ShiftLock.Toggle()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.LeftShift)

	-- After the camera has updated: keep the mouse locked and turn the
	-- character to match the camera.
	RunService:BindToRenderStep("CloverShiftLock", Enum.RenderPriority.Camera.Value + 2, function()
		if not enabled or suspended then
			return
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

		local humanoid, root = getHumanoid()
		if not humanoid or not root or humanoid.Health <= 0 or humanoid.Sit then
			return
		end
		local character = localPlayer.Character :: Model
		-- Ragdolled, a skill is steering the body (Bull Thrust), or a cutscene.
		if
			CombatState.IsRagdolled(character)
			or character:GetAttribute("Steering") == true
			or character:GetAttribute("Cinematic") == true
		then
			return
		end
		local look = workspace.CurrentCamera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 1e-3 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		end
	end)

	localPlayer.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid")
		apply()
	end)
end

return ShiftLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TopBar</string>
            <string name="Source"><![CDATA[--[[
	TopBar
	Buttons in Roblox's top bar, right next to the menu/chat buttons:
	  CHARACTERS  opens the character picker
	  SHIFT LOCK  toggles shift lock (same as LeftShift)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kits = require(Shared.Kits)
local Remotes = require(Shared.Remotes)

local ShiftLock = require(script.Parent.ShiftLock)

local localPlayer = Players.LocalPlayer

local COLORS = {
	Pill = Color3.fromRGB(0, 0, 0),
	Panel = Color3.fromRGB(14, 14, 18),
	Card = Color3.fromRGB(28, 28, 34),
	Text = Color3.fromRGB(240, 240, 240),
	SubText = Color3.fromRGB(165, 165, 175),
	On = Color3.fromRGB(90, 200, 255),
}

local TopBar = {}

local panel: Frame
local cards: { [string]: { stroke: UIStroke, badge: TextLabel } } = {}
local open = false

local function corner(parent: Instance, radius: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
end

-- A pill-shaped button styled like Roblox's own top bar buttons.
local function pillButton(parent: Instance, text: string, order: number): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = true
	button.AutomaticSize = Enum.AutomaticSize.X
	button.Size = UDim2.fromOffset(0, 44)
	button.BackgroundColor3 = COLORS.Pill
	button.BackgroundTransparency = 0.3
	button.Font = Enum.Font.GothamBold
	button.TextSize = 14
	button.TextColor3 = COLORS.Text
	button.Text = text
	button.LayoutOrder = order
	button.Parent = parent
	corner(button, UDim.new(1, 0))

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = button
	return button
end

local function selectedKit(): string
	local character = localPlayer.Character
	local id = (character and character:GetAttribute("Kit")) or localPlayer:GetAttribute("Kit")
	return if type(id) == "string" then id else Kits.Default
end

local function refreshCards()
	local current = selectedKit()
	for id, card in cards do
		local kit = Kits.List[id]
		local isCurrent = id == current
		card.stroke.Color = if isCurrent then kit.color else Color3.fromRGB(50, 50, 58)
		card.stroke.Thickness = if isCurrent then 3 else 1
		card.badge.Text = if not kit.playable then "COMING SOON" elseif isCurrent then "SELECTED" else ""
	end
end

local function setOpen(value: boolean)
	open = value
	ShiftLock.SetSuspended(open)
	if open then
		refreshCards()
		panel.Visible = true
		panel.Position = UDim2.fromOffset(16, -10)
		TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Position = UDim2.fromOffset(16, 8) })
			:Play()
	else
		panel.Visible = false
	end
end

local function buildCard(parent: Instance, kit: Kits.KitInfo, order: number)
	local card = Instance.new("TextButton")
	card.Name = kit.id
	card.AutoButtonColor = kit.playable
	card.Text = ""
	card.BackgroundColor3 = COLORS.Card
	card.LayoutOrder = order
	card.Parent = parent
	corner(card, UDim.new(0, 8))

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card

	local strip = Instance.new("Frame")
	strip.Size = UDim2.new(1, 0, 0, 6)
	strip.BackgroundColor3 = kit.color
	strip.BackgroundTransparency = if kit.playable then 0 else 0.6
	strip.BorderSizePixel = 0
	strip.Parent = card
	corner(strip, UDim.new(0, 3))

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(10, 14)
	title.Size = UDim2.new(1, -20, 0, 20)
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 15
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = if kit.playable then COLORS.Text else COLORS.SubText
	title.Text = string.upper(kit.title)
	title.Parent = card

	local description = Instance.new("TextLabel")
	description.BackgroundTransparency = 1
	description.Position = UDim2.fromOffset(10, 36)
	description.Size = UDim2.new(1, -20, 0, 44)
	description.Font = Enum.Font.Gotham
	description.TextSize = 12
	description.TextWrapped = true
	description.TextXAlignment = Enum.TextXAlignment.Left
	description.TextYAlignment = Enum.TextYAlignment.Top
	description.TextColor3 = COLORS.SubText
	description.Text = kit.description
	description.Parent = card

	local badge = Instance.new("TextLabel")
	badge.BackgroundTransparency = 1
	badge.AnchorPoint = Vector2.new(0, 1)
	badge.Position = UDim2.new(0, 10, 1, -8)
	badge.Size = UDim2.new(1, -20, 0, 14)
	badge.Font = Enum.Font.GothamBold
	badge.TextSize = 11
	badge.TextXAlignment = Enum.TextXAlignment.Left
	badge.TextColor3 = kit.color
	badge.Parent = card

	cards[kit.id] = { stroke = stroke, badge = badge }

	card.Activated:Connect(function()
		if not kit.playable then
			return
		end
		-- Picking the character you already are re-equips it (a refresh).
		Remotes.Action:FireServer("SelectKit", kit.id)
		setOpen(false)
	end)
end

local function buildPanel(gui: ScreenGui)
	panel = Instance.new("Frame")
	panel.Name = "CharacterPicker"
	panel.Size = UDim2.fromOffset(3 * 170 + 2 * 10 + 28, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.BackgroundColor3 = COLORS.Panel
	panel.BackgroundTransparency = 0.1
	panel.Visible = false
	panel.Parent = gui
	corner(panel, UDim.new(0, 12))

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.Parent = panel

	local heading = Instance.new("TextLabel")
	heading.BackgroundTransparency = 1
	heading.Size = UDim2.new(1, 0, 0, 24)
	heading.Font = Enum.Font.GothamBlack
	heading.TextSize = 18
	heading.TextXAlignment = Enum.TextXAlignment.Left
	heading.TextColor3 = COLORS.Text
	heading.Text = "CHOOSE YOUR GRIMOIRE"
	heading.Parent = panel

	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.fromOffset(0, 34)
	grid.Size = UDim2.new(1, 0, 0, 0)
	grid.AutomaticSize = Enum.AutomaticSize.Y
	grid.Parent = panel

	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(170, 112)
	layout.CellPadding = UDim2.fromOffset(10, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid

	for order, id in Kits.Order do
		local kit = Kits.List[id]
		if kit then
			buildCard(grid, kit, order)
		end
	end
end

function TopBar.Start()
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	-- Lives in the free part of Roblox's top bar, next to the chat button.
	local bar = Instance.new("ScreenGui")
	bar.Name = "TopBar"
	bar.ResetOnSpawn = false
	bar.ScreenInsets = Enum.ScreenInsets.TopbarSafeInsets
	bar.DisplayOrder = 10
	bar.Parent = playerGui

	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromScale(1, 1)
	row.Parent = bar

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row

	local charactersButton = pillButton(row, "CHARACTERS", 1)
	local shiftLockButton = pillButton(row, "SHIFT LOCK: OFF", 2)

	-- Line up exactly with Roblox's own buttons: in the 58px top bar they're
	-- 44px tall and sit 12px from the top (2px from the bottom). Computed from
	-- the bar's real height so it also lines up on smaller top bars.
	local rowPadding = Instance.new("UIPadding")
	rowPadding.PaddingLeft = UDim.new(0, 10) -- small gap after Roblox's chat button
	rowPadding.Parent = row
	local function align()
		local barHeight = row.AbsoluteSize.Y
		local buttonHeight = math.clamp(barHeight - 14, 28, 44)
		rowPadding.PaddingTop = UDim.new(0, math.max(barHeight - buttonHeight - 2, 0))
		charactersButton.Size = UDim2.fromOffset(0, buttonHeight)
		shiftLockButton.Size = UDim2.fromOffset(0, buttonHeight)
	end
	row:GetPropertyChangedSignal("AbsoluteSize"):Connect(align)
	align()

	-- The picker opens below the top bar.
	local menus = Instance.new("ScreenGui")
	menus.Name = "Menus"
	menus.ResetOnSpawn = false
	menus.DisplayOrder = 10
	menus.Parent = playerGui
	buildPanel(menus)

	charactersButton.Activated:Connect(function()
		setOpen(not open)
	end)

	shiftLockButton.Activated:Connect(ShiftLock.Toggle)
	ShiftLock.OnChanged(function(on)
		shiftLockButton.Text = if on then "SHIFT LOCK: ON" else "SHIFT LOCK: OFF"
		shiftLockButton.TextColor3 = if on then COLORS.On else COLORS.Text
	end)

	-- Keep the "SELECTED" badge right after a switch or respawn.
	local function watch(character: Model)
		character:GetAttributeChangedSignal("Kit"):Connect(refreshCards)
		refreshCards()
	end
	localPlayer.CharacterAdded:Connect(watch)
	if localPlayer.Character then
		watch(localPlayer.Character)
	end
end

return TopBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">VFX</string>
            <string name="Source"><![CDATA[--[[
	VFX
	Every visual effect is drawn on the client. The server only sends
	("EffectName", data), so effects cost no server performance and stay
	smooth regardless of ping. Built entirely from parts, beams, particles
	and lights using textures that ship with Roblox, so no uploads needed.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)
local CameraShake = require(script.Parent.CameraShake)

local TEXTURES = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}

local COLORS = {
	Swing = Color3.fromRGB(255, 255, 255),
	Hit = Color3.fromRGB(255, 236, 190),
	Heavy = Color3.fromRGB(255, 120, 60),
	Block = Color3.fromRGB(110, 170, 255),
	Parry = Color3.fromRGB(120, 255, 255),
	GuardBreak = Color3.fromRGB(255, 170, 60),
	Dash = Color3.fromRGB(200, 225, 255),
	Evasive = Color3.fromRGB(235, 255, 255),
	Dust = Color3.fromRGB(150, 145, 135),
}

-- Characters can recolor their hit effects (VFX.SetPalette).
-- `cleanM1`: M1 hits only flash the victim and show damage (no sparks/rings).
type Palette = { hit: Color3, heavy: Color3, flash: Color3, cleanM1: boolean? }
local DEFAULT_PALETTE: Palette = { hit = COLORS.Hit, heavy = COLORS.Heavy, flash = Color3.new(1, 1, 1) }
local palettes: { [string]: Palette } = {}

local function paletteFor(data): Palette
	return (type(data.kit) == "string" and palettes[data.kit]) or DEFAULT_PALETTE
end

local localPlayer = Players.LocalPlayer

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = workspace

local VFX = {}
local Effects: { [string]: (data: any) -> () } = {}

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------

local function newPart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = fxFolder
	return part
end

local function tween(
	instance: Instance,
	duration: number,
	goals: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, goals)
	t:Play()
	return t
end

local function randomUnit(): Vector3
	local v = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
	return if v.Magnitude > 1e-3 then v.Unit else Vector3.yAxis
end

local function randomAngles(): CFrame
	return CFrame.Angles(math.random() * math.pi * 2, math.random() * math.pi * 2, math.random() * math.pi * 2)
end

local function getRoot(character: Model?): BasePart?
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function isLocal(character: Model?): boolean
	return character ~= nil and character == localPlayer.Character
end

local function groundBelow(position: Vector3, ignore: { Instance }?, depth: number?): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter: { Instance } = { fxFolder }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(filter, player.Character)
		end
	end
	local dummies = workspace:FindFirstChild("Dummies")
	if dummies then
		table.insert(filter, dummies)
	end
	if ignore then
		for _, instance in ignore do
			table.insert(filter, instance)
		end
	end
	params.FilterDescendantsInstances = filter
	return workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -(depth or 14), 0), params)
end

type BurstOptions = {
	texture: string?,
	color: Color3?,
	count: number?,
	size: number?,
	speed: NumberRange?,
	lifetime: NumberRange?,
	lightEmission: number?,
	transparency: number?,
	drag: number?,
	acceleration: Vector3?,
	spread: number?,
	streaks: boolean?,
	direction: Vector3?, -- aim the spread cone this way (default: straight up)
}

-- One-shot particle burst at a point.
local function burst(position: Vector3, options: BurstOptions)
	local cframe = if options.direction
		then CFrame.lookAt(position, position + options.direction)
		else CFrame.new(position)
	local holder = newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = cframe })
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder

	local lifetime = options.lifetime or NumberRange.new(0.15, 0.35)
	local size = options.size or 1

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = options.texture or TEXTURES.Spark
	emitter.Color = ColorSequence.new(options.color or COLORS.Hit)
	emitter.LightEmission = options.lightEmission or 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(options.transparency or 0, 1)
	emitter.Lifetime = lifetime
	emitter.Speed = options.speed or NumberRange.new(20, 40)
	emitter.SpreadAngle = Vector2.one * (options.spread or 180)
	emitter.Drag = options.drag or 5
	emitter.Acceleration = options.acceleration or Vector3.zero
	if options.direction then
		emitter.EmissionDirection = Enum.NormalId.Front
	end
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	if options.streaks then
		-- Stretch along travel direction for speed-line sparks.
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		emitter.Squash = NumberSequence.new(1.5)
	end
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(options.count or 12)

	Debris:AddItem(holder, lifetime.Max + 0.5)
end

-- Expanding glowing ball.
local function flash(position: Vector3, color: Color3, size: number, duration: number)
	local ball = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size * 0.3,
		CFrame = CFrame.new(position),
		Color = color,
		Transparency = 0.1,
	})
	tween(ball, duration, { Size = Vector3.one * size, Transparency = 1 })
	Debris:AddItem(ball, duration + 0.05)
end

-- Ring of thin neon segments expanding outward in the cframe's XZ plane.
local function ringBurst(
	cframe: CFrame,
	color: Color3,
	startRadius: number,
	endRadius: number,
	duration: number,
	thickness: number?
)
	local segments = 16
	local width = thickness or 0.2
	for i = 1, segments do
		local spin = CFrame.Angles(0, (i / segments) * math.pi * 2, 0)
		local startLength = (2 * math.pi * startRadius / segments) * 1.15
		local endLength = (2 * math.pi * endRadius / segments) * 1.15
		local segment = newPart({
			Size = Vector3.new(startLength, width, width),
			CFrame = cframe * spin * CFrame.new(0, 0, -startRadius),
			Color = color,
			Transparency = 0.05,
		})
		tween(segment, duration, {
			Size = Vector3.new(endLength, width * 0.2, width * 0.2),
			CFrame = cframe * spin * CFrame.new(0, 0, -endRadius),
			Transparency = 1,
		})
		Debris:AddItem(segment, duration + 0.05)
	end
end

-- A ring facing along `direction`, for impacts.
local function impactRing(position: Vector3, direction: Vector3, color: Color3, startRadius, endRadius, duration)
	local cframe = CFrame.lookAt(position, position + direction) * CFrame.Angles(math.rad(90), 0, 0)
	ringBurst(cframe, color, startRadius, endRadius, duration, 0.18)
end

local function light(position: Vector3, color: Color3, brightness: number, range: number, duration: number)
	local holder = newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(position) })
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Brightness = brightness
	pointLight.Range = range
	pointLight.Shadows = false
	pointLight.Parent = holder
	tween(pointLight, duration, { Brightness = 0 })
	Debris:AddItem(holder, duration + 0.05)
end

-- Body glow on hit: a near-solid flash. `fill` (the fill's transparency)
-- lightens it, for a coat on someone's own character that should leave
-- their avatar showing through.
local function highlight(character: Model?, color: Color3, duration: number, fill: number?)
	if not character then
		return
	end
	local h = Instance.new("Highlight")
	h.Adornee = character
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = fill or 0.15
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = fxFolder
	tween(h, duration, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(h, duration + 0.05)
end

-- Neon ghost copy of a character that fades out.
local function afterimage(character: Model, color: Color3, duration: number)
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local ghost = part:Clone()
			if ghost then
				for _, child in ghost:GetChildren() do
					if not child:IsA("DataModelMesh") then
						child:Destroy()
					end
				end
				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanQuery = false
				ghost.CanTouch = false
				ghost.CastShadow = false
				ghost.Massless = true
				ghost.Material = Enum.Material.Neon
				ghost.Color = color
				ghost.Transparency = 0.35
				if ghost:IsA("MeshPart") then
					ghost.TextureID = ""
				end
				ghost.Parent = fxFolder
				tween(ghost, duration, { Transparency = 1 })
				Debris:AddItem(ghost, duration + 0.05)
			end
		end
	end
end

-- Wind trail streaming off a flying character.
local function bodyTrail(character: Model?, color: Color3, duration: number)
	local root = getRoot(character)
	if not root then
		return
	end
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, 1.2, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -1.2, 0)
	bottom.Parent = root

	local trail = Instance.new("Trail")
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(color)
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Lifetime = 0.25
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.FaceCamera = true
	trail.Parent = root

	task.delay(duration, function()
		trail.Enabled = false
		task.wait(trail.Lifetime)
		trail:Destroy()
		top:Destroy()
		bottom:Destroy()
	end)
end

-- Flying shards (unanchored, local physics only).
local function shards(position: Vector3, color: Color3, count: number)
	for _ = 1, count do
		local shard = newPart({
			Size = Vector3.new(0.25, 0.6 + math.random() * 0.6, 0.08),
			CFrame = CFrame.new(position) * randomAngles(),
			Color = color,
			Material = Enum.Material.Glass,
			Transparency = 0.1,
		})
		shard.Anchored = false
		shard.AssemblyLinearVelocity = randomUnit() * (20 + math.random() * 15) + Vector3.new(0, 15, 0)
		shard.AssemblyAngularVelocity = randomUnit() * 20
		tween(shard, 0.6, { Transparency = 1, Size = shard.Size * 0.3 })
		Debris:AddItem(shard, 0.65)
	end
end

-- Rocks bursting up from the ground in a ring, plus dust.
local function groundRocks(position: Vector3, count: number, radius: number, maxSize: number)
	local ground = groundBelow(position)
	if not ground then
		return
	end
	local hitPart = ground.Instance
	local color = if hitPart:IsA("BasePart") then hitPart.Color else COLORS.Dust
	local material = ground.Material

	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.3
		local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (radius + math.random() * 1.5)
		local size = maxSize * (0.5 + math.random() * 0.5)
		local resting = CFrame.new(ground.Position + offset)
			* CFrame.Angles(math.random() * 0.8, math.random() * math.pi, math.random() * 0.8)
		local rock = newPart({
			Size = Vector3.one * size,
			CFrame = resting - Vector3.new(0, size, 0),
			Color = color,
			Material = material,
		})
		rock.CastShadow = true
		tween(rock, 0.15, { CFrame = resting }, Enum.EasingStyle.Back)
		task.delay(1.6 + math.random() * 0.4, function()
			tween(
				rock,
				0.5,
				{ CFrame = resting - Vector3.new(0, size * 1.2, 0) },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
		end)
		Debris:AddItem(rock, 2.6)
	end

	burst(ground.Position, {
		texture = TEXTURES.Smoke,
		color = color:Lerp(Color3.new(1, 1, 1), 0.3),
		count = 14,
		size = 4,
		speed = NumberRange.new(8, 18),
		lifetime = NumberRange.new(0.6, 1.2),
		lightEmission = 0,
		transparency = 0.4,
		drag = 3,
		spread = 80,
	})
end

-- "PERFECT", damage numbers, etc.
local function popup(position: Vector3, text: string, color: Color3, scale: number?)
	local holder = newPart({
		Size = Vector3.one * 0.2,
		Transparency = 1,
		CFrame = CFrame.new(position + Vector3.new((math.random() - 0.5) * 2, 1, (math.random() - 0.5) * 2)),
	})

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160 * (scale or 1), 48 * (scale or 1))
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Parent = holder

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui

	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1.7
	uiScale.Parent = label
	tween(uiScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

	tween(holder, 0.9, { CFrame = holder.CFrame + Vector3.new(0, 2.5, 0) })
	task.delay(0.45, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(holder, 0.95)
end

local function screenFlash(color: Color3, duration: number)
	local correction = Instance.new("ColorCorrectionEffect")
	correction.TintColor = color
	correction.Brightness = 0.2
	correction.Parent = workspace.CurrentCamera
	tween(correction, duration, { TintColor = Color3.new(1, 1, 1), Brightness = 0 })
	Debris:AddItem(correction, duration + 0.05)
end

-- Four-point star glint facing the camera (metal catching the light).
local function glint(position: Vector3, scale: number, color: Color3?)
	local camera = workspace.CurrentCamera
	local base = CFrame.lookAt(position, camera.CFrame.Position)
	local tint = color or Color3.fromRGB(255, 236, 190)
	for i = 0, 1 do
		local bar = newPart({
			Size = Vector3.new(0.1, 0.1, 0.04),
			CFrame = base * CFrame.Angles(0, 0, math.rad(45 + i * 90)),
			Color = tint,
		})
		tween(bar, 0.05, { Size = Vector3.new((if i == 0 then 3.4 else 2.2) * scale, 0.14 * scale, 0.04) })
		task.delay(0.05, function()
			tween(
				bar,
				0.14,
				{ Size = Vector3.new(0.2, 0.02, 0.02), Transparency = 1 },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
		end)
		Debris:AddItem(bar, 0.22)
	end
	flash(position, tint, 1.4 * scale, 0.1)
end

local SPARK_COLORS = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 250, 225)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 205, 90)),
	ColorSequenceKeypoint.new(0.65, Color3.fromRGB(255, 125, 25)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 35, 10)),
})

--[[
	Molten metal sparks, for sword clashes: hot streaks that fly out along
	`direction` and arc down under gravity, slower embers that linger, a
	glint, a flash of orange light and a puff of metal dust.
]]
local function sparks(position: Vector3, direction: Vector3, scale: number?)
	local k = scale or 1
	local aim = if direction.Magnitude > 1e-3 then direction.Unit else Vector3.yAxis
	local holder =
		newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.lookAt(position, position + aim) })
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder

	local streaks = Instance.new("ParticleEmitter")
	streaks.Texture = TEXTURES.Spark
	streaks.Color = SPARK_COLORS
	streaks.LightEmission = 1
	streaks.LightInfluence = 0
	streaks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.24 * k), NumberSequenceKeypoint.new(1, 0) })
	streaks.Squash = NumberSequence.new(2.5)
	streaks.Orientation = Enum.ParticleOrientation.VelocityParallel
	streaks.EmissionDirection = Enum.NormalId.Front
	streaks.SpreadAngle = Vector2.new(55, 55)
	streaks.Speed = NumberRange.new(30 * k, 62 * k)
	streaks.Acceleration = Vector3.new(0, -95, 0)
	streaks.Drag = 1.5
	streaks.Lifetime = NumberRange.new(0.25, 0.55)
	streaks.Enabled = false
	streaks.Parent = attachment
	streaks:Emit(math.floor(26 * k))

	local embers = Instance.new("ParticleEmitter")
	embers.Texture = TEXTURES.Spark
	embers.Color = SPARK_COLORS
	embers.LightEmission = 1
	embers.LightInfluence = 0
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3 * k), NumberSequenceKeypoint.new(1, 0) })
	embers.EmissionDirection = Enum.NormalId.Front
	embers.SpreadAngle = Vector2.new(85, 85)
	embers.Speed = NumberRange.new(6 * k, 16 * k)
	embers.Acceleration = Vector3.new(0, -45, 0)
	embers.Drag = 2
	embers.Lifetime = NumberRange.new(0.5, 1)
	embers.Rotation = NumberRange.new(0, 360)
	embers.RotSpeed = NumberRange.new(-300, 300)
	embers.Enabled = false
	embers.Parent = attachment
	embers:Emit(math.floor(10 * k))

	glint(position, k)
	light(position, Color3.fromRGB(255, 160, 60), 7 * k, 12 * k, 0.22)
	burst(position, {
		texture = TEXTURES.Smoke,
		color = Color3.fromRGB(150, 140, 130),
		count = 3,
		size = 1.2 * k,
		speed = NumberRange.new(2, 5),
		lifetime = NumberRange.new(0.3, 0.6),
		lightEmission = 0,
		transparency = 0.6,
		drag = 3,
	})
	Debris:AddItem(holder, 1.2)
end

-- Thin white speed lines rushing past a moving character for `duration`.
-- Without a direction they follow the way it's actually moving (curves).
local function speedLines(root: BasePart, direction: Vector3?, duration: number, color: Color3?)
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < duration and root.Parent do
			local heading = direction or root.AssemblyLinearVelocity
			local aim = if heading.Magnitude > 1 then heading.Unit else root.CFrame.LookVector
			for _ = 1, 3 do
				local offset = randomUnit() * Vector3.new(2.6, 2.2, 2.6)
				local from = root.Position + offset + aim * 4
				local line = newPart({
					Size = Vector3.new(0.05, 0.05, 2.5 + math.random() * 2),
					CFrame = CFrame.lookAt(from, from + aim),
					Color = color or Color3.new(1, 1, 1),
					Transparency = 0.25,
				})
				tween(line, 0.16, {
					CFrame = CFrame.lookAt(from - aim * 9, from - aim * 8),
					Transparency = 1,
				}, Enum.EasingStyle.Linear)
				Debris:AddItem(line, 0.18)
			end
			task.wait(0.035)
		end
	end)
end

-- Expanding sphere shell; centered on the ground it reads as a dome.
-- ForceField material gives a shimmering wave, Glass a solid-looking shell.
local function shockwave(
	position: Vector3,
	color: Color3,
	fromSize: number,
	toSize: number,
	duration: number,
	material: Enum.Material?,
	transparency: number?
)
	local ball = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * fromSize,
		CFrame = CFrame.new(position),
		Color = color,
		Material = material or Enum.Material.ForceField,
		Transparency = transparency or 0,
	})
	tween(ball, duration, { Size = Vector3.one * toSize, Transparency = 1 }, Enum.EasingStyle.Quart)
	Debris:AddItem(ball, duration + 0.05)
end

--[[
	Jagged cracks splitting outward across the ground from `position`. Each
	crack grows segment by segment, glows `glow` inside for a moment, then
	stays dark for `duration` before fading.
]]
local function groundCracks(position: Vector3, count: number, length: number, glow: Color3?, duration: number?)
	local ground = groundBelow(position)
	if not ground then
		return
	end
	local floor = ground.Position + Vector3.new(0, 0.04, 0)
	local life = duration or 2.5
	local dark = Color3.fromRGB(14, 13, 13)

	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + (math.random() - 0.5) * 0.7
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local point = floor + direction * (0.5 + math.random() * 0.8)
		local remaining = length * (0.6 + math.random() * 0.5)
		local width = 0.42
		local delay = 0
		while remaining > 0.3 do
			local segment = math.min(remaining, 1.1 + math.random() * 1.5)
			direction = CFrame.Angles(0, (math.random() - 0.5) * 1.1, 0):VectorToWorldSpace(direction)
			local nextPoint = point + direction * segment
			local from, to, w = point, nextPoint, width
			task.delay(delay, function()
				local look = CFrame.lookAt(from, to)
				local crack = newPart({
					Size = Vector3.new(w, 0.06, 0.05),
					CFrame = look,
					Color = dark,
					Material = Enum.Material.SmoothPlastic,
				})
				tween(crack, 0.06, {
					Size = Vector3.new(w, 0.06, segment + w * 0.5),
					CFrame = look * CFrame.new(0, 0, -segment / 2),
				}, Enum.EasingStyle.Linear)
				if glow then
					local hot = newPart({
						Size = Vector3.new(w * 0.45, 0.08, segment + w * 0.4),
						CFrame = look * CFrame.new(0, 0.01, -segment / 2),
						Color = glow,
						Transparency = 0.05,
					})
					tween(hot, 0.9, { Transparency = 1, Size = Vector3.new(0.02, 0.08, segment) })
					Debris:AddItem(hot, 0.95)
				end
				task.delay(life, function()
					tween(crack, 0.6, { Transparency = 1 })
				end)
				Debris:AddItem(crack, life + 0.65)
			end)
			point = nextPoint
			remaining -= segment
			width *= 0.72
			delay += 0.03
		end
	end
end

--[[
	Chunks of the ground blasted out of `position`: they fly out, fall,
	bounce once and settle, then sink away. Simulated here (no physics
	parts), so they never shove characters around.
]]
local function debris(position: Vector3, count: number, speed: number, size: number)
	local ground = groundBelow(position)
	if not ground then
		return -- nothing to blast out of in mid-air
	end
	local color = if ground.Instance:IsA("BasePart") then ground.Instance.Color else COLORS.Dust
	local material = ground.Material
	local floorY = ground.Position.Y
	local gravity = workspace.Gravity * 0.8

	local chunks = {}
	for _ = 1, count do
		local s = size * (0.35 + math.random() * 0.65)
		local angle = math.random() * math.pi * 2
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local part = newPart({
			Size = Vector3.new(s, s * (0.55 + math.random() * 0.5), s * (0.7 + math.random() * 0.4)),
			CFrame = CFrame.new(Vector3.new(position.X, floorY + s / 2, position.Z) + out * 0.8) * randomAngles(),
			Color = color,
			Material = material,
		})
		part.CastShadow = true
		table.insert(chunks, {
			part = part,
			velocity = out * speed * (0.45 + math.random() * 0.6)
				+ Vector3.new(0, speed * (0.55 + math.random() * 0.7), 0),
			spin = randomUnit() * (5 + math.random() * 10),
			bounced = false,
			resting = false,
		})
	end

	local start = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		for _, chunk in chunks do
			if not chunk.resting then
				chunk.velocity -= Vector3.new(0, gravity * dt, 0)
				local cframe = chunk.part.CFrame
				local nextPosition = cframe.Position + chunk.velocity * dt
				local half = chunk.part.Size.Y / 2
				if chunk.velocity.Y < 0 and nextPosition.Y - half < floorY then
					nextPosition = Vector3.new(nextPosition.X, floorY + half * 0.6, nextPosition.Z)
					if chunk.bounced or chunk.velocity.Y > -20 then
						chunk.resting = true
					else
						chunk.bounced = true
						chunk.velocity =
							Vector3.new(chunk.velocity.X * 0.35, -chunk.velocity.Y * 0.28, chunk.velocity.Z * 0.35)
						chunk.spin *= 0.4
					end
				end
				local spin = chunk.spin * dt
				chunk.part.CFrame = CFrame.new(nextPosition) * cframe.Rotation * CFrame.Angles(spin.X, spin.Y, spin.Z)
			end
		end
		if os.clock() - start > 2.2 then
			connection:Disconnect()
			for _, chunk in chunks do
				local part = chunk.part
				tween(part, 0.6, { CFrame = part.CFrame - Vector3.new(0, part.Size.Y, 0), Transparency = 1 })
				Debris:AddItem(part, 0.65)
			end
		end
	end)
end

-- A column of energy shooting up out of the ground, then thinning out.
local function pillar(
	position: Vector3,
	color: Color3,
	radius: number,
	height: number,
	duration: number,
	material: Enum.Material?,
	transparency: number?
)
	-- Cylinders run along X; turn X up.
	local base = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	local column = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = base,
		Color = color,
		Material = material or Enum.Material.Neon,
		Transparency = transparency or 0.05,
	})
	local rise = duration * 0.25
	tween(column, rise, {
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = base * CFrame.new(height / 2, 0, 0),
	}, Enum.EasingStyle.Quart)
	task.delay(rise, function()
		tween(column, duration - rise, {
			Size = Vector3.new(height * 1.15, 0.1, 0.1),
			CFrame = base * CFrame.new(height * 0.58, 0, 0),
			Transparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	Debris:AddItem(column, duration + 0.05)
end

--[[
	Ribbons spiralling around `anchor` (following it) for `duration`: they
	climb from `height` below to `height` above (negative height spirals
	down) while the radius closes in by `tighten` (0 to 1).
]]
local function spiral(
	anchor: BasePart,
	color: Color3,
	radius: number,
	height: number,
	duration: number,
	strands: number?,
	width: number?,
	tighten: number?
)
	local count = strands or 3
	local w = width or 0.45
	local glows = color.R + color.G + color.B > 0.3
	local ribbons: { BasePart } = {}
	for _ = 1, count do
		local part = newPart({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = anchor.CFrame })
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, w / 2, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -w / 2, 0)
		a1.Parent = part
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(color)
		trail.LightEmission = if glows then 1 else 0
		trail.LightInfluence = 0
		trail.Lifetime = 0.22
		trail.MinLength = 0
		trail.FaceCamera = true
		trail.Transparency = NumberSequence.new(if glows then 0.15 else 0.05, 1)
		trail.WidthScale = NumberSequence.new(1, 0)
		trail.Parent = part
		table.insert(ribbons, part)
	end
	local close = tighten or 0.5
	local turns = 2.2
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - start) / duration
		if t >= 1 or not anchor.Parent then
			connection:Disconnect()
			for _, part in ribbons do
				for _, child in part:GetChildren() do
					if child:IsA("Trail") then
						child.Enabled = false
					end
				end
				Debris:AddItem(part, 0.3)
			end
			return
		end
		local r = radius * (1 - t * close)
		for i, part in ribbons do
			local angle = t * math.pi * 2 * turns + (i / count) * math.pi * 2
			part.CFrame = CFrame.new(
				anchor.Position + Vector3.new(math.cos(angle) * r, -height + height * 2 * t, math.sin(angle) * r)
			)
		end
	end)
end

--[[
	A jagged lightning bolt from `from` to `to`: a `color` core inside a
	wider `glow` sheath (optional), with a side branch, flickering out over
	`duration`. Dark colors use a matte core so black lightning stays black.
]]
local function lightning(
	from: Vector3,
	to: Vector3,
	color: Color3,
	glow: Color3?,
	thickness: number?,
	duration: number?,
	branch: boolean?
)
	local width = thickness or 0.16
	local life = duration or 0.2
	local offset = to - from
	local length = offset.Magnitude
	if length < 0.1 then
		return
	end
	local segments = math.clamp(math.floor(length / 1.1), 3, 12)
	local points = { from }
	for i = 1, segments - 1 do
		table.insert(points, from + offset * (i / segments) + randomUnit() * length * 0.09)
	end
	table.insert(points, to)

	local matte = color.R + color.G + color.B < 0.3
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local segment = (b - a).Magnitude
		local cframe = CFrame.lookAt((a + b) / 2, b)
		local core = newPart({
			Size = Vector3.new(width, width, segment + width),
			CFrame = cframe,
			Color = color,
			Material = if matte then Enum.Material.SmoothPlastic else Enum.Material.Neon,
		})
		tween(
			core,
			life,
			{ Transparency = 1, Size = Vector3.new(width * 0.3, width * 0.3, segment) },
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		)
		Debris:AddItem(core, life + 0.05)
		if glow then
			local sheath = newPart({
				Size = Vector3.new(width * 3.2, width * 3.2, segment + width * 2),
				CFrame = cframe,
				Color = glow,
				Transparency = 0.55,
			})
			tween(sheath, life * 0.8, { Transparency = 1, Size = Vector3.new(width, width, segment) })
			Debris:AddItem(sheath, life + 0.05)
		end
	end

	if branch ~= false and length > 3 and #points > 3 then
		local fork = points[math.random(2, #points - 2)]
		local direction = (offset.Unit + randomUnit() * 1.2).Unit
		lightning(fork, fork + direction * length * 0.4, color, glow, width * 0.7, life * 0.85, false)
	end
end

-- A full-screen color grade for the local camera: eases into `goal`
-- (ColorCorrectionEffect properties), holds, then eases back out.
local function colorGrade(goal: { [string]: any }, fadeIn: number, hold: number, fadeOut: number)
	local correction = Instance.new("ColorCorrectionEffect")
	correction.Parent = workspace.CurrentCamera
	if fadeIn <= 0 then
		for key, value in goal do
			(correction :: any)[key] = value
		end
	else
		tween(correction, fadeIn, goal, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	end
	task.delay(fadeIn + hold, function()
		tween(correction, fadeOut, {
			Brightness = 0,
			Contrast = 0,
			Saturation = 0,
			TintColor = Color3.new(1, 1, 1),
		})
	end)
	Debris:AddItem(correction, fadeIn + hold + fadeOut + 0.05)
end

---------------------------------------------------------------------------
-- Effects (names match what the server sends)
---------------------------------------------------------------------------

-- M1 hit for kits with a clean style: a quick body flash and the number.
local function cleanM1Hit(data, heavy: boolean): boolean
	local palette = paletteFor(data)
	if not palette.cleanM1 or data.variant == nil then
		return false
	end
	highlight(data.victim, Color3.new(1, 1, 1), if heavy then 0.18 else 0.1)
	if data.damage then
		popup(data.position, string.format("%g", data.damage), Color3.new(1, 1, 1), if heavy then 1.2 else 1)
	end
	-- Finishers get a touch of motion: a small burst in the launch direction.
	local victimRoot = getRoot(data.victim)
	if victimRoot and (data.variant == "Uppercut" or data.variant == "Downslam") then
		local up = data.variant == "Uppercut"
		local direction = if up then Vector3.yAxis else -Vector3.yAxis
		burst(victimRoot.Position, {
			color = Color3.new(1, 1, 1),
			count = 6,
			size = 0.45,
			speed = NumberRange.new(18, 30),
			lifetime = NumberRange.new(0.12, 0.22),
			streaks = true,
			spread = 22,
			direction = direction,
		})
		ringBurst(CFrame.new(victimRoot.Position - direction * 1.2), Color3.new(1, 1, 1), 0.6, 2.4, 0.18, 0.08)
		bodyTrail(data.victim, Color3.new(1, 1, 1), if up then 0.45 else 0.3)
	end
	if heavy and (isLocal(data.attacker) or isLocal(data.victim)) then
		CameraShake.FovKick(4)
	end
	return true
end

function Effects.Hit(data)
	if cleanM1Hit(data, false) then
		return
	end
	local position: Vector3 = data.position
	local direction: Vector3 = data.direction or Vector3.zAxis
	local palette = paletteFor(data)

	burst(position, {
		color = palette.hit,
		count = 10,
		size = 0.9,
		speed = NumberRange.new(20, 38),
		streaks = true,
	})
	flash(position, palette.flash, 3.2, 0.12)
	impactRing(position, direction, palette.flash, 0.5, 2.8, 0.18)
	light(position, palette.hit, 4, 10, 0.15)
	highlight(data.victim, Color3.new(1, 1, 1), 0.15)
	if data.damage then
		popup(position, string.format("%g", data.damage), Color3.new(1, 1, 1))
	end
end

function Effects.HeavyHit(data)
	if cleanM1Hit(data, true) then
		return
	end
	local position: Vector3 = data.position
	local direction: Vector3 = data.direction or Vector3.zAxis
	local palette = paletteFor(data)

	burst(position, {
		color = palette.heavy,
		count = 22,
		size = 1.4,
		speed = NumberRange.new(30, 60),
		lifetime = NumberRange.new(0.2, 0.45),
		streaks = true,
	})
	burst(position, {
		color = Color3.new(1, 1, 1),
		count = 8,
		size = 2,
		speed = NumberRange.new(5, 12),
	})
	flash(position, palette.flash, 6.5, 0.18)
	impactRing(position, direction, palette.heavy, 0.8, 5.5, 0.25)
	task.delay(0.06, impactRing, position, direction, palette.flash, 0.5, 4, 0.22)
	light(position, palette.heavy, 8, 18, 0.3)
	highlight(data.victim, palette.heavy, 0.25)
	if data.damage then
		popup(position, string.format("%g", data.damage), palette.heavy, 1.3)
	end

	if data.variant == "Knockback" or data.variant == "Uppercut" or data.variant == nil then
		bodyTrail(data.victim, Color3.new(1, 1, 1), 0.6)
	end
	if isLocal(data.attacker) or isLocal(data.victim) then
		CameraShake.FovKick(8)
	end
end

function Effects.Block(data)
	local position: Vector3 = data.position
	local root = getRoot(data.victim)

	burst(position, {
		color = COLORS.Block,
		count = 8,
		size = 0.7,
		speed = NumberRange.new(12, 25),
	})
	if root then
		local shield = newPart({
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.ForceField,
			Color = COLORS.Block,
			Size = Vector3.one * 5,
			CFrame = root.CFrame,
		})
		tween(shield, 0.25, { Size = Vector3.one * 6.5, Transparency = 1 })
		Debris:AddItem(shield, 0.3)
	end
	highlight(data.victim, COLORS.Block, 0.12)
end

function Effects.PerfectBlock(data)
	local position: Vector3 = data.position
	local victimRoot = getRoot(data.victim)
	local direction = if victimRoot then victimRoot.CFrame.LookVector else Vector3.zAxis

	flash(position, COLORS.Parry, 8, 0.25)
	impactRing(position, direction, COLORS.Parry, 1, 7, 0.3)
	task.delay(0.08, impactRing, position, direction, Color3.new(1, 1, 1), 0.6, 5, 0.25)
	burst(position, {
		color = COLORS.Parry,
		count = 24,
		size = 1.2,
		speed = NumberRange.new(25, 50),
		streaks = true,
	})
	light(position, COLORS.Parry, 10, 20, 0.35)
	highlight(data.victim, COLORS.Parry, 0.3)
	highlight(data.attacker, Color3.fromRGB(255, 60, 60), 0.4)
	popup(position + Vector3.new(0, 2, 0), "PERFECT", COLORS.Parry, 1.4)

	if isLocal(data.attacker) or isLocal(data.victim) then
		screenFlash(COLORS.Parry, 0.3)
		CameraShake.FovKick(-6)
	end
end

function Effects.GuardBreak(data)
	local position: Vector3 = data.position
	shards(position, COLORS.Block, 14)
	flash(position, COLORS.GuardBreak, 6, 0.2)
	burst(position, {
		color = COLORS.GuardBreak,
		count = 16,
		size = 1.1,
		speed = NumberRange.new(25, 45),
		streaks = true,
	})
	light(position, COLORS.GuardBreak, 8, 16, 0.3)
	highlight(data.victim, COLORS.GuardBreak, 0.35)
	popup(position + Vector3.new(0, 2, 0), "GUARD BREAK", COLORS.GuardBreak, 1.5)
end

function Effects.Dash(data)
	local character: Model? = data.character
	local root = getRoot(character)
	if not character or not root then
		return
	end

	afterimage(character, COLORS.Dash, 0.35)
	for i = 1, 2 do
		task.delay(i * 0.06, function()
			if character.Parent then
				afterimage(character, COLORS.Dash, 0.3)
			end
		end)
	end

	local ground = groundBelow(root.Position, { character })
	if ground then
		burst(ground.Position, {
			texture = TEXTURES.Smoke,
			color = COLORS.Dust,
			count = 6,
			size = 2.5,
			speed = NumberRange.new(4, 10),
			lifetime = NumberRange.new(0.4, 0.7),
			lightEmission = 0,
			transparency = 0.5,
			spread = 70,
		})
		ringBurst(CFrame.new(ground.Position + Vector3.new(0, 0.1, 0)), COLORS.Dash, 0.6, 3.5, 0.25, 0.12)
	end
end

function Effects.Evasive(data)
	local character: Model? = data.character
	local root = getRoot(character)
	if not character or not root then
		return
	end
	afterimage(character, COLORS.Evasive, 0.5)
	flash(root.Position, COLORS.Evasive, 7, 0.25)
	ringBurst(CFrame.new(root.Position), COLORS.Evasive, 1, 8, 0.35, 0.25)
	burst(root.Position, {
		color = COLORS.Evasive,
		count = 20,
		size = 1,
		speed = NumberRange.new(20, 40),
		streaks = true,
	})
	popup(root.Position + Vector3.new(0, 3, 0), "EVASIVE", COLORS.Evasive, 1.2)
	if isLocal(character) then
		screenFlash(COLORS.Evasive, 0.25)
	end
end

-- A ragdoll slamming into the floor or a wall.
function Effects.BodyImpact(data)
	local position: Vector3 = data.position
	local strength: number = math.clamp(tonumber(data.strength) or 0.5, 0.2, 1)
	local ground = groundBelow(position)
	local spot = if ground then ground.Position else position
	local dustColor = if ground and ground.Instance:IsA("BasePart") then ground.Instance.Color else COLORS.Dust

	burst(spot, {
		texture = TEXTURES.Smoke,
		color = dustColor:Lerp(Color3.new(1, 1, 1), 0.35),
		count = math.floor(6 + 10 * strength),
		size = 2 + 2.5 * strength,
		speed = NumberRange.new(6, 14 * strength + 6),
		lifetime = NumberRange.new(0.5, 1),
		lightEmission = 0,
		transparency = 0.35,
		drag = 3,
		spread = 75,
	})
	ringBurst(CFrame.new(spot + Vector3.new(0, 0.15, 0)), Color3.new(1, 1, 1), 0.8, 3 + 4 * strength, 0.25, 0.12)
	if strength > 0.6 and ground then
		groundRocks(spot, math.floor(4 + 6 * strength), 1.5 + 1.5 * strength, 1 + strength)
	end
end

function Effects.Crater(data)
	local position: Vector3 = data.position
	if data.small then
		-- M1 downslams: a modest dent, not a skill-sized crater.
		groundRocks(position, 6, 2, 1.1)
		ringBurst(CFrame.new(position + Vector3.new(0, 0.2, 0)), Color3.new(1, 1, 1), 0.6, 5, 0.25, 0.15)
		return
	end
	groundRocks(position, 12, 4, 2.2)
	ringBurst(CFrame.new(position + Vector3.new(0, 0.2, 0)), Color3.new(1, 1, 1), 1, 10, 0.35, 0.3)
	flash(position, COLORS.Heavy, 6, 0.2)
	light(position, COLORS.Heavy, 6, 20, 0.35)

	-- Anyone nearby feels the slam.
	local myRoot = getRoot(localPlayer.Character)
	if myRoot then
		local distance = (myRoot.Position - position).Magnitude
		if distance < 40 then
			CameraShake.Add(0.35 * (1 - distance / 40))
		end
	end
end

---------------------------------------------------------------------------

---------------------------------------------------------------------------
-- Public helpers used by the move animations
---------------------------------------------------------------------------

-- Streak behind a striking limb (fist or foot) for `duration` seconds.
function VFX.LimbTrail(character: Model, limbName: string, duration: number, color: Color3?)
	local limbPart = character:FindFirstChild(limbName)
	if not limbPart or not limbPart:IsA("BasePart") then
		return
	end
	-- Two points near the end of the limb (R6 limbs are 2 studs long).
	local tip = Instance.new("Attachment")
	tip.Position = Vector3.new(0, -1.1, 0)
	tip.Parent = limbPart
	local mid = Instance.new("Attachment")
	mid.Position = Vector3.new(0, -0.3, 0)
	mid.Parent = limbPart

	local trail = Instance.new("Trail")
	trail.Attachment0 = tip
	trail.Attachment1 = mid
	trail.Color = ColorSequence.new(color or COLORS.Swing)
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Lifetime = 0.12
	trail.MinLength = 0
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.FaceCamera = true
	trail.Parent = limbPart

	task.delay(duration, function()
		trail.Enabled = false
		task.wait(trail.Lifetime)
		trail:Destroy()
		tip:Destroy()
		mid:Destroy()
	end)
end

-- Burst of displaced air in front of a punch or kick.
function VFX.AirPop(character: Model, heavy: boolean)
	local root = getRoot(character)
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local position = root.Position + look * (if heavy then 3.5 else 3) + Vector3.new(0, 0.5, 0)
	impactRing(position, look, COLORS.Swing, 0.3, if heavy then 3.2 else 1.8, if heavy then 0.2 else 0.14)
	burst(position, {
		color = COLORS.Swing,
		count = if heavy then 8 else 4,
		size = 0.5,
		speed = NumberRange.new(10, 20),
		lifetime = NumberRange.new(0.1, 0.2),
		streaks = true,
		spread = 35,
		direction = look,
	})
	if heavy then
		flash(position, COLORS.Swing, 2.5, 0.1)
	end
end

-- Building blocks for character kits (Client/Kits/*).
VFX.Util = {
	folder = fxFolder,
	textures = TEXTURES,
	newPart = newPart,
	tween = tween,
	randomUnit = randomUnit,
	randomAngles = randomAngles,
	getRoot = getRoot,
	isLocal = isLocal,
	groundBelow = groundBelow,
	burst = burst,
	flash = flash,
	ringBurst = ringBurst,
	impactRing = impactRing,
	light = light,
	highlight = highlight,
	afterimage = afterimage,
	bodyTrail = bodyTrail,
	shards = shards,
	groundRocks = groundRocks,
	popup = popup,
	screenFlash = screenFlash,
	glint = glint,
	sparks = sparks,
	speedLines = speedLines,
	shockwave = shockwave,
	groundCracks = groundCracks,
	debris = debris,
	pillar = pillar,
	spiral = spiral,
	lightning = lightning,
	colorGrade = colorGrade,
}

-- Adds (or replaces) a named effect the server can trigger.
function VFX.Register(name: string, effect: (data: any) -> ())
	Effects[name] = effect
end

-- A character-specific version of an effect (e.g. Asta's own dash). Used
-- when data.character is playing that kit.
local kitEffects: { [string]: { [string]: (data: any) -> () } } = {}
function VFX.RegisterKitEffect(kitId: string, name: string, effect: (data: any) -> ())
	kitEffects[kitId] = kitEffects[kitId] or {}
	kitEffects[kitId][name] = effect
end

function VFX.SetPalette(kitId: string, palette: Palette)
	palettes[kitId] = palette
end

-- Plays an effect locally (used for instant feedback on your own actions).
-- The kit whose version of `name` should play: the attacker's (data.kit),
-- then the acting character's, then the defender's (data.victimKit), so a
-- block against Asta's sword, or by it, makes sword sparks.
local function overrideFor(name: string, data: any): ((data: any) -> ())?
	if type(data) ~= "table" then
		return nil
	end
	local candidates = { data.kit }
	if typeof(data.character) == "Instance" then
		table.insert(candidates, data.character:GetAttribute("Kit"))
	end
	table.insert(candidates, data.victimKit)
	for _, kitId in candidates do
		local overrides = if type(kitId) == "string" then kitEffects[kitId] else nil
		if overrides and overrides[name] then
			return overrides[name]
		end
	end
	return nil
end

-- Plays the built-in version of an effect, ignoring kit overrides (lets an
-- override add to the default instead of replacing it).
function VFX.PlayDefault(name: string, data: any)
	local effect = Effects[name]
	if effect then
		task.spawn(effect, data)
	end
end

function VFX.Play(name: string, data: any)
	local effect = overrideFor(name, data) or Effects[name]
	if effect then
		task.spawn(effect, data)
	end
end

function VFX.Start()
	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if type(name) == "string" and type(data) == "table" then
			VFX.Play(name, data)
		end
	end)
end

return VFX
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
