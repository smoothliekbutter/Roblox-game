      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Impulse</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local Impulse = {}

function Impulse.Apply(
	root: BasePart,
	velocity: Vector3,
	duration: number,
	name: string?,
	taper: number?
): LinearVelocity
	local id = "Impulse_" .. (name or "Default")
	local existing = root:FindFirstChild(id)
	if existing then
		existing:Destroy()
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = id
	attachment.Parent = root

	local mover = Instance.new("LinearVelocity")
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	local vertical = if math.abs(velocity.Y) > 0.01 then 1e6 else 0
	mover.MaxAxesForce = Vector3.new(1e6, vertical, 1e6)
	mover.VectorVelocity = velocity
	mover.Parent = attachment

	if taper and taper > 0 and duration > 0 then
		local start = os.clock()
		local easeFrom = duration * (1 - math.min(taper, 1))
		local from: Vector3? = nil
		local connection
		connection = RunService.Heartbeat:Connect(function()
			if not mover.Parent then
				connection:Disconnect()
				return
			end
			local t = os.clock() - start
			if t < easeFrom then
				return
			end
			from = from or mover.VectorVelocity
			local a = math.clamp((t - easeFrom) / (duration - easeFrom), 0, 1)
			mover.VectorVelocity = (from :: Vector3) * (1 - a * a * (3 - 2 * a))
		end)
	end

	task.delay(duration, function()
		attachment:Destroy()
	end)

	return mover
end

function Impulse.Clear(root: BasePart)
	for _, child in root:GetChildren() do
		if child:IsA("Attachment") and string.sub(child.Name, 1, 8) == "Impulse_" then
			child:Destroy()
		end
	end
end

return Impulse
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Kits</string>
          <string name="Source"><![CDATA[export type SkillInfo = {
	name: string,
	cooldown: number,
	type: string,
	airHold: boolean?,
}

export type SwordInfo = {
	name: string,
	skills: { SkillInfo },
}

export type KitInfo = {
	id: string,
	title: string,
	description: string,
	color: Color3,
	playable: boolean,
	m1: { [string]: any },
	skills: { SkillInfo },
	special: SkillInfo?,
	awakenedSkills: { SkillInfo }?,
	awakenedSpecial: SkillInfo?,
	swords: { [string]: SwordInfo }?,
	awakening: {
		name: string,
		duration: number,
		damageMultiplier: number,
		cooldownMultiplier: number,
		speedBonus: number,
	}?,
	airJumps: number?,
	ascension: {
		name: string,
		duration: number,
		charge: number,
		chargeByKit: boolean?,
		damageMultiplier: number,
		cooldownMultiplier: number,
		speedBonus: number,
		skills: { SkillInfo },
	}?,
}

local Kits = {}

Kits.Default = "AntiMagic"

Kits.Order = { "AntiMagic", "Wind", "Water", "Dark", "Flame", "Lightning" }

local function comingSoon(id: string, title: string, description: string, color: Color3): KitInfo
	return {
		id = id,
		title = title,
		description = description,
		color = color,
		playable = false,
		m1 = {},
		skills = {},
	}
end

Kits.List = {
	AntiMagic = {
		id = "AntiMagic",
		title = "Anti-Magic Knight",
		description = "No magic at all. A demon-slaying greatsword that cuts through every spell.",
		color = Color3.fromRGB(205, 35, 45),
		playable = true,
		m1 = {
			HitboxSize = Vector3.new(7, 6, 7),
			HitboxOffset = 3.75,
			Damage = 4,
			FinisherDamage = 6,
			WindUp = 0.11,
			FinisherWindUp = 0.18,
		},
		skills = {
			{ name = "Bull Thrust", cooldown = 10, type = "Melee", airHold = true },
			{ name = "Black Meteorite", cooldown = 13, type = "Melee", airHold = true },
			{ name = "Black Divider", cooldown = 11, type = "Melee", airHold = true },
			{ name = "Anti-Magic Deflect", cooldown = 14, type = "Counter", airHold = true },
		},
		special = { name = "Anti-Magic Leap", cooldown = 10, type = "Melee", airHold = true },
		awakenedSkills = {
			{ name = "Black Hurricane", cooldown = 9, type = "Melee", airHold = true },
			{ name = "Slayer Recall", cooldown = 12, type = "Bolt", airHold = true },
			{ name = "Grand Divider", cooldown = 13, type = "Explosion", airHold = true },
			{ name = "Black Moon", cooldown = 25, type = "Melee" },
		},
		awakenedSpecial = { name = "Swap Sword", cooldown = 0, type = "Melee" },
		swords = {
			Slayer = {
				name = "Demon-Slayer Sword",
				skills = {
					{ name = "Black Hurricane", cooldown = 9, type = "Melee", airHold = true },
					{ name = "Slayer Recall", cooldown = 12, type = "Bolt", airHold = true },
				},
			},
			Destroyer = {
				name = "Demon-Destroyer Sword",
				skills = {
					{ name = "Causality Break", cooldown = 15, type = "Zone", airHold = true },
					{ name = "Black Comet", cooldown = 14, type = "Melee", airHold = true },
				},
			},
			Slasher = {
				name = "Demon-Slasher Katana",
				skills = {
					{ name = "Black Ascent", cooldown = 12, type = "Melee", airHold = true },
					{ name = "Zetten", cooldown = 16, type = "Counter", airHold = true },
				},
			},
		},
		awakening = {
			name = "Black Form",
			duration = 55,
			damageMultiplier = 1.25,
			cooldownMultiplier = 0.8,
			speedBonus = 6,
		},
	} :: KitInfo,

	Wind = {
		id = "Wind",
		title = "Prince of Wind",
		description = "Wind magic blessed by the spirit Sylph, and star magic. Fights from range and is never where you left him.",
		color = Color3.fromRGB(90, 220, 150),
		playable = true,
		m1 = {
			HitboxOffset = 3.5,
		},
		airJumps = 1,
		skills = {
			{ name = "Wind Blades Shower", cooldown = 11, type = "Swarm", airHold = true },
			{ name = "Swift White Hawk", cooldown = 8, type = "Bolt", airHold = true },
			{ name = "Heavenly Wind Ark", cooldown = 12, type = "Zone", airHold = true },
			{ name = "Gale White Bow", cooldown = 15, type = "Bolt", airHold = true },
		},
		special = { name = "Conjunction", cooldown = 10, type = "Melee" },
		awakenedSkills = {
			{ name = "Spirit Storm", cooldown = 12, type = "Bolt", airHold = true },
			{ name = "Tempest Dive", cooldown = 16, type = "Melee", airHold = true },
			{ name = "Quartile Scutum", cooldown = 16, type = "Counter" },
			{ name = "Nova Vortex", cooldown = 14, type = "Zone", airHold = true },
		},
		awakening = {
			name = "Half-Crown",
			duration = 45,
			damageMultiplier = 1.15,
			cooldownMultiplier = 0.85,
			speedBonus = 4,
		},
		ascension = {
			name = "Full-Crown",
			duration = 30,
			charge = 2,
			chargeByKit = true,
			damageMultiplier = 1.3,
			cooldownMultiplier = 0.75,
			speedBonus = 8,
			skills = {
				{ name = "Spirit of Boreas", cooldown = 12, type = "Melee", airHold = true },
				{ name = "Spirit of Zephyrus", cooldown = 13, type = "Melee", airHold = true },
				{ name = "Spirit of Euros", cooldown = 18, type = "Bolt", airHold = true },
				{ name = "Saint Spirit of Zephyr", cooldown = 30, type = "Melee" },
			},
		},
	} :: KitInfo,
	Water = comingSoon("Water", "Water Princess", "Royal water magic.", Color3.fromRGB(80, 160, 255)),
	Dark = comingSoon("Dark", "Dark Captain", "Dark magic that slices space.", Color3.fromRGB(120, 70, 190)),
	Flame = comingSoon("Flame", "Flame Lioness", "Overwhelming flame magic.", Color3.fromRGB(255, 120, 40)),
	Lightning = comingSoon("Lightning", "Battle Maniac", "Lightning-fast magic.", Color3.fromRGB(255, 225, 70)),
} :: { [string]: KitInfo }

function Kits.Get(id: string?): KitInfo?
	if id == nil then
		return nil
	end
	return Kits.List[id]
end

function Kits.SkillsOf(character: Model): { SkillInfo }
	local kit = Kits.Of(character)
	if not kit then
		return {}
	end
	if character:GetAttribute("Awakened") == true and kit.ascension and character:GetAttribute("Ascended") == true then
		return kit.ascension.skills
	end
	if character:GetAttribute("Awakened") == true and kit.awakenedSkills then
		local sword = character:GetAttribute("Sword")
		local weapon = if kit.swords and type(sword) == "string" then kit.swords[sword] else nil
		if weapon then
			local merged = table.clone(kit.awakenedSkills)
			for slot, skill in weapon.skills do
				merged[slot] = skill
			end
			return merged
		end
		return kit.awakenedSkills
	end
	return kit.skills
end

function Kits.Of(character: Model): KitInfo?
	return Kits.Get(character:GetAttribute("Kit") :: string?)
end

return Kits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MeteorVortex</string>
          <string name="Source"><![CDATA[local MeteorVortex = {}

MeteorVortex.Length = 1.2
MeteorVortex.Turns = 3
MeteorVortex.Top = 20
MeteorVortex.AirTop = 8
MeteorVortex.Bob = 4
MeteorVortex.Radius = 1.5

MeteorVortex.Flip = 0.14
MeteorVortex.DiveSpeed = 45
MeteorVortex.SpinRate = 9
MeteorVortex.Recover = 0.26
MeteorVortex.ImpactHeight = 3.2
MeteorVortex.NoFloorDrop = 16

local UP = Vector3.yAxis

export type Plan = {
	origin: CFrame,
	top: number,
	floorY: number?,
	topPosition: Vector3,
	diveEnd: Vector3,
	drop: number,
	spins: number,
	flipAt: number,
	diveAt: number,
	impactAt: number,
	length: number,
}

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

function MeteorVortex.Plan(origin: CFrame, top: number, floorY: number?): Plan
	local topPosition = origin.Position + UP * top
	local forward = origin.LookVector
	local endY = if floorY then floorY + MeteorVortex.ImpactHeight else topPosition.Y - MeteorVortex.NoFloorDrop
	endY = math.min(endY, topPosition.Y - 2)
	local drop = topPosition.Y - endY
	local dive = math.clamp(drop / MeteorVortex.DiveSpeed, 0.35, 0.9)
	local flipAt = MeteorVortex.Length
	local diveAt = flipAt + MeteorVortex.Flip
	local impactAt = diveAt + dive
	return {
		origin = origin,
		top = top,
		floorY = floorY,
		topPosition = topPosition,
		diveEnd = Vector3.new(topPosition.X, endY, topPosition.Z) + forward * 1.8,
		drop = drop,
		spins = math.max(2, math.floor(MeteorVortex.SpinRate * dive + 0.5)),
		flipAt = flipAt,
		diveAt = diveAt,
		impactAt = impactAt,
		length = impactAt + MeteorVortex.Recover,
	}
end

function MeteorVortex.Angle(a: number): number
	return MeteorVortex.Turns * 2 * math.pi * smooth(math.clamp(a, 0, 1))
end

function MeteorVortex.Spin(origin: CFrame, t: number, top: number?): CFrame
	local a = math.clamp(t / MeteorVortex.Length, 0, 1)
	local angle = MeteorVortex.Angle(a)
	local height = (top or MeteorVortex.Top) * smooth(a)
		+ MeteorVortex.Bob * math.sin(a * math.pi * 4) * math.sin(a * math.pi)
	local circle = (origin.RightVector * math.sin(angle) + origin.LookVector * (math.cos(angle) - 1))
		* MeteorVortex.Radius
	local position = origin.Position + UP * height + circle
	local pull = 4 * a * (1 - a)
	return CFrame.new(position)
		* origin.Rotation
		* CFrame.Angles(0, -angle, 0)
		* CFrame.Angles(math.rad(10) * pull, 0, -math.rad(12) * pull)
end

function MeteorVortex.At(plan: Plan, t: number): CFrame
	if t <= plan.flipAt then
		return MeteorVortex.Spin(plan.origin, t, plan.top)
	end
	local forward = plan.origin.LookVector
	if t <= plan.diveAt then
		local a = (t - plan.flipAt) / (plan.diveAt - plan.flipAt)
		local e = smooth(a)
		local position = plan.topPosition + UP * math.sin(a * math.pi) * 1.2 + forward * 0.6 * e
		return CFrame.new(position) * plan.origin.Rotation * CFrame.Angles(-math.pi * e, 0, 0)
	end
	if t <= plan.impactAt then
		local a = (t - plan.diveAt) / (plan.impactAt - plan.diveAt)
		local from = plan.topPosition + forward * 0.6
		local position = from:Lerp(plan.diveEnd, a) - UP * plan.drop * (a ^ 1.7 - a)
		local spin = plan.spins * 2 * math.pi * a
		return CFrame.new(position) * CFrame.Angles(0, -spin, 0) * plan.origin.Rotation * CFrame.Angles(-math.pi, 0, 0)
	end
	local a = math.clamp((t - plan.impactAt) / (plan.length - plan.impactAt), 0, 1)
	local e = smooth(a)
	local landY = if plan.floorY then plan.floorY + 3 else plan.diveEnd.Y
	local position = Vector3.new(plan.diveEnd.X, plan.diveEnd.Y + (landY - plan.diveEnd.Y) * e, plan.diveEnd.Z)
		+ UP * math.sin(a * math.pi) * 1.5
		+ forward * 1.5 * e
	return CFrame.new(position) * plan.origin.Rotation * CFrame.Angles(-math.pi * (1 + e), 0, 0)
end

return MeteorVortex
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = { "Action", "VFX", "CameraShake", "Impulse", "Notify" }

local Remotes: { [string]: RemoteEvent } = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in NAMES do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in NAMES do
		Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">SaintZephyr</string>
          <string name="Source"><![CDATA[local SaintZephyr = {}

local UP = Vector3.yAxis

local PATH = {
	Lift = 1.0,
	Open = 1.15,
	Hover = 1.2,
	Cuts = { 1.62, 1.89, 2.15, 2.4, 2.64, 2.87, 3.09, 3.3 },
	Cross = 3.6,
	Rise = 3.94,
	Strike = 4.72,
	Burst = 4.97,
	Land = 5.32,
	Length = 6.3,
}
SaintZephyr.SlowMo = 0.16
SaintZephyr.Linger = 0.15

local function smoother(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * x * (x * (x * 6 - 15) + 10)
end

local SLOW_FROM = PATH.Strike - SaintZephyr.SlowMo + SaintZephyr.Linger / 2

function SaintZephyr.PathTime(t: number): number
	return t - SaintZephyr.Linger * smoother((t - SLOW_FROM) / (2 * SaintZephyr.SlowMo))
end

function SaintZephyr.RealTime(p: number): number
	if p <= SLOW_FROM then
		return p
	end
	local t = p + SaintZephyr.Linger / 2
	for _ = 1, 12 do
		local x = (t - SLOW_FROM) / (2 * SaintZephyr.SlowMo)
		local slope = if x > 0 and x < 1
			then 1 - SaintZephyr.Linger / (2 * SaintZephyr.SlowMo) * 30 * x * x * (1 - x) * (1 - x)
			else 1
		t -= (SaintZephyr.PathTime(t) - p) / slope
	end
	return t
end

SaintZephyr.Times = {
	Lift = PATH.Lift,
	Open = PATH.Open,
	Hover = PATH.Hover,
	Cuts = table.clone(PATH.Cuts),
	Cross = PATH.Cross,
	Rise = PATH.Rise,
	Strike = SaintZephyr.RealTime(PATH.Strike),
	Burst = SaintZephyr.RealTime(PATH.Burst),
	Land = SaintZephyr.RealTime(PATH.Land),
	Length = SaintZephyr.RealTime(PATH.Length),
}
SaintZephyr.Height = 32
SaintZephyr.Ring = 12
SaintZephyr.Above = 22
SaintZephyr.Charge = 0.26
SaintZephyr.Drift = 2
SaintZephyr.Dive = 0.18
SaintZephyr.Lift = 1.8

local ELEVATIONS = { 24, -18, 28, -24, 16, -28, 22, -20 }
local HOVER_ELEVATION = -12
local CROSS_ELEVATION = 38
local HALF_PETAL = math.rad(22.5)
local PASS_REACH = 1.45
local TIP_SPEED = 0.25
local SWAY = 0.35
local LEAN = math.rad(16)

export type Plan = {
	origin: CFrame,
	start: Vector3,
	forward: Vector3,
	right: Vector3,
	floorY: number,
	center: Vector3,
	hover: Vector3,
	stars: { Vector3 },
	passes: { Vector3 },
	speeds: { number },
	tangents: { Vector3 },
	top: Vector3,
	ground: Vector3,
}

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function direction(plan: Plan, azimuth: number, elevation: number): Vector3
	local flat = plan.forward * math.cos(azimuth) + plan.right * math.sin(azimuth)
	return flat * math.cos(elevation) + UP * math.sin(elevation)
end

local function passTimes(): { number }
	local times = table.clone(PATH.Cuts)
	table.insert(times, PATH.Cross)
	return times
end

function SaintZephyr.Plan(origin: CFrame, victimPosition: Vector3, floorY: number): Plan
	local toward = victimPosition - origin.Position
	local flat = Vector3.new(toward.X, 0, toward.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
	end
	local forward = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	local right = forward:Cross(UP)
	local start = Vector3.new(victimPosition.X, floorY + 3, victimPosition.Z)
	local center = start + UP * SaintZephyr.Height
	local ring = SaintZephyr.Ring
	local plan: Plan = {
		origin = origin,
		start = start,
		forward = forward,
		right = right,
		floorY = floorY,
		center = center,
		hover = center,
		stars = {},
		passes = {},
		speeds = {},
		tangents = {},
		top = center,
		ground = start,
	}

	local home = math.pi
	local hoverElevation = math.rad(HOVER_ELEVATION)
	plan.hover = center + direction(plan, home, hoverElevation) * ring
	local azimuths, elevations = {}, {}
	for i = 1, #ELEVATIONS do
		azimuths[i] = home + math.pi + HALF_PETAL + (i - 1) * math.rad(225)
		elevations[i] = math.rad(ELEVATIONS[i])
		table.insert(plan.stars, center + direction(plan, azimuths[i], elevations[i]) * ring)
	end

	table.insert(plan.passes, (center - plan.hover).Unit)
	for i = 2, #ELEVATIONS do
		local from = direction(plan, azimuths[i - 1] + HALF_PETAL, elevations[i - 1])
		local to = direction(plan, azimuths[i] - HALF_PETAL, elevations[i])
		table.insert(plan.passes, (to - from).Unit)
	end
	local cross = math.rad(CROSS_ELEVATION)
	table.insert(plan.passes, (direction(plan, 0, cross) - direction(plan, math.pi, -cross)).Unit + right * 0.12)
	plan.passes[#plan.passes] = plan.passes[#plan.passes].Unit

	local times = passTimes()
	for i, at in times do
		if i == 1 then
			plan.speeds[i] = 3 * ring / SaintZephyr.Charge
		else
			local before = (at - times[i - 1]) / 2
			local after = if times[i + 1] then (times[i + 1] - at) / 2 else before
			plan.speeds[i] = PASS_REACH * ring / ((before + after) / 2)
		end
	end
	for i, star in plan.stars do
		local radial = (star - center).Unit
		local across = -(plan.passes[i] + plan.passes[i + 1])
		across -= radial * radial:Dot(across)
		plan.tangents[i] = if across.Magnitude > 1e-3 then across.Unit else plan.right
	end

	local reach = 7
	plan.top = center + UP * SaintZephyr.Above + forward * reach
	plan.ground = start - forward * (reach * SaintZephyr.Height / (SaintZephyr.Above + SaintZephyr.Drift))
	return plan
end

local function hermite(
	p0: Vector3,
	v0: Vector3,
	p1: Vector3,
	v1: Vector3,
	duration: number,
	s: number
): (Vector3, Vector3)
	local s2, s3 = s * s, s * s * s
	local m0, m1 = v0 * duration, v1 * duration
	local position = p0 * (2 * s3 - 3 * s2 + 1) + m0 * (s3 - 2 * s2 + s) + p1 * (3 * s2 - 2 * s3) + m1 * (s3 - s2)
	local velocity = p0 * (6 * s2 - 6 * s) + m0 * (3 * s2 - 4 * s + 1) + p1 * (6 * s - 6 * s2) + m1 * (3 * s2 - 2 * s)
	return position, velocity / duration
end

local function petals(plan: Plan, t: number): (Vector3, Vector3)
	local times = passTimes()
	local count = #times
	if t >= times[count] then
		local duration = PATH.Rise - times[count]
		local s = math.clamp((t - times[count]) / duration, 0, 1)
		return hermite(plan.center, plan.passes[count] * plan.speeds[count], plan.top, UP * 4, duration, s)
	end
	local index = 1
	for i = 1, count - 1 do
		if t >= times[i] then
			index = i
		end
	end
	local from, to = times[index], times[index + 1]
	local tip = (from + to) / 2
	local half = (to - from) / 2
	local star = plan.stars[index]
	local tipVelocity = plan.tangents[index] * plan.speeds[index] * TIP_SPEED
	if t < tip then
		return hermite(plan.center, plan.passes[index] * plan.speeds[index], star, tipVelocity, half, (t - from) / half)
	end
	return hermite(
		star,
		tipVelocity,
		plan.center,
		plan.passes[index + 1] * plan.speeds[index + 1],
		half,
		(t - tip) / half
	)
end

local function poised(plan: Plan, position: Vector3, pitch: number): CFrame
	return CFrame.new(position) * CFrame.lookAt(Vector3.zero, -plan.forward).Rotation * CFrame.Angles(pitch, 0, 0)
end

local function lean(speed: number): CFrame
	return CFrame.Angles(-LEAN * math.min(speed / 120, 1), 0, 0)
end

local function turning(from: Vector3, to: Vector3, u: number): Vector3
	local axis = to:Cross(from)
	if axis.Magnitude < 1e-4 then
		axis = if math.abs(from.Y) < 0.9 then UP:Cross(from) else Vector3.xAxis
	end
	local short = math.acos(math.clamp(from:Dot(to), -1, 1))
	local eased = u - SWAY * math.sin(2 * math.pi * u) / (2 * math.pi)
	return CFrame.fromAxisAngle(axis.Unit, (2 * math.pi - short) * eased):VectorToWorldSpace(from)
end

local POISED_PITCH = math.rad(-18)

local function yawOf(direction: Vector3): number
	return math.atan2(-direction.X, -direction.Z)
end

local function wrap(angle: number): number
	return (angle + math.pi) % (2 * math.pi) - math.pi
end

local function softPitch(pitch: number): number
	local k, m = math.rad(30), math.rad(55)
	local over = math.abs(pitch) - k
	if over <= 0 then
		return pitch
	end
	return math.sign(pitch) * (k + (m - k) * math.tanh(over / (m - k)))
end

local function flight(plan: Plan, t: number): (Vector3, Vector3)
	local times = PATH
	local cuts = times.Cuts
	local charge = cuts[1] - SaintZephyr.Charge
	if t < times.Hover then
		local a = smooth((t - 0.25) / (times.Hover - 0.25))
		local from, to = plan.origin.Position, plan.hover
		local bow = plan.right * 4 + UP * 2
		local position = from:Lerp(to, a) + bow * math.sin(a * math.pi)
		return position, Vector3.zero
	elseif t < charge then
		local u = (t - times.Hover) / (charge - times.Hover)
		return plan.hover + UP * 0.35 * math.sin(u * math.pi) ^ 2, Vector3.zero
	elseif t < cuts[1] then
		local s = (t - charge) / SaintZephyr.Charge
		local line = plan.center - plan.hover
		return plan.hover + line * (s * s * s), line * (3 * s * s / SaintZephyr.Charge)
	end
	return petals(plan, t)
end

local function diveTimes(): (number, number)
	local above = SaintZephyr.Above + SaintZephyr.Drift
	local through = math.sqrt(above / (above + SaintZephyr.Height))
	local strike = PATH.Strike
	return strike - through * SaintZephyr.Dive, strike + (1 - through) * SaintZephyr.Dive
end

local victimAt: (Plan, number) -> CFrame

local function attackerAt(plan: Plan, t: number): CFrame
	local times = PATH
	local cuts = times.Cuts
	if t < 0.25 then
		return plan.origin
	end
	if t < times.Hover then
		local position = flight(plan, t)
		local look = victimAt(plan, math.min(t, times.Lift)).Position - position
		local flat = Vector3.new(look.X, 0, look.Z)
		local heading = if flat.Magnitude > 1e-3 then flat.Unit else plan.forward
		local first = victimAt(plan, 0.25).Position - plan.origin.Position
		first = Vector3.new(first.X, 0, first.Z)
		first = if first.Magnitude > 1e-3 then first.Unit else plan.forward
		local start = plan.origin.LookVector
		start = Vector3.new(start.X, 0, start.Z)
		start = if start.Magnitude > 1e-3 then start.Unit else plan.forward
		local ease = smooth((t - 0.25) / 0.35)
		local turn = wrap(yawOf(first) - yawOf(start)) + wrap(yawOf(heading) - yawOf(first))
		local yaw = yawOf(start) + turn * ease
		local pitch = softPitch(math.atan2(look.Y, math.max(flat.Magnitude, 1e-3))) * ease
		return CFrame.new(position) * CFrame.fromOrientation(pitch, yaw, 0)
	end
	if t < cuts[1] then
		local position, velocity = flight(plan, t)
		return CFrame.lookAt(position, position + plan.passes[1]) * lean(velocity.Magnitude)
	end
	if t < times.Cross then
		local position, velocity = flight(plan, t)
		local passes = passTimes()
		local index = 1
		for i = 1, #passes - 1 do
			if t >= passes[i] then
				index = i
			end
		end
		local u = (t - passes[index]) / (passes[index + 1] - passes[index])
		local heading = turning(plan.passes[index], plan.passes[index + 1], u)
		return CFrame.lookAt(position, position + heading) * lean(velocity.Magnitude)
	end
	if t < times.Rise then
		local position = flight(plan, t)
		local count = #plan.passes
		local x = plan.passes[count]
		local out = CFrame.lookAt(position, position + x) * lean(plan.speeds[count])
		local w = smooth((t - times.Cross) / (times.Rise - times.Cross))
		return out:Lerp(poised(plan, position, POISED_PITCH), w)
	end
	local hold, landed = diveTimes()
	if t < hold then
		local s = math.clamp((t - times.Rise) / (hold - times.Rise), 0, 1)
		local position =
			hermite(plan.top, UP * 4, plan.top + UP * SaintZephyr.Drift, Vector3.zero, hold - times.Rise, s)
		return poised(plan, position, POISED_PITCH)
	end
	if t < landed then
		local s = (t - hold) / (landed - hold)
		local from = plan.top + UP * SaintZephyr.Drift
		return poised(plan, from:Lerp(plan.ground, s * s), POISED_PITCH * (1 - smooth(s)))
	end
	local turn = smooth((t - landed) / 0.9)
	return CFrame.new(plan.ground)
		* CFrame.lookAt(Vector3.zero, -plan.forward).Rotation
		* CFrame.Angles(0, math.rad(14) * turn, 0)
end

local function knock(t: number, at: number, peak: number): number
	if t < at then
		return 0
	end
	local u = (t - at) / peak
	return u * math.exp(1 - u)
end

local function hanging(plan: Plan, t: number): CFrame
	local times = PATH
	local toward = CFrame.lookAt(Vector3.zero, -plan.forward).Rotation
	local offset = Vector3.zero
	local twist, tip = 0, 0
	local passes = passTimes()
	for i, at in passes do
		local k = knock(t, at, 0.05)
		local big = i == #passes
		offset += plan.passes[i] * (if big then 1.2 else 0.7) * k
		twist += (if i % 2 == 1 then 1 else -1) * math.rad(if big then 22 else 12) * k
		tip += math.rad(if big then -14 else -6) * k
	end
	local struck = knock(t, times.Strike, 0.08)
	offset += -UP * 2.4 * struck
	tip += math.rad(-25) * struck
	local sway = math.sin(t * 9) * math.rad(8) * (1 - smooth((t - times.Rise) / 0.4))
	return CFrame.new(plan.center + offset) * toward * CFrame.Angles(math.rad(-20) + tip, sway + twist, 0)
end

function victimAt(plan: Plan, t: number): CFrame
	local times = PATH
	if t <= times.Lift then
		local a = smooth(t / times.Lift)
		local hang = hanging(plan, t)
		local toward = CFrame.lookAt(Vector3.zero, -plan.forward).Rotation
		return CFrame.new(plan.start:Lerp(plan.center, a))
			* CFrame.Angles(0, (a - 1) * math.pi * 2, 0)
			* toward:Lerp(hang.Rotation, a)
	end
	if t <= times.Burst then
		return hanging(plan, t)
	end
	local from = hanging(plan, times.Burst)
	local a = math.clamp((t - times.Burst) / (times.Land - times.Burst), 0, 1)
	local floor = Vector3.new(plan.start.X, plan.floorY + 1.5, plan.start.Z)
	return CFrame.new(from.Position:Lerp(floor, a * a)) * from.Rotation * CFrame.Angles(math.rad(-70) * smooth(a), 0, 0)
end

function SaintZephyr.Attacker(plan: Plan, t: number): CFrame
	return attackerAt(plan, SaintZephyr.PathTime(t))
end

function SaintZephyr.Victim(plan: Plan, t: number): CFrame
	return victimAt(plan, SaintZephyr.PathTime(t))
end

function SaintZephyr.DiveTimes(): (number, number)
	local hold, landed = diveTimes()
	return SaintZephyr.RealTime(hold), SaintZephyr.RealTime(landed)
end

return SaintZephyr
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">TempestDive</string>
          <string name="Source"><![CDATA[local TempestDive = {}

local UP = Vector3.yAxis

TempestDive.Times = {
	Lift = 1.1,
	Flip = 1.55,
	Ticks = { 1.85, 2.1, 2.3 },
	Land = 2.5,
	Length = 3.1,
}
TempestDive.Height = 34
TempestDive.Hold = 2.6
TempestDive.Spins = 3

export type Plan = {
	origin: CFrame,
	start: Vector3,
	forward: Vector3,
	floorY: number,
}

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

function TempestDive.Plan(origin: CFrame, victimPosition: Vector3, floorY: number): Plan
	local toward = victimPosition - origin.Position
	local forward = Vector3.new(toward.X, 0, toward.Z)
	if forward.Magnitude < 1e-3 then
		forward = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
	end
	return {
		origin = origin,
		start = victimPosition,
		forward = if forward.Magnitude > 1e-3 then forward.Unit else Vector3.new(0, 0, -1),
		floorY = floorY,
	}
end

local function facing(direction: Vector3): CFrame
	return CFrame.lookAt(Vector3.zero, direction)
end

local function rise(a: number): number
	return TempestDive.Height * (1 - (1 - math.clamp(a, 0, 1)) ^ 2)
end

function TempestDive.Impact(plan: Plan): Vector3
	return Vector3.new(plan.start.X, plan.floorY + 2.5, plan.start.Z)
end

local function top(plan: Plan): Vector3
	return plan.start + UP * TempestDive.Height
end

function TempestDive.DiveAt(plan: Plan, a: number): Vector3
	return top(plan):Lerp(TempestDive.Impact(plan), a * a)
end

function TempestDive.Spin(a: number): number
	return a * a * TempestDive.Spins * 2 * math.pi
end

function TempestDive.Victim(plan: Plan, t: number): CFrame
	local times = TempestDive.Times
	local toward = facing(-plan.forward)
	if t <= times.Lift then
		local a = t / times.Lift
		return CFrame.new(plan.start + UP * rise(a))
			* toward
			* CFrame.Angles(math.rad(-15) * math.sin(a * math.pi), 0, 0)
	end
	if t <= times.Flip then
		local a = smooth((t - times.Lift) / (times.Flip - times.Lift))
		return CFrame.new(top(plan)) * toward * CFrame.Angles(math.pi * a, 0, 0)
	end
	local a = math.clamp((t - times.Flip) / (times.Land - times.Flip), 0, 1)
	return CFrame.new(TempestDive.DiveAt(plan, a))
		* CFrame.Angles(0, -TempestDive.Spin(a), 0)
		* toward
		* CFrame.Angles(math.pi, 0, 0)
end

function TempestDive.Attacker(plan: Plan, t: number): CFrame
	local times = TempestDive.Times
	local ahead = facing(plan.forward)
	local holding = UP * TempestDive.Hold - plan.forward * 0.8
	if t <= times.Lift then
		local position = plan.start + UP * rise(t / times.Lift) + holding
		return CFrame.new(plan.origin.Position:Lerp(position, smooth(t / 0.2))) * ahead
	end
	local above = top(plan) + UP * 3.2
	if t <= times.Flip then
		local a = smooth((t - times.Lift) / (times.Flip - times.Lift))
		local position = (top(plan) + holding):Lerp(above, a) + UP * math.sin(a * math.pi) * 1.5
		return CFrame.new(position) * ahead * CFrame.Angles(math.pi * a, 0, 0)
	end
	if t <= times.Land then
		local a = (t - times.Flip) / (times.Land - times.Flip)
		return CFrame.new(TempestDive.DiveAt(plan, a) + UP * 3.2)
			* CFrame.Angles(0, -TempestDive.Spin(a), 0)
			* ahead
			* CFrame.Angles(math.pi, 0, 0)
	end
	local a = math.clamp((t - times.Land) / (times.Length - times.Land), 0, 1)
	local from = TempestDive.Impact(plan) + UP * 3.2
	local to = Vector3.new(plan.start.X, plan.floorY + 3, plan.start.Z) - plan.forward * 5
	local position = from:Lerp(to, smooth(a)) + UP * math.sin(a * math.pi) * 5
	return CFrame.new(position) * ahead * CFrame.Angles(math.pi * (1 + smooth(a)), 0, 0)
end

return TempestDive
]]></string>
        </Properties>
