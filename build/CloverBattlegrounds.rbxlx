      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BlackComet</string>
          <string name="Source"><![CDATA[

local a={}

local b=Vector3.yAxis

a.Times={
Slams={0.24,0.45,0.64},
Plant=0.79,
Stop=0.92,
Release=1.0,
Length=1.4,
}
a.Distance=30

local c=0.5
local d=1.4
local e=0.055
local f=0.06
local g=0.2

local h=4
local i=0.55
local j=2.8
local k=2
local l=Vector3.new(0,-196.2,0)
local m=0.08
local n=0.98
local o=0.3
local p=1/240

export type Plan={
origin:Vector3,
forward:Vector3,
right:Vector3,
distance:number,
floorY:number,
above:number,
victim:{CFrame},
}

local function q(r:number):number
r=math.clamp(r,0,1)
return r*r*(3-2*r)
end

local function r(s:number):number
local t=f
local u=t*((1-2*t*t)-math.exp(-s/t)*(1-s*s-2*t*s-2*t*t))
return s-s*s*s/3-u
end
local s=r(1)

local function t(u:number):number
local v=a.Times
local w=c*q(u/0.14)*(1-q((u-0.66)/(v.Plant-0.66)))
local x=0
for y,z in v.Slams do
x+=math.exp(-((u-z)/e)^2)
end
return w-d*x
end

function a.Attacker(u:Plan,v:number):CFrame
local w=a.Times
local x=u.distance*r(math.clamp(v/w.Stop,0,1))/s
local y=3+t(v)+u.above*(1-q(v/g))
local z=Vector3.new(u.origin.X,u.floorY+y,u.origin.Z)+u.forward*x
return CFrame.lookAt(z,z+u.forward)
end

local u:{{any}}={
{0,Vector3.new(-1.6,1.18,-1.08)},
{0.05,Vector3.new(-2.48,0.73,-0.49),"Quart","Out"},
{0.11,Vector3.new(-2.21,0.07,-1.29),"Sine","Out"},
{0.17,Vector3.new(-1.94,-0.17,-1.59),"Sine","InOut"},
{0.24,Vector3.new(-2.1,-0.93,-0.65),"Quad","In"},
{0.34,Vector3.new(-1.96,-0.27,-1.55),"Sine","Out"},
{0.45,Vector3.new(-2.1,-0.95,-0.57),"Quad","In"},
{0.54,Vector3.new(-1.97,-0.36,-1.51),"Sine","Out"},
{0.64,Vector3.new(-2.1,-0.97,-0.48),"Quad","In"},
{0.7,Vector3.new(-2.1,-0.93,-0.65),"Sine","Out"},
{0.79,Vector3.new(-2.32,-0.65,-0.35),"Sine","InOut"},
{0.85,Vector3.new(-2.34,-0.52,0.01),"Sine","Out"},
{0.94,Vector3.new(-2.41,0.06,0.1),"Sine","InOut"},
{1,Vector3.new(-1.38,1.06,-1.99),"Quad","In"},
}

local function v(w:number,x:string?,y:string?):number
local function z(A:number):number
if x=="Quart"then
return A^4
elseif x=="Sine"then
return 1-math.cos(A*math.pi/2)
end
return A*A
end
if y=="In"then
return z(w)
elseif y=="InOut"then
return if w<0.5 then z(2*w)/2 else 1-z(2*(1-w))/2
end
return 1-z(1-w)
end


function a.Hand(w:Plan,x:number):Vector3
local y=u[#u][2]
for z=1,#u-1 do
local A,B=u[z],u[z+1]
if x<B[1]then
local C=math.clamp((x-A[1])/(B[1]-A[1]),0,1)
y=(A[2]::Vector3):Lerp(B[2],v(C,B[3],B[4]))
break
end
end
return a.Attacker(w,x):PointToWorldSpace(y)
end

export type Body={feet:Vector3,last:Vector3,look:Vector3,neck:Vector3,t:number}



function a.Body(w:Plan,x:Vector3):Body
local y=-w.forward
local z=x-y*i
local A=z-b*h
return{feet=A,last=A,look=y,neck=z,t=0}
end

function a.Step(w:Plan,x:Body,y:Vector3,z:number):CFrame
local A=w.floorY+0.5
local B,C=x.neck,x.t
local D=y-x.look*i
D=Vector3.new(D.X,math.max(D.Y,w.floorY+0.35),D.Z)
local E=math.clamp(math.floor((z-C)/p+0.5),1,24)
local F=a.Attacker(w,z).Position
local G=k+(j-k)*q(z/0.15)
for H=1,E do
local I=B:Lerp(D,H/E)
local J=x.feet
local K=(J-x.last)*n
x.last=J
J+=K+l*p*p
local function L(M:Vector3)
J+=M
x.last+=M
end
for M=1,3 do
if J.Y<A then

local N=J-x.last
L(Vector3.new(0,A-J.Y,0))
x.last+=Vector3.new(N.X,0,N.Z)*m
end
local N=(J-F):Dot(w.right)
if N>-G then
L(w.right*-(N+G))
end
if J.Y>I.Y-o then
L(Vector3.new(0,I.Y-o-J.Y,0))
end
local O=J-I
J=I+(if O.Magnitude>1e-4 then O.Unit else-b)*h
end
x.feet=J
end
x.neck,x.t=D,z

local H=(D-x.feet).Unit
local I=x.look-H*x.look:Dot(H)
I=if I.Magnitude>1e-3 then I.Unit else(b-H*H.Y).Unit
local J=b-H*H.Y
if J.Magnitude>0.8 and I:Dot(J)>0 then
local K=math.clamp((J.Magnitude-0.8)/0.2,0,1)*math.min((z-C)*6,1)
I=I:Lerp(J.Unit,K).Unit
end
x.look=I
return CFrame.fromMatrix(D-H,H:Cross(-I),H,-I)
end

function a.Plan(w:Vector3,x:Vector3,y:number,z:number):Plan
local A:Plan={
origin=w,
forward=x,
right=x:Cross(b),
distance=y,
floorY=z,
above=math.clamp(w.Y-(z+3),0,40),
victim={},
}

local B=a.Body(A,a.Hand(A,0))
local C=a.Times.Release
for D=0,math.ceil(C*60)do
local E=math.min(D/60,C)
A.victim[D+1]=a.Step(A,B,a.Hand(A,E),E)
end
return A
end


function a.Victim(w:Plan,x:number):CFrame
local y=math.clamp(x,0,a.Times.Release)*60
local z=math.floor(y)
local A=w.victim[z+1]
local B=w.victim[math.min(z+2,#w.victim)]
return A:Lerp(B,y-z)
end

return a]]></string>
        </Properties>
