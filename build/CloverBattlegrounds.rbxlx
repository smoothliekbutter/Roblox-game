			"Linear",
			"Out",
		},
		{
			1.29,
			{
				Torso = body(0.108, 4),
				Head = rot(-12),
				RightArm = limb(172),
				Sword = aim(-0.95, 0.2, 0.2),
				LeftArm = limb(25, 0, -30),
				RightLeg = rot(-6, 0, 8),
				LeftLeg = rot(10, 0, -8),
