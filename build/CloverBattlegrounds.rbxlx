end)
end

h.flash(P,o,5,0.12)
g.twinkle(P,9,n,0.3)
g.windRing(P,D,1,12,0.35)
h.shockwave(P,l,1,14,0.3)
g.windPuff(P+D*2,4,D)
g.streaks(P+D,18,95,D,25)
for V,W in N do
