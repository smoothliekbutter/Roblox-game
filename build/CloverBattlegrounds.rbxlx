              </Properties>
            </Item>
            <Item class="ModuleScript" referent="44">
              <Properties>
                <string name="Name">Hawk</string>
                <string name="Source"><![CDATA[--[[
	The hawk of Swift White Hawk: a bird of wind. A white-hot body in a
	green glow, a head with a gold hooked beak, a fanned tail, and wings
	built like a bird's (an arm and a hand, secondaries trailing off the
	arm, primaries fanned off the hand and splaying at the tip, a bright
	leading edge). It flaps hard, the beat rolling out to the wingtips, and
	banks into its turns.

	Laid out in its own space: -Z where it flies, X its right, Y up.
	Hawk.Pose is plain geometry (where every piece goes); Hawk.new makes
	the parts and Hawk.Place moves them there.
]]

local Soft = require(script.Parent.Parent.Parent.Soft)

local rad = math.rad
local key = Soft.key

local WIND, WIND_WHITE = Soft.WIND, Soft.WIND_WHITE
local STAR = Soft.STAR

local Hawk = {}

-- The wing's bones (arm and hand), and the beat.
local ARM, HAND = 1.25, 1.45
local SHOULDER = Vector3.new(0.35, 0.12, -0.25)
local FLAP = 38 -- degrees the arm beats up and down
local FLICK = 30 -- degrees more at the hand, a little after

export type Piece = {
	shape: "Feather" | "Box" | "Wedge",
	size: Vector3,
	color: Color3,
	transparency: number,
}

-- Feathers on a wing: on the arm (1) or the hand (2), `at` of the way
-- along it, `angle` degrees round from straight back toward the tip;
-- `lift` puts the short coverts over the roots of the rest.
type Feather = { bone: number, at: number, angle: number, length: number, width: number, lift: number? }
local WING: { Feather } = {
	{ bone = 1, at = 0.12, angle = 2, length = 1.05, width = 0.56 },
	{ bone = 1, at = 0.4, angle = 6, length = 1.15, width = 0.56 },
	{ bone = 1, at = 0.68, angle = 10, length = 1.2, width = 0.56 },
	{ bone = 1, at = 0.95, angle = 15, length = 1.25, width = 0.54 },
	{ bone = 2, at = 0.12, angle = 22, length = 1.3, width = 0.5 },
	{ bone = 2, at = 0.36, angle = 34, length = 1.45, width = 0.48 },
	{ bone = 2, at = 0.6, angle = 47, length = 1.55, width = 0.44 },
	{ bone = 2, at = 0.82, angle = 60, length = 1.55, width = 0.4 },
	{ bone = 2, at = 1, angle = 74, length = 1.35, width = 0.34 },
	-- Coverts.
	{ bone = 1, at = 0.3, angle = 8, length = 0.6, width = 0.5, lift = 0.05 },
	{ bone = 1, at = 0.75, angle = 12, length = 0.62, width = 0.5, lift = 0.05 },
	{ bone = 2, at = 0.25, angle = 30, length = 0.66, width = 0.45, lift = 0.05 },
	{ bone = 2, at = 0.65, angle = 50, length = 0.6, width = 0.4, lift = 0.05 },
}
local OUTERMOST = 9 -- (in WING: wind streams off its tip)
local TAIL = { -28, -14, 0, 14, 28 }

-- Everything it's made of, in the order Pose places it: body, glow, head,
-- beak, the tail feathers, then each wing (right, left): its two bones and
-- its feathers.
local PIECES: { Piece } = {
	{ shape = "Feather", size = Vector3.new(0.85, 0.75, 2.3), color = WIND_WHITE, transparency = 0.12 },
	{ shape = "Feather", size = Vector3.new(1.7, 1.5, 3.4), color = WIND, transparency = 0.72 },
	{ shape = "Feather", size = Vector3.new(0.62, 0.6, 0.85), color = WIND_WHITE, transparency = 0.08 },
	{ shape = "Wedge", size = Vector3.new(0.14, 0.24, 0.42), color = STAR, transparency = 0 },
}
for _ in TAIL do
	table.insert(PIECES, { shape = "Feather", size = Vector3.new(0.42, 0.05, 1.45), color = WIND, transparency = 0.3 })
end
for _ = 1, 2 do
	table.insert(PIECES, { shape = "Box", size = Vector3.new(ARM, 0.12, 0.12), color = WIND_WHITE, transparency = 0.1 })
	table.insert(PIECES, { shape = "Box", size = Vector3.new(HAND, 0.1, 0.1), color = WIND_WHITE, transparency = 0.1 })
	for _, f in WING do
		table.insert(PIECES, {
			shape = "Feather",
			size = Vector3.new(f.width, 0.05, f.length),
			color = if f.lift
				then WIND:Lerp(WIND_WHITE, 0.45)
				elseif f.bone == 2 then WIND:Lerp(WIND_WHITE, 0.2)
				else WIND,
			transparency = if f.lift then 0.2 else 0.28,
		})
	end
end
-- Where the outermost primary of the right wing sits in PIECES.
local TIP = 4 + #TAIL + 2 + OUTERMOST

function Hawk.Pieces(): { Piece }
	return PIECES
end

--[[
	Fills `frames` (in Pieces' order) for a hawk at `frame` (-Z where it
	flies), `phase` radians into its wingbeat, banked `bank` radians (its
	right wing down for negative).
]]
function Hawk.Pose(frames: { CFrame }, frame: CFrame, phase: number, bank: number)
	-- It rises a little on each downstroke.
	local body = frame * CFrame.new(0, -0.1 * math.sin(phase), 0) * CFrame.Angles(0, 0, bank)
	frames[1] = body
	frames[2] = body
	frames[3] = body * CFrame.new(0, 0.18, -1.25) * CFrame.Angles(rad(-8), 0, 0)
	frames[4] = body * CFrame.new(0, 0.1, -1.72)
	local n = 4
	for _, spread in TAIL do
		n += 1
		frames[n] = body * CFrame.new(0, 0.05, 1.05) * CFrame.Angles(rad(6), rad(spread), 0) * CFrame.new(0, 0, 0.65)
	end
	local arm = FLAP * math.sin(phase)
	local hand = arm + FLICK * math.sin(phase - 0.7)
	for _, side in { 1, -1 } do
		local shoulder = body
			* CFrame.new(SHOULDER.X * side, SHOULDER.Y, SHOULDER.Z)
			* CFrame.Angles(0, rad(-8) * side, rad(arm) * side)
		local wrist = shoulder
			* CFrame.new(ARM * side, 0, 0)
			* CFrame.Angles(0, rad(-12) * side, rad(hand - arm) * side)
		n += 1
		frames[n] = shoulder * CFrame.new(ARM / 2 * side, 0, -0.05)
		n += 1
		frames[n] = wrist * CFrame.new(HAND / 2 * side, 0, -0.05)
		for _, f in WING do
			local bone, length = if f.bone == 1 then shoulder else wrist, if f.bone == 1 then ARM else HAND
			n += 1
			frames[n] = bone
				* CFrame.new(length * f.at * side, f.lift or 0, 0)
				* CFrame.Angles(0, rad(f.angle) * side, 0)
				* CFrame.new(0, 0, f.length / 2)
		end
	end
end

---------------------------------------------------------------------------
-- The parts
---------------------------------------------------------------------------

export type Hawk = {
	parts: { BasePart },
	frames: { CFrame },
	body: BasePart,
	trails: { Trail },
}

function Hawk.new(start: CFrame): Hawk
	local parts: { BasePart } = {}
	for _, piece in PIECES do
		local part: BasePart
		if piece.shape == "Wedge" then
			part = Soft.newWedge({ Size = piece.size, Color = piece.color, Transparency = piece.transparency })
		else
			part = Soft.U.newPart({ Size = piece.size, Color = piece.color, Transparency = piece.transparency })
			if piece.shape == "Feather" then
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = part
			end
		end
		table.insert(parts, part)
	end
	local hawk = {
		parts = parts,
		frames = table.create(#parts, CFrame.identity),
		body = parts[1],
		trails = {},
	}
	Hawk.Place(hawk, start, 0, 0)
	-- A long ribbon of wind behind it, and wind off each wingtip (made once
	-- it's in place, so they start there).
	table.insert(
		hawk.trails,
		Soft.trail(parts[1], Vector3.new(0, 1, 0.4), Vector3.new(0, -1, 0.4), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new({ key(0, 0.35), key(1, 1) }),
			width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
			lifetime = 0.4,
			texture = Soft.SMOKE,
		})
	)
	for _, tip in { TIP, TIP + 2 + #WING } do
		local feather = parts[tip]
		local half = feather.Size.Z / 2
		table.insert(
			hawk.trails,
			Soft.trail(feather, Vector3.new(0, 0, half - 0.6), Vector3.new(0, 0, half), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
				lifetime = 0.22,
			})
		)
	end
	return hawk
end

-- Poses a hawk (see Pose) and moves its parts there.
function Hawk.Place(hawk: Hawk, frame: CFrame, phase: number, bank: number)
	Hawk.Pose(hawk.frames, frame, phase, bank)
	workspace:BulkMoveTo(hawk.parts, hawk.frames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Lets it go: the trails fade on their own, the body and wings linger
-- (hidden) until they have.
function Hawk.Release(hawk: Hawk, fade: number)
	for _, trail in hawk.trails do
		Soft.endTrail(trail)
	end
	for _, part in hawk.parts do
		Soft.linger(part, fade, 0.55)
	end
end

return Hawk
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="45">
              <Properties>
                <string name="Name">Nova</string>
                <string name="Source"><![CDATA[--[[
	Prince of Wind (Yuno): Nova Vortex (Half-Crown 4), drawn. The server
	(Server/Kits/Wind) decides where it goes, how long it turns and who it
	hits; this draws it:

	  the star    a star forms over his open hand, wind streaming into it,
	              and he flicks it out: it flies spinning on a low arc,
	              trailing starlight and wind.
	  the galaxy  where it lands it opens into a galaxy of wind and stars
	              turning flat over the ground: four arms of wind and
	              starlight curling out of a bright core, stars strewn along
	              them, rings of wind turning round it, a ring of light at
	              the edge of its pull, wind rushing in across the ground
	              from all round, and in its eye a column of wind twisting
	              up. It turns faster the longer it's open.
	  the nova    it all falls into its eye in a blink, then a pillar of
	              starlight bursts up into the sky, twisting with wind: a
	              ring of wind and light races out over the ground, the
	              ground cracks gold, stars scatter.

	All of it see-through wind and light, so you can see who's caught in it.
]]

local RunService = game:GetService("RunService")

local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local Soft = require(script.Parent.Parent.Parent.Soft)

local U = Soft.U
local UP = Vector3.yAxis
local key = Soft.key

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE = Soft.SMOKE

type Animation = PoseAnimator.Animation

-- What the kit lends this module.
export type Context = {
	anims: { [string]: Animation },
	play: (Model, Animation) -> (),
}

local Nova = {}

local ARMS = 4
local SPIRAL_IN, SPIRAL_OUT = 1.2, 14 -- studs from the eye the arms run between
local TWIST = 2.4 -- radians each arm curls round on its way out
local COLLAPSE = 0.15 -- (as the server's NOVA_COLLAPSE)

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

local function handOf(character: Model): Vector3?
	local arm = character:FindFirstChild("Right Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.3, 0)).Position else nil
end

---------------------------------------------------------------------------
-- The star in his hand, and its flight
---------------------------------------------------------------------------

type Forming = { stop: () -> () }
local forming: { [Model]: Forming } = setmetatable({}, { __mode = "k" }) :: any

-- A star grows over his open hand, wind streaming into it.
local function formStar(character: Model): Forming
	local star = Soft.makeStar(1.1)
	local alive = true
	Soft.every(0.6, function(elapsed)
		local hand = handOf(character)
		if not alive or not hand then
			return false
		end
		star.place(hand + UP * (0.6 + 0.2 * smooth(elapsed / 0.2)), elapsed * 6)
		return true
	end, function()
		if alive then
			alive = false
			star.fade(0.1)
		end
	end)
	for i = 0, 5 do
		task.delay(i * 0.04, function()
			local hand = handOf(character)
			if alive and hand then
				Soft.inflow(hand + UP * 0.8, 3.5, if i % 2 == 0 then WIND_WHITE else STAR)
			end
		end)
	end
	return {
		stop = function()
			if alive then
				alive = false
				star.fade(0.08)
			end
		end,
	}
end

-- The star flies from his hand to where the galaxy opens.
local function throwStar(from: Vector3, eye: Vector3, flight: number)
	local star = Soft.makeStar(1.5)
	local holder = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(from) })
	local light = Soft.trail(holder, Vector3.new(0, 0.45, 0), Vector3.new(0, -0.45, 0), {
		color = ColorSequence.new(STAR_WHITE, STAR),
		transparency = NumberSequence.new({ key(0, 0.15), key(1, 1) }),
		width = NumberSequence.new({ key(0, 1), key(1, 0) }),
		lifetime = 0.25,
		off = true,
	})
	local wind = Soft.trail(holder, Vector3.new(0, 1.1, 0), Vector3.new(0, -1.1, 0), {
		color = ColorSequence.new(WIND_WHITE, WIND),
		transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
		width = NumberSequence.new({ key(0, 1), key(1, 0.3) }),
		lifetime = 0.3,
		texture = SMOKE,
		off = true,
	})
	local begun = false
	Soft.every(flight, function(elapsed)
		local u = elapsed / flight
		local at = from:Lerp(eye, u) + UP * math.sin(u * math.pi) * 2.5
		holder.CFrame = CFrame.lookAt(at, eye)
		star.place(at, elapsed * 16)
		if not begun then
			begun = true
			Soft.beginTrail(light)
			Soft.beginTrail(wind)
		end
		return true
	end, function()
		star.fade(0.08)
		Soft.endTrail(light)
		Soft.endTrail(wind)
		Soft.linger(holder, 0.05, 0.5)
		U.flash(eye, STAR_WHITE, 3, 0.1)
		Soft.twinkle(eye, 6, STAR, 0.25)
	end)
end

---------------------------------------------------------------------------
-- The galaxy
---------------------------------------------------------------------------

type Galaxy = { collapse: () -> (), fade: () -> () }
local galaxies: { [Model]: Galaxy } = setmetatable({}, { __mode = "k" }) :: any

-- Wind rushing in across the ground to the eye.
local function drawIn(eye: Vector3, ground: Vector3, radius: number)
	local angle = math.random() * math.pi * 2
	local from = ground + Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius + UP * (0.4 + math.random() * 2.2)
	local to = eye:Lerp(from, 0.15)
	local wisp = Soft.bar(from, from + (to - from).Unit * 2.4, 0.12, WIND_WHITE, 0.35)
	U.tween(wisp, 0.3, { CFrame = CFrame.lookAt(to, to + (to - from).Unit), Transparency = 1 })
	task.delay(0.32, wisp.Destroy, wisp)
end

local function openGalaxy(eye: Vector3, ground: Vector3, reach: number): Galaxy
	local made: { Instance } = {}
	local plane = ground + UP * 0.7
	local born = os.clock()
	local collapsing: number? = nil
	local spin = 0

	-- Where along an arm `s` (0 at the eye, 1 at the rim) is, and which way
	-- the arm runs there.
	local function spiral(base: number, s: number, scale: number): (Vector3, Vector3)
		local r = (SPIRAL_IN + (SPIRAL_OUT - SPIRAL_IN) * s) * scale
		local theta = base + TWIST * s
		local radial = Vector3.new(math.cos(theta), 0, math.sin(theta))
		local around = Vector3.new(-math.sin(theta), 0, math.cos(theta))
		local tangent = radial * (SPIRAL_OUT - SPIRAL_IN) * scale + around * r * TWIST
		return plane + radial * r, tangent
	end

	-- The arms: two curved spans each, wind with starlight running along it.
	type Span = { a: Attachment, b: Attachment, beams: { Beam }, from: number, to: number, arm: number }
	local spans: { Span } = {}
	for arm = 1, ARMS do
		for half = 0, 1 do
			local a, b = Soft.worldAnchor(plane), Soft.worldAnchor(plane)
			table.insert(made, a)
			table.insert(made, b)
			local inner = half == 0
			local beams = {
				Soft.softBeam(a, b, {
					color = ColorSequence.new(WIND_WHITE, if arm % 2 == 0 then WIND else WIND_DEEP),
					width0 = if inner then 3.4 else 2.4,
					width1 = if inner then 2.4 else 0.8,
					transparency = NumberSequence.new({ key(0, 0.5), key(1, if inner then 0.6 else 0.85) }),
					texture = SMOKE,
					speed = 4,
					length = 6,
				}),
				Soft.starStream(a, b, if inner then 1.3 else 0.9, 3),
			}
			for _, beam in beams do
				table.insert(made, beam)
			end
			table.insert(spans, { a = a, b = b, beams = beams, from = half * 0.5, to = half * 0.5 + 0.5, arm = arm })
		end
	end

	-- Stars strewn along the arms, glittering.
	type Mote = { part: BasePart, arm: number, s: number, lift: number, out: number, phase: number }
	local motes: { Mote } = {}
	for i = 1, 40 do
		local part = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (0.3 + math.random() * 0.5),
			Color = if i % 3 == 0 then STAR else STAR_WHITE,
			Transparency = 1,
		})
		table.insert(made, part)
		table.insert(motes, {
			part = part,
			arm = (i - 1) % ARMS + 1,
			s = math.random(),
			lift = 0.2 + math.random() * 1.6,
			out = (math.random() - 0.5) * 1.6,
			phase = math.random() * 6.28,
		})
	end

	-- The bright core in its eye.
	local core = Soft.makeStar(3)
	for _, part in core.parts do
		table.insert(made, part)
	end

	-- Rings of wind turning round it, and a ring of light at the edge of
	-- its pull.
	local rings = {
		Soft.softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.4,
			width1 = 1.4,
			transparency = NumberSequence.new(0.6),
			texture = SMOKE,
			speed = 5,
			length = 6,
		}),
		Soft.softRing({
			color = ColorSequence.new(WIND_WHITE, WIND_DEEP),
			width0 = 2,
			width1 = 2,
			transparency = NumberSequence.new(0.7),
			texture = SMOKE,
			speed = -4,
			length = 8,
			segments = 16,
		}),
	}
	local edge = Soft.softRing({
		color = ColorSequence.new(STAR_WHITE, STAR),
		width0 = 0.3,
		width1 = 0.3,
		transparency = NumberSequence.new(0.55),
		segments = 20,
	})
	for _, ring in { rings[1], rings[2], edge } do
		table.insert(made, ring.hub)
	end

	-- The column of wind twisting up out of its eye.
	local foot, top = Soft.worldAnchor(ground, UP), Soft.worldAnchor(ground + UP * 13, UP)
	table.insert(made, foot)
	table.insert(made, top)
	local column = Soft.softBeam(foot, top, {
		color = ColorSequence.new(WIND_WHITE, WIND),
		width0 = 2.6,
		width1 = 6,
		transparency = NumberSequence.new({ key(0, 0.55), key(1, 1) }),
		texture = SMOKE,
		speed = -10,
		length = 8,
	})
	table.insert(made, column)
	local stopHelix = Soft.helix(function()
		return ground, ground + UP * 12
	end, 1.8, 3, 0.45, 1.5, 0.7, 3, WIND_WHITE)

	-- Dust lifting off the ground under it.
	local floor = U.newPart({
		Size = Vector3.new(reach * 1.4, 0.2, reach * 1.4),
		Transparency = 1,
		CFrame = CFrame.new(ground + UP * 0.2),
	})
	table.insert(made, floor)
	local dust = Soft.windEmitter(floor, {
		Color = ColorSequence.new(Color3.fromRGB(214, 222, 210), Color3.fromRGB(176, 196, 182)),
		LightEmission = 0,
		Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.86), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 2), key(1, 5) }),
		Lifetime = NumberRange.new(0.8, 1.2),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(30, 30),
		EmissionDirection = Enum.NormalId.Top,
		Rate = 26,
	})

	local nextDraw = 0
	local finished = false
	local connection: RBXScriptConnection
	local function destroy()
		if finished then
			return
		end
		finished = true
		connection:Disconnect()
		stopHelix()
		dust.Enabled = false
		for _, instance in made do
			instance:Destroy()
		end
	end
	connection = RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		local t = now - born
		local grow = 1 - (1 - math.clamp(t / 0.3, 0, 1)) ^ 3
		local shrink = if collapsing then 1 - smooth((now - collapsing) / COLLAPSE) else 1
		local scale = math.max(grow * shrink, 0.02)
		if collapsing and now - collapsing >= COLLAPSE then
			destroy()
			return
		end
		-- Faster the longer it's open (and fastest as it falls in).
		spin += dt * (1.6 + 1.2 * math.min(t, 2) + (if collapsing then 10 else 0))

		for _, span in spans do
			local base = spin + (span.arm - 1) * math.pi * 2 / ARMS
			local p0, t0 = spiral(base, span.from, scale)
			local p1, t1 = spiral(base, span.to, scale)
			Soft.aim(span.a, p0, t0)
			Soft.aim(span.b, p1, t1)
			local step = span.to - span.from
			for _, beam in span.beams do
				beam.CurveSize0 = t0.Magnitude * step / 3
				beam.CurveSize1 = t1.Magnitude * step / 3
			end
		end
		for _, mote in motes do
			local base = spin + (mote.arm - 1) * math.pi * 2 / ARMS
			local p, tangent = spiral(base, mote.s, scale)
			local side = tangent:Cross(UP).Unit
			mote.part.CFrame = CFrame.new(p + side * mote.out * scale + UP * mote.lift * scale)
			local glint = 0.5 + 0.5 * math.sin(t * 7 + mote.phase)
			mote.part.Transparency = 1 - math.min(grow, shrink) * (0.25 + 0.6 * glint)
		end
		core.place(eye, t * 3)
		rings[1].set(CFrame.new(plane + UP * 0.2) * CFrame.Angles(0, spin, 0), 8 * scale)
		rings[2].set(CFrame.new(plane + UP * 0.4) * CFrame.Angles(0, -spin * 0.6, 0), SPIRAL_OUT * scale)
		edge.set(CFrame.new(ground + UP * 0.3), reach * (0.6 + 0.4 * grow) * shrink)
		for _, beam in edge.beams do
			beam.Transparency = NumberSequence.new(0.55 + 0.25 * (0.5 + 0.5 * math.sin(t * 6)))
		end
		column.Width0 = 2.6 * scale
		column.Width1 = 6 * scale

		-- Wind rushing in from all round, faster as it goes.
		if not collapsing and t >= nextDraw then
			nextDraw = t + 0.05
			drawIn(eye, ground, reach * (0.6 + math.random() * 0.4))
		end
	end)

	local galaxy = {}
	function galaxy.collapse()
		if not collapsing then
			collapsing = os.clock()
			-- The core flares as everything falls into it.
			Soft.twinkle(eye, 10, STAR, COLLAPSE + 0.05)
			U.flash(eye, STAR_WHITE, 5, COLLAPSE)
		end
	end
	function galaxy.fade()
		if not collapsing then
			collapsing = os.clock()
		end
	end
	return galaxy
end

---------------------------------------------------------------------------
-- The nova
---------------------------------------------------------------------------

local function nova(eye: Vector3, ground: Vector3)
	-- A pillar of starlight bursting up into the sky, twisting with wind.
	local foot, top = Soft.worldAnchor(ground, UP), Soft.worldAnchor(ground + UP * 46, UP)
	local pillar = {
		Soft.softBeam(foot, top, {
			color = ColorSequence.new(STAR_WHITE),
			width0 = 3.2,
			width1 = 1.2,
			transparency = NumberSequence.new({ key(0, 0.05), key(1, 0.5) }),
		}),
		Soft.softBeam(foot, top, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 8,
			width1 = 3,
			transparency = NumberSequence.new({ key(0, 0.45), key(1, 0.85) }),
		}),
		Soft.softBeam(foot, top, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 13,
			width1 = 5,
			transparency = NumberSequence.new({ key(0, 0.65), key(1, 0.95) }),
			texture = SMOKE,
			speed = -22,
			length = 14,
		}),
	}
	table.insert(pillar, Soft.starStream(foot, top, 2.4, -30))
	local widths = Soft.widths(pillar)
	-- Thin to wide in a flash, then thinning out as it fades.
	Soft.every(0.6, function(elapsed)
		local k = if elapsed < 0.06 then 0.2 + 1.1 * elapsed / 0.06 else 1.3 - 0.9 * (elapsed - 0.06) / 0.54
		Soft.scaleBeams(pillar, k, widths)
		return true
	end)
	task.delay(0.15, Soft.fadeBeams, pillar, 0.45, { foot, top })
	local stopSpiral = Soft.helix(function()
		return ground, ground + UP * 40
	end, 3.2, 4, 0.35, 2, 1.1, 0.45, STAR)
	task.delay(0.5, stopSpiral)

	-- Out over the ground: a ring of wind and light, the ground cracked gold.
	Soft.windRing(ground + UP * 0.4, UP, 2, 22, 0.5)
	Soft.lightRing(ground + UP * 0.3, UP, 1, 18, 0.4, STAR)
	U.shockwave(ground, STAR, 2, 30, 0.45)
	U.groundCracks(ground, 10, 8, STAR, 1.6)
	U.debris(ground, 14, 40, 0.8)

	-- And the burst itself: light, stars scattering.
	U.flash(eye, STAR_WHITE, 10, 0.25)
	Soft.twinkle(eye, 16, STAR, 0.4)
	Soft.starDust(eye, 40, 50)
	Soft.streaks(eye, 24, 80, UP, 50)
	Soft.windPuff(eye, 6, UP)
	U.light(eye, STAR, 6, 40, 0.5)
end

---------------------------------------------------------------------------

function Nova.Handle(ctx: Context, data, character: Model, root: BasePart)
	local phase = data.phase
	local anims = ctx.anims
	if phase == "Form" then
		ctx.play(character, if data.airborne then anims.NovaFormAir else anims.NovaForm)
		local old = forming[character]
		if old then
			old.stop()
		end
		forming[character] = formStar(character)
		Soft.twinkle(root.Position + root.CFrame.LookVector * 1.5 + UP * 1.5, 3, STAR, 0.25)
	elseif phase == "Cancel" then
		local star = forming[character]
		forming[character] = nil
		if star then
			star.stop()
		end
		local current = PoseAnimator.Current(character)
		if current == anims.NovaForm or current == anims.NovaFormAir then
			PoseAnimator.FadeOut(character, 0.15)
		end
	elseif phase == "Throw" then
		ctx.play(
			character,
			if PoseAnimator.Current(character) == anims.NovaFormAir then anims.NovaFlickAir else anims.NovaFlick
		)
		local star = forming[character]
		forming[character] = nil
		if star then
			star.stop()
		end
		if typeof(data.from) == "Vector3" and typeof(data.eye) == "Vector3" then
			throwStar(data.from, data.eye, tonumber(data.flight) or 0.2)
			Soft.windPuff(data.from, 2, (data.eye - data.from).Unit)
		end
	elseif phase == "Open" then
		if typeof(data.eye) ~= "Vector3" or typeof(data.ground) ~= "Vector3" then
			return
		end
		local old = galaxies[character]
		if old then
			old.fade()
		end
		galaxies[character] = openGalaxy(data.eye, data.ground, tonumber(data.reach) or 22)
		Soft.windRing(data.ground + UP * 0.5, UP, 1, 14, 0.35)
		Soft.lightRing(data.ground + UP * 0.4, UP, 0.5, 10, 0.3, STAR)
		Soft.twinkle(data.eye, 8, STAR, 0.3)
	elseif phase == "Nova" then
		local galaxy = galaxies[character]
		galaxies[character] = nil
		if galaxy then
			galaxy.collapse()
		end
		if typeof(data.eye) == "Vector3" and typeof(data.ground) == "Vector3" then
			local eye, ground = data.eye, data.ground
			task.delay(COLLAPSE, nova, eye, ground)
		end
	elseif phase == "Fizzle" then
		local galaxy = galaxies[character]
		galaxies[character] = nil
		if galaxy then
			galaxy.fade()
		end
	end
end

return Nova
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="46">
              <Properties>
                <string name="Name">Saint</string>
                <string name="Source"><![CDATA[--[[
	Prince of Wind (Yuno): Saint Spirit of Zephyr (Full-Crown 4), drawn.
	The flight is Shared/SaintZephyr (the server holds them both on it);
	this draws it, about 6 seconds:

	  the bind    the flicked star strikes them and a seal of starlight
	              closes on them; a magic circle opens on the ground under
	              them and a column of wind tears up out of it, carrying them
	              high into the sky, him flying up beside them.
	  the stars   eight stars open round them in the sky, joined in one line
	              of streaming starlight (an eight-pointed star) over turning
	              rings of light and wind; light pours from each into them.
	  the dance   from his own star he charges through them, then never
	              stops: out round a star, back through them, every pass a
	              cut you see him make (his sword sweeping a sheet of wind,
	              the cut left hanging in the air), the ribbon of wind he
	              trails painting a flower of eight petals round them, faster
	              and faster. Then a rising X.
	  the blade   up and over to the top: wings of wind open, Sylph dives
	              into his raised hands and a colossal blade of wind and
	              starlight grows out of them, wind spiralling up it, the
	              light of every star in the constellation pouring into it,
	              a shaft of wind opening into the sky over him.
	  the strike  one stroke straight down through them: the swing leaves
	              a crescent of wind the height of the sky and a seam of
	              light from the heavens to the ground.
	  the fall    every cut left hanging bursts, one after another, the
	              stars burst, the rings blow apart; they fall like a meteor,
	              a comet's tail of wind behind them, into a crater, a
	              tornado of wind tearing up out of it, starlight falling,
	              him standing with his back to it.

	Everything is wind and light you can see through, and both of them are
	outlined through it, so the fight stays readable. The light changes
	only a little (a touch brighter, greener, a soft bloom). The camera
	moves smoothly: eased shots and eased blends, no shake.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SaintPlan = require(ReplicatedStorage:WaitForChild("Shared").SaintZephyr)
local CameraShake = require(script.Parent.Parent.Parent.CameraShake)
local Cinematic = require(script.Parent.Parent.Parent.Cinematic)
local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local Soft = require(script.Parent.Parent.Parent.Soft)

local U = Soft.U
local rad = math.rad
local UP = Vector3.yAxis

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE, SPARKLE = Soft.SMOKE, Soft.SPARKLE
local every, key = Soft.every, Soft.key
local worldAnchor, softBeam, fadeBeams, softRing = Soft.worldAnchor, Soft.softBeam, Soft.fadeBeams, Soft.softRing
local windRing, lightRing, windEmitter, windPuff = Soft.windRing, Soft.lightRing, Soft.windEmitter, Soft.windPuff
local twinkle, starDust, streaks = Soft.twinkle, Soft.starDust, Soft.streaks

type Animation = PoseAnimator.Animation

-- What the kit lends this module (its animations, and his sword).
export type Context = {
	anims: { [string]: Animation },
	play: (Model, Animation) -> (),
	blade: (Model) -> BasePart?, -- his wind sword's blade (moves trail wind off it)
	hideSword: (Model, number) -> (),
}

local Saint = {}

local SAINT_BLADE = 40 -- the colossal blade's length
local SHEER = 0.4 -- how much more see-through everything in it is

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

local function easeOut(u: number): number
	return 1 - (1 - math.clamp(u, 0, 1)) ^ 3
end

local function handOf(character: Model, side: string): Vector3?
	local arm = character:FindFirstChild(side .. " Arm")
	return if arm and arm:IsA("BasePart") then (arm.CFrame * CFrame.new(0, -1.15, 0)).Position else nil
end

-- Any direction square to `direction`, and a second square to both.
local function across(direction: Vector3): (Vector3, Vector3)
	local side = direction:Cross(UP)
	side = if side.Magnitude > 1e-3 then side.Unit else Vector3.xAxis
	return side, side:Cross(direction).Unit
end

---------------------------------------------------------------------------
-- Pieces
---------------------------------------------------------------------------

-- Outlines someone through all of it for the length of the cutscene.
local function outline(character: Model?, color: Color3, duration: number)
	if not character then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = color
	highlight.FillTransparency = 0.92
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 1
	highlight.Adornee = character
	highlight.Parent = character
	U.tween(highlight, 0.3, { OutlineTransparency = 0.35 })
	task.delay(duration, function()
		U.tween(highlight, 0.4, { OutlineTransparency = 1, FillTransparency = 1 })
		task.delay(0.45, highlight.Destroy, highlight)
	end)
end

-- A magic circle on the ground: rings of starlight and wind turning
-- opposite ways, an eight-pointed star drawn in one line inside them.
local function groundSigil(center: Vector3, radius: number, duration: number)
	local rings = {
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.45,
			width1 = 0.45,
			transparency = NumberSequence.new(0.15),
		}),
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 1.1,
			width1 = 1.1,
			transparency = NumberSequence.new(0.35),
			texture = SPARKLE,
			wrap = true,
			length = 1.6,
			speed = 2,
		}),
		softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.8,
			width1 = 1.8,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 3,
			length = 5,
		}),
		softRing({
			color = ColorSequence.new(STAR_WHITE),
			width0 = 0.25,
			width1 = 0.25,
			transparency = NumberSequence.new(0.3),
		}),
	}
	local hub = rings[1].hub
	local points: { Attachment } = {}
	for i = 1, 8 do
		local point = Instance.new("Attachment")
		point.Parent = hub
		points[i] = point
	end
	local lines: { Beam } = {}
	for i = 1, 8 do
		table.insert(
			lines,
			softBeam(points[i], points[(i + 2) % 8 + 1], {
				color = ColorSequence.new(STAR_WHITE, STAR),
				width0 = 0.3,
				width1 = 0.3,
				transparency = NumberSequence.new(0.25),
			}, hub)
		)
	end
	local floor = CFrame.new(center + UP * 0.12)
	every(duration, function(elapsed)
		local r = radius * easeOut(elapsed / 0.3) + 0.05
		rings[1].set(floor * CFrame.Angles(0, elapsed * 0.8, 0), r)
		rings[2].set(floor * CFrame.Angles(0, -elapsed * 0.5, 0), r * 1.1)
		rings[3].set(floor * CFrame.Angles(0, elapsed * 1.6, 0), r * 0.62)
		rings[4].set(floor * CFrame.Angles(0, -elapsed * 1.2, 0), r * 0.3)
		for i, point in points do
			local angle = (i - 1) / 8 * math.pi * 2
			point.Position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * r * 0.97
		end
		return true
	end, function()
		fadeBeams(lines, 0.35)
		for _, ring in rings do
			ring.fade(0.45)
		end
	end)
end

-- A column of wind tearing up out of the ground: a broad stream of wind
-- flowing up it round a bright core, ribbons spiralling up round it, gusts
-- and streaks racing up it, and the ground bursting where it comes out.
local function windColumn(base: Vector3, height: number, radius: number, duration: number)
	U.pillar(base, WIND, radius, height, duration, Enum.Material.ForceField, 0.55)
	local foot, head = worldAnchor(base, UP), worldAnchor(base + UP * height, UP)
	local beams = {
		softBeam(foot, head, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = radius * 2.4,
			width1 = radius * 3.6,
			transparency = NumberSequence.new({ key(0, 0.85), key(0.12, 0.5), key(0.85, 0.6), key(1, 1) }),
			texture = SMOKE,
			speed = 7,
			length = 12,
		}),
		softBeam(foot, head, {
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = radius * 0.5,
			width1 = radius * 0.25,
			transparency = NumberSequence.new({ key(0, 0.6), key(0.1, 0.3), key(0.9, 0.5), key(1, 1) }),
		}),
		softBeam(foot, head, {
			color = ColorSequence.new(WIND, WIND_DEEP),
			width0 = radius * 5,
			width1 = radius * 6,
			transparency = NumberSequence.new({ key(0, 0.95), key(0.2, 0.86), key(1, 1) }),
			texture = SMOKE,
			speed = 3,
			length = 20,
			emission = 0.6,
		}),
	}
	task.delay(duration * 0.55, fadeBeams, beams, duration * 0.45, { foot, head })
	local holder = U.newPart({
		Size = Vector3.new(radius * 2, 1, radius * 2),
		Transparency = 1,
		CFrame = CFrame.new(base),
	})
	local gusts = windEmitter(holder, {
		Size = NumberSequence.new({ key(0, radius * 0.6), key(1, radius * 1.5) }),
		Lifetime = NumberRange.new(0.45, 0.8),
		Speed = NumberRange.new(height * 1.1, height * 1.6),
		SpreadAngle = Vector2.new(6, 6),
		Drag = 1.5,
		EmissionDirection = Enum.NormalId.Top,
		Shape = Enum.ParticleEmitterShape.Disc,
		Rate = 90,
	})
	local rising = windEmitter(holder, {
		Texture = SPARKLE,
		Color = ColorSequence.new(WIND_WHITE),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.35), key(1, 0) }),
		Squash = NumberSequence.new(4),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(height * 1.8, height * 2.4),
		SpreadAngle = Vector2.new(4, 4),
		EmissionDirection = Enum.NormalId.Top,
		Shape = Enum.ParticleEmitterShape.Disc,
		Rate = 70,
	})
	task.delay(duration * 0.75, function()
		gusts.Enabled = false
		rising.Enabled = false
	end)
	task.delay(duration + 1, holder.Destroy, holder)
	Soft.helix(function()
		return base, base + UP * height
	end, radius * 1.4, 4, 0.5, 2.5, 0.9, duration)
	U.burst(base + UP * 0.5, {
		texture = SMOKE,
		color = Color3.fromRGB(196, 204, 194),
		count = 22,
		size = radius * 1.8,
		speed = NumberRange.new(22, 44),
		lifetime = NumberRange.new(0.5, 0.9),
		transparency = 0.5,
		lightEmission = 0,
		drag = 4,
		spread = 85,
		direction = UP,
	})
	windRing(base + UP * 0.3, UP, radius, radius * 5, 0.5)
	lightRing(base + UP * 0.2, UP, radius, radius * 4, 0.4, WIND_WHITE)
	U.groundCracks(base, 8, radius * 3, WIND, 1.2)
	U.groundRocks(base, 8, radius * 2, 1.3)
	U.debris(base, 12, 45, 0.7)
	U.light(base + UP * 4, WIND, 5, 40, duration)
end

-- The constellation's rings, round them and turning: a ring of starlight
-- and a chain of sparkles outside it, a ring of wind turning the other way,
-- a small ring round them, two rings standing up through them crossed at a
-- slant, and twelve spokes of light. They open out of them, and at the end
-- are blown apart.
type Circle = { update: (number, number) -> (), blowApart: () -> () }

local function skyCircle(center: Vector3, radius: number): Circle
	local rings = {
		outer = softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.5,
			width1 = 0.5,
			transparency = NumberSequence.new(0.25),
		}),
		glitter = softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 1.3,
			width1 = 1.3,
			transparency = NumberSequence.new(0.35),
			texture = SPARKLE,
			wrap = true,
			length = 2,
			speed = 3,
		}),
		wind = softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 2.4,
			width1 = 2.4,
			transparency = NumberSequence.new(0.62),
			texture = SMOKE,
			speed = 3,
			length = 6,
		}),
		inner = softRing({
			color = ColorSequence.new(WIND_WHITE),
			width0 = 0.35,
			width1 = 0.35,
			transparency = NumberSequence.new(0.35),
		}),
		slant = softRing({
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.3,
			width1 = 0.3,
			transparency = NumberSequence.new(0.45),
		}),
		cross = softRing({
			color = ColorSequence.new(WIND_WHITE, STAR),
			width0 = 0.25,
			width1 = 0.25,
			transparency = NumberSequence.new(0.5),
		}),
	}
	local spokes: { { Attachment } } = {}
	for _ = 1, 12 do
		local a0 = Instance.new("Attachment")
		a0.Parent = rings.outer.hub
		local a1 = Instance.new("Attachment")
		a1.Parent = rings.outer.hub
		table.insert(spokes, { a0, a1 })
		softBeam(a0, a1, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.2,
			width1 = 0.05,
			transparency = NumberSequence.new({ key(0, 0.4), key(1, 0.8) }),
		}, rings.outer.hub)
	end
	local current = 0
	local circle = {}
	function circle.update(t: number, open: number)
		local r = radius * open + 0.05
		current = r
		-- (Out of sight until it opens.)
		local at = CFrame.new(if open > 0 then center else center + UP * 5000)
		rings.outer.set(at * CFrame.Angles(0, t * 0.6, 0), r)
		rings.glitter.set(at * CFrame.Angles(0, -t * 0.35, 0), r * 1.07)
		rings.wind.set(at * CFrame.Angles(0, -t * 1.1, 0), r * 0.86)
		rings.inner.set(at * CFrame.Angles(0, t * 1.8, 0), r * 0.34)
		rings.slant.set(at * CFrame.Angles(0, t * 0.8, 0) * CFrame.Angles(rad(70), 0, 0), r * 1.05)
		rings.cross.set(at * CFrame.Angles(0, -t * 0.7 + 1.2, 0) * CFrame.Angles(rad(-62), 0, 0), r * 1.12)
		for i, pair in spokes do
			local angle = i / #spokes * math.pi * 2
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			pair[1].Position = out * r * 0.38
			pair[2].Position = out * r * 0.84
		end
	end
	function circle.blowApart()
		local from = current
		local frames: { [string]: CFrame } = {}
		for name, ring in rings do
			frames[name] = ring.hub.CFrame
		end
		every(0.45, function(elapsed)
			local grow = from * (1 + elapsed * 2.5)
			for name, ring in rings do
				ring.set(frames[name], grow * (if name == "inner" then 0.34 else 1))
			end
			return true
		end)
		for _, ring in rings do
			ring.fade(0.45)
		end
	end
	return circle
end

-- Wings of wind: two fans of shimmering, see-through feathers open out of
-- his back for the strike, wind streaming off them, beat slowly and fold.
local function wingsOfWind(character: Model, duration: number)
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if not torso then
		return
	end
	type WingFeather = { vane: BasePart, glow: BasePart, side: number, index: number, length: number }
	local feathers: { WingFeather } = {}
	local trails: { Trail } = {}
	local shedding: { ParticleEmitter } = {}
	for side = -1, 1, 2 do
		for i = 1, 7 do
			local length = 5 + i * 0.8
			local vane = Soft.newWedge({
				Size = Vector3.new(0.12, 0.9, length),
				Color = WIND_WHITE,
				Material = Enum.Material.ForceField,
				Transparency = 0.15,
			})
			if i >= 5 then
				table.insert(
					shedding,
					windEmitter(vane, {
						Size = NumberSequence.new({ key(0, 0.8), key(1, 2.4) }),
						Lifetime = NumberRange.new(0.3, 0.6),
						Speed = NumberRange.new(2, 6),
						Drag = 3,
						Rate = 12,
						Enabled = false, -- (until the wings are posed)
					})
				)
			end
			local glow = U.newPart({ Size = Vector3.new(0.05, 1.9, length + 0.8), Color = WIND, Transparency = 0.82 })
			if i % 2 == 1 then
				-- Wind streaming off the feather tips as they beat.
				table.insert(
					trails,
					Soft.trail(
						glow,
						Vector3.new(0, 0.6, -(length + 0.8) / 2),
						Vector3.new(0, -0.6, -(length + 0.8) / 2),
						{
							color = ColorSequence.new(WIND_WHITE, WIND),
							transparency = NumberSequence.new({ key(0, 0.45), key(1, 1) }),
							lifetime = 0.3,
							off = true,
						}
					)
				)
			end
			table.insert(feathers, { vane = vane, glow = glow, side = side, index = i, length = length })
		end
	end
	every(duration, function(elapsed)
		if not torso.Parent then
			return false
		end
		local open = easeOut(elapsed / 0.3)
		local fold = math.clamp((elapsed - (duration - 0.25)) / 0.25, 0, 1)
		local spread = open * (1 - fold)
		local beat = math.sin(elapsed * 5) * 0.08
		local frame = torso.CFrame
		for _, f in feathers do
			local angle = rad(8 + (f.index - 1) * 15) * spread + beat
			local out = (
				frame.RightVector * f.side * math.cos(angle)
				+ frame.UpVector * math.sin(angle)
				- frame.LookVector * 0.35
			).Unit
			local base = (frame * CFrame.new(f.side * 0.45, 0.8, 0.55)).Position
			local length = f.length * (0.3 + 0.7 * spread)
			local pose = CFrame.lookAt(base, base + out, frame.LookVector) * CFrame.new(0, 0, -length / 2)
			f.vane.Size = Vector3.new(0.12, 0.9, length)
			f.vane.CFrame = pose
			f.glow.Size = Vector3.new(0.05, 1.9, length + 0.8)
			f.glow.CFrame = pose
		end
		for _, trail in trails do
			Soft.beginTrail(trail)
		end
		for _, emitter in shedding do
			emitter.Enabled = true
		end
		return true
	end, function()
		for _, trail in trails do
			Soft.endTrail(trail)
		end
		for _, f in feathers do
			Soft.fadeOut({ f.vane, f.glow }, 0.25)
		end
	end)
end

-- The colossal blade: a white-hot core in a glittering edge inside layers
-- of wind flowing up it, ribbons of wind spiralling up it, wind and
-- sparkles pouring off it, a star at its point. See-through where it's
-- nearest him.
type Blade = {
	set: (Vector3, Vector3, number) -> (),
	tip: Attachment,
	dissolve: () -> (),
}

local function windBlade(): Blade
	local hub = U.newPart({ Size = Vector3.one, Transparency = 1 })
	local base = Instance.new("Attachment")
	base.Parent = hub
	local point = Instance.new("Attachment")
	point.Parent = hub
	local tipAnchor = worldAnchor(Vector3.zero)
	local layers = {
		softBeam(base, point, {
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 1.4,
			width1 = 0.45,
			transparency = NumberSequence.new({ key(0, 0.45), key(0.12, 0.05), key(0.88, 0.08), key(1, 0.5) }),
		}, hub),
		softBeam(base, point, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 2.8,
			width1 = 1.2,
			transparency = NumberSequence.new({ key(0, 0.75), key(0.2, 0.35), key(1, 0.45) }),
			texture = SPARKLE,
			wrap = true,
			length = 3,
			speed = 8,
		}, hub),
		softBeam(base, point, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 6,
			width1 = 2.5,
			transparency = NumberSequence.new({ key(0, 0.85), key(0.2, 0.5), key(1, 0.72) }),
			texture = SMOKE,
			speed = 3,
			length = 8,
		}, hub),
		softBeam(base, point, {
			color = ColorSequence.new(WIND, WIND_DEEP),
			width0 = 14,
			width1 = 7,
			transparency = NumberSequence.new({ key(0, 0.95), key(0.25, 0.82), key(1, 0.9) }),
			texture = SMOKE,
			speed = -2,
			length = 10,
		}, hub),
	}
	local flow = windEmitter(hub, {
		Size = NumberSequence.new({ key(0, 1.5), key(1, 4) }),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(15, 15),
		EmissionDirection = Enum.NormalId.Front,
		Shape = Enum.ParticleEmitterShape.Box,
		Drag = 2,
		Rate = 60,
	})
	local glitter = windEmitter(hub, {
		Texture = SPARKLE,
		Color = ColorSequence.new(STAR),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.6), key(1, 0) }),
		Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new(2, 6),
		SpreadAngle = Vector2.new(180, 180),
		Shape = Enum.ParticleEmitterShape.Box,
		Rate = 50,
	})
	local light = Instance.new("PointLight")
	light.Color = STAR
	light.Range = 50
	light.Brightness = 5
	light.Parent = hub
	local tip = Soft.softStar(5)
	local last = { from = Vector3.zero, to = Vector3.zero, length = 0 }
	local stopHelix = Soft.helix(function()
		return last.from, last.to
	end, 2.4, 3, 0.45, 3, 0.8, 4, WIND)
	local blade = { tip = tipAnchor }
	function blade.set(from: Vector3, direction: Vector3, length: number)
		local to = from + direction * length
		last.from, last.to, last.length = from, to, length
		hub.Size = Vector3.new(2, 2, math.max(length, 0.2))
		hub.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
		base.CFrame = CFrame.new(0, 0, length / 2)
		point.CFrame = CFrame.new(0, 0, -length / 2)
		tip.place(to, os.clock() * 6)
		tipAnchor.CFrame = CFrame.new(to)
	end
	function blade.dissolve()
		flow.Enabled = false
		glitter.Enabled = false
		light.Enabled = false
		stopHelix()
		for i = 1, 8 do
			windPuff(last.from:Lerp(last.to, i / 8), 2.5)
		end
		starDust(last.to, 16, 30)
		tip.fade(0.25)
		fadeBeams(layers, 0.3, { hub, tipAnchor })
	end
	return blade
end

-- The strike's seam through the whole sky: a white-hot line, wind racing
-- down it and a broad haze of wind round it, there and gone.
local function windSeam(top: Vector3, ground: Vector3)
	local direction = (ground - top).Unit
	local from, to = top - direction * 90, ground + direction * 2
	local a = worldAnchor(from, direction)
	local b = worldAnchor(to, direction)
	local beams = {
		softBeam(a, b, {
			color = ColorSequence.new(STAR_WHITE),
			width0 = 1.3,
			width1 = 1.3,
			transparency = NumberSequence.new({ key(0, 0.7), key(0.2, 0.05), key(1, 0.05) }),
		}),
		softBeam(a, b, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 3,
			width1 = 2.4,
			transparency = NumberSequence.new({ key(0, 0.8), key(0.25, 0.3), key(1, 0.35) }),
			texture = SPARKLE,
			wrap = true,
			length = 4,
			speed = -20,
		}),
		softBeam(a, b, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 9,
			width1 = 7,
			transparency = NumberSequence.new({ key(0, 0.9), key(0.25, 0.5), key(1, 0.55) }),
			texture = SMOKE,
			speed = 8,
			length = 20,
		}),
		softBeam(a, b, {
			color = ColorSequence.new(WIND, WIND_DEEP),
			width0 = 40,
			width1 = 30,
			transparency = NumberSequence.new({ key(0, 0.96), key(0.3, 0.86), key(1, 0.88) }),
			texture = SMOKE,
			speed = 4,
			length = 30,
		}),
	}
	for i = 0, 8 do
		windPuff(from:Lerp(to, 0.35 + 0.65 * i / 8), 4, -direction)
	end
	task.delay(0.35, function()
		for _, beam in beams do
			U.tween(beam, 0.5, { Width0 = beam.Width0 * 0.05, Width1 = beam.Width1 * 0.05 })
		end
		fadeBeams(beams, 0.55, { a, b })
	end)
end

-- Feathers of light drifting down round him afterwards.
local function featherFall(center: Vector3, count: number, duration: number)
	for i = 1, count do
		local feather = Soft.newWedge({
			Size = Vector3.new(0.05, 0.3, 1),
			Color = WIND_WHITE,
			Material = Enum.Material.ForceField,
			Transparency = 1,
		})
		U.tween(feather, 0.3, { Transparency = Soft.sheerValue(0.2) })
		local from = center + Vector3.new(math.random(-70, 70) / 10, 5 + math.random() * 7, math.random(-70, 70) / 10)
		local life = duration * (0.7 + math.random() * 0.3)
		every(life, function(elapsed)
			local drift =
				Vector3.new(math.sin(elapsed * 2.6 + i) * 1.3, -elapsed * 2.4, math.cos(elapsed * 2 + i) * 0.8)
			feather.CFrame = CFrame.new(from + drift)
				* CFrame.Angles(elapsed * 1.5 + i, elapsed * 2.5, math.sin(elapsed * 4 + i) * 0.7)
			return true
		end, function()
			Soft.fadeOut({ feather }, 0.3)
		end)
	end
end

-- Starlight sifting down over an area, glittering as it falls.
local function starfall(center: Vector3, radius: number, duration: number)
	local sky = U.newPart({
		Size = Vector3.new(radius * 2, 1, radius * 2),
		Transparency = 1,
		CFrame = CFrame.new(center + UP * 16),
	})
	local motes = windEmitter(sky, {
		Texture = SPARKLE,
		Color = ColorSequence.new(STAR_WHITE, STAR),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 1), key(0.15, 0.2), key(0.8, 0.4), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 0.35), key(0.5, 0.55), key(1, 0) }),
		Lifetime = NumberRange.new(1.4, 2.2),
		Speed = NumberRange.new(5, 9),
		SpreadAngle = Vector2.new(12, 12),
		EmissionDirection = Enum.NormalId.Bottom,
		Shape = Enum.ParticleEmitterShape.Box,
		Drag = 0.5,
		Rate = 45,
	})
	task.delay(duration, function()
		motes.Enabled = false
	end)
	task.delay(duration + 2.5, sky.Destroy, sky)
end

---------------------------------------------------------------------------
-- The cutscene
---------------------------------------------------------------------------

--[[
	The Zephyr sky (the Golden Dawn): for anyone near, the light turns to a
	golden sunrise (Cinematic.Dawn) and the sky over the fight is dressed for
	Yuno: the low sun haloed in gold with rays of light fanning out of it,
	stars of his star magic glittering all over the sky, long streams of wind
	sweeping across it, and right over them a colossal spiral of wind turning
	slowly round an eight-pointed star of light in its eye, light falling
	from it onto them. It answers the fight: the star swells as the blade
	grows (the blade points straight up at it), flares at the strike, and
	the spiral blows apart when they fall.
]]
export type ZephyrSky = {
	update: (number) -> (), -- (run every frame on its own: seconds since it opened)
	gather: () -> (),
	flare: () -> (),
	scatter: () -> (),
	close: (number) -> (),
}

local SKY_GOLD = Color3.fromRGB(255, 214, 140)
local SKY_SUN = Color3.fromRGB(255, 240, 200)

local function zephyrSky(plan: SaintPlan.Plan): ZephyrSky
	local center = plan.center
	local made: { Instance } = {}
	local beams: { { beam: Beam, base: number } } = {}
	local function track(beam: Beam, base: number): Beam
		table.insert(beams, { beam = beam, base = base })
		table.insert(made, beam)
		beam.Transparency = NumberSequence.new(1)
		return beam
	end
	local function anchor(position: Vector3, axis: Vector3?): Attachment
		local attachment = worldAnchor(position, axis)
		table.insert(made, attachment)
		return attachment
	end

	-- The sun, low and gold where the dawn puts it: a halo round it and
	-- rays of light fanning up out of it.
	local toSun = Cinematic.DawnSun()
	toSun = Vector3.new(toSun.X, math.max(toSun.Y, 0.1), toSun.Z).Unit
	local sun = center + toSun * 420
	local halos: { { part: BasePart, base: number } } = {}
	for i, layer in { { 46, 0.5, SKY_SUN }, { 110, 0.76, SKY_GOLD }, { 210, 0.9, SKY_GOLD } } do
		local part = U.newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, layer[1], layer[1]),
			CFrame = CFrame.lookAt(sun - toSun * i, center) * CFrame.Angles(0, rad(90), 0),
			Color = layer[3],
			Transparency = 1,
		})
		table.insert(made, part)
		table.insert(halos, { part = part, base = layer[2] })
	end
	local sunAnchor = anchor(sun)
	local sunUp = (UP - toSun * toSun.Y).Unit
	local sunSide = toSun:Cross(sunUp).Unit
	for i = 1, 9 do
		local angle = rad(-80 + (i - 1) * 20)
		local out = sunUp * math.cos(angle) + sunSide * math.sin(angle)
		track(
			softBeam(sunAnchor, anchor(sun + out * 360 - toSun * 60), {
				color = ColorSequence.new(SKY_SUN, SKY_GOLD),
				width0 = 26,
				width1 = 90,
				transparency = NumberSequence.new(0),
				emission = 1,
			}),
			0.92
		)
	end

	-- Stars of his star magic all over the sky, glittering.
	type Twinkle = { part: BasePart, phase: number, speed: number }
	local stars: { Twinkle } = {}
	for i = 1, 140 do
		local direction
		repeat
			direction = U.randomUnit()
		until direction.Y > 0.12
		local part = U.newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (1 + math.random() * 1.8),
			CFrame = CFrame.new(center + direction * (280 + math.random() * 40)),
			Color = if i % 4 == 0 then STAR else STAR_WHITE,
			Transparency = 1,
		})
		table.insert(made, part)
		table.insert(stars, { part = part, phase = math.random() * 6.28, speed = 2 + math.random() * 4 })
	end

	-- Streams of wind sweeping across the sky, high over the fight.
	for i = 1, 6 do
		local angle = rad(i * 60 + math.random() * 20)
		local across = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local side = across:Cross(UP)
		local height = UP * (36 + i * 8)
		local from = center + height - across * 260 + side * (i * 14 - 50)
		local to = center + height + across * 260 + side * (i * 14 - 50)
		track(
			softBeam(anchor(from, across + UP * 0.15), anchor(to, across - UP * 0.15), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 14,
				width1 = 14,
				transparency = NumberSequence.new(0),
				texture = SMOKE,
				speed = 18 + i * 3,
				length = 60,
				curve0 = 40,
				curve1 = 40,
			}),
			0.88
		)
	end

	-- The spiral of wind over them: rings turning round its eye (each
	-- slower than the one inside it), arms of wind curling in.
	local eye = center + UP * 92
	type Swirl = { ring: Soft.Ring, radius: number, height: number, speed: number, tilt: number }
	local swirls: { Swirl } = {}
	for i, radius in { 34, 62, 95, 132, 175 } do
		local ring = softRing({
			color = ColorSequence.new(WIND_WHITE, if i % 2 == 0 then WIND else WIND_DEEP),
			width0 = 6 + i * 3,
			width1 = 6 + i * 3,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 6,
			length = 30,
			segments = 24,
		})
		table.insert(made, ring.hub)
		for _, beam in ring.beams do
			track(beam, 0.7 + i * 0.04)
		end
		table.insert(
			swirls,
			{ ring = ring, radius = radius, height = -i * 7, speed = 0.5 - i * 0.07, tilt = (i % 2) * 4 - 2 }
		)
	end
	type Arm = { from: Attachment, to: Attachment, beam: Beam, phase: number }
	local arms: { Arm } = {}
	for i = 1, 6 do
		local from, to = anchor(eye), anchor(eye)
		local beam = softBeam(from, to, {
			color = ColorSequence.new(WIND, WIND_WHITE),
			width0 = 22,
			width1 = 5,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 10,
			length = 40,
			segments = 20,
		})
		track(beam, 0.76)
		table.insert(arms, { from = from, to = to, beam = beam, phase = (i - 1) * math.pi / 3 })
	end

	-- The star in its eye, and light falling from it onto them.
	local star = Soft.softStar(30)
	for _, part in star.parts do
		table.insert(made, part)
		part.Transparency = 1
	end
	local starLight = star.parts[1]:FindFirstChildOfClass("PointLight")
	if starLight then
		starLight.Enabled = false
	end
	local eyeAnchor = anchor(eye)
	local fall: { Beam } = {}
	for i = 1, 6 do
		local angle = (i - 1) * math.pi / 3
		local foot = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 16 - UP * 6
		table.insert(
			fall,
			track(
				softBeam(eyeAnchor, anchor(foot), {
					color = ColorSequence.new(SKY_SUN, STAR),
					width0 = 16,
					width1 = 4,
					transparency = NumberSequence.new(0),
					emission = 1,
				}),
				0.94
			)
		)
	end

	local shown = 0 -- 0 to 1: how far in it's faded
	local target = 0
	-- Eased toward their targets every frame (nothing jumps).
	local scale, scaleTarget = 1, 1 -- the star in the eye
	local spin, spinTarget = 1, 1
	local spread, spreadTarget = 1, 1
	local sky = {} :: ZephyrSky
	function sky.update(t: number)
		shown += (target - shown) * 0.08
		scale += (scaleTarget - scale) * 0.12
		spin += (spinTarget - spin) * 0.05
		spread += (spreadTarget - spread) * 0.06
		local a = smooth(shown)
		for _, entry in beams do
			entry.beam.Transparency = NumberSequence.new(1 - (1 - entry.base) * a)
		end
		for _, halo in halos do
			halo.part.Transparency = 1 - (1 - halo.base) * a
		end
		for _, twinkle_ in stars do
			local glint = 0.5 + 0.5 * math.sin(t * twinkle_.speed + twinkle_.phase)
			twinkle_.part.Transparency = 1 - a * (0.25 + 0.45 * glint)
		end
		-- The spiral turns; its arms curl in from the outer ring to the eye.
		for _, swirl in swirls do
			swirl.ring.set(
				CFrame.new(eye + UP * swirl.height) * CFrame.Angles(rad(swirl.tilt), t * swirl.speed * spin, 0),
				swirl.radius * spread
			)
		end
		for _, arm in arms do
			local angle = arm.phase + t * 0.35 * spin
			local outer = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local inner = Vector3.new(math.cos(angle + 1.6), 0, math.sin(angle + 1.6))
			local outerAt = eye + outer * 160 * spread - UP * 30
			local innerAt = eye + inner * 22 * spread
			-- Leaving the rim along it, arriving round the eye.
			Soft.aim(arm.from, outerAt, Vector3.new(-outer.Z, 0, outer.X))
			Soft.aim(arm.to, innerAt, Vector3.new(-inner.Z, 0, inner.X))
			arm.beam.CurveSize0 = 70 * spread
			arm.beam.CurveSize1 = 18 * spread
		end
		star.place(eye, t * 0.6)
		local glow = a * (0.25 + 0.15 * math.sin(t * 3))
		for i, part in star.parts do
			part.Transparency = if i == 1 then 1 - 0.6 * a * math.min(scale, 1) else 1 - glow * 1.6 * math.min(scale, 1)
			if i == 1 then
				part.Size = Vector3.one * 30 * 0.32 * math.max(scale, 0.05)
			end
		end
	end
	function sky.gather()
		-- The blade grows toward it: the star swells, the spiral turns faster.
		scaleTarget, spinTarget = 1.8, 2.2
	end
	function sky.flare()
		-- The strike: the star flares white and the light falls hard.
		scale, scaleTarget = 2.8, 2.2
		for _, beam in fall do
			beam.Width0, beam.Width1 = 30, 10
			U.tween(beam, 0.5, { Width0 = 16, Width1 = 4 })
		end
		twinkle(eye, 60, STAR, 0.45)
		U.flash(eye, SKY_SUN, 40, 0.3)
	end
	function sky.scatter()
		-- They fall: the spiral blows apart and thins out, the star goes out.
		spinTarget, spreadTarget, scaleTarget = 3, 1.6, 0
	end
	local born = os.clock()
	local connection = RunService.RenderStepped:Connect(function()
		sky.update(os.clock() - born)
	end)
	function sky.close(duration: number)
		target = 0
		task.delay(duration + 0.6, function()
			connection:Disconnect()
			for _, instance in made do
				instance:Destroy()
			end
		end)
	end
	sky.update(0)
	target = 1
	return sky
end

--[[
	Sylph, the spirit of Zephyr, over the fight: a giant figure of wind and
	light looming behind them (wherever you look from: she's drawn facing
	you, beyond the fight), her hair and the tail of her dress streaming in
	the wind, wings of wind open behind her, a halo of light over her head.
	When he raises his hands for the blade she lifts her arms over her head,
	then pours herself into him: she shrinks into a stream of wind that runs
	down to him (the little Sylph that dives into the blade).
]]
export type Spirit = { raise: () -> (), dissolve: (BasePart) -> (), close: () -> () }

local SPIRIT_HEIGHT = 84

local function sylphSpirit(plan: SaintPlan.Plan): Spirit
	local made: { Instance } = {}
	local H = SPIRIT_HEIGHT
	type Limb = { a: Attachment, b: Attachment, beam: Beam, base: number, curve: number }
	local limbs: { [string]: Limb } = {}
	local function limb(name: string, style: Soft.BeamStyle, base: number, curve: number?)
		local a, b = worldAnchor(plan.center), worldAnchor(plan.center)
		local beam = softBeam(a, b, style)
		beam.Transparency = NumberSequence.new(1)
		table.insert(made, a)
		table.insert(made, b)
		table.insert(made, beam)
		limbs[name] = { a = a, b = b, beam = beam, base = base, curve = curve or 0 }
	end
	local wind = ColorSequence.new(WIND_WHITE, WIND)
	limb("body", {
		color = ColorSequence.new(WIND_WHITE),
		width0 = 0.09 * H,
		width1 = 0.14 * H,
		transparency = NumberSequence.new(0),
	}, 0.82)
	limb("head", {
		color = ColorSequence.new(WIND_WHITE),
		width0 = 0.1 * H,
		width1 = 0.085 * H,
		transparency = NumberSequence.new(0),
	}, 0.76)
	limb("dress", {
		color = wind,
		width0 = 0.17 * H,
		width1 = 0.02 * H,
		transparency = NumberSequence.new(0),
		texture = SMOKE,
		speed = -8,
		length = 30,
	}, 0.86, 0.25)
	for _, side in { "L", "R" } do
		limb("arm" .. side, {
			color = ColorSequence.new(WIND_WHITE),
			width0 = 0.035 * H,
			width1 = 0.022 * H,
			transparency = NumberSequence.new(0),
		}, 0.84, 0.1)
		limb("wingHigh" .. side, {
			color = wind,
			width0 = 0.2 * H,
			width1 = 0.05 * H,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 5,
			length = 26,
		}, 0.9, 0.18)
		limb("wingLow" .. side, {
			color = wind,
			width0 = 0.16 * H,
			width1 = 0.03 * H,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 5,
			length = 26,
		}, 0.92, 0.15)
	end
	for i = 1, 3 do
		limb("hair" .. i, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 0.07 * H,
			width1 = 0.006 * H,
			transparency = NumberSequence.new(0),
			texture = SMOKE,
			speed = 6 + i,
			length = 18,
		}, 0.82, 0.14)
	end
	local halo = softRing({
		color = ColorSequence.new(STAR_WHITE, STAR),
		width0 = 0.012 * H,
		width1 = 0.012 * H,
		transparency = NumberSequence.new(0.2),
	})
	table.insert(made, halo.hub)
	local core = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(plan.center) })
	table.insert(made, core)
	local glow = Soft.glow(core, WIND_WHITE, 0.3 * H, 0.88)

	local shown, target = 0, 1 -- faded in
	local raise, raiseTarget = 0, 0 -- arms open to arms over her head
	local shrink = 0 -- pouring herself into him
	local into: BasePart? = nil
	local born = os.clock()
	local function place(t: number)
		local camera = workspace.CurrentCamera.CFrame.Position
		local toward = Vector3.new(plan.center.X - camera.X, 0, plan.center.Z - camera.Z)
		toward = if toward.Magnitude > 1 then toward.Unit else plan.forward
		local heart = plan.center + toward * 150 + UP * (34 + math.sin(t * 1.2) * 1.5)
		local look = (heart - camera).Unit
		local r = look:Cross(UP).Unit
		local u = r:Cross(look).Unit
		local size = H * (1 - 0.9 * shrink)
		if into and shrink > 0 then
			heart = heart:Lerp(into.Position + UP * 3, shrink * shrink)
		end
		local function at(x: number, y: number): Vector3
			return heart + (r * x + u * y) * size
		end
		local function pose(name: string, from: Vector3, to: Vector3, axisFrom: Vector3?, axisTo: Vector3?)
			local limb_ = limbs[name]
			Soft.aim(limb_.a, from, axisFrom or (to - from))
			Soft.aim(limb_.b, to, axisTo or (to - from))
			limb_.beam.CurveSize0 = limb_.curve * size
			limb_.beam.CurveSize1 = -limb_.curve * size * 0.5
		end
		local sway = math.sin(t * 1.7) * 0.02
		pose("body", at(0, 0.25), at(0.01, -0.14))
		pose("head", at(0, 0.285), at(0, 0.375))
		pose("dress", at(0.01, -0.12), at(0.16 + sway * 3, -0.66), -u, (-u + r * 0.6).Unit)
		-- Arms: open, palms out, or lifted over her head.
		for i, side in { "L", "R" } do
			local s = if i == 1 then -1 else 1
			local open = Vector3.new(s * 0.4, 0.3 + sway, 0)
			local up = Vector3.new(s * 0.15, 0.58, 0)
			local hand = open:Lerp(up, smooth(raise))
			pose("arm" .. side, at(s * 0.07, 0.22), at(hand.X, hand.Y), r * s + u * 0.4, u)
			local beat = math.sin(t * 1.4) * 0.04
			pose("wingHigh" .. side, at(s * 0.04, 0.18), at(s * 0.56, 0.64 + beat), r * s + u * 1.6, r * s + u * 0.4)
			pose("wingLow" .. side, at(s * 0.04, 0.1), at(s * 0.46, -0.16 + beat * 0.6), r * s - u * 0.2, r * s - u)
		end
		-- Hair streaming out in the wind.
		for i = 1, 3 do
			local wave = math.sin(t * 2.2 + i) * 0.03
			local tip = ({ Vector3.new(-0.4, 0.26), Vector3.new(-0.46, 0.36), Vector3.new(-0.34, 0.14) })[i]
			pose("hair" .. i, at(0, 0.37), at(tip.X, tip.Y + wave), -r + u * 0.3, -r - u * 0.2)
		end
		halo.set(CFrame.fromMatrix(at(0, 0.43), r, -look), 0.08 * size)
		core.CFrame = CFrame.new(at(0, 0.08))
		local a = smooth(shown) * (1 - shrink)
		for _, limb_ in limbs do
			limb_.beam.Transparency =
				NumberSequence.new({ key(0, 1 - (1 - limb_.base) * a), key(1, 1 - (1 - limb_.base) * a * 0.6) })
		end
		for _, beam in halo.beams do
			beam.Transparency = NumberSequence.new(1 - 0.5 * a)
		end
		glow.Enabled = a > 0.05
	end
	local connection = RunService.RenderStepped:Connect(function()
		shown += (target - shown) * 0.06
		raise += (raiseTarget - raise) * 0.1
		place(os.clock() - born)
	end)
	local closed = false
	local spirit = {} :: Spirit
	function spirit.raise()
		raiseTarget = 1
	end
	function spirit.dissolve(root: BasePart)
		-- Down into him as a stream of wind, getting smaller as she goes.
		into = root
		every(0.45, function(elapsed)
			shrink = smooth(elapsed / 0.45)
			return true
		end, function()
			shrink = 1
			spirit.close()
		end)
		windPuff(root.Position + UP * 3, 6)
		twinkle(root.Position + UP * 3, 10, STAR, 0.3)
	end
	function spirit.close()
		if closed then
			return
		end
		closed = true
		target = 0
		task.delay(0.8, function()
			connection:Disconnect()
			glow.Enabled = false
			for _, instance in made do
				instance:Destroy()
			end
		end)
	end
	place(0)
	return spirit
end

local function play(data, character: Model, root: BasePart, context: Context)
	local anims = context.anims
	local target: Model? = data.target
	local targetRoot = target and U.getRoot(target)
	local plan = SaintPlan.Plan(data.origin, data.start, data.floorY)
	local times = SaintPlan.Times
	local cuts = times.Cuts
	local dive, landed = SaintPlan.DiveTimes()
	local started = os.clock()
	local mine = U.isLocal(character) or U.isLocal(target)
	local near = (workspace.CurrentCamera.CFrame.Position - plan.center).Magnitude < 120
	local forward, right = plan.forward, plan.right
	local center = plan.center
	local charge = cuts[1] - SaintPlan.Charge
	-- Every pass through them: the eight cuts, then the X.
	local passes = table.clone(cuts)
	table.insert(passes, times.Cross)

	-- The path starts where his body is (raised by his hover), so his hover
	-- goes at the same moment and he doesn't move.
	PoseAnimator.SettleLift(character, times.Length)

	-- All of it sheer: every piece of wind and light made while it plays is
	-- that much more see-through, so the two of them show through it.
	local unsheer = Soft.sheer(SHEER)
	task.delay(times.Length + 0.3, unsheer)

	-- Both of them stay readable through everything.
	outline(character, WIND_WHITE, times.Length)
	outline(target, STAR, times.Land)

	-- The Golden Dawn: for whoever's near, as he carries them up, the sun
	-- comes up gold, the light turns warm (never dark), and the Zephyr sky
	-- opens over the fight; it goes back after they land. A bloom makes the
	-- wind and starlight glow; for the two of them, depth of field on him.
	local nearby = mine or (workspace.CurrentCamera.CFrame.Position - plan.center).Magnitude < 180
	local sky: ZephyrSky? = nil
	local spirit: Spirit? = nil
	if nearby then
		task.delay(times.Lift - 0.35, function()
			local lift = Cinematic.Dawn(0.9)
			local opened = zephyrSky(plan)
			sky = opened
			task.delay(0.6, function()
				spirit = sylphSpirit(plan)
			end)
			task.delay(times.Land + 0.6 - (times.Lift - 0.35), function()
				opened.close(1.2)
				lift(1.4)
			end)
		end)
	end
	local bloom: BloomEffect? = nil
	local depth: DepthOfFieldEffect? = nil
	if mine or near then
		local effect = Instance.new("BloomEffect")
		effect.Intensity = 0
		effect.Size = 28
		effect.Threshold = 0.9
		effect.Parent = workspace.CurrentCamera
		U.tween(effect, 0.4, { Intensity = 0.6 })
		bloom = effect
	end
	if mine then
		local effect = Instance.new("DepthOfFieldEffect")
		effect.FarIntensity = 0.3
		effect.NearIntensity = 0.1
		effect.InFocusRadius = 16
		effect.FocusDistance = 20
		effect.Parent = workspace.CurrentCamera
		depth = effect
	end
	task.delay(times.Length + 0.2, function()
		for _, effect in { bloom, depth } :: { PostEffect? } do
			if effect then
				U.tween(
					effect,
					0.4,
					if effect:IsA("BloomEffect") then { Intensity = 0 } else { FarIntensity = 0, NearIntensity = 0 }
				)
				task.delay(0.45, effect.Destroy, effect)
			end
		end
	end)
	local function punch(intensity: number, decay: number)
		if bloom then
			bloom.Intensity = intensity
			U.tween(bloom, decay, { Intensity = 0.6 })
		end
	end

	-- The seal that binds them: a star on them and rings of starlight and
	-- wind turning round them (little stars riding them), wind swirling
	-- round them while they hang there.
	local seal = Soft.softStar(3)
	local bindRings = {
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.4,
			width1 = 0.4,
			transparency = NumberSequence.new(0.3),
		}),
		softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.2,
			width1 = 1.2,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 3,
			length = 4,
		}),
		softRing({
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.7,
			width1 = 0.7,
			transparency = NumberSequence.new(0.45),
			texture = SPARKLE,
			wrap = true,
			length = 1.2,
			speed = 2,
		}),
	}
	local shackles: { Soft.Star } = {}
	for _ = 1, 3 do
		table.insert(shackles, Soft.softStar(0.9))
	end
	local swirlHolder = U.newPart({ Size = Vector3.one * 9, Transparency = 1, CFrame = CFrame.new(center) })
	local swirl = windEmitter(swirlHolder, {
		Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.85), key(1, 1) }),
		Size = NumberSequence.new({ key(0, 3), key(1, 8) }),
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(3, 8),
		SpreadAngle = Vector2.new(180, 180),
		Shape = Enum.ParticleEmitterShape.Sphere,
		Drag = 1,
		Rate = 0,
	})

	-- The constellation: the eight stars, joined in the order he goes round
	-- them (one line drawing an eight-pointed star) by streams of sparkles
	-- over thin lines of light; and his own star where he waits.
	local stars: { Soft.Star } = {}
	local starAnchors: { Attachment } = {}
	local lines: { Beam } = {}
	for _ = 1, #plan.stars do
		table.insert(stars, Soft.softStar(2.4))
		table.insert(starAnchors, worldAnchor(center))
	end
	for i = 1, #plan.stars do
		local a, b = starAnchors[i], starAnchors[i % #plan.stars + 1]
		local stream = Soft.starStream(a, b, 0.55, 3)
		local thread = softBeam(a, b, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 0.12,
			width1 = 0.12,
			transparency = NumberSequence.new({ key(0, 0.3), key(0.5, 0.6), key(1, 0.3) }),
		})
		stream.Enabled = false
		thread.Enabled = false
		table.insert(lines, stream)
		table.insert(lines, thread)
	end
	local homeStar = Soft.softStar(1.8)
	local circle = skyCircle(center, SaintPlan.Ring + 3)
	local slashes: { Soft.Slash } = {}
	local blade: Blade? = nil
	local tailTop = worldAnchor(center, UP)
	local tailEnd = worldAnchor(center, UP)
	local tail = {
		softBeam(tailEnd, tailTop, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 1.6,
			width1 = 0.2,
			transparency = NumberSequence.new({ key(0, 0.1), key(1, 1) }),
		}),
		softBeam(tailEnd, tailTop, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 5,
			width1 = 1,
			transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
			texture = SMOKE,
			speed = -6,
			length = 10,
		}),
		softBeam(tailEnd, tailTop, {
			color = ColorSequence.new(STAR_WHITE, STAR),
			width0 = 2.6,
			width1 = 0.6,
			transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
			texture = SPARKLE,
			wrap = true,
			length = 2.5,
			speed = -10,
		}),
	}
	for _, beam in tail do
		beam.Enabled = false
	end
	local burst = false

	-- His sword, and the light pouring from the stars into the blade.
	local swordBlade = context.blade(character)
	local gathering: { Beam } = {}
	local gatherExtra: { Instance } = {}

	local bind = "CloverSaintZephyr" .. tostring(started)
	local function finish()
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > times.Length + 0.1 then
			finish()
			return
		end
		if root.Parent then
			root.CFrame = SaintPlan.Attacker(plan, t)
		end
		local victim = SaintPlan.Victim(plan, math.min(t, times.Land))
		if targetRoot and targetRoot.Parent and t <= times.Land then
			targetRoot.CFrame = victim
		end

		if not burst then
			local at = victim.Position
			seal.place(at + victim.LookVector * 0.9 + UP * 0.4, t * 4)
			local grow = easeOut(t / 0.25)
			bindRings[1].set(CFrame.new(at + UP * 0.9) * CFrame.Angles(0, t * 3, 0), 2.6 * grow + 0.05)
			bindRings[2].set(CFrame.new(at - UP * 0.5) * CFrame.Angles(0, -t * 4, 0), 3 * grow + 0.05)
			bindRings[3].set(
				CFrame.new(at) * CFrame.Angles(0, t * 2, 0) * CFrame.Angles(rad(64), 0, 0),
				3.4 * grow + 0.05
			)
			for i, shackle in shackles do
				local angle = t * 3 + (i - 1) * math.pi * 2 / 3
				local ring = bindRings[1].hub.CFrame
				shackle.place(
					(ring * CFrame.new(math.cos(angle) * 2.6 * grow, 0, math.sin(angle) * 2.6 * grow)).Position,
					t * 6
				)
			end
			-- The stars open out of them one by one, joined up as they go.
			local placed: { Vector3 } = {}
			local opened: { boolean } = {}
			for i, star in stars do
				local open = math.clamp((t - times.Lift - i * 0.025) / 0.2, 0, 1)
				opened[i] = open > 0
				placed[i] = if open > 0 then center:Lerp(plan.stars[i], easeOut(open)) else center + UP * 5000
				star.place(placed[i], t * 2 + i)
				starAnchors[i].CFrame = CFrame.new(placed[i])
			end
			for i = 1, #stars do
				local shown = opened[i] and opened[i % #stars + 1]
				lines[i * 2 - 1].Enabled = shown
				lines[i * 2].Enabled = shown
			end
			circle.update(t, easeOut((t - times.Lift) / 0.35))
			-- His own star, under him while he waits, left behind when he goes.
			local home = if t < times.Hover - 0.1 then center + UP * 5000 else plan.hover - UP * 1.2
			homeStar.place(home, t * 3)
		end

		-- The blade: up out of his raised hands, then down along the strike.
		if blade then
			local hand, other = handOf(character, "Right"), handOf(character, "Left")
			local hands = if hand and other then hand:Lerp(other, 0.5) else root.Position + UP * 2.5
			local grow = easeOut((t - (times.Rise - 0.1)) / 0.35)
			-- Swung over in front of him (round his right), from straight up
			-- to down along the strike, at an even sweep of the angle.
			local down = (plan.ground - (plan.top + UP * SaintPlan.Drift)).Unit
			local swing = smooth((t - dive) / 0.1)
			local arc = math.acos(math.clamp(UP:Dot(down), -1, 1))
			local direction = CFrame.fromAxisAngle(right, swing * arc):VectorToWorldSpace(UP)
			blade.set(hands, direction, SAINT_BLADE * grow + 0.5)
		end

		-- Falling like a meteor: a comet's tail of wind behind them.
		if t >= times.Burst and t <= times.Land then
			local length = 4 + 26 * math.clamp((t - times.Burst) / (times.Land - times.Burst), 0, 1)
			tailEnd.CFrame = CFrame.new(victim.Position)
			tailTop.CFrame = CFrame.new(victim.Position + UP * length)
			for _, beam in tail do
				beam.Enabled = true
			end
		end
	end)

	-- The bind: the star strikes them, a magic circle opens on the ground
	-- under them and a column of wind tears up out of it and carries them
	-- up; he flies up beside them.
	twinkle(plan.start + UP, 9, STAR, 0.35)
	U.flash(plan.start + UP, STAR_WHITE, 4, 0.15)
	lightRing(plan.start + UP, UP, 0.5, 7, 0.35)
	lightRing(plan.start + UP, forward, 0.5, 5, 0.3)
	starDust(plan.start + UP, 18, 26)
	windPuff(plan.start + UP, 4)
	local ground = Vector3.new(plan.start.X, plan.floorY, plan.start.Z)
	groundSigil(ground, 7, times.Lift + 0.5)
	windColumn(ground, SaintPlan.Height + 14, 3.4, times.Lift + 0.5)
	if targetRoot then
		U.spiral(targetRoot, WIND_WHITE, 4, 5, times.Lift, 4, 0.6, 0.3)
	end
	task.delay(0.25, function()
		context.play(character, anims.SaintAscend)
		windPuff(root.Position - UP * 2.5, 3, UP)
		U.spiral(root, WIND, 3, 4, times.Lift, 3, 0.5, 0.3)
		U.bodyTrail(character, WIND, times.Lift)
	end)
	if mine then
		CameraShake.FovKick(4)
	end

	-- The ground far below stirs: dust lifting off it in the downdraft of
	-- the fight over it.
	task.delay(times.Lift, function()
		local below = U.newPart({
			Size = Vector3.new(28, 1, 28),
			Transparency = 1,
			CFrame = CFrame.new(ground + UP * 0.5),
		})
		local stir = windEmitter(below, {
			Color = ColorSequence.new(Color3.fromRGB(205, 214, 204), Color3.fromRGB(170, 190, 175)),
			LightEmission = 0,
			Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.82), key(1, 1) }),
			Size = NumberSequence.new({ key(0, 3), key(1, 7) }),
			Lifetime = NumberRange.new(1.2, 1.8),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(60, 60),
			EmissionDirection = Enum.NormalId.Top,
			Shape = Enum.ParticleEmitterShape.Disc,
			Rate = 14,
		})
		task.delay(times.Burst - times.Lift, function()
			stir.Enabled = false
		end)
		task.delay(times.Burst - times.Lift + 2, below.Destroy, below)
	end)

	-- The constellation opens round them; wind swirls round them; light
	-- pours from every star into them.
	task.delay(times.Lift, function()
		swirl.Rate = 22
		windRing(center, UP, 2, SaintPlan.Ring + 6, 0.5)
		lightRing(center, UP, 1, SaintPlan.Ring + 4, 0.45)
		U.shockwave(center, WIND, 2, SaintPlan.Ring * 2.4, 0.5)
		U.light(center, STAR, 6, 70, times.Burst - times.Lift)
		for i, at in plan.stars do
			task.delay(i * 0.025 + 0.15, function()
				twinkle(at, 4, STAR, 0.3)
				lightRing(at, (center - at).Unit, 0.3, 3.5, 0.3)
				local from, into = worldAnchor(at), worldAnchor(center)
				local ray = softBeam(from, into, {
					color = ColorSequence.new(STAR_WHITE, STAR),
					width0 = 0.9,
					width1 = 0.15,
					transparency = NumberSequence.new({ key(0, 0.3), key(1, 0.8) }),
				})
				fadeBeams({ ray }, 0.4, { from, into })
			end)
		end
	end)
	task.delay(times.Hover - 0.1, function()
		context.play(character, anims.SaintPoise)
	end)
	task.delay(times.Hover - 0.05, function()
		twinkle(plan.hover - UP * 1.2, 3, STAR, 0.3)
		windRing(plan.hover - UP * 1.4, UP, 0.5, 4, 0.35)
	end)

	-- The dance: he leaves a ribbon of wind behind him (painting the
	-- petals round them), his sword sweeps a sheet of wind as it swings and
	-- sheds starlight, and he glows.
	local torso = character:FindFirstChild("Torso") :: BasePart?
	task.delay(charge, function()
		windPuff(plan.hover, 3, -plan.passes[1])
		windRing(plan.hover, plan.passes[1], 1, 6, 0.3)
		U.afterimage(character, WIND, 0.4)
		twinkle(plan.hover - UP * 1.2, 4, STAR, 0.25)
		if not torso then
			return
		end
		local dance = times.Rise - charge
		local trails = {
			Soft.trail(torso, Vector3.new(0, 1.7, 0), Vector3.new(0, -1.7, 0), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.4), key(0.4, 0.65), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.35) }),
				lifetime = 0.75,
				texture = SMOKE,
			}),
			Soft.trail(torso, Vector3.new(0, 0.3, 0), Vector3.new(0, -0.3, 0), {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				transparency = NumberSequence.new({ key(0, 0.1), key(1, 1) }),
				lifetime = 0.22,
			}),
		}
		local aura = Soft.glow(torso, WIND, 5, 0.9)
		local lamp = Instance.new("PointLight")
		lamp.Color = WIND
		lamp.Range = 18
		lamp.Brightness = 3
		lamp.Shadows = false
		lamp.Parent = torso
		local dust = windEmitter(torso, {
			Texture = SPARKLE,
			Color = ColorSequence.new(STAR_WHITE, STAR),
			LightEmission = 1,
			Transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
			Size = NumberSequence.new({ key(0, 0.45), key(1, 0) }),
			Lifetime = NumberRange.new(0.3, 0.6),
			Speed = NumberRange.new(0.5, 2),
			SpreadAngle = Vector2.new(180, 180),
			Rate = 60,
		})
		local swordTrails: { Trail } = {}
		local swordGlitter: ParticleEmitter? = nil
		if swordBlade then
			table.insert(
				swordTrails,
				Soft.trail(swordBlade, Vector3.new(0, -2.6, 0), Vector3.new(0, 2.7, 0), {
					color = ColorSequence.new(WIND_WHITE, WIND),
					transparency = NumberSequence.new({ key(0, 0.1), key(1, 1) }),
					lifetime = 0.22,
					faceCamera = false,
				})
			)
			swordGlitter = windEmitter(swordBlade, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, STAR),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
				Size = NumberSequence.new({ key(0, 0.4), key(1, 0) }),
				Lifetime = NumberRange.new(0.2, 0.4),
				Speed = NumberRange.new(0),
				Shape = Enum.ParticleEmitterShape.Box,
				Rate = 70,
			})
		end
		task.delay(dance, function()
			for _, trail in trails do
				Soft.endTrail(trail)
			end
			for _, trail in swordTrails do
				Soft.endTrail(trail)
			end
			aura.Enabled = false
			dust.Enabled = false
			U.tween(lamp, 0.3, { Brightness = 0 })
			task.delay(0.35, lamp.Destroy, lamp)
			task.delay(1, aura.Destroy, aura)
			task.delay(1, dust.Destroy, dust)
			if swordGlitter then
				swordGlitter.Enabled = false
				task.delay(0.6, swordGlitter.Destroy, swordGlitter)
			end
		end)
	end)

	-- Each pass: the swing (just before he's in the middle of them), the cut
	-- itself (a stroke of light through them, left hanging as a crescent of
	-- wind), and round each star a kick off it (a ghost of him left there).
	for i, at in passes do
		local direction = plan.passes[i]
		local last = i == #passes
		local swing = if last or i % 2 == 1 then anims.SaintCut else anims.SaintCutBack
		task.delay(math.max(at - 0.05, 0), function()
			context.play(character, swing)
		end)
		local side, lift = across(direction)
		local scale = if last then 1.5 else 0.68 + i * 0.04
		local reach = if last then 13 else 10
		-- The crescent is swept along with him (centred on him being in the
		-- middle of them).
		task.delay(math.max(at - 0.025, 0), function()
			if burst then
				return
			end
			local bend = (if i % 2 == 1 then lift else side) * (2.4 + i * 0.25) * (if i % 4 < 2 then 1 else -1)
			table.insert(
				slashes,
				Soft.windSlash(center - direction * reach, center + direction * reach, bend, scale, 0.05)
			)
		end)
		task.delay(at, function()
			if burst then
				return
			end
			-- The stroke through them.
			local a0, a1 =
				worldAnchor(center - direction * 5, direction), worldAnchor(center + direction * 6, direction)
			local stroke = {
				softBeam(a0, a1, {
					color = ColorSequence.new(STAR_WHITE),
					width0 = 0.15,
					width1 = 0.7,
					transparency = NumberSequence.new({ key(0, 0.6), key(0.5, 0), key(1, 0.3) }),
				}),
				softBeam(a0, a1, {
					color = ColorSequence.new(WIND_WHITE, WIND),
					width0 = 0.6,
					width1 = 2.6,
					transparency = NumberSequence.new({ key(0, 0.8), key(0.5, 0.35), key(1, 0.55) }),
					texture = SMOKE,
					speed = 6,
					length = 4,
				}),
			}
			fadeBeams(stroke, 0.16, { a0, a1 })
			twinkle(center + direction * 0.4, if last then 9 else 4.5, STAR, 0.22)
			lightRing(center, direction, 0.8, if last then 12 else 6, if last then 0.35 else 0.22)
			streaks(center + direction, if last then 30 else 12, if last then 110 else 80, direction)
			windPuff(center + direction * 2, if last then 4 else 2, direction)
			if target then
				U.highlight(target, WIND_WHITE, 0.1, 0.6)
			end
			if last then
				-- The X: its mirror stroke at once, a wider shock, a flash.
				local mirror = Vector3.new(direction.X, -direction.Y, direction.Z).Unit
				table.insert(
					slashes,
					Soft.windSlash(center - mirror * reach, center + mirror * reach, right * 3, scale, 0.05)
				)
				windRing(center, side, 2, 20, 0.4)
				U.shockwave(center, WIND, 2, 22, 0.35)
				starDust(center, 30, 40)
				-- Rays of light thrown out from them every way.
				local rays: { Beam } = {}
				local ends: { Attachment } = {}
				local hub = worldAnchor(center)
				table.insert(ends, hub)
				for k = 1, 12 do
					local out = U.randomUnit()
					local tip = worldAnchor(center + out * (14 + math.random() * 8), out)
					table.insert(ends, tip)
					table.insert(
						rays,
						softBeam(hub, tip, {
							color = ColorSequence.new(STAR_WHITE, if k % 2 == 0 then STAR else WIND_WHITE),
							width0 = 1.6,
							width1 = 0.05,
							transparency = NumberSequence.new({ key(0, 0.15), key(1, 0.9) }),
						})
					)
				end
				for _, ray in rays do
					U.tween(ray, 0.3, { Width0 = 0.1 })
				end
				fadeBeams(rays, 0.32, ends)
				punch(1.2, 0.35)
				if mine or near then
					U.colorGrade({ Brightness = 0.08, Contrast = 0.25, Saturation = -0.3 }, 0, 0.05, 0.18)
				end
				if mine then
					CameraShake.FovKick(4)
				end
			end
		end)
		-- Round the star after this pass (the X has none: he goes up).
		local star = plan.stars[i]
		if star and passes[i + 1] then
			local tipAt = (at + passes[i + 1]) / 2
			task.delay(tipAt - 0.02, function()
				if burst then
					return
				end
				U.afterimage(character, WIND, 0.35)
				twinkle(star, 3.2, STAR, 0.22)
				lightRing(star, (center - star).Unit, 0.3, 3, 0.25)
				windPuff(star, 1.4)
				-- The lines of light meeting at this star flare up and settle.
				local count = #plan.stars
				for _, line in { (i - 1) % count + 1, (i - 2) % count + 1 } do
					local stream = lines[line * 2 - 1]
					if stream.Parent then
						stream.Width0, stream.Width1 = 1.6, 1
						U.tween(stream, 0.3, { Width0 = 0.55, Width1 = 0.33 })
					end
				end
			end)
		end
	end

	-- High above them: wings of wind open, wind pours in, Sylph dives into
	-- his hands and the blade grows out of them; the light of every star
	-- pours into it.
	task.delay(times.Rise - 0.35, function()
		if spirit then
			spirit.raise()
		end
	end)
	task.delay(times.Rise + 0.05, function()
		if spirit then
			spirit.dissolve(root)
		end
	end)
	task.delay(times.Rise + 0.12, function()
		if sky then
			sky.gather()
		end
	end)
	task.delay(times.Strike, function()
		if sky then
			sky.flare()
		end
		if mine then
			Soft.focusLines(0.35)
		end
	end)
	task.delay(times.Burst, function()
		if sky then
			sky.scatter()
		end
		if mine then
			Soft.focusLines(0.3)
		end
	end)
	task.delay(times.Length, function()
		if spirit then
			spirit.close()
		end
	end)
	task.delay(times.Rise - 0.1, function()
		context.play(character, anims.SaintRise)
		local hold = dive - (times.Rise - 0.1)
		context.hideSword(character, hold + 0.4)
		local made = windBlade()
		made.set(root.Position + UP * 2.5, UP, 0.5) -- (in his hands from the first frame)
		blade = made
		wingsOfWind(character, hold + 0.3)
		windPuff(plan.top, 5)
		windRing(plan.top, forward, 2, 16, 0.45)
		lightRing(plan.top, UP, 1, 14, 0.4)
		U.shockwave(plan.top, WIND, 2, 18, 0.45)
		local gather = U.newPart({ Size = Vector3.one * 34, Transparency = 1, CFrame = CFrame.new(plan.top + UP * 12) })
		local inward = windEmitter(gather, {
			Size = NumberSequence.new({ key(0, 4), key(1, 1) }),
			Lifetime = NumberRange.new(0.5, 0.8),
			Speed = NumberRange.new(22, 34),
			Shape = Enum.ParticleEmitterShape.Sphere,
			ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
			Rate = 70,
		})
		task.delay(hold, function()
			inward.Enabled = false
		end)
		task.delay(hold + 1, gather.Destroy, gather)
		U.light(plan.top, STAR, 6, 60, hold + 0.2)
		-- The heavens open over him: a shaft of wind up into the sky.
		local low, high = worldAnchor(plan.top, UP), worldAnchor(plan.top + UP * 220, UP)
		local shaft = {
			softBeam(low, high, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 7,
				width1 = 20,
				transparency = NumberSequence.new({ key(0, 0.6), key(1, 1) }),
				texture = SMOKE,
				speed = 5,
				length = 30,
			}),
			softBeam(low, high, {
				color = ColorSequence.new(STAR_WHITE),
				width0 = 1.2,
				width1 = 3,
				transparency = NumberSequence.new({ key(0, 0.3), key(1, 1) }),
			}),
			softBeam(low, high, {
				color = ColorSequence.new(STAR_WHITE, STAR),
				width0 = 3,
				width1 = 6,
				transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
				texture = SPARKLE,
				wrap = true,
				length = 5,
				speed = 12,
			}),
		}
		task.delay(hold, fadeBeams, shaft, 0.3, { low, high })
		-- Sylph circles him, then dives into the blade.
		local sylph = Soft.makeSprite(1.4)
		local into = dive - 0.18
		every(into - (times.Rise - 0.1) + 0.1, function(elapsed)
			local t = elapsed + (times.Rise - 0.1)
			local head = root.Position + UP * 2.5
			if t < into then
				local angle = elapsed * 7
				local at = head + Vector3.new(math.cos(angle) * 3.5, math.sin(elapsed * 5) * 1.2, math.sin(angle) * 3.5)
				sylph.place(CFrame.lookAt(at, at + Vector3.new(-math.sin(angle), 0, math.cos(angle))), elapsed)
			else
				local a = math.clamp((t - into) / 0.1, 0, 1)
				sylph.place(CFrame.new(head:Lerp(head + UP * SAINT_BLADE, a)), elapsed)
			end
			return true
		end, function()
			sylph.fade(0.1)
			twinkle(root.Position + UP * (SAINT_BLADE + 2.5), 8, STAR, 0.3)
			windPuff(root.Position + UP * (SAINT_BLADE + 2.5), 4)
		end)
		if mine then
			CameraShake.FovKick(3)
		end
	end)
	task.delay(times.Rise + 0.12, function()
		local current = blade
		if burst or not current then
			return
		end
		-- Every star pours its light up into the blade's point.
		for i, anchor in starAnchors do
			table.insert(gathering, Soft.starStream(anchor, current.tip, 0.8, 9))
			twinkle(plan.stars[i], 3, STAR, 0.25)
		end
		local from = worldAnchor(center)
		table.insert(gathering, Soft.starStream(from, current.tip, 1.2, 12))
		table.insert(gatherExtra, from)
	end)

	-- The strike: the swing leaves a crescent of wind the height of the
	-- sky, and a seam of light from the heavens to the ground; it goes
	-- through them (a beat of hit-stop), and he lands.
	task.delay(dive, function()
		context.play(character, anims.SaintStrike)
		fadeBeams(gathering, 0.15, gatherExtra)
		local top = plan.top + UP * SaintPlan.Drift
		local down = (plan.ground - top).Unit
		table.insert(slashes, Soft.windSlash(top + UP * 38, top + down * 38, -forward * 30, 3, 0.1))
	end)
	task.delay(times.Strike, function()
		windSeam(plan.top + UP * SaintPlan.Drift, plan.ground)
		twinkle(center, 18, STAR, 0.35)
		U.flash(center, STAR_WHITE, 9, 0.25)
		for k = 1, 3 do
			windRing(center, UP, 2, 14 + k * 9, 0.3 + k * 0.08, if k == 2 then STAR else WIND)
		end
		lightRing(center, UP, 1, 30, 0.35)
		lightRing(center, forward, 1, 18, 0.3)
		U.shockwave(center, WIND, 3, 36, 0.4)
		windPuff(center, 6)
		U.burst(center, {
			color = STAR_WHITE,
			count = 40,
			size = 0.6,
			speed = NumberRange.new(60, 120),
			lifetime = NumberRange.new(0.2, 0.45),
			streaks = true,
			spread = 180,
		})
		U.light(center, STAR_WHITE, 8, 90, 0.45)
		-- Hit-stop: both of them frozen for a beat.
		PoseAnimator.Freeze(character, 0.12)
		if target then
			PoseAnimator.Freeze(target, 0.12)
		end
		punch(1.5, 0.5)
		if mine or near then
			-- An impact frame: a flash of stark black and white.
			U.colorGrade({ Brightness = 0.25, Contrast = 0.85, Saturation = -1 }, 0, 0.07, 0.22)
		end
		-- (No shake: the cutscene camera's own eased zoom is the blow.)
	end)
	task.delay(landed, function()
		context.play(character, anims.SaintLand)
		local feet = plan.ground - UP * 2.6
		windPuff(feet, 4, UP)
		windRing(feet, UP, 1, 12, 0.4)
		lightRing(feet + UP * 0.1, UP, 0.5, 8, 0.3, WIND_WHITE)
		U.groundCracks(feet, 6, 6, WIND, 1.4)
		U.burst(feet, {
			texture = SMOKE,
			color = Color3.fromRGB(196, 204, 194),
			count = 14,
			size = 3,
			speed = NumberRange.new(14, 30),
			lifetime = NumberRange.new(0.4, 0.8),
			transparency = 0.5,
			lightEmission = 0,
			drag = 4,
			spread = 80,
			direction = UP,
		})
		if blade then
			blade.dissolve()
			blade = nil
		end
	end)

	-- Every hanging cut bursts, one after another; the stars burst; the rings
	-- blow apart; they fall.
	task.delay(times.Burst, function()
		burst = true
		swirl.Enabled = false
		task.delay(1.5, swirlHolder.Destroy, swirlHolder)
		for i, slash in slashes do
			task.delay((i - 1) * 0.03, function()
				slash.flare()
				task.delay(0.1, function()
					windPuff(slash.apex, 2.5)
					starDust(slash.apex, 8, 24)
					twinkle(slash.apex, 4, STAR, 0.2)
					slash.fade(0.25)
				end)
			end)
		end
		for i, star in stars do
			twinkle(plan.stars[i], 6, STAR, 0.3)
			starDust(plan.stars[i], 10, 30)
			windPuff(plan.stars[i], 2)
			star.fade(0.2)
		end
		homeStar.fade(0.2)
		fadeBeams(lines, 0.2, starAnchors)
		circle.blowApart()
		seal.fade(0.15)
		for _, shackle in shackles do
			shackle.fade(0.15)
		end
		for _, ring in bindRings do
			ring.fade(0.15)
		end
		local nova = Soft.softStar(9)
		nova.place(center, 0)
		task.delay(0.1, nova.fade, 0.45)
		twinkle(center, 22, STAR, 0.45)
		windRing(center, UP, 3, 40, 0.5, STAR)
		windRing(center, forward, 3, 32, 0.45)
		lightRing(center, UP, 2, 46, 0.5)
		U.shockwave(center, STAR, 3, 44, 0.5)
		windPuff(center, 8)
		U.burst(center, {
			color = STAR,
			count = 50,
			size = 0.6,
			speed = NumberRange.new(40, 100),
			lifetime = NumberRange.new(0.3, 0.6),
			streaks = true,
			spread = 180,
		})
		if targetRoot then
			U.spiral(targetRoot, WIND_WHITE, 3, -5, times.Land - times.Burst, 3, 0.6, 0.2)
			-- A comet's trail of smoke and glitter as they fall.
			local smoke = windEmitter(targetRoot, {
				Size = NumberSequence.new({ key(0, 2), key(1, 5) }),
				Transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
				Lifetime = NumberRange.new(0.4, 0.8),
				Speed = NumberRange.new(1, 3),
				Rate = 70,
			})
			local glitter = windEmitter(targetRoot, {
				Texture = SPARKLE,
				Color = ColorSequence.new(STAR_WHITE, STAR),
				LightEmission = 1,
				Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
				Size = NumberSequence.new({ key(0, 0.6), key(1, 0) }),
				Lifetime = NumberRange.new(0.4, 0.8),
				Speed = NumberRange.new(1, 4),
				SpreadAngle = Vector2.new(180, 180),
				Rate = 60,
			})
			task.delay(times.Land - times.Burst, function()
				smoke.Enabled = false
				glitter.Enabled = false
				task.delay(1, smoke.Destroy, smoke)
				task.delay(1, glitter.Destroy, glitter)
			end)
			-- Rings of wind torn off them as they fall.
			for k = 1, 4 do
				task.delay(k * 0.07, function()
					if targetRoot.Parent then
						windRing(targetRoot.Position, UP, 1, 5 + k, 0.25)
					end
				end)
			end
		end
		if mine or near then
			U.colorGrade({ Brightness = 0.1, TintColor = Color3.fromRGB(255, 246, 222) }, 0, 0.08, 0.3)
		end
		punch(1.2, 0.4)
		if mine then
			CameraShake.FovKick(5)
		end
	end)

	task.delay(times.Land, function()
		fadeBeams(tail, 0.2, { tailTop, tailEnd })
		featherFall(plan.ground, 18, times.Length - times.Land + 1.2)
	end)
	task.delay(times.Length - 0.35, function()
		local hand = handOf(character, "Right")
		if hand then
			U.glint(hand, 2, STAR_WHITE)
			twinkle(hand, 3, STAR, 0.3)
		end
	end)
	task.delay(times.Length + 0.3, finish)

	-- The camera: every shot moving, smoothly (eased, no shake), him always
	-- in shot. Pushing in over his shoulder as the star strikes; craning up
	-- the column with them; behind him at his star as the constellation
	-- opens (he charges away from us, through them); circling them wide
	-- through the dance; side-on for the X; from below them up at him and
	-- the blade; wide for the strike; falling with them; and round him at
	-- the crater to his face, his back to it.
	if not mine then
		return
	end
	local origin, start, top, landing = plan.origin.Position, plan.start, plan.top, plan.ground
	local function him(t: number): Vector3
		return SaintPlan.Attacker(plan, t).Position
	end
	local function them(t: number): Vector3
		return SaintPlan.Victim(plan, math.min(t, times.Land)).Position
	end
	-- Through the dance the camera follows him smoothly (not every dart).
	local followed: Vector3? = nil
	local lastT = 0
	local function follow(t: number): Vector3
		local dt = math.max(t - lastT, 0)
		lastT = t
		local target = him(t)
		followed = if followed then followed:Lerp(target, math.min(dt * 5, 1)) else target
		return followed :: Vector3
	end
	local x = plan.passes[#plan.passes]
	local xSide = Vector3.new(x.X, 0, x.Z)
	xSide = if xSide.Magnitude > 1e-3 then xSide.Unit:Cross(UP) else right
	type Shot = {
		from: number,
		to: number,
		blend: number, -- ease in from the last shot over this long (0: a cut)
		get: (number, number) -> (Vector3, Vector3, number, number), -- eye, focus, roll (degrees), field of view
	}
	local shots: { Shot } = {
		{
			from = 0,
			to = 0.35,
			blend = 0,
			get = function(u, t)
				local e = smooth(u)
				local eye = (origin - forward * 9.5 + right * 3.5 + UP * 2.4):Lerp(
					origin - forward * 7.5 + right * 3 + UP * 2,
					e
				)
				return eye, them(t):Lerp(him(t), 0.55) + UP * 0.3, -2 * e, 74 - 6 * e
			end,
		},
		{
			from = 0.35,
			to = times.Hover + 0.05,
			blend = 0.3,
			get = function(u, t)
				local e = smooth(u)
				local victim, attacker = them(t), him(t)
				local middle = victim:Lerp(attacker, 0.5)
				local angle = rad(-20 + 60 * e)
				local around = forward * math.sin(angle) + right * math.cos(angle)
				local eye = Vector3.new(start.X, start.Y + 1.5 + (middle.Y - start.Y) * 0.85, start.Z) + around * 16
				return eye, middle + UP, 3, 84 - 6 * e
			end,
		},
		{
			from = times.Hover + 0.05,
			to = cuts[1] - 0.04,
			blend = 0,
			get = function(u, _)
				local e = smooth(u)
				local behind = plan.hover - plan.passes[1] * (9 - 2 * e) + UP * 2.6 + right * 2.2
				return behind, center + UP * 0.5, -3, 72 - 4 * e
			end,
		},
		{
			from = cuts[1] - 0.04,
			to = times.Cross - 0.12,
			blend = 0.35,
			get = function(u, t)
				local angle = rad(-35) + u * rad(110)
				local radius = 23 - 3 * u
				local around = -forward * math.cos(angle) + right * math.sin(angle)
				local eye = center + around * radius + UP * (5 + 3 * math.sin(u * math.pi))
				return eye, center:Lerp(follow(t), 0.18), -3 + 2 * u, 66 + 6 * u
			end,
		},
		{
			from = times.Cross - 0.12,
			to = times.Rise - 0.05,
			blend = 0.25,
			get = function(u, t)
				local e = smooth(u)
				-- Pulling back as he rises out of it, to keep them both.
				local rise = smooth((u - 0.35) / 0.65)
				local look = center:Lerp(him(t), 0.5 * rise)
				return center + xSide * (20 + 12 * rise) + UP * (1 + 4 * e), look, 3 * e, 66 - 4 * e + 10 * rise
			end,
		},
		{
			from = times.Rise - 0.05,
			to = dive,
			blend = 0.3,
			get = function(u, _)
				local e = smooth(u)
				local angle = rad(-30 + 50 * e)
				local around = right * math.cos(angle) + forward * math.sin(angle)
				-- From below them: them hanging close and him high above them,
				-- then tilting up and pulling back as the blade grows, until
				-- it's all in shot, him at the foot of it.
				local reveal = smooth((u - 0.15) / 0.6)
				local eye = center - UP * 4 + around * (24 + 10 * reveal)
				local focus = center:Lerp(top + UP * 6, 0.44):Lerp(top + UP * 19, reveal)
				return eye, focus, -5 + 3 * e, 78 - 4 * e
			end,
		},
		{
			from = dive,
			to = times.Burst + 0.05,
			blend = 0,
			get = function(u, _)
				return center + right * (48 + 6 * u) + UP * (1 + u), center - UP * 4, 0, 80 + 3 * u
			end,
		},
		{
			from = times.Burst + 0.05,
			to = times.Land + 0.1,
			blend = 0.25,
			get = function(_, t)
				-- Held still, panning down with them as they fall (so nothing
				-- lurches when they hit).
				local eye = start + UP * 18 + right * 30 + forward * 6
				return eye, them(t):Lerp(start, 0.4), 4, 80
			end,
		},
		{
			from = times.Land + 0.1,
			to = times.Length + 0.3,
			blend = 0.3,
			get = function(u, _)
				local e = smooth(u)
				-- In front of him, the crater and the tornado behind him,
				-- coming round to his face.
				local angle = rad(140 + 40 * e)
				local around = forward * math.cos(angle) + right * math.sin(angle)
				return landing + around * (13 - 5 * e) + UP * (2.4 - 0.6 * e),
					landing + UP * (1.6 + 0.2 * e),
					0,
					70 - 12 * e
			end,
		},
	}
	-- A blow's zoom: in fast, eased back out (never a jump).
	local function blow(t: number, at: number, amount: number): number
		if t < at then
			return 0
		end
		local u = (t - at) / 0.08
		return amount * u * math.exp(1 - u)
	end
	local function zoom(t: number): number
		local total = 0
		for i, at in passes do
			total += blow(t, at, if i == #passes then 6 else 2)
		end
		return total + blow(t, times.Strike, 8) + blow(t, times.Burst, 4)
	end
	-- Where a shot puts the camera at `t` (past its end it carries on as
	-- it was going, for blending out of it).
	local function evaluate(shot: Shot, t: number, hold: boolean): (CFrame, number)
		local u = (t - shot.from) / math.max(shot.to - shot.from, 1e-3)
		if hold then
			u = math.clamp(u, 0, 1)
		end
		local eye, focus, roll, fov = shot.get(u, t)
		return CFrame.lookAt(eye, focus) * CFrame.Angles(0, 0, rad(roll)), fov
	end
	Cinematic.Camera(function(t)
		local index = #shots
		for i, shot in shots do
			if t < shot.to then
				index = i
				break
			end
		end
		local shot = shots[index]
		local cframe, fov = evaluate(shot, t, true)
		local previous = shots[index - 1]
		if shot.blend > 0 and previous and t - shot.from < shot.blend then
			-- Eased both ways, from where the last shot is now: no jolt
			-- starting or finishing the move.
			local b = smooth((t - shot.from) / shot.blend)
			local fromFrame, fromFov = evaluate(previous, t, false)
			cframe = fromFrame:Lerp(cframe, b)
			fov = fromFov + (fov - fromFov) * b
		end
		fov -= zoom(t)
		if depth then
			depth.FocusDistance = (cframe.Position - him(t)).Magnitude
		end
		return cframe, fov
	end, times.Length + 0.3)
end

-- The crater, and a tornado of wind tearing up out of it, starlight
-- falling round it.
local function impact(position: Vector3)
	twinkle(position + UP * 2, 14, STAR, 0.35)
	U.flash(position + UP * 2, STAR_WHITE, 10, 0.25)
	U.shockwave(position, WIND, 3, 50, 0.6)
	U.shockwave(position, STAR, 3, 36, 0.5)
	windRing(position + UP * 0.3, UP, 2, 30, 0.55)
	windRing(position + UP * 0.6, UP, 2, 40, 0.75, STAR)
	lightRing(position + UP * 0.2, UP, 1, 34, 0.5)
	U.groundCracks(position, 14, 16, WIND, 2.5)
	U.groundRocks(position, 14, 10, 2.2)
	U.debris(position, 26, 60, 1.2)
	windColumn(position, 70, 4.5, 1.2) -- (narrow enough to stand clear of him)
	starfall(position, 18, 1.4)
	U.burst(position + UP, {
		texture = SMOKE,
		color = Color3.fromRGB(170, 178, 170),
		count = 26,
		size = 6,
		speed = NumberRange.new(20, 45),
		lifetime = NumberRange.new(0.6, 1.2),
		lightEmission = 0,
		transparency = 0.45,
		spread = 80,
		direction = UP,
		drag = 3,
	})
	U.light(position, STAR, 6, 60, 0.9)
	-- Bystanders feel it; the cutscene's own camera never shakes.
	local me = Players.LocalPlayer.Character
	local watching = me ~= nil and me:GetAttribute("Cinematic") == true
	if not watching and (workspace.CurrentCamera.CFrame.Position - position).Magnitude < 80 then
		CameraShake.Add(0.2)
	end
end

function Saint.Handle(data, character: Model, root: BasePart, context: Context)
	local phase = data.phase
	if phase == "Flick" then
		-- The star flies out ahead of him on a thread of starlight.
		context.play(character, context.anims.Conjunction)
		local hand = handOf(character, "Right") or root.Position
		local forward = root.CFrame.LookVector
		local range: number = data.range or 15
		local star = Soft.softStar(1.4)
		local from, at = worldAnchor(hand), worldAnchor(hand)
		local thread = Soft.starStream(from, at, 0.4, 6)
		twinkle(hand, 2.5, STAR, 0.2)
		windPuff(hand, 1.5, forward)
		every(0.2, function(elapsed)
			local position = hand + forward * range * (elapsed / 0.2)
			star.place(position, elapsed * 20)
			at.CFrame = CFrame.new(position)
			return true
		end, function()
			star.fade(0.15)
			fadeBeams({ thread }, 0.2, { from, at })
		end)
	elseif phase == "Whiff" then
		local at = root.Position + root.CFrame.LookVector * 15
		windPuff(at, 2)
		starDust(at, 10, 14)
	elseif phase == "Begin" then
		play(data, character, root, context)
	elseif phase == "Impact" then
		impact(data.position)
	end
end

return Saint
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="47">
              <Properties>
                <string name="Name">Sword</string>
                <string name="Source"><![CDATA[--[[
	Yuno's sword of wind (Full-Crown), in his right hand: a long leaf-shaped
	blade of wind, swelling toward the point and drawn to a long, fine tip,
	with a white-hot fuller down its middle and bright edges; a gold diamond
	set with a green gem where it leaves the guard; a crossguard of small
	gold wings (three feathers a side fanned up toward the blade, a fourth
	curling back) round a gold block set with gems; a dark wrapped grip
	with gold bands; a gold pommel tipped with a green gem. Wind flows up
	the blade and starlight glitters along it, inside a shimmer the shape
	of it.

	Laid out in the grip's space: Y up the blade, Z across it (its edges),
	X through its flats. Sword.Pieces is plain geometry; Sword.new makes the
	parts and Sword.Place moves them to the grip every frame.
]]

local Soft = require(script.Parent.Parent.Parent.Soft)

local rad = math.rad
local key = Soft.key

local WIND, WIND_WHITE = Soft.WIND, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE

local GRIP = Color3.fromRGB(22, 64, 48) -- the wrapping
local GOLD = STAR
local GEM = WIND

local Sword = {}

-- The blade: from BASE up the grip it widens from BASE_WIDTH to WIDEST at
-- SWELL, then narrows to the point at TIP.
local BASE, SWELL, TIP = 0.72, 4.6, 6.6
local BASE_WIDTH, WIDEST = 0.5, 0.86
local THICK = 0.12
local CORE = 3.5 -- the middle of the fuller

export type Piece = {
	shape: "Box" | "Wedge" | "Ball" | "Feather",
	size: Vector3,
	color: Color3,
	transparency: number,
	offset: CFrame, -- where it sits in the grip's space
	material: Enum.Material?,
	core: boolean?, -- the fuller (moves trail wind off it)
}

local PIECES: { Piece } = {}
local function add(piece: Piece)
	table.insert(PIECES, piece)
end

-- Grip, bands and pommel.
add({
	shape = "Box",
	size = Vector3.new(0.2, 1.12, 0.2),
	color = GRIP,
	transparency = 0,
	offset = CFrame.new(0, -0.06, 0),
	material = Enum.Material.Fabric,
})
for _, y in { -0.36, -0.06, 0.24 } do
	add({
		shape = "Box",
		size = Vector3.new(0.235, 0.07, 0.235),
		color = GOLD,
		transparency = 0,
		offset = CFrame.new(0, y, 0),
	})
end
add({
	shape = "Box",
	size = Vector3.new(0.27, 0.08, 0.27),
	color = GOLD,
	transparency = 0,
	offset = CFrame.new(0, -0.62, 0),
})
add({ shape = "Ball", size = Vector3.one * 0.3, color = GOLD, transparency = 0, offset = CFrame.new(0, -0.8, 0) })
add({ shape = "Ball", size = Vector3.one * 0.16, color = GEM, transparency = 0, offset = CFrame.new(0, -0.95, 0) })

-- Crossguard: a gold block with a gem in each face, and its wings.
local GUARD = 0.56
add({
	shape = "Box",
	size = Vector3.new(0.3, 0.24, 0.46),
	color = GOLD,
	transparency = 0,
	offset = CFrame.new(0, GUARD, 0),
})
for _, x in { -0.12, 0.12 } do
	add({ shape = "Ball", size = Vector3.one * 0.2, color = GEM, transparency = 0, offset = CFrame.new(x, GUARD, 0) })
end
-- Each wing: feathers out from the block, `rise` degrees up toward the blade
-- from straight out, and one curling back toward the grip.
local GUARD_FEATHERS = {
	{ rise = 10, length = 0.95, width = 0.22 },
	{ rise = 34, length = 0.76, width = 0.19 },
	{ rise = 58, length = 0.54, width = 0.16 },
	{ rise = -28, length = 0.42, width = 0.14 },
}
for _, side in { -1, 1 } do
	for _, f in GUARD_FEATHERS do
		add({
			shape = "Feather",
			-- (lying in the blade's plane: thin through its flats)
			size = Vector3.new(0.07, f.length, f.width),
			color = GOLD,
			transparency = 0,
			offset = CFrame.new(0, GUARD, side * 0.2)
				* CFrame.Angles(rad(90 - f.rise) * side, 0, 0)
				* CFrame.new(0, f.length / 2, 0),
		})
	end
end

-- Where the blade leaves the guard: a gold diamond, a gem in each face.
local DIAMOND = 0.95
add({
	shape = "Box",
	size = Vector3.new(0.17, 0.3, 0.3),
	color = GOLD,
	transparency = 0,
	offset = CFrame.new(0, DIAMOND, 0) * CFrame.Angles(rad(45), 0, 0),
})
for _, x in { -0.07, 0.07 } do
	add({ shape = "Ball", size = Vector3.one * 0.13, color = GEM, transparency = 0, offset = CFrame.new(x, DIAMOND, 0) })
end

-- The blade: a body as wide as its base, wedges widening it to the swell,
-- and two more drawing it to the point. (A wedge's slope runs from its
-- bottom front edge to its top back edge.)
local reach = SWELL - BASE
local flare = (WIDEST - BASE_WIDTH) / 2
local middle = (BASE + SWELL) / 2
add({
	shape = "Box",
	size = Vector3.new(THICK, reach, BASE_WIDTH),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, middle, 0),
})
local flareAt = BASE_WIDTH / 2 + flare / 2
add({
	shape = "Wedge",
	size = Vector3.new(THICK, reach, flare),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, middle, flareAt) * CFrame.Angles(math.pi, 0, 0),
})
add({
	shape = "Wedge",
	size = Vector3.new(THICK, reach, flare),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, middle, -flareAt) * CFrame.Angles(0, 0, math.pi),
})
local point = TIP - SWELL
add({
	shape = "Wedge",
	size = Vector3.new(THICK, point, WIDEST / 2),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, (SWELL + TIP) / 2, WIDEST / 4) * CFrame.Angles(0, math.pi, 0),
})
add({
	shape = "Wedge",
	size = Vector3.new(THICK, point, WIDEST / 2),
	color = WIND,
	transparency = 0.3,
	offset = CFrame.new(0, (SWELL + TIP) / 2, -WIDEST / 4),
})
-- A paler glow inside it, and the white-hot fuller down the middle.
add({
	shape = "Box",
	size = Vector3.new(THICK + 0.015, reach - 0.3, 0.28),
	color = WIND_WHITE,
	transparency = 0.55,
	offset = CFrame.new(0, middle + 0.15, 0),
})
add({
	shape = "Box",
	size = Vector3.new(0.15, 5.3, 0.09),
	color = WIND_WHITE,
	transparency = 0,
	offset = CFrame.new(0, CORE, 0),
	core = true,
})
-- Bright edges, along the outline.
local function edge(fromY: number, fromZ: number, toY: number, toZ: number)
	local dy, dz = toY - fromY, toZ - fromZ
	add({
		shape = "Box",
		size = Vector3.new(THICK + 0.02, math.sqrt(dy * dy + dz * dz) + 0.03, 0.05),
		color = WIND_WHITE,
		transparency = 0.1,
		offset = CFrame.new(0, (fromY + toY) / 2, (fromZ + toZ) / 2) * CFrame.Angles(math.atan2(dz, dy), 0, 0),
	})
end
for _, side in { -1, 1 } do
	edge(BASE, side * BASE_WIDTH / 2, SWELL, side * WIDEST / 2)
	edge(SWELL, side * WIDEST / 2, TIP, 0)
end
-- The shimmer round it.
add({
	shape = "Feather",
	size = Vector3.new(0.42, TIP - BASE + 0.6, WIDEST + 0.45),
	color = WIND,
	transparency = 0,
	offset = CFrame.new(0, (BASE + TIP) / 2 + 0.1, 0),
	material = Enum.Material.ForceField,
})

function Sword.Pieces(): { Piece }
	return PIECES
end

---------------------------------------------------------------------------
-- The parts
---------------------------------------------------------------------------

-- Makes a part (fading in with the rest of his look): props, its
-- transparency once in, and whether it's a wedge.
export type Maker = (props: { [string]: any }, base: number, wedge: boolean?) -> BasePart

export type Sword = {
	parts: { BasePart },
	frames: { CFrame },
	blade: BasePart, -- the fuller (moves trail wind off it)
	beams: { Beam },
	emitters: { ParticleEmitter },
}

function Sword.new(make: Maker): Sword
	local parts: { BasePart } = {}
	local blade: BasePart? = nil
	for _, piece in PIECES do
		local props: { [string]: any } = {
			Size = piece.size,
			Color = piece.color,
		}
		if piece.shape == "Ball" then
			props.Shape = Enum.PartType.Ball
		end
		if piece.material then
			props.Material = piece.material
		end
		local part = make(props, piece.transparency, piece.shape == "Wedge")
		if piece.shape == "Feather" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		if piece.core then
			blade = part
		end
		table.insert(parts, part)
	end
	assert(blade, "the sword has no fuller")

	-- Wind flowing up the blade, starlight glittering along its edge, and a
	-- glint at the point now and then.
	local low = Instance.new("Attachment")
	low.Position = Vector3.new(0, -2.6, 0)
	low.Parent = blade
	local high = Instance.new("Attachment")
	high.Position = Vector3.new(0, 2.8, 0)
	high.Parent = blade
	local beams = {
		Soft.softBeam(low, high, {
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.5,
			width1 = 0.7,
			transparency = NumberSequence.new({ key(0, 0.86), key(0.3, 0.64), key(1, 0.82) }),
			texture = Soft.SMOKE,
			speed = 2.5,
			length = 3,
		}, blade),
		Soft.softBeam(low, high, {
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.5,
			width1 = 0.28,
			transparency = NumberSequence.new({ key(0, 0.75), key(0.5, 0.45), key(1, 0.7) }),
			texture = Soft.SPARKLE,
			wrap = true,
			length = 0.8,
			speed = 1.5,
		}, blade),
	}
	for _, beam in beams do
		beam.Enabled = false
	end
	local point = Instance.new("Attachment")
	point.Position = Vector3.new(0, TIP - CORE - 0.15, 0)
	point.Parent = blade
	local glint = Soft.windEmitter(point, {
		Texture = Soft.SPARKLE,
		Color = ColorSequence.new(STAR_WHITE),
		LightEmission = 1,
		Size = NumberSequence.new({ key(0, 0), key(0.3, 0.9), key(1, 0) }),
		Transparency = NumberSequence.new({ key(0, 0.1), key(1, 0.6) }),
		Lifetime = NumberRange.new(0.25, 0.35),
		Speed = NumberRange.new(0),
		RotSpeed = NumberRange.new(-90, 90),
		LockedToPart = true,
		Rate = 1.5,
	})

	return {
		parts = parts,
		frames = table.create(#parts, CFrame.identity),
		blade = blade,
		beams = beams,
		emitters = { glint },
	}
end

-- Moves the sword to his grip (Y up the blade, Z across it).
function Sword.Place(sword: Sword, grip: CFrame)
	for i, piece in PIECES do
		sword.frames[i] = grip * piece.offset
	end
	workspace:BulkMoveTo(sword.parts, sword.frames, Enum.BulkMoveMode.FireCFrameChanged)
end

return Sword
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="48">
              <Properties>
                <string name="Name">Waltz</string>
                <string name="Source"><![CDATA[--[[
	Prince of Wind (Yuno): Spirit of Zephyrus (Full-Crown 2), the waltz of
	the west wind, drawn. The paths are Shared/Zephyrus (the server holds
	them both on them); this draws it, about 1.3 seconds from the catch:

	  the catch  his lunge runs into them: a ring of wind bursts off them
	             and the wind lifts them off their feet.
	  the waltz  he whirls round them twice at a blur, a ring of his ghosts
	             left behind him all the way round, wind spiralling up round
	             them; every half turn a cut, his long sword of wind through
	             them, each cut left hanging in the air round them.
	  the spear  he swings out in front of them, draws back (the wind pours
	             into his sword), and runs them through: the sword shoots out
	             into a spear of wind thirty studs long, spiralling, rings of
	             wind racing down it; every hanging cut bursts at once and
	             they're blown away trailing wind.

	Everything is see-through wind and light. The camera (for the two of
	them) circles the other way round them, low, so the waltz sweeps past
	it, and comes round behind him for the spear. No shake: eased zooms.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local WaltzPlan = require(ReplicatedStorage:WaitForChild("Shared").Zephyrus)
local Cinematic = require(script.Parent.Parent.Parent.Cinematic)
local PoseAnimator = require(script.Parent.Parent.Parent.PoseAnimator)
local Reactions = require(script.Parent.Parent.Parent.Reactions)
local Soft = require(script.Parent.Parent.Parent.Soft)

local U = Soft.U
local rad = math.rad
local UP = Vector3.yAxis
local key = Soft.key

local WIND, WIND_WHITE = Soft.WIND, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE = Soft.SMOKE

type Animation = PoseAnimator.Animation
type Sword = { hold: (number) -> (), point: () -> Vector3 }

-- What the kit lends this module.
export type Context = {
	anims: { [string]: Animation },
	play: (Model, Animation) -> (),
	sword: (Model) -> Sword?, -- his long sword of wind, out since the lunge
}

local Waltz = {}

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

-- Draws it (t = 0 now). Returns stop(), which cuts it short.
function Waltz.Play(ctx: Context, data, character: Model, root: BasePart): (() -> ())?
	if typeof(data.attacker) ~= "Vector3" or typeof(data.victim) ~= "Vector3" then
		return nil
	end
	local times = WaltzPlan.Times
	local plan = WaltzPlan.Plan(data.attacker, data.victim)
	local victim: Model? = if typeof(data.target) == "Instance" and data.target:IsA("Model") then data.target else nil
	local victimRoot = U.getRoot(victim)
	local mine = U.isLocal(character) or U.isLocal(victim)
	local started = os.clock()
	local finished = false
	local through = -plan.out -- the way the spear goes

	local function at(time: number, fn: () -> ())
		task.delay(math.max(time - (os.clock() - started), 0), function()
			if not finished and character.Parent then
				fn()
			end
		end)
	end
	local function them(t: number): Vector3
		return WaltzPlan.Victim(plan, math.min(t, times.Thrust)).Position
	end

	-- Both of them on the paths.
	local bind = "CloverZephyrWaltz" .. tostring(started)
	local stop: () -> ()
	function stop()
		if finished then
			return
		end
		finished = true
		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)
	end
	RunService:BindToRenderStep(bind, Enum.RenderPriority.Camera.Value + 3, function()
		local t = os.clock() - started
		if t > times.Length then
			stop()
			return
		end
		if root.Parent then
			root.CFrame = WaltzPlan.Attacker(plan, t)
		end
		if victimRoot and victimRoot.Parent and t <= times.Thrust then
			victimRoot.CFrame = WaltzPlan.Victim(plan, t)
		end
	end)
	task.delay(times.Length + 0.5, stop)
	local sword = ctx.sword(character)
	if sword then
		sword.hold(times.Length + 0.2)
	end

	-- The catch: a ring of wind off them, and the wind lifts them.
	local center = plan.center
	Soft.windRing(center, plan.out, 1, 8, 0.3)
	Soft.lightRing(center, plan.out, 0.5, 6, 0.25, WIND_WHITE)
	Soft.twinkle(center, 5, WIND, 0.25)
	Soft.windPuff(center, 3, through)
	U.flash(center, WIND_WHITE, 3, 0.1)
	if victim then
		U.highlight(victim, WIND_WHITE, 0.1, 0.6)
		-- Swept off their feet: flailing in the wind.
		local flail = Reactions.Launched
		if flail then
			PoseAnimator.Play(victim, flail)
		end
	end

	-- The wind round them while he whirls: two rings of wind turning with
	-- him, ribbons spiralling up round them, a ring of light under them.
	local rings = {
		Soft.softRing({
			color = ColorSequence.new(WIND_WHITE, WIND),
			width0 = 1.6,
			width1 = 1.6,
			transparency = NumberSequence.new(0.55),
			texture = SMOKE,
			speed = 6,
			length = 5,
		}),
		Soft.softRing({
			color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
			width0 = 0.3,
			width1 = 0.3,
			transparency = NumberSequence.new(0.45),
		}),
	}
	local stopHelix = Soft.helix(function()
		local foot = them(os.clock() - started) - UP * 3
		return foot, foot + UP * 8
	end, 3.6, 3, 0.5, 1.5, 0.9, times.Out + 0.15, WIND)
	Soft.every(times.Out + 0.15, function(elapsed)
		local spin = WaltzPlan.Attacker(plan, math.min(elapsed, times.Out))
		local heart = them(elapsed)
		local grow = smooth(elapsed / 0.15)
		local turn = math.atan2(spin.Position.Z - heart.Z, spin.Position.X - heart.X)
		rings[1].set(CFrame.new(heart) * CFrame.Angles(0, -turn, 0), WaltzPlan.Radius * grow + 0.05)
		rings[2].set(CFrame.new(heart - UP * 2.4) * CFrame.Angles(0, turn, 0), (WaltzPlan.Radius + 0.8) * grow + 0.05)
		return true
	end, function()
		for _, ring in rings do
			ring.fade(0.25)
		end
		stopHelix()
	end)

	-- Whirling round them: his ghosts left behind him all the way round, and
	-- the wind he trails painting the circle.
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if torso then
		local wake = Soft.trail(torso, Vector3.new(0, 1.4, 0), Vector3.new(0, -1.4, 0), {
			color = ColorSequence.new(WIND_WHITE, WIND),
			transparency = NumberSequence.new({ key(0, 0.4), key(1, 1) }),
			width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
			lifetime = 0.45,
			texture = SMOKE,
		})
		task.delay(times.Out + 0.05, Soft.endTrail, wake)
	end
	for i = 0, 17 do
		at(0.06 + i * 0.045, function()
			U.afterimage(character, WIND, 0.4)
		end)
	end

	-- Each cut: his sword through them, the cut left hanging round them.
	local slashes: { Soft.Slash } = {}
	for i, when in times.Cuts do
		at(when - 0.05, function()
			ctx.play(character, if i % 2 == 1 then ctx.anims.SaintCut else ctx.anims.SaintCutBack)
		end)
		at(when, function()
			local heart = them(when)
			local him = WaltzPlan.Attacker(plan, when)
			local across = UP:Cross((heart - him.Position).Unit)
			across = if across.Magnitude > 1e-3 then across.Unit else plan.side
			local tilt = UP * (if i % 2 == 1 then 1.4 else -1.4)
			local slash = Soft.windSlash(
				heart + across * 4 + tilt,
				heart - across * 4 - tilt,
				(heart - him.Position).Unit * 1.2 + UP * 0.3,
				0.8
			)
			table.insert(slashes, slash)
			Soft.twinkle(heart, 3, WIND, 0.18)
			Soft.lightRing(heart, across, 0.4, 4.5, 0.2, WIND_WHITE)
			Soft.windPuff(heart, 2, across)
			U.burst(heart, {
				color = WIND_WHITE,
				count = 8,
				size = 0.4,
				speed = NumberRange.new(24, 50),
				lifetime = NumberRange.new(0.1, 0.25),
				streaks = true,
				spread = 40,
				direction = across,
			})
			if victim then
				U.highlight(victim, WIND_WHITE, 0.08, 0.6)
			end
		end)
	end

	-- Out in front of them, drawn back: the wind pours into his sword.
	at(times.Out - 0.06, function()
		ctx.play(character, ctx.anims.ZephyrusDraw)
		for i = 0, 6 do
			task.delay(i * 0.015, function()
				local current = ctx.sword(character)
				if current then
					Soft.inflow(current.point(), 4, WIND_WHITE)
				end
			end)
		end
		Soft.twinkle(root.Position, 4, STAR, 0.2)
	end)
	at(times.Thrust - 0.07, function()
		ctx.play(character, ctx.anims.ZephyrusSkewer)
	end)

	-- The spear: his sword shoots out through them and blows them away.
	at(times.Thrust, function()
		local hand = WaltzPlan.Attacker(plan, times.Thrust).Position + UP * 0.3
		local heart = them(times.Thrust)
		local tip = heart + through * 26
		local a, b = Soft.worldAnchor(hand, through), Soft.worldAnchor(hand, through)
		local spear = {
			Soft.softBeam(a, b, {
				color = ColorSequence.new(STAR_WHITE, WIND_WHITE),
				width0 = 1.1,
				width1 = 0.15,
				transparency = NumberSequence.new({ key(0, 0.1), key(1, 0.6) }),
			}),
			Soft.softBeam(a, b, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 5,
				width1 = 1.4,
				transparency = NumberSequence.new({ key(0, 0.55), key(1, 0.92) }),
				texture = SMOKE,
				speed = 14,
				length = 10,
			}),
		}
		table.insert(spear, Soft.starStream(a, b, 0.7, 16))
		-- It shoots out, then fades.
		Soft.every(0.07, function(elapsed)
			Soft.aim(b, hand:Lerp(tip, smooth(elapsed / 0.07)), through)
			return true
		end, function()
			Soft.aim(b, tip, through)
			task.delay(0.12, Soft.fadeBeams, spear, 0.32, { a, b })
		end)
		local stopSpiral = Soft.helix(function()
			return hand, tip
		end, 1.4, 4, 0.3, 3, 0.5, 0.4, WIND_WHITE)
		task.delay(0.4, stopSpiral)
		-- Rings of wind racing down it.
		for i = 1, 6 do
			task.delay(i * 0.025, function()
				local ring = hand + through * (2 + i * 4)
				Soft.windRing(ring, through, 0.6, 3 + i * 0.8, 0.3)
				Soft.lightRing(ring, through, 0.5, 2.5 + i * 0.7, 0.25, WIND_WHITE)
			end)
		end
		-- Where it goes through them: the air bursts, every cut bursts.
		U.flash(heart, STAR_WHITE, 5, 0.12)
		Soft.twinkle(heart, 9, STAR, 0.3)
		Soft.windRing(heart, through, 1, 12, 0.35)
		U.shockwave(heart, WIND, 1, 14, 0.3)
		Soft.windPuff(heart + through * 2, 4, through)
		Soft.streaks(heart + through, 18, 95, through, 25)
		for i, slash in slashes do
			task.delay(0.02 * i, function()
				slash.flare()
				slash.fade(0.22)
				Soft.twinkle(slash.apex, 3, WIND, 0.2)
			end)
		end
		if victimRoot and victimRoot.Parent then
			local comet = Soft.trail(victimRoot, Vector3.new(0, 1.2, 0), Vector3.new(0, -1.2, 0), {
				color = ColorSequence.new(WIND_WHITE, WIND),
				transparency = NumberSequence.new({ key(0, 0.35), key(1, 1) }),
				width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
				lifetime = 0.35,
				texture = SMOKE,
			})
			task.delay(0.7, Soft.endTrail, comet)
		end
		if mine then
			Soft.focusLines(0.3)
		end
	end)

	if mine then
		local release = Waltz.Camera(plan)
		local stopDrawing = stop
		stop = function()
			stopDrawing()
			release()
		end
	end
	return stop
end

--[[
	The camera: low, a little way out, going round them the other way to
	him (so the waltz sweeps past it, fast), then round behind his shoulder
	for the spear, watching them blown away. Each cut and the spear is an
	eased zoom in and out; nothing shakes.
]]
function Waltz.Camera(plan: WaltzPlan.Plan): () -> ()
	local times = WaltzPlan.Times
	local function them(t: number): Vector3
		return WaltzPlan.Victim(plan, math.min(t, times.Thrust)).Position
	end
	local function blow(t: number, at: number, amount: number): number
		if t < at then
			return 0
		end
		local u = (t - at) / 0.07
		return amount * u * math.exp(1 - u)
	end
	return Cinematic.Camera(function(elapsed)
		local t = math.min(elapsed, times.Length)
		-- From beside his shoulder, round the other way to him...
		local counter = rad(-40) - rad(40) * smooth(t / times.Out)
		-- ...then on round behind him for the spear.
		local behind = smooth((t - (times.Out - 0.35)) / 0.45)
		local angle = counter + (rad(18) - counter) * behind
		local radial = plan.out * math.cos(angle) + plan.side * math.sin(angle)
		local heart = them(t)
		local eye = heart + radial * (11 + 3 * behind) + UP * (0.6 + 1.6 * behind)
		local follow = smooth((t - times.Thrust) / 0.25)
		local focus = heart:Lerp(heart - plan.out * 8, follow) + UP * 0.4
		local fov = 72 - 4 * behind
		for _, cut in times.Cuts do
			fov -= blow(t, cut, 3)
		end
		fov -= blow(t, times.Thrust, 9)
		return CFrame.lookAt(eye, focus) * CFrame.Angles(0, 0, rad(3 - 5 * behind)), fov
	end, times.Length + 0.05)
end

return Waltz
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="49">
              <Properties>
                <string name="Name">Wings</string>
                <string name="Source"><![CDATA[--[[
	Yuno's wings of wind, worn while he's awakened (Half-Crown: the one on
	his left; Full-Crown: both). Built like a bird's wing: three bones out of
	his shoulder blade (the upper arm rising steeply, the forearm out to the
	wrist at the top of the arch, the hand out and down to the tip) with
	every feather where a bird's would be:

	  primaries    the long flight feathers off the hand, fanned round to
	               the tip and splaying apart there like fingers
	  secondaries  off the forearm, hanging in a scalloped trailing edge
	  tertials     off the upper arm, closing the gap back to his body
	  coverts      three rows of shorter feathers layered over their roots,
	               up to the leading edge (the bones, glowing)
	  scapulars    over his shoulder blade, where the wing meets his back

	All of it see-through wind, white quills down the flight feathers.

	It beats slowly while he hovers: down and forward, then up and back,
	the beat rolling out along the wing (the elbow after the shoulder, the
	wrist after the elbow) with the feathers bending against the air and
	rippling. When he moves it sweeps back into a glide, beating shallow and
	quick. Wind streams off the wingtip as it moves and starlight drifts off
	its edge.

	Wings.Pieces and Wings.Pose are plain geometry (where every piece goes);
	Wings.new makes the parts and poses them every frame.
]]

local Soft = require(script.Parent.Parent.Parent.Soft)

local rad = math.rad
local key = Soft.key

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE

local Wings = {}

-- How big the whole wing is, and its bones: the upper arm, the forearm and
-- the hand.
local SCALE = 0.92
local BONES = { 1.3 * SCALE, 1.8 * SCALE, 1.4 * SCALE }

-- Where the wing grows from (his shoulder blade, his right; mirrored for
-- his left), in his torso's space.
local ROOT = Vector3.new(0.45, 0.55, 0.65)

--[[
	How the wing is held (degrees), eased between hovering and gliding:
	  lift   the upper arm's rise from straight out to his side
	  elbow  the forearm's bend at the elbow (down from the upper arm)
	  wrist  the hand's bend at the wrist (down from the forearm)
	  sweep  how far the whole wing is swept back behind him
	  twist  how far it's turned about the upper arm, trailing edge back
	         (gliding, it lies back nearly flat on the air, its top to the
	         sky, and the elbow and wrist bends fold it back in its plane,
	         like a falcon's)
	  beat   how deep it beats, `rate` beats a second
]]
export type Hold = {
	lift: number,
	elbow: number,
	wrist: number,
	sweep: number,
	twist: number,
	beat: number,
	rate: number,
}

Wings.Hover = { lift = 68, elbow = -20, wrist = -44, sweep = 24, twist = 8, beat = 1, rate = 0.4 } :: Hold
Wings.Glide = { lift = 22, elbow = -12, wrist = -30, sweep = 30, twist = 72, beat = 0.35, rate = 0.8 } :: Hold

function Wings.Blend(a: Hold, b: Hold, k: number): Hold
	return {
		lift = a.lift + (b.lift - a.lift) * k,
		elbow = a.elbow + (b.elbow - a.elbow) * k,
		wrist = a.wrist + (b.wrist - a.wrist) * k,
		sweep = a.sweep + (b.sweep - a.sweep) * k,
		twist = a.twist + (b.twist - a.twist) * k,
		beat = a.beat + (b.beat - a.beat) * k,
		rate = a.rate + (b.rate - a.rate) * k,
	}
end

--[[
	The feathers. Each sits on a bone (1 the upper arm, 2 the forearm, 3 the
	hand), `at` of the way along it, or on his back where the wing grows
	from (bone 4, `at` in studs out from there), and hangs off it `angle`
	degrees round from straight off its trailing side toward its end.
	`layer` is how far over the flight feathers it lies (the coverts over
	their roots), `drop` how far below the bone its root is.
]]
type Feather = {
	bone: number,
	at: number,
	angle: number,
	length: number,
	width: number,
	layer: number,
	drop: number,
	color: Color3,
	transparency: number,
	quill: boolean,
	flex: number, -- how far it bends against the air as the wing beats
	trail: boolean, -- wind streams off its tip
}

local FEATHERS: { Feather } = {}
local function row(style: { [string]: any }, list: { { number } })
	for i, f in list do
		table.insert(FEATHERS, {
			bone = f[1],
			at = f[2],
			angle = f[3],
			length = f[4] * SCALE,
			width = f[5] * SCALE,
			-- (a hair apart, so neighbours never lie flat in each other)
			layer = style.layer + i * 0.006,
			drop = style.drop,
			color = style.color,
			transparency = style.transparency,
			quill = style.quill == true,
			flex = style.flex,
			trail = style.trail == true and i >= #list - 2,
		})
	end
end

-- Tertials: off the upper arm by the elbow, hanging down toward his back.
row({ layer = 0, drop = 0.1, color = WIND:Lerp(WIND_DEEP, 0.25), transparency = 0.56, quill = true, flex = 0.6 }, {
	{ 1, 0.48, -75, 1.4, 0.48 },
	{ 1, 0.7, -72, 1.62, 0.5 },
	{ 1, 0.92, -68, 1.8, 0.52 },
})
-- Secondaries: along the forearm, the trailing edge.
row({ layer = 0.03, drop = 0.1, color = WIND, transparency = 0.56, quill = true, flex = 0.8 }, {
	{ 2, 0.06, -46, 1.95, 0.54 },
	{ 2, 0.21, -42, 2.02, 0.54 },
	{ 2, 0.36, -38, 2.07, 0.54 },
	{ 2, 0.51, -34, 2.1, 0.54 },
	{ 2, 0.66, -30, 2.12, 0.54 },
	{ 2, 0.81, -26, 2.14, 0.54 },
	{ 2, 0.95, -22, 2.16, 0.54 },
})
-- Primaries: off the hand, fanned round from trailing to the tip, the
-- longest near the tip and the outermost splaying apart.
row({
	layer = 0.07,
	drop = 0.08,
	color = WIND:Lerp(WIND_WHITE, 0.15),
	transparency = 0.54,
	quill = true,
	flex = 1,
	trail = true,
}, {
	{ 3, 0, 26, 2.3, 0.54 },
	{ 3, 0.14, 34, 2.48, 0.53 },
	{ 3, 0.28, 42, 2.64, 0.52 },
	{ 3, 0.42, 50, 2.8, 0.5 },
	{ 3, 0.56, 58, 2.92, 0.48 },
	{ 3, 0.7, 67, 3, 0.46 },
	{ 3, 0.82, 76, 2.94, 0.43 },
	{ 3, 0.92, 86, 2.75, 0.4 },
	{ 3, 1, 96, 2.4, 0.36 },
})
-- Greater coverts: over the roots of the secondaries and the inner primaries.
row({ layer = 0.16, drop = 0.04, color = WIND:Lerp(WIND_WHITE, 0.25), transparency = 0.54, flex = 0.4 }, {
	{ 2, 0.08, -42, 1.05, 0.48 },
	{ 2, 0.3, -36, 1.1, 0.48 },
	{ 2, 0.52, -30, 1.12, 0.48 },
	{ 2, 0.74, -24, 1.14, 0.48 },
	{ 2, 0.95, -18, 1.16, 0.48 },
	{ 3, 0.08, 32, 1.22, 0.46 },
	{ 3, 0.3, 44, 1.26, 0.44 },
	{ 3, 0.52, 56, 1.24, 0.42 },
	{ 3, 0.74, 68, 1.16, 0.4 },
})
-- Median coverts: a shorter row over those.
row({ layer = 0.24, drop = 0, color = WIND:Lerp(WIND_WHITE, 0.35), transparency = 0.52, flex = 0.2 }, {
	{ 1, 0.55, -62, 0.7, 0.38 },
	{ 1, 0.95, -48, 0.72, 0.4 },
	{ 2, 0.25, -34, 0.72, 0.4 },
	{ 2, 0.55, -26, 0.72, 0.4 },
	{ 2, 0.85, -18, 0.72, 0.4 },
	{ 3, 0.2, 30, 0.72, 0.38 },
	{ 3, 0.5, 46, 0.7, 0.36 },
	{ 3, 0.8, 62, 0.62, 0.32 },
})
-- Lesser coverts: small and close-set along the leading edge.
row({ layer = 0.32, drop = -0.06, color = WIND:Lerp(WIND_WHITE, 0.5), transparency = 0.48, flex = 0 }, {
	{ 1, 0.2, -70, 0.46, 0.3 },
	{ 1, 0.55, -58, 0.46, 0.3 },
	{ 1, 0.9, -46, 0.46, 0.3 },
	{ 2, 0.15, -30, 0.46, 0.3 },
	{ 2, 0.45, -20, 0.46, 0.3 },
	{ 2, 0.75, -10, 0.46, 0.3 },
	{ 3, 0.1, 20, 0.44, 0.28 },
	{ 3, 0.45, 40, 0.4, 0.26 },
	{ 3, 0.8, 60, 0.36, 0.24 },
})
-- Scapulars: over his shoulder blade, hanging down his back (they're his,
-- not the wing's: they stay put as it sweeps).
row({ layer = 0.12, drop = 0, color = WIND:Lerp(WIND_WHITE, 0.2), transparency = 0.56, flex = 0.3 }, {
	{ 4, 0, -14, 1.2, 0.44 },
	{ 4, 0.16, -6, 1.05, 0.42 },
})

-- One piece of a wing: a feather (a flat ellipsoid), a quill, a bone or a
-- joint, with how it looks.
export type Piece = {
	shape: "Feather" | "Box" | "Ball",
	size: Vector3,
	color: Color3,
	transparency: number,
}

-- Everything one wing is made of, in the order Pose places it: each
-- feather (then its quill, if it has one), the three bones, the elbow, the
-- wrist and the root.
local PIECES: { Piece } = {}
for _, f in FEATHERS do
	table.insert(PIECES, {
		shape = "Feather",
		size = Vector3.new(f.width, f.length, 0.05),
		color = f.color,
		transparency = f.transparency,
	})
	if f.quill then
		table.insert(PIECES, {
			shape = "Box",
			size = Vector3.new(0.05, f.length * 0.86, 0.08),
			color = WIND_WHITE,
			transparency = 0.3,
		})
	end
end
local BONE_WIDTH = { 0.2, 0.16, 0.12 }
for i, length in BONES do
	table.insert(PIECES, {
		shape = "Box",
		size = Vector3.new(length + BONE_WIDTH[i] * 0.5, BONE_WIDTH[i], BONE_WIDTH[i]),
		color = WIND_WHITE,
		transparency = 0.18,
	})
end
table.insert(PIECES, { shape = "Ball", size = Vector3.one * 0.26, color = WIND_WHITE, transparency = 0.15 })
table.insert(PIECES, { shape = "Ball", size = Vector3.one * 0.22, color = WIND_WHITE, transparency = 0.1 })
table.insert(PIECES, { shape = "Ball", size = Vector3.one * 0.36, color = WIND, transparency = 0.35 })

function Wings.Pieces(): { Piece }
	return PIECES
end

-- Fixed offsets, worked out once for each side: where the wing grows from,
-- each bone's end (and middle) along the one before it, and each feather's
-- root on its bone. Then, for every feather, where its middle and its
-- quill's sit down it.
type Offsets = { root: CFrame, bones: { CFrame }, middles: { CFrame }, feathers: { CFrame } }
local OFFSETS: { [number]: Offsets } = {}
for _, side in { -1, 1 } do
	local offsets: Offsets = {
		root = CFrame.new(ROOT.X * side, ROOT.Y, ROOT.Z),
		bones = {},
		middles = {},
		feathers = {},
	}
	for i, length in BONES do
		offsets.bones[i] = CFrame.new(length * side, 0, 0)
		offsets.middles[i] = CFrame.new(length / 2 * side, 0, 0.12)
	end
	for i, f in FEATHERS do
		local along = if f.bone == 4 then f.at else BONES[f.bone] * f.at
		offsets.feathers[i] = CFrame.new(along * side, -f.drop, f.layer)
	end
	OFFSETS[side] = offsets
end
local HANGS: { CFrame } = {}
local QUILLS: { CFrame } = {}
for i, f in FEATHERS do
	HANGS[i] = CFrame.new(0, -f.length / 2, 0)
	QUILLS[i] = CFrame.new(0, -f.length * 0.47, 0.01)
end
local JOINT = CFrame.new(0, 0, 0.12)
local SHOULDER_GLOW = CFrame.new(0, 0, 0.05)

-- The shoulder, elbow and wrist (each frame with its bone running out
-- along X: +X on his right, -X on his left, mirrored) at beat `phase`.
function Wings.Bones(torso: CFrame, side: number, hold: Hold, phase: number): (CFrame, CFrame, CFrame)
	local offsets = OFFSETS[side]
	local beat = hold.beat
	-- Down and forward, then up and back: the stroke rolling out along it.
	local lift = hold.lift + 10 * beat * math.sin(phase)
	local sweep = hold.sweep + 12 * beat * math.sin(phase - 0.5)
	local elbow = hold.elbow + 7 * beat * math.sin(phase - 0.9)
	local wrist = hold.wrist + 11 * beat * math.sin(phase - 1.6)
	local shoulder = torso
		* offsets.root
		* CFrame.Angles(0, rad(-sweep) * side, rad(lift) * side)
		* CFrame.Angles(rad(-hold.twist), 0, 0)
	local elbowFrame = shoulder * offsets.bones[1] * CFrame.Angles(0, 0, rad(elbow) * side)
	-- (the hand angled back a little, so the tip trails)
	local wristFrame = elbowFrame * offsets.bones[2] * CFrame.Angles(0, rad(-10) * side, rad(wrist) * side)
	return shoulder, elbowFrame, wristFrame
end

--[[
	Fills `frames` with where every piece goes (in Pieces' order) for the
	wing on `side` (-1 his left, 1 his right) of a torso at `torso`.
	`phase` is how far through its beat it is (radians), `flutter` how hard
	the air's rushing past (0 hovering, 1 gliding fast), `t` the time.
]]
function Wings.Pose(
	frames: { CFrame },
	torso: CFrame,
	side: number,
	hold: Hold,
	phase: number,
	flutter: number,
	t: number
)
	local offsets = OFFSETS[side]
	local shoulder, elbow, wrist = Wings.Bones(torso, side, hold, phase)
	local bones = { shoulder, elbow, wrist, torso * offsets.root }
	-- The feathers bend against the stroke (with the sweep's speed, a
	-- little after it): their tips trail as it sweeps forward or back, and
	-- back in the wind as he glides.
	local bend = 10 * hold.beat * math.cos(phase - 0.9) - flutter * 4
	local n = 0
	for i, f in FEATHERS do
		local ripple = 2.5 * math.sin(t * 2.3 - i * 0.55) + flutter * 2 * math.sin(t * 15 - i * 1.3)
		local joint = bones[f.bone]
			* offsets.feathers[i]
			* CFrame.Angles(rad(bend * f.flex), 0, rad(f.angle + ripple * f.flex) * side)
		n += 1
		frames[n] = joint * HANGS[i]
		if f.quill then
			n += 1
			frames[n] = joint * QUILLS[i]
		end
	end
	for i = 1, 3 do
		n += 1
		frames[n] = bones[i] * offsets.middles[i]
	end
	n += 1
	frames[n] = elbow * JOINT
	n += 1
	frames[n] = wrist * JOINT
	n += 1
	frames[n] = shoulder * SHOULDER_GLOW
end

---------------------------------------------------------------------------
-- The parts
---------------------------------------------------------------------------

-- Makes a part (fading in with the rest of his look): props, its
-- transparency once in, and whether it's a wedge.
export type Maker = (props: { [string]: any }, base: number, wedge: boolean?) -> BasePart

export type Wing = {
	parts: { BasePart },
	frames: { CFrame },
	trails: { Trail },
	emitters: { ParticleEmitter },
	beams: { Beam },
	side: number,
}

function Wings.new(make: Maker, side: number): Wing
	local parts: { BasePart } = {}
	for _, piece in PIECES do
		local part = make({
			Shape = if piece.shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block,
			Size = piece.size,
			Color = piece.color,
		}, piece.transparency)
		if piece.shape == "Feather" then
			-- (a flat ellipsoid: the feather's outline, round-tipped)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		table.insert(parts, part)
	end
	local frames = table.create(#parts, CFrame.identity)

	-- Wind streaming off the outer primaries' tips as it moves, wisps of
	-- wind off the outermost, and starlight drifting off the hand.
	local trails: { Trail } = {}
	local emitters: { ParticleEmitter } = {}
	local n = 0
	for _, f in FEATHERS do
		n += 1
		local vane = parts[n]
		if f.trail then
			local tip = -f.length / 2
			table.insert(
				trails,
				Soft.trail(vane, Vector3.new(0, tip + 0.55, 0), Vector3.new(0, tip + 0.05, 0), {
					color = ColorSequence.new(WIND_WHITE, WIND),
					transparency = NumberSequence.new({ key(0, 0.5), key(1, 1) }),
					width = NumberSequence.new({ key(0, 1), key(1, 0.15) }),
					lifetime = 0.35,
					off = true,
				})
			)
			local wisp = Soft.windEmitter(vane, {
				Color = ColorSequence.new(WIND_WHITE, WIND),
				LightEmission = 1,
				Size = NumberSequence.new({ key(0, 0.35), key(1, 0) }),
				Transparency = NumberSequence.new({ key(0, 1), key(0.2, 0.55), key(1, 1) }),
				Lifetime = NumberRange.new(0.3, 0.55),
				Speed = NumberRange.new(0.4, 1),
				Rate = 6,
			})
			table.insert(emitters, wisp)
		end
		if f.quill then
			n += 1
		end
	end
	local hand = parts[n + 3]
	table.insert(
		emitters,
		Soft.windEmitter(hand, {
			Texture = Soft.SPARKLE,
			Color = ColorSequence.new(STAR_WHITE, STAR),
			LightEmission = 1,
			Size = NumberSequence.new({ key(0, 0.22), key(1, 0) }),
			Transparency = NumberSequence.new({ key(0, 0.2), key(1, 1) }),
			Lifetime = NumberRange.new(0.6, 1.1),
			Speed = NumberRange.new(0.3, 1),
			Acceleration = Vector3.new(0, -1.5, 0),
			Shape = Enum.ParticleEmitterShape.Box,
			Rate = 5,
		})
	)

	-- Wind flowing out along the leading edge, bone by bone.
	local beams: { Beam } = {}
	for i = 1, 3 do
		local bone = parts[n + i]
		local half = bone.Size.X / 2
		local from = Instance.new("Attachment")
		from.Position = Vector3.new(-half * side, 0, 0)
		from.Parent = bone
		local to = Instance.new("Attachment")
		to.Position = Vector3.new(half * side, 0, 0)
		to.Parent = bone
		table.insert(
			beams,
			Soft.softBeam(from, to, {
				color = ColorSequence.new(WIND_WHITE, WIND),
				width0 = 0.7 - i * 0.12,
				width1 = 0.6 - i * 0.12,
				transparency = NumberSequence.new({ key(0, 0.8), key(0.5, 0.66), key(1, 0.8) }),
				texture = Soft.SMOKE,
				speed = 1.6,
				length = 1.5,
			}, bone)
		)
	end

	return { parts = parts, frames = frames, trails = trails, emitters = emitters, beams = beams, side = side }
end

-- Poses a wing (see Pose) and moves its parts there.
function Wings.Place(wing: Wing, torso: CFrame, hold: Hold, phase: number, flutter: number, t: number)
	Wings.Pose(wing.frames, torso, wing.side, hold, phase, flutter, t)
	workspace:BulkMoveTo(wing.parts, wing.frames, Enum.BulkMoveMode.FireCFrameChanged)
end

return Wings
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">M1Animations</string>
            <string name="Source"><![CDATA[--[[
	M1Animations
	R6 punch/kick animations for the M1 string, built for PoseAnimator.

	The string is: right jab, left cross, right hook, then a finisher:
	  Knockback  spinning front kick
	  Uppercut   rising right uppercut (jump held)
	  Downslam   double-fist hammer (in the air)

	Timing lines up with the server: normal hits land ~0.08s after input
	(Config.M1.WindUp), finishers ~0.15s (Config.M1.FinisherWindUp).
	The "Strike" event is when the limb starts moving fast (trails turn on).
]]

local PoseAnimator = require(script.Parent.PoseAnimator)

type Animation = PoseAnimator.Animation

local rad = math.rad

-- Torso / head / leg rotation. x leans back (+) or forward (-), y twists left (+).
local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

-- Arm/leg aim. pitch raises the limb forward (90 = straight ahead, 180 = up),
-- yaw swings it horizontally (+ = toward the left), roll swings it out sideways
-- (+ = to the right).
local function limb(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, rad(yaw or 0), 0) * CFrame.Angles(0, 0, rad(roll or 0)) * CFrame.Angles(rad(pitch), 0, 0)
end

-- The legs twist against the torso so the feet stay planted. They're
-- additive, so walking still plays underneath.
local LEGS_ADDITIVE = { RightLeg = true, LeftLeg = true }

local Clips: { [string]: Animation } = {}

local M1Animations = {}
M1Animations.Clips = Clips

Clips.Jab = {
	fadeIn = 0.03,
	fadeOut = 0.16,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.04, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -6),
				RightArm = limb(60, 20),
				LeftArm = limb(75, -25),
				RightLeg = rot(0, 6),
				LeftLeg = rot(0, 6),
			},
		},
		{
			time = 0.04,
			pose = {
				Torso = rot(0, -16),
				RightArm = limb(45, 10),
				LeftArm = limb(80, -28),
				Head = rot(0, 14),
				RightLeg = rot(0, 16),
				LeftLeg = rot(0, 16),
			},
		},
		{
			time = 0.1,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-5, 22),
				RightArm = limb(94, 12),
				LeftArm = limb(62, -30),
				Head = rot(0, -18),
				RightLeg = rot(0, -22),
				LeftLeg = rot(0, -22),
			},
		},
		{
			time = 0.2,
			pose = {
				Torso = rot(-4, 18),
				RightArm = limb(90, 12),
				LeftArm = limb(62, -30),
				Head = rot(0, -15),
				RightLeg = rot(0, -18),
				LeftLeg = rot(0, -18),
			},
		},
	},
}

Clips.Cross = {
	fadeIn = 0.03,
	fadeOut = 0.16,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.04, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, 10),
				RightArm = limb(80, 28),
				LeftArm = limb(60, -18),
				RightLeg = rot(0, -10),
				LeftLeg = rot(0, -10),
			},
		},
		{
			time = 0.04,
			pose = {
				Torso = rot(0, 18),
				RightArm = limb(80, 28),
				LeftArm = limb(42, -10),
				Head = rot(0, -14),
				RightLeg = rot(0, -18),
				LeftLeg = rot(0, -18),
			},
		},
		{
			time = 0.1,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-6, -24),
				RightArm = limb(62, 30),
				LeftArm = limb(94, -12),
				Head = rot(0, 20),
				RightLeg = rot(0, 24),
				LeftLeg = rot(0, 24),
			},
		},
		{
			time = 0.2,
			pose = {
				Torso = rot(-5, -20),
				RightArm = limb(62, 30),
				LeftArm = limb(90, -12),
				Head = rot(0, 16),
				RightLeg = rot(0, 20),
				LeftLeg = rot(0, 20),
			},
		},
	},
}

Clips.Hook = {
	fadeIn = 0.03,
	fadeOut = 0.18,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.05, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -10),
				RightArm = limb(70, -10),
				LeftArm = limb(75, -25),
				RightLeg = rot(0, 10),
				LeftLeg = rot(0, 10),
			},
		},
		{
			-- Arm swings out wide to the right.
			time = 0.05,
			pose = {
				Torso = rot(0, -28),
				RightArm = limb(75, -55),
				LeftArm = limb(80, -28),
				Head = rot(0, 22),
				RightLeg = rot(0, 26),
				LeftLeg = rot(0, 26),
			},
		},
		{
			-- ...and sweeps across the body.
			time = 0.12,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-7, 32),
				RightArm = limb(88, 40),
				LeftArm = limb(65, -30),
				Head = rot(0, -26),
				RightLeg = rot(0, -30),
				LeftLeg = rot(0, -30),
			},
		},
		{
			time = 0.22,
			pose = {
				Torso = rot(-6, 28),
				RightArm = limb(85, 38),
				LeftArm = limb(65, -30),
				Head = rot(0, -22),
				RightLeg = rot(0, -26),
				LeftLeg = rot(0, -26),
			},
		},
	},
}

-- Knockback finisher: chambered front kick. Legs are fully posed here.
Clips.Kick = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -8),
				RightArm = limb(70, 20),
				LeftArm = limb(75, -25),
			},
		},
		{
			-- Chamber: knee comes back, body coils.
			time = 0.09,
			pose = {
				Torso = rot(8, -14),
				RightArm = limb(25, 0, 25),
				LeftArm = limb(60, -20),
				Head = rot(-6, 10),
				RightLeg = rot(-30),
				LeftLeg = rot(5),
			},
		},
		{
			-- Snap the leg straight out.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(20, 16),
				RightArm = limb(-20, 0, 45),
				LeftArm = limb(10, 0, -70),
				Head = rot(-18, -12),
				RightLeg = rot(98),
				LeftLeg = rot(-20), -- cancels the torso lean so the standing leg stays vertical
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(18, 14),
				RightArm = limb(-15, 0, 40),
				LeftArm = limb(10, 0, -65),
				Head = rot(-16, -10),
				RightLeg = rot(92),
				LeftLeg = rot(-18),
			},
		},
	},
}

Clips.Uppercut = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	additive = LEGS_ADDITIVE,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0, -8),
				RightArm = limb(60, 15),
				LeftArm = limb(75, -25),
			},
		},
		{
			-- Dip down and load the right arm low.
			time = 0.09,
			pose = {
				Torso = rot(-18, -18),
				RightArm = limb(-25, 5),
				LeftArm = limb(80, -28),
				Head = rot(12, 12),
				RightLeg = rot(-8, 18),
				LeftLeg = rot(15, 18),
			},
		},
		{
			-- Rip upward.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(14, 22),
				RightArm = limb(168, 10),
				LeftArm = limb(35, -20),
				Head = rot(-20, -16),
				RightLeg = rot(0, -20),
				LeftLeg = rot(0, -20),
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(12, 18),
				RightArm = limb(165, 10),
				LeftArm = limb(35, -20),
				Head = rot(-18, -14),
				RightLeg = rot(0, -16),
				LeftLeg = rot(0, -16),
			},
		},
	},
}

Clips.Downslam = {
	fadeIn = 0.04,
	fadeOut = 0.22,
	events = { { time = 0.09, name = "Strike" } },
	keyframes = {
		{
			time = 0,
			pose = {
				Torso = rot(0),
				RightArm = limb(80, 10),
				LeftArm = limb(80, -10),
			},
		},
		{
			-- Both fists raised overhead, body arched back.
			time = 0.09,
			pose = {
				Torso = rot(18),
				RightArm = limb(172, 12),
				LeftArm = limb(172, -12),
				Head = rot(-15),
				RightLeg = rot(-20),
				LeftLeg = rot(10),
			},
		},
		{
			-- Hammer down.
			time = 0.16,
			easing = Enum.EasingStyle.Back,
			pose = {
				Torso = rot(-32),
				RightArm = limb(45, 15),
				LeftArm = limb(45, -15),
				Head = rot(18),
				RightLeg = rot(30),
				LeftLeg = rot(20),
			},
		},
		{
			time = 0.32,
			pose = {
				Torso = rot(-28),
				RightArm = limb(50, 15),
				LeftArm = limb(50, -15),
				Head = rot(15),
				RightLeg = rot(25),
				LeftLeg = rot(18),
			},
		},
	},
}

-- Which limbs leave a trail on each move.
M1Animations.Strikers = {
	Jab = { "Right Arm" },
	Cross = { "Left Arm" },
	Hook = { "Right Arm" },
	Kick = { "Right Leg" },
	Uppercut = { "Right Arm" },
	Downslam = { "Right Arm", "Left Arm" },
}

local STRING = { "Jab", "Cross", "Hook" }
local FINISHERS = { Knockback = "Kick", Uppercut = "Uppercut", Downslam = "Downslam" }

-- Animation name for combo hit `index` with finisher `variant`.
function M1Animations.NameFor(index: number, variant: string): string
	if variant ~= "Normal" then
		return FINISHERS[variant] or "Kick"
	end
	return STRING[((index - 1) % #STRING) + 1]
end

return M1Animations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Moves</string>
            <string name="Source"><![CDATA[--[[
	Moves
	Plays move animations + their VFX on characters, routed to each
	character's kit (Client/Kits/<KitId>). Characters without a kit (the
	dummies) use the default fist M1s.

	Your own M1s play instantly when you click (predicted by Input), so they
	feel responsive at any ping. Everyone else's play when the server's
	"Swing" event arrives. Skills are driven by the server's "Skill" events.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Kits = require(ReplicatedStorage:WaitForChild("Shared").Kits)
local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local M1Animations = require(script.Parent.M1Animations)
local PoseAnimator = require(script.Parent.PoseAnimator)
local Reactions = require(script.Parent.Reactions)
local VFX = require(script.Parent.VFX)

local localPlayer = Players.LocalPlayer

local TRAIL_TIME = 0.14

local clientKits: { [string]: any } = {}
for _, module in script.Parent:WaitForChild("Kits"):GetChildren() do
	if module:IsA("ModuleScript") then
		clientKits[module.Name] = require(module) :: any
	end
end

local Moves = {}

local function kitOf(character: Model): any
	local id = character:GetAttribute("Kit")
	return if type(id) == "string" then clientKits[id] else nil
end

-- Default M1s: punches and a kick.
local function playFistM1(character: Model, index: number, variant: string)
	local name = M1Animations.NameFor(index, variant)
	local animation = M1Animations.Clips[name]
	if not animation then
		return
	end
	local heavy = variant ~= "Normal"
	local strikers = M1Animations.Strikers[name] or {}

	PoseAnimator.Play(character, animation, function(event)
		if event == "Strike" then
			for _, limbName in strikers do
				VFX.LimbTrail(character, limbName, if heavy then TRAIL_TIME * 1.5 else TRAIL_TIME)
			end
			VFX.AirPop(character, heavy)
		end
	end)
end

function Moves.PlayM1(character: Model, index: number, variant: string)
	local kit = kitOf(character)
	if kit and kit.PlayM1 then
		kit.PlayM1(character, index, variant)
	else
		playFistM1(character, index, variant)
	end
end

---------------------------------------------------------------------------
-- Getting hit and blocking
---------------------------------------------------------------------------

-- A character's own reaction (Kit.Reactions) or the default one.
local function reactionFor(character: Model, name: string): PoseAnimator.Animation?
	local kit = kitOf(character)
	local own = kit and kit.Reactions and kit.Reactions[name]
	return own or Reactions[name]
end

local function asModel(value: unknown): Model?
	return if typeof(value) == "Instance" and value:IsA("Model") then value else nil
end

-- Characters being held in a grab (see pinGrab), by victim.
local grabs: { [Model]: { stop: () -> () } } = {}

local function react(character: Model, name: string)
	if character:GetAttribute("Ragdolled") == true then
		return -- the ragdoll is the reaction
	end
	if grabs[character] and name ~= "Grabbed" then
		return -- they keep struggling in the grip
	end
	local animation = reactionFor(character, name)
	if animation then
		PoseAnimator.Play(character, animation)
	end
end

local GUARD_ANIMS = { Guard = true, GuardHit = true }
local lastFlinchSide: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function isGuardPlaying(character: Model): boolean
	local current = PoseAnimator.Current(character)
	if not current then
		return false
	end
	for name in GUARD_ANIMS do
		if current == reactionFor(character, name) then
			return true
		end
	end
	return false
end

local function onLandedHit(name: string, data)
	local victim = data.victim
	if typeof(victim) ~= "Instance" or not victim:IsA("Model") or data.noReaction == true then
		return
	end
	if name == "HeavyHit" or name == "PerfectDivider" then
		react(victim, "HitHeavy")
		return
	end
	-- Hit from behind throws them forward; otherwise alternate sides.
	local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
	local attacker = data.attacker
	local attackerRoot = if typeof(attacker) == "Instance"
		then attacker:FindFirstChild("HumanoidRootPart") :: BasePart?
		else nil
	if victimRoot and attackerRoot then
		local toAttacker = attackerRoot.Position - victimRoot.Position
		if victimRoot.CFrame.LookVector:Dot(Vector3.new(toAttacker.X, 0, toAttacker.Z).Unit) < -0.3 then
			react(victim, "FlinchBack")
			return
		end
	end
	local side = not lastFlinchSide[victim]
	lastFlinchSide[victim] = side
	react(victim, if side then "FlinchA" else "FlinchB")
end

--[[
	Grabs. The server holds the victim in place for hitboxes, but its
	position reaches us a ping late, which looks loose when the grabber is
	moving fast (Black Meteorite's rise and slam). So every client pins the
	victim to the grabber's hand itself, every frame: the hand's grip point
	is at their throat, facing the grabber, never sunk into the floor.
]]
local GRAB_NECK = 0.85 -- grip point to the victim's root
local GRAB_REACH = 0.6 -- the victim's root sits this far past the hand
local GRAB_FLOOR = 2.6 -- lowest the victim's root goes above the ground

local function pinGrab(data)
	local victim, attacker = asModel(data.victim), asModel(data.attacker)
	if not victim or not attacker then
		return
	end
	local victimRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
	local attackerRoot = attacker:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not victimRoot or not attackerRoot then
		return
	end
	local existing = grabs[victim]
	if existing then
		existing.stop()
	end

	local offset: CFrame = if typeof(data.offset) == "CFrame" then data.offset else CFrame.new(0, 0, -3)
	local handName: string? = if type(data.hand) == "string" then data.hand else nil
	local duration = (tonumber(data.duration) or 2) + 0.3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { victim, attacker, VFX.Util.folder }
	local floorY: number? = nil
	local nextFloorCheck = 0
	local started = os.clock()

	local entry = {} :: { stop: () -> () }
	local connection
	entry.stop = function()
		if grabs[victim] ~= entry then
			return
		end
		grabs[victim] = nil
		connection:Disconnect()
		if PoseAnimator.Current(victim) == reactionFor(victim, "Grabbed") then
			PoseAnimator.FadeOut(victim, 0.2)
		end
	end
	grabs[victim] = entry

	connection = RunService.RenderStepped:Connect(function()
		if os.clock() - started > duration or not victimRoot.Parent or not attackerRoot.Parent then
			entry.stop()
			return
		end
		local target = attackerRoot.CFrame * offset
		local hand = if handName then attacker:FindFirstChild(handName) else nil
		if hand and hand:IsA("BasePart") then
			-- Hanging from the hand the way the grabber is the right way up:
			-- if he turns upside down (a head-first dive), so do they.
			local grip = (hand.CFrame * CFrame.new(0, -1, 0)).Position
			local up = attackerRoot.CFrame.UpVector
			local forward = attackerRoot.CFrame.LookVector
			local position = grip + forward * GRAB_REACH - up * GRAB_NECK
			target = CFrame.lookAt(position, position - forward, up)
		end
		local now = os.clock()
		if now >= nextFloorCheck then
			nextFloorCheck = now + 0.1
			local hit = workspace:Raycast(target.Position + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), params)
			floorY = if hit then hit.Position.Y else nil
		end
		if floorY and target.Position.Y < floorY + GRAB_FLOOR then
			target += Vector3.new(0, floorY + GRAB_FLOOR - target.Position.Y, 0)
		end
		victimRoot.CFrame = target
	end)
	react(victim, "Grabbed")
end

-- Holding block shows the guard; letting go fades it out.
local function watchBlocking(character: Model)
	local function update()
		if character:GetAttribute("Blocking") == true then
			react(character, "Guard")
		elseif isGuardPlaying(character) then
			PoseAnimator.FadeOut(character, 0.15)
		end
	end
	character:GetAttributeChangedSignal("Blocking"):Connect(update)
	if character:GetAttribute("Blocking") == true then
		update()
	end
end

-- Kit stances and Black Form style looks follow the "Kit" and "Awakened"
-- attributes on every player.
local function watchCharacter(character: Model)
	-- The character can arrive before its joints have replicated.
	local torso = character:WaitForChild("Torso", 5)
	if torso then
		torso:WaitForChild("Right Shoulder", 5)
	end

	local function updateAwakened()
		local kit = kitOf(character)
		if kit and kit.SetAwakened then
			kit.SetAwakened(character, character:GetAttribute("Awakened") == true)
		end
	end
	local function updateKit()
		local kit = kitOf(character)
		-- A kit can choose its idle by state (Yuno hovers when awakened).
		local set = if kit and kit.IdleFor then kit.IdleFor(character) elseif kit then kit.Idle else nil
		PoseAnimator.SetIdle(character, set)
	end
	character:GetAttributeChangedSignal("Awakened"):Connect(updateAwakened)
	character:GetAttributeChangedSignal("Kit"):Connect(updateKit)
	updateAwakened()
	updateKit()
	watchBlocking(character)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
end

function Moves.Start()
	PoseAnimator.Start()

	-- Heavy hits: the attacker's swing also freezes for the hit-stop, so the
	-- impact feels like it connected.
	local HEAVY_EFFECTS = { HeavyHit = true, PerfectDivider = true }
	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if type(data) ~= "table" then
			return
		end
		if HEAVY_EFFECTS[name] and typeof(data.attacker) == "Instance" then
			PoseAnimator.Freeze(data.attacker :: Model, Config.Physics.HitStop)
		end

		if name == "Grabbed" then
			pinGrab(data)
			return
		elseif name == "GrabReleased" then
			local victim = asModel(data.victim)
			local grab = victim and grabs[victim]
			if grab then
				grab.stop()
			end
			return
		end

		-- Reactions on whoever got hit.
		if data.hitConfirm then
			onLandedHit(name, data)
		else
			local victim, attacker = asModel(data.victim), asModel(data.attacker)
			if name == "Block" and victim then
				react(victim, "GuardHit")
			elseif name == "GuardBreak" and victim then
				react(victim, "Stagger")
			elseif name == "PerfectBlock" and attacker then
				react(attacker, "Stagger")
			end
		end
	end)

	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if type(data) ~= "table" then
			return
		end
		local character = data.character
		if typeof(character) ~= "Instance" or not character:IsA("Model") then
			return
		end

		if name == "Swing" then
			-- Our own swing already played the moment we clicked.
			if character ~= localPlayer.Character then
				Moves.PlayM1(character, data.index or 1, data.variant or "Normal")
			end
		elseif name == "Skill" then
			local kit = if type(data.kit) == "string" then clientKits[data.kit] else nil
			if kit and kit.OnSkill then
				kit.OnSkill(data)
			end
		end
	end)

	-- Character switch: a flash in the new character's color.
	VFX.Register("KitSwitch", function(data)
		local character = data.character
		local kit = Kits.Get(data.kit)
		local root = VFX.Util.getRoot(character)
		if not root or not kit then
			return
		end
		VFX.Util.afterimage(character, kit.color, 0.5)
		VFX.Util.flash(root.Position, kit.color, 8, 0.3)
		VFX.Util.ringBurst(CFrame.new(root.Position - Vector3.new(0, 2.8, 0)), kit.color, 1, 8, 0.35, 0.25)
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end

	-- Dummies block too.
	task.spawn(function()
		local dummies = workspace:WaitForChild("Dummies", 30)
		if dummies then
			dummies.ChildAdded:Connect(function(child)
				if child:IsA("Model") then
					watchBlocking(child)
				end
			end)
			for _, child in dummies:GetChildren() do
				if child:IsA("Model") then
					watchBlocking(child)
				end
			end
		end
	end)
end

return Moves
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">PoseAnimator</string>
            <string name="Source"><![CDATA[--[[
	PoseAnimator
	Keyframe animations defined in code, played by overriding Motor6D.Transform
	every frame. No uploaded animation assets needed, so they work in any place
	without animation permissions.

	Runs on every client for every character: the server tells clients
	"this character swung", each client animates it locally.

	Poses rotate a limb around its joint in the PARENT part's space:
	  Torso       RootJoint, relative to HumanoidRootPart
	  Head        Neck, relative to Torso
	  RightArm    Right Shoulder, relative to Torso
	  LeftArm     Left Shoulder
	  RightLeg    Right Hip
	  LeftLeg     Left Hip
	  Sword       SwordGrip (a weapon's wrist), relative to the right arm
	Axes: X = right, Y = up, Z = back. So for a limb hanging down,
	  +X rotation swings it forward, +Y turns it to the left,
	  +Z swings it out to the right. For the Torso, +X leans back.

	Two layers per character:
	  idle   a looping stance, one version for standing still and one for
	         moving, blended by how fast the character is going
	  track  one-shot animations (attacks, skills) that blend in from
	         wherever the body is and back out into the idle
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

export type Pose = { [string]: CFrame }

export type Keyframe = {
	time: number,
	pose: Pose,
	easing: Enum.EasingStyle?, -- easing INTO this keyframe (default Quad)
	direction: Enum.EasingDirection?, -- (default Out)
}

export type Animation = {
	keyframes: { Keyframe },
	fadeIn: number?,
	fadeOut: number?,
	loop: boolean?,
	-- Joints whose pose is layered on top of the layer below instead of
	-- replacing it (e.g. legs counter-twisting while still walking).
	additive: { [string]: boolean }?,
	-- Overlapping action: a joint with a delay follows the animation that
	-- many seconds late (negative leads), so the body leads and the arm and
	-- weapon drag behind like in hand-made animation.
	delays: { [string]: number }?,
	events: { { time: number, name: string } }?,
}

export type IdleSet = {
	stand: Animation?, -- played while standing still
	move: Animation?, -- played while moving (a run cycle)
	walk: Animation?, -- played while moving slowly; blends into `move` as speed picks up
	air: Animation?, -- played while jumping or falling
	-- The speeds the run and walk cycles are animated for; they play faster
	-- or slower with the character's actual speed so feet don't slide.
	moveSpeed: number?,
	walkSpeed: number?,
	-- Better: the ground each cycle covers in one loop (studs). The cycle
	-- then moves exactly with the distance travelled, so the planted foot
	-- stays put at any speed.
	moveStride: number?,
	walkStride: number?,
}

local JOINTS = {
	Torso = "RootJoint",
	Head = "Neck",
	RightArm = "Right Shoulder",
	LeftArm = "Left Shoulder",
	RightLeg = "Right Hip",
	LeftLeg = "Left Hip",
	Sword = "SwordGrip",
}

local STAND_SPEED = 1.5 -- studs/s; slower than this counts as standing still
local STANCE_BLEND = 8 -- how fast the idle switches between stand and move
local AIR_HEIGHT = 3.6 -- no ground this far under the root counts as airborne (R6 stands at 3)
local AIR_BLEND = 10
local TURN_BLEND = 10 -- how fast the legs swing round to a new movement direction

type Track = {
	animation: Animation,
	joints: { [string]: Motor6D },
	start: number,
	length: number,
	onEvent: ((name: string) -> ())?,
	firedEvents: { [number]: boolean },
	-- Where each joint actually was when this track started, so a new swing
	-- blends from the previous swing's pose instead of snapping to idle.
	from: { [string]: CFrame },
	-- Hit-stop: the animation holds still until this time.
	freezeUntil: number,
	frozenAt: number,
	-- Set when the track is told to stop early (FadeOut).
	fadeOutOverride: number?,
}

type Idle = {
	set: IdleSet,
	covered: { [string]: boolean },
	joints: { [string]: Motor6D },
	start: number,
	standWeight: number,
	airWeight: number,
	-- Where in the step cycle the legs are (0 to 1), shared by walk and run
	-- so they blend without the legs fighting.
	phase: number,
	-- Movement direction relative to facing (degrees, + is right), folded
	-- into -75..75; backWeight says it's actually backwards.
	moveYaw: number,
	backWeight: number,
	airborne: boolean,
	nextGroundCheck: number,
	rayParams: RaycastParams,
	nextJointScan: number,
}

local tracks: { [Model]: Track } = {}
local idles: { [Model]: Idle } = {}
-- What we wrote to each joint last frame. If the default Animator didn't
-- overwrite it, the joint has no base animation and its base is identity.
local lastWritten: { [Motor6D]: CFrame } = {}
local posedCache: { [Animation]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any

local PoseAnimator = {}

local function findJoints(character: Model): { [string]: Motor6D }
	local found = {}
	for poseName, jointName in JOINTS do
		local joint = character:FindFirstChild(jointName, true)
		if joint and joint:IsA("Motor6D") then
			found[poseName] = joint
		end
	end
	return found
end

local function ease(alpha: number, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): number
	return TweenService:GetValue(alpha, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
end

-- Smooth 0..1 ramp (no sudden starts/stops) for fading tracks in and out.
local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function lengthOf(animation: Animation): number
	local keyframes = animation.keyframes
	return keyframes[#keyframes].time
end

local function posed(animation: Animation): { [string]: boolean }
	local cached = posedCache[animation]
	if cached then
		return cached
	end
	local set = {}
	for _, keyframe in animation.keyframes do
		for poseName in keyframe.pose do
			set[poseName] = true
		end
	end
	posedCache[animation] = set
	return set
end

-- The animation's pose for one joint at time t (identity if never posed).
-- Applies the joint's delay; looping animations wrap around.
local function sample(animation: Animation, poseName: string, t: number): CFrame
	local delays = animation.delays
	if delays and delays[poseName] then
		t -= delays[poseName]
	end
	local keyframes = animation.keyframes
	if animation.loop then
		local length = keyframes[#keyframes].time
		if length > 0 then
			t %= length
		end
	end

	local previous = keyframes[1]
	if t <= previous.time then
		return previous.pose[poseName] or CFrame.identity
	end
	for i = 2, #keyframes do
		local nextFrame = keyframes[i]
		if t <= nextFrame.time then
			local span = nextFrame.time - previous.time
			local alpha = if span > 0 then (t - previous.time) / span else 1
			local from = previous.pose[poseName] or CFrame.identity
			local to = nextFrame.pose[poseName] or CFrame.identity
			return from:Lerp(to, ease(alpha, nextFrame.easing, nextFrame.direction))
		end
		previous = nextFrame
	end
	return previous.pose[poseName] or CFrame.identity
end

-- Parent-part-space pose -> the joint's own space.
local function toJointSpace(joint: Motor6D, pose: CFrame): CFrame
	local c0 = joint.C0.Rotation
	return c0:Inverse() * pose * c0
end

-- What the default Animator (walk/idle) set this frame, or identity if
-- nothing but us animates this joint.
local function animatorBase(joint: Motor6D): CFrame
	local current = joint.Transform
	return if lastWritten[joint] == current then CFrame.identity else current
end

local function write(joint: Motor6D, value: CFrame)
	joint.Transform = value
	lastWritten[joint] = value
end

-- A lift under everything a character plays (Yuno hovering while awakened):
-- the whole body raised `studs` off its root, eased so it never pops. It
-- settles to nothing while the root is anchored (a cutscene path), so the
-- body stays where the path puts it.
type Lift = { target: number, current: number, holdUntil: number }
local lifts: { [Model]: Lift } = setmetatable({}, { __mode = "k" }) :: any

local function liftFor(character: Model, joint: Motor6D, dt: number): CFrame?
	local lift = lifts[character]
	if not lift then
		return nil
	end
	local root = joint.Part0
	local held = (root and root.Anchored) or os.clock() < lift.holdUntil
	local target = if held then 0 else lift.target
	lift.current += (target - lift.current) * math.min(dt * 6, 1)
	if lift.current < 0.005 and target == 0 then
		lift.current = 0
		return nil
	end
	local c0 = joint.C0.Rotation
	return c0:Inverse() * CFrame.new(0, lift.current, 0) * c0
end

local function release(track: Track, character: Model)
	-- Hand the joints back; the default Animator overwrites them next frame
	-- if it's animating them. Joints the idle covers stay put, the idle
	-- takes over next frame.
	local idle = idles[character]
	for poseName, joint in track.joints do
		if idle and idle.joints[poseName] then
			continue
		end
		if lastWritten[joint] then
			lastWritten[joint] = nil
			if joint.Parent then
				joint.Transform = CFrame.identity
			end
		end
	end
end

-- One idle animation's value for a joint (joint space), or nil if it doesn't pose it.
local function layer(animation: Animation?, poseName: string, joint: Motor6D, time: number): CFrame?
	if animation and posed(animation)[poseName] then
		return toJointSpace(joint, sample(animation, poseName, time))
	end
	return nil
end

-- The idle layer's value for every joint it covers this frame (joint space).
local function idleValues(character: Model, idle: Idle, now: number, dt: number): { [string]: CFrame }
	-- Joints can show up late (a weapon replicating after the kit was set)
	-- or get recreated (avatar applied), so look for missing ones now and then.
	if now >= idle.nextJointScan then
		idle.nextJointScan = now + 0.25
		local fresh: { [string]: Motor6D }? = nil
		for poseName in idle.covered do
			local joint = idle.joints[poseName]
			if not joint or not joint.Parent then
				fresh = fresh or findJoints(character)
				idle.joints[poseName] = (fresh :: { [string]: Motor6D })[poseName]
			end
		end
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local velocity = if root then root.AssemblyLinearVelocity else Vector3.zero
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	local set = idle.set

	-- Airborne means nothing under the feet. Unlike checking vertical
	-- speed, this holds through the top of a jump.
	if root and now >= idle.nextGroundCheck then
		idle.nextGroundCheck = now + 0.05
		idle.airborne = workspace:Raycast(root.Position, Vector3.new(0, -AIR_HEIGHT, 0), idle.rayParams) == nil
	end

	local standTarget = if speed < STAND_SPEED then 1 else 0
	idle.standWeight += (standTarget - idle.standWeight) * math.min(dt * STANCE_BLEND, 1)
	local airTarget = if set.air and idle.airborne then 1 else 0
	idle.airWeight += (airTarget - idle.airWeight) * math.min(dt * AIR_BLEND, 1)

	-- Which way he's moving compared to where he faces (shift lock strafing,
	-- backpedalling). Backwards runs the cycle in reverse.
	local yawTarget, backTarget = 0, 0
	if root and speed > STAND_SPEED then
		local direction = root.CFrame:VectorToObjectSpace(flat / speed)
		local angle = math.deg(math.atan2(direction.X, -direction.Z))
		local backLimit = if idle.backWeight > 0.5 then 95 else 115
		if math.abs(angle) > backLimit then
			backTarget = 1
			angle -= 180 * math.sign(angle)
		end
		yawTarget = math.clamp(angle, -75, 75)
	end
	local turn = math.min(dt * TURN_BLEND, 1)
	idle.moveYaw += (yawTarget - idle.moveYaw) * turn
	idle.backWeight += (backTarget - idle.backWeight) * turn

	-- Walk when slow, run when fast, both on the same step phase.
	local runLength = if set.move then lengthOf(set.move) else 1
	local walkLength = if set.walk then lengthOf(set.walk) else runLength
	local runSpeed = set.moveSpeed or 16
	local walkSpeed = set.walkSpeed or 8
	local runWeight = if set.walk then smooth((speed - walkSpeed * 1.2) / (runSpeed * 0.85 - walkSpeed * 1.2)) else 1
	local walkRate = if set.walkStride
		then math.clamp(speed / set.walkStride, 0.4, 3)
		else math.clamp(speed / walkSpeed, 0.5, 1.8) / walkLength
	local runRate = if set.moveStride
		then math.clamp(speed / set.moveStride, 0.4, 3.4)
		else math.clamp(speed / runSpeed, 0.5, 2) / runLength
	local rate = walkRate + (runRate - walkRate) * runWeight
	idle.phase = (idle.phase + dt * rate * (if backTarget == 1 then -1 else 1)) % 1

	local standW, airW = smooth(idle.standWeight), smooth(idle.airWeight)
	local yaw, back = math.rad(idle.moveYaw), idle.backWeight

	local t = now - idle.start
	local values = {}
	for poseName, joint in idle.joints do
		if not joint.Parent then
			continue
		end
		local base = animatorBase(joint)
		-- Moving (or the default walk), blended toward standing, then air.
		local value = base
		local run = if set.move and posed(set.move)[poseName]
			then sample(set.move, poseName, idle.phase * runLength)
			else nil
		local walk = if set.walk and posed(set.walk)[poseName]
			then sample(set.walk, poseName, idle.phase * walkLength)
			else nil
		local move = if run and walk then walk:Lerp(run, runWeight) else run or walk
		if move then
			-- Turn the stride toward the movement direction: hips most, the
			-- torso a little, the head back to facing forward. Lean back less
			-- when backpedalling.
			if poseName == "Torso" then
				move = CFrame.Angles(0, -yaw * 0.4, 0) * CFrame.Angles(math.rad(14) * back, 0, 0) * move
			elseif poseName == "Head" then
				move = CFrame.Angles(0, yaw * 0.4, 0) * move
			elseif poseName == "RightLeg" or poseName == "LeftLeg" then
				move = CFrame.Angles(0, -yaw * 0.6, 0) * move
			end
			value = toJointSpace(joint, move)
		end
		value = value:Lerp(layer(set.stand, poseName, joint, t) or base, standW)
		local air = layer(set.air, poseName, joint, t)
		if air and airW > 0 then
			value = value:Lerp(air, airW)
		end
		values[poseName] = value
	end
	return values
end

local function step(dt: number)
	local now = os.clock()

	local idleFrame: { [Model]: { [string]: CFrame } } = {}
	for character, idle in idles do
		if not character.Parent then
			idles[character] = nil
			continue
		end
		if character:GetAttribute("Ragdolled") == true then
			continue
		end
		local values = idleValues(character, idle, now, dt)
		idleFrame[character] = values
		local track = tracks[character]
		for poseName, value in values do
			if not (track and track.joints[poseName]) then
				local joint = idle.joints[poseName]
				local lift = if poseName == "Torso" then liftFor(character, joint, dt) else nil
				write(joint, if lift then lift * value else value)
			end
		end
	end

	for character, track in tracks do
		local elapsed = if now < track.freezeUntil then track.frozenAt else now - track.start
		local animation = track.animation
		local fadeIn = animation.fadeIn or 0.04
		local fadeOut = track.fadeOutOverride or animation.fadeOut or 0.15
		local total = track.length + fadeOut

		local dead = not character.Parent or character:GetAttribute("Ragdolled") == true
		if dead or elapsed >= total then
			tracks[character] = nil
			release(track, character)
			continue
		end

		if animation.events and track.onEvent then
			for index, event in animation.events do
				if not track.firedEvents[index] and elapsed >= event.time then
					track.firedEvents[index] = true
					task.spawn(track.onEvent, event.name)
				end
			end
		end

		local fadingIn = elapsed < fadeIn
		local weight = 1
		if fadingIn then
			weight = smooth(elapsed / fadeIn)
		elseif elapsed > track.length then
			weight = 1 - smooth((elapsed - track.length) / fadeOut)
		end

		local additive = animation.additive or {}
		local idleValuesNow = idleFrame[character]
		local clampedTime = math.min(elapsed, track.length)
		for poseName, joint in track.joints do
			if not joint.Parent then
				continue
			end
			local base = (idleValuesNow and idleValuesNow[poseName]) or animatorBase(joint)
			local local_ = toJointSpace(joint, sample(animation, poseName, clampedTime))
			local target = if additive[poseName] then base * local_ else local_
			-- Fading in starts from wherever the joint really was (mid-swing
			-- from the previous track, for example), not from the base.
			local lift = if poseName == "Torso" then liftFor(character, joint, dt) else nil
			local start = base
			if fadingIn and track.from[poseName] then
				-- (What the joint really was includes the lift; take it off.)
				start = if lift then lift:Inverse() * track.from[poseName] else track.from[poseName]
			end
			local value = start:Lerp(target, weight)
			write(joint, if lift then lift * value else value)
		end
	end
end

-- Lifts everything `character` plays `studs` off the ground (0 to settle
-- back down), eased in and out.
function PoseAnimator.SetLift(character: Model, studs: number)
	local lift = lifts[character]
	if lift then
		lift.target = studs
	else
		lifts[character] = { target = studs, current = 0, holdUntil = 0 }
	end
end

-- Drops the lift to nothing at once and holds it there for `duration` (a
-- cutscene that raised his root by as much at the same moment, so his body
-- doesn't move), then it eases back.
function PoseAnimator.SettleLift(character: Model, duration: number)
	local lift = lifts[character]
	if lift then
		lift.current = 0
		lift.holdUntil = os.clock() + duration
	end
end

-- Plays `animation` on `character`, replacing whatever this module was playing on it.
function PoseAnimator.Play(character: Model, animation: Animation, onEvent: ((name: string) -> ())?)
	local wanted = posed(animation)
	local joints = {}
	local from = {}
	for poseName, joint in findJoints(character) do
		if wanted[poseName] then
			joints[poseName] = joint
			from[poseName] = joint.Transform -- captured before the old track lets go
		end
	end

	local existing = tracks[character]
	if existing then
		tracks[character] = nil
		release(existing, character)
	end
	if next(joints) == nil then
		return -- not an R6 rig
	end

	tracks[character] = {
		animation = animation,
		joints = joints,
		start = os.clock(),
		length = lengthOf(animation),
		onEvent = onEvent,
		firedEvents = {},
		from = from,
		freezeUntil = 0,
		frozenAt = 0,
	}
end

function PoseAnimator.Stop(character: Model)
	local track = tracks[character]
	if track then
		tracks[character] = nil
		release(track, character)
	end
end

-- The animation currently playing on a character, if any.
function PoseAnimator.Current(character: Model): Animation?
	local track = tracks[character]
	return if track then track.animation else nil
end

-- Ends the current animation early, fading out from wherever it is now.
function PoseAnimator.FadeOut(character: Model, duration: number?)
	local track = tracks[character]
	if not track then
		return
	end
	local elapsed = os.clock() - track.start
	if elapsed < track.length then
		track.length = math.max(elapsed, 0)
	end
	track.fadeOutOverride = duration
end

-- Hit-stop: holds the character's current animation still for `duration`,
-- then lets it continue from the same point.
function PoseAnimator.Freeze(character: Model, duration: number)
	local track = tracks[character]
	if not track then
		return
	end
	local now = os.clock()
	if now < track.freezeUntil then
		return
	end
	track.frozenAt = now - track.start
	track.freezeUntil = now + duration
	track.start += duration
end

-- Sets (or clears, with nil) a character's idle layer.
function PoseAnimator.SetIdle(character: Model, set: IdleSet?)
	local old = idles[character]
	if old then
		idles[character] = nil
		for _, joint in old.joints do
			if lastWritten[joint] then
				lastWritten[joint] = nil
				joint.Transform = CFrame.identity
			end
		end
	end
	if not set then
		return
	end
	local covered: { [string]: boolean } = {}
	for _, animation in { set.stand, set.move, set.walk, set.air } :: { Animation? } do
		if animation then
			for poseName in posed(animation) do
				covered[poseName] = true
			end
		end
	end
	local joints = {}
	for poseName, joint in findJoints(character) do
		if covered[poseName] then
			joints[poseName] = joint
		end
	end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	idles[character] = {
		set = set,
		covered = covered,
		joints = joints,
		start = os.clock(),
		standWeight = 1,
		airWeight = 0,
		phase = 0,
		moveYaw = 0,
		backWeight = 0,
		airborne = false,
		nextGroundCheck = 0,
		rayParams = rayParams,
		nextJointScan = 0,
	}
end

function PoseAnimator.Start()
	-- PreSimulation runs after the default Animator has written its pose, so
	-- whatever we set here is what gets rendered.
	RunService.PreSimulation:Connect(step)
end

return PoseAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Reactions</string>
            <string name="Source"><![CDATA[--[[
	Reactions
	Default getting-hit and blocking animations, used by characters that
	don't bring their own (the dummies, and characters until they get custom
	ones). A kit can override any of these by name in Kit.Reactions.

	  FlinchA / FlinchB  hit from the front (alternating sides)
	  FlinchBack         hit from behind
	  HitHeavy           big hit that doesn't knock down
	  Guard              blocking stance, held until the block ends
	  GuardHit           a blocked hit pushes the guard back
	  Stagger            guard broken or parried
	  Grabbed            held up by the throat (faded out on release)
	  Launched           thrown high into the air, flailing (cutscenes end it)
]]

local PoseAnimator = require(script.Parent.PoseAnimator)

type Animation = PoseAnimator.Animation

local rad = math.rad
local QUART, SINE, LINEAR = Enum.EasingStyle.Quart, Enum.EasingStyle.Sine, Enum.EasingStyle.Linear
local OUT, IN_OUT = Enum.EasingDirection.Out, Enum.EasingDirection.InOut

local function rot(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

local function limb(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, rad(yaw or 0), 0) * CFrame.Angles(0, 0, rad(roll or 0)) * CFrame.Angles(rad(pitch), 0, 0)
end

local function clip(keys: { any }, options: { [string]: any }): Animation
	local keyframes = {}
	for _, key in keys do
		table.insert(keyframes, { time = key[1], pose = key[2], easing = key[3], direction = key[4] })
	end
	local animation: any = options
	animation.keyframes = keyframes
	return animation :: Animation
end

local LEGS = { RightLeg = true, LeftLeg = true }

local NEUTRAL = {
	Torso = rot(0),
	Head = rot(0),
	RightArm = limb(0),
	LeftArm = limb(0),
	RightLeg = rot(0),
	LeftLeg = rot(0),
}

local function settle(twist: number)
	return {
		Torso = rot(5, twist),
		Head = rot(-6, twist * 1.5),
		RightArm = limb(6, 0, 10),
		LeftArm = limb(6, 0, -12),
		RightLeg = rot(-2),
		LeftLeg = rot(2),
	}
end

local Reactions: { [string]: Animation } = {}

Reactions.FlinchA = clip({
	{ 0, NEUTRAL },
	{
		0.05,
		{
			Torso = rot(14, 14, 5),
			Head = rot(-20, 18),
			RightArm = limb(20, 0, 35),
			LeftArm = limb(15, 0, -40),
			RightLeg = rot(-6),
			LeftLeg = rot(6),
		},
		QUART,
		OUT,
	},
	{ 0.3, settle(4), SINE, OUT },
}, { fadeIn = 0.045, fadeOut = 0.22, additive = LEGS })

Reactions.FlinchB = clip({
	{ 0, NEUTRAL },
	{
		0.05,
		{
			Torso = rot(14, -14, -5),
			Head = rot(-20, -18),
			RightArm = limb(15, 0, 40),
			LeftArm = limb(20, 0, -35),
			RightLeg = rot(6),
			LeftLeg = rot(-6),
		},
		QUART,
		OUT,
	},
	{ 0.3, settle(-4), SINE, OUT },
}, { fadeIn = 0.045, fadeOut = 0.22, additive = LEGS })

Reactions.FlinchBack = clip({
	{ 0, NEUTRAL },
	{
		0.05,
		{
			Torso = rot(-16),
			Head = rot(18),
			RightArm = limb(-25, 0, 25),
			LeftArm = limb(-25, 0, -25),
			RightLeg = rot(-6),
			LeftLeg = rot(6),
		},
		QUART,
		OUT,
	},
	{ 0.3, settle(0), SINE, OUT },
}, { fadeIn = 0.045, fadeOut = 0.22, additive = LEGS })

Reactions.HitHeavy = clip({
	{ 0, NEUTRAL },
	{
		0.06,
		{
			Torso = rot(26),
			Head = rot(-35),
			RightArm = limb(110, 0, 40),
			LeftArm = limb(110, 0, -40),
			RightLeg = rot(20),
			LeftLeg = rot(-12),
		},
		QUART,
		OUT,
	},
	{ 0.5, settle(0), SINE, IN_OUT },
}, { fadeIn = 0.05, fadeOut = 0.25, additive = LEGS })

local GUARD = {
	Torso = rot(-8, 6),
	Head = rot(12),
	RightArm = limb(120, 42),
	LeftArm = limb(118, -42),
}
local GUARD_PUSHED = {
	Torso = rot(6, 10),
	Head = rot(-4),
	RightArm = limb(105, 48),
	LeftArm = limb(100, -36),
}

-- Held for a minute; the block ending fades it out early.
Reactions.Guard = clip({
	{ 0, { Torso = rot(0), Head = rot(0), RightArm = limb(0), LeftArm = limb(0) } },
	{ 0.08, GUARD, QUART, OUT },
	{ 60, GUARD, LINEAR },
}, { fadeIn = 0.05, fadeOut = 0.15 })

Reactions.GuardHit = clip({
	{ 0, GUARD },
	{ 0.05, GUARD_PUSHED, QUART, OUT },
	{ 0.2, GUARD, SINE, OUT },
	{ 60, GUARD, LINEAR },
}, { fadeIn = 0.02, fadeOut = 0.15 })

local STAGGER = {
	Torso = rot(20, -10),
	Head = rot(-25, 8),
	RightArm = limb(140, 0, 30),
	LeftArm = limb(120, 0, -35),
	RightLeg = rot(16),
	LeftLeg = rot(-14),
}

Reactions.Stagger = clip({
	{ 0, NEUTRAL },
	{ 0.08, STAGGER, QUART, OUT },
	{ 1.0, STAGGER, LINEAR },
	{ 1.3, settle(0), SINE, IN_OUT },
}, { fadeIn = 0.02, fadeOut = 0.25 })

-- Held up by the throat: head thrown back, both hands clawing at the grip,
-- legs kicking. Written out long (tracks don't loop); release fades it.
do
	local function grabbed(kick: number, arch: number)
		return {
			Torso = rot(10 + arch),
			Head = rot(-26 - arch),
			RightArm = limb(150 + arch * 2, -14, 6),
			LeftArm = limb(150 + arch * 2, 14, -6),
			RightLeg = rot(14 * kick),
			LeftLeg = rot(-12 * kick),
		}
	end
	local keys: { any } = { { 0, grabbed(0, 0) } }
	for i = 1, 14 do
		table.insert(
			keys,
			{ i * 0.18, grabbed(if i % 2 == 1 then 1 else -1, if i % 2 == 1 then 3 else 0), SINE, IN_OUT }
		)
	end
	Reactions.Grabbed = clip(keys, { fadeIn = 0.08, fadeOut = 0.2 })
end

do
	local function launched(flail: number)
		return {
			Torso = rot(20 + flail),
			Head = rot(-30),
			RightArm = limb(160 - flail * 3, 0, 30),
			LeftArm = limb(150 + flail * 3, 0, -35),
			RightLeg = rot(30 - flail * 2),
			LeftLeg = rot(-20 + flail * 2),
		}
	end
	local keys: { any } = { { 0, launched(0) } }
	for i = 1, 24 do -- long enough for the whole of Black Moon
		table.insert(keys, { i * 0.25, launched(if i % 2 == 1 then 6 else -6), SINE, IN_OUT })
	end
	Reactions.Launched = clip(keys, { fadeIn = 0.1, fadeOut = 0.2 })
end

return Reactions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ShiftLock</string>
            <string name="Source"><![CDATA[--[[
	ShiftLock
	Our own shift lock (Roblox's built-in one is turned off in StarterPlayer):
	LeftShift or the top bar button toggles it. While on, the mouse is locked
	to the center, the camera sits over the right shoulder and the character
	always faces where the camera looks, so attacks go where you aim.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CombatState = require(ReplicatedStorage:WaitForChild("Shared").CombatState)

local SHOULDER_OFFSET = Vector3.new(1.75, 0.25, 0)
local DOT_SIZE = 6

local localPlayer = Players.LocalPlayer

local ShiftLock = {}

local enabled = false
local suspended = false -- e.g. a menu is open and needs the mouse
local listeners: { (boolean) -> () } = {}
local dot: Frame? = nil

-- Small aiming dot in the middle of the screen (replaces the mouse cursor).
local function buildDot()
	local gui = Instance.new("ScreenGui")
	gui.Name = "ShiftLockDot"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromOffset(DOT_SIZE, DOT_SIZE)
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.Visible = false
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Transparency = 0.4
	stroke.Thickness = 1
	stroke.Parent = frame

	dot = frame
end

local function getHumanoid(): (Humanoid?, BasePart?)
	local character = localPlayer.Character
	if not character then
		return nil, nil
	end
	return character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function apply()
	local active = enabled and not suspended
	local humanoid = getHumanoid()
	if humanoid then
		humanoid.AutoRotate = not active
		humanoid.CameraOffset = if active then SHOULDER_OFFSET else Vector3.zero
	end
	UserInputService.MouseIconEnabled = not active
	if dot then
		dot.Visible = active
	end
	if not active then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end

function ShiftLock.IsEnabled(): boolean
	return enabled
end

function ShiftLock.Set(value: boolean)
	if enabled == value then
		return
	end
	enabled = value
	apply()
	for _, listener in listeners do
		task.spawn(listener, enabled)
	end
end

function ShiftLock.Toggle()
	ShiftLock.Set(not enabled)
end

-- Temporarily frees the mouse (menus) without turning shift lock off.
function ShiftLock.SetSuspended(value: boolean)
	suspended = value
	apply()
end

function ShiftLock.OnChanged(listener: (boolean) -> ())
	table.insert(listeners, listener)
end

function ShiftLock.Start()
	buildDot()
	ContextActionService:BindAction("CloverShiftLock", function(_, state)
		if state == Enum.UserInputState.Begin then
			ShiftLock.Toggle()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.LeftShift)

	-- After the camera has updated: keep the mouse locked and turn the
	-- character to match the camera.
	RunService:BindToRenderStep("CloverShiftLock", Enum.RenderPriority.Camera.Value + 2, function()
		if not enabled or suspended then
			return
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

		local humanoid, root = getHumanoid()
		if not humanoid or not root or humanoid.Health <= 0 or humanoid.Sit then
			return
		end
		local character = localPlayer.Character :: Model
		-- Ragdolled, a skill is steering the body (Bull Thrust), or a cutscene.
		if
			CombatState.IsRagdolled(character)
			or character:GetAttribute("Steering") == true
			or character:GetAttribute("Cinematic") == true
		then
			return
		end
		local look = workspace.CurrentCamera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 1e-3 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		end
	end)

	localPlayer.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid")
		apply()
	end)
end

return ShiftLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Soft</string>
            <string name="Source"><![CDATA[--[[
	Soft light: the soft, see-through pieces effects are drawn with. Beams
	facing the camera (smoke or sparkles flowing along them), rings and
	arcs of beams, trails, glows and particles. Solid neon parts are kept
	for the small hard things (star points, blade edges, sparks).

	Its colours are Yuno's (wind pale green with a white core, star magic
	gold-white); every piece takes its own colours too. Used by
	Client/Kits/Wind (and its Saint module) and Client/Kits/AntiMagic.
]]

local RunService = game:GetService("RunService")

local VFX = require(script.Parent.VFX)

local U = VFX.Util
local rad = math.rad
local UP = Vector3.yAxis
local TERRAIN = workspace.Terrain

local Soft = {}
Soft.U = U

Soft.WIND = Color3.fromRGB(120, 235, 175)
Soft.WIND_DEEP = Color3.fromRGB(35, 170, 110)
Soft.WIND_WHITE = Color3.fromRGB(228, 255, 240)
Soft.STAR = Color3.fromRGB(255, 226, 130)
Soft.STAR_WHITE = Color3.fromRGB(255, 250, 228)
Soft.STAR_FIRE = Color3.fromRGB(255, 140, 40)

Soft.SMOKE = U.textures.Smoke
Soft.SPARKLE = U.textures.Spark

-- Sheer: while one is in force (Soft.sheer(k) until its release), every
-- soft piece made is that much more see-through: what would block a
-- fraction a of the light now blocks a(1 - k). Scoped to whatever wants it
-- (a whole cutscene), so the rest of the time nothing changes.
local sheers: { number } = {}
local function sheerness(): number
	local k = 0
	for _, value in sheers do
		k = math.max(k, value)
	end
	return k
end
function Soft.sheer(k: number): () -> ()
	table.insert(sheers, k)
	local released = false
	return function()
		if not released then
			released = true
			local i = table.find(sheers, k)
			if i then
				table.remove(sheers, i)
			end
		end
	end
end
local function sheerValue(transparency: number): number
	local k = sheerness()
	return if k > 0 then 1 - (1 - transparency) * (1 - k) else transparency
end
local function sheerSequence(sequence: NumberSequence): NumberSequence
	local k = sheerness()
	if k <= 0 then
		return sequence
	end
	local points = {}
	for _, point in sequence.Keypoints do
		table.insert(
			points,
			NumberSequenceKeypoint.new(point.Time, 1 - (1 - point.Value) * (1 - k), point.Envelope * (1 - k))
		)
	end
	return NumberSequence.new(points)
end
Soft.sheerValue = sheerValue

local WIND, WIND_DEEP, WIND_WHITE = Soft.WIND, Soft.WIND_DEEP, Soft.WIND_WHITE
local STAR, STAR_WHITE = Soft.STAR, Soft.STAR_WHITE
local SMOKE, SPARKLE = Soft.SMOKE, Soft.SPARKLE

local KAPPA = 0.5523 -- a quarter circle as a cubic curve

---------------------------------------------------------------------------
-- Timing and cleanup
---------------------------------------------------------------------------

-- Runs `step(elapsed, dt)` every frame until it returns false or `duration`
-- runs out; then `finish` (if any).
function Soft.every(duration: number, step: (number, number) -> boolean?, finish: (() -> ())?)
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		local elapsed = os.clock() - start
		if elapsed >= duration or step(elapsed, dt) == false then
			connection:Disconnect()
			if finish then
				finish()
			end
		end
	end)
end
local every = Soft.every

function Soft.fadeOut(parts: { BasePart }, duration: number)
	for _, part in parts do
		U.tween(part, duration, { Transparency = 1 })
	end
	task.delay(duration + 0.05, function()
		for _, part in parts do
			part:Destroy()
		end
	end)
end
local fadeOut = Soft.fadeOut

function Soft.key(time: number, value: number): NumberSequenceKeypoint
	return NumberSequenceKeypoint.new(time, value)
end
local key = Soft.key

function Soft.quadratic(a: Vector3, b: Vector3, c: Vector3, s: number): Vector3
	return a * ((1 - s) * (1 - s)) + b * (2 * s * (1 - s)) + c * (s * s)
end
local quadratic = Soft.quadratic

---------------------------------------------------------------------------
-- Hard shapes: bars, tubes, wedges, stars
---------------------------------------------------------------------------

-- A straight bar of light or wind between two points.
function Soft.bar(from: Vector3, to: Vector3, width: number, color: Color3, transparency: number): BasePart
	if (to - from).Magnitude < 1e-3 then
		to = from + UP * 0.05
	end
	local length = math.max((to - from).Magnitude, 0.05)
	return U.newPart({
		Size = Vector3.new(width, width, length),
		CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to),
		Color = color,
		Transparency = sheerValue(transparency),
	})
end
local bar = Soft.bar

-- A round beam (cylinder) between two points.
function Soft.tube(from: Vector3, to: Vector3, width: number, color: Color3, transparency: number): BasePart
	if (to - from).Magnitude < 1e-3 then
		to = from + UP * 0.05
	end
	local length = math.max((to - from).Magnitude, 0.05)
	return U.newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, width, width),
		CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to) * CFrame.Angles(0, rad(90), 0),
		Color = color,
		Transparency = sheerValue(transparency),
	})
end

-- Re-poses a bar (from `bar`) to run between two points.
function Soft.stretch(line: BasePart, from: Vector3, to: Vector3)
	line.Size = Vector3.new(line.Size.X, line.Size.Y, (to - from).Magnitude + 0.05)
	line.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
end

-- A neon wedge (U.newPart for wedges), for pointed shapes.
function Soft.newWedge(props: { [string]: any }): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Anchored = true
	wedge.CanCollide = false
	wedge.CanQuery = false
	wedge.CanTouch = false
	wedge.CastShadow = false
	wedge.Material = Enum.Material.Neon
	for name, value in props do
		(wedge :: any)[name] = value
	end
	wedge.Transparency = sheerValue(wedge.Transparency)
	wedge.Parent = U.folder
	return wedge
end

-- Wind streaming into a point from all round it.
function Soft.inflow(target: Vector3, radius: number, color: Color3?)
	local from = target + U.randomUnit() * radius
	local wisp = bar(from, from + (target - from).Unit * 1.2, 0.08, color or WIND_WHITE, 0.3)
	U.tween(wisp, 0.22, { CFrame = CFrame.lookAt(target, target + (target - from).Unit), Transparency = 1 })
	task.delay(0.25, wisp.Destroy, wisp)
end

-- A burst of pale wind streaks.
function Soft.gust(position: Vector3, size: number, direction: Vector3?)
	U.burst(position, {
		color = WIND_WHITE,
		count = math.floor(8 + size * 3),
		size = 0.3 + size * 0.06,
		speed = NumberRange.new(14 + size * 4, 28 + size * 8),
		lifetime = NumberRange.new(0.15, 0.35),
		streaks = true,
		spread = if direction then 40 else 180,
		direction = direction,
	})
	U.ringBurst(CFrame.new(position), WIND, size * 0.2, size, 0.3, 0.12)
	U.light(position, WIND, 3, size * 2.5, 0.25)
end

-- A four-pointed star of light (star magic): a white core, a gold cross and
-- a smaller diagonal cross, always turned to face the camera, and a soft
-- glitter of starlight round it.
export type Star = { place: (Vector3, number) -> (), fade: (number) -> (), parts: { BasePart } }

function Soft.makeStar(size: number, color: Color3?): Star
	local tint = color or STAR
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local function add(part: BasePart, offset: CFrame)
		table.insert(parts, part)
		table.insert(offsets, offset)
	end
	add(
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.32, Color = STAR_WHITE }),
		CFrame.identity
	)
	for i = 0, 3 do
		local long = i % 2 == 0
		add(
			U.newPart({
				Size = Vector3.new(size * 0.07, size * (if long then 1.15 else 0.55), size * 0.07),
				Color = tint,
				Transparency = 0.05,
			}),
			CFrame.Angles(0, 0, i * math.pi / 4)
		)
	end
	add(
		U.newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.95, Color = tint, Transparency = 0.82 }),
		CFrame.identity
	)
	for _, part in parts do
		part.Transparency = sheerValue(part.Transparency)
	end
	local light = Instance.new("PointLight")
	light.Color = tint
	light.Range = size * 6
	light.Brightness = 2.5
	light.Parent = parts[1]
	-- Glitter: sparkles of starlight round it, and a soft halo.
	local glitter = Instance.new("ParticleEmitter")
	glitter.Texture = SPARKLE
	glitter.Color = ColorSequence.new(STAR_WHITE, tint)
	glitter.LightEmission = 1
	glitter.LightInfluence = 0
	glitter.Size = NumberSequence.new({ key(0, size * 0.5), key(1, 0) })
	glitter.Transparency = sheerSequence(NumberSequence.new({ key(0, 0.2), key(1, 1) }))
	glitter.Lifetime = NumberRange.new(0.25, 0.5)
	glitter.Rate = 10
	glitter.Speed = NumberRange.new(0.5, 1.5)
	glitter.SpreadAngle = Vector2.new(180, 180)
	glitter.Rotation = NumberRange.new(0, 90)
	glitter.Enabled = false -- (until it's first placed)
	glitter.Parent = parts[1]
	local placed, faded = false, false
	local star = { parts = parts }
	function star.place(position: Vector3, spin: number)
		local base = CFrame.lookAt(position, workspace.CurrentCamera.CFrame.Position) * CFrame.Angles(0, 0, spin)
		for i, part in parts do
			part.CFrame = base * offsets[i]
		end
		if not placed and not faded then
			placed = true
			glitter.Enabled = true
		end
	end
	function star.fade(duration: number)
		faded = true
		light.Enabled = false
		glitter.Enabled = false
		fadeOut(parts, duration)
	end
	return star
end
local makeStar = Soft.makeStar

-- A star, softer: its rays see-through.
function Soft.softStar(size: number, color: Color3?): Star
	local star = makeStar(size, color)
	for i, part in star.parts do
		if i > 1 then
			part.Transparency = math.max(part.Transparency, 0.35)
		end
	end
	return star
end

-- Sylph: a small spirit of wind, a glowing body with two fluttering wings
-- and a trail of wind behind her.
export type Sprite = { place: (CFrame, number) -> (), fade: (number) -> () }

function Soft.makeSprite(scale: number): Sprite
	local body = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.5, 0.5, 0.5) * scale,
		Color = WIND_WHITE,
	})
	local glow = U.newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.3 * scale,
		Color = WIND,
		Transparency = 0.7,
	})
	local wings = {
		U.newPart({ Size = Vector3.new(0.9, 0.05, 0.5) * scale, Color = WIND, Transparency = 0.35 }),
		U.newPart({ Size = Vector3.new(0.9, 0.05, 0.5) * scale, Color = WIND, Transparency = 0.35 }),
	}
	for _, part in { body, glow, wings[1], wings[2] } do
		part.Transparency = sheerValue(part.Transparency)
	end
	local light = Instance.new("PointLight")
	light.Color = WIND
	light.Range = 6 * scale
	light.Brightness = 2
	light.Parent = body
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.25 * scale, 0)
	a0.Parent = body
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.25 * scale, 0)
	a1.Parent = body
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(WIND_WHITE, WIND)
	trail.Transparency = sheerSequence(NumberSequence.new({ key(0, 0.2), key(1, 1) }))
	trail.WidthScale = NumberSequence.new({ key(0, 1), key(1, 0) })
	trail.Lifetime = 0.35
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Enabled = false -- (until she's first placed)
	trail.Parent = body
	local started = false
	local sprite = {}
	function sprite.place(cframe: CFrame, t: number)
		body.CFrame = cframe
		glow.CFrame = cframe
		if not started then
			started = true
			trail:Clear()
			trail.Enabled = true
		end
		local flap = math.sin(t * 30) * rad(40)
		wings[1].CFrame = cframe * CFrame.Angles(0, 0, flap) * CFrame.new(0.45 * scale, 0, 0)
		wings[2].CFrame = cframe * CFrame.Angles(0, 0, -flap) * CFrame.new(-0.45 * scale, 0, 0)
	end
	function sprite.fade(duration: number)
		light.Enabled = false
		trail.Enabled = false
		fadeOut({ glow, wings[1], wings[2] }, duration)
		Soft.linger(body, duration, trail.Lifetime + 0.15)
	end
	return sprite
end

-- An arc of thin segments (a bow, a crescent of wind): points on a circle of
-- `radius` round `center` from angle `from` to `to` (radians) in the plane of
-- `right` and `up`.
function Soft.arcPoints(
	center: Vector3,
	right: Vector3,
	up: Vector3,
	radius: number,
	from: number,
	to: number,
	count: number
): { Vector3 }
	local points = {}
	for i = 0, count do
		local angle = from + (to - from) * i / count
		table.insert(points, center + (right * math.cos(angle) + up * math.sin(angle)) * radius)
	end
	return points
end

function Soft.arcParts(points: { Vector3 }, width: number, color: Color3, transparency: number): { BasePart }
	local parts = {}
	for i = 1, #points - 1 do
		table.insert(parts, bar(points[i], points[i + 1], width, color, transparency))
	end
	return parts
end

function Soft.poseArc(parts: { BasePart }, points: { Vector3 })
	for i, part in parts do
		local a, b = points[i], points[i + 1]
		part.Size = Vector3.new(part.Size.X, part.Size.Y, (b - a).Magnitude + 0.05)
		part.CFrame = CFrame.lookAt(a:Lerp(b, 0.5), b)
	end
end

---------------------------------------------------------------------------
-- Soft shapes: beams, rings, trails, particles
---------------------------------------------------------------------------

-- An attachment fixed in the world (on Terrain), its X axis along `axis`
-- (the way a beam leaving it curves).
function Soft.worldAnchor(position: Vector3, axis: Vector3?): Attachment
	local x = if axis and axis.Magnitude > 1e-3 then axis.Unit else Vector3.xAxis
	local y = if math.abs(x.Y) > 0.98 then Vector3.zAxis else UP
	local z = x:Cross(y).Unit
	local attachment = Instance.new("Attachment")
	attachment.CFrame = CFrame.fromMatrix(position, x, z:Cross(x).Unit)
	attachment.Parent = TERRAIN
	return attachment
end
local worldAnchor = Soft.worldAnchor

-- Re-aims a world anchor (from `worldAnchor`).
function Soft.aim(attachment: Attachment, position: Vector3, axis: Vector3?)
	local x = if axis and axis.Magnitude > 1e-3 then axis.Unit else Vector3.xAxis
	local y = if math.abs(x.Y) > 0.98 then Vector3.zAxis else UP
	local z = x:Cross(y).Unit
	attachment.CFrame = CFrame.fromMatrix(position, x, z:Cross(x).Unit)
end

export type BeamStyle = {
	color: ColorSequence,
	width0: number,
	width1: number,
	transparency: NumberSequence,
	curve0: number?,
	curve1: number?,
	texture: string?,
	speed: number?,
	length: number?,
	emission: number?,
	wrap: boolean?, -- tile the texture every `length` studs (a chain of sparkles)
	segments: number?,
}

-- A soft beam between two attachments: facing the camera, glowing, see-
-- through, wind flowing along it when it's textured.
function Soft.softBeam(a0: Attachment, a1: Attachment, style: BeamStyle, parent: Instance?): Beam
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = style.color
	beam.Width0 = style.width0
	beam.Width1 = style.width1
	beam.Transparency = sheerSequence(style.transparency)
	beam.CurveSize0 = style.curve0 or 0
	beam.CurveSize1 = style.curve1 or 0
	beam.FaceCamera = true
	beam.LightEmission = style.emission or 1
	beam.LightInfluence = 0
	local curved = (style.curve0 or 0) ~= 0 or (style.curve1 or 0) ~= 0
	beam.Segments = style.segments or (if curved then 20 else 10)
	if style.texture then
		beam.Texture = style.texture
		beam.TextureMode = if style.wrap then Enum.TextureMode.Wrap else Enum.TextureMode.Stretch
		beam.TextureLength = style.length or 1
		beam.TextureSpeed = style.speed or 0
	end
	beam.Parent = parent or TERRAIN
	return beam
end
local softBeam = Soft.softBeam

-- Eases beams out to nothing, then removes them (and `extra`).
function Soft.fadeBeams(beams: { Beam }, duration: number, extra: { any }?)
	local originals: { { NumberSequenceKeypoint } } = {}
	for i, beam in beams do
		originals[i] = beam.Transparency.Keypoints
	end
	every(duration, function(elapsed)
		local a = math.clamp(elapsed / duration, 0, 1)
		for i, beam in beams do
			if beam.Parent then
				local points = {}
				for _, point in originals[i] do
					table.insert(points, key(point.Time, point.Value + (1 - point.Value) * a))
				end
				beam.Transparency = NumberSequence.new(points)
			end
		end
		return true
	end, function()
		for _, beam in beams do
			beam:Destroy()
		end
		if extra then
			for _, instance in extra do
				instance:Destroy()
			end
		end
	end)
end
local fadeBeams = Soft.fadeBeams

-- Scales a beam's widths by `scale` (from the widths it was made with).
function Soft.scaleBeams(beams: { Beam }, scale: number, base: { { number } })
	for i, beam in beams do
		beam.Width0 = base[i][1] * scale
		beam.Width1 = base[i][2] * scale
	end
end

function Soft.widths(beams: { Beam }): { { number } }
	local base = {}
	for i, beam in beams do
		base[i] = { beam.Width0, beam.Width1 }
	end
	return base
end

-- A ring of soft light: four quarter-circle beams on an invisible hub, so
-- turning or tilting it is just moving the hub. It lies in the hub's XZ
-- plane.
export type Ring = { hub: BasePart, beams: { Beam }, set: (CFrame, number) -> (), fade: (number) -> () }

function Soft.softRing(style: BeamStyle): Ring
	local hub = U.newPart({ Size = Vector3.one * 0.1, Transparency = 1 })
	local anchors: { Attachment } = {}
	for _ = 1, 4 do
		local attachment = Instance.new("Attachment")
		attachment.Parent = hub
		table.insert(anchors, attachment)
	end
	local beams: { Beam } = {}
	for i = 1, 4 do
		local beam = softBeam(anchors[i], anchors[i % 4 + 1], style, hub)
		beam.Segments = style.segments or 12
		table.insert(beams, beam)
	end
	local ring = { hub = hub, beams = beams }
	function ring.set(frame: CFrame, radius: number)
		hub.CFrame = frame
		for i, attachment in anchors do
			local angle = (i - 1) * math.pi / 2
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			attachment.CFrame = CFrame.fromMatrix(out * radius, Vector3.new(-math.sin(angle), 0, math.cos(angle)), UP)
		end
		for _, beam in beams do
			beam.CurveSize0 = radius * KAPPA
			beam.CurveSize1 = radius * KAPPA
		end
	end
	function ring.fade(duration: number)
		fadeBeams(beams, duration, { hub })
	end
	return ring
end
local softRing = Soft.softRing

-- A ring of wind racing out from `from` to `to` studs across `normal`.
function Soft.windRing(
	center: Vector3,
	normal: Vector3,
	from: number,
	to: number,
	duration: number,
	color: Color3?,
	width: number?
)
	local w = width or 1.4
	local ring = softRing({
		color = ColorSequence.new(WIND_WHITE, color or WIND),
		width0 = w,
		width1 = w,
		transparency = NumberSequence.new(0.3),
		texture = SMOKE,
		speed = 2,
		length = 4,
	})
	local frame = CFrame.lookAt(center, center + normal) * CFrame.Angles(rad(90), 0, 0)
	ring.set(frame, from)
	every(duration, function(elapsed)
		ring.set(frame, from + (to - from) * (1 - (1 - elapsed / duration) ^ 2))
		return true
	end)
	ring.fade(duration)
end

-- A thin bright ring of starlight racing out (sharper than a wind ring).
function Soft.lightRing(center: Vector3, normal: Vector3, from: number, to: number, duration: number, color: Color3?)
	local ring = softRing({
		color = ColorSequence.new(STAR_WHITE, color or STAR),
		width0 = 0.35,
		width1 = 0.35,
		transparency = NumberSequence.new(0.1),
	})
	local frame = CFrame.lookAt(center, center + normal) * CFrame.Angles(rad(90), 0, 0)
	ring.set(frame, from)
	every(duration, function(elapsed)
		local a = 1 - (1 - elapsed / duration) ^ 3
		ring.set(frame, from + (to - from) * a)
		for _, beam in ring.beams do
			beam.Width0 = 0.35 * (1 - a) + 0.05
			beam.Width1 = beam.Width0
		end
		return true
	end)
	ring.fade(duration)
end

-- A soft arc: beams curving round `center` from one angle to another (in
-- the plane of `right` and `up`), re-posed every frame with set().
export type Arc = {
	beams: { Beam },
	set: (Vector3, Vector3, Vector3, number, number, number) -> (),
	fade: (number) -> (),
}

function Soft.softArc(styles: { BeamStyle }): Arc
	local a0, a1 = worldAnchor(Vector3.zero), worldAnchor(Vector3.zero)
	local beams: { Beam } = {}
	for _, style in styles do
		local beam = softBeam(a0, a1, style)
		beam.Segments = style.segments or 16
		table.insert(beams, beam)
	end
	local arc = { beams = beams }
	function arc.set(center: Vector3, right: Vector3, up: Vector3, radius: number, from: number, to: number)
		local function at(angle: number): Vector3
			return center + (right * math.cos(angle) + up * math.sin(angle)) * radius
		end
		local function tangent(angle: number): Vector3
			return up * math.cos(angle) - right * math.sin(angle)
		end
		local k = 4 / 3 * math.tan((to - from) / 4) * radius
		Soft.aim(a0, at(from), tangent(from))
		Soft.aim(a1, at(to), tangent(to))
		for _, beam in beams do
			beam.CurveSize0 = k
			beam.CurveSize1 = k
		end
	end
	function arc.fade(duration: number)
		fadeBeams(beams, duration, { a0, a1 })
	end
	return arc
end

-- A particle emitter of soft wind (or sparkles) on `parent`.
function Soft.windEmitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SMOKE
	emitter.Color = ColorSequence.new(WIND_WHITE, WIND)
	emitter.LightEmission = 0.5
	emitter.LightInfluence = 0
	emitter.Transparency = NumberSequence.new({ key(0, 1), key(0.2, 0.65), key(0.7, 0.8), key(1, 1) })
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	for name, value in props do
		(emitter :: any)[name] = value
	end
	emitter.Transparency = sheerSequence(emitter.Transparency)
	emitter.Parent = parent
	return emitter
end
local windEmitter = Soft.windEmitter

-- A soft glow that follows `parent` (a stream of overlapping puffs of
-- light, so it moves with it and fades as soon as it stops).
function Soft.glow(parent: Instance, color: Color3, size: number, transparency: number?): ParticleEmitter
	local base = transparency or 0.6
	return windEmitter(parent, {
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Transparency = NumberSequence.new({ key(0, 1), key(0.25, base), key(0.75, base), key(1, 1) }),
		Size = NumberSequence.new(size),
		Lifetime = NumberRange.new(0.2, 0.26),
		Speed = NumberRange.new(0),
		RotSpeed = NumberRange.new(-40, 40),
		LockedToPart = true,
		Rate = 20,
	})
end

-- A puff of wind: soft gusts thrown out of a point.
function Soft.windPuff(position: Vector3, size: number, direction: Vector3?)
	U.burst(position, {
		texture = SMOKE,
		color = WIND_WHITE,
		count = math.floor(5 + size),
		size = size,
		speed = NumberRange.new(size * 4, size * 9),
		lifetime = NumberRange.new(0.25, 0.5),
		transparency = 0.55,
		lightEmission = 0.6,
		drag = 5,
		spread = if direction then 50 else 180,
		direction = direction,
	})
end

-- Sparks of starlight thrown out of a point (glittering four-point stars).
function Soft.starDust(position: Vector3, count: number, speed: number, direction: Vector3?, color: Color3?)
	U.burst(position, {
		color = color or STAR,
		count = count,
		size = 0.5,
		speed = NumberRange.new(speed * 0.4, speed),
		lifetime = NumberRange.new(0.3, 0.7),
		drag = 4,
		spread = if direction then 60 else 180,
		direction = direction,
	})
end

-- Fast streaks of wind thrown out along `direction` (or every way).
function Soft.streaks(position: Vector3, count: number, speed: number, direction: Vector3?, spread: number?)
	U.burst(position, {
		color = WIND_WHITE,
		count = count,
		size = 0.4,
		speed = NumberRange.new(speed * 0.5, speed),
		lifetime = NumberRange.new(0.12, 0.3),
		streaks = true,
		spread = spread or (if direction then 35 else 180),
		direction = direction,
	})
end

-- One big glint of starlight: a sparkle that flares and goes (a camera-
-- facing particle, so it's the same from every side).
function Soft.twinkle(position: Vector3, size: number, color: Color3?, duration: number?)
	local life = duration or 0.25
	local holder = U.newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(position) })
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder
	local flare = Instance.new("ParticleEmitter")
	flare.Texture = SPARKLE
	flare.Color = ColorSequence.new(STAR_WHITE, color or STAR)
	flare.LightEmission = 1
	flare.LightInfluence = 0
	flare.Size = NumberSequence.new({ key(0, size * 0.4), key(0.25, size), key(1, 0) })
	flare.Transparency = sheerSequence(NumberSequence.new({ key(0, 0), key(0.7, 0.2), key(1, 1) }))
	flare.Lifetime = NumberRange.new(life)
	flare.Speed = NumberRange.new(0)
	flare.Rotation = NumberRange.new(-10, 10)
	flare.RotSpeed = NumberRange.new(-60, 60)
	flare.Enabled = false
	flare.Parent = attachment
	flare:Emit(1)
	-- A soft halo under it.
	local halo = flare:Clone()
	halo.Texture = SMOKE
	halo.Color = ColorSequence.new(color or STAR)
	halo.Size = NumberSequence.new({ key(0, size * 0.6), key(1, size * 1.2) })
	halo.Transparency = sheerSequence(NumberSequence.new({ key(0, 0.55), key(1, 1) }))
	halo.Parent = attachment
	halo:Emit(1)
	task.delay(life + 0.1, holder.Destroy, holder)
end

-- A trail between two points on `part` (offsets in its space).
export type TrailStyle = {
	color: ColorSequence,
	transparency: NumberSequence,
	lifetime: number,
	width: NumberSequence?,
	texture: string?,
	faceCamera: boolean?,
	emission: number?,
	off: boolean?, -- made switched off: start it with beginTrail once its part is in place
}

function Soft.trail(part: BasePart, a: Vector3, b: Vector3, style: TrailStyle): Trail
	local a0 = Instance.new("Attachment")
	a0.Position = a
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = b
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = style.color
	trail.Transparency = sheerSequence(style.transparency)
	trail.Lifetime = style.lifetime
	trail.WidthScale = style.width or NumberSequence.new(1)
	trail.LightEmission = style.emission or 1
	trail.LightInfluence = 0
	trail.FaceCamera = style.faceCamera ~= false
	trail.MinLength = 0
	trail.Enabled = not style.off
	if style.texture then
		trail.Texture = style.texture
		trail.TextureMode = Enum.TextureMode.Stretch
		trail.TextureLength = 1
	end
	trail.Parent = part
	trail.Destroying:Connect(function()
		a0:Destroy()
		a1:Destroy()
	end)
	return trail
end

-- Starts a trail made switched off, once its part is where it should be
-- (so nothing streaks in from wherever the part was made).
function Soft.beginTrail(trail: Trail)
	if not trail.Enabled then
		trail:Clear()
		trail.Enabled = true
	end
end

-- Stops a trail and removes it once what it left behind has faded.
function Soft.endTrail(trail: Trail)
	trail.Enabled = false
	task.delay(trail.Lifetime + 0.1, trail.Destroy, trail)
end

-- Hides `part` (over `fade`) but keeps it, and whatever trails or
-- particles are on it, until `keep` seconds, so they fade out on their own.
function Soft.linger(part: BasePart, fade: number, keep: number)
	U.tween(part, fade, { Transparency = 1 })
	task.delay(keep, part.Destroy, part)
end

-- Ribbons of wind spiralling up round a moving axis: `axis(t)` gives the
-- foot and the top of it each frame (t: seconds since it started); the
-- ribbons climb it over `climb` seconds, over and over, `turns` times
-- round on the way. Each climb is a fresh ribbon (the last one left to
-- fade at the top), so nothing streaks back down the axis. Returns stop().
function Soft.helix(
	axis: (number) -> (Vector3, Vector3),
	radius: number,
	strands: number,
	climb: number,
	turns: number,
	width: number,
	duration: number,
	color: Color3?
): () -> ()
	type Runner = { part: BasePart, trail: Trail, phase: number }
	local runners: { [number]: Runner } = {}
	local function retire(runner: Runner)
		Soft.endTrail(runner.trail)
		task.delay(runner.trail.Lifetime + 0.2, runner.part.Destroy, runner.part)
	end
	local function spawnRunner(i: number, at: Vector3, phase: number): Runner
		-- Placed before its trail is attached, so the trail starts here.
		local part = U.newPart({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = CFrame.new(at) })
		local trail = Soft.trail(part, Vector3.new(0, width / 2, 0), Vector3.new(0, -width / 2, 0), {
			color = ColorSequence.new(if i % 2 == 0 then WIND_WHITE else color or WIND, color or WIND),
			transparency = NumberSequence.new({ key(0, 0.25), key(1, 1) }),
			width = NumberSequence.new({ key(0, 1), key(1, 0.2) }),
			lifetime = 0.25,
		})
		return { part = part, trail = trail, phase = phase }
	end
	local stopped = false
	local function stop()
		if stopped then
			return
		end
		stopped = true
		for i = 1, strands do
			local runner = runners[i]
			if runner then
				runners[i] = nil
				retire(runner)
			end
		end
	end
	every(duration, function(elapsed)
		if stopped then
			return false
		end
		local foot, top = axis(elapsed)
		local along = top - foot
		local length = along.Magnitude
		if length < 1e-3 then
			return true -- (no axis yet: nothing drawn)
		end
		local up = along / length
		local side = up:Cross(if math.abs(up.Y) > 0.9 then Vector3.xAxis else UP).Unit
		local other = up:Cross(side)
		for i = 1, strands do
			local phase = (elapsed / climb + (i - 1) / strands) % 1
			local angle = phase * turns * math.pi * 2 + i * 2.1
			local r = radius * (1 - phase * 0.35)
			local position = foot + up * (length * phase) + (side * math.cos(angle) + other * math.sin(angle)) * r
			local runner = runners[i]
			if runner and phase < runner.phase then
				-- Back to the foot: this ribbon is left to fade at the top.
				retire(runner)
				runner = nil
			end
			if runner then
				runner.part.CFrame = CFrame.new(position)
				runner.phase = phase
			else
				runners[i] = spawnRunner(i, position, phase)
			end
		end
		return true
	end, stop)
	return stop
end

-- A chain of sparkles streaming from one attachment to another (starlight
-- poured along a line).
function Soft.starStream(a0: Attachment, a1: Attachment, width: number, speed: number, parent: Instance?): Beam
	return softBeam(a0, a1, {
		color = ColorSequence.new(STAR_WHITE, STAR),
		width0 = width,
		width1 = width * 0.6,
		transparency = NumberSequence.new({ key(0, 0.5), key(0.15, 0.1), key(0.85, 0.1), key(1, 0.5) }),
		texture = SPARKLE,
		wrap = true,
		length = width * 1.6,
		speed = speed,
	}, parent)
end

---------------------------------------------------------------------------
-- Cuts of wind
---------------------------------------------------------------------------

-- A cut of wind through the air: a crescent from `from` to `to` bowed out
-- by `bend`. A swipe of wind streaks along it and it's left hanging: a
-- white-hot edge glittering with starlight inside a soft green glow and a
-- broad haze, wind flowing along it and wisps of wind drifting off it.
-- flare() blazes it up (just before it bursts), fade() lets it go.
export type Slash = {
	flare: () -> (),
	fade: (number) -> (),
	move: (Vector3, number) -> (),
	apex: Vector3,
	from: Vector3,
	to: Vector3,
}

function Soft.windSlash(from: Vector3, to: Vector3, bend: Vector3, scale: number, swipe: number?): Slash
	local middle = from:Lerp(to, 0.5)
	local apex = middle + bend
	local control = middle + bend * 2
	local a = worldAnchor(from, control - from)
	local m = worldAnchor(apex, to - from)
	local b = worldAnchor(to, to - control)
	local k1 = (apex - from).Magnitude * 0.42
	local k2 = (to - apex).Magnitude * 0.42
	local white = ColorSequence.new(STAR_WHITE, WIND_WHITE)
	local green = ColorSequence.new(WIND_WHITE, WIND)
	local haze = ColorSequence.new(WIND, WIND_DEEP)
	local function half(first: boolean, style: BeamStyle): Beam
		style.curve0 = if first then k1 else k2
		style.curve1 = style.curve0
		return softBeam(if first then a else m, if first then m else b, style)
	end
	local function taper(first: boolean, wide: number, thin: number): (number, number)
		if first then
			return thin, wide
		end
		return wide, thin
	end
	local function fadeEnds(first: boolean, edge: number, middleValue: number): NumberSequence
		if first then
			return NumberSequence.new({ key(0, 1), key(0.5, (edge + middleValue) / 2), key(1, middleValue) })
		end
		return NumberSequence.new({ key(0, middleValue), key(0.5, (edge + middleValue) / 2), key(1, 1) })
	end
	local beams: { Beam } = {}
	for _, first in { true, false } do
		local w0, w1 = taper(first, 0.5 * scale, 0.05)
		table.insert(
			beams,
			half(first, { color = white, width0 = w0, width1 = w1, transparency = fadeEnds(first, 0.2, 0.05) })
		)
		w0, w1 = taper(first, 0.9 * scale, 0.1)
		table.insert(
			beams,
			half(first, {
				color = ColorSequence.new(STAR_WHITE, STAR),
				width0 = w0,
				width1 = w1,
				transparency = fadeEnds(first, 0.4, 0.25),
				texture = SPARKLE,
				wrap = true,
				length = 1.4 * scale,
				speed = if first then 3 else -3,
			})
		)
		w0, w1 = taper(first, 3 * scale, 0.4)
		table.insert(
			beams,
			half(first, {
				color = green,
				width0 = w0,
				width1 = w1,
				transparency = fadeEnds(first, 0.72, 0.6),
				texture = SMOKE,
				speed = 1.5,
				length = 3,
			})
		)
		w0, w1 = taper(first, 7 * scale, 1)
		table.insert(
			beams,
			half(first, {
				color = haze,
				width0 = w0,
				width1 = w1,
				transparency = fadeEnds(first, 0.94, 0.87),
				texture = SMOKE,
				speed = -1,
				length = 6,
				emission = 0.6,
			})
		)
	end
	for _, beam in beams do
		beam.Enabled = false
	end
	-- Wisps of wind drifting off it while it hangs there.
	local wisps = windEmitter(m, {
		Size = NumberSequence.new({ key(0, 1.2 * scale), key(1, 3 * scale) }),
		Transparency = NumberSequence.new({ key(0, 1), key(0.3, 0.8), key(1, 1) }),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 2,
		Rate = 0,
	})
	-- The swipe: a ribbon of wind streaking along the curve.
	local sweep = swipe or 0.06
	local runner = U.newPart({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = CFrame.new(from) })
	local swipeTrail = Soft.trail(runner, Vector3.new(0, 1.3 * scale, 0), Vector3.new(0, -1.3 * scale, 0), {
		color = ColorSequence.new(STAR_WHITE, WIND),
		transparency = NumberSequence.new({ key(0, 0.1), key(1, 1) }),
		width = NumberSequence.new({ key(0, 1), key(1, 0.15) }),
		lifetime = 0.3,
	})
	every(sweep, function(elapsed)
		runner.CFrame = CFrame.new(quadratic(from, control, to, elapsed / sweep))
		return true
	end, function()
		runner.CFrame = CFrame.new(to)
		for _, beam in beams do
			beam.Enabled = true
		end
		wisps.Rate = 14
		Soft.endTrail(swipeTrail)
		task.delay(0.45, runner.Destroy, runner)
	end)
	local slash = { apex = apex, from = from, to = to }
	local base = Soft.widths(beams)
	function slash.flare()
		every(0.12, function(elapsed)
			Soft.scaleBeams(beams, 1 + 1.6 * math.sin(math.min(elapsed / 0.12, 1) * math.pi / 2), base)
			return true
		end)
	end
	function slash.fade(duration: number)
		wisps.Enabled = false
		fadeBeams(beams, duration, { a, m, b })
	end
	-- Carries it `offset` over `duration` (easing out), as if blown along.
	function slash.move(offset: Vector3, duration: number)
		for _, anchor in { a, m, b } do
			U.tween(anchor, duration, { CFrame = anchor.CFrame + offset })
		end
	end
	return slash
end

-- Manga focus lines: thin streaks of light rushing in toward the middle of
-- the screen for a moment (for whoever's watching it from the cutscene).
function Soft.focusLines(duration: number)
	local playerGui = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local viewport = workspace.CurrentCamera.ViewportSize
	local gui = Instance.new("ScreenGui")
	gui.Name = "FocusLines"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 45 -- under the letterbox bars
	gui.Parent = playerGui
	local half = viewport.Magnitude / 2
	local lines: { Frame } = {}
	for i = 1, 56 do
		local angle = (i / 56) * math.pi * 2 + math.random() * 0.08
		local length = half * (0.55 + math.random() * 0.35)
		local reach = half * (0.42 + math.random() * 0.2) + length / 2
		local line = Instance.new("Frame")
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Position =
			UDim2.fromOffset(viewport.X / 2 + math.cos(angle) * reach, viewport.Y / 2 + math.sin(angle) * reach)
		line.Size = UDim2.fromOffset(length, 1 + math.random() * 3)
		line.Rotation = math.deg(angle)
		line.BackgroundColor3 = if i % 7 == 0 then STAR else Color3.new(1, 1, 1)
		line.BorderSizePixel = 0
		line.BackgroundTransparency = 0.1
		local gradient = Instance.new("UIGradient")
		-- Faint where it starts nearest the middle, solid at the edge.
		gradient.Transparency = NumberSequence.new({ key(0, 1), key(0.45, 0.4), key(1, 0) })
		gradient.Parent = line
		line.Parent = gui
		table.insert(lines, line)
	end
	for _, line in lines do
		U.tween(line, duration, { BackgroundTransparency = 1 })
	end
	task.delay(duration + 0.05, gui.Destroy, gui)
end

return Soft
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">TopBar</string>
            <string name="Source"><![CDATA[--[[
	TopBar
	Buttons in Roblox's top bar, right next to the menu/chat buttons:
	  CHARACTERS  opens the character picker
	  SHIFT LOCK  toggles shift lock (same as LeftShift)
	  INFINITE AWAKENING  play testing only (Config.PlayTest)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Kits = require(Shared.Kits)
local Remotes = require(Shared.Remotes)

local ShiftLock = require(script.Parent.ShiftLock)

local localPlayer = Players.LocalPlayer

local COLORS = {
	Pill = Color3.fromRGB(0, 0, 0),
	Panel = Color3.fromRGB(14, 14, 18),
	Card = Color3.fromRGB(28, 28, 34),
	Text = Color3.fromRGB(240, 240, 240),
	SubText = Color3.fromRGB(165, 165, 175),
	On = Color3.fromRGB(90, 200, 255),
}

local TopBar = {}

local panel: Frame
local cards: { [string]: { stroke: UIStroke, badge: TextLabel } } = {}
local open = false

local function corner(parent: Instance, radius: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
end

-- A pill-shaped button styled like Roblox's own top bar buttons.
local function pillButton(parent: Instance, text: string, order: number): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = true
	button.AutomaticSize = Enum.AutomaticSize.X
	button.Size = UDim2.fromOffset(0, 44)
	button.BackgroundColor3 = COLORS.Pill
	button.BackgroundTransparency = 0.3
	button.Font = Enum.Font.GothamBold
	button.TextSize = 14
	button.TextColor3 = COLORS.Text
	button.Text = text
	button.LayoutOrder = order
	button.Parent = parent
	corner(button, UDim.new(1, 0))

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = button
	return button
end

local function selectedKit(): string
	local character = localPlayer.Character
	local id = (character and character:GetAttribute("Kit")) or localPlayer:GetAttribute("Kit")
	return if type(id) == "string" then id else Kits.Default
end

local function refreshCards()
	local current = selectedKit()
	for id, card in cards do
		local kit = Kits.List[id]
		local isCurrent = id == current
		card.stroke.Color = if isCurrent then kit.color else Color3.fromRGB(50, 50, 58)
		card.stroke.Thickness = if isCurrent then 3 else 1
		card.badge.Text = if not kit.playable then "COMING SOON" elseif isCurrent then "SELECTED" else ""
	end
end

local function setOpen(value: boolean)
	open = value
	ShiftLock.SetSuspended(open)
	if open then
		refreshCards()
		panel.Visible = true
		panel.Position = UDim2.fromOffset(16, -10)
		TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Position = UDim2.fromOffset(16, 8) })
			:Play()
	else
		panel.Visible = false
	end
end

local function buildCard(parent: Instance, kit: Kits.KitInfo, order: number)
	local card = Instance.new("TextButton")
	card.Name = kit.id
	card.AutoButtonColor = kit.playable
	card.Text = ""
	card.BackgroundColor3 = COLORS.Card
	card.LayoutOrder = order
	card.Parent = parent
	corner(card, UDim.new(0, 8))

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card

	local strip = Instance.new("Frame")
	strip.Size = UDim2.new(1, 0, 0, 6)
	strip.BackgroundColor3 = kit.color
	strip.BackgroundTransparency = if kit.playable then 0 else 0.6
	strip.BorderSizePixel = 0
	strip.Parent = card
	corner(strip, UDim.new(0, 3))

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(10, 14)
	title.Size = UDim2.new(1, -20, 0, 20)
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 15
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = if kit.playable then COLORS.Text else COLORS.SubText
	title.Text = string.upper(kit.title)
	title.Parent = card

	local description = Instance.new("TextLabel")
	description.BackgroundTransparency = 1
	description.Position = UDim2.fromOffset(10, 36)
	description.Size = UDim2.new(1, -20, 0, 44)
	description.Font = Enum.Font.Gotham
	description.TextSize = 12
	description.TextWrapped = true
	description.TextXAlignment = Enum.TextXAlignment.Left
	description.TextYAlignment = Enum.TextYAlignment.Top
	description.TextColor3 = COLORS.SubText
	description.Text = kit.description
	description.Parent = card

	local badge = Instance.new("TextLabel")
	badge.BackgroundTransparency = 1
	badge.AnchorPoint = Vector2.new(0, 1)
	badge.Position = UDim2.new(0, 10, 1, -8)
	badge.Size = UDim2.new(1, -20, 0, 14)
	badge.Font = Enum.Font.GothamBold
	badge.TextSize = 11
	badge.TextXAlignment = Enum.TextXAlignment.Left
	badge.TextColor3 = kit.color
	badge.Parent = card

	cards[kit.id] = { stroke = stroke, badge = badge }

	card.Activated:Connect(function()
		if not kit.playable then
			return
		end
		-- Picking the character you already are re-equips it (a refresh).
		Remotes.Action:FireServer("SelectKit", kit.id)
		setOpen(false)
	end)
end

local function buildPanel(gui: ScreenGui)
	panel = Instance.new("Frame")
	panel.Name = "CharacterPicker"
	panel.Size = UDim2.fromOffset(3 * 170 + 2 * 10 + 28, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.BackgroundColor3 = COLORS.Panel
	panel.BackgroundTransparency = 0.1
	panel.Visible = false
	panel.Parent = gui
	corner(panel, UDim.new(0, 12))

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.Parent = panel

	local heading = Instance.new("TextLabel")
	heading.BackgroundTransparency = 1
	heading.Size = UDim2.new(1, 0, 0, 24)
	heading.Font = Enum.Font.GothamBlack
	heading.TextSize = 18
	heading.TextXAlignment = Enum.TextXAlignment.Left
	heading.TextColor3 = COLORS.Text
	heading.Text = "CHOOSE YOUR GRIMOIRE"
	heading.Parent = panel

	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.fromOffset(0, 34)
	grid.Size = UDim2.new(1, 0, 0, 0)
	grid.AutomaticSize = Enum.AutomaticSize.Y
	grid.Parent = panel

	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(170, 112)
	layout.CellPadding = UDim2.fromOffset(10, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid

	for order, id in Kits.Order do
		local kit = Kits.List[id]
		if kit then
			buildCard(grid, kit, order)
		end
	end
end

function TopBar.Start()
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	-- Lives in the free part of Roblox's top bar, next to the chat button.
	local bar = Instance.new("ScreenGui")
	bar.Name = "TopBar"
	bar.ResetOnSpawn = false
	bar.ScreenInsets = Enum.ScreenInsets.TopbarSafeInsets
	bar.DisplayOrder = 10
	bar.Parent = playerGui

	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromScale(1, 1)
	row.Parent = bar

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row

	local charactersButton = pillButton(row, "CHARACTERS", 1)
	local shiftLockButton = pillButton(row, "SHIFT LOCK: OFF", 2)
	local infiniteButton = if Config.PlayTest.InfiniteAwakening
		then pillButton(row, "INFINITE AWAKENING: OFF", 3)
		else nil

	-- Line up exactly with Roblox's own buttons: in the 58px top bar they're
	-- 44px tall and sit 12px from the top (2px from the bottom). Computed from
	-- the bar's real height so it also lines up on smaller top bars.
	local rowPadding = Instance.new("UIPadding")
	rowPadding.PaddingLeft = UDim.new(0, 10) -- small gap after Roblox's chat button
	rowPadding.Parent = row
	local function align()
		local barHeight = row.AbsoluteSize.Y
		local buttonHeight = math.clamp(barHeight - 14, 28, 44)
		rowPadding.PaddingTop = UDim.new(0, math.max(barHeight - buttonHeight - 2, 0))
		charactersButton.Size = UDim2.fromOffset(0, buttonHeight)
		shiftLockButton.Size = UDim2.fromOffset(0, buttonHeight)
		if infiniteButton then
			infiniteButton.Size = UDim2.fromOffset(0, buttonHeight)
		end
	end
	row:GetPropertyChangedSignal("AbsoluteSize"):Connect(align)
	align()

	-- The picker opens below the top bar.
	local menus = Instance.new("ScreenGui")
	menus.Name = "Menus"
	menus.ResetOnSpawn = false
	menus.DisplayOrder = 10
	menus.Parent = playerGui
	buildPanel(menus)

	charactersButton.Activated:Connect(function()
		setOpen(not open)
	end)

	shiftLockButton.Activated:Connect(ShiftLock.Toggle)

	-- Play testing: the server keeps the state (the player's attribute).
	if infiniteButton then
		local function show()
			local on = localPlayer:GetAttribute("InfiniteAwakening") == true
			infiniteButton.Text = if on then "INFINITE AWAKENING: ON" else "INFINITE AWAKENING: OFF"
			infiniteButton.TextColor3 = if on then COLORS.On else COLORS.Text
		end
		infiniteButton.Activated:Connect(function()
			Remotes.Action:FireServer("InfiniteAwakening", localPlayer:GetAttribute("InfiniteAwakening") ~= true)
		end)
		localPlayer:GetAttributeChangedSignal("InfiniteAwakening"):Connect(show)
		show()
	end
	ShiftLock.OnChanged(function(on)
		shiftLockButton.Text = if on then "SHIFT LOCK: ON" else "SHIFT LOCK: OFF"
		shiftLockButton.TextColor3 = if on then COLORS.On else COLORS.Text
	end)

	-- Keep the "SELECTED" badge right after a switch or respawn.
	local function watch(character: Model)
		character:GetAttributeChangedSignal("Kit"):Connect(refreshCards)
		refreshCards()
	end
	localPlayer.CharacterAdded:Connect(watch)
	if localPlayer.Character then
		watch(localPlayer.Character)
	end
end

return TopBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">VFX</string>
            <string name="Source"><![CDATA[--[[
	VFX
	Every visual effect is drawn on the client. The server only sends
	("EffectName", data), so effects cost no server performance and stay
	smooth regardless of ping. Built entirely from parts, beams, particles
	and lights using textures that ship with Roblox, so no uploads needed.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)
local CameraShake = require(script.Parent.CameraShake)

local TEXTURES = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}

local COLORS = {
	Swing = Color3.fromRGB(255, 255, 255),
	Hit = Color3.fromRGB(255, 236, 190),
	Heavy = Color3.fromRGB(255, 120, 60),
	Block = Color3.fromRGB(110, 170, 255),
	Parry = Color3.fromRGB(120, 255, 255),
	GuardBreak = Color3.fromRGB(255, 170, 60),
	Dash = Color3.fromRGB(200, 225, 255),
	Evasive = Color3.fromRGB(235, 255, 255),
	Dust = Color3.fromRGB(150, 145, 135),
}

-- Characters can recolor their hit effects (VFX.SetPalette).
-- `cleanM1`: M1 hits only flash the victim and show damage (no sparks/rings).
type Palette = { hit: Color3, heavy: Color3, flash: Color3, cleanM1: boolean? }
local DEFAULT_PALETTE: Palette = { hit = COLORS.Hit, heavy = COLORS.Heavy, flash = Color3.new(1, 1, 1) }
local palettes: { [string]: Palette } = {}

local function paletteFor(data): Palette
	return (type(data.kit) == "string" and palettes[data.kit]) or DEFAULT_PALETTE
end

local localPlayer = Players.LocalPlayer

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = workspace

local VFX = {}
local Effects: { [string]: (data: any) -> () } = {}

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------

local function newPart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = fxFolder
	return part
end

local function tween(
	instance: Instance,
	duration: number,
	goals: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, goals)
	t:Play()
	return t
end

local function randomUnit(): Vector3
	local v = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
	return if v.Magnitude > 1e-3 then v.Unit else Vector3.yAxis
end

local function randomAngles(): CFrame
	return CFrame.Angles(math.random() * math.pi * 2, math.random() * math.pi * 2, math.random() * math.pi * 2)
end

local function getRoot(character: Model?): BasePart?
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function isLocal(character: Model?): boolean
	return character ~= nil and character == localPlayer.Character
end

local function groundBelow(position: Vector3, ignore: { Instance }?, depth: number?): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter: { Instance } = { fxFolder }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(filter, player.Character)
		end
	end
	local dummies = workspace:FindFirstChild("Dummies")
	if dummies then
		table.insert(filter, dummies)
	end
	if ignore then
		for _, instance in ignore do
			table.insert(filter, instance)
		end
	end
	params.FilterDescendantsInstances = filter
	return workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -(depth or 14), 0), params)
end

type BurstOptions = {
	texture: string?,
	color: Color3?,
	count: number?,
	size: number?,
	speed: NumberRange?,
	lifetime: NumberRange?,
	lightEmission: number?,
	transparency: number?,
	drag: number?,
	acceleration: Vector3?,
	spread: number?,
	streaks: boolean?,
	direction: Vector3?, -- aim the spread cone this way (default: straight up)
}

-- One-shot particle burst at a point.
local function burst(position: Vector3, options: BurstOptions)
	local cframe = if options.direction
		then CFrame.lookAt(position, position + options.direction)
		else CFrame.new(position)
	local holder = newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = cframe })
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder

	local lifetime = options.lifetime or NumberRange.new(0.15, 0.35)
	local size = options.size or 1

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = options.texture or TEXTURES.Spark
	emitter.Color = ColorSequence.new(options.color or COLORS.Hit)
	emitter.LightEmission = options.lightEmission or 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(options.transparency or 0, 1)
	emitter.Lifetime = lifetime
	emitter.Speed = options.speed or NumberRange.new(20, 40)
	emitter.SpreadAngle = Vector2.one * (options.spread or 180)
	emitter.Drag = options.drag or 5
	emitter.Acceleration = options.acceleration or Vector3.zero
	if options.direction then
		emitter.EmissionDirection = Enum.NormalId.Front
	end
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	if options.streaks then
		-- Stretch along travel direction for speed-line sparks.
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		emitter.Squash = NumberSequence.new(1.5)
	end
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(options.count or 12)

	Debris:AddItem(holder, lifetime.Max + 0.5)
end

-- Expanding glowing ball.
local function flash(position: Vector3, color: Color3, size: number, duration: number)
	local ball = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size * 0.3,
		CFrame = CFrame.new(position),
		Color = color,
		Transparency = 0.1,
	})
	tween(ball, duration, { Size = Vector3.one * size, Transparency = 1 })
	Debris:AddItem(ball, duration + 0.05)
end

-- Ring of thin neon segments expanding outward in the cframe's XZ plane.
local function ringBurst(
	cframe: CFrame,
	color: Color3,
	startRadius: number,
	endRadius: number,
	duration: number,
	thickness: number?
)
	local segments = 16
	local width = thickness or 0.2
	for i = 1, segments do
		local spin = CFrame.Angles(0, (i / segments) * math.pi * 2, 0)
		local startLength = (2 * math.pi * startRadius / segments) * 1.15
		local endLength = (2 * math.pi * endRadius / segments) * 1.15
		local segment = newPart({
			Size = Vector3.new(startLength, width, width),
			CFrame = cframe * spin * CFrame.new(0, 0, -startRadius),
			Color = color,
			Transparency = 0.05,
		})
		tween(segment, duration, {
			Size = Vector3.new(endLength, width * 0.2, width * 0.2),
			CFrame = cframe * spin * CFrame.new(0, 0, -endRadius),
			Transparency = 1,
		})
		Debris:AddItem(segment, duration + 0.05)
	end
end

-- A ring facing along `direction`, for impacts.
local function impactRing(position: Vector3, direction: Vector3, color: Color3, startRadius, endRadius, duration)
	local cframe = CFrame.lookAt(position, position + direction) * CFrame.Angles(math.rad(90), 0, 0)
	ringBurst(cframe, color, startRadius, endRadius, duration, 0.18)
end

local function light(position: Vector3, color: Color3, brightness: number, range: number, duration: number)
	local holder = newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(position) })
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Brightness = brightness
	pointLight.Range = range
	pointLight.Shadows = false
	pointLight.Parent = holder
	tween(pointLight, duration, { Brightness = 0 })
	Debris:AddItem(holder, duration + 0.05)
end

-- Body glow on hit: a near-solid flash. `fill` (the fill's transparency)
-- lightens it, for a coat on someone's own character that should leave
-- their avatar showing through.
local function highlight(character: Model?, color: Color3, duration: number, fill: number?)
	if not character then
		return
	end
	local h = Instance.new("Highlight")
	h.Adornee = character
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = fill or 0.15
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = fxFolder
	tween(h, duration, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(h, duration + 0.05)
end

-- Neon ghost copy of a character that fades out (`offset` from where he is).
local function afterimage(character: Model, color: Color3, duration: number, offset: Vector3?)
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local ghost = part:Clone()
			if ghost then
				for _, child in ghost:GetChildren() do
					if not child:IsA("DataModelMesh") then
						child:Destroy()
					end
				end
				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanQuery = false
				ghost.CanTouch = false
				ghost.CastShadow = false
				ghost.Massless = true
				if offset then
					ghost.CFrame = part.CFrame + offset
				end
				ghost.Material = Enum.Material.Neon
				ghost.Color = color
				ghost.Transparency = 0.35
				if ghost:IsA("MeshPart") then
					ghost.TextureID = ""
				end
				ghost.Parent = fxFolder
				tween(ghost, duration, { Transparency = 1 })
				Debris:AddItem(ghost, duration + 0.05)
			end
		end
	end
end

-- Wind trail streaming off a flying character.
local function bodyTrail(character: Model?, color: Color3, duration: number)
	local root = getRoot(character)
	if not root then
		return
	end
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, 1.2, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -1.2, 0)
	bottom.Parent = root

	local trail = Instance.new("Trail")
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(color)
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Lifetime = 0.25
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.FaceCamera = true
	trail.Parent = root

	task.delay(duration, function()
		trail.Enabled = false
		task.wait(trail.Lifetime)
		trail:Destroy()
		top:Destroy()
		bottom:Destroy()
	end)
end

-- Flying shards (unanchored, local physics only).
local function shards(position: Vector3, color: Color3, count: number)
	for _ = 1, count do
		local shard = newPart({
			Size = Vector3.new(0.25, 0.6 + math.random() * 0.6, 0.08),
			CFrame = CFrame.new(position) * randomAngles(),
			Color = color,
			Material = Enum.Material.Glass,
			Transparency = 0.1,
		})
		shard.Anchored = false
		shard.AssemblyLinearVelocity = randomUnit() * (20 + math.random() * 15) + Vector3.new(0, 15, 0)
		shard.AssemblyAngularVelocity = randomUnit() * 20
		tween(shard, 0.6, { Transparency = 1, Size = shard.Size * 0.3 })
		Debris:AddItem(shard, 0.65)
	end
end

-- Rocks bursting up from the ground in a ring, plus dust.
local function groundRocks(position: Vector3, count: number, radius: number, maxSize: number)
	local ground = groundBelow(position)
	if not ground then
		return
	end
	local hitPart = ground.Instance
	local color = if hitPart:IsA("BasePart") then hitPart.Color else COLORS.Dust
	local material = ground.Material

	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.3
		local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (radius + math.random() * 1.5)
		local size = maxSize * (0.5 + math.random() * 0.5)
		local resting = CFrame.new(ground.Position + offset)
			* CFrame.Angles(math.random() * 0.8, math.random() * math.pi, math.random() * 0.8)
		local rock = newPart({
			Size = Vector3.one * size,
			CFrame = resting - Vector3.new(0, size, 0),
			Color = color,
			Material = material,
		})
		rock.CastShadow = true
		tween(rock, 0.15, { CFrame = resting }, Enum.EasingStyle.Back)
		task.delay(1.6 + math.random() * 0.4, function()
			tween(
				rock,
				0.5,
				{ CFrame = resting - Vector3.new(0, size * 1.2, 0) },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
		end)
		Debris:AddItem(rock, 2.6)
	end

	burst(ground.Position, {
		texture = TEXTURES.Smoke,
		color = color:Lerp(Color3.new(1, 1, 1), 0.3),
		count = 14,
		size = 4,
		speed = NumberRange.new(8, 18),
		lifetime = NumberRange.new(0.6, 1.2),
		lightEmission = 0,
		transparency = 0.4,
		drag = 3,
		spread = 80,
	})
end

-- "PERFECT", damage numbers, etc.
local function popup(position: Vector3, text: string, color: Color3, scale: number?)
	local holder = newPart({
		Size = Vector3.one * 0.2,
		Transparency = 1,
		CFrame = CFrame.new(position + Vector3.new((math.random() - 0.5) * 2, 1, (math.random() - 0.5) * 2)),
	})

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160 * (scale or 1), 48 * (scale or 1))
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Parent = holder

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui

	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1.7
	uiScale.Parent = label
	tween(uiScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

	tween(holder, 0.9, { CFrame = holder.CFrame + Vector3.new(0, 2.5, 0) })
	task.delay(0.45, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(holder, 0.95)
end

local function screenFlash(color: Color3, duration: number)
	local correction = Instance.new("ColorCorrectionEffect")
	correction.TintColor = color
	correction.Brightness = 0.2
	correction.Parent = workspace.CurrentCamera
	tween(correction, duration, { TintColor = Color3.new(1, 1, 1), Brightness = 0 })
	Debris:AddItem(correction, duration + 0.05)
end

-- Four-point star glint facing the camera (metal catching the light).
local function glint(position: Vector3, scale: number, color: Color3?)
	local camera = workspace.CurrentCamera
	local base = CFrame.lookAt(position, camera.CFrame.Position)
	local tint = color or Color3.fromRGB(255, 236, 190)
	for i = 0, 1 do
		local bar = newPart({
			Size = Vector3.new(0.1, 0.1, 0.04),
			CFrame = base * CFrame.Angles(0, 0, math.rad(45 + i * 90)),
			Color = tint,
		})
		tween(bar, 0.05, { Size = Vector3.new((if i == 0 then 3.4 else 2.2) * scale, 0.14 * scale, 0.04) })
		task.delay(0.05, function()
			tween(
				bar,
				0.14,
				{ Size = Vector3.new(0.2, 0.02, 0.02), Transparency = 1 },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
		end)
		Debris:AddItem(bar, 0.22)
	end
	flash(position, tint, 1.4 * scale, 0.1)
end

local SPARK_COLORS = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 250, 225)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 205, 90)),
	ColorSequenceKeypoint.new(0.65, Color3.fromRGB(255, 125, 25)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 35, 10)),
})

--[[
	Molten metal sparks, for sword clashes: hot streaks that fly out along
	`direction` and arc down under gravity, slower embers that linger, a
	glint, a flash of orange light and a puff of metal dust.
]]
local function sparks(position: Vector3, direction: Vector3, scale: number?)
	local k = scale or 1
	local aim = if direction.Magnitude > 1e-3 then direction.Unit else Vector3.yAxis
	local holder =
		newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.lookAt(position, position + aim) })
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder

	local streaks = Instance.new("ParticleEmitter")
	streaks.Texture = TEXTURES.Spark
	streaks.Color = SPARK_COLORS
	streaks.LightEmission = 1
	streaks.LightInfluence = 0
	streaks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.24 * k), NumberSequenceKeypoint.new(1, 0) })
	streaks.Squash = NumberSequence.new(2.5)
	streaks.Orientation = Enum.ParticleOrientation.VelocityParallel
	streaks.EmissionDirection = Enum.NormalId.Front
	streaks.SpreadAngle = Vector2.new(55, 55)
	streaks.Speed = NumberRange.new(30 * k, 62 * k)
	streaks.Acceleration = Vector3.new(0, -95, 0)
	streaks.Drag = 1.5
	streaks.Lifetime = NumberRange.new(0.25, 0.55)
	streaks.Enabled = false
	streaks.Parent = attachment
	streaks:Emit(math.floor(26 * k))

	local embers = Instance.new("ParticleEmitter")
	embers.Texture = TEXTURES.Spark
	embers.Color = SPARK_COLORS
	embers.LightEmission = 1
	embers.LightInfluence = 0
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3 * k), NumberSequenceKeypoint.new(1, 0) })
	embers.EmissionDirection = Enum.NormalId.Front
	embers.SpreadAngle = Vector2.new(85, 85)
	embers.Speed = NumberRange.new(6 * k, 16 * k)
	embers.Acceleration = Vector3.new(0, -45, 0)
	embers.Drag = 2
	embers.Lifetime = NumberRange.new(0.5, 1)
	embers.Rotation = NumberRange.new(0, 360)
	embers.RotSpeed = NumberRange.new(-300, 300)
	embers.Enabled = false
	embers.Parent = attachment
	embers:Emit(math.floor(10 * k))

	glint(position, k)
	light(position, Color3.fromRGB(255, 160, 60), 7 * k, 12 * k, 0.22)
	burst(position, {
		texture = TEXTURES.Smoke,
		color = Color3.fromRGB(150, 140, 130),
		count = 3,
		size = 1.2 * k,
		speed = NumberRange.new(2, 5),
		lifetime = NumberRange.new(0.3, 0.6),
		lightEmission = 0,
		transparency = 0.6,
		drag = 3,
	})
	Debris:AddItem(holder, 1.2)
end

-- Thin white speed lines rushing past a moving character for `duration`.
-- Without a direction they follow the way it's actually moving (curves).
local function speedLines(root: BasePart, direction: Vector3?, duration: number, color: Color3?)
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < duration and root.Parent do
			local heading = direction or root.AssemblyLinearVelocity
			local aim = if heading.Magnitude > 1 then heading.Unit else root.CFrame.LookVector
			for _ = 1, 3 do
				local offset = randomUnit() * Vector3.new(2.6, 2.2, 2.6)
				local from = root.Position + offset + aim * 4
				local line = newPart({
					Size = Vector3.new(0.05, 0.05, 2.5 + math.random() * 2),
					CFrame = CFrame.lookAt(from, from + aim),
					Color = color or Color3.new(1, 1, 1),
					Transparency = 0.25,
				})
				tween(line, 0.16, {
					CFrame = CFrame.lookAt(from - aim * 9, from - aim * 8),
					Transparency = 1,
				}, Enum.EasingStyle.Linear)
				Debris:AddItem(line, 0.18)
			end
			task.wait(0.035)
		end
	end)
end

-- Expanding sphere shell; centered on the ground it reads as a dome.
-- ForceField material gives a shimmering wave, Glass a solid-looking shell.
local function shockwave(
	position: Vector3,
	color: Color3,
	fromSize: number,
	toSize: number,
	duration: number,
	material: Enum.Material?,
	transparency: number?
)
	local ball = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * fromSize,
		CFrame = CFrame.new(position),
		Color = color,
		Material = material or Enum.Material.ForceField,
		Transparency = transparency or 0,
	})
	tween(ball, duration, { Size = Vector3.one * toSize, Transparency = 1 }, Enum.EasingStyle.Quart)
	Debris:AddItem(ball, duration + 0.05)
end

--[[
	Jagged cracks splitting outward across the ground from `position`. Each
	crack grows segment by segment, glows `glow` inside for a moment, then
	stays dark for `duration` before fading.
]]
local function groundCracks(position: Vector3, count: number, length: number, glow: Color3?, duration: number?)
	local ground = groundBelow(position)
	if not ground then
		return
	end
	local floor = ground.Position + Vector3.new(0, 0.04, 0)
	local life = duration or 2.5
	local dark = Color3.fromRGB(14, 13, 13)

	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + (math.random() - 0.5) * 0.7
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local point = floor + direction * (0.5 + math.random() * 0.8)
		local remaining = length * (0.6 + math.random() * 0.5)
		local width = 0.42
		local delay = 0
		while remaining > 0.3 do
			local segment = math.min(remaining, 1.1 + math.random() * 1.5)
			direction = CFrame.Angles(0, (math.random() - 0.5) * 1.1, 0):VectorToWorldSpace(direction)
			local nextPoint = point + direction * segment
			local from, to, w = point, nextPoint, width
			task.delay(delay, function()
				local look = CFrame.lookAt(from, to)
				local crack = newPart({
					Size = Vector3.new(w, 0.06, 0.05),
					CFrame = look,
					Color = dark,
					Material = Enum.Material.SmoothPlastic,
				})
				tween(crack, 0.06, {
					Size = Vector3.new(w, 0.06, segment + w * 0.5),
					CFrame = look * CFrame.new(0, 0, -segment / 2),
				}, Enum.EasingStyle.Linear)
				if glow then
					local hot = newPart({
						Size = Vector3.new(w * 0.45, 0.08, segment + w * 0.4),
						CFrame = look * CFrame.new(0, 0.01, -segment / 2),
						Color = glow,
						Transparency = 0.05,
					})
					tween(hot, 0.9, { Transparency = 1, Size = Vector3.new(0.02, 0.08, segment) })
					Debris:AddItem(hot, 0.95)
				end
				task.delay(life, function()
					tween(crack, 0.6, { Transparency = 1 })
				end)
				Debris:AddItem(crack, life + 0.65)
			end)
			point = nextPoint
			remaining -= segment
			width *= 0.72
			delay += 0.03
		end
	end
end

--[[
	Chunks of the ground blasted out of `position`: they fly out, fall,
	bounce once and settle, then sink away. Simulated here (no physics
	parts), so they never shove characters around.
]]
local function debris(position: Vector3, count: number, speed: number, size: number)
	local ground = groundBelow(position)
	if not ground then
		return -- nothing to blast out of in mid-air
	end
	local color = if ground.Instance:IsA("BasePart") then ground.Instance.Color else COLORS.Dust
	local material = ground.Material
	local floorY = ground.Position.Y
	local gravity = workspace.Gravity * 0.8

	local chunks = {}
	for _ = 1, count do
		local s = size * (0.35 + math.random() * 0.65)
		local angle = math.random() * math.pi * 2
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local part = newPart({
			Size = Vector3.new(s, s * (0.55 + math.random() * 0.5), s * (0.7 + math.random() * 0.4)),
			CFrame = CFrame.new(Vector3.new(position.X, floorY + s / 2, position.Z) + out * 0.8) * randomAngles(),
			Color = color,
			Material = material,
		})
		part.CastShadow = true
		table.insert(chunks, {
			part = part,
			velocity = out * speed * (0.45 + math.random() * 0.6)
				+ Vector3.new(0, speed * (0.55 + math.random() * 0.7), 0),
			spin = randomUnit() * (5 + math.random() * 10),
			bounced = false,
			resting = false,
		})
	end

	local start = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		for _, chunk in chunks do
			if not chunk.resting then
				chunk.velocity -= Vector3.new(0, gravity * dt, 0)
				local cframe = chunk.part.CFrame
				local nextPosition = cframe.Position + chunk.velocity * dt
				local half = chunk.part.Size.Y / 2
				if chunk.velocity.Y < 0 and nextPosition.Y - half < floorY then
					nextPosition = Vector3.new(nextPosition.X, floorY + half * 0.6, nextPosition.Z)
					if chunk.bounced or chunk.velocity.Y > -20 then
						chunk.resting = true
					else
						chunk.bounced = true
						chunk.velocity =
							Vector3.new(chunk.velocity.X * 0.35, -chunk.velocity.Y * 0.28, chunk.velocity.Z * 0.35)
						chunk.spin *= 0.4
					end
				end
				local spin = chunk.spin * dt
				chunk.part.CFrame = CFrame.new(nextPosition) * cframe.Rotation * CFrame.Angles(spin.X, spin.Y, spin.Z)
			end
		end
		if os.clock() - start > 2.2 then
			connection:Disconnect()
			for _, chunk in chunks do
				local part = chunk.part
				tween(part, 0.6, { CFrame = part.CFrame - Vector3.new(0, part.Size.Y, 0), Transparency = 1 })
				Debris:AddItem(part, 0.65)
			end
		end
	end)
end

-- A column of energy shooting up out of the ground, then thinning out.
local function pillar(
	position: Vector3,
	color: Color3,
	radius: number,
	height: number,
	duration: number,
	material: Enum.Material?,
	transparency: number?
)
	-- Cylinders run along X; turn X up.
	local base = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	local column = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = base,
		Color = color,
		Material = material or Enum.Material.Neon,
		Transparency = transparency or 0.05,
	})
	local rise = duration * 0.25
	tween(column, rise, {
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = base * CFrame.new(height / 2, 0, 0),
	}, Enum.EasingStyle.Quart)
	task.delay(rise, function()
		tween(column, duration - rise, {
			Size = Vector3.new(height * 1.15, 0.1, 0.1),
			CFrame = base * CFrame.new(height * 0.58, 0, 0),
			Transparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	Debris:AddItem(column, duration + 0.05)
end

--[[
	Ribbons spiralling around `anchor` (following it) for `duration`: they
	climb from `height` below to `height` above (negative height spirals
	down) while the radius closes in by `tighten` (0 to 1).
]]
local function spiral(
	anchor: BasePart,
	color: Color3,
	radius: number,
	height: number,
	duration: number,
	strands: number?,
	width: number?,
	tighten: number?
)
	local count = strands or 3
	local w = width or 0.45
	local glows = color.R + color.G + color.B > 0.3
	local ribbons: { BasePart } = {}
	for _ = 1, count do
		local part = newPart({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = anchor.CFrame })
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, w / 2, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -w / 2, 0)
		a1.Parent = part
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(color)
		trail.LightEmission = if glows then 1 else 0
		trail.LightInfluence = 0
		trail.Lifetime = 0.22
		trail.MinLength = 0
		trail.FaceCamera = true
		trail.Transparency = NumberSequence.new(if glows then 0.15 else 0.05, 1)
		trail.WidthScale = NumberSequence.new(1, 0)
		trail.Parent = part
		table.insert(ribbons, part)
	end
	local close = tighten or 0.5
	local turns = 2.2
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - start) / duration
		if t >= 1 or not anchor.Parent then
			connection:Disconnect()
			for _, part in ribbons do
				for _, child in part:GetChildren() do
					if child:IsA("Trail") then
						child.Enabled = false
					end
				end
				Debris:AddItem(part, 0.3)
			end
			return
		end
		local r = radius * (1 - t * close)
		for i, part in ribbons do
			local angle = t * math.pi * 2 * turns + (i / count) * math.pi * 2
			part.CFrame = CFrame.new(
				anchor.Position + Vector3.new(math.cos(angle) * r, -height + height * 2 * t, math.sin(angle) * r)
			)
		end
	end)
end

--[[
	A jagged lightning bolt from `from` to `to`: a `color` core inside a
	wider `glow` sheath (optional), with a side branch, flickering out over
	`duration`. Dark colors use a matte core so black lightning stays black.
]]
local function lightning(
	from: Vector3,
	to: Vector3,
	color: Color3,
	glow: Color3?,
	thickness: number?,
	duration: number?,
	branch: boolean?
)
	local width = thickness or 0.16
	local life = duration or 0.2
	local offset = to - from
	local length = offset.Magnitude
	if length < 0.1 then
		return
	end
	local segments = math.clamp(math.floor(length / 1.1), 3, 12)
	local points = { from }
	for i = 1, segments - 1 do
		table.insert(points, from + offset * (i / segments) + randomUnit() * length * 0.09)
	end
	table.insert(points, to)

	local matte = color.R + color.G + color.B < 0.3
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local segment = (b - a).Magnitude
		local cframe = CFrame.lookAt((a + b) / 2, b)
		local core = newPart({
			Size = Vector3.new(width, width, segment + width),
			CFrame = cframe,
			Color = color,
			Material = if matte then Enum.Material.SmoothPlastic else Enum.Material.Neon,
		})
		tween(
			core,
			life,
			{ Transparency = 1, Size = Vector3.new(width * 0.3, width * 0.3, segment) },
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		)
		Debris:AddItem(core, life + 0.05)
		if glow then
			local sheath = newPart({
				Size = Vector3.new(width * 3.2, width * 3.2, segment + width * 2),
				CFrame = cframe,
				Color = glow,
				Transparency = 0.55,
			})
			tween(sheath, life * 0.8, { Transparency = 1, Size = Vector3.new(width, width, segment) })
			Debris:AddItem(sheath, life + 0.05)
		end
	end

	if branch ~= false and length > 3 and #points > 3 then
		local fork = points[math.random(2, #points - 2)]
		local direction = (offset.Unit + randomUnit() * 1.2).Unit
		lightning(fork, fork + direction * length * 0.4, color, glow, width * 0.7, life * 0.85, false)
	end
end

--[[
	An impact star: spikes of light shooting out of a point, square to the
	eye (the radiating lines of a manga impact), sharp and thin, flung out
	and thinning away. `color` is their glow, `core` (default white) the
	bright line down each one.
]]
local function impactSpikes(
	position: Vector3,
	color: Color3,
	count: number,
	length: number,
	duration: number,
	core: Color3?
)
	local camera = workspace.CurrentCamera
	local facing = CFrame.lookAt(position, camera.CFrame.Position)
	local slice = math.pi * 2 / count
	local grow = math.min(0.05, duration * 0.3)
	for i = 1, count do
		local angle = i * slice + (math.random() - 0.5) * slice * 0.7
		local reach = length * (0.45 + math.random() * 0.55)
		local start = length * 0.12
		local spoke = facing * CFrame.Angles(0, 0, angle)
		local width = 0.12 + reach * 0.035
		for layer = 1, 2 do
			local w = if layer == 1 then width * 2.6 else width
			-- (the bright line just in front of its glow, toward the eye)
			local z = if layer == 1 then 0 else -0.02
			local spike = newPart({
				Size = Vector3.new(0.05, w, 0.03),
				CFrame = spoke * CFrame.new(start, 0, z),
				Color = if layer == 1 then color else core or Color3.new(1, 1, 1),
				Transparency = if layer == 1 then 0.35 else 0,
			})
			tween(spike, grow, {
				Size = Vector3.new(reach, w, 0.03),
				CFrame = spoke * CFrame.new(start + reach / 2, 0, z),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			task.delay(grow, function()
				tween(spike, duration - grow, {
					Size = Vector3.new(reach * 1.1, 0.02, 0.02),
					CFrame = spoke * CFrame.new(start + reach * 0.85, 0, z),
					Transparency = 1,
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end)
			Debris:AddItem(spike, duration + 0.05)
		end
	end
end

--[[
	A wave of dust rolling out along the ground from `position` to about
	`radius` studs: puffs thrown out low all round, swelling as they slow.
	Coloured like the ground unless `color` says otherwise.
]]
local function dustWave(position: Vector3, radius: number, color: Color3?, puffs: number?)
	local ground = groundBelow(position)
	if not ground then
		return
	end
	local floor = ground.Position + Vector3.new(0, 0.5, 0)
	local dust = color
		or (if ground.Instance:IsA("BasePart") then ground.Instance.Color else COLORS.Dust):Lerp(
			Color3.new(1, 1, 1),
			0.35
		)
	local holder = newPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(floor) })
	local n = puffs or 14
	for i = 1, n do
		local angle = (i / n) * math.pi * 2 + math.random() * 0.4
		local out = Vector3.new(math.cos(angle), 0.08, math.sin(angle)).Unit
		local attachment = Instance.new("Attachment")
		attachment.CFrame = CFrame.lookAt(Vector3.zero, out)
		attachment.Parent = holder
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = TEXTURES.Smoke
		emitter.Color = ColorSequence.new(dust)
		emitter.LightEmission = 0
		emitter.LightInfluence = 0.6
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, radius * 0.12 + 0.6),
			NumberSequenceKeypoint.new(1, radius * 0.32 + 1.5),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(0.6, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.6, 1)
		emitter.Speed = NumberRange.new(radius * 2.2, radius * 3.2)
		emitter.Drag = 3
		emitter.SpreadAngle = Vector2.new(10, 4)
		emitter.EmissionDirection = Enum.NormalId.Front
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-60, 60)
		emitter.Enabled = false
		emitter.Parent = attachment
		emitter:Emit(2)
	end
	Debris:AddItem(holder, 1.1)
end

--[[
	A scorch mark on the ground under a big impact: a dark burn (darker in
	the middle) with a ring glowing `glow` as it cools, left lying there for
	`duration` before it fades. Lies flat on whatever slope it's on.
]]
local function scorch(position: Vector3, radius: number, glow: Color3?, duration: number?)
	local ground = groundBelow(position)
	if not ground then
		return
	end
	local life = duration or 2.5
	-- Cylinders run along X: X along the ground's normal.
	local frame = CFrame.lookAt(ground.Position, ground.Position + ground.Normal) * CFrame.Angles(0, math.rad(90), 0)
	local marks = {
		{ radius = radius, color = Color3.fromRGB(22, 20, 20), transparency = 0.45, lift = 0.03 },
		{ radius = radius * 0.6, color = Color3.fromRGB(10, 9, 9), transparency = 0.25, lift = 0.045 },
	}
	for _, mark in marks do
		local disc = newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.02, mark.radius * 1.3, mark.radius * 1.3),
			CFrame = frame * CFrame.new(mark.lift, 0, 0),
			Color = mark.color,
			Material = Enum.Material.SmoothPlastic,
			Transparency = mark.transparency,
		})
		tween(disc, 0.12, { Size = Vector3.new(0.02, mark.radius * 2, mark.radius * 2) })
		task.delay(life, function()
			tween(disc, 0.8, { Transparency = 1 })
		end)
		Debris:AddItem(disc, life + 0.85)
	end
	if glow then
		local ember = newPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.02, radius * 1.4, radius * 1.4),
			CFrame = frame * CFrame.new(0.06, 0, 0),
			Color = glow,
			Transparency = 0.3,
		})
		tween(ember, 0.9, { Size = Vector3.new(0.02, radius * 0.6, radius * 0.6), Transparency = 1 })
		Debris:AddItem(ember, 0.95)
	end
end

--[[
	A groove torn into the ground from `from` to `to`, following the ground
	(and skipping where it drops away): a dark channel with a core glowing
	`glow` as it cools, left lying there for `duration`. With `speed` it's
	torn along at that many studs a second instead of all at once.
]]
local function groove(from: Vector3, to: Vector3, width: number, glow: Color3?, duration: number?, speed: number?)
	local life = duration or 2
	local span = (to - from).Magnitude
	local steps = math.max(math.ceil(span / 2.5), 1)
	local up = Vector3.new(0, 0.05, 0)
	local floors: { Vector3 | false } = {}
	for i = 0, steps do
		local ground = groundBelow(from:Lerp(to, i / steps), nil, 10)
		floors[i + 1] = if ground then ground.Position else false
	end
	for i = 1, steps do
		local a, b = floors[i], floors[i + 1]
		if a and b and math.abs(a.Y - b.Y) < 2.5 then
			local function cut()
				local length = (b - a).Magnitude
				local look = CFrame.lookAt((a + b) / 2 + up, b + up)
				local channel = newPart({
					Size = Vector3.new(width, 0.07, length + width * 0.4),
					CFrame = look,
					Color = Color3.fromRGB(14, 13, 13),
					Material = Enum.Material.SmoothPlastic,
				})
				task.delay(life, function()
					tween(channel, 0.6, { Transparency = 1 })
				end)
				Debris:AddItem(channel, life + 0.65)
				if glow then
					local hot = newPart({
						Size = Vector3.new(width * 0.4, 0.09, length + width * 0.3),
						CFrame = look + Vector3.new(0, 0.01, 0),
						Color = glow,
						Transparency = 0.05,
					})
					tween(hot, 0.9, { Transparency = 1, Size = Vector3.new(0.04, 0.09, length) })
					Debris:AddItem(hot, 0.95)
				end
			end
			if speed then
				task.delay(span * (i - 1) / steps / speed, cut)
			else
				cut()
			end
		end
	end
end

-- A full-screen color grade for the local camera: eases into `goal`
-- (ColorCorrectionEffect properties), holds, then eases back out.
local function colorGrade(goal: { [string]: any }, fadeIn: number, hold: number, fadeOut: number)
	local correction = Instance.new("ColorCorrectionEffect")
	correction.Parent = workspace.CurrentCamera
	if fadeIn <= 0 then
		for key, value in goal do
			(correction :: any)[key] = value
		end
	else
		tween(correction, fadeIn, goal, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	end
	task.delay(fadeIn + hold, function()
		tween(correction, fadeOut, {
			Brightness = 0,
			Contrast = 0,
			Saturation = 0,
			TintColor = Color3.new(1, 1, 1),
		})
	end)
	Debris:AddItem(correction, fadeIn + hold + fadeOut + 0.05)
end

---------------------------------------------------------------------------
-- Effects (names match what the server sends)
---------------------------------------------------------------------------

-- M1 hit for kits with a clean style: a quick body flash and the number.
local function cleanM1Hit(data, heavy: boolean): boolean
	local palette = paletteFor(data)
	if not palette.cleanM1 or data.variant == nil then
		return false
	end
	highlight(data.victim, Color3.new(1, 1, 1), if heavy then 0.18 else 0.1)
	if data.damage then
		popup(data.position, string.format("%g", data.damage), Color3.new(1, 1, 1), if heavy then 1.2 else 1)
	end
	-- Finishers get a touch of motion: a small burst in the launch direction.
	local victimRoot = getRoot(data.victim)
	if victimRoot and (data.variant == "Uppercut" or data.variant == "Downslam") then
		local up = data.variant == "Uppercut"
		local direction = if up then Vector3.yAxis else -Vector3.yAxis
		burst(victimRoot.Position, {
			color = Color3.new(1, 1, 1),
			count = 6,
			size = 0.45,
			speed = NumberRange.new(18, 30),
			lifetime = NumberRange.new(0.12, 0.22),
			streaks = true,
			spread = 22,
			direction = direction,
		})
		ringBurst(CFrame.new(victimRoot.Position - direction * 1.2), Color3.new(1, 1, 1), 0.6, 2.4, 0.18, 0.08)
		bodyTrail(data.victim, Color3.new(1, 1, 1), if up then 0.45 else 0.3)
	end
	if heavy and (isLocal(data.attacker) or isLocal(data.victim)) then
		CameraShake.FovKick(4)
	end
	return true
end

function Effects.Hit(data)
	if cleanM1Hit(data, false) then
		return
	end
	local position: Vector3 = data.position
	local direction: Vector3 = data.direction or Vector3.zAxis
	local palette = paletteFor(data)

	burst(position, {
		color = palette.hit,
		count = 10,
		size = 0.9,
		speed = NumberRange.new(20, 38),
		streaks = true,
	})
	flash(position, palette.flash, 3.2, 0.12)
	impactRing(position, direction, palette.flash, 0.5, 2.8, 0.18)
	light(position, palette.hit, 4, 10, 0.15)
	highlight(data.victim, Color3.new(1, 1, 1), 0.15)
	if data.damage then
		popup(position, string.format("%g", data.damage), Color3.new(1, 1, 1))
	end
end

function Effects.HeavyHit(data)
	if cleanM1Hit(data, true) then
		return
	end
	local position: Vector3 = data.position
	local direction: Vector3 = data.direction or Vector3.zAxis
	local palette = paletteFor(data)

	burst(position, {
		color = palette.heavy,
		count = 22,
		size = 1.4,
		speed = NumberRange.new(30, 60),
		lifetime = NumberRange.new(0.2, 0.45),
		streaks = true,
	})
	burst(position, {
		color = Color3.new(1, 1, 1),
		count = 8,
		size = 2,
		speed = NumberRange.new(5, 12),
	})
	flash(position, palette.flash, 6.5, 0.18)
	impactRing(position, direction, palette.heavy, 0.8, 5.5, 0.25)
	task.delay(0.06, impactRing, position, direction, palette.flash, 0.5, 4, 0.22)
	light(position, palette.heavy, 8, 18, 0.3)
	highlight(data.victim, palette.heavy, 0.25)
	if data.damage then
		popup(position, string.format("%g", data.damage), palette.heavy, 1.3)
	end

	if data.variant == "Knockback" or data.variant == "Uppercut" or data.variant == nil then
		bodyTrail(data.victim, Color3.new(1, 1, 1), 0.6)
	end
	if isLocal(data.attacker) or isLocal(data.victim) then
		CameraShake.FovKick(8)
	end
end

function Effects.Block(data)
	local position: Vector3 = data.position
	local root = getRoot(data.victim)

	burst(position, {
		color = COLORS.Block,
		count = 8,
		size = 0.7,
		speed = NumberRange.new(12, 25),
	})
	if root then
		local shield = newPart({
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.ForceField,
			Color = COLORS.Block,
			Size = Vector3.one * 5,
			CFrame = root.CFrame,
		})
		tween(shield, 0.25, { Size = Vector3.one * 6.5, Transparency = 1 })
		Debris:AddItem(shield, 0.3)
	end
	highlight(data.victim, COLORS.Block, 0.12)
end

function Effects.PerfectBlock(data)
	local position: Vector3 = data.position
	local victimRoot = getRoot(data.victim)
	local direction = if victimRoot then victimRoot.CFrame.LookVector else Vector3.zAxis

	flash(position, COLORS.Parry, 8, 0.25)
	impactRing(position, direction, COLORS.Parry, 1, 7, 0.3)
	task.delay(0.08, impactRing, position, direction, Color3.new(1, 1, 1), 0.6, 5, 0.25)
	burst(position, {
		color = COLORS.Parry,
		count = 24,
		size = 1.2,
		speed = NumberRange.new(25, 50),
		streaks = true,
	})
	light(position, COLORS.Parry, 10, 20, 0.35)
	highlight(data.victim, COLORS.Parry, 0.3)
	highlight(data.attacker, Color3.fromRGB(255, 60, 60), 0.4)
	popup(position + Vector3.new(0, 2, 0), "PERFECT", COLORS.Parry, 1.4)

	if isLocal(data.attacker) or isLocal(data.victim) then
		screenFlash(COLORS.Parry, 0.3)
		CameraShake.FovKick(-6)
	end
end

function Effects.GuardBreak(data)
	local position: Vector3 = data.position
	shards(position, COLORS.Block, 14)
	flash(position, COLORS.GuardBreak, 6, 0.2)
	burst(position, {
		color = COLORS.GuardBreak,
		count = 16,
		size = 1.1,
		speed = NumberRange.new(25, 45),
		streaks = true,
	})
	light(position, COLORS.GuardBreak, 8, 16, 0.3)
	highlight(data.victim, COLORS.GuardBreak, 0.35)
	popup(position + Vector3.new(0, 2, 0), "GUARD BREAK", COLORS.GuardBreak, 1.5)
end

function Effects.Dash(data)
	local character: Model? = data.character
	local root = getRoot(character)
	if not character or not root then
		return
	end

	afterimage(character, COLORS.Dash, 0.35)
	for i = 1, 2 do
		task.delay(i * 0.06, function()
			if character.Parent then
				afterimage(character, COLORS.Dash, 0.3)
			end
		end)
	end

	local ground = groundBelow(root.Position, { character })
	if ground then
		burst(ground.Position, {
			texture = TEXTURES.Smoke,
			color = COLORS.Dust,
			count = 6,
			size = 2.5,
			speed = NumberRange.new(4, 10),
			lifetime = NumberRange.new(0.4, 0.7),
			lightEmission = 0,
			transparency = 0.5,
			spread = 70,
		})
		ringBurst(CFrame.new(ground.Position + Vector3.new(0, 0.1, 0)), COLORS.Dash, 0.6, 3.5, 0.25, 0.12)
	end
end

function Effects.Evasive(data)
	local character: Model? = data.character
	local root = getRoot(character)
	if not character or not root then
		return
	end
	afterimage(character, COLORS.Evasive, 0.5)
	flash(root.Position, COLORS.Evasive, 7, 0.25)
	ringBurst(CFrame.new(root.Position), COLORS.Evasive, 1, 8, 0.35, 0.25)
	burst(root.Position, {
		color = COLORS.Evasive,
		count = 20,
		size = 1,
		speed = NumberRange.new(20, 40),
		streaks = true,
	})
	popup(root.Position + Vector3.new(0, 3, 0), "EVASIVE", COLORS.Evasive, 1.2)
	if isLocal(character) then
		screenFlash(COLORS.Evasive, 0.25)
	end
end

-- A ragdoll slamming into the floor or a wall.
function Effects.BodyImpact(data)
	local position: Vector3 = data.position
	local strength: number = math.clamp(tonumber(data.strength) or 0.5, 0.2, 1)
	local ground = groundBelow(position)
	local spot = if ground then ground.Position else position
	local dustColor = if ground and ground.Instance:IsA("BasePart") then ground.Instance.Color else COLORS.Dust

	burst(spot, {
		texture = TEXTURES.Smoke,
		color = dustColor:Lerp(Color3.new(1, 1, 1), 0.35),
		count = math.floor(6 + 10 * strength),
		size = 2 + 2.5 * strength,
		speed = NumberRange.new(6, 14 * strength + 6),
		lifetime = NumberRange.new(0.5, 1),
		lightEmission = 0,
		transparency = 0.35,
		drag = 3,
		spread = 75,
	})
	ringBurst(CFrame.new(spot + Vector3.new(0, 0.15, 0)), Color3.new(1, 1, 1), 0.8, 3 + 4 * strength, 0.25, 0.12)
	if strength > 0.6 and ground then
		groundRocks(spot, math.floor(4 + 6 * strength), 1.5 + 1.5 * strength, 1 + strength)
	end
end

function Effects.Crater(data)
	local position: Vector3 = data.position
	if data.small then
		-- M1 downslams: a modest dent, not a skill-sized crater.
		groundRocks(position, 6, 2, 1.1)
		ringBurst(CFrame.new(position + Vector3.new(0, 0.2, 0)), Color3.new(1, 1, 1), 0.6, 5, 0.25, 0.15)
		return
	end
	groundRocks(position, 12, 4, 2.2)
	ringBurst(CFrame.new(position + Vector3.new(0, 0.2, 0)), Color3.new(1, 1, 1), 1, 10, 0.35, 0.3)
	flash(position, COLORS.Heavy, 6, 0.2)
	light(position, COLORS.Heavy, 6, 20, 0.35)

	-- Anyone nearby feels the slam.
	local myRoot = getRoot(localPlayer.Character)
	if myRoot then
		local distance = (myRoot.Position - position).Magnitude
		if distance < 40 then
			CameraShake.Add(0.35 * (1 - distance / 40))
		end
	end
end

---------------------------------------------------------------------------

---------------------------------------------------------------------------
-- Public helpers used by the move animations
---------------------------------------------------------------------------

-- Streak behind a striking limb (fist or foot) for `duration` seconds.
function VFX.LimbTrail(character: Model, limbName: string, duration: number, color: Color3?)
	local limbPart = character:FindFirstChild(limbName)
	if not limbPart or not limbPart:IsA("BasePart") then
		return
	end
	-- Two points near the end of the limb (R6 limbs are 2 studs long).
	local tip = Instance.new("Attachment")
	tip.Position = Vector3.new(0, -1.1, 0)
	tip.Parent = limbPart
	local mid = Instance.new("Attachment")
	mid.Position = Vector3.new(0, -0.3, 0)
	mid.Parent = limbPart

	local trail = Instance.new("Trail")
	trail.Attachment0 = tip
	trail.Attachment1 = mid
	trail.Color = ColorSequence.new(color or COLORS.Swing)
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Lifetime = 0.12
	trail.MinLength = 0
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.FaceCamera = true
	trail.Parent = limbPart

	task.delay(duration, function()
		trail.Enabled = false
		task.wait(trail.Lifetime)
		trail:Destroy()
		tip:Destroy()
		mid:Destroy()
	end)
end

-- Burst of displaced air in front of a punch or kick.
function VFX.AirPop(character: Model, heavy: boolean)
	local root = getRoot(character)
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local position = root.Position + look * (if heavy then 3.5 else 3) + Vector3.new(0, 0.5, 0)
	impactRing(position, look, COLORS.Swing, 0.3, if heavy then 3.2 else 1.8, if heavy then 0.2 else 0.14)
	burst(position, {
		color = COLORS.Swing,
		count = if heavy then 8 else 4,
		size = 0.5,
		speed = NumberRange.new(10, 20),
		lifetime = NumberRange.new(0.1, 0.2),
		streaks = true,
		spread = 35,
		direction = look,
	})
	if heavy then
		flash(position, COLORS.Swing, 2.5, 0.1)
	end
end

-- Building blocks for character kits (Client/Kits/*).
VFX.Util = {
	folder = fxFolder,
	textures = TEXTURES,
	newPart = newPart,
	tween = tween,
	randomUnit = randomUnit,
	randomAngles = randomAngles,
	getRoot = getRoot,
	isLocal = isLocal,
	groundBelow = groundBelow,
	burst = burst,
	flash = flash,
	ringBurst = ringBurst,
	impactRing = impactRing,
	light = light,
	highlight = highlight,
	afterimage = afterimage,
	bodyTrail = bodyTrail,
	shards = shards,
	groundRocks = groundRocks,
	popup = popup,
	screenFlash = screenFlash,
	glint = glint,
	sparks = sparks,
	speedLines = speedLines,
	shockwave = shockwave,
	groundCracks = groundCracks,
	debris = debris,
	pillar = pillar,
	spiral = spiral,
	lightning = lightning,
	colorGrade = colorGrade,
	impactSpikes = impactSpikes,
	dustWave = dustWave,
	scorch = scorch,
	groove = groove,
}

-- Adds (or replaces) a named effect the server can trigger.
function VFX.Register(name: string, effect: (data: any) -> ())
	Effects[name] = effect
end

-- A character-specific version of an effect (e.g. Asta's own dash). Used
-- when data.character is playing that kit.
local kitEffects: { [string]: { [string]: (data: any) -> () } } = {}
function VFX.RegisterKitEffect(kitId: string, name: string, effect: (data: any) -> ())
	kitEffects[kitId] = kitEffects[kitId] or {}
	kitEffects[kitId][name] = effect
end

function VFX.SetPalette(kitId: string, palette: Palette)
	palettes[kitId] = palette
end

-- Plays an effect locally (used for instant feedback on your own actions).
-- The kit whose version of `name` should play: the attacker's (data.kit),
-- then the acting character's, then the defender's (data.victimKit), so a
-- block against Asta's sword, or by it, makes sword sparks.
local function overrideFor(name: string, data: any): ((data: any) -> ())?
	if type(data) ~= "table" then
		return nil
	end
	local candidates = { data.kit }
	if typeof(data.character) == "Instance" then
		table.insert(candidates, data.character:GetAttribute("Kit"))
	end
	table.insert(candidates, data.victimKit)
	for _, kitId in candidates do
		local overrides = if type(kitId) == "string" then kitEffects[kitId] else nil
		if overrides and overrides[name] then
			return overrides[name]
		end
	end
	return nil
end

-- Plays the built-in version of an effect, ignoring kit overrides (lets an
-- override add to the default instead of replacing it).
function VFX.PlayDefault(name: string, data: any)
	local effect = Effects[name]
	if effect then
		task.spawn(effect, data)
	end
end

function VFX.Play(name: string, data: any)
	local effect = overrideFor(name, data) or Effects[name]
	if effect then
		task.spawn(effect, data)
	end
end

function VFX.Start()
	Remotes.VFX.OnClientEvent:Connect(function(name, data)
		if type(name) == "string" and type(data) == "table" then
			VFX.Play(name, data)
		end
	end)
end

return VFX
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
