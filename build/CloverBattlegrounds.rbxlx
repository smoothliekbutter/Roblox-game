)

Animations.Air = clip(
	{ loop = true },
	[[
0|r-6|r6|l85 25 10|a.28 .39 .88|l35 0 -40|r30|r-12
]]
)

Animations.Slash1 = clip(
	{
		fadeIn = 0.1,
		fadeOut = 0.22,
		additive = { RightLeg = true, LeftLeg = true },
		delays = { Head = -0.01, RightArm = 0.012, LeftArm = 0.02, Sword = 0.03 },
	},
	[[
