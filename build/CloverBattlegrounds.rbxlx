end
if A then
g.focusLines(0.3)
end
end)

if A then
local O=q.Camera(x)
local P=H
H=function()
P()
O()
end
end
return H
end

function q.Camera(s:c.Plan):()->()
local t=c.Times
local function u(v:number):Vector3
return c.Victim(s,math.min(v,t.Thrust)).Position
end
local function v(w:number,x:number,y:number):number
if w<x then
return 0
end
local z=(w-x)/0.07
return y*z*math.exp(1-z)
end
return d.Camera(function(w)
local x=math.min(w,t.Length)

local y=i(-40)-i(40)*r(x/t.Out)

local z=r((x-(t.Out-0.35))/0.45)
local A=y+(i(18)-y)*z
local B=s.out*math.cos(A)+s.side*math.sin(A)
local C=u(x)
local D=C+B*(11+3*z)+j*(0.6+1.6*z)
local E=r((x-t.Thrust)/0.25)
local F=C:Lerp(C-s.out*8,E)+j*0.4
local G=72-4*z
for H,I in t.Cuts do
G-=v(x,I,3)
end
G-=v(x,t.Thrust,9)
return CFrame.lookAt(D,F)*CFrame.Angles(0,0,i(3-5*z)),G
end,t.Length+0.05)
end

