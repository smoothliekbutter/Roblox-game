.062 Lo|b.03 -17.07 -2.68 2.77|r15.36 2.68 -2.77|l88.72 25 10|a.219 .645 .732|l27.13 -3.83 -10.59|l43.9 2.68 -1.66|l4.1 2.68 -1.66
.125 Lo|b.08 -17.49 -4.95 2.12|r14.79 4.95 -2.12|l87.03 25 10|a.188 .65 .736|l43.36 -7.07 -12|l60.77 4.95 -1.27|l-12.77 4.95 -1.27
.188 Lo|b.16 -18.07 -6.47 1.15|r14.03 6.47 -1.15|l84.73 25 10|a.171 .655 .736|l54.19 -9.24 -13.41|l72.04 6.47 -.69|l-24.04 6.47 -.69
.25 Lo|b.21 -18.45 -7|r13.51 7|l83.18 25 10|a.17 .656 .736|l58 -10 -14|l76 7|l-28 7
.312 Lo|b.21 -18.43 -6.47 -1.15|r13.54 6.47 1.15|l83.28 25 10|a.186 .65 .737|l54.19 -9.24 -13.41|l72.04 6.47 .69|l-24.04 6.47 .69
.375 Lo|b.15 -18.01 -4.95 -2.12|r14.11 4.95 2.12|l84.97 25 10|a.217 .638 .739|l43.36 -7.07 -12|l60.77 4.95 1.27|l-12.77 4.95 1.27
.438 Lo|b.07 -17.43 -2.68 -2.77|r14.87 2.68 2.77|l87.27 25 10|a.256 .625 .738|l27.13 -3.83 -10.59|l43.9 2.68 1.66|l4.1 2.68 1.66
