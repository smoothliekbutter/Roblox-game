          <string name="Name">CharacterLoader</string>
          <string name="Source"><![CDATA[

local a=game:GetService("Players")
local b=game:GetService("StarterPlayer")

local c={}

local d:{[Player]:HumanoidDescription}={}

local function e(f:Player):HumanoidDescription
local g=d[f]
if g then
return g
end
local h,i=pcall(function()
return a:GetHumanoidDescriptionFromUserIdAsync(f.UserId)
end)
if not h or not i then

i=Instance.new("HumanoidDescription")
end
d[f]=i
return i
end

local function f(g:Player)
if not g.Parent then
return
end
g:LoadCharacterAsync()

local h=g.Character
local i=h and h:FindFirstChildOfClass("Humanoid")
if not h or not i then
return
end

local j,k=pcall(function()
i:ApplyDescriptionAsync(e(g))
end)
if not j then
warn("[CharacterLoader] Couldn't apply avatar for",g.Name,k)
end
h:SetAttribute("AvatarLoaded",true)

i.Died:Connect(function()
task.delay(a.RespawnTime,function()
if g.Parent and g.Character==h then
f(g)
end
end)
end)
end

function c.Start()
a.CharacterAutoLoads=false

if not b:FindFirstChild("StarterCharacter")then
local g=a:CreateHumanoidModelFromDescriptionAsync(
Instance.new("HumanoidDescription"),
Enum.HumanoidRigType.R6
)
g.Name="StarterCharacter"
g.Parent=b
end

a.PlayerAdded:Connect(f)
a.PlayerRemoving:Connect(function(g)
d[g]=nil
end)

for g,h in a:GetPlayers()do
task.spawn(f,h)
end
end

return c]]></string>
