      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Impulse</string>
          <string name="Source"><![CDATA[

local a=game:GetService("RunService")

local b={}

function b.Apply(
c:BasePart,
d:Vector3,
e:number,
f:string?,
g:number?
):LinearVelocity
local h="Impulse_"..(f or"Default")
local i=c:FindFirstChild(h)
if i then
i:Destroy()
end

local j=Instance.new("Attachment")
j.Name=h
j.Parent=c

local k=Instance.new("LinearVelocity")
k.Attachment0=j
k.RelativeTo=Enum.ActuatorRelativeTo.World
k.VelocityConstraintMode=Enum.VelocityConstraintMode.Vector
k.ForceLimitMode=Enum.ForceLimitMode.PerAxis
local l=if math.abs(d.Y)>0.01 then 1e6 else 0
k.MaxAxesForce=Vector3.new(1e6,l,1e6)
k.VectorVelocity=d
k.Parent=j

if g and g>0 and e>0 then
local m=os.clock()
local n=e*(1-math.min(g,1))
local o:Vector3?=nil
local p
p=a.Heartbeat:Connect(function()
if not k.Parent then
p:Disconnect()
return
end
local q=os.clock()-m
if q<n then
return
end
o=o or k.VectorVelocity
local r=math.clamp((q-n)/(e-n),0,1)
k.VectorVelocity=(o::Vector3)*(1-r*r*(3-2*r))
end)
end

task.delay(e,function()
j:Destroy()
end)

return k
end

function b.Clear(c:BasePart)
for d,e in c:GetChildren()do
if e:IsA("Attachment")and string.sub(e.Name,1,8)=="Impulse_"then
e:Destroy()
end
end
end

return b]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Kits</string>
          <string name="Source"><![CDATA[

export type SkillInfo={
name:string,
cooldown:number,
type:string,
airHold:boolean?,
}

export type SwordInfo={
name:string,
skills:{SkillInfo},
}

export type KitInfo={
id:string,
title:string,
description:string,
color:Color3,
playable:boolean,

m1:{[string]:any},
skills:{SkillInfo},

special:SkillInfo?,

awakenedSkills:{SkillInfo}?,

awakenedSpecial:SkillInfo?,
swords:{[string]:SwordInfo}?,
awakening:{
name:string,
duration:number,
damageMultiplier:number,
cooldownMultiplier:number,
speedBonus:number,
}?,

airJumps:number?,
ascension:{
name:string,
duration:number,
charge:number,
chargeByKit:boolean?,
damageMultiplier:number,
cooldownMultiplier:number,
speedBonus:number,
skills:{SkillInfo},
}?,
}

local a={}

a.Default="AntiMagic"


a.Order={"AntiMagic","Wind","Water","Dark","Flame","Lightning"}

local function b(c:string,d:string,e:string,f:Color3):KitInfo
return{
id=c,
title=d,
description=e,
color=f,
playable=false,
m1={},
skills={},
}
end

a.List={
AntiMagic={
id="AntiMagic",
title="Anti-Magic Knight",
description="No magic at all. A demon-slaying greatsword that cuts through every spell.",
color=Color3.fromRGB(205,35,45),
playable=true,
m1={

HitboxSize=Vector3.new(7,6,7),
HitboxOffset=3.75,
Damage=4,
FinisherDamage=6,

WindUp=0.11,
FinisherWindUp=0.18,
},
skills={
{name="Bull Thrust",cooldown=10,type="Melee",airHold=true},
{name="Black Meteorite",cooldown=13,type="Melee",airHold=true},
{name="Black Divider",cooldown=11,type="Melee",airHold=true},
{name="Anti-Magic Deflect",cooldown=14,type="Counter",airHold=true},
},

special={name="Anti-Magic Leap",cooldown=10,type="Melee",airHold=true},
awakenedSkills={
{name="Black Hurricane",cooldown=9,type="Melee",airHold=true},
{name="Slayer Recall",cooldown=12,type="Bolt",airHold=true},
{name="Grand Divider",cooldown=13,type="Explosion",airHold=true},
{name="Black Moon",cooldown=25,type="Melee"},
},
awakenedSpecial={name="Swap Sword",cooldown=0,type="Melee"},
swords={
Slayer={
name="Demon-Slayer Sword",
skills={
{name="Black Hurricane",cooldown=9,type="Melee",airHold=true},
{name="Slayer Recall",cooldown=12,type="Bolt",airHold=true},
},
},
Destroyer={
name="Demon-Destroyer Sword",
skills={
{name="Causality Break",cooldown=15,type="Zone",airHold=true},
{name="Black Comet",cooldown=14,type="Melee",airHold=true},
},
},
Slasher={
name="Demon-Slasher Katana",
skills={
{name="Black Ascent",cooldown=12,type="Melee",airHold=true},
{name="Zetten",cooldown=16,type="Counter",airHold=true},
},
},
},
awakening={
name="Black Form",
duration=55,
damageMultiplier=1.25,
cooldownMultiplier=0.8,
speedBonus=6,
},
}::KitInfo,

Wind={
id="Wind",
title="Prince of Wind",
description="Wind magic blessed by the spirit Sylph, and star magic. Fights from range and is never where you left him.",
color=Color3.fromRGB(90,220,150),
playable=true,
m1={

HitboxOffset=3.5,
},

airJumps=1,
skills={
{name="Wind Blades Shower",cooldown=11,type="Swarm",airHold=true},
{name="Swift White Hawk",cooldown=8,type="Bolt",airHold=true},
{name="Heavenly Wind Ark",cooldown=12,type="Zone",airHold=true},
{name="Gale White Bow",cooldown=15,type="Bolt",airHold=true},
},

special={name="Conjunction",cooldown=10,type="Melee"},

awakenedSkills={
{name="Spirit Storm",cooldown=12,type="Bolt",airHold=true},
{name="Tempest Dive",cooldown=16,type="Melee",airHold=true},
{name="Quartile Scutum",cooldown=16,type="Counter"},
{name="Nova Vortex",cooldown=14,type="Zone",airHold=true},
},
awakening={
name="Half-Crown",
duration=45,
damageMultiplier=1.15,
cooldownMultiplier=0.85,
speedBonus=4,
},
ascension={
name="Full-Crown",
duration=30,
charge=2,
chargeByKit=true,
damageMultiplier=1.3,
cooldownMultiplier=0.75,
speedBonus=8,
skills={
{name="Spirit of Boreas",cooldown=12,type="Melee",airHold=true},
{name="Spirit of Zephyrus",cooldown=13,type="Melee",airHold=true},
{name="Spirit of Euros",cooldown=18,type="Bolt",airHold=true},
{name="Saint Spirit of Zephyr",cooldown=30,type="Melee"},
},
},
}::KitInfo,
Water=b("Water","Water Princess","Royal water magic.",Color3.fromRGB(80,160,255)),
Dark=b("Dark","Dark Captain","Dark magic that slices space.",Color3.fromRGB(120,70,190)),
Flame=b("Flame","Flame Lioness","Overwhelming flame magic.",Color3.fromRGB(255,120,40)),
Lightning=b("Lightning","Battle Maniac","Lightning-fast magic.",Color3.fromRGB(255,225,70)),
}::{[string]:KitInfo}

function a.Get(c:string?):KitInfo?
if c==nil then
return nil
end
return a.List[c]
end


function a.SkillsOf(c:Model):{SkillInfo}
local d=a.Of(c)
if not d then
return{}
end
if c:GetAttribute("Awakened")==true and d.ascension and c:GetAttribute("Ascended")==true then
return d.ascension.skills
end
if c:GetAttribute("Awakened")==true and d.awakenedSkills then

local e=c:GetAttribute("Sword")
local f=if d.swords and type(e)=="string"then d.swords[e]else nil
if f then
local g=table.clone(d.awakenedSkills)
for h,i in f.skills do
g[h]=i
end
return g
end
return d.awakenedSkills
end
return d.skills
end


function a.Of(c:Model):KitInfo?
return a.Get(c:GetAttribute("Kit")::string?)
end

return a]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MeteorVortex</string>
          <string name="Source"><![CDATA[

local a={}

a.Length=1.2
a.Turns=3
a.Top=20
a.AirTop=8
a.Bob=4
a.Radius=1.5

a.Flip=0.14
a.DiveSpeed=45
a.SpinRate=9
a.Recover=0.26
a.ImpactHeight=3.2
a.NoFloorDrop=16

local b=Vector3.yAxis

export type Plan={
origin:CFrame,
top:number,
floorY:number?,
topPosition:Vector3,
diveEnd:Vector3,
drop:number,
spins:number,
flipAt:number,
diveAt:number,
impactAt:number,
length:number,
}

local function c(d:number):number
return d*d*(3-2*d)
end


function a.Plan(d:CFrame,e:number,f:number?):Plan
local g=d.Position+b*e
local h=d.LookVector
local i=if f then f+a.ImpactHeight else g.Y-a.NoFloorDrop
i=math.min(i,g.Y-2)
local j=g.Y-i
local k=math.clamp(j/a.DiveSpeed,0.35,0.9)
local l=a.Length
local m=l+a.Flip
local n=m+k
return{
origin=d,
top=e,
floorY=f,
topPosition=g,
diveEnd=Vector3.new(g.X,i,g.Z)+h*1.8,
drop=j,
spins=math.max(2,math.floor(a.SpinRate*k+0.5)),
flipAt=l,
diveAt=m,
impactAt=n,
length=n+a.Recover,
}
end

function a.Angle(d:number):number
return a.Turns*2*math.pi*c(math.clamp(d,0,1))
end


function a.Spin(d:CFrame,e:number,f:number?):CFrame
local g=math.clamp(e/a.Length,0,1)
local h=a.Angle(g)
local i=(f or a.Top)*c(g)
+a.Bob*math.sin(g*math.pi*4)*math.sin(g*math.pi)
local j=(d.RightVector*math.sin(h)+d.LookVector*(math.cos(h)-1))
*a.Radius
local k=d.Position+b*i+j


local l=4*g*(1-g)
return CFrame.new(k)
*d.Rotation
*CFrame.Angles(0,-h,0)
*CFrame.Angles(math.rad(10)*l,0,-math.rad(12)*l)
end

function a.At(d:Plan,e:number):CFrame
if e<=d.flipAt then
return a.Spin(d.origin,e,d.top)
end
local f=d.origin.LookVector
if e<=d.diveAt then

local g=(e-d.flipAt)/(d.diveAt-d.flipAt)
local h=c(g)
local i=d.topPosition+b*math.sin(g*math.pi)*1.2+f*0.6*h
return CFrame.new(i)*d.origin.Rotation*CFrame.Angles(-math.pi*h,0,0)
end
if e<=d.impactAt then

local g=(e-d.diveAt)/(d.impactAt-d.diveAt)
local h=d.topPosition+f*0.6
local i=h:Lerp(d.diveEnd,g)-b*d.drop*(g^1.7-g)
local j=d.spins*2*math.pi*g
return CFrame.new(i)*CFrame.Angles(0,-j,0)*d.origin.Rotation*CFrame.Angles(-math.pi,0,0)
end

local g=math.clamp((e-d.impactAt)/(d.length-d.impactAt),0,1)
local h=c(g)
local i=if d.floorY then d.floorY+3 else d.diveEnd.Y
local j=Vector3.new(d.diveEnd.X,d.diveEnd.Y+(i-d.diveEnd.Y)*h,d.diveEnd.Z)
+b*math.sin(g*math.pi)*1.5
+f*1.5*h
return CFrame.new(j)*d.origin.Rotation*CFrame.Angles(-math.pi*(1+h),0,0)
end

return a]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[

local a=game:GetService("ReplicatedStorage")
local b=game:GetService("RunService")

local c={"Action","VFX","CameraShake","Impulse","Notify"}

local d:{[string]:RemoteEvent}={}

if b:IsServer()then
local e=a:FindFirstChild("Remotes")
if not e then
e=Instance.new("Folder")
e.Name="Remotes"
e.Parent=a
end
for f,g in c do
local h=e:FindFirstChild(g)
if not h then
h=Instance.new("RemoteEvent")
h.Name=g
h.Parent=e
end
d[g]=h
end
else
local e=a:WaitForChild("Remotes")
for f,g in c do
d[g]=e:WaitForChild(g)::RemoteEvent
end
end

return d]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">SaintZephyr</string>
          <string name="Source"><![CDATA[

local a={}

local b=Vector3.yAxis

local c={
Lift=1.0,
Open=1.15,
Hover=1.2,


Cuts={1.62,1.89,2.15,2.4,2.64,2.87,3.09,3.3},
Cross=3.6,
Rise=3.94,
Strike=4.72,
Burst=4.97,
Land=5.32,
Length=6.3,
}
a.SlowMo=0.16
a.Linger=0.15

local function d(e:number):number
e=math.clamp(e,0,1)
return e*e*e*(e*(e*6-15)+10)
end

local e=c.Strike-a.SlowMo+a.Linger/2


function a.PathTime(f:number):number
return f-a.Linger*d((f-e)/(2*a.SlowMo))
end


function a.RealTime(f:number):number
if f<=e then
return f
end
local g=f+a.Linger/2
for h=1,12 do


local i=(g-e)/(2*a.SlowMo)
local j=if i>0 and i<1
then 1-a.Linger/(2*a.SlowMo)*30*i*i*(1-i)*(1-i)
else 1
g-=(a.PathTime(g)-f)/j
end
return g
end

a.Times={
Lift=c.Lift,
Open=c.Open,
Hover=c.Hover,
Cuts=table.clone(c.Cuts),
Cross=c.Cross,
Rise=c.Rise,
Strike=a.RealTime(c.Strike),
Burst=a.RealTime(c.Burst),
Land=a.RealTime(c.Land),
Length=a.RealTime(c.Length),
}
a.Height=32
a.Ring=12
a.Above=22
a.Charge=0.26
a.Drift=2
a.Dive=0.18
a.Lift=1.8

local f={24,-18,28,-24,16,-28,22,-20}
local g=-12
local h=38
local i=math.rad(22.5)
local j=1.45
local k=0.25
local l=0.35
local m=math.rad(16)

export type Plan={
origin:CFrame,
start:Vector3,
forward:Vector3,
right:Vector3,
floorY:number,
center:Vector3,
hover:Vector3,
stars:{Vector3},
passes:{Vector3},
speeds:{number},
tangents:{Vector3},
top:Vector3,
ground:Vector3,
}

local function n(o:number):number
o=math.clamp(o,0,1)
return o*o*(3-2*o)
end



local function o(p:Plan,q:number,r:number):Vector3
local s=p.forward*math.cos(q)+p.right*math.sin(q)
return s*math.cos(r)+b*math.sin(r)
end


local function p():{number}
local q=table.clone(c.Cuts)
table.insert(q,c.Cross)
return q
end

function a.Plan(q:CFrame,r:Vector3,s:number):Plan
local t=r-q.Position
local u=Vector3.new(t.X,0,t.Z)
if u.Magnitude<1e-3 then
u=Vector3.new(q.LookVector.X,0,q.LookVector.Z)
end
local v=if u.Magnitude>1e-3 then u.Unit else Vector3.new(0,0,-1)
local w=v:Cross(b)
local x=Vector3.new(r.X,s+3,r.Z)
local y=x+b*a.Height
local z=a.Ring
local A:Plan={
origin=q,
start=x,
forward=v,
right=w,
floorY=s,
center=y,
hover=y,
stars={},
passes={},
speeds={},
tangents={},
top=y,
ground=x,
}

local B=math.pi
local C=math.rad(g)
A.hover=y+o(A,B,C)*z
local D,E={},{}
for F=1,#f do
D[F]=B+math.pi+i+(F-1)*math.rad(225)
E[F]=math.rad(f[F])
table.insert(A.stars,y+o(A,D[F],E[F])*z)
end

table.insert(A.passes,(y-A.hover).Unit)
for F=2,#f do
local G=o(A,D[F-1]+i,E[F-1])
local H=o(A,D[F]-i,E[F])
table.insert(A.passes,(H-G).Unit)
end
local F=math.rad(h)
table.insert(A.passes,(o(A,0,F)-o(A,math.pi,-F)).Unit+w*0.12)
A.passes[#A.passes]=A.passes[#A.passes].Unit

local G=p()
for H,I in G do
if H==1 then
A.speeds[H]=3*z/a.Charge
else
local J=(I-G[H-1])/2
local K=if G[H+1]then(G[H+1]-I)/2 else J
A.speeds[H]=j*z/((J+K)/2)
end
end
for H,I in A.stars do
local J=(I-y).Unit
local K=-(A.passes[H]+A.passes[H+1])
K-=J*J:Dot(K)
A.tangents[H]=if K.Magnitude>1e-3 then K.Unit else A.right
end

local H=7
A.top=y+b*a.Above+v*H
A.ground=x-v*(H*a.Height/(a.Above+a.Drift))
return A
end

local function q(
r:Vector3,
s:Vector3,
t:Vector3,
u:Vector3,
v:number,
w:number
):(Vector3,Vector3)
local x,y=w*w,w*w*w
local z,A=s*v,u*v
local B=r*(2*y-3*x+1)+z*(y-2*x+w)+t*(3*x-2*y)+A*(y-x)
local C=r*(6*x-6*w)+z*(3*x-4*w+1)+t*(6*w-6*x)+A*(3*x-2*w)
return B,C/v
end

local function r(s:Plan,t:number):(Vector3,Vector3)
local u=p()
local v=#u
if t>=u[v]then

local w=c.Rise-u[v]
local x=math.clamp((t-u[v])/w,0,1)
return q(s.center,s.passes[v]*s.speeds[v],s.top,b*4,w,x)
end
local w=1
for x=1,v-1 do
if t>=u[x]then
w=x
end
end
local x,y=u[w],u[w+1]
local z=(x+y)/2
local A=(y-x)/2
local B=s.stars[w]
local C=s.tangents[w]*s.speeds[w]*k
if t<z then
return q(s.center,s.passes[w]*s.speeds[w],B,C,A,(t-x)/A)
end
return q(
B,
C,
s.center,
s.passes[w+1]*s.speeds[w+1],
A,
(t-z)/A
)
end



local function s(t:Plan,u:Vector3,v:number):CFrame
return CFrame.new(u)*CFrame.lookAt(Vector3.zero,-t.forward).Rotation*CFrame.Angles(v,0,0)
end


local function t(u:number):CFrame
return CFrame.Angles(-m*math.min(u/120,1),0,0)
end

local function u(v:Vector3,w:Vector3,x:number):Vector3
local y=w:Cross(v)
if y.Magnitude<1e-4 then
y=if math.abs(v.Y)<0.9 then b:Cross(v)else Vector3.xAxis
end
local z=math.acos(math.clamp(v:Dot(w),-1,1))
local A=x-l*math.sin(2*math.pi*x)/(2*math.pi)
return CFrame.fromAxisAngle(y.Unit,(2*math.pi-z)*A):VectorToWorldSpace(v)
end

local v=math.rad(-18)


local function w(x:Vector3):number
return math.atan2(-x.X,-x.Z)
end


local function x(y:number):number
return(y+math.pi)%(2*math.pi)-math.pi
end

local function y(z:number):number
local A,B=math.rad(30),math.rad(55)
local C=math.abs(z)-A
if C<=0 then
return z
end
return math.sign(z)*(A+(B-A)*math.tanh(C/(B-A)))
end

local function z(A:Plan,B:number):(Vector3,Vector3)
local C=c
local D=C.Cuts
local E=D[1]-a.Charge
if B<C.Hover then

local F=n((B-0.25)/(C.Hover-0.25))
local G,H=A.origin.Position,A.hover
local I=A.right*4+b*2
local J=G:Lerp(H,F)+I*math.sin(F*math.pi)
return J,Vector3.zero
elseif B<E then

local F=(B-C.Hover)/(E-C.Hover)
return A.hover+b*0.35*math.sin(F*math.pi)^2,Vector3.zero
elseif B<D[1]then

local F=(B-E)/a.Charge
local G=A.center-A.hover
return A.hover+G*(F*F*F),G*(3*F*F/a.Charge)
end
return r(A,B)
end

local function A():(number,number)
local B=a.Above+a.Drift
local C=math.sqrt(B/(B+a.Height))
local D=c.Strike
return D-C*a.Dive,D+(1-C)*a.Dive
end

local B:(Plan,number)->CFrame

local function C(D:Plan,E:number):CFrame
local F=c
local G=F.Cuts
if E<0.25 then
return D.origin
end
if E<F.Hover then
local H=z(D,E)
local I=B(D,math.min(E,F.Lift)).Position-H
local J=Vector3.new(I.X,0,I.Z)
local K=if J.Magnitude>1e-3 then J.Unit else D.forward
local L=B(D,0.25).Position-D.origin.Position
L=Vector3.new(L.X,0,L.Z)
L=if L.Magnitude>1e-3 then L.Unit else D.forward
local M=D.origin.LookVector
M=Vector3.new(M.X,0,M.Z)
M=if M.Magnitude>1e-3 then M.Unit else D.forward
local N=n((E-0.25)/0.35)
local O=x(w(L)-w(M))+x(w(K)-w(L))
local P=w(M)+O*N
local Q=y(math.atan2(I.Y,math.max(J.Magnitude,1e-3)))*N
return CFrame.new(H)*CFrame.fromOrientation(Q,P,0)
end
if E<G[1]then

local H,I=z(D,E)
return CFrame.lookAt(H,H+D.passes[1])*t(I.Magnitude)
end
if E<F.Cross then

local H,I=z(D,E)
local J=p()
local K=1
for L=1,#J-1 do
if E>=J[L]then
K=L
end
end
local L=(E-J[K])/(J[K+1]-J[K])
local M=u(D.passes[K],D.passes[K+1],L)
return CFrame.lookAt(H,H+M)*t(I.Magnitude)
end
if E<F.Rise then


local H=z(D,E)
local I=#D.passes
local J=D.passes[I]
local K=CFrame.lookAt(H,H+J)*t(D.speeds[I])
local L=n((E-F.Cross)/(F.Rise-F.Cross))
return K:Lerp(s(D,H,v),L)
end
local H,I=A()
if E<H then

local J=math.clamp((E-F.Rise)/(H-F.Rise),0,1)
local K=
q(D.top,b*4,D.top+b*a.Drift,Vector3.zero,H-F.Rise,J)
return s(D,K,v)
end
if E<I then

local J=(E-H)/(I-H)
local K=D.top+b*a.Drift
return s(D,K:Lerp(D.ground,J*J),v*(1-n(J)))
end


local J=n((E-I)/0.9)
return CFrame.new(D.ground)
*CFrame.lookAt(Vector3.zero,-D.forward).Rotation
*CFrame.Angles(0,math.rad(14)*J,0)
end

local function D(E:number,F:number,G:number):number
if E<F then
return 0
end
local H=(E-F)/G
return H*math.exp(1-H)
end


local function E(F:Plan,G:number):CFrame
local H=c
local I=CFrame.lookAt(Vector3.zero,-F.forward).Rotation
local J=Vector3.zero
local K,L=0,0
local M=p()
for N,O in M do
local P=D(G,O,0.05)
local Q=N==#M
J+=F.passes[N]*(if Q then 1.2 else 0.7)*P
K+=(if N%2==1 then 1 else-1)*math.rad(if Q then 22 else 12)*P
L+=math.rad(if Q then-14 else-6)*P
end

local N=D(G,H.Strike,0.08)
J+=-b*2.4*N
L+=math.rad(-25)*N
local O=math.sin(G*9)*math.rad(8)*(1-n((G-H.Rise)/0.4))
return CFrame.new(F.center+J)*I*CFrame.Angles(math.rad(-20)+L,O+K,0)
end

function B(F:Plan,G:number):CFrame
local H=c
if G<=H.Lift then
local I=n(G/H.Lift)
local J=E(F,G)
local K=CFrame.lookAt(Vector3.zero,-F.forward).Rotation
return CFrame.new(F.start:Lerp(F.center,I))
*CFrame.Angles(0,(I-1)*math.pi*2,0)
*K:Lerp(J.Rotation,I)
end
if G<=H.Burst then
return E(F,G)
end

local I=E(F,H.Burst)
local J=math.clamp((G-H.Burst)/(H.Land-H.Burst),0,1)
local K=Vector3.new(F.start.X,F.floorY+1.5,F.start.Z)
return CFrame.new(I.Position:Lerp(K,J*J))*I.Rotation*CFrame.Angles(math.rad(-70)*n(J),0,0)
end


function a.Attacker(F:Plan,G:number):CFrame
return C(F,a.PathTime(G))
end


function a.Victim(F:Plan,G:number):CFrame
return B(F,a.PathTime(G))
end


function a.DiveTimes():(number,number)
