export type Hold={
lift:number,
elbow:number,
wrist:number,
sweep:number,
twist:number,
beat:number,
rate:number,
}

i.Hover={lift=68,elbow=-20,wrist=-44,sweep=24,twist=8,beat=1,rate=0.4}::Hold
i.Glide={lift=22,elbow=-12,wrist=-30,sweep=30,twist=72,beat=0.35,rate=0.8}::Hold

function i.Blend(m:Hold,n:Hold,o:number):Hold
return{
lift=m.lift+(n.lift-m.lift)*o,
elbow=m.elbow+(n.elbow-m.elbow)*o,
wrist=m.wrist+(n.wrist-m.wrist)*o,
sweep=m.sweep+(n.sweep-m.sweep)*o,
twist=m.twist+(n.twist-m.twist)*o,
beat=m.beat+(n.beat-m.beat)*o,
rate=m.rate+(n.rate-m.rate)*o,
}
end

type Feather={
