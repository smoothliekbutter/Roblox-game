local function R(S:Model,T:BasePart):boolean
local U=OverlapParams.new()
U.FilterType=Enum.RaycastFilterType.Exclude
U.FilterDescendantsInstances={S}
for V,W in workspace:GetPartBoundsInBox(T.CFrame*CFrame.new(0,0,-3),Vector3.new(4.5,5,4),U)do
