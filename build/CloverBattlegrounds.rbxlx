transparency=NumberSequence.new({c(0,0.5),c(1,1)}),
width=NumberSequence.new({c(0,1),c(1,0.15)}),
lifetime=0.35,
off=true,
})
)
local G=a.windEmitter(E,{
Color=ColorSequence.new(f,d),
LightEmission=1,
Size=NumberSequence.new({c(0,0.35),c(1,0)}),
Transparency=NumberSequence.new({c(0,1),c(0.2,0.55),c(1,1)}),
Lifetime=NumberRange.new(0.3,0.55),
Speed=NumberRange.new(0.4,1),
Rate=6,
})
table.insert(A,G)
end
if D.quill then
B+=1
end
end
local C=x[B+3]
table.insert(
A,
a.windEmitter(C,{
Texture=a.SPARKLE,
Color=ColorSequence.new(h,g),
LightEmission=1,
Size=NumberSequence.new({c(0,0.22),c(1,0)}),
Transparency=NumberSequence.new({c(0,0.2),c(1,1)}),
Lifetime=NumberRange.new(0.6,1.1),
Speed=NumberRange.new(0.3,1),
Acceleration=Vector3.new(0,-1.5,0),
Shape=Enum.ParticleEmitterShape.Box,
Rate=5,
})
)


local D:{Beam}={}
for E=1,3 do
local F=x[B+E]
local G=F.Size.X/2
local H=Instance.new("Attachment")
H.Position=Vector3.new(-G*w,0,0)
H.Parent=F
local I=Instance.new("Attachment")
I.Position=Vector3.new(G*w,0,0)
I.Parent=F
table.insert(
D,
a.softBeam(H,I,{
color=ColorSequence.new(f,d),
width0=0.7-E*0.12,
width1=0.6-E*0.12,
transparency=NumberSequence.new({c(0,0.8),c(0.5,0.66),c(1,0.8)}),
texture=a.SMOKE,
speed=1.6,
length=1.5,
},F)
)
end

return{parts=x,frames=y,trails=z,emitters=A,beams=D,side=w}
end


function i.Place(v:Wing,w:CFrame,x:Hold,y:number,z:number,A:number)
i.Pose(v.frames,w,v.side,x,y,z,A)
workspace:BulkMoveTo(v.parts,v.frames,Enum.BulkMoveMode.FireCFrameChanged)
end

